@page
@using Microsoft.AspNetCore.Identity
@attribute [IgnoreAntiforgeryToken]
@inject SignInManager<IdentityUser> SignInManager
@functions {
    public async Task<IActionResult> OnPost()
    {
        if (User != null)
    {
            await SignInManager.SignOutAsync();
        }

        return Redirect("~/");
    }
}


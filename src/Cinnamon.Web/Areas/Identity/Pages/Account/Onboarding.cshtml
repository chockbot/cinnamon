<div class="modal fade" id="loginModal" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Sign Up/Log In</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br/>
                    <h6>Email</h6>
                    <div class="w-100 text-center">
                        <form id="email-submit" method="post">
                            <div class="d-flex flex-column gap-3 align-items-center">
                                <div class="col-12">
                                    <input id="email-signup" required placeholder="Email" class="input-group fs-12" type="email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                                </div>
                                <button class="btn-primary rounded-pill shadow-sm text-center" id="signup-waiting" type="submit" style="width:100%;white-space:nowrap;padding-right:50px;">
                                    <i id="email-spinner-loading" class="fa fa-spinner fa-spin d-none"></i> Continue
                                </button>
                                <p style="font-family:'Nunito';font-size:12px;font-weight:400;">By signing up you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                            </div>
                        </form> 
                         <div class="divider">
                            <hr class="left" />or<hr class="right" />
                        </div>
                        <div class="col-12">
                          <form id="external-account"
                                action="/Identity/Account/ExternalLogin"
                                method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="provider" value="Google">
                                <input type="hidden" name="userType"  value="@UserType.Maker">
                                <input type="hidden" name="returnUrl" value="/Creation">
                                <button class="btn btn-md btn-google" type="submit"><img src="https://img.icons8.com/color/48/000000/gmail-new.png" class="img-icon" /> Continue with Gmail</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>  
    </div>
</div>

<div class="modal fade" id="login-password-modal" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Log In</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-modal-id="login-password-modal"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br/>
                    <h6>Password</h6>
                    <form id="form-signin" method="post">
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <input id="text-password" asp-for="Input.Password" required placeholder="Password" class="input-group fs-12" type="password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                                <input type="hidden" id="hidden-email" asp-for="Input.Email" />
                            </div>
                            @* <div id="error-message-container" class="mb-4">
                                <ul id="error-list" class="fw-bold">
                                    <li style="font-family:'Nunito';font-size:12px;">Invalid password! Please insert correct password.</li>
                                </ul>
                            </div> *@
                            <button class="btn-primary rounded-pill shadow-sm text-center" id="login-password" type="submit" style="width:100%;white-space:nowrap;padding-right:50px;">
                                <i id="spinner-loading" class="fa fa-spinner fa-spin d-none"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>  
    </div>
</div>

<div class="modal fade" id="verificationModal" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Verification Email</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br />
                    <div class="col-12 text-center">
                        <p>We've sent an email to your inbox. Please check and click verify.</p>
                        <p>Haven't received a verification email?<a href="#" style="color:#FFA942"> Resend</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="finishModal" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Finish signing up</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <form id="form-register-information" method="post">
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <input id="firstname-signup-register" required class="input-group fs-12" placeholder="First name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                            </div>
                            <div class="col-12 justify-content-start">
                                <input id="lastname-signup-register" required class="input-group fs-12" placeholder="Last name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                                <p>Be sure it's the same as what appears on your government ID.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <input id="birtdate-signup-register" required type="date" class="input-group fs-12" placeholder="Birthdate" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                                <p>The minimum age to join is 18. Unlike Facebook, Cinnamon won't tell anybody else about your birthday.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <input id="email-signup-register" required type="email" class="input-group fs-12" placeholder="Email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" disabled/>
                                <p>For email confirmations, and receipts.</p>
                            </div>
                            <div class="col-12">
                                <input id="password-signup-register" required type="password" class="input-group fs-12" placeholder="Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                            </div>
                            <div class="col-12">
                                <input id="confirm-signup-register" required type="password" class="input-group fs-12" placeholder="Confirm Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                            </div>
                                <!--Error Message-->
                                <div id="error-message-container" class="mb-4">
                                    <ul id="error-list-register" class="fw-bold">
                                    </ul>
                                </div>
                            <p>By selecting <b>Agree and continue</b>,you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                            <button class="btn-primary rounded-pill shadow-sm text-center" id="signup-waiting-register" type="submit" style="width:100%;white-space:nowrap;padding-right:50px;">
                                <i id="spinner-loading-register" class="fa fa-spinner fa-spin d-none"></i>Agree and continue
                            </button>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="defaultCheck1-register">
                                    <label class="form-check-label" for="defaultCheck1" style="font-family:'Nunito';font-size:12px;font-weight:400;">
                                        I do not wish to receive promotional communications from Cinnamon.
                                  </label>
                                </div>
                            </div>
                        </div>  
                    </form>
                </div>
            </div>
        </div>  
    </div>
</div>

@section Scripts {
    <script>
        MyLib.Pages.customer.onboarding.init();
    </script>
}
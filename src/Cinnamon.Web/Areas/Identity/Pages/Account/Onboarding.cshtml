<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Sign Up/Log In</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br/>
                    <h6>Email</h6>
                    <div class="w-100 text-center">
                        <form action="">
                            <div class="d-flex flex-column gap-3 align-items-center">
                                <div class="col-12">
                                    <input id="email-signup" placeholder="Email" class="input-group fs-12" type="email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                                </div>
                                <button class="btn-primary rounded-pill shadow-sm text-center" id="signup-waiting" type="submit" style="width:100%;white-space:nowrap;padding-right:50px;">
                                    <i id="spinner-loading" class="fa fa-spinner fa-spin" style="visibility: hidden"></i> Continue
                                </button>
                                <p style="font-family:'Nunito';font-size:12px;font-weight:400;">By signing up you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                                <div class="divider">
                                    <hr class="left" />or<hr class="right" />
                                </div>
                                <div class="col-12">
                                    <a class="btn btn-md btn-google" href="#"><img src="https://img.icons8.com/color/48/000000/gmail-new.png" class="img-icon" onclick=""/> Continue with Gmail</a>
                                </div>
                            </div>
                        </form> 
                    </div>
                </div>
            </div>
        </div>  
    </div>
</div>

<div class="modal" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Log In</p>
                <button type="button" class="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br/>
                    <h6>Password</h6>
                    <form action="">
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <input id="text-password" placeholder="Password" class="input-group fs-12" type="password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" />
                            </div>
                            <div id="error-message-container" class="mb-4">
                                <ul id="error-list" class="fw-bold">
                                    <li style="font-family:'Nunito';font-size:12px;">Invalid password! Please insert correct password.</li>
                                </ul>
                            </div>
                            <button class="btn-primary rounded-pill shadow-sm text-center" id="login-password" type="submit" style="width:100%;white-space:nowrap;padding-right:50px;">
                                <i id="spinner-loading" class="fa fa-spinner fa-spin"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>  
    </div>
</div>

<div class="modal" id="verificationModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display: none;">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Verification Email</p>
                <button type="button" class="btn-close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">Cinnamon</span></h5>
                    <br />
                    <div class="col-12 text-center">
                        <p>We've sent an email to your inbox. Please check and click verify.</p>
                        <p>Haven't received a verification email?<a href="#" style="color:#FFA942"> Resend</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
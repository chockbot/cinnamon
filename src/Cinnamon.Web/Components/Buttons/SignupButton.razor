@namespace Cinnamon.Web.Components

<button class="btn-primary rounded-pill shadow-sm" id="@Id" type="submit" style="width:@Width;white-space:nowrap;padding-right:60px;" data-bs-toggle=@ModalBsToggle data-bs-target=@ModalTarget @onclick="OnClick">
    <i id="spinner-loading" class="fa fa-spinner fa-spin" style="visibility:hidden"></i> @Text
</button>

@code {
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter]
    public string Text { get; set; } = "Primary Button";
    [Parameter]
    public string ModalTarget { get; set; } = "";
    [Parameter]
    public string ModalBsToggle { get; set; } = "";
    [Parameter]
    public string Width { get; set; } = "50%";
    [Parameter]
    public string Id { get; set; }
}

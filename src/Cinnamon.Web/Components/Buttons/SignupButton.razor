@namespace Cinnamon.Web.Components

<button class="btn-primary rounded-pill shadow-sm text-center" id="@Id" type="submit" style="width:@Width;white-space:nowrap;padding-right:50px;" data-bs-toggle=@ModalBsToggle data-bs-target=@ModalTarget @onclick="OnClick" disabled="@DisableButton">
    <i id="spinner-loading" class="fa fa-spinner fa-spin" style="visibility:@Visibility"></i> @Text
</button>

@code {
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter]
    public string Text { get; set; } = "Primary Button";
    [Parameter]
    public string ModalTarget { get; set; } = "";
    [Parameter]
    public string ModalBsToggle { get; set; } = "";
    [Parameter]
    public string Width { get; set; } = "50%";
    [Parameter]
    public string Id { get; set; }
    [Parameter]
    public string Visibility { get; set; } = "hidden";
    [Parameter]
    public bool DisableButton { get; set; } = false;
}

@namespace Cinnamon.Web.Components


<div class="card shadow p-3 mr-5 text-center d-flex flex-column justify-content-between" style="font-size:0.9rem">
    @((MarkupString)Text.Replace(Environment.NewLine, "<br>").Replace("\r\n\r\n","<br>"))
    <button class="btn-primary rounded-pill shadow-sm">Choose</button>
</div>


@code {
    [Parameter]
    public string Text { get; set; } = "";
}

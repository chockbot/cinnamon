@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Enums;
@using Models.Entities
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="card shadow-sm p-3 mr-5 text-center d-flex flex-column justify-content-between" style="font-size:0.9rem" @onmouseenter="OnMouseEnter" @onmouseleave="OnMouseEnter">
    <span class="fw-bold">@ScheduleModel.Name</span>
    <br />
    <div>
        @ScheduleModel.DateTime
    </div>
    <br />
    <div style="font-size:0.7rem">
     @ScheduleModel.UnitPrice @ScheduleModel.Price / @ScheduleModel.PerUnit1 @ScheduleModel.PriceUnit1 / @ScheduleModel.PerUnit2 @ScheduleModel.PriceUnit2
    </div>
    <br />
    @if (AuthState.User.Identity.IsAuthenticated)
    {
        if (ButtonType == ScheduleButtonType.Choose)
        {
            <button class="btn-primary rounded border-0 shadow-sm text-decoration-none" id="choose-redirect" @onclick="OnClickChoose" style="width:fit-content;padding: 5px 10px">Choose</button>
        }
        else{
            <button class="btn-primary shadow-sm border-0 rounded" style="width:fit-content;padding: 5px 10px" @onclick="OnClickChange">
                Change
            </button>
        }
    }
    else
    {
        <button class="btn-primary rounded border-0 shadow-sm" data-bs-toggle="modal" data-bs-target="#loginModal" style="width:fit-content;padding: 5px 10px">Choose</button>
    }
    
</div>


@if (!AuthState.User.Identity.IsAuthenticated && mouseEnter)
{
    <ModalLogin ReturnUrl="@($"/Payment/{ScheduleModel.Id}")"></ModalLogin>
}
@code {
    [Parameter]
    public ActivitySchedule ScheduleModel { get; set; }

    [Parameter]
    public ScheduleButtonType ButtonType { get; set; } = ScheduleButtonType.Choose;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickChange { get; set; } = new EventCallback<MouseEventArgs>();

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickLogin { get; set; } = new EventCallback<MouseEventArgs>();

    public AuthenticationState AuthState { get; set; }

    private bool mouseEnter { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    }

    private void OnClickChoose()
    {
        NavigationManager.NavigateTo($"/Payment/{ScheduleModel.Id}", true);
    }

    private void OnMouseEnter()
    {
        mouseEnter = !mouseEnter;
    }
}

@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Enums;
@using Models.Entities
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

@if(ActivityModel != null){
    @if(ScheduleModel.IsActiveSchedule == true)
    {
        <div class="card shadow-sm p-3 mr-5 text-center d-flex flex-column justify-content-between">
            <span class="fw-bold schedule-name">@ScheduleModel.Name</span>
            @*<br />*@
            <div class="schedule-date">
                @ScheduleModel.DateTime
            </div>
            @* <br />*@
            <div class="schedule-text">
                ₱ @ScheduleModel.LongPrice / @ScheduleModel.PerUnit1 @ScheduleModel.PriceUnit1 / @ScheduleModel.PerUnit2 @ScheduleModel.PriceUnit2
            </div>
            @if (ScheduleModel.IsSetSession == true)
            {
                @*<br />*@
                <div class="schedule-text">
                    Consume in - @ScheduleModel.SessionName
                </div>
            }
            @*<br />*@
            @if (AuthState.User.Identity.IsAuthenticated)
            {
                if (ButtonType == ScheduleButtonType.Choose)
                {
                    <button class="btn-primary rounded border-0 shadow-sm text-decoration-none" id="choose-redirect" @onclick="OnClickChoose">Choose</button>
                }
                else
                {
                    <button class="btn-primary shadow-sm border-0 rounded" @onclick="OnClickChange">
                        Change
                    </button>
                }
            }
            else
            {
                <button class="btn-primary rounded border-0 shadow-sm" @onclick="() => modalLoginRef?.Show()">Choose</button>
            }
        </div>
    }
}
@if (!AuthState.User.Identity.IsAuthenticated)
{
    <ModalLogin @ref="modalLoginRef" ReturnUrl="@($"/Payment/{ActivityModel.Id}/{ScheduleModel.Id}")"></ModalLogin>
}

@code {
    [Parameter]
    public ActivitySchedule ScheduleModel { get; set; }
    [Parameter]
    public Activity ActivityModel { get; set; }
    [Parameter]
    public ScheduleButtonType ButtonType { get; set; } = ScheduleButtonType.Choose;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickChange { get; set; } = new EventCallback<MouseEventArgs>();

    [Parameter]
    public EventCallback OnChooseClick { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClickLogin { get; set; } = new EventCallback<MouseEventArgs>();

    public AuthenticationState AuthState { get; set; }

    private ModalLogin? modalLoginRef;

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
    }

    private void OnClickChoose()
    {
        NavigationManager.NavigateTo($"/Payment/{ActivityModel.Id}/{ScheduleModel.Id}");
        if(OnChooseClick.HasDelegate)
        {
            OnChooseClick.InvokeAsync();
        }
    }
}
@namespace Cinnamon.Web.Components
@using Cinnamon.Core


<div class="card shadow p-3 mr-5 text-center d-flex flex-column justify-content-between" style="font-size:0.9rem">
    @ScheduleModel.Name
    <br />
    <br />
    <div style="font-size:0.7rem">
     @ScheduleModel.UnitPrice @ScheduleModel.Price / @ScheduleModel.PerUnit1 @ScheduleModel.PriceUnit1 / @ScheduleModel.PerUnit2 @ScheduleModel.PriceUnit2
    </div>
    <button class="btn-primary rounded-pill shadow-sm">Choose</button>
</div>


@code {
    [Parameter]
    public ScheduleModel ScheduleModel { get; set; }
}

@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Google
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Cinnamon.Core.Module.CinnamonMakerService.Handler
@inject DataStoreDbContext waitList
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject Cinnamon.Core.Models.TokenProvider _tokenProvider;
@inject ISubmitWaitngList submitWaitingListHandler;

 <div class="w-100 text-center"> 
    @if (!viewModel.isSubmit)
    {
        <EditForm Model=viewModel OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex flex-column gap-3 align-items-center">
                <div class="col-12">
                <InputText id="email-signup" placeholder="Email" class="input-group fs-12" type="email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.waitListModel.Email />
                    <ValidationMessage style="text-align:left" For="() => viewModel.waitListModel.Email" />
                </div>
                <SignupButton id="signup-waiting" Width="100%" Text="Continue" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()"/>
                <p style="font-family:'Nunito';font-size:12px;font-weight:400;">By signing up you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>

            </div>
        </EditForm>
        <div class="divider">
            <hr class="left" />or<hr class="right" />
        </div>
        <div class="col-12">
              <form id="external-account" 
                    action="/Identity/Account/ExternalLogin" 
                    asp-route-returnUrl="/onboarding" 
                    method="post">
                 <input type="hidden" name="provider" value="Google">
                <input type="hidden" name="userType"  value="@TypeValue">
                <input type="hidden" name="returnUrl" value="">
                <button class="btn btn-md btn-google" type="submit"><img src="https://img.icons8.com/color/48/000000/gmail-new.png" class="img-icon" /> Continue with Gmail</button>
                <input name="__RequestVerificationToken" type="hidden" value="@_tokenProvider.AntiForgeryToken" />
            </form>
        </div>

    }    
</div>
<ModalPassword @ref="modalPassword"></ModalPassword>
<ValidationModal @ref="verify"></ValidationModal>

@code {
    IJSObjectReference module;

    public Modal modal { get; set; }

    ModalPassword modalPassword { get; set; }

    ValidationModal verify { get; set; }

    public List<WaitListModel> userList = new List<WaitListModel>();

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
        }
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }

    public async Task Submit()
    {
        if (viewModel.isValid(viewModel.waitListModel.Email))
        {
            userList = await CoreDI.DataStore.WaitList.GetAllAsync();
            var result = userList.Where(a => a.Email == viewModel.waitListModel.Email).FirstOrDefault();
            //Check if Account is Verified
            if (result !=null && result.IsVerified)
            {
                //If user is Verified display modal password
                await modalPassword.OpenModal(result.Email);
                viewModel.isClickButton = false;
            }
            // not yet verified the account but already submit an email
            else if(result != null && !result.IsVerified)
            {
                //Display Verification Modal
                    await verify.OpenModal();
                    viewModel.isClickButton = false;
            }
            else
            {
                //Register Account
                var register = await submitWaitingListHandler.ExecuteAsync(
                        new Core.Module.CinnamonMakerService.Interactors.SubmitWaitingList
                            { Email = viewModel.waitListModel.Email, UserType = UserType.Maker });

                if (register.Succeeded)
                {
                    //Display Verification Modal
                    await verify.OpenModal();
                    viewModel.isClickButton = false;
                }
            }
        }
    }
} 
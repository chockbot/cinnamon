@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Identity
@inject DataStoreDbContext waitList
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

 <div class="w-100 text-center"> 
    @if (!viewModel.isSubmit)
    {
            <EditForm Model=viewModel OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="d-flex flex-column gap-3 align-items-center">
                    <div class="col-12">
                    <InputText id="email-signup" placeholder="Email" class="input-group fs-12" type="email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.waitListModel.Email />
                        <ValidationMessage style="text-align:left" For="() => viewModel.userListModel.Email" />
                    </div>
                    <SignupButton id="signup-waiting" Width="100%" Text="Continue" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()"/>
                    <p style="font-family:'Nunito';font-size:12px;font-weight:400;">By signing up you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                    <div class="divider">
                        <hr class="left" />or<hr class="right" />
                    </div>
                     <div class="col-12">
                        <a class="btn btn-md btn-google" href="#"><img src="https://img.icons8.com/color/48/000000/gmail-new.png" class="img-icon" onclick="@LoginwithEmail()"/> Continue with Gmail</a>
                     </div>
                </div>
            </EditForm>
    }    
</div>
<!--Verify Modal-->
<Modal @ref="modal">
    <ModalContent Centered>
        <ModalHeader>
            <Column ColumnSize="ColumnSize.Is11" TextAlignment="TextAlignment.Center">
                <ModalTitle Style="font-family:'Nunito';font-size:18px;font-weight:700">Verification Email</ModalTitle>
            </Column>
            <CloseButton Style="border:none;background-color:transparent" />
        </ModalHeader>
        <ModalBody>
            <Heading Size="HeadingSize.Is5">Welcome to <Span Style="color:#ffa942;font-family:'Backline'">@Resources.App.appName</Span></Heading>
            <br />
            <Column ColumnSize="ColumnSize.Is12" TextAlignment="TextAlignment.Center">
                <Paragraph Style="font-family:'Nunito';font-size:14px;font-weight: 400;color:#343D4C">We've sent an email to your inbox. Please check and click verify.</Paragraph>
                <Paragraph Style="font-family:'Nunito';font-size:14px;font-weight: 400;color:#343D4C">Haven't received a verification email? <Link To="#" Style="color:#ffa942"> Resend</Link></Paragraph>
            </Column>
        </ModalBody>
    </ModalContent>
</Modal>
<ModalFinishSignUp></ModalFinishSignUp>
@code {
    IJSObjectReference module;

    public Modal modal { get; set; }

    public List<WaitListModel> userList = new List<WaitListModel>();

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
        }
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }
    public async Task LoginwithEmail()
    {
        //Login with Email
    }
    public async Task Submit()
    {
        if (viewModel.isValid(viewModel.waitListModel.Email))
        {
            userList = await CoreDI.DataStore.WaitList.GetAllAsync();
            var result = userList.Where(a => a.Email == viewModel.waitListModel.Email).FirstOrDefault();
            if (result != null)
            {
                //Already have an Account
                //Go to Creation Page
                NavigationManager.NavigateTo("Creation", true);
            }
            else
            {
                //Register Account
                var register = await CoreDI.CinnamonMakerService.SubmitWaitngList
                .ExecuteAsync(new Core.Module.CinnamonMakerService.Interactors.SubmitWaitingList
                    { Email = viewModel.waitListModel.Email, UserType = UserType.Maker });

                if (register.Succeeded)
                {
                    //Display Verification Modal
                    await modal.Show();
                }
            }
        }
    }
} 
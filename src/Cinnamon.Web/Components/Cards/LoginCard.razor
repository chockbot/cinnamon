@namespace Cinnamon.Web.Components
@using System.Linq.Expressions
@using Cinnamon.Core.Enums;
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Google
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc
@using Cinnamon.Web.Models.Account;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@inject IAccountApiHandler accountApiHandler;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject Cinnamon.Core.Models.TokenProvider _tokenProvider;

 <div class="w-100 text-center"> 
    @if (!isSubmit)
    {
        <EditForm Model=Model OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex flex-column gap-3 align-items-center">
                <div class="col-12">
                <InputText id="email-signup" placeholder="Email" class="input-group fs-12" type="email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=Model.Email />
                    <ValidationMessage style="text-align:left" For="() => Model.Email" />
                </div>
                <SignupButton id="signup-waiting" Width="100%" Text="Continue" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()"/>
                <p style="font-family:'Nunito';font-size:12px;font-weight:400;">By signing up you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>

            </div>
        </EditForm>
        <div class="divider">
            <hr class="left" />or<hr class="right" />
        </div>
        <div class="col-12">
              <form id="external-account" 
                    action="/Identity/Account/ExternalLogin" 
                    asp-route-returnUrl="/onboarding" 
                    method="post">
                <input type="hidden" name="provider" value="Google">
                <input type="hidden" name="userType"  value="@TypeValue">
                <input type="hidden" name="returnUrl" value="@ReturnUrl">
                <button class="btn btn-md btn-google" type="submit"><img src="https://img.icons8.com/color/48/000000/gmail-new.png" class="img-icon" /> Continue with Gmail</button>
                <input name="__RequestVerificationToken" type="hidden" value="@_tokenProvider.AntiForgeryToken" />
            </form>
        </div>

    }    
</div>
<ModalPassword @ref="modalPassword"></ModalPassword>
<ValidationModal @ref="verify" Email="@Model.Email"></ValidationModal>

@code {

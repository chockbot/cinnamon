@namespace Cinnamon.Web.Components
@using System.Linq.Expressions
@using Cinnamon.Web.Models.Account;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

 <div class="w-100 text-center"> 
    <EditForm Model=loginModel id="form-submit-login">
        <DataAnnotationsValidator />
        <div class="d-flex flex-column gap-3 align-items-center">
            <div class="col-12">
            <InputText id="text-login-password" placeholder="Password" class="input-group fs-12" type="password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=loginModel.Password />
            <input type="hidden" id="login-email-hidden" name="login-email-hidden" @bind-value="@Email" />
            </div>
            <div id="error-message-container" class="mb-4 error-message-container-submit-login">
                <ul id="error-list-login" class="fw-bold">
                </ul>
            </div>
            <SignupButton id="login-password" Width="100%" Text="Log In"/>
        </div>
    </EditForm>  
</div>

@code 
{
    IJSObjectReference module;

    public Modal modal { get; set; }

    [Parameter]
    public string Email { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    private LoginModel loginModel = new LoginModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
            await jsRuntime.InvokeVoidAsync("MyLib.Components.modal.passwordModal.init","");
        }
    }
} 
@namespace Cinnamon.Web.Components
@using System.Text;
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using Cinnamon.Core.Services;
@using Cinnamon.Core.Config;
@using Cinnamon.Web.Models;
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Identity
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject IJsonSerializationService jsonSerialization;
@inject CoreConfig coreConfig;

 <div class="w-100 text-center"> 
    @if (!viewModel.isSubmit)
    {
        <EditForm Model=viewModel id="form-submit-login">
            <DataAnnotationsValidator />
            <div class="d-flex flex-column gap-3 align-items-center">
                <div class="col-12">
                <InputText id="text-login-password" placeholder="Password" class="input-group fs-12" type="password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Password />
                <input type="hidden" id="login-email-hidden" name="login-email-hidden" @bind-value="@Email" />
                </div>
                <div id="error-message-container" class="mb-4 error-message-container-submit-login">
                    <ul id="error-list-login" class="fw-bold">
                    </ul>
                </div>
                <SignupButton id="login-password" Width="100%" Text="Log In" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()"/>
            </div>
        </EditForm>
    }    
</div>
@code {
    IJSObjectReference module;

    public Modal modal { get; set; }

    public List<WaitListModel> userList = new List<WaitListModel>();

    [Parameter]
    public string Email { get; set; }

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
            await jsRuntime.InvokeVoidAsync("MyLib.Components.modal.passwordModal.init","");
        }
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }
} 
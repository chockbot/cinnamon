@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Identity
@inject DataStoreDbContext waitList
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

 <div class="w-100 text-center"> 
    @if (!viewModel.isSubmit)
    {
        <EditForm Model=viewModel OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex flex-column gap-3 align-items-center">
                <div class="col-12">
                <InputText id="text-password" placeholder="Password" class="input-group fs-12" type="password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Password />
                </div>
                <div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
                    <ul id="error-list" class="fw-bold">
                        <li style="font-family:'Nunito';font-size:12px;">Invalid password! Please insert correct password.</li>
                    </ul>
                </div>
                <SignupButton id="login-password" Width="100%" Text="Log In" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()"/>
            </div>
        </EditForm>
    }    
</div>
@code {
    IJSObjectReference module;

    public Modal modal { get; set; }

    public List<WaitListModel> userList = new List<WaitListModel>();

    [Parameter]
    public string Email { get; set; }

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
        }
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }

    private string ShowErrorMessage()
    {
        return viewModel.HasError ? "block" : "none";
    }
    public async Task Submit()
    {
         if (viewModel.isValid(viewModel.Password))
        {
            userList = await CoreDI.DataStore.WaitList.GetAllAsync();
            var result = userList.Where(p => p.Email == Email).FirstOrDefault();

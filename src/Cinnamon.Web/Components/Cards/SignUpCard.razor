@namespace Cinnamon.Web.Components
<div class="w-100">
    <span>Join our waiting list to get notified when go live!</span>
    <hr />
    <div class="d-flex flex-column gap-3 align-items-center">
        <div class="d-flex gap-3">
            <div>
                <input type="radio" value="customer" id="customer" name="signup-value" checked />
                <label class="fw-bold" for="customer">Customer</label>
            </div>
            <div>
                <input type="radio" value="maker" id="maker" name="signup-value" />
                <label class="fw-bold text-nowrap" for="maker">Cinnamon Maker</label>
            </div>
        </div>
        <input class="input-group fs-5" style="border-radius:5px;border:0.5px solid black;padding:10px;" cla placeholder="Email" />
        <PrimaryButton Text="Sign-up" />
    </div>
</div>
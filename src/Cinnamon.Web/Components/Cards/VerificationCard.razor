@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@inject DataStoreDbContext waitList
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime


<EditForm Model=viewModel.waitListModel OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <div class="w-100 text-center">
        <div class="d-flex flex-column gap-3 align-items-center">
            <div class="col-12">
                <InputText id="email-signup" class="input-group fs-12" type="" style="border-radius:5px;border:0.5px solid black;padding:10px;" placeholder="Enter code" @bind-Value=viewModel.waitListModel.Email />
            </div>
            <p class="col-12" style="font-family:'Nunito';font-size:12px;font-weight:400;text-align:left">Haven't Received Verification Code? <a href="#" style="color:#FFA942">Resend Code</a></p>
            <br />
            <br />
            <br />
            <br />
            <br />
            <button class="btn-primary rounded-pill shadow-sm" type="submit" style="width:100%;white-space:nowrap;padding-right:60px;">
                <i id="spinner-loading" class="fa fa-spinner fa-spin" style="visibility:hidden"></i> Submit
            </button>
        </div>
    </div>
</EditForm>
 


@code {
    IJSObjectReference module;

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("Verification", "./js/Signup.js");
        }
    }
    public async Task Submit()
    {
       
    }
}

@* Need to refactor this component
should have Available dates, Selected Dates, *@

@namespace Cinnamon.Web.Components.Common

<div class="@WrapperClass">
    <div class="calendar-header d-flex align-items-center justify-content-between">
        <Button Clicked="PrevMonthClick">
            <img class="img-navigation cursor-pointer" src="images/back-icon.png" alt="prev">
        </Button>
        <div class="text-center font-20 font-weight-700 color-black-100 text-capitalize">@activeDate.ToString("MMMM")</div>
        <Button Clicked="NextMonthClick">
            <img style="transform: rotate(180deg);" class="img-navigation cursor-pointer" src="images/back-icon.png" alt="next">
        </Button>
    </div>
    <div class="calendar-grid-container">
        <div class="grid-item header">sun</div>
        <div class="grid-item header">mon</div>
        <div class="grid-item header">tue</div>
        <div class="grid-item header">wed</div>
        <div class="grid-item header">thu</div>
        <div class="grid-item header">fri</div>
        <div class="grid-item header">sat</div>
        @foreach (var item in calendarItems)
        {
            <div class="grid-item" @key="item">
                @if(!item.Empty)
                {
                    if (item.PastDate)
                    {
                        <Tooltip Text="Sorry, you cannot purchase tickets for past events." Multiline=true>
                        <span class="@DayClass(item.Selected, item.PastDate, item.StrikeOut, item.Date)" @onclick="() => OnDayClick(item)">
                            @NumberString(item.Date.Day)
                        </span>
                        </Tooltip>
                    }
                    else
                    {
                        <span class="@DayClass(item.Selected, item.PastDate, item.StrikeOut, item.Date)" @onclick="() => OnDayClick(item)">
                            @NumberString(item.Date.Day)
                        </span>
                    }
                }
                else {
                    <span class="@DayClass(false, false)"></span>
                }
            </div>
        }
    </div>
</div>

@code 
{
    [Parameter]
    public DateTime CurrentDate {get; set;}
    [Parameter]
    public IEnumerable<DateTime> SelectedDates {get; set;} = Enumerable.Empty<DateTime>();
    [Parameter]
    public bool ViewOnly {get; set;}
    [Parameter]
    public EventCallback<DateTime> OnSelectedDate {get; set;}
    [Parameter]
    public EventCallback<CalendarCurrentMonth> OnPreviousMonthChanged {get; set;}
    [Parameter]
    public EventCallback<CalendarCurrentMonth> OnNextMonthChanged {get; set;}
    [Parameter]
    public bool StrikeOutNotSelected {get; set;}
    [Parameter]
    public bool UnHighlightLoadedDates {get; set;}
    [Parameter]
    public bool Flat {get; set;}
    [Parameter]
    public bool StoreClickedItems {get; set;}

    private IList<CalendarItem> calendarItems = new List<CalendarItem>();
    private DateTime activeDate;
    private Dictionary<DateTime,CalendarItem> clickedItems = new();

    protected override void OnInitialized()
    {
        activeDate = CurrentDate;
        LoadCalendarItems();
    }

    public void LoadCalendarItems()
    {
        calendarItems.Clear();
        var now = activeDate;
        var startDate = new DateTime(now.Year, now.Month, 1);
        var endDate = startDate.AddMonths(1).AddDays(-1);
        var skipCount = (int)startDate.DayOfWeek;

        for(int i = 1; i < endDate.Day + (skipCount + 1); i++)
        {
            if(i <= skipCount)
            {
                calendarItems.Add(new CalendarItem {
                    Empty = true
                });
            }
            else
            {
                var currentDateTime = DateTime.Now;
                var date = new DateTime(now.Year, now.Month, i - skipCount, now.TimeOfDay.Hours, now.TimeOfDay.Minutes, now.TimeOfDay.Seconds);
                var selected = SelectedDates.Any(a => a.Date == date.Date);
                var pastDate = SelectedDates.Any(a => a.Date == date.Date && a <= currentDateTime);
                calendarItems.Add(new CalendarItem {
                    Empty = false,
                    Date = date,
                    Selected = selected && !pastDate,
                    StrikeOut = StrikeOutNotSelected && !selected,
                    PastDate = pastDate
                });
            }
        }
    }

    private string DayClass(bool selected, bool pastdate, bool strikeOut = false, DateTime? date = null)
    {
        string result = "day prevent-select";
        if(selected && !pastdate)
        {
            result += $" selected rounded-circle";
        }
        if (pastdate)
        {
            result += $" selected rounded-circle strike-out";
        }
        if(strikeOut)
        {
            result += $" strike-out";
        }
        if(selected && UnHighlightLoadedDates){
            result += " unhighlight";
        }
        if(date.HasValue)
        {
            if(clickedItems.ContainsKey(date.Value.Date))
            {
                result += " clicked rounded-circle";
            }
        }
        return result;
    }

    private string WrapperClass
    {
        get
        {
            string result = "calendar-wrapper";
            if(Flat) result += " flat";
            return result;
        }
    }

    private async Task OnDayClick(CalendarItem item)
    {
        if (item.StrikeOut) // Check if the date is struck out
        {
            return; // Exit early if the date is struck out
        }
        if (item.PastDate)
        {
            return; // Exit early if the date is struck out
        }
        if(!ViewOnly)
        {
            item.Selected = !item.Selected;
        }
        if(OnSelectedDate.HasDelegate)
        {
            await OnSelectedDate.InvokeAsync(item.Date);
        }
        await StoreClicked(item);
    }

    public IEnumerable<DateTime> GetClickedDates => clickedItems.Select(d => d.Key);

    private Task StoreClicked(CalendarItem item)
    {
        if(StoreClickedItems)
        {
            if(!clickedItems.ContainsKey(item.Date.Date))
            {
                clickedItems.Add(item.Date.Date, item);
            }
            else
            {
                clickedItems.Remove(item.Date.Date);
            }
        }
        return Task.CompletedTask;
    }

    private string NumberString(int number)
    {
        if(number.ToString().Length > 1) return number.ToString();
        return $"0{number}";
    }

    private async Task NextMonthClick()
    {
        if(activeDate != DateTime.MaxValue)
        {
            var date = activeDate.AddMonths(1);
            activeDate = date;

            LoadCalendarItems();
            if(OnNextMonthChanged.HasDelegate)
            {
                await OnNextMonthChanged.InvokeAsync(new CalendarCurrentMonth {
                    Month = date.Month,
                    Year = date.Year
                });
            }
        }
    }

    private async Task PrevMonthClick()
    {
        if(activeDate.Date != DateTime.MinValue)
        {
            var date = activeDate.AddMonths(-1);
            activeDate = date;

            LoadCalendarItems();
            if(OnPreviousMonthChanged.HasDelegate)
            {
               await OnPreviousMonthChanged.InvokeAsync(new CalendarCurrentMonth {
                    Month = date.Month,
                    Year = date.Year
                });
            }
        }
    }

    public Task LoadDates(IEnumerable<DateTime> dates, DateTime? currentDate = null)
    {
        SelectedDates = dates;
        if(currentDate.HasValue)
        {
            activeDate = currentDate.Value;
        }
        LoadCalendarItems();
        return Task.CompletedTask;
    }

    private class CalendarItem 
    {
        public DateTime Date {get; set;}
        public bool Empty {get; set;}
        public bool Selected {get; set;}
        public bool StrikeOut {get; set;}
        public bool PastDate { get; set; }
    }

    public class CalendarCurrentMonth 
    {
        public int Month {get; set;}
        public int Year {get; set;}
    }
}
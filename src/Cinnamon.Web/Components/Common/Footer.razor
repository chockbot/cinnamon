@code {
    private bool isAboutUsVisible = false;
    private bool isEventVisible = false;
    private string mailchimpEmail;
    private string subscriptionResultMessage;
    private string subscriptionResultClass;
    private bool showModal;
    public Profile CustomerModel = new Profile();
    public ClaimsPrincipal AuthState { get; set; }
    private bool isLogin { get; set; } = false;
    [Inject] HubConnection hubConnection { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadSigninUser();
    }

    private void NavigateToHelp()
    {
        NavigationManager.NavigateTo("/help");
    }

    void ToggleAboutUs() => isAboutUsVisible = !isAboutUsVisible;
    void ToggleEvents() => isEventVisible = !isEventVisible;

    private void NavigateToPrivacyPolicy()
    {
        NavigationManager.NavigateTo("/help?section=privacy");
    }

    private void NavigateToTermsConditions()
    {
        NavigationManager.NavigateTo("/help?section=terms");
    }

    private void NavigateToOnboarding()
    {
        NavigationManager.NavigateTo("/Onboarding");
    }

    private void NavigateToOTECreation()
    {
        NavigationManager.NavigateTo("/experiences/ote");
    }

    private async Task SubscribeUserToMailchimp()
    {

        var args = new SubscribeToMailchimpArgs
        {
            EmailAddress = mailchimpEmail
        };

        var result = await systemApiHandler.SubscribeToMailchimp(args);
        if (result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            subscriptionResultMessage = "Subscription successful!";
            subscriptionResultClass = "success";
            mailchimpEmail = string.Empty;
        }
        else
        {
            subscriptionResultMessage = "Subscription failed. Please try again.";
            subscriptionResultClass = "error";
        }

        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task LoadSigninUser()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;

        if (user != null && user.Identity.IsAuthenticated)
        {

            isLogin = true;

            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        ProfileImg = args.ProfileImg,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };

                if (hubConnection.State == HubConnectionState.Disconnected)
                {
                    try
                    {
                        await hubConnection.StartAsync();
                    }
                    catch (Exception ex)
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);

                        while (true)
                        {
                            try
                            {
                                await hubConnection.StartAsync();

                                break;
                            }
                            catch (ObjectDisposedException e)
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                            catch
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                        }
                    }
                }
            }
        }
    }
}

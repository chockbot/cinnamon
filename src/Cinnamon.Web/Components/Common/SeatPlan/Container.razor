@namespace Cinnamon.Web.Components.Common.SeatPlan
@using SeatPlanModels = Cinnamon.Framework.Models.SeatPlan;
@using Cinnamon.Framework.Providers;
@inject IJsonSerializationProvider JsonSerializationProvider;
@inject IJSRuntime jsRuntime;

<div id="seat-plan-container" class="w-100 overflow-hidden" style="position: relative;">
    @if (!string.IsNullOrEmpty(Image))
    {
        <div class="image-container" @onclick="() => imageViewer.ShowModal()">
            <img class="seat-image" src="@Image">
        </div>
    }
    <div class="categories-container" style="@GetCategoryStyle">
        @if(seatPlanFormat is not null)
        {
            @foreach (var category in seatPlanFormat.Categories)
            {
                <Cinnamon.Web.Components.Common.SeatPlan.Category 
                ViewOnly="ViewOnly" 
                SeatCategory="category.Value" 
                OnSeatSelected="OnSeatSelected"/>
            }
        }
    </div>
    @* <div class="seat-plan-actions text-end">
        <Button Clicked="ScaleUp" class="bg-orange-100 color-white-100" Border="Border.Is0">+</Button>
        <Button Clicked="ScaleDown" class="bg-orange-100 color-white-100" Border="Border.Is0">-</Button>
    </div> *@
</div>
<ImageViewer @ref="imageViewer" Image="@Image" />
@code
{
    [Parameter]
    public string Payload { get; set; }

    [Parameter]
    public EventCallback<Category.SelectedSeat> OnSeatSelected { get; set; }

    [Parameter]
    public bool ViewOnly { get; set; }


    [Parameter]
    public string Image { get; set; }

    private ImageViewer imageViewer;

    private SeatPlanModels.Format? seatPlanFormat;

    private const float MAXSCALE = 1.5f;
    private const float MINSCALE = 0.4f;
    private float currentScale = 0.7f;

    protected override async Task OnInitializedAsync()
    {
        await SerializePayload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Utils.dragElement", "#seat-plan-container", ".categories-container");
        }
    }

    private Task SerializePayload()
    {
        if (Payload is not null)
        {
            seatPlanFormat = JsonSerializationProvider.Deserialize<SeatPlanModels.Format>(Payload);
        }

        return Task.CompletedTask;
    }

    private Task ScaleUp()
    {
        if (currentScale < MAXSCALE)
        {
            currentScale += 0.1f;
        }

        return Task.CompletedTask;
    }

    private Task ScaleDown()
    {
        if (currentScale > MINSCALE)
        {
            currentScale -= 0.1f;
        }

        return Task.CompletedTask;
    }

    private string GetCategoryStyle 
    {
        get
        {
            return "";
            //return $"transform: scale({currentScale});";
        }
    }
}
@namespace Cinnamon.Web.Components.Common

<div class="select-calendar-wrapper position-relative" @onblur="() => displayCalendar = false">
    <div class="input prevent-select" @onclick="() => displayCalendar = !displayCalendar">
        <span class="font-18 color-grey-100">
            @(selectedDate.HasValue ? selectedDate.Value.ToString("MMMM dd, yyyy") : "")
        </span>
        <span>
            <img src="images/arrow-down.png" alt="arrow">
        </span>
    </div>
    <div class="@DisplayCalendar">
        <Calendar ViewOnly="ViewOnly" StrikeOutNotSelected="StrikeOutNotSelected" 
            SelectedDates="SelectedDates" OnSelectedDate="SelectedDate" CurrentDate="CurrentDate"
            OnNextMonthChanged="OnNextMonthChanged" OnPreviousMonthChanged="OnPreviousMonthChanged" />
    </div>
</div>

@code 
{
    [Parameter]
    public IEnumerable<DateTime> SelectedDates {get; set;} = Enumerable.Empty<DateTime>();
    [Parameter]
    public DateTime CurrentDate {get; set;}
    [Parameter]
    public bool ViewOnly {get; set;}
    [Parameter]
    public EventCallback<DateTime> OnSelectedDate {get; set;}
    [Parameter]
    public bool StrikeOutNotSelected {get; set;}

    private bool displayCalendar {get; set;}
    private DateTime? selectedDate;

    [Parameter]
    public EventCallback<Calendar.CalendarCurrentMonth>? OnPreviousMonthChanged {get; set;}
    [Parameter]
    public EventCallback<Calendar.CalendarCurrentMonth>? OnNextMonthChanged {get; set;}

    protected override void OnInitialized()
    {
        selectedDate = SelectedDates.Where(a => a.Date >= DateTime.UtcNow).FirstOrDefault();
    }

    private string DisplayCalendar
    {
        get
        {
            string result = "calendar-container mt-1";
            if(!displayCalendar) 
            {
                result += " d-none";
            }
            return result;
        }
    }

    private async Task SelectedDate(DateTime date)
    {
        if(SelectedDates.Any(d => d.Date == date.Date))
        {
            displayCalendar = false;
            selectedDate = date;
            if(OnSelectedDate.HasDelegate)
            {
                await OnSelectedDate.InvokeAsync(date);
            }
        }
    }
}
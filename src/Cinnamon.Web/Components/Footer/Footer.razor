@namespace Cinnamon.Web.Components
<div class="footer px-4">
    <div class="footer-content text-center d-lg-block d-md-none d-sm-none d-none">
        <span class="footer-appname color-primary">@Resources.App.appName</span>
        <div class="social-section">
            <a href="#">
                <img src="/images/facebook.png" />
            </a>
            <a href="#">
                <img src="/images/instagram.png" />
            </a>
            <a href="#">
                <img src="/images/linkedin.png" />
            </a>
        </div>
        <span class="footer-text">
            Copyright © @year. All rights reserved.
        </span>
    </div>
</div>
@code {
    int year = DateTime.Now.Year;
}

@namespace Cinnamon.Web.Components
@using System
@using System.Text.RegularExpressions;
@using Cinnamon.Web.Models.Customer;
@using Cinnamon.Web.Modules.ApiAccess.Handlers

<Modal @ref="modalReference" Class="view-image-modal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" @onclick="() => modalReference.Hide()"></button>
            </div>
            <div class="modal-body text-center">
                <label class="guide-title">
                    How it will look like
                </label>
                <div class="row">
                    @foreach (var item in imagePathsSplitted)
                    {
                        <div class="col-lg-12">
                            <img class="front-image" src="@item" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</Modal>

@code {
    public string ImagePath { get; set; }
    private List<string> imagePathsSplitted = new List<string>();

    private Blazorise.Modal modalReference = new Modal();

    public Task ShowModal(string imagePath)
    {
        ImagePath = imagePath;
        imagePathsSplitted = imagePath.Split("|").ToList();
        return modalReference.Show();
    }
    public Task HideModal()
    {
        return modalReference.Hide();
    }

}

@namespace Cinnamon.Web.Components
@using System.Linq;
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject IAccountApiHandler accountApiHandler;


<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <ul class="list-group list-group-flush">
                        @*<li class="list-group-item">
                            <h5 class="font-weight-bold align-items-start">Location</h5>
                            <select class="form-control" aria-label="Default select example">
                                <option selected>All Location</option>*@
                                @* @foreach (var act in address)
                                {
                                    cnt++;
                                    <option value=@cnt>@act.District, @act.City</option>
                                } *@
                            @*</select>
                            <br />
                        </li>*@
                        <li class="list-group-item">
                            <h5 class="font-weight-bold align-items-start">Categories</h5>
                            <div class="row">
                                @foreach(var type in activityTypes)
                                {
                                     if(type.subCategory.Id%2==0)
                                    {
                                        <div class="col-lg-6 col-md-6 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" @bind-value="type.IsSelected" id="flexCheckChecked+@type.subCategory.Id">
                                                <label class="form-check-label" for="flexCheckChecked1">
                                                    @type.subCategory.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-lg-6 col-md-6 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" @bind-value="type.IsSelected" id="flexCheckChecked+@type.subCategory.Id">
                                                <label class="form-check-label" for="flexCheckChecked1">
                                                    @type.subCategory.Name
                                                </label>
                                            </div>
                                        </div>
                                    } 
                                    cnt++;
                                }
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button @onclick="OnSelecteCategories" type="button" class="btn" style="background-color:#ffa942;color:white" data-bs-dismiss="modal">Apply</button>
            </div>
        </div>
    </div>
</div>

@code 
{
    public List<SubCategory>            subCategories = new List<SubCategory>();
    public IList<SelectedSubCategories> activityTypes = new List<SelectedSubCategories>();
    public int cnt                                    = 0;
    private string selectedString { get; set; }
    [Parameter]
    public EventCallback<int[]> OnSelectedIdsChanged { get; set; }
    protected override async Task OnInitializedAsync()
    {
        //Get All SubCategory
        var result = await activityApiHandler.GetSubCategories();
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            subCategories = result.Result.Result.Select(s =>
            {
                return new SubCategory
                {
                    Id         = s.Id,
                    Name       = s.Name,
                    CategoryId = s.CategoryId
                };
            }).ToList();
        }
        activityTypes = subCategories.Select(i => new SelectedSubCategories
            {
                IsSelected = false,
                subCategory = i
            }).ToList();
    }
    public class SelectedSubCategories 
    {
        public bool IsSelected {get; set;}

        public SubCategory subCategory { get; set; }
    }

    private async Task OnSelecteCategories()
    {
        
        var selectedIds = activityTypes
            .Where(i => i.IsSelected)
            .Select(i => i.subCategory.Id)
            .ToArray();
        await OnSelectedIdsChanged.InvokeAsync(selectedIds);
    }
}

@namespace Cinnamon.Web.Components
@using Cinnamon.Core.Enums
@using Cinnamon.Web.Components
@using Cinnamon.Data
@using Cinnamon.Core
@using System.Text
@using System.Globalization

<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Filter</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item">
                            <h5 class="font-weight-bold align-items-start">Location</h5>
                            <select class="form-select" aria-label="Default select example" value="@selectedValue">
                                <option selected>All Location</option>
                                @foreach (var act in distinctActivity)
                                {
                                    cnt++;
                                    <option value=@cnt>@act.Location</option>
                                }
                            </select>
                            <br />
                        </li>
                        <li class="list-group-item">
                            <h5 class="font-weight-bold align-items-start">Categories</h5>
                            <div class="row">
                                @foreach(var type in activityTypes)
                                {
                                    if(type.Id%2==0)
                                    {
                                        <div class="col-lg-6 col-md-6 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="" id="flexCheckChecked+@type.Id">
                                                <label class="form-check-label" for="flexCheckChecked1">
                                                    @type.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-lg-6 col-md-6 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" value="" id="flexCheckChecked+@type.Id">
                                                <label class="form-check-label" for="flexCheckChecked1">
                                                    @type.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                    cnt++;
                                }
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color:#ffa942;color:white">Apply</button>
            </div>
        </div>
    </div>
</div>
@code {
    public List<ActivityModel> activity              = new List<ActivityModel>();
    public List<ActivityModel> distinctActivity      = new List<ActivityModel>();
    public List<ActivityTypeModel> activityTypes     = new List<ActivityTypeModel>();
    public int cnt                                   = 0;
    private int selectedValue { get; set; }
    protected override async Task OnInitializedAsync()
    {
        activity         = await CoreDI.DataStore.Activities.GetAllAsync();
        activityTypes    = await CoreDI.DataStore.ActivityTypes.GetAllAsync();
        distinctActivity = activity.GroupBy(p => p.Location).Select(grp => grp.First()).ToList();
    }


}

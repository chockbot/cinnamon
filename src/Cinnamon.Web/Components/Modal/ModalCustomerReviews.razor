@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Pages
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler

<Modal @ref="modalRef" class="multiple-review-modal" Padding="Padding.Is0">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-block">
                <div class="row d-flex">
                    <div class="col-lg-11 col-md-11 col-10">
                        <p class="your-reviews">Your Reviews (@ReviewsCount)</p>
                    </div>
                    <div class="col-lg-1 col-md-1 col-2 justify-content-end">
                        <button type="button" class="btn-close" @onclick="() => HideModal()"></button>
                    </div>
                </div>
            </div>
            <div class="modal-body">
                <div class="conversation-section">
                    <InfiniteScroll ObserverTargetId="customer-observerTarget" ObservableTargetReach="(e)=> GetReviews(false, true)">
                        @foreach (var item in ReviewsHistory)
                         {
                             @if (Profile != null)
                             {
                                 var activity = Activities.Where(a => a.ActivityId == item.ActivityId).FirstOrDefault();
                                 <div class="xp-body-item d-flex">
                                     <div class="activity-img">
                                         <img class="rounded-2 rounded-circle" src="@Profile.ProfilePath" />
                                     </div>
                                     <div>
                                         <p class="customer-name">@Profile.FirstName @Profile.LastName</p>
                                         <Rating Color="Color.Primary" SelectedValue="@item.Rating" MaxValue="5" ReadOnly=true />
                                     </div>
                                 </div>
                                 <div class="xp-activity">
                                     <p class="xp-title">@activity.Title (@activity.ActivitySchedules.Where(a=>a.Id == item.ScheduleId).First().Name)</p>
                                 </div>
                                 <div class="xp-body-item">
                                     <p class="secondary-caption">@item.Review</p>
                                 </div>
                             }
                         }
                        @if (isLoading)
                        {
                            <div class="loading-section d-flex flex-row justify-content-center">
                                <div class="spinner-border">
                                </div>
                            </div>
                        }
                        <div id="customer-observerTarget"></div>
                    </InfiniteScroll>

                </div>
            </div>
        </div>
    </div>
</Modal>

@code {
    private Modal modalRef;
  
    [Parameter]
    public CustomerProfile Profile { get; set; }

    [Parameter]
    public IEnumerable<Activity> Activities { get; set; }

    [Parameter]
    public int ReviewsCount { get; set; }

    public List<Reviews> ReviewsHistory = new List<Reviews>();


    private bool isLoading = false;

    private int pageIndex = 1;

    private int countPerPage = 10;

    public Task ShowModal()
    {
        return modalRef.Show();
    }

    public Task HideModal()
    {
        return modalRef.Hide();
    }
    public async Task GetReviews(bool fromClick, bool fromScroll)
    {
        isLoading = true;

        if (fromClick)
        {
            pageIndex = 1;
        }
        var reviewsResult = await ongoingApiHandler.GetReviewsByCustomerId(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetReviewsByCustomerIdArgs
            {
                CustomerId = Profile.Id,
                CountPerPage = countPerPage,
                PageIndex = pageIndex
            });
        if (reviewsResult.Succeeded && reviewsResult.Result != null && reviewsResult.Result.IsSuccess)
        {
            var reviews = reviewsResult.Result.Result.Select(a =>
            {
                return new Reviews
                    {
                        Id = a.Id,
                        CustomerId = a.CustomerId,
                        MakerId = a.MakerId,
                        ActivityId = a.ActivityId,
                        ScheduleId = a.ScheduleId,
                        StudentId = a.StudentId,
                        Review = a.Review,
                        Rating = a.Rating,
                        ReviewDate = a.ReviewDate
                    };
            }).OrderByDescending(a => a.ReviewDate).ToList();
            if (fromScroll)
            {
                ReviewsHistory.AddRange(reviews);
                ReviewsHistory = ReviewsHistory.OrderBy(c => c.ReviewDate).ToList();
            }
            else
            {
                ReviewsHistory = reviews;
            }
            pageIndex = reviewsResult.Result.Pagination.PageIndex.GetValueOrDefault() + 1;
        }
        isLoading = false;
    }
}

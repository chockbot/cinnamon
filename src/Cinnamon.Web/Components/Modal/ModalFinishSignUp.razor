@namespace Cinnamon.Web.Components
@using Microsoft.AspNetCore.Identity;
@using Cinnamon.Core.Common;
@using Cinnamon.Core
@using Cinnamon.Core.Models;
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using Cinnamon.Core.Module.CinnamonMakerService.Handler;
@using System.Linq.Expressions
@inject DataStoreDbContext user
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject IRegisterMaker registerMakerHandler;
@inject UserManager<IdentityUser> userManager;

<div class="modal @ModalClass" id="finishModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@ModalDisplay">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Finish signing up</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@(() => CloseModal())"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    @if(!viewModel.isSubmit)
                    {
                    <EditForm Model=viewModel OnValidSubmit="Submit">
                        <DataAnnotationsValidator />
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <InputText id="firstname-signup" class="input-group fs-12" placeholder="First name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.FirstName />
                                    <ValidationMessage style="text-align:left" For="() => viewModel.Customer.FirstName" />
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="lastname-signup" class="input-group fs-12" placeholder="Last name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.LastName />
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.LastName" />
                                <p>Be sure it's the same as what appears on your government ID.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="birtdate-signup" type="date" class="input-group fs-12" placeholder="Birthdate" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.Birthdate />
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.Birthdate" />
                                <p>The minimum age to join is 18. Unlike Facebook, Cinnamon won't tell anybody else about your birthday.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="email-signup" type="email" class="input-group fs-12" placeholder="Email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.Email disabled/>
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.Email" />
                                <p>For email confirmations, and receipts.</p>
                            </div>
                            <div class="col-12">
                                <InputText id="password-signup" type="password" class="input-group fs-12" placeholder="Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Password />
                                    <ValidationMessage style="text-align:left" For="() => viewModel.Password" />
                            </div>
                            <div class="col-12">
                                <InputText id="confirm-signup" type="password" class="input-group fs-12" placeholder="Confirm Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.ConfirmPassword />
                                <ValidationMessage style="text-align:left" For="() => viewModel.ConfirmPassword" />
                            </div>
                                <!--Error Message-->
                                <div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
                                    <ul id="error-list" class="fw-bold">
                                        <li style="font-family:'Nunito';font-size:14px;">@ErrorText</li>
                                    </ul>
                                </div>
                            <p>By selecting <b>Agree and continue</b>,you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                            <SignupButton id="signup-waiting" Width="100%" Text="Agree and continue" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()" />
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="defaultCheck1" @bind=viewModel.Customer.AcceptFlag>
                                    <label class="form-check-label" for="defaultCheck1" style="font-family:'Nunito';font-size:12px;font-weight:400;">
                                        I do not wish to receive promotional communications from Cinnamon.
                                  </label>
                                </div>
                            </div>
                        </div>  
                    </EditForm>
                    }
                </div>
            </div>
        </div>  
    </div>
</div>
@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}
@code {
    IJSObjectReference module;

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public bool ShowBackdrop = false;

    public string ErrorText { get; set; }

    public void OnSelect(ChangeEventArgs args)
    {
        UserType usertype;
        Enum.TryParse(args.Value.ToString(), out usertype);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
        }
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }
    private string ShowErrorMessage()
    {
        return viewModel.HasError ? "block" : "none";
    }
    public async Task OpenModal(string Email)
    {
        ModalDisplay                  = "block;";
        ModalClass                    = "show";
        ShowBackdrop                  = true;
        viewModel.Customer.Email = Email;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass      = "";
        ModalDisplay    = "none;";
        StateHasChanged();
    }
    public async Task Submit()
    {
        if (viewModel.isValid(viewModel.Customer.Email) && viewModel.isValid(viewModel.Customer.FirstName) &&
        viewModel.isValid(viewModel.Customer.LastName) && viewModel.isValid(viewModel.Customer.Birthdate.ToString()))
        {
            if (viewModel.isValidPassword(viewModel.Password, viewModel.ConfirmPassword))
            {
                var user = await userManager.FindByEmailAsync(viewModel.Customer.Email);
                if(user == null)
                {
                    var registerRes = await registerMakerHandler.ExecuteAsync(new Core.Module.CinnamonMakerService.Interactors.RegisterMaker 
                        {
                            AcceptFlag = viewModel.Customer.AcceptFlag,
                            Birthdate = viewModel.Customer.Birthdate,
                            Email = viewModel.Customer.Email,
                            FirstName = viewModel.Customer.FirstName,
                            LastName = viewModel.Customer.LastName,
                            Password = viewModel.Password                            
                        });
                    if(registerRes.Succeeded)
                    {
                        await jsRuntime.InvokeVoidAsync("MyLib.Track", "User Signup");
                        viewModel.isSubmit = true;
                        viewModel.isClickButton = false;
                        NavigationManager.NavigateTo("Creation");
                    }
                }
            }
            else
            {
                viewModel.HasError = true;
                ErrorText = "Password and confirm password are not match.";
                viewModel.isClickButton = false;
            }
        }
        else
        {
            viewModel.HasError = true;
            ErrorText = "Kindly fill out the form to proceed signing up.";
            viewModel.isClickButton = false;
        }
    }
}
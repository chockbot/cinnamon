@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models.Customer;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

<Modal @ref="ModalRef" Closing="ModalClosing">
    <ModalContent>
        <ModalHeader>
            <p class="col-12 modal-title text-center">Finish Signing Up</p>
            <button type="button" class="btn-close" @onclick="() => ModalRef.Hide()" />
        </ModalHeader>
        <ModalBody>
            <div class="card-filter">
                <Validations Mode="ValidationMode.Manual" @ref="viewModel.FormValidation" Model="viewModel">
                    <Validation>
                        <Field>
                            <FieldLabel>First Name</FieldLabel>
                            <TextEdit Placeholder="First name" @bind-Text="viewModel.FirstName">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <p></p>
                    <Validation>
                        <Field>
                            <FieldLabel>Last Name</FieldLabel>
                            <TextEdit  Placeholder="your lastname" @bind-Text="viewModel.LastName">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <p class="sub-info">Be sure it's the same as what appears on your government ID.</p>
                    <Validation>
                        <Field>
                            <FieldLabel>BirthDate</FieldLabel>
                            <DateEdit Placeholder="your birthdate" TValue="DateTime" @bind-Date="viewModel.Birthdate">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DateEdit>  
                        </Field>
                    </Validation>
                    <p class="sub-info">The minimum age to join is 18. Unlike Facebook, Cinnamon won't tell anybody else about your birthday.</p>
                    <Validation>
                        <Field>
                            <FieldLabel>Email Address</FieldLabel>
                            <TextEdit Disabled Role="TextRole.Email" Placeholder="your email" @bind-Text="viewModel.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>  
                        </Field>
                    </Validation>
                    <p class="sub-info">For email confirmations, and receipts.</p>
                    <Validation>
                        <Field>
                            <FieldLabel>Password</FieldLabel>
                            <div class="password-content">
                                <TextEdit Role="TextRole.Password" Placeholder="your password" @bind-Text="viewModel.Password" class="input-password">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </div>
                        </Field>
                    </Validation>
                    <p></p>
                    <Validation>
                        <Field>
                            <FieldLabel>Confirm Password</FieldLabel>
                            <div class="password-content">
                                <TextEdit Role="TextRole.Password" Placeholder="your password" @bind-Text="viewModel.ConfirmPassword" class="input-password">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </div>
                        </Field>
                    </Validation>
                    <p>By selecting <b>Agree and continue</b>,you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                    <div>
                        <Button Clicked="SubmitRegister" Margin="Margin.Is3.FromTop" Shadow="Shadow.Small" class="btn-primary"
                                Disabled="viewModel.IsSubmitting" Loading="viewModel.IsSubmitting">
                            <LoadingTemplate>
                                <i class="fa fa-spinner fa-spin"></i> Please Wait
                            </LoadingTemplate>
                            <ChildContent>
                                Agree and continue
                            </ChildContent>
                        </Button>
                        <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="viewModel.IsShowErrorMessage">
                            <AlertDescription>@viewModel.Message</AlertDescription>
                        </Alert>
                        <Alert Color="Color.Success" Margin="Margin.Is3.FromTop" Visible="viewModel.IsShowSuccessMessage">
                            <AlertDescription>@viewModel.Message</AlertDescription>
                        </Alert>
                    </div>
                </Validations>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>

@code 
{
    IJSObjectReference module;

    private SignupModel viewModel = new SignupModel();

    private Modal ModalRef {get; set;}

    protected override void OnInitialized()
    {
        viewModel.Birthdate = DateTime.Today.AddYears(-25);
    }

    public void OpenModal(string Email)
    {
        ModalRef.Show();
        viewModel.Email = Email;
        StateHasChanged();
    }

    public void CloseModal()
    {
        ModalRef.Hide();
        StateHasChanged();
    }

    private async Task SubmitRegister()
    {
        try
        {
            if (await viewModel.FormValidation.ValidateAll())
            {
                viewModel.IsSubmitting = true;

                var result = await jsRuntime.InvokeAsync<Models.JsResultModel>("MyLib.Components.modal.finishSignUpModal.init",
                        new {
                            firstname = viewModel.FirstName,
                            lastname = viewModel.LastName,
                            email = viewModel.Email,
                            birthdate = viewModel.Birthdate,
                            password = viewModel.Password 
                        });

                viewModel.IsSubmitting = false;

                if (!result.Success)
                {
                    viewModel.Message = result.Message;
                    viewModel.IsShowErrorMessage = true;
                    return;
                }

                NavigationManager.NavigateTo("/explore", true);
            }
        }
        catch
        {
            viewModel.Message = "An error occured. Please try again later";
            viewModel.IsShowErrorMessage = true;
        }
    }

    private Task ModalClosing(ModalClosingEventArgs e)
    {
        if(e.CloseReason == CloseReason.FocusLostClosing)
        {
            e.Cancel = true;
        }
        return Task.CompletedTask;
    }

    string flexItemStyle = $" width:660px;";
}
@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models.Customer;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

<Modal @ref="ModalRef" Closing="ModalClosing">
    <ModalContent class="modal-finish-signup">
        <ModalHeader>
            <p class="col-12 modal-title text-center">Finish Signing Up</p>
            <button type="button" class="btn-close" @onclick="() => ModalRef.Hide()" />
        </ModalHeader>
        <ModalBody>
            <div class="card-filter">
                <Validations Mode="ValidationMode.Manual" @ref="viewModel.FormValidation" Model="viewModel">
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel>First Name</FieldLabel>
                            <TextEdit Placeholder="First name" @bind-Text="viewModel.FirstName">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel>Last Name</FieldLabel>
                            <TextEdit  Placeholder="Last name" @bind-Text="viewModel.LastName">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field>
                            <FieldLabel>Birth Date</FieldLabel>
                            <DatePicker DisplayFormat="MMMM-yyyy" @bind-Date=viewModel.Birthdate Placeholder="Your birthday" TValue="DateTime">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DatePicker>
                        </Field>
                    </Validation>
                    <p class="sub-info">The minimum age to join is 13.</p>
                    <Validation>
                        <Field>
                            <FieldLabel>Email Address</FieldLabel>
                            <TextEdit Disabled Role="TextRole.Email" Placeholder="your email" @bind-Text="viewModel.Email">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>  
                        </Field>
                    </Validation>
                    <p class="sub-info">For email confirmations, and receipts.</p>
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel>Mobile Number</FieldLabel>
                            <TextEdit @bind-Text="viewModel.PhoneNumber">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel>Password</FieldLabel>
                            <div class="password-content">
                                @* create two textedit for toggle show password for safari issue *@
                                <div class='@(viewModel.IsRevealPassword ? "d-block" : "d-none")'>
                                    <TextEdit Role="TextRole.Text"
                                        Placeholder="Password should be at least 6 characters long" @bind-Text="viewModel.Password" class="input-password">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </div>
                                <div class='@(!viewModel.IsRevealPassword ? "d-block" : "d-none")'>
                                    <TextEdit Role="TextRole.Password"
                                        Placeholder="Password should be at least 6 characters long" @bind-Text="viewModel.Password" class="input-password">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </div>
                                <span class="fa fa-fw fa-eye field-icon toggle-password" 
                                    @onclick="() => viewModel.IsRevealPassword = !viewModel.IsRevealPassword"></span>
                            </div>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel>Confirm Password</FieldLabel>
                            <div class="password-content">
                                @* create two textedit for toggle show password for safari issue *@
                                <div class='@(viewModel.IsRevealConfirmPassword ? "d-block" : "d-none")'>
                                    <TextEdit KeyDown="OnConfirmPasswordTextSubmit" Role="TextRole.Text"
                                        Placeholder="Retype your password" @bind-Text="viewModel.ConfirmPassword" class="input-password">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </div>
                                <div class='@(!viewModel.IsRevealConfirmPassword ? "d-block" : "d-none")'>
                                    <TextEdit KeyDown="OnConfirmPasswordTextSubmit" Role="TextRole.Password"
                                        Placeholder="Retype your password" @bind-Text="viewModel.ConfirmPassword" class="input-password">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </div>
                                <span class="fa fa-fw fa-eye field-icon toggle-password" 
                                    @onclick="() => viewModel.IsRevealConfirmPassword = !viewModel.IsRevealConfirmPassword"></span>
                            </div>
                        </Field>
                    </Validation>
                    <label class="d-flex" style="align-items: last baseline;">
                        <InputCheckbox @bind-Value="IsAcceptPrivacyPolicy" class="@GetCheckboxClass"/>
                        <span class="font-16">
                            I have read and agreed to the website 
                            <NavLink href="/help/terms" target="_blank" class="color-primary hover-color-primary">Terms and Conditions</NavLink> and 
                            <NavLink href="/help/privacy" target="_blank" class="color-primary hover-color-primary">Privacy Policy</NavLink>
                        </span>
                    </label>
                    @if(IsShowCheckboxError)
                    {
                        <div class="invalid-feedback d-block">Please accept terms and condition and privacy policy</div>
                    }
                    <div>
                        <Button Clicked="SubmitRegister" Margin="Margin.Is3.FromTop" Shadow="Shadow.Small" class="btn-primary"
                                Disabled="viewModel.IsSubmitting" Loading="viewModel.IsSubmitting">
                            <LoadingTemplate>
                                <i class="fa fa-spinner fa-spin"></i> Please Wait
                            </LoadingTemplate>
                            <ChildContent>
                                Agree and continue
                            </ChildContent>
                        </Button>
                        <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="viewModel.IsShowErrorMessage">
                            <AlertDescription>@viewModel.Message</AlertDescription>
                        </Alert>
                        <Alert Color="Color.Success" Margin="Margin.Is3.FromTop" Visible="viewModel.IsShowSuccessMessage">
                            <AlertDescription>@viewModel.Message</AlertDescription>
                        </Alert>
                    </div>
                </Validations>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>

@code 
{
    IJSObjectReference module;

    private SignupModel viewModel = new SignupModel();

    private Modal ModalRef {get; set;}

    private bool IsAcceptPrivacyPolicy {get; set;}

    private bool IsShowCheckboxError {get; set;}

    IReadOnlyList<DateTime?> selectedDates;

    protected override void OnInitialized()
    {
        viewModel.Birthdate = DateTime.Today.AddYears(-25);
    }

    public void OpenModal(string Email)
    {
        ModalRef.Show();
        viewModel.Email = Email;
        StateHasChanged();
    }

    public void CloseModal()
    {
        ModalRef.Hide();
        StateHasChanged();
    }

    private async Task SubmitRegister()
    {
        try
        {
            IsShowCheckboxError = !IsAcceptPrivacyPolicy;
            if (await viewModel.FormValidation.ValidateAll() && IsAcceptPrivacyPolicy)
            {
                viewModel.IsSubmitting = true;

                var result = await jsRuntime.InvokeAsync<Models.JsResultModel>("MyLib.Components.modal.finishSignUpModal.init",
                        new {
                            firstname = viewModel.FirstName,
                            lastname = viewModel.LastName,
                            email = viewModel.Email,
                            birthdate = viewModel.Birthdate,
                            phoneNumber = viewModel.PhoneNumber,
                            password = viewModel.Password,
                            hasAcceptedTerms = IsAcceptPrivacyPolicy
                        });

                viewModel.IsSubmitting = false;

                if (!result.Success)
                {
                    viewModel.Message = result.Message;
                    viewModel.IsShowErrorMessage = true;
                    return;
                }

                NavigationManager.NavigateTo("/explore?IsNewRegistered=true", true);
            }
        }
        catch
        {
            viewModel.Message = "An error occured. Please try again later";
            viewModel.IsShowErrorMessage = true;
        }
    }

    private Task ModalClosing(ModalClosingEventArgs e)
    {
        if(e.CloseReason == CloseReason.FocusLostClosing)
        {
            e.Cancel = true;
        }
        return Task.CompletedTask;
    }

    private Task OnConfirmPasswordTextSubmit(KeyboardEventArgs e)
    {
        if(e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            return SubmitRegister();
        }

        return Task.CompletedTask;
    }

    private string GetCheckboxClass 
    {
        get 
        {
            if(IsAcceptPrivacyPolicy) return "me-3";

            return "me-3 is-invalid";
        }
    }

    string flexItemStyle = $" width:660px;";
}
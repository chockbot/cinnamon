@namespace Cinnamon.Web.Components
@using System.Linq.Expressions
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

<div class="modal @viewModel.ModalClass" id="finishModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@viewModel.ModalDisplay">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Finish signing up</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@(() => CloseModal())"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    @if(!viewModel.isSubmit)
                    {
                    <EditForm Model=viewModel id="submitFinishSignup">
                        <DataAnnotationsValidator />
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <InputText id="firstname-signup-finish" class="input-group fs-12" placeholder="First name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.FirstName />
                                    <ValidationMessage style="text-align:left" For="() => viewModel.Customer.FirstName" />
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="lastname-signup-finish" class="input-group fs-12" placeholder="Last name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.LastName />
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.LastName" />
                                <p>Be sure it's the same as what appears on your government ID.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="birtdate-signup-finish" type="date" class="input-group fs-12" placeholder="Birthdate" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.Birthdate />
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.Birthdate" />
                                <p>The minimum age to join is 18. Unlike Facebook, Cinnamon won't tell anybody else about your birthday.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="email-signup-finish" type="email" class="input-group fs-12" placeholder="Email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Customer.Email disabled/>
                                <ValidationMessage style="text-align:left" For="() => viewModel.Customer.Email" />
                                <p>For email confirmations, and receipts.</p>
                            </div>
                            <div class="col-12">
                                <InputText id="password-signup-finish" type="password" class="input-group fs-12" placeholder="Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.Password />
                                    <ValidationMessage style="text-align:left" For="() => viewModel.Password" />
                            </div>
                            <div class="col-12">
                                <InputText id="confirm-signup-finish" type="password" class="input-group fs-12" placeholder="Confirm Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8;font-family:'Nunito';" @bind-Value=viewModel.ConfirmPassword />
                                <ValidationMessage style="text-align:left" For="() => viewModel.ConfirmPassword" />
                            </div>
                            <div id="error-message-container" class="mb-4 error-message-container-finish">
                                <ul id="error-list-finish" class="fw-bold">
                                </ul>
                            </div>
                            <p>By selecting <b>Agree and continue</b>,you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                            <SignupButton id="signup-waiting-finish" Width="100%" Text="Agree and continue" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()" />
                            <div class="col-12">
                                @*<div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="defaultCheck1" @bind=viewModel.Customer.AcceptFlag>
                                    <label class="form-check-label" for="defaultCheck1" style="font-family:'Nunito';font-size:12px;font-weight:400;">
                                        I do not wish to receive promotional communications from Cinnamon.
                                  </label>
                                </div>*@
                            </div>
                        </div>  
                    </EditForm>
                    }
                </div>
            </div>
        </div>  
    </div>
</div>
@if (viewModel.ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}

@code 
{
    IJSObjectReference module;

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
            await jsRuntime.InvokeVoidAsync("MyLib.Components.modal.finishSignUpModal.init","");
        }
    }

    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }

    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }

    public async Task OpenModal(string Email)
    {
        viewModel.ModalDisplay   = "block;";
        viewModel.ModalClass     = "show";
        viewModel.ShowBackdrop   = true;
        viewModel.Customer.Email = Email;
        StateHasChanged();
    }

    public async Task CloseModal()
    {
        viewModel.ModalClass    = "";
        viewModel.ModalDisplay  = "none;";
        StateHasChanged();
    }
}
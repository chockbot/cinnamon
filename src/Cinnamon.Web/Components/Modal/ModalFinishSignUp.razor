@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System.ComponentModel.DataAnnotations
@using System.Linq.Expressions
@inject DataStoreDbContext user
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

<div class="modal fade" id="finishModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Finish signing up</p>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <EditForm Model=viewModel.userModel OnValidSubmit="Submit">
                        <DataAnnotationsValidator />
                        <div class="d-flex flex-column gap-3 align-items-center">
                            <div class="col-12">
                                <InputText id="firstname-signup" class="input-group fs-12" placeholder="First name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.FirstName />
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="lastname-signup" class="input-group fs-12" placeholder="Last name" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.LastName />
                                <p>Be sure it's the same as what appears on your government ID.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="birtdate-signup" type="date" class="input-group fs-12" placeholder="Birthdate" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.Birthdate />
                                <p>The minimum age to join is 18. Unlike Facebook, Cinnamon won't tell anybody else about your birthday.</p>
                            </div>
                            <div class="col-12 justify-content-start">
                                <InputText id="email-signup" type="email" class="input-group fs-12" placeholder="Email" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.Email />
                                <p>For email confirmations, and receipts.</p>
                            </div>
                            <div class="col-12">
                                <InputText id="password-signup" type="password" class="input-group fs-12" placeholder="Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.Password />
                            </div>
                            <div class="col-12">
                                <InputText id="confirm-signup" type="password" class="input-group fs-12" placeholder="Confirm Password" style="border-radius:5px;border:0.5px solid black;padding:12px;background-color:#EDF2F8" @bind-Value=viewModel.userModel.ConfirmPassword />
                            </div>
                            <p>By selecting <b>Agree and continue</b>,you agree to our <a href="Terms" style="color:#FFA942">Terms and Conditions</a> and <a href="Policy" style="color:#FFA942">Privacy Policy</a></p>
                            <button class="btn-primary rounded-pill shadow-sm text-center" type="submit">
                                <i id="spinner-loading" class="fa fa-spinner fa-spin" style="visibility:hidden"></i> Agree and continue
                            </button>
                            <div class="col-12">
                                <div class="form-check">
                                   <input class="form-check-input" type="checkbox" value="" id="defaultCheck1" @bind=viewModel.userModel.AcceptFlag>
                                    <label class="form-check-label" for="defaultCheck1" style="font-family:'Nunito';font-size:12px;font-weight:400;">
                                        I do not wish to receive promotional communications from Cinnamon.
                                  </label>
                                </div>
                            </div>
                        </div> 
                    </EditForm>
                </div>
            </div>
        </div>  
    </div>
</div>
@code {
    IJSObjectReference module;

    [Parameter]
    public UserType TypeValue { get; set; }

    [Parameter]
    public Expression<Func<string>>? For { get; set; }

    SignupViewModel viewModel = new SignupViewModel();

    public void OnSelect(ChangeEventArgs args)
    {
        UserType usertype;
        Enum.TryParse(args.Value.ToString(), out usertype);
        TypeValue = usertype;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Signup.js");
        }
    }
    public async Task Submit()
    {
       
    }
}

    private void HandleInput(string? value, int index)
    {
        if (!string.IsNullOrEmpty(value) && char.IsDigit(value[0]))
        {
            Otp[index] = value[0].ToString();
            // Move to the next input if it exists
            if (index + 1 < OtpLength)
            {
                var nextInput = $"otp-{index + 1}";
                module.InvokeVoidAsync("focusInput", nextInput);
            }
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Backspace")
        {
            // Clear the current input and move to the previous box if it exists
            Otp[index] = string.Empty;
            if (index > 0)
            {
                var previousInput = $"otp-{index - 1}";
                module.InvokeVoidAsync("focusInput", previousInput);
            }
        }
    }

    private async Task HandlePaste(int startIndex)
    {
        // Call JS to fetch clipboard text
        var clipboardText = await module.InvokeAsync<string>("getClipboardText");
        if (string.IsNullOrWhiteSpace(clipboardText))
            return;

        var digits = clipboardText.Where(char.IsDigit).Take(OtpLength).ToArray();

        for (int i = 0; i < digits.Length; i++)
        {
            if (startIndex + i < OtpLength)
            {
                Otp[startIndex + i] = digits[i].ToString();
            }
        }

        StateHasChanged();
    }



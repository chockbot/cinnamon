    private async Task SubmitResetPassword()
    {
        try
        {
            if(await Model.ResetPasswordValidation.ValidateAll())
            {
                Model.ResetPasswordModel.IsForgotPasswordSubmitting = true;
                var resetPasswordRes = await accountApiHandler.ResetPassword(new Framework.ApiCommand.ApiCore.Account.Request.ResetPasswordArgs {
                    Email = Model.ResetPasswordModel.Email,
                    ValidationRoute = config.BaseUrl.AppendPathSegment("verify-reset-password")
                });
                if(!resetPasswordRes.Succeeded || resetPasswordRes.Result == null || !resetPasswordRes.Result.IsSuccess)
                {
                    Model.ResetPasswordModel.ForgotPasswordErrorMessage = resetPasswordRes.Result?.ErrorInfo?.Message ?? resetPasswordRes.Message;
                    Model.ResetPasswordModel.IsShowForgotPassworErrordMessage = true;
                }
                else 
                {
                    Model.ResetPasswordModel.ForgotPasswordSuccessMessage = "Successfully request reset password. Please see your reset verification link to your email";
                    Model.ResetPasswordModel.IsShowForgorPasswordSuccessMessage = true;
                }
                Model.ResetPasswordModel.IsForgotPasswordSubmitting = false;
            }
        }
        catch
        {
            Model.ResetPasswordModel.ForgotPasswordErrorMessage = "An error occured. Please try again later";
            Model.ResetPasswordModel.IsShowForgotPassworErrordMessage = true;
        }
    }


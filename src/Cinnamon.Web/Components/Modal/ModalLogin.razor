<Modal @ref="Model.OTPModal" class="modal-account-credential">
    <ModalContent>
        <ModalHeader Style="@modalHeaderStyle" class="py-2 px-4 border-0-solid border-bottom-1-solid border-color-grey-200">
            <p class="col-12 modal-title font-20 m-0">Verification Email</p>
        </ModalHeader>
        <ModalBody class="px-4 py-4 m-0">
            <h5 class="text-center" style="color:#ffa942; font-weight:bold">Please check you email.</h5>
            <p class="text-center">
                We've sent a six digit code to <span class="fw-bold">
                    @(string.IsNullOrEmpty(Model.GuestEmailModel.Email)
                        ? Model.EmailModel.Email
                        : Model.GuestEmailModel.Email)
                </span>.
            </p>
            <div class="d-flex justify-content-center otp-section">
                @for (int i = 0; i < OtpLength; i++)
                {
                    int currentIndex = i; // Create a local variable to capture the loop index
                    <input type="text" id="otp-@currentIndex" maxlength="1" class="otp-box form-control mx-1 text-center"
                       inputmode="numeric" pattern="[0-9]*"
                       value="@Otp[currentIndex]" 
                       @oninput="@(e => HandleInput(e.Value?.ToString(), currentIndex))"
                       @onkeydown="@(e => HandleKeyDown(e, currentIndex))"
                       @onpaste="@(e => HandlePaste(currentIndex))" />
                }
            </div>
            <div class="w-100 text-center">
                <Button Clicked="VerifyGuestEmail" Type="ButtonType.Submit" class="btn-primary py-2 h-auto rounded-pill"
                        Loading="Model.IsGuestSendingVerification" Disabled="Model.IsGuestSendingVerification">
                    <LoadingTemplate>
                        <i id="email-spinner-loading" class="fa fa-spinner fa-spin"></i> Please Wait
                    </LoadingTemplate>
                    <ChildContent>
                        Verify
                    </ChildContent>
                </Button>
            </div>
            <p class="mt-2 text-center">
                Didn't receive an email?
                @if (!Model.IsGuestResendingVerification)
                {
                    <span @onclick="ResendOTP" class="resend-link"> Resend</span>
                }
                else
                {
                    <span>Please Wait...</span>
                }
            </p>
            <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="Model.IsGuestSendVerificationShowError">
                <AlertDescription>@Model.IsGuestVerificatioErrorMessage</AlertDescription>
            </Alert>
        </ModalBody>
    </ModalContent>
</Modal>

@code 
{
    private Models.Modals.LoginModal Model = new();

    [Parameter]
    public string ReturnUrl { get; set; } = "";

    [Parameter]
    public bool IsFBLogin { get; set; }

    IJSObjectReference module;

    private const int OtpLength = 6;

    private string[] Otp = new string[OtpLength];

    private List<OTPModel> oTPs = new List<OTPModel>();

    private bool IsGuestsAlreadyRegistered { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/FocusNext.js");
        }
    }

    public async Task Show()
    {
        await Model.EmailModal.Show();
        await Model.TextEmail.Focus();
    }

    string modalHeaderStyle = $"";

    string alertStyle = $"margin-bottom:0px;";

    private async Task SubmitEmail()
    {
        try
        {
            if(await Model.EmailModelValidation.ValidateAll())
            {
                Model.EmailModel.IsEmailSubmitting = true;

                var registerWaitlist = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs {
                    Email = Model.EmailModel.Email,
                    ValidationRoute = config.BaseUrl + "/explore",
                    IsGuest = false
                });

                Model.EmailModel.IsEmailSubmitting = false;

                if(!registerWaitlist.Succeeded || registerWaitlist.Result == null)
                {
                    Model.EmailModel.IsShowErrorMessage = true;
                    return;
                }

                if(registerWaitlist.Succeeded && !registerWaitlist.Result.IsSuccess)
                {
                    switch(registerWaitlist.Result.ErrorInfo?.Code)
                    {
                        case "EMAIL-ALREADY-REGISTERED":
                            //Check if guest or not
                            var customer = await accountApiHandler.GetCustomerByEmail(Model.EmailModel.Email);
                            if (customer.Result is not null && customer.Result.Result.IsGuest)
                            {
                                await ShowOTP();
                                IsGuestsAlreadyRegistered = customer.Result.Result.IsGuest;
                            }
                            else
                            {
                                await Model.PasswordModal.Show();
                                await Model.TextPassword.Focus();
                            }  
                            return;
                        case "EMAIL-ALREADY-REGISTERED-NOT-VERIFIED":
                        case "EMAIL-ALREADY-REGISTERED-VERIFIED":
                            await Model.VerificationModal.Show();
                            break;
                        default:
                            Model.EmailModel.IsShowErrorMessage = true;
                            return;
                    }
                }

                await Model.VerificationModal.Show();
            }
        }
        catch
        {
            Model.EmailModel.IsShowErrorMessage = true;
        }
    }

    private async Task SubmitLogin()
    {
        try
        {
            if(await Model.PasswordModelValidation.ValidateAll())
            {
                Model.PasswordModel.IsPasswordSubmitting = true;

                var result = await JsRuntime.InvokeAsync<Models.JsResultModel>("MyLib.Account.login",Model.EmailModel.Email,Model.PasswordModel.Password);

                Model.PasswordModel.IsPasswordSubmitting = false;

                if(!result.Success)
                {
                    Model.PasswordModel.ErrorMessage = result.Message;
                    Model.PasswordModel.IShowErrorMessage = true;
                    return;
                }

                var redirect = string.IsNullOrEmpty(ReturnUrl) ? "/explore" : ReturnUrl;

                if (result.IsAdmin)
                {
                    NavigationManager.NavigateTo("/admin/users", true);
                    return;
                }

                NavigationManager.NavigateTo(redirect, true);
            }
        }
        catch
        {
            Model.PasswordModel.IShowErrorMessage = true;
        }
    }

    private async Task ResendVerification()
    {
        try
        {
            Model.IsResendingVerification = true;

            var result = await accountApiHandler.ResendVerification(new Framework.ApiCommand.ApiCore.Account.Request.ResendVerificationArgs {
                Email = Model.EmailModel.Email,
                ValidationRoute = "/explore",
            });

            Model.IsResendingVerification = false;

            if(!result.Succeeded || result.Result == null)
            {
                Model.ResendVrificationErrorMessage = "An error occured. Please try again later.";
                Model.IsResendVerificationShowError = true;
                return;
            }

            if(result.Succeeded && !result.Result.IsSuccess)
            {
                Model.ResendVrificationErrorMessage = result.Result.ErrorInfo?.Message ?? "An error occured. please try again later.";
                Model.IsResendVerificationShowError = true;
                return;
            }
        }
        catch
        {
            Model.ResendVrificationErrorMessage = "An error occured. Please try again later.";
            Model.IsResendVerificationShowError = true;
        }
    } 

    private void VerificationModalClosed()
    {
        Model.ResendVrificationErrorMessage = string.Empty;
        Model.IsResendingVerification = false;
        Model.IsResendVerificationShowError = false;
    }

    private async Task SubmitGuestEmail()
    {
        try
        {
            if (await Model.GuestEmailModelValidation.ValidateAll())
            {
                Model.GuestEmailModel.IsEmailSubmitting = true;
                //Check if email is registered
                var registerWaitlist = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs
                    {
                        Email = Model.GuestEmailModel.Email,
                        ValidationRoute = config.BaseUrl + "/explore",
                        IsGuest = true
                    });

                Model.GuestEmailModel.IsEmailSubmitting = false;

                if (!registerWaitlist.Succeeded || registerWaitlist.Result == null)
                {
                    Model.GuestEmailModel.IsShowErrorMessage = true;
                    return;
                }

                if (registerWaitlist.Succeeded && !registerWaitlist.Result.IsSuccess)
                {
                    switch (registerWaitlist.Result.ErrorInfo?.Code)
                    {
                        //Redirect to normal Login
                        case "EMAIL-ALREADY-REGISTERED":
                            var customer = await accountApiHandler.GetCustomerByEmail(Model.GuestEmailModel.Email);
                            if (customer.Result is not null && customer.Result.Result.IsGuest)
                            {
                                await ShowOTP();
                                IsGuestsAlreadyRegistered = customer.Result.Result.IsGuest;
                            }
                            else
                            {
                                await Model.GuestLoginModal.Hide();
                                await Model.PasswordModal.Show();
                                await Model.TextPassword.Focus();
                                Model.PasswordModel.ErrorMessage = "Email already registered. Please enter your password to continue.";
                            }
                            return;
                        case "EMAIL-ALREADY-REGISTERED-NOT-VERIFIED":
                        case "EMAIL-ALREADY-REGISTERED-VERIFIED":
                            await ShowOTP();
                            break;
                        default:
                            //Display OTP Modal
                            await ShowOTP();
                            return;
                    }
                }
                else
                {
                    await ShowOTP();
                    return;
                }
            }
        }
        catch
        {
            Model.GuestEmailModel.IsShowErrorMessage = true;
        }
    }

    private async Task VerifyGuestEmail()
    {
        try
        {
            Model.IsGuestSendingVerification = true;
            var redirect = string.IsNullOrEmpty(ReturnUrl) ? "/explore" : ReturnUrl;
            string userEmail = string.IsNullOrEmpty(Model.GuestEmailModel.Email) ? Model.EmailModel.Email : Model.GuestEmailModel.Email;
            //Confirm OTP exist
            var result = await accountApiHandler.GetUserOTP(new Framework.ApiCommand.ApiCore.Account.Request.GetUserOTPArgs
            {
                Email = userEmail
            });

            if (result.Succeeded && result.Result is not null && result.Result.IsSuccess)
            {
                oTPs = result.Result.Result.Select(a =>
                {
                    return new OTPModel
                    {
                        Email = a.Email,
                        OTPCode = a.OtpCode,
                        CreatedOn = a.CreatedOn
                    };
                }).ToList();
            }
            else
            {
                Model.IsGuestSendingVerification = false;
                Model.IsGuestSendVerificationShowError = true;
                return;
            }
            //Check if OTP Exist
            var enteredOtp = string.Join(",", Otp);

            // Check if the entered OTP exists in the fetched list
            var isValidOtp = oTPs.Any(otp => otp.OTPCode == enteredOtp);
            //Use if you want otp to have expiration time
            var IsExpiredOtp = oTPs.Any(otp => otp.OTPCode == enteredOtp && otp.CreatedOn.AddMinutes(10) <= DateTime.Now);

            if (isValidOtp)
            {
                //If already registered implement auto login
                if (IsGuestsAlreadyRegistered)
                {
                    // Implement the required logic to register customer
                    var register = await JsRuntime.InvokeAsync<Models.JsResultModel>("MyLib.Components.modal.createGuest",
                        new
                        {
                            firstname = userEmail,
                            lastname = string.Empty,
                            email = userEmail,
                            birthdate = DateTime.Now.AddYears(-19),
                            phoneNumber = string.Empty,
                            password = string.Empty,
                            hasAcceptedTerms = true,
                            IsGuest = true
                        });
                    if (!register.Success)
                    {
                        Model.IsGuestSendVerificationShowError = true;
                        Model.IsGuestSendingVerification = false;
                        return;
                    }
                    Model.IsGuestSendingVerification = false;
                    NavigationManager.NavigateTo(redirect, true);
                }
                else
                {
                    // OTP is valid: Update waitlist to IsVerify and register to customer table
                    // Implement the required logic for updating waitlist
                    var verify = await accountApiHandler.VerifyEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyEmailArgs
                        {
                            Email = userEmail
                        });
                    if (verify.Succeeded && verify.Result is not null && verify.Result.IsSuccess)
                    {
                        // Implement the required logic to register customer
                        var register = await JsRuntime.InvokeAsync<Models.JsResultModel>("MyLib.Components.modal.createGuest",
                        new
                        {
                            firstname = userEmail,
                            lastname = string.Empty,
                            email = userEmail,
                            birthdate = DateTime.Now.AddYears(-19),
                            phoneNumber = string.Empty,
                            password = string.Empty,
                            hasAcceptedTerms = true,
                            IsGuest = true
                        });
                        if (!register.Success)
                        {
                            Model.IsGuestSendVerificationShowError = true;
                            Model.IsGuestSendingVerification = false;
                            Model.IsGuestVerificatioErrorMessage = "An error occured. Please try again later";
                            return;
                        }
                        Model.IsGuestSendingVerification = false;
                        NavigationManager.NavigateTo(redirect, true);
                    }
                }
            }
            else
            {
                Model.IsGuestSendVerificationShowError = true;
                Model.IsGuestVerificatioErrorMessage = "The OTP is invalid or has expired. Please try again.";
            }
            Model.IsGuestSendingVerification = false;
        }
        catch (Exception ex)
        {
            Model.IsGuestSendingVerification = false;
            Model.IsGuestSendVerificationShowError = true; 
            Model.IsGuestVerificatioErrorMessage = "An error occured. Please try again later";
        }
    }


    public int[] GenerateOtp()
    {
        Random random = new Random();
        int[] otpArray = new int[6];  // Array to hold 6 digits

        // Generate each digit between 0 and 9
        for (int i = 0; i < otpArray.Length; i++)
        {
            otpArray[i] = random.Next(0, 10);  // Generate a random number between 0 and 9
        }

        return otpArray;
    }


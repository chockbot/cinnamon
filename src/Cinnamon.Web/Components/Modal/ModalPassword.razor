@namespace Cinnamon.Web.Components

<div class="modal @ModalClass" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Log In</p>
                <button type="button" class="btn-close" @onclick=@(() => CloseModal())></button>
            </div>
            <div class="modal-body">
                <div class="card-filter">
                    <h5> Welcome to <span style="color:#ffa942;font-family:'Backline'">@Resources.App.appName</span></h5>
                    <br/>
                    <h6>Password</h6>
                    <PasswordCard Email="@setEmail"></PasswordCard>
                </div>
            </div>
        </div>  
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}

@code 
{
    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public string setEmail { get; set; }

    public bool ShowBackdrop = false;

    public async Task OpenModal(string getEmail)
    {
        ModalDisplay = "block;";
        ModalClass   = "show";
        ShowBackdrop = true;
        setEmail     = getEmail;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass      = "";
        ModalDisplay    = "none;";
        ShowBackdrop    = false;
        StateHasChanged();
    }
}

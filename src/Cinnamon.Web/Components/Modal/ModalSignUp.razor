@namespace Cinnamon.Web.Components
@using Cinnamon.Core.Enums
<div class="modal fade" id="sigupModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-body">
                <div class="card-filter text-center">
                    <h1> Welcome to <span style="color:#ffa942">@Resources.App.appName</span></h1>
                    <SignUpCard TypeValue="@TypeValue"></SignUpCard>
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter]
    public UserType TypeValue { get; set; }
}

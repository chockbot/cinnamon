@namespace Cinnamon.Web.Components.Modals
@using Cinnamon.Web.Models.Customer;
@using Cinnamon.Web.Components.Pages.Customer.Profile;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject IAccountApiHandler accountApiHandler;

<Modal @ref="modalRef" class="upload-government-id">
    <ModalContent>
        <ModalHeader Border="Border.Is0" Position="Position.Relative" Flex="Flex.JustifyContent.Center">
            <p class="mb-0 header-label">Upload your Government ID</p>
            <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-close" @onclick="() => modalRef.Hide()"> 
                <Icon Name="IconName.Times" IconStyle="IconStyle.Solid" IconSize="IconSize.Large" />
            </Button>
        </ModalHeader>
        <ModalBody Border="Border.Is0" Padding="Padding.Is0.OnY">
            <Divider Margin="Margin.Is0" />
            <p class="body-label">Your ID will be handled according to our Privacy Policy and won’t be shared with a Cinnamon Maker.</p>
            <Row>
                <Column>
                    <ImageUpload @bind-Model="frontData" />
                </Column>
                <Column>
                    <ImageUpload @bind-Model="backData" />
                </Column>
            </Row>
        </ModalBody>
        <ModalFooter Border="Border.Is0" Margin="Margin.Is3.FromBottom">
            <Button TextColor="TextColor.White" Width="Width.Is100" Size="Size.Small" @onclick="OnUploadClick"
                Color="Color.Primary" Border="Border.Is0.RoundedPill" Block class="font-18">Upload</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code 
{
    [Parameter]
    public string Token { get; set; }

    private Modal modalRef;

    private UploadGovernmenId frontData = new();

    private UploadGovernmenId backData = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await accountApiHandler.GetGovermentIds(Token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            throw new ApplicationException("An error occured when getting government ids");
        }

        frontData.Label = "Front of ID";
        frontData.ImageName = "front-image";
        frontData.ImageFileName = result.Result.Result.FrontIdImagePath;

        backData.Label = "Back of ID";
        backData.ImageName = "back-data";
        backData.ImageFileName = result.Result.Result.BackIdImagePath;
    }

    public Task ShowModal()
    {
        return modalRef.Show();
    }

    public Task HideModal()
    {
        return modalRef.Hide();
    }


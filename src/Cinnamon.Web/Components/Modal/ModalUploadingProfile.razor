@namespace Cinnamon.Web.Components

<div class="modal @ModalClass" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Profile Photo</p>
                <button type="button" class="btn-close" @onclick=@(() => CloseModal())></button>
            </div>
            <div class="modal-body">
                <p class="top-text">People can get to know you better if your profile shows your face.</p>
                <div class="col-12-lg d-flex justify-content-center">
                    <Card class="customer-profile-card" Border="Border.Is1" ColumnSize="ColumnSize.Is7.OnDesktop.Is8.OnMobile" TextAlignment="TextAlignment.Center" >
                        <div class="btn-delete">
                            <Button Border="Border.Is0" Padding="Padding.Is0" Margin="Margin.Is0">
                                <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                            </Button>
                       </div>
                       <div class="figure-profile">
                            <Figure Border="Border.RoundedCircle" Width="Width.Max100">
                                <FigureImage Source="images/Profile/user1.png" AlternateText="profile" Width="Width.Max100" Border="Border.RoundedCircle.Is2.White" />
                            </Figure> 
                       </div>
                    </Card>
                </div>
                <br/>
                <Button TextColor="TextColor.White" Width="Width.Is100" Size="Size.Medium" Color="Color.Primary" Border="Border.RoundedPill" Block class="font-18">Upload</Button>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
                <br/>
            </div>
        </div>
    </div>
</div>
@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}
@code {
    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public bool ShowBackdrop = false;

    public async Task OpenModal()
    {
        ModalDisplay    = "block;";
        ModalClass      = "show";
        ShowBackdrop    = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass      = "";
        ModalDisplay    = "none;";
        ShowBackdrop    = false;
        StateHasChanged();
    }
}

@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Core.Models
@using Cinnamon.Data
@using System
@using System.IO
@using System.Text.RegularExpressions;
@using Cinnamon.Core.Module.UploadService.Handler
@inject IWebHostEnvironment Environment
@inject IUploadImages uploadImageHandler
@inject IDeleteImage deleteImageHandler
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

@if (!viewModel.isSubmit)
{
<EditForm Model=viewModel OnValidSubmit="Upload">
    <DataAnnotationsValidator />
    <div class="modal @viewModel.ModalClass" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@viewModel.ModalDisplay">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <p class="col-11 modal-title text-center">Profile Photo</p>
                    <button type="button" class="btn-close" @onclick=@(() => CloseModal())></button>
                </div>
                <div class="modal-body">
                    <p class="top-text">People can get to know you better if your profile shows your face.</p>
                    <div class="col-12-lg d-flex justify-content-center">
                        <Card Class="customer-profile-card" Border="Border.Is1" ColumnSize="ColumnSize.Is8.OnDesktop.Is11.OnMobile" TextAlignment="TextAlignment.Center" >
                            <div class="btn-delete">
                                <button type="button" class="btn border-0" @onclick="@(() => DeleteProfile())" disabled=@viewModel.isClickButton>
                                    <i class="fa fa-trash" style="color:black;"></i>
                                </button>
                            </div>
                            <div class="figure-profile">
                                 <label for="fileinput" class="upload-image">
                                    <Figure Border="Border.RoundedCircle">
                                        <CardImage Source="@viewModel.profilepicture" id="avatar-crop" Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                                    </Figure>
                                 </label>
                                     <input type="file" name="photo" accept="image/*" class="js-photo-upload" style="display:none;">
                                <div class="round">
                                    <form method="post">
                                        <InputFile id="fileinput" accept=".png,.jpg,.jpeg,.tiff,.gif" type="file" name="photo" class="js-photo-upload"/>
                                        <i class="fa fa-camera" style="color: black;"></i>
                                    </form>
                                </div>
                            </div>
                        </Card>
                    </div>
                    <p class="bottom-text">JPEG or PNG only</p>
                    <div class="btn-upload">
                        <SignupButton id="update-profile" Width="100%" Text="Upload" DisableButton="@ButtonIsClicked()" Visibility="@showSpinner()" Height="0.5vw"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</EditForm>
<!--ModalEdit-->
    <div class="modal fade remove-modal" tabindex="-1" role="dialog" id="cropperModal">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <p class="col-11 modal-title text-center">Edit Profile Photo</p>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="top-text">People can get to know you better if your profile shows your face.</p>
                     <div class="col-12-lg d-flex justify-content-center">
                        <img class="js-avatar-preview" src="">
                    </div>
                    <button class="btn btn-primary js-save-cropped-avatar">Save</button>
                </div>
            </div> 
        </div>
    </div>
}
@if (viewModel.ShowErrorMessage)
{
    <div class="alert alert-danger alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Error!</strong>Error occured while uploading image. Please try again.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (viewModel.ShowSuccessMessage)
{
    <div class="alert alert-success alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Success!</strong> Your profile photo was uploaded successfully.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<!--Confimation Popup-->
@if (viewModel.ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}
@code {
    IJSObjectReference module;

    private DotNetObjectReference<ModalUploadingProfile>? objRef;

    private readonly IConfiguration configuration;

    private List<IBrowserFile> loadedFiles = new();

    UploadProfileViewModel viewModel = new UploadProfileViewModel();

    private CustomerModel customer = new CustomerModel();

    public string ParaContent = "Some Text Content";

    private Modal modalRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/editprofileModal.js");
        }
    }
    private async Task ShowModal()
    {
        await modalRef.Show();
    }

    private async Task HideModal()
    {
        await modalRef.Hide();
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }
    public string showSpinner()
    {
        return viewModel.isSpinnerShow ? "visible" : "hidden";
    }
    private async Task DeleteProfile()
    {
        string[] filepath           = viewModel.profilepicture.Split("/");
        viewModel.profilepicture    = filepath[4];
        await DeleteBlob(viewModel.profilepicture, "upload-profile-picture");
    }
    private async Task DeleteBlob(string filename, string container1)
    {
        // Delete to Azure Blob
        var result = await deleteImageHandler.ExecuteAsync(
                new Core.Module.UploadService.Interactors.DeleteImage
                { Container = "upload-profile-picture", FileName = filename });

        if(result.Succeeded)
        {
            customer = await CoreDI.DataStore.Customers.GetCustomerByEmailAsync(viewModel.UserEmail);
            viewModel.profilepicture = customer.ProfilePath;
        }
        else
        {
            ResultModel.error("Error occurred while deleting image");
        }
    }
    private async Task Upload()
    {
         viewModel.isSpinnerShow = true;

        //Get Image Data Url from JS
        await module.InvokeVoidAsync("ChangeContentJS", objRef);

        //Get Image Data
        var match = Regex.Match(ParaContent, @"data:(?<type>.+?);base64,(?<data>.+)");
        var base64Data = match.Groups["data"].Value;
        var contentType = match.Groups["type"].Value;
        var binData = Convert.FromBase64String(base64Data);

        using (var ms = new MemoryStream(binData))
        {
            //Get image Byte
            byte[] imageByte = ms.ToArray();

            //Generate File Name
            var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
            var stringChars = new char[8];
            var random = new Random();

            for (int i = 0; i < stringChars.Length; i++)
            {
                stringChars[i] = chars[random.Next(chars.Length)];
            }
            var randomStr = new String(stringChars);

            //Set image FileName
            string[] type= contentType.Split("/");
            string extension = type[1];
            string filename = new String(randomStr + "." + extension);

            //Upload to Azure Blob
            var upload = await uploadImageHandler.ExecuteAsync(
                new Core.Module.UploadService.Interactors.ImageUpload
                    { Container = "upload-profile-picture", Images = new List<Tuple<byte[], string>> { new Tuple<byte[], string>(imageByte, filename) } });
           
            //Display Image
            if (upload.Succeeded)
            {
                if (upload.Result != null)
                {
                    foreach (var imagePath in upload.Result.ImagesPath)
                    {
                        viewModel.profilepicture = imagePath;
                        viewModel.isClickButton = false;
                    }
                }
            }
        }
        //Save image location to DB
        var res = await CoreDI.DataStore.Customers.GetCustomerByEmailAsync(viewModel.UserEmail);
        if (res != null)
        {
            res.ProfilePath              = viewModel.profilepicture;
            var update                   = await CoreDI.DataStore.Customers.SaveDataAsync(res);
            viewModel.isClickButton      = false;
            viewModel.isSpinnerShow      = false;
            viewModel.ShowSuccessMessage = true;
            HideMessageAfterDelay();
            await CloseModal();
        }
        else
        {
            viewModel.ShowErrorMessage = true;
            HideMessageAfterDelay();
        }
    }

    [JSInvokable]
    public void ChangeParaContentValue(string value)
    {
        ParaContent = value;
    }

    public async Task OpenModal(string email, string path)
    {
        viewModel.ModalDisplay   = "block;";
        viewModel.ModalClass     = "show";
        viewModel.ShowBackdrop   = true;
        viewModel.UserEmail      = email;
        viewModel.profilepicture = path;
        StateHasChanged();
    }

    public async Task CloseModal()
    {
        viewModel.ModalClass   = "";
        viewModel.ModalDisplay = "none;";
        viewModel.ShowBackdrop = false;
        StateHasChanged();
        NavigationManager.NavigateTo("/customer/profile",true);
    }

    private async void HideMessageAfterDelay()
    {
        await Task.Delay(20000);
        viewModel.ShowErrorMessage  = false;
        viewModel.ShowSuccessMessage = false;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }
}


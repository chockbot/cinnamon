@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Core.ViewModels
@using Cinnamon.Data
@using System
@using System.IO
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Logging
@using Cinnamon.Core.Module.UploadService.Handler
@inject IWebHostEnvironment Environment
@inject IUploadImages uploadImageHandler;

<div class="modal @ModalClass" id="loginModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center">Profile Photo</p>
                <button type="button" class="btn-close" @onclick=@(() => CloseModal())></button>
            </div>
            <div class="modal-body">
                <p class="top-text">People can get to know you better if your profile shows your face.</p>
                <div class="col-12-lg d-flex justify-content-center">
                    <Card Class="customer-profile-card" Border="Border.Is1" ColumnSize="ColumnSize.Is8.OnDesktop.Is8.OnMobile" TextAlignment="TextAlignment.Center" >
                        <div class="btn-delete">
                            <button type="button" class="btn border-0" @onclick="@(() => DeleteProfile())">
                                <i class="fa fa-trash" style="color:black;"></i>
                            </button>
                       </div>
                       <div class="figure-profile">
                            <Figure Border="Border.RoundedCircle">
                                <CardImage Source="@profilepicture" Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                            </Figure>
                            <div class="round">
                                <InputFile id="fileinput" accept=".png,.jpg,.jpeg,.tiff,.gif" OnChange="@LoadImage" />
                                <i class="fa fa-camera" style="color: black;"></i>
                            </div>
                       </div>
                    </Card>
                </div>
                <div class="btn-upload">

                    <Button TextColor="TextColor.White" Width="Width.Is100" Size="Size.Medium" Color="Color.Primary" Border="Border.RoundedPill" Block class="font-18" Style="" Disabled="ButtonIsClicked()">
                        Upload
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>
@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal()"></div>
}
@code {
    private List<IBrowserFile> loadedFiles = new();

    UploadProfileViewModel viewModel = new UploadProfileViewModel();

    private long maxFileSize = 10000000;

    private int maxAllowedFiles = 3;

    private bool isLoading;

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public bool ShowBackdrop = false;

    public string profilepicture { get; set; } = "images/Profile/user.png";

    public async Task OpenModal()
    {
        ModalDisplay    = "block;";
        ModalClass      = "show";
        ShowBackdrop    = true;
        StateHasChanged();
    }
    public async Task CloseModal()
    {
        ModalClass      = "";
        ModalDisplay    = "none;";
        ShowBackdrop    = false;
        StateHasChanged();
    }
    public bool ButtonIsClicked()
    {
        return viewModel.isClickButton ? true : false;
    }
    public string showSpinner()
    {
        return viewModel.isClickButton ? "visible" : "hidden";
    }
    private void DeleteProfile()
    {
        profilepicture = "images/Profile/user.png";
    }
    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        isLoading = true;
        loadedFiles.Clear();

        string path = Path.Combine(Environment.WebRootPath, "Images\\ProfilePicture");
        if (!Directory.Exists(path))
        {
            Directory.CreateDirectory(path);
        }
        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            string fileName = Path.GetFileName(file.Name);
            try
            {
                loadedFiles.Add(file);
                await using FileStream fs = new FileStream(Path.Combine(path, fileName), FileMode.Create);
                await file.OpenReadStream(maxFileSize).CopyToAsync(fs);

                profilepicture          = "images/ProfilePicture/"+file.Name;
                viewModel.isClickButton = false;
                //byte[] imageByte= new byte[fs.Length];

                //Upload to Azure Blob
                //var upload = await uploadImageHandler.ExecuteAsync(
                //        new Core.Module.UploadService.Interactors.ImageUpload
                //            { Container = "upload-profile-picture", Images = new List<Tuple<byte[], string>> { new Tuple<byte[], string>(imageByte, file.Name)});
                }
                catch (Exception ex)
                {
                    ResultModel.error(ex.Message);
                }
            }

            isLoading = false;
        }
    }
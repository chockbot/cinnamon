@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject IJSRuntime jsRuntime
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler

<Modal @ref="modalRef" class="multiple-review-modal" Padding="Padding.Is0">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header d-block">
                <div class="row d-flex">
                    <div class="col-lg-11 col-md-11 col-10">
                        <p class="modal-title justify-content-start">Reviews</p>
                    </div>
                    <div class="col-lg-1 col-md-1 col-2 justify-content-end">
                        <button type="button" class="btn-close" @onclick="() => HideModal()"></button>
                    </div> 
                </div>
                <div class="row d-flex">
                    <div class="col-12 d-flex justify-content-start rating-section">
                        <div id="modal-star-rating"></div>
                        <p class="rating-value">(@AverageRating.ToString("0.0"))</p>
                        <ul>
                            <li>
                            </li>
                        </ul>
                        <p class="rating-number">(@Reviews.Count)</p>
                    </div>
                </div>
                
            </div>
            <div class="modal-body">
                @foreach (var item in Reviews)
                {
                    @if (CustomerProfiles != null && Activities != null)
                    {
                        var profile = CustomerProfiles.Where(a => a.Id == item.CustomerId).FirstOrDefault();
                        var activity = Activities.Where(a => a.ActivityId == item.ActivityId).FirstOrDefault();
                        <div class="xp-body-item d-flex">
                            <div class="activity-img">
                                <img class="rounded-2 rounded-circle" src="@profile.ProfilePath" />
                            </div>
                            <div>
                                <p class="customer-name">@profile.FirstName @profile.LastName</p>
                                <Rating Color="Color.Primary" SelectedValue="@item.Rating" MaxValue="5" ReadOnly=true />
                            </div>
                        </div>
                        <div class="xp-activity">
                            <p class="xp-title">@activity.Title (@activity.ActivitySchedules.Where(a=>a.Id == item.ScheduleId).First().Name)</p>
                        </div>
                        <div class="xp-body-item">
                            <p class="secondary-caption">@item.Review</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</Modal>
@code {
    IJSObjectReference module;

    private Modal modalRef;

    [Parameter]
    public List<Reviews> Reviews { get; set; }

    [Parameter]
    public int SelectedValue { get; set; }

    [Parameter]
    public double AverageRating { get; set; }

    [Parameter]
    public List<CustomerProfile> CustomerProfiles { get; set; }

    [Parameter]
    public IList<Activity> Activities { get; set; }

    public async Task ShowModal()
    {
        module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/ModalStarRating.js");
        await Task.Run(() => module.InvokeVoidAsync("generateStarRating", AverageRating));
        await modalRef.Show();
    }

    public async Task HideModal()
    {
        await modalRef.Close(CloseReason.None);
    }
}

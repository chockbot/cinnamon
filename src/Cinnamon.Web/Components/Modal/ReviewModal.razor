@namespace Cinnamon.Web.Components
@inject IJSRuntime jsRuntime
@using Cinnamon.Web.Models.Entities
@inject NavigationManager NavigationManager

<div class="modal @ModalClass" id="@Student.StudentId" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" style="overflow:hidden;display:@ModalDisplay">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <p class="col-11 modal-title text-center color-black-100 font-family-nunito font-weight-700">
                    You Just Finished an Activity
                </p>
                <button type="button" class="btn-close" @onclick="() => CloseModal(Student.StudentId)"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <p class="font-14 color-gray-100">Leave a review</p>
                    <img class="mt-1" src="@imgScr" alt="welcome image">
                    <p class="font-16 color-black-100">@Activity.Title</p>
                    <p class="font-14 color-gray-100">@Student.Name</p>
                    <Rating Color="Color.Primary" @bind-SelectedValue="@SelectedValue" MaxValue="5" />
                    <div class="textarea-container col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
                        <MemoEdit Placeholder="Additional Comments" Text=""/>
                    </div>
                    <Button @onclick="() => CloseModal(Student.StudentId)" class="d-inline-block btn-not-now" style="font-size: 16px; font-weight: 700;">
                        Not Now
                    </Button>
                    <Button Clicked="SubmitReview" class="d-inline-block btn-primary" style="font-size: 16px; font-weight: 700;"
                            Border="Border.Is0">
                        Submit Review
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show" data-dismiss="modal" @onclick="() => CloseModal(Student.StudentId)"></div>
}
@code {
    IJSObjectReference module;

    public Modal modRef { get; set; }

    public Activity Activity = new Activity();

    public StudentAttendance Student = new StudentAttendance();

    public string imgScr = string.Empty;

    public int Id { get; set; }

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public string ClassName { get; set; } = string.Empty;

    public string setEmail { get; set; }

    public bool ShowBackdrop = false;

    int SelectedValue = 0;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/CloseModalById.js");
        }
    }
    public async Task OpenModal(Activity activity, StudentAttendance studentAttendance, int id)
    {
        ModalDisplay    = "block;";
        ModalClass      = "show";
        ShowBackdrop    = true;
        Activity        = activity;
        Student         = studentAttendance;
        Id              = id;
        imgScr          = activity.Images.ElementAt(0).ImageSrc;
        StateHasChanged();
    }
    public async Task CloseModal(int Id)
    {
        await Task.Run(() => module.InvokeVoidAsync("closeModalById", Id));
        ShowBackdrop = false;
    }
    public Task HideModal()
    {
        return modRef.Hide();
    }
    public async Task NotNow()
    {
        await modRef.Close(CloseReason.None);
    }
    public async Task SubmitReview()
    {

    }
}

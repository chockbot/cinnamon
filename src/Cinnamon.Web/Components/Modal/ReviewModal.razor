@namespace Cinnamon.Web.Components
@inject IJSRuntime jsRuntime
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject IActivityApiHandler activityApiHandler
@inject NavigationManager NavigationManager

@foreach (var item in Students)
{
    <Modal @ref="item.ModalRef" class="review-modal" Padding="Padding.Is0">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <p class="col-11 modal-title text-center color-black-100 font-family-nunito font-weight-700">
                        You Just Finished an Activity
                    </p>
                    <button type="button" class="btn-close" @onclick="() => item.ModalRef.Close(CloseReason.UserClosing)"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center">
                        <p class="font-14 color-gray-100">Leave a review</p>
                        <img class="mt-1" src=@activity.Images.ElementAt(0).ImageSrc alt="review image">
                        <p class="font-16 color-black-100">@activity.Title</p>
                        <p class="font-14 color-gray-100">@item.Name</p>
                        <Rating Color="Color.Primary" @bind-SelectedValue="@SelectedValue" MaxValue="5" />
                        <div class="textarea-container col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
                            <MemoEdit Placeholder="Additional Comments" Text="" />
                        </div>
                        <Button @onclick="() => item.ModalRef.Close(CloseReason.UserClosing)" class="d-inline-block btn-not-now" style="font-size: 16px; font-weight: 700;">
                            Not Now
                        </Button>
                        <Button Clicked="SubmitReview" class="d-inline-block btn-primary" style="font-size: 16px; font-weight: 700;"
                            Border="Border.Is0">
                            Submit Review
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    </Modal>
}
@code {
    IJSObjectReference module;

    public Modal modRef { get; set; }

    [Parameter]
    public List<StudentAttendance> Students { get; set; }
    
    public Activity activity = new Activity();

    public string imgScr = string.Empty;

    public int Id { get; set; }

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public string ClassName { get; set; } = string.Empty;

    public string setEmail { get; set; }

    public bool ShowBackdrop = false;

    int SelectedValue = 0;

    private async Task<Activity> GetActivityById(int Id)
    {
        var ActivityListData = await activityApiHandler.GetActivity(Id, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
            {
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true,
            });
        if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
        {
            var result = ActivityListData.Result.Result;
            activity = new Activity
                {
                    Id = result.ActivityId,
                    Title = result.Title,
                    Description = result.Description,
                    Images = result.Images.Select(i =>
                    {
                        return new ActivityImage
                        {
                            Id = i.Id,
                            ImageSrc = i.ImageSrc,
                            Name = i.Name
                        };
                    }).ToList(),
                };
        }
        return await Task.FromResult<Activity>(activity);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/CloseModalById.js");
        }
    }

    public async Task Show()
    {
        for(int i = 0; i < Students.Count; i++)
        {
            await Students[i].ModalRef.Show();
        }
    }

    public Task HideModal()
    {
        return modRef.Hide();
    }

    public async Task NotNow()
    {
        await modRef.Close(CloseReason.None);
    }
    
    public async Task SubmitReview()
    {

    }
}

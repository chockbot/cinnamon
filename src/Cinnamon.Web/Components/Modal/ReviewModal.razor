@namespace Cinnamon.Web.Components
@inject IJSRuntime jsRuntime
@using System.Security.Claims
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (studentAttendances.Count != 0)
{
    foreach (var item in studentAttendances)
    {
        <Modal @ref="item.ModalRef" class="customer-review-modal" Padding="Padding.Is0">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <p class="col-11 modal-title text-center color-black-100 font-family-nunito font-weight-700">
                            You Just Finished an Activity
                        </p>
                        <button type="button" class="btn-close" @onclick="() => item.ModalRef.Close(CloseReason.UserClosing)"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <p class="font-14 color-gray-100">Leave a review</p>
                            <img class="mt-1" src="@activities.Where(a => a.Id == item.ActivityId).FirstOrDefault().Images.ElementAt(0).ImageSrc" alt="review image">
                            <p class="font-16 color-black-100">@activities.Where(a => a.Id == item.ActivityId).FirstOrDefault().Title</p>
                            <p class="font-14 color-gray-100">@item.Name</p>
                            <Rating Color="Color.Primary" @bind-SelectedValue="@SelectedValue" MaxValue="5" />
                            <div class="textarea-container col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
                                <MemoEdit Placeholder="Additional Comments" @bind-Text=ReviewText/>
                            </div>
                            <Button @onclick="() => item.ModalRef.Close(CloseReason.UserClosing)" class="d-inline-block btn-not-now">
                                Not Now
                            </Button>
                            <Button Clicked="() => SubmitReview(item, activities.Where(a => a.Id == item.ActivityId).First())" class="d-inline-block btn-primary">
                                Submit Review
                            </Button>
                        </div>
                    </div>
                </div>
            </div>
            @if (IsShowErrorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
                    <strong>Error!</strong> @ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </Modal>
    }
}
@code {
    IJSObjectReference module;

    private List<StudentAttendance> studentAttendances = new List<StudentAttendance>();

    private List<StudentAttendance> students = new List<StudentAttendance>();

    private List<Activity> activities = new List<Activity>();

    public ClaimsPrincipal AuthState { get; set; }

    public CustomerProfile customerProfile = new CustomerProfile();

    public Activity activity = new Activity();

    public string token { get; set; }

    public string ReviewText { get; set; }

    public int SelectedValue = 0;

    public bool IsShowErrorMessage { get; set; }

    public string ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                customerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };
            }
        }

        if (customerProfile != null)
        {
            //Get Completed Students
            var attendance = await ongoingApiHandler.GetCompletedStudentsById(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetCompletedStudentsByIdArgs
                {
                    CustomerId = customerProfile.Id
                }, token);

            if (attendance.Succeeded && attendance.Result != null && attendance.Result.IsSuccess)
            {
                studentAttendances = attendance.Result.Result.Select(a =>
                {
                    return new StudentAttendance
                        {
                            StudentId = a.Id,
                            ActivityId = a.ActivityId,
                            ScheduleId = a.ScheduleId,
                            Name = a.Name,
                            NumberOfSessions = a.NumberOfSessions,
                            SessionsAttended = a.SessionsAttended
                        };
                }).ToList();
            }
            //Get Activity
            students = studentAttendances.GroupBy(a => a.ActivityId).Select(s => s.First()).ToList();
            foreach (var item in students)
            {
                var ActivityListData = await activityApiHandler.GetActivity(item.ActivityId, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
                    {
                        IncludeActivityDescription = true,
                        IncludeActivityImages = true,
                        IncludeAtivitySchedules = true,
                        IncludeCustomer = true
                    });
                if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
                {
                    var result = ActivityListData.Result.Result;
                    activity = new Activity
                    {
                        Id = result.ActivityId,
                        Title = result.Title,
                        Description = result.Description,
                        Images = result.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                        Owner = result.Owner != null ? new CustomerProfile
                        {
                            // map only required fields
                            Id = result.Owner.Id,
                            Handler = result.Owner.Handler
                        } : null
                    };
                }
                activities.Add(activity);
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(2000);
            await Show();
        }
    }
    public async Task Show()
    {
        for (int i = 0; i < studentAttendances.Count; i++)
        {
            studentAttendances[i].ModalRef.ShowBackdrop = (i == 0) ? true : false;
            await studentAttendances[i].ModalRef.Show();
        }
    }

    public async Task SubmitReview(StudentAttendance studentAttendance, Activity activity)
    {
        try
        {
            if (SelectedValue == 0)
            {
                IsShowErrorMessage = true;
                ErrorMessage = "Review rating is required. Please try again";
                StateHasChanged();
                await Task.Delay(2000);
                IsShowErrorMessage = false;
            }
            else
            {
                var create = await ongoingApiHandler.CreateReview(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.CreateReviewArgs
                    {
                        CustomerId = customerProfile.Id,
                        MakerId = activity.Owner.Id,
                        ActivityId = studentAttendance.ActivityId,
                        ScheduleId = studentAttendance.ScheduleId,
                        StudentId = studentAttendance.StudentId,
                        Rating = SelectedValue,
                        Review = string.IsNullOrEmpty(ReviewText) ? "No additional comment." : ReviewText,
                        ReviewDate = DateTime.UtcNow
                    }, token);

                if (create.Succeeded && create.Result != null && create.Result.IsSuccess)
                {
                    //Update Student Table Has Review
                    var update = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
                        {
                            Id = studentAttendance.StudentId,
                            HasReview = true
                        });
                    if ((!update.Succeeded || update.Result == null) || (update.Succeeded && !update.Result.IsSuccess))
                    {
                        IsShowErrorMessage = true;
                        ErrorMessage = "An error occured. Please try again later.";
                        return;
                    }
                    else
                    {
                        SelectedValue = 0;
                        ReviewText = string.Empty;
                        await studentAttendance.ModalRef.Close(CloseReason.UserClosing);
                    }
                }
            }
        }
        catch (Exception)
        {
            IsShowErrorMessage = true;
            ErrorMessage = "An error occured. Please try again later.";
            StateHasChanged();
            await Task.Delay(2000);
            IsShowErrorMessage = false;
        }
        
    }
}

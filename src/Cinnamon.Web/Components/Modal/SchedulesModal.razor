@namespace Cinnamon.Web.Components
@using Models.Entities

<div class="modal fade @ModalClass" id="scheduleModal" tabindex="-1" aria-labelledby="ScheduleModalLabel" aria-hidden="true" style="display:@ModalDisplay">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="()=>Close()"></button>
            </div>
            <div class="modal-body">
                <div class="row col-lg-12 col-md-12 col-sm-12 d-flex flex-row flex-wrap justify-content-evenly">
                    @foreach (var item in ScheduleModel.Where(s => s.IsActiveSchedule))
                    {
                        <div class="col-md-4 mb-2">
                            <CarouselItemSchedule ScheduleModel="item" ActivityModel="ActivityModel"/>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (ShowBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}

@code 
{
    [Parameter]
    public IList<ActivitySchedule> ScheduleModel { get; set; }
    [Parameter]
    public Activity ActivityModel { get; set; }

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public bool ShowBackdrop = false;

    public void Open()
    {
        ModalDisplay = "block;";
        ModalClass = "show";
        ShowBackdrop = true;
        StateHasChanged();
    }

    public void Close()
    {
        ModalDisplay = "none";
        ModalClass = "hide";
        ShowBackdrop = false;
        StateHasChanged();
    }
}

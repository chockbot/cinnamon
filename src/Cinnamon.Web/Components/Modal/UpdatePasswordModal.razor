@namespace Cinnamon.Web.Components
@using Flurl;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using System.Security.Claims;
@inject IAccountApiHandler accountApiHandler;
@inject Cinnamon.Web.Config.Config config;
@inject IJSRuntime JsRuntime;
@inject NavigationManager NavigationManager;
@inject IAdminApiHandler adminApiHandler;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime jsRuntime

<Modal @ref="Model.ForgotPasswordModal" class="modal-forgot-password modal-account-credential" id="modal-disabled-close">
    <ModalContent>
        <ModalHeader Style="@modalHeaderStyle" class="py-2 px-4 border-0-solid border-bottom-1-solid border-color-grey-200">
            <p class="col-12 modal-title font-20 m-0">Reset Password</p>
        </ModalHeader>
        <ModalBody class="px-4 py-4 m-0">
            <div class="form-content">
                <p class="font-14 mb-3 font-weight-400 text-center" style="color:#717171">
                    Let's reset your password for your new email address. Click "Continue" to initiate process.
                </p>
                <div class="w-100 text-center">
                    <Validations @ref="Model.ResetPasswordValidation" Mode="ValidationMode.Manual" Model="Model.ResetPasswordModel">
                        <div class="">
                            <div class="col-12">
                                <p class="color-black-100 font-16 mb-1 font-weight-700 text-start">Current Email</p>
                                <Validation>
                                    <TextEdit @ref="Model.TextForgetPassword" Role="TextRole.Email" @bind-Text=Current Size="Size.ExtraLarge" class="bg-grey-300 py-4 color-grey-100 font-16" Border="Border.Is0" Disabled>
                                        <Feedback>
                                            <ValidationError TextAlignment="TextAlignment.Start" />
                                        </Feedback>
                                    </TextEdit>
                                </Validation>
                                <br />
                                <p class="color-black-100 font-16 mb-1 font-weight-700 text-start">New Email</p>
                                <Validation>
                                    <TextEdit @ref="Model.TextForgetPassword" Role="TextRole.Email" @bind-Text=New Size="Size.ExtraLarge" class="bg-grey-300 py-4 color-grey-100 font-16" Border="Border.Is0" Disabled>
                                        <Feedback>
                                            <ValidationError TextAlignment="TextAlignment.Start" />
                                        </Feedback>
                                    </TextEdit>
                                </Validation>
                            </div>
                            <Button Type="ButtonType.Submit" class="btn-primary py-2 h-auto rounded-pill"
                                    Clicked="SubmitResetPassword"
                                    Loading="Model.ResetPasswordModel.IsForgotPasswordSubmitting"
                                    Disabled="Model.ResetPasswordModel.IsForgotPasswordSubmitting">
                                <LoadingTemplate>
                                    <i id="email-spinner-loading" class="fa fa-spinner fa-spin"></i> Please Wait
                                </LoadingTemplate>
                                <ChildContent>
                                    Continue
                                </ChildContent>
                            </Button>
                        </div>
                    </Validations>
                    <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="Model.ResetPasswordModel.IsShowForgotPassworErrordMessage">
                        <AlertDescription>@Model.ResetPasswordModel.ForgotPasswordErrorMessage</AlertDescription>
                    </Alert>
                    <Alert Color="Color.Success" Margin="Margin.Is3.FromTop" Visible="Model.ResetPasswordModel.IsShowForgorPasswordSuccessMessage">
                        <AlertDescription>@Model.ResetPasswordModel.ForgotPasswordSuccessMessage</AlertDescription>
                    </Alert>
                </div>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>
@code {
    IJSObjectReference module;

    private Models.Modals.LoginModal Model = new();

    string modalHeaderStyle = $"";

    [Parameter]
    public string New { get; set;}

    [Parameter]
    public string Current { get; set; }

    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public DateTime Birthdate { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/disabledModalClose.js");
        }
    }

    public async Task Show()
    {
        await Model.ForgotPasswordModal.Show();
    }

    private async Task SubmitResetPassword()
    {
        try
        {
            //Change Email Address to New Email
            var email = await accountApiHandler.ChangeEmailAddress(new Framework.ApiCommand.ApiCore.Account.Request.ChangeEmailArgs
                {
                    CurrentEmail = Current,
                    NewEmail = New,
                }, Token);
            if (email.Succeeded && email.Result != null && email.Result.IsSuccess)
            {
                //Change Customer Email
                var result = await accountApiHandler.UpdateProfileDetails(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
                    {
                        Email = New,
                        Datebirth = Birthdate
                    }, Token);

                if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
                {
                    if (await Model.ResetPasswordValidation.ValidateAll())
                    {
                        Model.ResetPasswordModel.IsForgotPasswordSubmitting = true;
                        var resetPasswordRes = await accountApiHandler.ResetPassword(new Framework.ApiCommand.ApiCore.Account.Request.ResetPasswordArgs
                            {
                                Email = New,
                                ValidationRoute = config.BaseUrl.AppendPathSegment("verify-reset-password")
                            });
                        if (!resetPasswordRes.Succeeded || resetPasswordRes.Result == null || !resetPasswordRes.Result.IsSuccess)
                        {
                            Model.ResetPasswordModel.ForgotPasswordErrorMessage = resetPasswordRes.Result?.ErrorInfo?.Message ?? resetPasswordRes.Message;
                            Model.ResetPasswordModel.IsShowForgotPassworErrordMessage = true;
                        }
                        else
                        {
                            Model.ResetPasswordModel.ForgotPasswordSuccessMessage = "Successfully request reset password. Please see your reset verification link to your email";
                            Model.ResetPasswordModel.IsShowForgorPasswordSuccessMessage = true;
                        }
                        Model.ResetPasswordModel.IsForgotPasswordSubmitting = false;
                    }
                }
            }
        }
        catch
        {
            Model.ResetPasswordModel.ForgotPasswordErrorMessage = "An error occured. Please try again later";
            Model.ResetPasswordModel.IsShowForgotPassworErrordMessage = true;
        }
    }
}

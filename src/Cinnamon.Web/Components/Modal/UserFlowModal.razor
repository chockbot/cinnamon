@namespace Cinnamon.Web.Components

<Modal @ref="modalRef">
    <ModalContent Size="ModalSize.Fullscreen" Style="background-color:transparent" Class="header-modal" Scrollable>
        <ModalHeader>
           <p class="col-11 modal-title text-center"></p>
           <button type="button" class="btn-close" @onclick="() => HideModal()"></button>
        </ModalHeader>
        <ModalBody Padding="Padding.Is0">
           <div class="container">
                <div class="col-12 justify-content-center user-flow-1">
                    <img class="img-flow" src="/images/experience-creation/@Image" />
                </div>
            </div>
            <div class="col-12 justify-content-center user-flow-mobile">
                <img class="img-flow" src="/images/experience-creation/@MobileImage" />
            </div>
        </ModalBody>
    </ModalContent>
</Modal>


@code {
    [Parameter]
    public string Image { get; set; }

    [Parameter]
    public string MobileImage { get; set; }

    private Modal modalRef;

    public Task ShowModal()
    {
        return modalRef.Show();
    }

    public Task HideModal()
    {
        return modalRef.Hide();
    }
}
<style scoped>
    .modal-header {
        border-bottom: 0;
        justify-content: end;
    }
</style>

@namespace Cinnamon.Web.Components
@using System
@using System.Text.RegularExpressions;
@using Cinnamon.Web.Models.Customer;
@using Cinnamon.Web.Modules.ApiAccess.Handlers

<Modal @ref="modalReference" Class="view-image-modal">
    <ModalContent Size="ModalSize.ExtraLarge">
        <ModalHeader>
            <p class="col-11 modal-title text-center">Uploaded Photos</p>
            <button type="button" class="btn-close" @onclick="() => modalReference.Hide()"></button>
        </ModalHeader>
        <ModalBody>
            <Row>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class="mb-3 mb-md-0">
                    <label>Front of ID</label>
                    @if(!string.IsNullOrEmpty(FrontIdImagePath))
                    {
                        <img class="front-image" src="@FrontIdImagePath" />
                    }
                    else {
                        <p class="my-5 font-weight-700">No ID uploaded</p>
                    }
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <label>Back of ID</label>
                    @if(!string.IsNullOrEmpty(BackIdImagePath))
                    {
                        <img class="back-image" src="@BackIdImagePath" />
                    }
                    else {
                        <p class="my-5 font-weight-700">No ID uploaded</p>
                    }
                </Column>
            </Row>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    public string BackIdImagePath { get; set; }

    public string FrontIdImagePath { get; set; }

    private Blazorise.Modal modalReference = new Modal();

    public Task ShowModal(string backIdImagePath, string frontIdImagePath)
    {
        BackIdImagePath = backIdImagePath;
        FrontIdImagePath = frontIdImagePath;
        return modalReference.Show();
    }
    public Task HideModal()
    {
        return modalReference.Hide();
    }

}

@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAccountApiHandler accountApiHandler;
@inject NavigationManager NavigationManager;

<Modal @ref=ModalRef class="welcome-modal">
    <ModalContent Centered>
        <ModalHeader>
            <p class="m-0 font-20 color-black-100 font-family-nunito font-weight-700">
                Welcome to 
                <span class="font-familt-backline color-primary">Cinnamon</span>
            </p>
        </ModalHeader>
        <ModalBody>
            <div class="text-center">
                <img class="mt-1" src="images/user-verification/welcome-image.png" alt="welcome image">
                <p class="font-16 color-grey-100">Joining as an Activity Partner?</p>
                <Button Clicked="VerifiedMaker" class="d-inline-block btn-primary" style="font-size: 16px; font-weight: 700;" 
                    Border="Border.Is0">Yes, I want to be a Cinnamon maker</Button>
                <a class="d-block mt-2 color-grey-100 hover-color-grey-100 cursor-pointer" @onclick="() => ModalRef.Close(CloseReason.None)">No, I am a Customer</a>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>

@code 
{
    private Modal ModalRef {get; set;}

    [Parameter]
    public string Token {get; set;}

    public Task Show()
    {
        return ModalRef.Show();
    }

    private async Task VerifiedMaker()
    {
        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
        if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            var account = result.Result.Result;
            if(account.IsVerified == 0)
            {
                NavigationManager.NavigateTo("/customer/user-verification");
            }
            else 
            {
                ModalRef.Close(CloseReason.None);
            }
        }
    }
}
@namespace Cinnamon.Web.Components.Pages.Creation
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.Services
@inject IJSRuntime jsRuntime;

<div class="activity-summary-wrapper col-lg-12 col-12">
    <label for="title" class="form-control-label label-top-margin mb-2 font-24 m-font-20">Review Your Experience</label>
    <Div class="experience-title" Margin="Margin.Is4.OnY">
        <Div Display="Display.Flex" Flex="Flex.AlignItems.Center" class="location-category" style="display: flex; align-items: center; justify-content: left;">
            @if (Activity.ExperienceTypeId == 1)
            {
                <span>
                    <img class="m-laptop-icon" src="images/activity-summary/location.png" alt="icon">
                </span>
                <span class="background-black-100 font-size-10 text-white-100
                    font-family-nunito in-person-button rounded-pill m-font-size-6">
                    Face to Face
                </span>
            }
            else
            {
                <span>
                    <img class="m-laptop-icon" src="images/activity-summary/laptop-icon.png" alt="icon">
                </span>
                <span class="background-black-100 font-size-10 text-white-100
                    font-family-nunito online-button rounded-pill m-font-size-6">
                    Online
                </span>
            }
        </Div>
        <h3 class="font-family-nunito font-weight-700 text-orange-100 my-3 experience-title font-24 m-font-20">@Activity.Title</h3>
        <p class="font-family-nunito experience-description color-black-100 font-20 m-font-18">@Activity.Description</p>
    </Div>
    @if (Activity.ExperienceTypeId == 1)
    {
        string address = string.IsNullOrEmpty(Activity.PinnedLocation) ? $"{@Activity.Address1 + ", " + Activity.BarangayName + ", " + Activity.CityName + ", " + Activity.RegionName}" : Activity.PinnedLocation;
        <Divider />
        <div class="experience-location margin-botton-3rem m-margin-bottom-10">
            <h3 class="text-capitalize text-orange-100 font-family-nunito
                font-weight-700 margin-botton-1rem m-margin-bottom-10 font-24 m-font-20">
                Location
            </h3>
            <p class="ont-family-nunito font-weight-400 mb-1 font-20 m-font-18 color-black-100">
                Place: @address
            </p>
            @* <p class="font-size-20 text-center font-family-nunito font-weight-400 mb-1 m-font-size-12">Remarks: Near Uno Gas Station, left side going north</p> *@
        </div>
    }
    <Divider />
    <div class="experience-schedules margin-botton-3rem m-margin-bottom-10">
        <h3 class="text-capitalize text-orange-100 font-family-nunito font-weight-700 margin-botton-1rem font-24 m-font-20 m-margin-bottom-10">
            Pricing & Schedule
        </h3>
        <div class="schedule-desktop">
            @if (Activity.ScheduleIndicator == "selection" || Activity.ActivitySchedules.Count > 0)
            {
                var activeSchedule = Activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).ToList();
                if (activeSchedule.Count > 0)
                {
                    <div class="d-block mb-2">
                        @for (int x = 0; x < activeSchedule.Count; x++)
                        {
                            var schedule = activeSchedule.ElementAt(x);
                            <div class="schedule-detail w-100 rounded-5">
                                    <div class="schedule-header d-flex" style="border-top-left-radius:10px;border-top-right-radius:10px">
                                        <div class="schedule-title col-lg-10 clo-md-9 col-sm-9 col-xs-9 col-9 justify-content-start">
                                            <p class="font-20 m-font-18">@activeSchedule.ElementAt(x).Name</p>
                                        </div>
                                    </div>
                                    <hr>
                                    <div class="schedule-body">
                                        <div class="col-lg-12 col-md-12 col-sm-12 PES-details">
                                            @if (x == 0)
                                            {
                                                <div class="col-lg-12 col-md-12 col-sm-12 col-12 justify-content-end recommended-mobile">
                                                    <p class="recommended">Highly Recommended!</p>
                                                </div>
                                            }
                                            <div class="PE-details">
                                                <div class="col-lg-6 col-md-6 col-sm-12 col-12 price-details">
                                                    <div class="d-flex price-details-title">
                                                        <img class="img-price" src="images/schedule-icons/price-icon.png" />
                                                        <p class="font-14">Price Details:</p>
                                                    </div>
                                                    <p class="font-16-d">₱ @activeSchedule.ElementAt(x).LongPrice / @activeSchedule.ElementAt(x).PerUnit1 @activeSchedule.ElementAt(x).PriceUnit1 / @activeSchedule.ElementAt(x).PerUnit2 @activeSchedule.ElementAt(x).PriceUnit2</p>
                                                </div>
                                                @if (schedule.IsSetSession == true)
                                                {
                                                    <div class="col-lg-6 col-md-6 col-sm-12 col-12 expiration-details">
                                                        <div class="d-flex expiration-details-title">
                                                            <img class="img-expiration" src="images/schedule-icons/expiration-icon.png" />
                                                            <p class="font-14">Expiration:</p>
                                                        </div>
                                                        <p class="font-16-d">Consume in - @schedule.SessionName</p>
                                                        <div class="cut-off-details">
                                                            @switch (schedule.HasExpiration)
                                                            {
                                                                case 1:
                                                                    string ordinal = "";
                                                                    DateTime frequency = DateTime.Now;
                                                                    int day = schedule.StartDate.Value.Day;
                                                                    switch (schedule.SessionName)
                                                                    {
                                                                        case "2 Weeks":
                                                                            frequency = schedule.StartDate.Value.AddDays(14);
                                                                            break;
                                                                        case "3 Weeks":
                                                                            frequency = schedule.StartDate.Value.AddDays(21);
                                                                            break;
                                                                        case "1 Month":
                                                                            frequency = schedule.StartDate.Value.AddMonths(1);
                                                                            break;
                                                                        case "2 Months":
                                                                            frequency = schedule.StartDate.Value.AddMonths(2);
                                                                            break;
                                                                        case "3 Months":
                                                                            frequency = schedule.StartDate.Value.AddMonths(3);
                                                                            break;
                                                                    }

                                                                    switch (frequency.Day)
                                                                    {
                                                                        case 1:
                                                                        case 21:
                                                                        case 31:
                                                                            ordinal = "st";
                                                                            break;
                                                                        case 2:
                                                                        case 22:
                                                                            ordinal = "nd";
                                                                            break;
                                                                        case 3:
                                                                        case 23:
                                                                            ordinal = "rd";
                                                                            break;
                                                                        default:
                                                                            ordinal = "th";
                                                                            break;
                                                                    }
                                                                    switch (schedule.SessionName)
                                                                    {
                                                                        case "2 Weeks":
                                                                        case "3 Weeks":
                                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                                                                <small class="form-text sub-details">
                                                                                The expiration period is @schedule.SessionName (calendar days) and will start at @schedule.StartDate.Value.ToString("dd/MM/yyyy").
                                                                                </small>
                                                                            </div>
                                                                            break;
                                                                        case "1 Month":
                                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                                                                <small class="form-text sub-details">
                                                                                    The expiration period is @schedule.SessionName and the cutoff is every @frequency.Day@ordinal day of the month.
                                                                                </small>
                                                                            </div>
                                                                            break;
                                                                        case "2 Months":
                                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                                                                <small class="form-text sub-details">
                                                                                    The expiration period is @schedule.SessionName, and the cutoff is every @frequency.Day@ordinal day of the 3rd month.
                                                                                </small>
                                                                            </div>
                                                                            break;
                                                                        case "3 Months":
                                                                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                                                                <small class="form-text sub-details">
                                                                                    The expiration period is @schedule.SessionName, and the cutoff is every @frequency.Day@ordinal day of the 4th month.
                                                                                </small>
                                                                            </div>
                                                                            break;
                                                                    }
                                                                    break;

                                                                    case 2:
                                                                        <small class="form-text sub-details">
                                                                            Session/s must be consumed in @schedule.SessionName.ToLower(), starting from first attendance.
                                                                        </small>
                                                                        break;

                                                                    default:
                                                                        break;
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="S-details col-lg-12 col-md-12 col-sm-12 col-12">
                                                <div class="d-flex schedule-details-title">
                                                    <img class="img-schedule" src="images/schedule-icons/calendar-icon.png" />
                                                    <p class="font-14">Schedule:</p>
                                                </div>
                                                <p class="font-16-d">@activeSchedule.ElementAt(x).DateTime</p>
                                                @if (x == 0)
                                                {
                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-12 justify-content-end recommended-desktop">
                                                        <p class="recommended">Highly Recommended!</p>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex flex-row gap-3 mb-2 overflow-auto">
                        <p>No schedule available yet, mark as favorite or come back soon for the next updated schedule!</p>
                    </div>
                }
            }
        </div>
    </div>
    <Divider />

    <div class="experience-provide">
        <h3 class="text-capitalize text-orange-100 font-family-nunito font-weight-700
            margin-botton-1rem m-margin-bottom-10 font-24 m-font-20">
            Customer Requirements
        </h3>
        <p class="color-black-100 font-20 m-font-18">
            @if (string.IsNullOrEmpty(Activity.CustomerBringWithThem))
            {
                @("N/A")
                ;
            }
            else if (Activity.CustomerBringWithThem?.ToLower()?.Trim() == "<p><br></p>")
            {
                @("N/A")
                ;
            }
            else
            {
                @((MarkupString)Activity.CustomerBringWithThem)
                ;
            }
        </p>
    </div>
    <Divider />

    <div class="experience-provide">
        <h3 class="text-capitalize text-orange-100 font-family-nunito font-weight-700
            margin-botton-1rem m-margin-bottom-10 font-24 m-font-20">
            Class Policies
        </h3>
        <p class="color-black-100 font-20 m-font-18">
            @if (string.IsNullOrEmpty(Activity.ClassPolicies))
            {
                @("N/A")
                ;
            }
            else if (Activity.ClassPolicies?.ToLower()?.Trim() == "<p><br></p>")
            {
                @("N/A")
                ;
            }
            else
            {
                @((MarkupString)Activity.ClassPolicies)
                ;
            }
        </p>
    </div>
</div>
@code
{
    [Parameter]
    public Activity Activity { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
    }
}
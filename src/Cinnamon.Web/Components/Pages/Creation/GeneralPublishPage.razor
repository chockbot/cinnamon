@namespace Cinnamon.Web.Components.Pages.Creation
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components
@using Cinnamon.Web.Modules.Services
@inject IJSRuntime jsRuntime;

<section class="ote-publish-wrapper">
    <div class="border-radius-10 p-4 bg-white-200 m-bg-white-100 m-padding-0">
        <h3 class="font-24 font-weight-700 color-black-100 text-center">Your activity is almost ready!</h3>
        <Divider />
        <div>
            <p class="font-20 font-weight-700 color-black-100">Here are some important things you need to know:</p>
            <Row HorizontalGutter="20" VerticalGutter="20">
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <div class="box-border border-radius-20 pt-3 pb-4 px-3 text-center bg-white-100 h-100 position-relative">
                        <p class="mb-4 font-20 font-weight-700 color-black-100">
                            What’s gonna happen
                            <br>
                            when someone
                            <br>
                            enrolls?
                        </p>
                        <div class="publish-read-more">
                            <Button class="px-4 py-1 rounded-pill bg-orange-100 color-white-100 font-14 font-weight-700 hover-color-white" Type="ButtonType.Button" Clicked="userFlowModal.ShowModal">
                                Read more
                            </Button>
                        </div>
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <div class="box-border border-radius-20 pt-3 pb-4 px-3 text-center bg-white-100 h-100 position-relative">
                        <p class="mb-3 font-20 font-weight-700 color-black-100">
                            How will I get paid
                            <br>
                            from my activity?
                        </p>
                        <div class="publish-read-more">
                            <Button class="px-4 py-1 rounded-pill bg-orange-100 color-white-100 font-14 font-weight-700 hover-color-white" Type="ButtonType.Button" Clicked="moneyFlowsModal.ShowModal">
                                Read more
                            </Button>
                        </div>
                    </div>
                </Column>
            </Row>
            <p class="mt-4 mb-5 font-20 font-weight-700 color-black-100">Final setup:</p>
            <div class="experience-what-you-will-provide active-marker margin-botton-3rem m-margin-bottom-10 m-font-size-12">
                <input type="hidden" value="@Activity.IsPublishedDescription" id="activity-is-published" />
                <button class="check-button" type="button" @onclick=TogglePublishActivity>
                    <img class="me-1" src='@(Activity.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                    <span class="color-black-100">Activate your activity now</span>
                </button>
            </div>
            <div class="experience-confirmation-checkbox margin-botton-3rem m-margin-bottom-10">
                <div class="d-none d-sm-block d-md-block d-lg-block d-xl-block">
                    <button class="check-button" type="button" @onclick=ToggleConfirmationCheck>
                        <img class="me-1" src='@(CheckboxConfirmation ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                        <span class="color-black-100">
                            I understand that I need that to check and complete the attendance of my customers
                            in the CHECK ATTENDANCE section so that I can receive the payment.
                        </span>
                    </button>
                </div>
                <div class="d-xl-none d-lg-none d-md-none d-sm-none d-block">
                    <span class="confirmation-description">
                        I understand that I need that to check and complete the attendance of my customers
                        in the CHECK ATTENDANCE section so that I can receive the payment.
                    </span>
                    <button class="check-button" type="button" @onclick=ToggleConfirmationCheck>
                        <img class="me-1" src='@(CheckboxConfirmation ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                        <span>
                            Yes, I understand
                        </span>
                    </button>
                </div>
                @if (isShowErrorMessage && !CheckboxConfirmation)
                {
                    <p style="color: red; font-size: 13px; text-align: center; margin-top: 5px;">Please accept and confirm</p>
                }
            </div>
        </div>
    </div>
</section>
<UserFlowModal @ref=userFlowModal Image="user-flow-1.webp" MobileImage="user-flow-mobile.png"/>
<UserFlowModal @ref=moneyFlowsModal Image="money-flows-1.webp" MobileImage="money-flow-mobile.png"/>

@code
{
    [Parameter]
    public Activity Activity { get; set; }

    private bool isPublished { get; set; } = true;

    private bool CheckboxConfirmation { get; set; }

    private bool isShowErrorMessage { get; set; }

    private DetailsSchedulesModal DetailsModalSched { get; set; }

    private UserFlowModal userFlowModal { get; set; }

    private UserFlowModal moneyFlowsModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Activity.ActivityId == 0)
        {
            Activity.IsPublished = true;
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
    }

    private void CheckChange(bool value)
    {
        isPublished = isPublished;
    }

    private Task ConfirmationCheckChanged(bool value)
    {
        CheckboxConfirmation = value;
        return Task.CompletedTask;
    }

    private Task ToggleConfirmationCheck()
    {
        CheckboxConfirmation = !CheckboxConfirmation;
        return Task.CompletedTask;
    }

    private Task TogglePublishActivity()
    {
        Activity.IsPublished = !Activity.IsPublished;
        return Task.CompletedTask;
    }

    public bool Validate()
    {
        if (!CheckboxConfirmation)
        {
            isShowErrorMessage = true;
        }
        return CheckboxConfirmation;
    }
}
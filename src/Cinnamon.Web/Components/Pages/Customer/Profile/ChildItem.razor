@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Core.Models;

<Div Position="Position.Relative" Flex="Flex.NoWrap.OnDesktop.Wrap.OnMobile" class="family-members">
    <Field Margin="Margin.Is3.FromTop" class="form-floating profile-info-input name">
        <TextEdit class="border-10" id="legalFirstname" Size="Size.Default" @bind-Text="Model.Name" />
        <FieldLabel for="legalFirstname">Name</FieldLabel>
    </Field>
    <Field Margin="Margin.Is3.FromTop" class="form-floating profile-info-input gender">
        <Select TValue="string" Size="Size.Default" @bind-SelectedValue="Model.Gender" 
            class="form-select border-10 text-capitalize">
            @foreach (var item in genders)
            {
                <SelectItem Value="item">@item</SelectItem>
            }
        </Select>
        <FieldLabel for="legalFirstname">Gender</FieldLabel>
    </Field>
    <Field Margin="Margin.Is3.FromTop" class="form-floating profile-info-input birthmonth">
        <Select TValue="int" Size="Size.Default" @bind-bind-SelectedValue="Model.BirthMonth" 
            class="form-select border-10 text-capitalize">
            @foreach (var item in months)
            {
                <SelectItem Value="@item">@item</SelectItem>
            }
        </Select>
        <FieldLabel for="legalFirstname">Birth Month</FieldLabel>
    </Field>
    <Field Margin="Margin.Is3.FromTop" class="form-floating profile-info-input year">
        <Select TValue="int" Size="Size.Default" @bind-SelectedValue="Model.BirthYear" 
            class="form-select border-10 text-capitalize">
            @foreach (var item in years)
            {
                <SelectItem Value="@item">@item</SelectItem>
            }
        </Select>
        <FieldLabel for="legalFirstname">Year</FieldLabel>
    </Field>
    <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" @onclick="DeleteClick"> 
        <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
    </Button>
</Div>

@code
{

    [Parameter]
    public Models.Entities.FamilyMember Model {get; set;}

    [Parameter]
    public EventCallback<Models.Entities.FamilyMember> ModelChanged {get; set;}

    [Parameter]
    public EventCallback<Models.Entities.FamilyMember> OnDelete {get; set;}

    private IList<string> genders = new List<string>();

    private IList<int> years = new List<int>();
    
    private IList<string> months = new List<string>();

    protected override void OnInitialized()
    {
        // gender
        genders.Add("male");
        genders.Add("female");

        // years`
        for(int i = 1900; i <= DateTime.Now.Year; i++)
        {
            years.Add(i);
        }

        // months
        months.Add("january");
        months.Add("february");
        months.Add("march");
        months.Add("april");
        months.Add("may");
        months.Add("june");
        months.Add("july");
        months.Add("august");
        months.Add("september");
        months.Add("october");
        months.Add("november");
        months.Add("december");
    }

    private void DeleteClick()
    {
        OnDelete.InvokeAsync(Model);
    }
}
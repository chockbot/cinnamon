@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Models.Entities
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler
@inject NavigationManager NavigationManager


<article class="experience-review-wrapper py-3">
    <h3 class="title">Reviews</h3>
    @if (reviews.Count != 0)
    {
        <div class="d-flex">
            <div class="col-8 d-flex justify-content-start rating-section">
                <Rating Color="Color.Primary" SelectedValue="SelectedValue" MaxValue="5" ReadOnly=true />
                <p class="rating-value">(@AverageRating.ToString("0.0"))</p>
            </div>
            <div class="col-4 d-flex justify-content-end">
                <a class="see-more">See More</a>
            </div>
           
        </div>
        <Div class="experience-reviews-container" Margin="Margin.Is3.FromTop">
            <div class="review-wrapper">
                @foreach (var item in top3Reviews)
                {
                    <ExperienceReviewItem Review="item" />
                }
            </div>
        </Div>
    }
    else
    {
        <p class="p-1" style="font-family:'Nunito';font-weight:bold">No reviews yet!</p>
    }
</article>

@code
{

    [Parameter]
    public IEnumerable<Activity> Activities { get; set; }

    [Parameter]
    public Models.Entities.CustomerProfile Profile { get; set; }

    public List<Reviews> reviews = new List<Reviews>();

    public List<Reviews> top3Reviews = new List<Reviews>();

    public CustomerProfile customerProfile = new CustomerProfile();

    public string Token;

    public int SelectedValue { get; set; } = 0;

    public double AverageRating { get; set; } = 0;

    public ClaimsPrincipal AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var reviewsResult = await ongoingApiHandler.GetReviewsByMakerId(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetReviewsByMakerIdArgs
            {
                MakerId = Profile.Id
            });
        if (reviewsResult.Succeeded && reviewsResult.Result != null && reviewsResult.Result.IsSuccess)
        {
            reviews = reviewsResult.Result.Result.Select(a =>
            {
                return new Reviews
                    {
                        Id = a.Id,
                        CustomerId = a.CustomerId,
                        MakerId = a.MakerId,
                        ActivityId = a.ActivityId,
                        ScheduleId = a.ScheduleId,
                        StudentId = a.StudentId,
                        Review = a.Review,
                        Rating = a.Rating,
                        ReviewDate = a.ReviewDate
                    };
            }).ToList();
        }
        if (reviews.Count != 0)
        {
            double SumOfRating = reviews.Sum(a => a.Rating);
            double numberOfRatee = reviews.Count;
            AverageRating = (double) SumOfRating/numberOfRatee;
            SelectedValue = (int)Math.Round(AverageRating);
            top3Reviews = reviews.Take(3).OrderBy(a => a.ReviewDate).ToList();
        }
    }
}


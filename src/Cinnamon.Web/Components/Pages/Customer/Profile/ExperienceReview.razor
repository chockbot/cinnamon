@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Components
@inject IJSRuntime jsRuntime
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler
@inject NavigationManager NavigationManager

<article class="experience-review-wrapper py-3">
    <h3 class="title">Customer Feedbacks</h3>
    @if (reviews.Count != 0)
    {
        <div class="d-flex">
            <div class="col-8 d-flex justify-content-start rating-section">
                <div id="star-rating"></div>
                <p class="rating-value">(@AverageRating.ToString("0.0"))</p>
            </div>
            @if (reviews.Count > 3)
            {
                <div class="col-4 d-flex justify-content-end">
                    <button class="see-more" @onclick="() => modalRef.ShowModal()">See More</button>
                </div>
            }
        </div>
        <Div class="experience-reviews-container" Margin="Margin.Is3.FromTop">
            <div class="review-wrapper">
                @foreach (var item in top3Reviews)
                {
                    <ExperienceReviewItem Review="item" />
                }
            </div>
        </Div>
    }
    else
    {
        <p class="p-1" style="font-family:'Nunito';font-weight:bold">No reviews yet!</p>
    }
</article>
<CustomerFeedbackModal @ref=modalRef AverageRating="AverageRating" SelectedValue="SelectedValue" ReviewCount="reviews.Count"
Activities="Activities" CustomerProfiles="customerProfiles" MakerProfile="Profile"></CustomerFeedbackModal>
@code
{
    IJSObjectReference module;

    [Parameter]
    public IEnumerable<Activity> Activities { get; set; }

    [Parameter]
    public CustomerProfile Profile { get; set; }

    private CustomerFeedbackModal modalRef;

    public Activity activity = new Activity();

    public List<Reviews> reviews = new List<Reviews>();

    public List<Reviews> top3Reviews = new List<Reviews>();

    public List<CustomerProfile> customerProfiles = new List<CustomerProfile>();

    public CustomerProfile reviweeProfile = new CustomerProfile();

    public int SelectedValue { get; set; } = 0;

    public double AverageRating { get; set; } = 0;

    protected override async Task OnInitializedAsync()
    {
        var reviewsResult = await ongoingApiHandler.GetReviewsByMakerId(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetReviewsByMakerIdArgs
            {
                MakerId = Profile.Id,
            });
        if (reviewsResult.Succeeded && reviewsResult.Result != null && reviewsResult.Result.IsSuccess)
        {
            reviews = reviewsResult.Result.Result.Select(a =>
            {
                return new Reviews
                    {
                        Id = a.Id,
                        CustomerId = a.CustomerId,
                        MakerId = a.MakerId,
                        ActivityId = a.ActivityId,
                        ScheduleId = a.ScheduleId,
                        StudentId = a.StudentId,
                        Review = a.Review,
                        Rating = a.Rating,
                        ReviewDate = a.ReviewDate
                    };
            }).OrderByDescending(a => a.ReviewDate).ToList();
        }
        if (reviews.Count != 0)
        {
            double SumOfRating = reviews.Sum(a => a.Rating);
            double numberOfRatee = reviews.Count;
            AverageRating = (double)SumOfRating / numberOfRatee;
            SelectedValue = (int)Math.Round(AverageRating);
            top3Reviews = reviews.Take(3).ToList();
        }
        //Get Customer Details
        foreach (var item in reviews.GroupBy(g => g.CustomerId).Select(s => s.First()).ToList())
        {
            var profileResult = await accountApiHandler.GetCustomerById(item.CustomerId);
            if (profileResult.Succeeded && profileResult.Result != null && profileResult.Result.IsSuccess)
            {
                var result = profileResult.Result.Result;
                reviweeProfile = new CustomerProfile
                    {
                        Id = result.Id,
                        FirstName = result.FirstName,
                        LastName = result.LastName,
                        ProfilePath = result.ProfileImg
                    };
                customerProfiles.Add(reviweeProfile);
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/StarRating.js");
            await Task.Run(() => module.InvokeVoidAsync("generateStarRating", AverageRating));
        }
        else
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/StarRating.js");
            await Task.Run(() => module.InvokeVoidAsync("generateStarRating", AverageRating));
        }
    }
}
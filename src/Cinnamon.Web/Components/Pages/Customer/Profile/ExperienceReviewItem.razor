@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<div class="swiper-slide">
    <Card class="card-review-item" Border="Border.Is0">
        <CardHeader Border="Border.Is0" Background="Background.Transparent" Margin="Margin.Is3.FromTop">
            <Row Flex="Flex.AlignItems.Center">
                <Column ColumnSize="ColumnSize.Is4.OnDesktop.Is4.OnMobile">
                    <Figure class="figure-container" Overflow="Overflow.Hidden" Width="Width.Max100" Margin="Margin.IsAuto.OnX.Is0.OnY" Display="Display.Block">
                        <FigureImage Margin="Margin.Is0" Source="images/avatar-girl.png" AlternateText="banner" Width="Width.Is100" />
                    </Figure>
                </Column>
                <Column ColumnSize="ColumnSize.Is8.OnDesktop.Is8.OnMobile">
                    <p class="mb-0 reviewer-name">Kelly james</p>
                    <p class="mb-0 reviewer-position">UI/UX Designer</p>
                </Column>
            </Row>
        </CardHeader>
        <CardBody Border="Border.Is0" Margin="Margin.Is3.FromTop" Padding="Padding.Is0.FromTop">
            <CardTitle>
                <p class="reviewer-content mb-2">Lorem, ipsum dolor sit amet consectetur adipisicing elit. Cupiditate autem quaerat fugit a vitae 
                    facilis impedit eveniet suscipit sed animi?</p>
                <Div class="review-badge" Display="Display.Flex" Flex="Flex.JustifyContent.Center.AlignItems.Center">
                    <img class="review-star" src="images/star-tag.png" alt="star">
                    <span class="review-count">5</span>
                </Div>
            </CardTitle>
        </CardBody>
    </Card>
</div>
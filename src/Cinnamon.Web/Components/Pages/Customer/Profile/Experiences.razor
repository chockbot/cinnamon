@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<div>
    <OngoingExperience Activities="Activities" Profile="Profile"/>
    <Divider class="my-3" />
    <CompletedExperience Activities="Activities" Profile="Profile" />
    <Divider class="my-3" />
    <ExpiredExperience Activities="Activities" Profile="Profile" />
    <Divider class="my-3" />
    <OteItems Token="@Token" />
    <Divider class="my-3" />
    <CustomerReview Profile="Profile" Activities="Activities" />
    <Divider class="my-3" />
    <RecommendedExperience Token="@Token" />
</div>

@code
{
    [Parameter]
    public IEnumerable<Models.Entities.Activity> Activities {get; set;}
    [Parameter]
    public Models.Entities.CustomerProfile Profile { get; set; }
    [Parameter]
    public string Token { get; set; }
}
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using System.Security.Claims
@inject IActivityApiHandler activityApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@namespace Cinnamon.Web.Components.Pages.Customer.Profile


<article class="ongoing-experience-wrapper">
    <h3 class="title">Favorite Experiences</h3>
    <Div class="ongoing-experiences-container activitySwiper" Margin="Margin.Is3.FromTop">
        <div class="swiper-wrapper maker-wrapper">
        @if (activities.Count != 0)
        {
            @foreach (var item in Favorites)
                {
                    var ActivityData = activities.Where(a => a.ActivityId == item.ActivityId).FirstOrDefault();
                    @if (ActivityData != null)
                    {
                        <div class="maker-swiper-slide">
                            <Div ElementId="#b-animate">
                                <Animate Anchor="#b-animate"
                                Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                                    <div class="card">
                                    <a class="button" href="@DetailsUrl(ActivityData.Handler, (int)ActivityData.ExperienceCreationType)" style="text-decoration:none;">
                                        <img src="@ActivityData.Images.ElementAt(0).ImageSrc" class="image-header card-img">
                                    </a>
                                    @if (Favorites != null)
                                        {
                                            ActivityData.IsFavorite = Favorites.Any(a => a.ActivityId == ActivityData.ActivityId);
                                            if (ActivityData.IsFavorite != false)
                                            {
                                                <div class="card-img-overlay favorite-section">
                                                    <button type="button" class="favorite-icon-button border-0" @onclick="() =>AddToFavorites(ActivityData)">
                                                        <img src='@(ActivityData.IsFavorite ? "images/favorites/experience-heart-selected.svg" : "images/favorites/experience-heart-default.svg")' class="favorite-icon" />
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="card-img-overlay favorite-section">
                                                    <button type="button" class="favorite-icon-button border-0" @onclick="() =>CreateFavorite(ActivityData)">
                                                        <img src="images/favorites/experience-heart-default.svg" class="favorite-icon" />
                                                    </button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="card-img-overlay favorite-section">
                                                <button type="button" class="favorite-icon-button border-0">
                                                    <img src="images/favorites/experience-heart-default.svg" class="favorite-icon" />
                                                </button>
                                            </div>
                                        }
                                        <div class="card-img-overlay">
                                            @if (ActivityData.OngoingStudents > 0)
                                            {
                                                <div class="rounded-pill ongoing-section">
                                                    <div class="active-badge" style="text-align:center">
                                                        <span class="pulse"></span>
                                                        <span class="active-tag-label">@ActivityData.OngoingStudents</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                <div class="card-container">
                    <div class="row text-start star-pulse-section">
                        <div class="col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 star-section">
                            @if (Activity.NumberOfReviews > 0)
                            {
                                <img src="images/dark-round-star.png" class="star-tag-badge" />
                                <span class="average-rating">@Activity.AverageRating</span>
                                <span class="number-of-reviews">(@Activity.NumberOfReviews)</span>
                            }
                            else
                            {
                            }
                        </div>
                        <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 pulse-section">
                        </div>
                    </div>
                    <div class="row text-start">
                        <div class="title-section">
                            <div>
                                <h4 class="card-title1 mb-0">@Activity.Title</h4>

                                @if (ActivityData.ExperienceTypeId == 1)
                                {
                                    var address = string.IsNullOrEmpty(ActivityData.PinnedLocation) ? $"{ActivityData.CityName + ", " + ActivityData.RegionName}" : ActivityData.PinnedLocation;
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/location-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@address</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="address-holder">
                                    <img src="images/explore-page-images/location-explore.svg" class="location-icon" />
                                    <p class="card-title2 mb-0 online">@(ActivityData.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                    </div>
                                }
                            </div>
                            @{
                               string formattedDate = @Activity.Schedule?.From.ToString("MMM dd, yyyy ● h:mm tt");
                            }
                                @if ((int)ActivityData.ExperienceCreationType == 3)
                                {
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/date-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@formattedDate</p>
                                    </div>
                                } else {
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/tag-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@GetPriceLabel(Activity)</p>
                                    </div>
                                }
                        </div>
                    </div>
                </div>
                                    </div>
                                </Animate>
                            </Div>
                        </div>
                    }
                }
        }
        </div>
    </Div>
</article>
@code
{
    [Parameter]
    public CustomerProfile Profile { get; set; }

    public string Token { get; set; }

    public Activity Activity = new Activity();

    public List<Activity> activities = new List<Activity>();

    public List<Favorite> Favorites = new List<Favorite>();

    public ClaimsPrincipal AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        Token = user.FindFirstValue("Token");
        await GetFavorites();
    }
    private string GetImage()
    {
        if (Activity.Images.Count > 0) return Activity.Images[0].ImageSrc;
        return string.Empty;
    }
    private string GetPriceLabel(Activity activity)
    {
        var schedules = activity.ActivitySchedules.OrderBy(s => s.Price).ToList();
        if (schedules.Count > 1)
        {
            return $"₱ {(long)schedules[0].Price} - {(long)schedules[schedules.Count - 1].Price}";
        }
        if (schedules.Count == 1)
        {
            return $"₱ {(long)schedules[0].Price}";
        }
        return string.Empty;
    }
    private async Task GetFavorites()
    {
        if (Profile != null)
        {
            var customerFavorites = await activityApiHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs
                {
                    CustomerId = Profile.Id
                }, Token);
            if (customerFavorites.Succeeded && customerFavorites.Result != null && customerFavorites.Result.IsSuccess)
            {
                Favorites = customerFavorites.Result.Result.Select(i =>
                {
                    return new Favorite
                        {
                            ActivityId = i.ActivityId,
                            CustomerId = i.CustomerId,
                            IsFavorite = true
                        };
                }).ToList();
            }
            await GetActivity();
        }
    }

    private async Task GetActivity()
    {
        foreach (var item in Favorites)
        {
            var ActivityListData = await activityApiHandler.GetActivity(item.ActivityId, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
                {
                    IncludeActivityAddress = true,
                    IncludeActivityDescription = true,
                    IncludeActivityImages = true,
                    IncludeAtivitySchedules = true,
                    IncludeCustomer = true
                });
            if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
            {
                var result = ActivityListData.Result.Result;
                Activity = new Activity
                    {
                        Id = result.ActivityId,
                        ActivityId = result.ActivityId,
                        Title = result.Title,
                        ExperienceTypeId = result.ExperienceTypeId,
                        Description = result.Description,
                        Price = result.Price,
                        District = result.District,
                        City = result.City,
                        CityName = result.CityName,
                        BarangayName = result.BarangayName,
                        RegionName = result.RegionName,
                        CreatedBy = result.CreatedBy,
                        MapDetails = result.MapDetails,
                        PinnedLocation = result.PinnedLocation,
                        OngoingStudents = result.OngoingStudents,
                        CompletedStudents = result.CompletedStudents,
                        AverageRating = result.AverageRating,
                        NumberOfReviews = result.NumberOfReviews,
                        Handler = result.Handler,
                        ExperienceCreationType = result.ExperienceCreationType,
                        ActivitySchedules = result.ActivitySchedules.Select(e => {
                        return new ActivitySchedule
                        {
                            Id = e.Id,
                            Name = e.Name,
                            PerUnit1 = e.PerUnit1,
                            PerUnit2 = e.PerUnit2,
                            Price = e.Price,
                            PriceUnit1 = e.PriceUnit1,
                            PriceUnit2 = e.PriceUnit2,
                            UnitPrice = e.UnitPrice
                        };
                        }).ToList(),
                        Images = result.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                        Schedule = result.Schedule is not null ? new Activity.OteSchedule {
                        From = result.Schedule.From,
                        To = result.Schedule.To,
                    } : null
                    };
            }
            activities.Add(Activity);
        }
    }

    private async Task AddToFavorites(Activity activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        if (activity.IsFavorite)
        {
            //Add to Favorites
            var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = Profile.Id
                }, Token);
        }
        else
        {
            //Delete to Favorites
            var createFavorite = await activityApiHandler.RemoveFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.RemoveFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = Profile.Id
                }, Token);
        }
        await GetFavorites();
    }

    private async Task CreateFavorite(Activity activity)
    {
        var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
            {
                ActivityId = activity.ActivityId,
                CustomerId = Profile.Id
            }, Token);
        await GetFavorites();

    }
    private string DetailsUrl(string handler, int xpCreationType)
    {
        string url = string.Empty;
        if (xpCreationType == 3)
        {
            url = $"explore/ote/{handler}";
        }
        else if (xpCreationType == 1)
        {
            url = $"explore/{handler}";
        }
        return url;
    }
}

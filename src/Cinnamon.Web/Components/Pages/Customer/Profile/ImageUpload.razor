@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<Div class="image-wrapper">
    <label for="@ImageName" class="upload-image">
        <Figure Width="Width.Is100" Height="Height.Is100" Margin="Margin.Is0">
            <FigureImage Width="Width.Is100" Height="Height.Is100" Margin="Margin.Is0" Source="@GetFrontImageSrc()" />
        </Figure>
    </label>
    <InputFile style="display: none;" id="@ImageName" name="@ImageName" accept=".png,.jpg,.jpeg" OnChange="LoadImage" />
    <p class="m-0">@Label</p>
    @if(!string.IsNullOrEmpty(errorMessage))
    {
        <p class="mt-2 mb-0">@errorMessage</p>
    }
</Div>

@code 
{
    [Parameter]
    public string ImageName {get; set;}
    
    [Parameter]
    public string Label {get; set;}

    [Parameter]
    public byte[] ImageData {get; set;}

    [Parameter]
    public EventCallback<byte[]> ImageDataChanged {get; set;}

    private bool isImageLoading = false;

    private string errorMessage = "";

    private const int maxFileSize = 10000000;

    private string fileName = string.Empty;

    private string GetFrontImageSrc()
    {
        if(isImageLoading) return "/images/loading_indicator.gif";
        
        if(ImageData != null)
        {
            var imageSrc = Convert.ToBase64String(ImageData);
            return string.Format("data:image/jpeg;base64,{0}", imageSrc);
        }

        return "/images/Profile/blank.png";
    }

    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        var file = e.File;
        errorMessage = string.Empty;

        if(!file.ContentType.Contains("image"))
        {
            errorMessage = "Please provide valid image file";
            return;
        }

        try
        {
            isImageLoading = true;
            using(var ms = new MemoryStream())
            {
                await file.OpenReadStream(maxFileSize).CopyToAsync(ms);
                ImageData = ms.ToArray();

                var guid = Guid.NewGuid().ToString();
                var extension = file.ContentType.Split("/")[1];
                fileName = $"{guid}.{extension}";

                await ImageDataChanged.InvokeAsync(ImageData);
            }
        }
        catch 
        {
            errorMessage = "An error occured. Please try again later";
        }
        finally 
        {
            isImageLoading = false;
        }
    }
}
@using Cinnamon.Web.Models.Entities;
@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<div>
    <MakerOngoingExperience Activities="Activities" />
    <Divider class="my-3" />
    @if (Profile.IsMaker)
    {
        <ExperienceReview Activities="Activities" Profile="Profile"/>
    }
</div>

@code
{
    [Parameter]
    public IList<Activity> Activities { get; set; }
    [Parameter]
    public CustomerProfile Profile { get; set; }
}



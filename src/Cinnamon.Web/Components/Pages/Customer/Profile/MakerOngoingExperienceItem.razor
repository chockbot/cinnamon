<div class="maker-swiper-slide">
    <div class="experience-box">
        <div class="experience-header">
            <a class="button" href="/explore/@Activity.ActivityId" style="text-decoration:none;">
                <img class="image-header" src="@GetImage()" />
            </a>
        </div>

        <div class="experience-content">


            <div class="xp-body">
                <div class="xp-body-details">
                    <p class="xp-title">@Activity.Title</p>
                    @if (Activity.ExperienceTypeId == 1)
                    {
                        <p class="price mb-0 text-color-343D">@Activity.City, @Activity.Region</p>
                    }
                    else
                    {
                        <p class="price mb-0 text-color-343D">@(Activity.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                    }
                </div>
                <div class="xp-body-price">
                    <p class="price mb-0 text-color-343D">@Activity.Price</p>
                </div>
            </div>

            <div class="xp-badges">
                <div class="new-badge">
                    <img class="new-tag-icon" src="images/star-tag.png" alt="new icon">
                    <span class="new-tag-label">New</span>
                </div>

                <div class="active-badge">
                    <span class="pulse"></span>
                    <span class="active-tag-label">18</span>
                </div>
            </div>




        </div>
    </div>
</div>







@code
{
    [Parameter]
    public Activity Activity { get; set; }

    private string GetImage()
    {
        if (Activity.Images.Count > 0) return Activity.Images[0].ImageSrc;
        return string.Empty;
    }
}


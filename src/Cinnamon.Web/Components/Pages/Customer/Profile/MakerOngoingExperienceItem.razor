@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Framework.Enums
@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<div class="maker-swiper-slide">
    <Div ElementId="b-animate">
        <Animate Anchor="b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
            <div class="card">
                @if (Activity.Status == Enums.ActivityStatus.InProgress)
                {
                    <img src="@GetImage()" class="image-header card-img">
                    <div class="card-img-overlay">
                        @if (Activity.OngoingStudents > 0)
                        {
                            <div class="rounded-pill ongoing-section">
                                <div class="active-badge" style="text-align:center">
                                    <span class="pulse"></span>
                                    <span class="active-tag-label">@Activity.OngoingStudents</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <a class="button" href=@DetailsUrl(Activity.Handler, (int)Activity.ExperienceCreationType, Activity.ForceDisable) style="text-decoration:none;">
                        <img src="@GetImage()" class="image-header card-img">
                        <div class="card-img-overlay">
                            @if (Activity.OngoingStudents > 0)
                            {
                                <div class="rounded-pill ongoing-section">
                                    <div class="active-badge" style="text-align:center">
                                        <span class="pulse"></span>
                                        <span class="active-tag-label">@Activity.OngoingStudents</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </a>
                }
               
                <div class="card-container">
                    <div class="row text-start star-pulse-section">
                        <div class="col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 star-section">
                            @if (Activity.NumberOfReviews > 0)
                            {
                                <img src="images/dark-round-star.png" class="star-tag-badge" />
                                <span class="average-rating">@Activity.AverageRating</span>
                                <span class="number-of-reviews">(@Activity.NumberOfReviews)</span>
                            }
                            else
                            {
                            }
                        </div>
                        <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 pulse-section">
                        </div>
                    </div>
                    <div class="row text-start">
                        <div class="title-section">
                            <div>
                                <h4 class="card-title1 mb-0">@Activity.Title</h4>

                                @if (Activity.ExperienceTypeId == 1)
                                {
                                    var address = string.IsNullOrEmpty(Activity.PinnedLocation) ? $"{Activity.CityName + ", " + Activity.RegionName}" : Activity.PinnedLocation;
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/location-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@address</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="address-holder">
                                    <img src="images/explore-page-images/location-explore.svg" class="location-icon" />
                                    <p class="card-title2 mb-0 online">@(Activity.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                    </div>
                                }
                            </div>
                            @{
                               string formattedDate = @Activity.Schedule?.From.ToString("MMM dd, yyyy ● h:mm tt");
                            }
                                @if ((int)Activity.ExperienceCreationType == 3)
                                {
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/date-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@formattedDate</p>
                                    </div>
                                } else {
                                    <div class="address-holder">
                                        <img src="images/explore-page-images/tag-explore.svg" class="location-icon" />
                                        <p class="card-title2 mb-0 in-person text-capitalize">@GetPriceLabel(Activity)</p>
                                    </div>
                                }
                        </div>
                    </div>
                </div>
            </div>
        </Animate>
    </Div>


</div>

@code
{
    [Parameter]
    public Activity Activity { get; set; }

    private string GetImage()
    {
        string image = Activity.Images.Count > 0 ? Activity.Images[0].ImageSrc : "images/blank-placeholder.svg";
        return image;
    }

    private string GetPriceLabel(Activity activity)
    {
        var schedules = activity.ActivitySchedules.OrderBy(s => s.Price).ToList();
        if (schedules.Count > 1)
        {
            return $"₱ {(long)schedules[0].Price} - {(long)schedules[schedules.Count - 1].Price}";
        }
        if (schedules.Count == 1)
        {
            return $"₱ {(long)schedules[0].Price}";
        }
        return string.Empty;
    }
    private string DetailsUrl(string handler, int xpCreationType, bool IsForceDisabled)
    {
        string url = string.Empty;
        if (IsForceDisabled)
        {
            url = $"maker/dashboard/expired-event/{handler}";
        }
        else
        {
            if (xpCreationType == 3)
            {
                url = $"explore/ote/{handler}";
            }
            else if (xpCreationType == 1)
            {
                url = $"explore/{handler}";
            }
        }
        
        return url;
    }
}


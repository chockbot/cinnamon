@using Cinnamon.Web.Models.Entities;
@namespace Cinnamon.Web.Components.Pages.Customer.Profile

<div class="maker-swiper-slide">
    <Div ElementId="#b-animate">
        <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
            <div class="card">
                <a class="button" href="/explore/@Activity.ActivityId" style="text-decoration:none;">
                    <img src="@GetImage()" class="image-header card-img">
                    <div class="card-img-overlay">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 heart-badge-section">
                                <span class="d-none d-xl-block">
                                    <img src="images/heart-xl.png" />
                                </span>
                                <span class="d-none d-lg-block d-xl-none">
                                    <img src="images/heart-lg.png" />
                                </span>
                                <span class="d-none d-md-block d-lg-none">
                                    <img src="images/heart-md.png" />
                                </span>
                                <span class="d-none d-sm-block d-md-none">
                                    <img src="images/heart-sm.png" />
                                </span>
                                <span class="d-block d-sm-none">
                                    <img src="images/heart-sm.png" />
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
                <div class="card-container">
                    <div class="row text-start star-pulse-section">
                        <div class="col-xl-6 col-lg-8 col-md-8 col-sm-8 col-9 star-section">
                            <img src="images/star-tag-small.png" class="star-tag-badge" />
                            <span>
                                @if (@Activity.IsNew)
                                {
                                    <i> New Experience</i>
                                }
                                else
                                {
                                    <i> 4.1(10)</i>
                                }
                            </span>

                        </div>
                        <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-3 pulse-section">
                            <img src="images/verified-badge.png" class="verified-badge" />
                        </div>
                    </div>
                    <div class="row text-start">
                        <div class="title-section">
                            <div>
                                <h4 class="card-title1 mb-0">@Activity.Title</h4>
                                @if (@Activity.ExperienceTypeId == 1)
                                {
                                    <p class="card-title2 mb-0 in-person">@Activity.CityName, @Activity.RegionName</p>
                                }
                                else
                                {
                                    <p class="card-title2 mb-0 online">@(Activity.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row price-badge-section">
                        <div class="col-xl-9 col-lg-9 col-md-9 col-sm-9 col-9 price-section"><p class="card-title3">@GetPriceLabel(Activity)</p></div>
                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-3 active-badge-section">
                            <div class="active-badge" style="text-align:center">
                                <span class="pulse-complete"></span>
                                <span class="active-tag-label">@Activity.CompletedStudents</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Animate>
    </Div>


</div>

@code
{
    [Parameter]
    public Activity Activity { get; set; }

    private string GetImage()
    {
        if (Activity.Images.Count > 0) return Activity.Images[0].ImageSrc;
        return string.Empty;
    }

    private string GetPriceLabel(Activity activity)
    {
        var schedules = activity.ActivitySchedules.OrderBy(s => s.Price).ToList();
        if (schedules.Count > 1)
        {
            return $"₱ {(long)schedules[0].Price} - {(long)schedules[schedules.Count - 1].Price}";
        }
        if (schedules.Count == 1)
        {
            return $"₱ {(long)schedules[0].Price}";
        }
        return string.Empty;
    }
}


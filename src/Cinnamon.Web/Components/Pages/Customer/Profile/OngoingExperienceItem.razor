@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]
@inject IJSRuntime jsRuntime

@if (isLoading == true)
{
    for(int x=0; x < 3; x++)
    {
        <div class="experience-box skeleton">
            <div class="top-content">
                <div class="experience-content">
                    <a class="button" style="text-decoration:none;">
                        <label class="xp-title skeleton">Activity Title</label>
                    </a>

                    <div class="xp-body-item skeleton">
                        <p class="secondary-caption">Activity Name</p>
                    </div>

                    <div class="xp-body-item skeleton">
                        <p class="secondary-caption">0/1</p>
                        <div class="progress">
                            <div class="progress-bar bg-success" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                    <div class="xp-body-item skeleton">
                        <p class="secondary-caption">
                            Expires on - January 01, 2001
                        </p>
                    </div>
                </div>
                <div class="experience-header skeleton">
                    <a class="button" style="text-decoration:none;">
                        <img class="image-header" />
                    </a>
                </div>
            </div>
            <div class="view-button skeleton">
                <Button Color="Color.Primary" Border="Border.Is0" style="width:100%">
                    View Attendance
                </Button>

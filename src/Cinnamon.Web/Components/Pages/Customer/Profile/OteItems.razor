@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Framework.ApiCommand.ApiCore.DTO.Activity;
@inject IActivityApiHandler activityApiHandler;
@inject ITransactionApiHandler transactionApiHandler;
@inject NavigationManager NavigationManager;
@inject INotificationService NotificationService;
@inject IJSRuntime JSRuntime

<article class="events-wrapper">
    <div class="events-container" Margin="Margin.Is3.FromTop">
        <h3 class="title">Events</h3>
        @if(otesItems is not null)
        {
            <div class="event-container-item-wrapper">
                @foreach (var item in otesItems)
                {
                    <div class="experience-box" @key="item">
                        <div class="top-content">
                            <label class="xp-title text-capitalize">@item.EventName</label>
                            <div class="experience-header">
                                <img class="image-header" src="@item.ImageSrc" />
                            </div>
                        </div>
                        <div class="view-button">
                            <Button Loading="item.Loading" Disabled="item.Loading" 
                                Color="Color.Primary" Clicked="() => RedirectTicketDetails(item)" Border="Border.Is0" class="w-100 view-exp-btn">
                                <LoadingTemplate>
                                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                                    Getting Ticket Details
                                </LoadingTemplate>
                                <ChildContent>
                                    View Ticket Details
                                </ChildContent>
                            </Button>
                        </div>
                    </div>   
                }
            </div>
        }
    </div>
</article>

@code
{
    [Parameter]
    public string Token { get; set; }

    private IEnumerable<TicketItemWithLoader> otesItems {get; set;}

    protected override async Task OnInitializedAsync()
    {
        var result = await activityApiHandler.CustomerOte(Token);
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            otesItems = result.Result.Result.Select(t => {
                return new TicketItemWithLoader {
                    EventName = t.EventTitle,
                    ImageSrc = t.ImageSrc,
                    PurchaseOrderId = t.PurchaseOrderId
                };
            });
        }
    }

    private async Task RedirectTicketDetails(TicketItemWithLoader item)
    {
        item.Loading = true;
        StateHasChanged();

        var result = await transactionApiHandler.GetOtePurchaseOrder(item.PurchaseOrderId, Token);
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            await JSRuntime.InvokeAsync<object>("open", result.Result.Result.TicketUrl, "_blank");
        }
        else 
        {
            await NotificationService.Error("An error occured. Please contact support.", "Error");
        }
        item.Loading = false;
    }

    private class TicketItemWithLoader 
    {
        public int PurchaseOrderId {get; set;}
        public string EventName {get; set;}
        public string ImageSrc {get; set;}
        public bool Loading {get; set;}
    }
}
@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Core.Module.CustomerService.Handler;
@inject IUpdateCustomerLegalName updateLegalNameHandler;

<article class="personal-info-wrapper p-3">
    <div class="p-section name-section">
        <Row>
            <Column ColumnSize="ColumnSize.Is6.OnDesktop">
                <p class="title mb-1">Legal Name</p>
                @if(!isEditLegalName)
                {
                    <Div class="details" Display="Display.Flex" Flex="Flex.AlignContent.End.JustifyContent.Between">
                        <span class="text-capitalize">@Model.Customer.FirstName @Model.Customer.LastName</span>
                        <span class="edit" @onclick="EditLegalNameClick">Edit</span>
                    </Div>
                }
                else
                {
                    <Div class="details" Display="Display.Flex" Flex="Flex.AlignContent.End.JustifyContent.Between">
                        <span>Your name should match the name in your submitted Government ID.</span>
                        <span class="edit" @onclick="() => isEditLegalName = !isEditLegalName">Cancel</span>
                    </Div>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is6.OnDesktop">
                            <div class="form-floating mt-3 profile-info-input">
                                <TextEdit class="border-10" id="legalFirstname" Size="Size.Default" @bind-Text="firstNameLocalState" />
                                <label for="legalFirstname">First name</label>
                            </div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is6.OnDesktop">
                            <div class="form-floating mt-3 profile-info-input">
                                <TextEdit class="border-10" id="legalLastname" Size="Size.Default" @bind-Text="lastNameLocalState" />
                                <label for="legalLastname">Last name</label>
                            </div>
                        </Column>
                    </Row>
                    <Button Border="Border.Is0" Margin="Margin.Is3.FromTop" TextColor="TextColor.White" Color="Color.Primary" @onclick="SaveLegalName">Save</Button>
                }
            </Column>
        </Row>
    </div>
    <Divider />
    <div class="p-section children-section">
        <Row>
            <Column ColumnSize="ColumnSize.Is6.OnDesktop">
                <p class="title mb-1">Kids Info</p>
                <Div class="details" Display="Display.Flex" Flex="Flex.AlignContent.End.JustifyContent.Between">
                    <Column style="margin-right: 1.5rem;">
                        @foreach (var item in children)
                        {
                            <Row style="flex: 0 0 auto;">
                                <Column>
                                    <p class="text-capitalize">@item.Name</p>
                                </Column>
                                <Column>
                                    <p class="text-capitalize text-center">@item.Gender</p>
                                </Column>
                                <Column>
                                    <p class="text-capitalize text-end">@item.BirthDate</p>
                                </Column>
                            </Row>
                        }
                    </Column>
                    <span class="edit">Edit</span>
                </Div>
            </Column>
        </Row>
    </div>
    <Divider />
    <div class="p-section ids-section">
        <Row>
            <Column ColumnSize="ColumnSize.Is6.OnDesktop">
                <p class="title mb-1">Governmend ID</p>
                <Div class="details" Display="Display.Flex" Flex="Flex.AlignContent.End.JustifyContent.Between">
                    <span>ID no. 1</span>
                    <span class="edit">Edit</span>
                </Div>
            </Column>
        </Row>
    </div>
</article>

<style scoped>
.personal-info-wrapper {
    font-family: "Nunito";
    overflow: hidden;
}
.personal-info-wrapper p 
{
    margin-bottom: 0;
}
.personal-info-wrapper .p-section .title 
{
    font-size: 18px;
    color: #344050;
    font-weight: 700;
}
.personal-info-wrapper .p-section .details 
{
    font-size: 16px;
    color: #717171;
    font-weight: 500;
}
.personal-info-wrapper .p-section .edit 
{
    font-size: 14px;
    font-weight: 700;
    color: #343D4C;
    cursor: pointer;
}
</style>

@code 
{
    [Parameter]
    public Models.Customer.Profile Model {get; set;}

    private IList<Child> children = new List<Child>();
    
    private bool isEditLegalName = false;
    
    private string firstNameLocalState = string.Empty;
    
    private string lastNameLocalState = string.Empty;
    
    protected override void OnInitialized()
    {
        children.Add(new Child {BirthDate = "April 2010", Gender = "Female", Name = "juanita san jose"});
        children.Add(new Child {BirthDate = "September 2008", Gender = "Male", Name = "charanko san jose"});
        children.Add(new Child {BirthDate = "December 2006", Gender = "Femala", Name = "rocia san jose"});
    }

    private void EditLegalNameClick()
    {
        isEditLegalName = !isEditLegalName;
        if(isEditLegalName)
        {
            firstNameLocalState = Model.Customer.FirstName;
            lastNameLocalState = Model.Customer.LastName;
        }
        else
        {
            firstNameLocalState = string.Empty;
            lastNameLocalState = string.Empty;
        }
    }

    private async Task SaveLegalName()
    {
        if(isEditLegalName)
        {
            var result = await updateLegalNameHandler.ExecuteAsync(
                new Core.Module.CustomerService.Interactors.UpdateLegalName {CustomerId = Model.Customer.Id, FirstName = firstNameLocalState, LastName = lastNameLocalState});
            
            if(result.Succeeded)
            {
                Model.Customer.FirstName = firstNameLocalState;
                Model.Customer.LastName = lastNameLocalState;
            }
        }
        isEditLegalName = false;
    }

    public class Child 
    {
        public string Name {get; set;}
        public string Gender {get; set;}
        public string BirthDate {get; set;}
    }
}


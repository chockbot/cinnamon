@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;

<article class="recommended-experience-wrapper py-3">
    <h3 class="title font-weight-700">Recommended Experiences</h3>
    <Div class="recommended-experiences-container" Margin="Margin.Is3.FromTop">
        @if(Activities != null)
        {
            <Row VerticalGutter="10">
                @foreach(var activity in Activities)
                {
                    <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
                        <MakerOngoingExperienceItem Activity="activity" />
                    </Column>
                }
            </Row>
        }
    </Div>
</article>

@code 
{
    [Parameter]
    public string Token { get; set; }

    private IList<Activity> Activities { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recommendActivitiesRes = await activityApiHandler.RecommendedActivities(Token);
            if(recommendActivitiesRes.Succeeded && recommendActivitiesRes.Result != null && recommendActivitiesRes.Result.IsSuccess)
            {
                Activities = recommendActivitiesRes.Result.Result.Select(a =>
                {
                    return new Activity
                        {
                            ActivityId       = a.ActivityId,
                            Title            = a.Title,
                            Description      = a.Description,
                            Price            = a.Price,
                            Handler          = a.Handler,
                            District         = a.District,
                            City             = a.City,
                            Region           = a.Region,
                            Barangay         = a.Barangay,
                            Address1         = a.Address1,
                            Address2         = a.Address2,
                            ExperienceTypeId = a.ExperienceTypeId,
                            Images = a.Images.Select(i =>
                            {
                                return new ActivityImage
                                {
                                    ActivityId = a.ActivityId,
                                    Id         = i.Id,
                                    ImageSrc   = i.ImageSrc,
                                    Name       = i.Name,
                                    Order      = i.Order
                                };
                            }).ToList(),
                            ActivitySchedules = a.ActivitySchedules.Select(i =>
                            {
                                return new ActivitySchedule
                                {
                                    Id         = i.Id,
                                    Name       = i.Name,
                                    PerUnit1   = i.PerUnit1,
                                    PerUnit2   = i.PerUnit2,
                                    Price      = i.Price,
                                    PriceUnit1 = i.PriceUnit1,
                                    PriceUnit2 = i.PriceUnit2,
                                    UnitPrice  = i.UnitPrice
                                };
                            }).ToList(),
                        };
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
}


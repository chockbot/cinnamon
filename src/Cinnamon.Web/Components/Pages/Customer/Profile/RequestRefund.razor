@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Models.Customer;
@using Cinnamon.Web.Models.Account;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Framework.ApiCommand.ApiCore.DTO.Disbursement;
@using static Cinnamon.Web.Models.Customer.RequestRefundModel;
@using Cinnamon.Web.Models.Entities
@inject IActivityApiHandler activityApiHandler;
@inject IAccountApiHandler accountApiHandler;
@inject ITransactionApiHandler transactionApiHandler
@inject IAdminApiHandler adminApiHandler;
@inject IDashboardApiHandler dashboardApiHandler

<article class="request-refund">
    @if (Profile.IsMaker == true)
    {
        <div class="request-refund-containers">
            <h3 class="request-refund-title">Earnings</h3>
            <div class="earnings-wrapper">
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-block justify-content-start">
                            <p class="title">Receivables from Cinnamon</p>
                            <p class="amount">&#8369;@String.Format("{0:N}",totalReceivables.Sum(t => t.Amount))</p>
                            <p class="amount-description">Complete your enrollee's attendance to automatically receive this amount in your payout account.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-block justify-content-start">
                            <p class="title">Total Earnings</p>
                            <p class="amount">&#8369;@String.Format("{0:N}",totalEarnings.Sum(t => t.Amount))</p>
                            <p class="amount-description">This is the total credited amount to your account.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-block justify-content-start">
                            <p class="title">Gross Sales</p>
                            @if (directSales.Count != 0)
                            { 
                                <p class="amount">&#8369;@String.Format("{0:N}",totalSales)</p>
                                <p class="amount-description">@String.Format("{0:N}", grossSales.Sum(a => a.Total)) + @String.Format("{0:N}", directSales.Sum(a => a.Total))</p>
                                <p class="amount-description">This is your sales from Cinnamon and Direct students.</p>
                            }
                            else
                            {
                                <p class="amount">&#8369;@String.Format("{0:N}",totalSales)</p>
                                <p class="amount-description">This is the sales from Cinnamon.</p>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="payout-information">
            <p class="payout-title">Payout Information</p>
            <div class="details col-lg-4 col-md-4 col-sm-12 col-12 d-flex justify-content-start">
                @if (PayoutAccount == null)
                {
                    <span class="font-16">No Data Found</span>
                    <span class="edit">
                        <NavLink class="edit" style="color:#717171;" href="/customer/profile/payout-account">Add</NavLink>
                    </span>
                }
                else
                {
                    if (PayoutAccount.UnMaskedNumber[0] == '2' || PayoutAccount.UnMaskedNumber[0] == '5')
                    {
                        <img class="me-2" style="width: 26px;" src="images/payment/master-card.svg" alt="icon">
                        <span class="font-16">@MaskedString(PayoutAccount.UnMaskedNumber, 4)</span>
                    }
                    else if (PayoutAccount.UnMaskedNumber[0] == '4')
                    {
                        <img class="me-2" style="width: 36px;" src="images/payment/visa-card.svg" alt="icon">
                        <span class="font-16">@MaskedString(PayoutAccount.UnMaskedNumber, 4)</span>
                    }
                    else
                    {
                        <span class="font-16">@MaskedString(PayoutAccount.UnMaskedNumber, 4)</span>
                    }
                    <span class="edit">
                        <NavLink class="edit" style="color:#717171;" href="/customer/profile/payout-account">Edit</NavLink>
                    </span>
                }
            </div>
        </div>
        <Divider />
        <p class="payout-remider">
            *You will receive payment once a session is completed. Please allow 2 banking days for clearing. Payout schedule is Tuesday and Friday every week.
        </p>
    }
    
    @*Payout History*@
    @if (disbursements.Count != 0)
    {
        <div class="payout-history">
            <p class="payout-title">Payout History</p>
            <div class="col-lg-6 col-md-10 col-sm-12 col-12">
                <div class="payout-table">
                    <div class="table-list">
                        <Table Class="payout-history-table">
                            <TableHeader>
                                <TableRow>
                                    <TableHeaderCell class="th-id">
                                        No
                                    </TableHeaderCell>
                                    <TableHeaderCell class="th-date">
                                        Date
                                    </TableHeaderCell>
                                    <TableHeaderCell class="th-amount">
                                        Amount
                                    </TableHeaderCell>
                                    <TableHeaderCell class="th-status">
                                        Status
                                    </TableHeaderCell>

                                </TableRow>
                            </TableHeader>
                            <TableBody>
                                @foreach (var item in disbursements)
                                {
                                    <TableRow>
                                        <TableRowCell class="tr-id">
                                            <span>@item.Id</span>
                                        </TableRowCell>
                                        <TableRowCell class="tr-date">
                                            <span>@item.PayoutDate.ToString("yyyy-MM-dd")</span>
                                        </TableRowCell>
                                        <TableRowCell class="tr-amount">
                                            <span>&#8369;@item.Amount</span>
                                        </TableRowCell> 
                                        <TableRowCell class="tr-status">
                                            <span class="payout-status" style="background-color:@(item.Status == "disbursed" ? "#4BB749" : "#F3D052")">
                                                @switch (item.Status)
                                                {
                                                    case "initiated":
                                                        Status = "Pending";
                                                        break;

                                                    case "disbursed":
                                                        Status = "Approved";
                                                        break;

                                                    case "pending":
                                                        Status = "Processing";
                                                        break;

                                                    default:
                                                        Status = "Unknown";
                                                        break;
                                                }
                                                @Status
                                            </span>
                                        </TableRowCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                        <Pagination Class="pagination-section" Style="margin-top: 20px;">
                            <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
                                <PaginationLink>
                                    <span aria-hidden="true">&laquo;</span>
                                </PaginationLink>
                            </PaginationItem>
                            @{
                                int pagesToShow = 6;
                                int startPage = Math.Max(1, (byte)Pagination.PageIndex - (pagesToShow / 2));
                                int endPage = Math.Min((byte)Pagination.TotalPages, startPage + pagesToShow - 1);

                                for (var i = startPage; i <= endPage; i++)
                                {
                                    var pageNumberAsString = i.ToString();
                                    <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                                        <PaginationLink Page="@pageNumberAsString" Clicked="SetActive">
                                            @pageNumberAsString
                                        </PaginationLink>
                                    </PaginationItem>
                                }
                            }
                            <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next">
                                <PaginationLink>
                                    <span aria-hidden="true">&raquo;</span>
                                </PaginationLink>
                            </PaginationItem>
                        </Pagination>
                    </div>
                </div>
            </div>
        </div>
    }
    
    @*Cinnamon Credits*@
    <div class="cinnamon-credits-table">
        <div class="col-lg-6 col-md-10 col-sm-12 col-12">
            <p class="payout-title">Cinnamon credits</p>
            <p class="payout-remider">
            Cinnamon credits can be used as payment when purchasing an activity.
        </p>
        <Table Class="credits-table">
            <TableHeader class="m-d-none">
                <TableRow>
                    <TableHeaderCell>Reference No</TableHeaderCell>
                    <TableHeaderCell>Experience Title</TableHeaderCell>
                    <TableHeaderCell>Status</TableHeaderCell>
                    <TableHeaderCell class="credit-text">Credits</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var item in requestedRefunds)
                {
                    <TableRow>
                        <TableRowCell>@item.ReferenceNo</TableRowCell>
                        <TableRowCell>@item.ExperienceTitle</TableRowCell>
                        <TableRowCell>@GetStatus(item.Status)</TableRowCell>
                        <TableRowCell class="credit-text">@item.RefundAmountGiven.ToString("#,##0.00")</TableRowCell>
                    </TableRow>
                }
            </TableBody>
            <TableFooter style="border-top: 1px solid #D9D9D9;">
                <TableRow>
                    <TableRowCell ColumnSpan="3">Total</TableRowCell>
                    <TableRowCell class="text-end"> @requestedRefunds.Sum(r => r.RefundAmountGiven).ToString("#,##0.00") </TableRowCell>
                </TableRow>
            </TableFooter>
        </Table>
        </div>
    </div>
    @*Request Refund*@
    <div class="request-refund-table">
        <div class="col-lg-6 col-md-10 col-sm-12 col-12">
            <p class="payout-title">Request for refund</p>
            <Table Borderless Class="refund-table">
            <TableHeader class="m-d-none">
                <TableRow>
                    <TableHeaderCell>Refund No</TableHeaderCell>
                    <TableHeaderCell>Experience Title</TableHeaderCell>
                    <TableHeaderCell>Status</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var item in Model.RequestedRefunds)
                {
                    <TableRow>
                        <TableRowCell>@item.ReferenceNo</TableRowCell>
                        <TableRowCell>@item.ExperienceTitle</TableRowCell>
                        <TableRowCell>@GetStatus(item.Status)</TableRowCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
            <Divider class="m-d-none" />
            <Button Clicked="() => Model.ModalRef.Show()" class="btn-primary" Border="Border.Is0">Request Refund</Button>
        </div>
    </div>

    <Modal @ref="Model.ModalRef">
        <ModalContent Centered Padding="Padding.Is3">
            <ModalHeader>
                <ModalTitle class="text-center col">Request for Refund</ModalTitle>
                <Button Type="ButtonType.Button" class="btn-close" Clicked="() => Model.ModalRef.Close(CloseReason.UserClosing)"></Button>
            </ModalHeader>
            <ModalBody Padding="Padding.Is0.FromTop">
                <Divider Margin="Margin.Is0.FromTop" />
                <div class="d-flex align-items-center div-warning">
                    <img src="images/small-mdi-warning-circle.png" class="me-2" alt="waning">
                    <p class="m-0 warning">IMPORTANT: Refund process will take at least 2 weeks. Once approved, your refund request will be added to your Cinnamon credits.  </p>
                </div>
                <br>
                <Validations @ref="Model.ValidationsRef" Mode="ValidationMode.Manual" Model="Model.ModelForm">
                    <Field Horizontal>
                        <FieldLabel Padding="Padding.Is1.FromBottom">Experience</FieldLabel>
                        <FieldBody>
                            <Select class="@GetSelectClass"
                                TValue="int" @bind-SelectedValue="Model.SelectedExperienceId">
                                <SelectItem Disabled selected>Please Select Enrolled Experience</SelectItem>
                                @foreach (var item in Model.EnrolledExperiences)
                                {
                                    <SelectItem Value="item.Id">@item.Title</SelectItem>
                                }
                            </Select>
                            <div class="invalid-feedback">Please select enrolled experience</div>
                        </FieldBody>
                    </Field>
                    <Validation>
                        <Field Horizontal Margin="Margin.Is2.FromTop">
                            <FieldLabel Padding="Padding.Is1.FromBottom">Reason</FieldLabel>
                            <FieldBody>
                                <MemoEdit Rows="3" @bind-Text="Model.ModelForm.Reason">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </MemoEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <div class="text-center my-3">
                        <Button Clicked="SubmitRequest" Padding="Padding.Is4.OnX" Size="Size.Small" 
                            Border="Border.Is0" class="btn-primary" Loading="Model.IsSubmitting" Disabled="Model.IsSubmitting">
                            <LoadingTemplate>
                                <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Submitting
                            </LoadingTemplate>
                            <ChildContent>
                                Submit
                            </ChildContent>
                        </Button>
                    </div>
                    <Alert Color="Color.Danger" Margin="Margin.Is2.FromTop" Visible="Model.IsShowErrorMessage">
                        <AlertDescription>@Model.Message</AlertDescription>
                    </Alert>
                </Validations>
            </ModalBody>
        </ModalContent>
    </Modal>
</article>

                    @code{

    [Parameter]
    public Models.Entities.CustomerProfile Profile { get; set; }

    [Parameter]
    public string Token {get; set;}

    private RequestRefundModel Model {get; set;} = new();

    private PayoutAccountModel PayoutAccount { get; set; }

    private List<DisbursementsInformationDTO> disbursements = new();

    private List<PayoutHistory> payouts = new List<PayoutHistory>();

    private IList<Requested> requestedRefunds = new List<Requested>();

    private List<GrossSales> grossSales = new List<GrossSales>();

    private List<GrossSales> directSales = new List<GrossSales>();

    private List<Payouts> totalEarnings = new List<Payouts>();

    private List<Payouts> totalReceivables = new List<Payouts>();

    private decimal totalSales { get; set; } = 0;

    public const string PREVIOUS = "previous";
    public const string NEXT = "next";
    public int pageItems = 10;
    public string currentPage = "1";
    public int counterPage = 10;
    public int count = 0;

    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();


    private string Status { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Model.EnrolledExperiences = new List<RequestRefundModel.EnrolledExperience>();
            var refundableResult = await activityApiHandler.GetRefundableExperience(Token);
            if(refundableResult.Succeeded && refundableResult.Result != null && refundableResult.Result.IsSuccess)
            {
                Model.EnrolledExperiences = refundableResult.Result.Result.Select(r => {
                    return new RequestRefundModel.EnrolledExperience {
                        Id = r.PurchaseOrderId,
                        Title = r.Name
                    };
                });
            }
            await FetchRequestedRefunds();
            await FetchPayoutAccount();
            await FetchCinnamonCredits();
            await GetTotalEarnings();
            await GetReceivables();
            await GetGrossSale();
            await GetDisbursement(1);
        }
        catch (Exception ex)
        {
            Model.Message = "An error occured. Please try again later";
        }
    }
    private string GetStatus(int status)
    {
        if (status == 0) return "Submitted";
        if (status == 1) return "Approved";
        if (status == 2) return "Disapproved";

        return string.Empty;
    }
    private async Task SubmitRequest()
    {
        try
        {
            var selectedExperience = Model.EnrolledExperiences.FirstOrDefault(s => s.Id == Model.SelectedExperienceId);
            if(selectedExperience == null) Model.IsShowErrorSelectedExperience = true;

            if(await Model.ValidationsRef.ValidateAll() && selectedExperience != null)
            {
                Model.IsSubmitting = true;
                var result = await accountApiHandler.RequestRefund(new Framework.ApiCommand.ApiCore.Account.Request.RequestRefundArgs {
                    PurchaseOrderId = selectedExperience.Id,
                    Reason = Model.ModelForm.Reason
                }, Token);
                Model.IsSubmitting = false;
                if(!result.Succeeded || result.Result == null || !result.Result.IsSuccess)
                {
                    Model.Message = result.Result?.ErrorInfo?.Message ?? result.Message;
                    Model.IsShowErrorMessage = true;
                    return;
                }

                Model.ModalRef.Close(CloseReason.UserClosing);

                await FetchRequestedRefunds();
            }
        }
        catch
        {
            Model.Message = "An error occured. Please try again later";
            Model.IsShowErrorMessage = true;
        }
    }

    private string GetSelectClass
    {
        get {
            if(Model.IsShowErrorSelectedExperience) 
            {
                return "form-control is-invalid";
            }
            return "form-control";
        }
    }

    private async Task FetchRequestedRefunds()
    {
        var result = await accountApiHandler.GetRequestedRefunds(new Framework.ApiCommand.ApiCore.Account.Request.GetRequestedRefundsArgs {Status = 0}, Token);
        if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            Model.RequestedRefunds = result.Result.Result.Select(r => {
                return new RequestRefundModel.Requested {
                    ExperienceTitle = r.ActivityTitle,
                    ReferenceNo = r.ReferenceNo,
                    Status = r.Status
                };
            }).ToList();
        }
    }
    private async Task FetchPayoutAccount()
    {
        var fetchPayoutAccount = await accountApiHandler.GetPayoutAccount(Token);
        if (fetchPayoutAccount.Succeeded && fetchPayoutAccount.Result != null && fetchPayoutAccount.Result.IsSuccess)
        {
            var payoutAccount = fetchPayoutAccount.Result.Result;
            PayoutAccount = new PayoutAccountModel
                {
                    AccountHolder  = payoutAccount.AccountHolder,
                    AccountNumber  = payoutAccount.AccountNumber,
                    UnMaskedNumber = payoutAccount.UnMaskAccountNumber,
                    Id             = payoutAccount.Id
                };
        }
    }
    private async Task FetchCinnamonCredits()
    {
        var result = await accountApiHandler.GetRequestedRefunds(new Framework.ApiCommand.ApiCore.Account.Request.GetRequestedRefundsArgs { Status = 1 }, Token);
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            requestedRefunds = result.Result.Result.Select(r =>
            {
                return new Requested
                    {
                        ExperienceTitle = r.ActivityTitle,
                        ReferenceNo = r.ReferenceNo,
                        Status = r.Status,
                        RefundAmountGiven = r.RefundAmountGiven
                    };
            }).ToList();
        }
    }
    private async Task GetGrossSale()
    {
        //Get gross sale by Activity Provider
        var gross = await transactionApiHandler.GetGrossSalesByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetGrossSalesByProviderArgs
            {
                Id       = Profile.Id,
                DateFrom = new DateTime(2000, 1, 1).ToString("yyyyMMddHHmmss")
            }, Token);
        if (gross.Succeeded && gross.Result != null && gross.Result.IsSuccess)
        {
            grossSales = gross.Result.Result.OrderBy(a => a.PurchaseDate).Select(e =>
            {
                return new GrossSales
                {
                    PurchaseDate = e.PurchaseDate,
                    Total = e.Total
                };
            }).ToList();
        }
        //Get direct student sales by Activity Provider
        var directGross = await transactionApiHandler.GetDirectStudentSales(new Framework.ApiCommand.ApiCore.Transaction.Request.GetDirectStudentSalesArgs
        {
            ProviderId = Profile.Id,
            DateFrom = new DateTime(2000, 1, 1).ToString("yyyyMMddHHmmss")
        }, Token);
        if (directGross.Succeeded && directGross.Result != null && directGross.Result.IsSuccess)
        {
            directSales = directGross.Result.Result.OrderBy(a => a.CreatedOn).Select(e =>
            {
                return new GrossSales
                {
                    PurchaseDate = e.CreatedOn,
                    Total = e.Amount
                };
            }).ToList();
        }
        //Get Total Amount
        totalSales = grossSales.Sum(a => a.Total) + directSales.Sum(a => a.Total);
    }
    private async Task GetTotalEarnings()
    {
        //Get total earnings by Activity Provider
        var payout = await transactionApiHandler.GetPayoutsByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetPayoutsByProviderArgs
            {
                Id       = Profile.Id,
                DateFrom = new DateTime(2000, 1, 1).ToString("yyyyMMddHHmmss"),
                Status   = 2
            }, Token);
        if (payout.Succeeded && payout.Result != null && payout.Result.IsSuccess)
        {
            totalEarnings = payout.Result.Result.OrderBy(a => a.PayoutDate).Select(e =>
            {
                return new Payouts
                    {
                        Date   = e.PayoutDate.Date,
                        Amount = e.Amount
                    };
            }).ToList();
        }
    }

    private async Task GetReceivables()
    {
        //Get total receivables by Activity Provider
        var payout = await transactionApiHandler.GetPayoutsByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetPayoutsByProviderArgs
            {
                Id       = Profile.Id,
                DateFrom = new DateTime(2000, 1, 1).ToString("yyyyMMddHHmmss"),
                Status   = 1
            }, Token);
        if (payout.Succeeded && payout.Result != null && payout.Result.IsSuccess)
        {
            totalReceivables = payout.Result.Result.OrderBy(a => a.PayoutDate).Select(e =>
            {
                return new Payouts
                    {
                        Date = e.PayoutDate.Date,
                        Amount = e.Amount
                    };
            }).ToList();
        }
    }

    private async Task GetDisbursement(int pageIndex)
    {
        var result = await dashboardApiHandler.GetDisbursementByProvider(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetDisbursementByProviderArgs
            {
                ProviderId = Profile.Id,
                CountPerPage = counterPage,
                PageIndex = pageIndex,
            }, Token);
        if (result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            Pagination = result.Result.Pagination;
            disbursements = result.Result.Result.OrderBy(a => a.PayoutDate).ToList();
        }
    }

    private bool IsActive(string page)
       => currentPage == page;

    private bool IsPageNavigationDisabled(string navigation)
    {
        if (navigation.Equals(PREVIOUS))
        {
            return currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return currentPage.Equals(pageItems.ToString());
        }
        return false;
    }

    private async Task Previous()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt > 1)
        {
            currentPage = (currentPageAsInt - 1).ToString();
            await GetDisbursement(int.Parse(currentPage));
        }
    }

    private async Task Next()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt < Pagination.TotalPages)
        {
            currentPage = (currentPageAsInt + 1).ToString();
            await GetDisbursement(int.Parse(currentPage));
        }
    }

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetDisbursement(int.Parse(page));
    }

    private string MaskedString(string value, int count)
    {
        return new String('*', value.Length - count) + value.Substring(value.Length - count);
    }
    public class PayoutHistory
    {
        public int Id { get; set; }
        public string Date { get; set; }
        public decimal Amount { get; set; }
        public bool Status { get; set; }
    }
}
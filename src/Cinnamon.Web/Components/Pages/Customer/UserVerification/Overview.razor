@namespace Cinnamon.Web.Components.Pages.Customer.UserVerification

<section class="user-verification-account-setup-section">
    <div class="container">
        <p class="text-capitalize font-32 font-weight-700 color-black-100 mb-0">account setup</p>
        <p class="font-16 color-grey-100">Let’s get you ready to become a Cinnamon Maker. Here are some thing you’ll need to prepare:</p>

        <div class="verification-images mt-5">
            <Row VerticalGutter="20">
                <Column ColumnSize="ColumnSize.Is4.OnDesktop.Is12.OnMobile">
                    <img class="w-100" src="images/user-verification/verified-user.svg" alt="user image">
                </Column>
                <Column ColumnSize="ColumnSize.Is4.OnDesktop.Is12.OnMobile">
                    <img class="w-100" src="images/user-verification/verified-id.svg" alt="card image">
                </Column>
                <Column ColumnSize="ColumnSize.Is4.OnDesktop.Is12.OnMobile">
                    <img class="w-100" src="images/user-verification/verified-document.svg" alt="document image">
                </Column>
            </Row>
        </div>
        <div class="text-center mt-5">
            <Button Type="ButtonType.Button" class="btn-primary" Border="Border.Is0">
                Continue
            </Button>
        </div>
    </div>
</section>

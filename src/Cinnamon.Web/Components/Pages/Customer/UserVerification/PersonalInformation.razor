@namespace Cinnamon.Web.Components.Pages.Customer.UserVerification
@using Cinnamon.Web.Components;
@using System.ComponentModel.DataAnnotations;
@using System.Security.Claims;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject NavigationManager NavigationManager;
@inject IAccountApiHandler accountApiHandler;
@inject IJSRuntime jsRuntime;

<section class="user-verification-personal-information-section">
    <div class="container">
        <p class="text-capitalize font-32 font-weight-700 color-black-100 mb-0">personal information</p>
        <p class="font-16 color-grey-100">Tell us a little bit about yourself. This information will appear on your public profile.</p>

        <div class="persinal-details mt-5">
            <div class="personal-details-fullname">
                <Validations @ref="refValidation" Mode="IsManualValidation ? ValidationMode.Manual : ValidationMode.Auto" Model="Model">
                    <Row>
                        <Column ColumnSize="ColumnSize.Is3">
                            <label class="color-black-100 font-weight-700 font-24 text-capitalize">full name</label>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is9">
                            <Row HorizontalGutter="10">
                                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is4.OnTablet">
                                    <Validation>
                                        <TextEdit class="text-capitalize" Placeholder="First Name" @bind-Text="Model.FirstName">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Validation>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is4.OnTablet">
                                    <Validation>
                                        <TextEdit class="text-capitalize" Placeholder="Last Name" @bind-Text="Model.LastName">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Validation>
                                </Column>
                            </Row>
                        </Column>
                    </Row>
                </Validations>
            </div>
            <div class="peronal-details-profile-image mt-5">
                <Row>
                    <Column ColumnSize="ColumnSize.Is3" Padding="Padding.Is3.FromTop">
                        <label class="color-black-100 font-weight-700 font-24 text-capitalize">profile picture</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is9">
                        <Figure class="profile-pic" Position="Position.Relative">
                            <CardImage Source=@Model.ProfileImageSrc Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White" />
                            <Button class="edit-profile-icon" Clicked="() => modalUploadProfile.ShowModal()">
                                <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                            </Button>
                        </Figure>
                    </Column>
                </Row>
            </div>
            <div class="personal-detail-about mt-4">
                <Row>
                    <Column ColumnSize="ColumnSize.Is3">
                        <label class="color-black-100 font-weight-700 font-24 text-capitalize">about you</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is9">
                        <div>
                            <MemoEdit id="bio-editor" Border="Border.Rounded" Rows="5" @bind-Text="Model.Bio" />
                            <p id="label-editor" class="text-end color-grey-100 m-0 font-14">Max of 80 words (0/80)</p>
                        </div>
                    </Column>
                </Row>
            </div>
        </div>
        <div class="text-center mt-5">
            <Button Clicked="SaveChanges" Type="ButtonType.Button" class="btn-primary font-20" Border="Border.Is0"
                Disabled="Model.IsSubmitting" Loading="Model.IsSubmitting">
                <LoadingTemplate>
                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                    Saving Changes
                </LoadingTemplate>
                <ChildContent>
                    Continue
                </ChildContent>
            </Button>
        </div>
    </div>
</section>

@if(!string.IsNullOrEmpty(Model.Token))
{
    <ModalUploadingProfile @ref="modalUploadProfile" IsReload="false" Token="@Model.Token" OnProfileSubmit="OnProfileImageSaved"  />
}

@code 
{
    private ModalUploadingProfile modalUploadProfile {get; set;}

    private bool IsManualValidation = true;

    private Validations refValidation {get; set;}

    private PersonalInfoModel Model {get; set;} = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        Model.Token = user.FindFirstValue("Token");
        if(string.IsNullOrEmpty(Model.Token))
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var accountResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Model.Token);
        if((!accountResult.Succeeded || accountResult.Result == null) || (accountResult.Succeeded && !accountResult.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var account = accountResult.Result.Result;

        Model.FirstName = account.FirstName;
        Model.LastName = account.LastName;
        Model.ProfileImageSrc = account.ProfileImg;
        Model.Bio = account.About;
        Model.Birthdate = account.Birthdate;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.init", "#label-editor", "#bio-editor", "Max", 80);
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.max", "#label-editor", "#bio-editor", "Max", 80);
        }
    }

    private async Task SaveChanges()
    {
        if(await refValidation.ValidateAll())
        {
            Model.IsSubmitting = true;

            var legalNameResult = await accountApiHandler.UpdateProfileDetails(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
                {
                    FirstName = Model.FirstName,
                    LastName = Model.LastName,
                    About = Model.Bio,
                    Datebirth = Model.Birthdate
                }, Model.Token);

            Model.IsSubmitting = false;
        }
        else 
        {
            IsManualValidation = false;
        }
    }

    private Task OnProfileImageSaved(string imageSrc)
    {
        Model.ProfileImageSrc = imageSrc;
        return Task.CompletedTask;
    }

    class PersonalInfoModel 
    {
        [Required(ErrorMessage = "Please provide valid first name")]
        public string FirstName {get; set;}
        [Required(ErrorMessage = "Please provide valid last name")]
        public string LastName {get; set;}
        public DateTime Birthdate {get; set;}

        public string? Bio {get; set;}
        public string ProfileImageSrc {get; set;} = "images/Profile/user.png";
        public string Token {get; set;}
        public bool IsSubmitting {get; set;}
    }
}
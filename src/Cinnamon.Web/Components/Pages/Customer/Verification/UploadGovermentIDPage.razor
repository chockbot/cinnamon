@namespace Cinnamon.Web.Components
@page "/uploadGovermentId/{Token}"
@using Cinnamon.Web.Models.Customer;
@using Cinnamon.Web.Components.Pages.Customer.Profile;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject IAccountApiHandler accountApiHandler;
@inject IJSRuntime JsRuntime

<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Lets upload your Government ID
            </label>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="label-paragraph">
                Your ID will be handled according to our Privacy Policy and won’t be shared with a Cinnamon Maker.
            </label>
        </div>
    </div>
    <div class="row mrow justify-content-center">
        <div class="col-lg-5 col-md-5 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <ImageUpload Model="frontData" />
            <label class="label-paragraph">
                Upload Front of ID
            </label>
            <br />
            <br />
            <ImageUpload Model="backData" />
            <label class="label-paragraph">
                Upload Back of ID
            </label>
            <br />
            <br />
            <ImageUpload Model="backData" />
            <label class="label-paragraph">
                Upload photo of yourself
            </label>
            <br />
            <br />
            <div class="button-container" style="overflow:auto;">
                <Button Border="Border.Is0" class="btn-primary" Type="ButtonType.Button" id="nextBtn">
                    Submit
                </Button>
            </div>
        </div>
        <div class="col-lg-5 col-md-5 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Take Note
            </label>
            <br />
            <br />
            <label class="label-paragraph">
                Here are the recommended IDs you can submit to
                immediately get verified
            </label>
            <br />
            <ul clas>
                <li>Drivers's License</li>
                <li>Passport</li>
                <li>Postal ID</li>
                <li>PRC ID</li>
                <li>SSS ID</li>
                <li>UMID</li>
                <li>Voters ID</li>
                <li>Phylsys National ID</li>
                <li>HDMF ID (Pag-ibig)</li>
                <li>TIN ID</li>
            </ul>
            <br />
            <label class="label-paragraph">
                We aim to keep the data you share during this process
                private, safe, and secure. Learn more in our <a href="/Policy" style="text-decoration:none;color:var(--primary);">Privacy Policy</a>.
            </label>

        </div>
    </div>
</div>


@code {
    [Parameter]
    public string Token { get; set; }

    private UploadGovernmenId frontData = new();

    private UploadGovernmenId backData = new();

    private DotNetObjectReference<UploadGovermentIDPage>? obj;

    private bool isLoading = false;

    private bool isShowErrorMessage = false;

    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await accountApiHandler.GetGovermentIds(Token);
        if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            throw new ApplicationException("An error occured when getting government ids");
        }

        obj = DotNetObjectReference.Create(this);

        frontData.Label = "Front of ID";
        frontData.ImageName = "FrontId";
        frontData.ImageFileName = result.Result.Result.FrontIdImagePath;
        frontData.ImageId = "id-front-image";
        frontData.ErrorId = "id-front-error";

        backData.Label = "Back of ID";
        backData.ImageName = "BackId";
        backData.ImageFileName = result.Result.Result.BackIdImagePath;
        backData.ImageId = "id-back-image";
        backData.ErrorId = "id-back-error";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("MyLib.Components.modal.uploadGovenmentId.init", obj);
        }
    }
}

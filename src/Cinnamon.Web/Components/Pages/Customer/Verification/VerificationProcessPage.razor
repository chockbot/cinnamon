@namespace Cinnamon.Web.Components
@page "/verificationprocess"
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject NavigationManager NavigationManager

<div class="col-lg-12 justify-content-center col-md-12 justify-content-center col-sm-12 justify-content-center col-12 justify-content-center text-lg-center text-md-center text-sm-center">
    <div class="box justify-content-center">
        <p class="p-thank">Thank you!</p>
        <img class="img-process" src="\images\process.png">
        <p class="p-verification">Your account verification is in progress  </p>
        <p class="p-notify">We’ll notify you via e-mail with the status of your verification, keep in touch. Thanks! </p>
        <a href="/customer/profile" class="link-explore">Go Back to Account</a>
    </div>
</div> 

@code{
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        if (token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }
    }
}
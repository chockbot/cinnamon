<div class="mt-4 experience-list">
    <Table Striped>
        <TableHeader>
            <TableRow>
                <TableHeaderCell>
                    <Check TValue="bool" TextColor="TextColor.Primary" Checked="@true" />
                </TableHeaderCell>
                <TableHeaderCell class="font-14">Experience Name</TableHeaderCell>
                @* <TableHeaderCell class="font-14" TextAlignment="TextAlignment.Center"># of enrolled</TableHeaderCell>
                <TableHeaderCell class="font-14" TextAlignment="TextAlignment.Center"># of enrolled ending in next session</TableHeaderCell> *@
                <TableHeaderCell class="font-14" TextAlignment="TextAlignment.Center">Deavtivate</TableHeaderCell>
            </TableRow>
        </TableHeader>
        <TableBody>
            <TableRow>
                <TableRowHeader>
                    <Check TValue="bool" Checked="@true" />
                </TableRowHeader>
                <TableRowCell>Football Experience - age group 1</TableRowCell>
                @* <TableRowCell TextAlignment="TextAlignment.Center">30</TableRowCell>
                <TableRowCell TextAlignment="TextAlignment.Center">3</TableRowCell> *@

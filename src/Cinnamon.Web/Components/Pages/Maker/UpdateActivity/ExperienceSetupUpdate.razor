    private void MoveScheduleUp(ActivitySchedule selected)
    {
        var orderedSchedules = Model.Activity.ActivitySchedules.OrderBy(s => s.Order).ToList();
        for(int i =0; i < orderedSchedules.Count; i++)
        {
            var schedule = orderedSchedules[i];
            if(selected == schedule)
            {
                if(i > 0)
                {
                    orderedSchedules[i-1].Order += 1;
                    schedule.Order -=1;
                }
            }
        }
    }

    private void MoveScheduleDown(ActivitySchedule selected)
    {
        var orderedSchedules = Model.Activity.ActivitySchedules.OrderBy(s => s.Order).ToList();
        for(int i =0; i < orderedSchedules.Count; i++)
        {
            var schedule = orderedSchedules[i];
            if(selected == schedule)
            {
                if(i != orderedSchedules.Count -1)
                {
                    orderedSchedules[i+1].Order -= 1;
                    schedule.Order +=1;
                }
            }
        }
    }

    private Task ItemDropped(DraggableDroppedEventArgs<ImageItem> dropItem)
    {
        if (dropItem.IndexInZone + 1 > dropItem.Item.NewOrder)
        {
            for (int i = dropItem.IndexInZone + 1; i > 0; i--)
            {
                var item = imageItems.FirstOrDefault(m => m.NewOrder == i);
                if (item != null)
                {
                    item.NewOrder -= 1;
                }
            }
        }
        else
        {
            for (int i = dropItem.IndexInZone + 1; i <= imageItems.Count; i++)
            {
                var item = imageItems.FirstOrDefault(m => m.NewOrder == i);
                if (item != null)
                {
                    item.NewOrder += 1;
                }
            }
        }

        dropItem.Item.NewOrder = dropItem.IndexInZone + 1;
        return Task.CompletedTask;
    }

    public bool IsImagesUpdated => isImageUpdated;

    public IEnumerable<ImageItem> ImageItems => imageItems;

    private async Task MoveNext(ImageItem item)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.moveImage.moveNext", $".{item.Id}");
        if (item.NewOrder < 3)
        {
            for (int i = item.NewOrder + 1; i > item.NewOrder; i--)
            {
                var imageItem = imageItems.FirstOrDefault(m => m.NewOrder == i);
                if (imageItem != null)
                {
                    imageItem.NewOrder -= 1;
                }
            }
            item.NewOrder += 1;
        }
    }

    private async Task MovePrevious(ImageItem item)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.moveImage.movePrevious", $".{item.Id}");
        if (item.NewOrder > 1)
        {
            for (int i = item.NewOrder - 1; i <= imageItems.Count; i++)
            {
                var imageItem = imageItems.FirstOrDefault(m => m.NewOrder == i);
                if (imageItem != null)
                {
                    imageItem.NewOrder += 1;
                }
            }
            item.NewOrder -= 1;
        }
    }


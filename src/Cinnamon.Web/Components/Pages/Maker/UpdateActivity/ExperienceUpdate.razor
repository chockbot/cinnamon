@namespace Cinnamon.Web.Components.Pages.Maker.UpdateActivity
@using Cinnamon.Web.Models;
@inject IJSRuntime jsRuntime;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;

<h3 class="fw-bold mb-2">Experience creation</h3>
<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>
<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Name your experience!
            </label>
            <br />
            <label class="label-paragraph">
                This is the title of your experience that people will see first! Make it
                informative and distinctive so that your customers may understand
                what you are offering
            </label>
        </div>
        <div class="col-lg-1 col-md-1 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
        </div>
        <div class="textarea-container col-lg-5 col-md-5 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="d-flex flex-column">
                <textarea id="update-activity-title" @bind="Model.Activity.Title" class="@RequiredCheck(Model.Activity.Title)"></textarea>
                <label>Max of 15 words</label>
            </div>
        </div>
    </div>

    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.letsDescribeExperience
            </label>
            <br />
            <label class="label-paragraph">
                @Resources.App.whatClientsGoingToDo
            </label>
            <br />
            <label class="label-paragraph">
                - Give detailed plans from beginning to end, not a bunch of ideas or
                options.
            </label>
            <br />
            <br />
            <label class="label-paragraph">
                - Describe what makes your experience unique something that
                guests wouldn't do on their own.
            </label>
        </div>
        <div class="col-lg-1 col-md-1 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
        </div>
        <div class="textarea-container col-lg-5 col-md-5 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="d-flex flex-column">
                <textarea id="update-activity-description" class="@RequiredMin(Model.Activity.Description,20)" @bind="Model.Activity.Description"></textarea>
                <label>Min of 20 words</label>
            </div>
        </div>
    </div>

    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                What type of experience are you sharing?
            </label>
        </div>
        <div class="col-lg-1 col-md-1 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
        </div>
        <div class="col-lg-5 col-md-5 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if (GetExperience("in-person") != null)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" data-id="" name="experience-type" id="in-person"
                       checked='SelectedExperience(GetExperience("in-person").Id)'
                       @onchange='@(()=>CheckboxChanged(GetExperience("in-person").Id))'>
                    <label class="form-check-label" for="in-person">
                        In-person - join in the real world to participate actively
                    </label>
                </div>
            }
            @if (GetExperience("online") != null)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="experience-type" id="online"
                       checked='SelectedExperience(GetExperience("online").Id)'
                       @onchange='@(()=>CheckboxChanged(GetExperience("online").Id))'>
                    <label class="form-check-label" for="online">
                        Online - join via video conferencing software (provided by Cinnamon Maker)
                    </label>
                </div>
            }
        </div>
    </div>

    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Where is your experience located?
            </label>
        </div>
        <div class="col-lg-1 col-md-1 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
        </div>
        <div class="col-lg-5 col-md-5 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if (Model.Activity.ExperienceTypeId == 2)
            {
                <input class="form-control" placeholder="Address" disabled />
                <input class="form-control my-3" placeholder="Subdivision/Building" disabled />
                <input class="form-control my-3" placeholder="Region/State" disabled />
                <input class="form-control my-3" placeholder="City" disabled />
                <input class="form-control my-3" placeholder="Barangay" disabled />
                <input class="form-control my-3" placeholder="Postal Code" disabled />
            }
            else
            {
                <input class="form-control @RequiredCheck(Model.Activity.Address1)" placeholder="Unit No./ House No.*" required @bind="Model.Activity.Address1" />
                <input class="form-control my-3 (Model.Activity.Subdivision)" placeholder="Subdivision/Building" required @bind="Model.Activity.Subdivision" />
                <Autocomplete TItem="Models.Entities.Region"
                          SelectedValue="@(Model.Activity.Region)"
                          SelectedText="@(Model.Activity.RegionName)"
                          TValue="string"
                          Class="@RequiredCheck(Model.Activity.Region)"
                          Data="@regionList"
                          TextField="@(( item ) => item.Name)"
                          ValueField="@(( item ) => item.Code)"
                          Placeholder="Region/State"
                          Filter="AutocompleteFilter.StartsWith"
                          FreeTyping
                          CustomFilter="@(( item, searchValue ) => item.Name.IndexOf( searchValue, 0, StringComparison.CurrentCultureIgnoreCase ) >= 0 )"
                          SelectedValueChanged="@((value) => GetCitiesByRegion(value, false))"
                          SelectedTextChanged="@((text) => SetRegionName(text))">
                    <NotFoundContent> Sorry... @context was not found. </NotFoundContent>
                </Autocomplete>
                <div class="divider"></div>
                <Autocomplete TItem="Models.Entities.City"
                          SelectedValue="@(Model.Activity.City)"
                          SelectedText="@(GetCityName())"
                          Disabled="@(cityList?.Count() == 0)"
                          Class="@RequiredCheck(Model.Activity.City)"
                          TValue="string"
                          Data="@cityList"
                          TextField="@(( item ) => item.Name)"
                          ValueField="@(( item ) => item.Code)"
                          Placeholder="City"
                          Filter="AutocompleteFilter.StartsWith"
                          FreeTyping
                          CustomFilter="@(( item, searchValue ) => item.Name.IndexOf( searchValue, 0, StringComparison.CurrentCultureIgnoreCase ) >= 0 )"
                          SelectedValueChanged="@((value) => GetBarangaysByCity(value))"
                          SelectedTextChanged="@((text) => SetCityName(text))">
                    <NotFoundContent> Sorry... @context was not found. </NotFoundContent>
                </Autocomplete>
                <div class="divider"></div>
                <Autocomplete TItem="Models.Entities.Barangay"
                          SelectedValue="@(Model.Activity.Barangay)"
                          SelectedText="@(GetBarangayName())"
                          Disabled="@(barangayList?.Count() == 0)"
                          Class="@RequiredCheck(Model.Activity.Barangay)"
                          TValue="string"
                          Data="@barangayList"
                          TextField="@(( item ) => item.Name)"
                          ValueField="@(( item ) => item.Code)"
                          Placeholder="Barangay"
                          Filter="AutocompleteFilter.StartsWith"
                          FreeTyping
                          CustomFilter="@(( item, searchValue ) => item.Name.IndexOf( searchValue, 0, StringComparison.CurrentCultureIgnoreCase ) >= 0 )"
                          SelectedValueChanged="@((value) => SetBarangay(value))"
                          SelectedTextChanged="@((text) => SetBarangayName(text))">
                    <NotFoundContent> Sorry... @context was not found. </NotFoundContent>
                </Autocomplete>
                <input class="form-control my-3 (Model.Activity.PostalCode)" placeholder="Postal Code" required @bind="Model.Activity.PostalCode" />
            }
        </div>
    </div>

    <div class="row mb-4 mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Session Expiration
            </label>
        </div>
        <div class="col-lg-1 col-md-1 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
        </div>
        <div class="col-lg-5 col-md-5 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center mt-2 toggle-expiration">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="Model.Activity.IsSetSession">
                </div>
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center mt-1 dropdown-expiration">
                <label class="set-exp">Set Expiration</label>
                @if (Model.Activity.IsSetSession == false)
                {
                    Model.Activity.SessionName = string.Empty;
                    <select class="form-control session-period" @bind="Model.Activity.SessionName" disabled="true">
                        <option disabled selected>Select Period</option>
                        @foreach (var sessionPeriod in Model.SessionPeriods)
                        {
                            <option value="@sessionPeriod">@sessionPeriod</option>
                        }
                    </select>
                }
                else
                {
                    <select class="form-control session-period" @bind="Model.Activity.SessionName">
                        <option disabled selected>Select Period</option>
                        @foreach (var sessionPeriod in Model.SessionPeriods)
                        {
                            <option value="@sessionPeriod">@sessionPeriod</option>
                        }
                    </select>
                }
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public ExperienceUpdateModel Model { get; set; }

    private string searchTag;

    public int SearchTagLength { get; set; } = 0;

    IEnumerable<Models.Entities.Region> regionList;
    IEnumerable<Models.Entities.City> cityList;
    IEnumerable<Models.Entities.Barangay> barangayList;

    protected override async Task OnInitializedAsync()
    {
        regionList = Model.Regions;
        await GetCitiesByRegion(Model.Activity.Region, true);
        await GetBarangaysByCity(Model.Activity.City);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.max", "#update-activity-title", 15);
        }
    }

    private void SetRegionName(string regionName)
    {
        Model.Activity.RegionName = regionName;
    }


     private string GetCityName()
    {
        return (string.IsNullOrEmpty(Model.Activity.CityName)) ? (cityList?.FirstOrDefault(c => c.Code == Model.Activity.City)?.Name) : Model.Activity.CityName;
    }

    private void SetCityName(string cityName)
    {
        Model.Activity.CityName = cityName;
    }

    private string GetBarangayName()
    {
        return (string.IsNullOrEmpty(Model.Activity.BarangayName)) ? (barangayList?.FirstOrDefault(c => c.Code == Model.Activity.Barangay)?.Name) : Model.Activity.BarangayName;
    }

    private void SetBarangayName(string barangayName)
    {
        Model.Activity.BarangayName = barangayName;
    }

    private async Task GetCitiesByRegion(string regionCode, bool isFirstLoad)
    {
        Model.Activity.Region = regionCode;

        if (!isFirstLoad)
        {
            Model.Activity.City = string.Empty;
            Model.Activity.CityName = string.Empty;
            Model.Activity.Barangay = string.Empty;
            Model.Activity.BarangayName = string.Empty;
        }

        var result = await activityApiHandler.GetAllCitiesByRegionCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllCitiesArgs { RegionCode = regionCode });

        if (result.Succeeded || result == null)
        {
            cityList = result.Result.Result.Select(r => new Models.Entities.City
                {
                    Code = r.Code,
                    Name = r.Name,
                    RegionCode = r.RegionCode
                });
        }
    }

    private async Task GetBarangaysByCity(string cityCode)
    {
        if (!string.IsNullOrEmpty(cityCode))
        {
            Model.Activity.City = cityCode;

            var result = await activityApiHandler.GetAllBarangaysByCityCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllBarangaysArgs { CityCode = cityCode });

            if (result.Succeeded || result == null)
            {
                barangayList = result.Result.Result.Select(r => new Models.Entities.Barangay
                    {
                        Code = r.Code,
                        Name = r.Name,
                        CityCode = r.CityCode
                    });
            }
        }
       
    }

    private void SetBarangay(string barangayCode)
    {
        if (!string.IsNullOrEmpty(barangayCode))
        {
            Model.Activity.Barangay = barangayCode;
        }
    }

    private void CheckboxChanged(int val)
    {
        Model.Activity.ExperienceTypeId = val;
    }

    public void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Comma")
        {
            if (Model.Activity.SearchTags.Count < 5 && (Model.Activity.SearchTags.Where(x => x == searchTag).FirstOrDefault()) == null)
            {
                Model.Activity.SearchTags.Add(searchTag);
            }
            searchTag = string.Empty;
        }
    }

    private string RequiredCheck(IList<string> searchTags)
    {
        if (searchTags.Count <= 0) return "invalid";
        return "";
    }

    private void RemoveSearchTag(string tag)
    {
        Model.Activity.SearchTags.Remove(tag);
    }

    private string RequiredCheck(string? value)
    {
        if (String.IsNullOrEmpty(value)) return "invalid";
        return "";
    }

    private string RequiredMin(string text, int min)
    {
        var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        if (length < min) return "invalid";
        return string.Empty;
    }

    private bool IsWordsLengthMin(string text, int min)
    {
        var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        return length < min;
    }

    private string RequiredCheck(int? value)
    {
        if (value == null || value == 0) return "invalid";
        return "";
    }

    private string ShowErrorMessage()
    {
        return Model.ExperienceHasError ? "block" : "none";
    }

    private Models.Entities.ExperienceType? GetExperience(string name)
        => Model.ExperienceTypes.FirstOrDefault(i => i.Name.ToLower() == name);

    private bool SelectedExperience(int id)
        => Model.Activity.ExperienceTypeId == id;

    public bool IsAllFieldsValidated()
    {
        if (string.IsNullOrEmpty(Model.Activity.Title.Trim())) return false;
        if (string.IsNullOrEmpty(Model.Activity.Description)) return false;
        if (IsWordsLengthMin(Model.Activity.Description, 20)) return false;
        if (Model.Activity.ExperienceTypeId == 1)
        {
            if (string.IsNullOrEmpty(Model.Activity.Address1) ||
                string.IsNullOrEmpty(Model.Activity.Region) ||
                string.IsNullOrEmpty(Model.Activity.Barangay) ||
                string.IsNullOrEmpty(Model.Activity.City)) return false;
        }
        if (Model.Activity.ExperienceCategoryId <= 0) return false;
        //if(Model.Activity.SearchTags.Count == 0) return false;

        return true;
    }
}
@namespace Cinnamon.Web.Components.Pages.Maker.UpdateActivity
@using Cinnamon.Web.Models;

<h3 class="fw-bold mb-2">Experience creation</h3>
<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>
<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Let's name that experience!
            </label>
            <p>
                Make it informative and distinctive so that your customers
                may understand what you are offering
            </p>
        </div>
        <div class="textarea-container col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="d-flex flex-column">
                <textarea maxlength="80" @bind="Model.Activity.Title" class="@RequiredCheck(Model.Activity.Title)"></textarea>
                <label>80 Max</label>
            </div>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                What type of experience are you sharing?
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if(GetExperience("in-person") != null)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" data-id="" name="experience-type" id="in-person" 
                        checked='SelectedExperience(GetExperience("in-person").Id)'
                        @onchange='@(()=>CheckboxChanged(GetExperience("in-person").Id))'>
                    <label class="form-check-label" for="in-person">
                        In-person - join in the real world to participate actively
                    </label>
                </div>
            }
            @if(GetExperience("online") != null)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="experience-type" id="online"
                        checked='SelectedExperience(GetExperience("online").Id)'
                        @onchange='@(()=>CheckboxChanged(GetExperience("online").Id))'>
                    <label class="form-check-label" for="online">
                        Online - join via video conferencing software (provided by Cinnamon Maker)
                    </label>
                </div>
            }
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Where is your experience located?
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if(Model.Activity.ExperienceTypeId == 2)
            {
                <input class="form-control" placeholder="Address 1" disabled/>
                <input class="form-control my-3" placeholder="Address 2" disabled />
                <input class="form-control my-3" placeholder="District" disabled />
                <input class="form-control my-3" placeholder="City" disabled />
            }
            else{
                <input class="form-control @RequiredCheck(Model.Activity.Address1)" placeholder="Address 1" 
                    required @bind="Model.Activity.Address1"/>
                <input class="form-control my-3 @RequiredCheck(Model.Activity.Address2)" placeholder="Address 2" 
                    required @bind="Model.Activity.Address2"/>
                <input class="form-control my-3 @RequiredCheck(Model.Activity.District)" placeholder="District" 
                    required @bind="Model.Activity.District"/>
                <input class="form-control my-3 @RequiredCheck(Model.Activity.City)" placeholder="City" 
                    required @bind="Model.Activity.City"/>
            }
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
               Experience Category
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <select @bind="Model.Activity.ExperienceCategoryId" class="form-control @RequiredCheck(Model.Activity.ExperienceCategoryId)">
                <option disabled>Select Category</option>
                @foreach (var cat in Model.ExperienceCategories)
                {
                    <option value="@cat.Id">@cat.Category</option>
                }
           </select>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Sub-category
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if (Model.Activity.ExperienceCategoryId != 0)
            {
                <select @bind="Model.Activity.SubCategoryId" class="form-control @RequiredCheck(Model.Activity.SubCategoryId)">
                    <option disabled selected>Select Subcategory</option>
                    @foreach (var cat in Model.SubCategories.Where(s => s.CategoryId == Model.Activity.ExperienceCategoryId))
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            }
            else
            {
                <select class="form-control @RequiredCheck(Model.Activity.SubCategoryId)" disabled>
                    <option disabled selected>Select Sub-category</option>
                </select>
            }
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                Sub-category missing? Suggest up to five!
            </label>
        </div>
        <div class="tagsinputcontainer col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center d-flex flex-column">
            <div class="bootstrap-tagsinput @RequiredCheck(Model.Activity.SearchTags) d-flex flex-row flex-wrap ">
                @foreach (var tag in Model.Activity.SearchTags)
                {
                    <span class="tag label label-info m-1">
                        @tag
                        <span data-role="remove" @onclick="(()=>RemoveSearchTag(tag))">
                        </span>
                    </span>
                }
                <input type="text" placeholder="" size="@SearchTagLength" @bind-value="searchTag" @bind-value:event="oninput" @onkeydown="Enter">
            </div>
           <label>Suggest sub-category for approval (up to 5 suggestions)</label>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ExperienceUpdateModel Model {get; set;}
    
    private string searchTag;

    public int SearchTagLength { get; set; } = 0;
    
    private void CheckboxChanged(int val)
    {
        Model.Activity.ExperienceTypeId = val;
    }

    public void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Comma")
        {
            if (Model.Activity.SearchTags.Count < 5 && (Model.Activity.SearchTags.Where(x=> x == searchTag).FirstOrDefault()) == null)
            {
                Model.Activity.SearchTags.Add(searchTag);
            }
            searchTag = string.Empty;
        }
    }

    private string RequiredCheck(IList<string> searchTags)
    {
        if (searchTags.Count <= 0) return "invalid";
        return "";
    }

    private void RemoveSearchTag(string tag)
    {
        Model.Activity.SearchTags.Remove(tag);
    }

    private string RequiredCheck(string? value) {
        if (String.IsNullOrEmpty(value)) return "invalid";
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (value == null || value == 0) return "invalid";
        return "";
    }

    private string ShowErrorMessage() {
        return Model.ExperienceHasError ? "block" : "none";
    }

    private Models.Entities.ExperienceType? GetExperience(string name)
        => Model.ExperienceTypes.FirstOrDefault(i => i.Name.ToLower() == name);
    
    private bool SelectedExperience(int id)
        => Model.Activity.ExperienceTypeId == id;
    
    public bool IsAllFieldsValidated()
    {
        if(string.IsNullOrEmpty(Model.Activity.Title.Trim())) return false;
        if(Model.Activity.ExperienceTypeId == 1)
        {
            if(string.IsNullOrEmpty(Model.Activity.Address1.Trim()) ||
                string.IsNullOrEmpty(Model.Activity.Address2.Trim()) ||
                string.IsNullOrEmpty(Model.Activity.District.Trim()) ||
                string.IsNullOrEmpty(Model.Activity.City.Trim())) return false;
        }
        if(Model.Activity.ExperienceCategoryId <= 0) return false;
        if(Model.Activity.SearchTags.Count == 0) return false;

        return true;
    }
}
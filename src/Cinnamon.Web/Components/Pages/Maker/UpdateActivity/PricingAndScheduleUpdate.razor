@code {
    [Parameter]
    public Models.ExperienceUpdateModel Model { get; set; }

    ExperienceCreationGuideModal experienceCreationGuideModal = new ExperienceCreationGuideModal();

    List<ActivitySchedule> existingSchedules = new List<ActivitySchedule>();

    List<ActivitySchedule> newSchedules = new List<ActivitySchedule>();

    DateTime? selectedDate = null;

    IJSObjectReference module;

    protected override async Task OnInitializedAsync()
    {
        foreach (var item in Model.Activity.ActivitySchedules)
        {
            item.Price = Math.Truncate(item.Price);
        }

        if (Model.Activity.Status == Framework.Enums.Enums.ActivityStatus.InProgress)
        {
            if (Model.Activity.ActivitySchedules.Count > 1)
            {
            }
            else
            {
                foreach (var item in Model.Activity.ActivitySchedules)
                {
                    item.IsNew = true;
                }
            }
        }
        else
        {
        }

        SetSchedules();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Creation.js");
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Price");
        }
    }

    private string ShowErrorMessage()
    {
        return Model.ExperienceHasError ? "block" : "none";
    }

    private string RequiredCheck(String? value)
    {
        if (Model.ExperienceHasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(DateTime? value)
    {
        if (Model.ExperienceHasError && !value.HasValue)
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (Model.ExperienceHasError && (value == null || value.Value == 0))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (Model.ExperienceHasError && (value == null || value == 0))
        {
            return "invalid";
        }

        return "";
    }

    public bool IsAllFieldsValidated()
    {
        if (!IsAllSchedulesValid()) return false;
        return true;
    }

    private bool IsAllSchedulesValid()
    {
        bool isSingle = Model.Activity.ActivitySchedules.Count == 1;

        foreach (var schedule in Model.Activity.ActivitySchedules)
        {
            if ((string.IsNullOrEmpty(schedule.Name) ||
                string.IsNullOrEmpty(schedule.DateTime) ||
                schedule.Price <= 0 ||
                string.IsNullOrEmpty(schedule.UnitPrice) ||
                schedule.PerUnit1 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit1) ||
                schedule.PerUnit2 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit2)) && (schedule.IsActiveSchedule || isSingle)) return false;
            if (schedule.IsSetSession == true)
            {
                if(schedule.HasExpiration == 0)
                    return false;
            }
            if (schedule.IsSetSession == true && schedule.HasExpiration == 1)
            {
                if ((string.IsNullOrEmpty(schedule.SessionName)
                || !schedule.StartDate.HasValue))

                    return false;
            }
            if (schedule.IsSetSession == true && schedule.HasExpiration == 2)
            {
                if (string.IsNullOrEmpty(schedule.SessionName))
                    return false;
            }
        }
        return true;
    }
    private void CheckboxChanged(int val, ActivitySchedule schedule)
    {
        schedule.HasExpiration = val;
    }

    private void AddSchedule()
    {
        module.InvokeVoidAsync("scrollToPricingandSchedule");

        foreach (var item in Model.Activity.ActivitySchedules)
        {
            item.IsNew = false;
        }

        int maxId = Model.Activity.ActivitySchedules.Count == 0 ? 1 : Model.Activity.ActivitySchedules.Max(s => s.TempId) + 1;
        int order = Model.Activity.ActivitySchedules.Count == 0 ? 1 : Model.Activity.ActivitySchedules.Max(s => s.Order) + 1;
        Model.Activity.ActivitySchedules.Add(new Models.Entities.ActivitySchedule { TempId = maxId, PerUnit1 = 1, PerUnit2 = 1, Order = order, IsNew = true, IsActiveSchedule = false });

        SetSchedules();
    }

    private void SetSchedules()
    {
        if (Model.Activity.ActivitySchedules.Count(a => a.IsNew) > 0)
        {
            existingSchedules = Model.Activity.ActivitySchedules.Where(a => !a.IsNew).ToList();
            newSchedules = Model.Activity.ActivitySchedules.Where(a => a.IsNew).ToList();
        }
        else
        {
            existingSchedules = Model.Activity.ActivitySchedules.Where(a => !a.IsNew).Skip(0).Take(Model.Activity.ActivitySchedules.Count(a => !a.IsNew) - 1).ToList();
            newSchedules = Model.Activity.ActivitySchedules.Where(a => !a.IsNew).Skip(Model.Activity.ActivitySchedules.Count(a => !a.IsNew) - 1).Take(1).ToList();
        }
    }
}

@namespace Cinnamon.Web.Components.Pages.Maker.UpdateActivity
@using Models
@using Models.Entities

<div class="row"> <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.Name)" id="name-input" placeholder="Detailed Activity Breakdown" required @bind="scheduleModel.Name" />
       <i class="fa fa-trash" id="delete-icon" @onclick=DeleteSchedule></i>
   
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <p>
            Detailed activity breakdown if needed (age group, different sub-activity, etc)
        </p>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.DateTime)" placeholder="Frequency of Experience" required @bind="scheduleModel.DateTime" />
        <p>
            Example: Monday, Tuesday and Friday - 9am-5pm
        </p>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center px-0">
        <input class="form-control unit-input @RequiredCheck(scheduleModel.Price)" id="price-input" placeholder="Price" required @bind="scheduleModel.Price" />
        <select class="form-select unit-input @RequiredCheck(scheduleModel.UnitPrice)" id="price-input" placeholder="Unit Price" required @bind="scheduleModel.UnitPrice">
            <option value="PHP">PHP</option>
            <option value="USD">USD</option>
        </select>
        <div class="per-text">per</div>
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit1)" id="unit1-input" required @bind="scheduleModel.PerUnit1" />
        <select class="form-select unit-input @RequiredCheck(scheduleModel.PriceUnit1)" id="unit1-input" placeholder="Unit 1" required @bind="scheduleModel.PriceUnit1">
            <option value="Head">Head</option>
            <option value="Group">Group</option>
        </select>
        <div class="per-text">per</div>
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit2)" id="unit2-input" required @bind="scheduleModel.PerUnit2" />
        <select class="form-select unit-input @RequiredCheck(scheduleModel.PriceUnit2)" id="unit2-input" placeholder="Unit 2" required @bind="scheduleModel.PriceUnit2">
            <option value="Session">Session</option>
            <option value="Hour">Hour</option>
        </select>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center mt-2 toggle-expiration">
        <label class="label-switch">Session Expiration</label>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="scheduleModel.isSetSession">
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center mt-1 dropdown-expiration">
        <label class="set-exp">Set Expiration</label>
        @if (scheduleModel.isSetSession == false)
        {
            <select class="form-control session-period" @bind="scheduleModel.SessionName" disabled="true">
                <option disabled selected>Select Period</option>
                @foreach (var sessionPeriod in Model.SessionPeriods)
                {
                    <option value="@sessionPeriod">@sessionPeriod</option>
                }
            </select>
        }
        else
        {
            <select class="form-control session-period" @bind="scheduleModel.SessionName">
                <option disabled selected>Select Period</option>
                @foreach (var sessionPeriod in Model.SessionPeriods)
                {
                    <option value="@sessionPeriod">@sessionPeriod</option>
                }
            </select>
        }

    </div>
</div>
@code {
    [Parameter]
    public Models.Entities.ActivitySchedule scheduleModel { get; set; }
    [Parameter]
    public ExperienceUpdateModel Model { get; set; }
    [Parameter]
    public EventCallback<ExperienceUpdateModel> ModelChanged { get; set; }
    [Parameter]
    public EventCallback<Models.Entities.ActivitySchedule> OnScheduleRemoved {get; set;}

    private Models.Entities.ActivitySchedule? DraggedItem;
    private int DraggedItemPosition;
    private Models.Entities.ActivitySchedule? DragEnter;

    private void DeleteSchedule() 
    {
        OnScheduleRemoved.InvokeAsync(scheduleModel);
    }

    private string RequiredCheck(string value)
    {
        if(string.IsNullOrEmpty(value)) return "invalid";
        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (value == null || value == 0) return "invalid";
        return "";
    }
}

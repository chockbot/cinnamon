    private class ImageSelector
    {
        public string Selector { get; set; }
        public int Order { get; set; }
    }

    public async Task LoadCoverPhotoFile(InputFileChangeEventArgs e)
    {
        if (imageCropper is not null)
        {
            //delete old images
            var oldCoverImage = ModelState.imageItems.Where(i => i.Order == 0);
            foreach (var item in oldCoverImage)
            {
                deletedIds.Add(item.Id);
            }
            var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions
                {
                    FileInputIndex = 0,
                    FileSrcSelector = $"#{coverPhoto.FileId}",
                    Title = "Crop selected image",
                    OuputSelector = $"#{coverPhoto.InputDataId}",
                    HeightRatio = 5,
                    WidthRatio = 4
                });
            if (cropperResult.Cropped)
            {
                await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{coverPhoto.ImageSrcId}", $"#{coverPhoto.InputDataId}");
                coverPhoto.FileSize = cropperResult.FileSize;
                coverPhoto.Display = true;
            }
            else
            {
                coverPhoto.Display = false;
            }

            if(OnCoverPhotoDisplayChanged.HasDelegate)
            {
                await OnCoverPhotoDisplayChanged.InvokeAsync();
            }
        }
    }

    private async Task LoadSetplanPhotoFile(InputFileChangeEventArgs e)
    {
        //delete old images
        var oldSeatPlanImage = ModelState.imageItems.Where(i => i.Order == 100);
        foreach (var item in oldSeatPlanImage)
            {
                deletedIds.Add(item.Id);
            }
        var options = new
        {
            imgSelector = $"#{setplanPhoto.ImageSrcId}",
            inputSelector = $"#{setplanPhoto.FileId}",
            fileIndex = 0,
            inputSelectorToWriteBlob = $"#{setplanPhoto.InputDataId}"
        };
        await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImageByFileInput", options);
        setplanPhoto.Display = true;
    }

    public async Task<bool> UploadImages(int createdActivityId)
    {
        try
        {
            var selectors = new List<ImageSelector>();
             if (coverPhoto.Display)
            {
                selectors.Add(new ImageSelector
                    {
                        Selector = $"#{coverPhoto.InputDataId}",
                        Order = coverPhoto.Order
                    });
            }
            if (setplanPhoto.Display)
            {
                selectors.Add(new ImageSelector
                    {
                        Order = setplanPhoto.Order,
                        Selector = $"#{setplanPhoto.InputDataId}"
                    });
            }

            var result = await JS.InvokeAsync<UploadResult>("MyLib.Pages.activity.creation.uploadListImages",
                    selectors, createdActivityId, deletedIds);

            return result.Success ?? false;
        }
        catch (System.Exception ex)
        {
            throw ex;
        }
    }

    public async Task DeleteCoverPhoto()
    {
        coverPhoto.Display = false;
        deletedIds.Add(coverPhoto.Id);
        if(OnCoverPhotoDisplayChanged.HasDelegate)
        {
            await OnCoverPhotoDisplayChanged.InvokeAsync();
        }
    }

    private Task DeleteSetplanPhoto()
    {
        setplanPhoto.Display = false;
        deletedIds.Add(setplanPhoto.Id);
        return Task.CompletedTask;
    }

    private void CheckboxChanged(int val)
    {
        if (val == 3)
        {
            ModelState.Publish    = false;
            ModelState.ComingSoon = false;
            ModelState.IsPrivate  = true;
        }
        else if (val == 2)
        {
            ModelState.Publish    = true;
            ModelState.ComingSoon = false;
            ModelState.IsPublic   = true;
        }
        else
        {
            ModelState.Publish      = true;
            ModelState.ComingSoon   = true;
            ModelState.IsComingSoon = true;
        }
    }

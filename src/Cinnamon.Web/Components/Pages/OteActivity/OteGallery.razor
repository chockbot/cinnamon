@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Components;
@inject IJSRuntime JS;
@inject INotificationService NotificationService;
@implements IOteComponent;

<section class="ote-gallery-wrapper">
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <div id="error-message-container" class="mb-4 invalid is-invalid">
                <ul id="error-list" class="fw-bold mb-0">
                    @((MarkupString)errorMessage)
                </ul>
            </div>
        }

        <h3 class="font-24 font-weight-700 color-black-100 mb-4 text-capitalize">post pictures</h3>
        <p class="font-16 color-grey-100">Pictures must have:</p>
        <ul class="font-16 color-grey-100">
            <li>
                Different angles and details, including photos of people at work.
            </li>
            <li>
                Innocent, yet illuminating, snippets from the experience.
            </li>
            <li>
                Top-notch picture quality, free from excessive effects like distortion, superimposition of text, and watermarks.
            </li>
        </ul>
        <div class="main-images-container-wrapper mb-5">
            <Row>
                <Column ColumnSize="ColumnSize.Is12" Flex="Flex.JustifyContent.End">
                    <div class="how-to-guide" style="display:flex" @onclick="() => howToModal.ShowModal()">
                        <label class="how-to-text">How to do this</label>
                        <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <div class="mt-4">
                        <label class="d-flex align-items-center mb-2">
                            <span class="rounded-circle bg-orange-100 color-white-100 round-padding me-2">6</span>
                            <p class="font-16 color-grey-100 mb-0 text-capitalize">cover photo</p>
                        </label>
                        <label for="@coverPhoto.FileId" class="cursor-pointer w-100">
                            <InputFile id="@coverPhoto.FileId" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="LoadCoverPhotoFile" />
                            <div class='@(coverPhoto.Display ? "d-none" : "")'>
                                <div class='empty-image-container bg-white-100'>
                                    <div class="text-center">
                                        <img src="images/ote/gallery-icon.png" alt="gallery-icon">
                                        <p class="mb-0 mt-1 font-16 color-grey-100 prevent-select">JPEG or PNG only</p>
                                    </div>
                                </div>
                            </div>
                            <Row class="cover-photo-image-container justify-content-center" HorizontalGutter="30">
                                <div class='@(coverPhoto.Display ? "col-12 mb-4 text-center" : "d-none")' id="@coverPhoto.ContainerId">
                                    <input type="hidden" id="@coverPhoto.InputDataId" name= "@coverPhoto.InputDataId" class="generated-input-data" />
                                    <img id="@coverPhoto.ImageSrcId" class="w-100 border-1-dashed border-color-black-100" src="@coverPhoto.ImageSrc" alt="supporting-photo">
                                    <img class="mt-2 cursor-pointer" @onclick="DeleteCoverPhoto" src="images/ote/trashcan-icon.png" alt="delete">
                                </div>
                            </Row>
                        </label>
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <div class="mt-4">
                        <label class="d-flex align-items-center mb-2">
                            <span class="rounded-circle bg-orange-100 color-white-100 round-padding me-2">8</span>
                            <p class="font-16 color-grey-100 mb-0 text-capitalize">seat plan (optional)</p>
                        </label>
                        <label class="cursor-pointer w-100">
                            <InputFile id="@setplanPhoto.FileId" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="LoadSetplanPhotoFile" />
                            <div for="@setplanPhoto.FileId" class='@(setplanPhoto.Display ? "d-none" : "")'>
                                <div class='empty-image-container bg-white-100'>
                                    <div class="text-center">
                                        <img src="images/ote/gallery-icon.png" alt="gallery-icon">
                                        <p class="mb-0 mt-1 font-16 color-grey-100 prevent-select">JPEG or PNG only</p>
                                    </div>
                                </div>
                            </div>
                            <Row class="cover-photo-image-container justify-content-center" HorizontalGutter="30">
                                <div class='@(setplanPhoto.Display ? "col-12 mb-4 text-center" : "d-none")' id="@setplanPhoto.ContainerId">
                                    <input type="hidden" id="@setplanPhoto.InputDataId" name= "@setplanPhoto.InputDataId" class="generated-input-data" />
                                    <img id="@setplanPhoto.ImageSrcId" class="w-100 border-1-dashed border-color-black-100" src="@setplanPhoto.ImageSrc" alt="supporting-photo">
                                    <img class="mt-2 cursor-pointer" @onclick="DeleteSetplanPhoto" src="images/ote/trashcan-icon.png" alt="delete">
                                </div>
                            </Row>
                        </label>
                    </div>
                </Column>
            </Row>
        </div>
        <div class="supporting-images-container-wrapper text-center">
            <div class="text-start font-16 mb-2 d-flex" style="justify-content: space-between;">
                <label class="d-flex align-items-center mb-5">
                    <span class="rounded-circle bg-orange-100 color-white-100 round-padding me-2">6</span>
                    <p class="font-16 color-grey-100 mb-0">Supporting Photos (Min of 4 and Max of 6 photos)</p>
                </label>
                <div class="how-to-guide mb-5" style="display:flex" @onclick="() => howToModalSupporting.ShowModal()">
                    <label class="how-to-text">How to do this</label>
                    <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
                </div>
            </div>
            <label for="photo-upload" class="cursor-pointer supporting-photos-container">
                <Button Type="ButtonType.Button" style="pointer-events: none;" Border="Border.Is0" class="btn-primary">
                    Choose Photos
                </Button>
                <InputFile multiple id="photo-upload" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="LoadFiles" />
                @if(imageItems.Count == 0)
                {
                    <div class="empty-image-container empty-supporting-container bg-white-100 mt-4">
                        <div class="text-center">
                            <img src="images/ote/gallery-icon.png" alt="gallery-icon">
                            <p class="mb-0 mt-1 font-16 color-grey-100">JPEG or PNG only</p>
                        </div>
                    </div>
                }
            </label>
            <Row class="supporting-images-container mt-4" HorizontalGutter="30" VerticalGutter="30">
                @foreach(var item in imageItems)
                {
                    <div @key="item" class='@(item.Display ? "col-12 col-md-6 mb-4" : "d-none")' id="@item.ContainerId">
                        <label for="@item.InputFileSrcId" class="cursor-pointer">
                            <InputFile id="@item.InputFileSrcId" accept=".png,.jpg,.jpeg" name="@item.InputFileSrcId" class="d-none" OnChange="(e) => LoadPerPhoto(e, item)" />
                            <input type="hidden" id="@item.InputDataId" name= "@item.InputDataId" class="generated-input-data" />
                            <img id="@item.ImageSrcId" class="w-100 border-1-dashed border-color-black-100" src="@item.ImageSrc" alt="supporting-photo">
                        </label>
                        <img class="mt-2 cursor-pointer" @onclick="() => DeleteImage(item)" src="images/ote/trashcan-icon.png" alt="delete">
                    </div>
                }
            </Row>
        </div>
    </div>
    <HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Cover Photo Guidelines" />
    <HowToModal @ref="howToModalSupporting" HtmlContent="@htmlSupporting" Title="Supporting Photo Guidelines" />
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
    <ImageCropper @ref="imageCropper" />
    <LoadingIndicator FullScreen @ref="loadingIndicator"  />
</section>

@code 
{
    [Parameter]
    public EventCallback OnNextClick {get; set;}

    [Parameter]
    public EventCallback OnPrevClick {get; set;}

    private ImageCropper? imageCropper;
    private ImageItem coverPhoto = new ImageItem {
        ContainerId = "cover-photo-container",
        Display = false,
        FileSize = 0,
        ImageSrcId = "cover-photo-image-src",
        InputDataId = "cover-photo-input-data",
        FileId = "cover-photo-input-file",
        Order = 0
    };
    private ImageItem setplanPhoto = new ImageItem {
        ContainerId = "setplan-photo-container",
        Display = false,
        FileSize = 0,
        ImageSrcId = "setplan-photo-image-src",
        InputDataId = "setplan-photo-input-data",
        FileId = "setplan-photo-input-file",
        Order = 100
    };
    private IList<ImageItem> imageItems = new List<ImageItem>();
    private string errorMessage = string.Empty;
    private IList<int> deletedIds = new List<int>();
    private LoadingIndicator? loadingIndicator;
    private HowToModal howToModal { get; set; }
    private HowToModal howToModalSupporting { get; set; }
    public string htmlString = Resources.App.CoverPhotoString;
    public string htmlSupporting = Resources.App.SupportingPhotoString;

    private async Task LoadCoverPhotoFile(InputFileChangeEventArgs e)
    {
        if(imageCropper is not null)
        {
            var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                FileInputIndex = 0,
                FileSrcSelector = $"#{coverPhoto.FileId}",
                Title = "Crop selected image",
                OuputSelector = $"#{coverPhoto.InputDataId}",
                HeightRatio = 5,
                WidthRatio = 4
            });
            if(cropperResult.Cropped)
            {
                await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{coverPhoto.ImageSrcId}", $"#{coverPhoto.InputDataId}");
                coverPhoto.FileSize = cropperResult.FileSize;
                coverPhoto.Display = true;
            }
            else 
            {
                coverPhoto.Display = false;
            }
        }
    }

    private async Task LoadSetplanPhotoFile(InputFileChangeEventArgs e)
    {
        var options = new {
            imgSelector = $"#{setplanPhoto.ImageSrcId}",
            inputSelector = $"#{setplanPhoto.FileId}",
            fileIndex = 0,
            inputSelectorToWriteBlob = $"#{setplanPhoto.InputDataId}"
        };
        await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImageByFileInput", options);
        setplanPhoto.Display = true;
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();
        var lastIndex = imageItems.Count > 0 ? imageItems.OrderByDescending(i => i.Order).First().Order + 1 : 1;
        
        for(int i = 0; i < files.Count; i++)
        {
            await loadingIndicator?.Show();

            string inputId = $"img-preview-input-{lastIndex}";
            string imgId = $"img-preview-src-{lastIndex}";
            string inputFileSrc = $"input-file-src-{lastIndex}";

            var imageItem = new ImageItem {
                ContainerId = $"{imgId}-{inputId}", 
                FileSize = 0, 
                ImageSrcId = imgId, 
                InputDataId = inputId, 
                Order = lastIndex,
                InputFileSrcId = inputFileSrc
            };
            imageItems.Add(imageItem);
            StateHasChanged();
            lastIndex++;

            if(imageCropper is not null)
            {
                await Task.Delay(500);
                await loadingIndicator?.Hide();

                var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                    FileInputIndex = i,
                    FileSrcSelector = "#photo-upload",
                    Title = "Crop selected image",
                    OuputSelector = $"#{imageItem.InputDataId}",
                    HeightRatio = 4,
                    WidthRatio = 5
                });
                if(cropperResult.Cropped)
                {
                    await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{imgId}", $"#{inputId}");
                    imageItem.FileSize = cropperResult.FileSize;
                    imageItem.Display = true;
                }
                else 
                {
                    imageItems.Remove(imageItem);
                    lastIndex--;
                }
            }
            StateHasChanged();
        }
    }

    private async Task LoadPerPhoto(InputFileChangeEventArgs e, ImageItem imageItem)
    {
        if(imageCropper is not null)
        {
            var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                FileInputIndex = 0,
                FileSrcSelector = $"#{imageItem.InputFileSrcId}",
                Title = "Crop selected image",
                OuputSelector = $"#{imageItem.InputDataId}",
                HeightRatio = 4,
                WidthRatio = 5
            });
            if(cropperResult.Cropped)
            {
                await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{imageItem.ImageSrcId}", $"#{imageItem.InputDataId}");
                imageItem.FileSize = cropperResult.FileSize;
                imageItem.Display = true;
            }
        }
    }

    public async Task<bool> FieldValid()
    {
        var supportedPhotosCount = imageItems.Count;
        var isHaveCoverPhoto = coverPhoto.Display;
        var totalFileSize = imageItems.Sum(i => i.FileSize) + coverPhoto.FileSize + setplanPhoto.FileSize;

        var message = string.Empty;
        var isAllFieldsValid = true;
        if(supportedPhotosCount < 4 )
        {
            isAllFieldsValid = false;
            message += "<li>Minimum of 4 supported photos</li>";
        }
        if(supportedPhotosCount > 6)
        {
            isAllFieldsValid = false;
            message += "<li>Maximum of 6 supported photos</li>";
        }
        if(!isHaveCoverPhoto)
        {
            isAllFieldsValid = false;
            message += "<li>Required cover photo</li>";
        }
        if(totalFileSize > 25)
        {
            isAllFieldsValid = false;
            message += "<li>Total file size must only 25MB</li>";
        }

        errorMessage = message;
        StateHasChanged();
        await Task.Delay(300); // add delay to populate is-invalid class
        if(!isAllFieldsValid)
        {
            await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-gallery-wrapper .is-invalid");
        }
        return isAllFieldsValid;
    }

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }

    private async Task PrevClick()
    {
        if(OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    public async Task<bool> UploadImages(int createdActivityId)
    {
        try
        {
            var selectors = new List<ImageSelector>();
            if(coverPhoto.Display)
            {
                selectors.Add(new ImageSelector {
                    Selector = $"#{coverPhoto.InputDataId}",
                    Order = coverPhoto.Order
                });
            }
            selectors.AddRange(imageItems.Select(i => {
                return new ImageSelector {
                    Selector = $"#{i.InputDataId}",
                    Order = i.Order
                };
            }));
            if(setplanPhoto.Display)
            {
                selectors.Add(new ImageSelector {
                    Order = setplanPhoto.Order,
                    Selector = $"#{setplanPhoto.InputDataId}"
                });
            }

            var result = await JS.InvokeAsync<UploadResult>("MyLib.Pages.activity.creation.uploadListImages", 
                    selectors, createdActivityId, deletedIds);
                    
            return result.Success ?? false;
        }
        catch (System.Exception ex)
        {
            throw ex;
        }
    }

    public Task SetState(IList<ImageItem> images)
    {
        var orderedImages = images.OrderBy(i => i.Order).ThenBy(i => i.Id);
        var coverImage = orderedImages.FirstOrDefault();
        var setplanImage = orderedImages.FirstOrDefault(i => i.Order == 100);

        if(setplanImage is not null)
        {
            setplanPhoto.Display = true;
            setplanPhoto.ImageSrc = setplanImage.ImageSrc;
            setplanPhoto.Id = setplanImage.Id;
            setplanPhoto.Order = setplanImage.Order;
        }
    
        if(coverImage is not null)
        {
            coverPhoto.Display = true;
            coverPhoto.ImageSrc = coverImage.ImageSrc;
            coverPhoto.Id = coverImage.Id;
            coverPhoto.Order = coverImage.Order;

            var supportedImages = images.Where(i => i.Id != coverImage.Id && i.Id != setplanPhoto.Id);
            foreach(var item in supportedImages)
            {
                string inputId = $"img-preview-input-{item.Order}";
                string imgId = $"img-preview-src-{item.Order}";
                string inputFileSrc = $"input-file-src-{item.Order}";

                imageItems.Add(new ImageItem {
                    ContainerId = $"{imgId}-{inputId}",
                    Display = true,
                    Id = item.Id,
                    ImageSrc = item.ImageSrc,
                    ImageSrcId = imgId,
                    InputDataId = inputId,
                    Order = item.Order,
                    InputFileSrcId = inputFileSrc
                });
            }
        }

        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task DeleteCoverPhoto()
    {
        coverPhoto.Display = false;
        deletedIds.Add(coverPhoto.Id);
        return Task.CompletedTask;
    }

    private Task DeleteSetplanPhoto()
    {
        setplanPhoto.Display = false;
        deletedIds.Add(setplanPhoto.Id);
        return Task.CompletedTask;
    }

    private Task DeleteImage(ImageItem imageItem)
    {
        imageItems.Remove(imageItem);
        deletedIds.Add(imageItem.Id);
        return Task.CompletedTask;
    }

    public class ImageItem 
    {
        public int Id {get; set;}
        public string ContainerId {get; set;} = string.Empty;
        public string ImageSrcId {get; set;} = string.Empty;
        public string InputDataId {get; set;} = string.Empty;
        public string FileId {get; set;} = string.Empty;
        public decimal FileSize {get; set;} = 0;
        public bool Display {get; set;} = false;
        public int Order {get; set;} = 0;
        public string ImageSrc {get; set;} = string.Empty;
        public string InputFileSrcId {get; set;}
    }

    private class UploadResult 
    {
        public string? Message {get; set;}
        public bool? Success {get; set;}
    }

    private class ImageSelector 
    {
        public string Selector {get; set;}
        public int Order {get; set;}
    }
}
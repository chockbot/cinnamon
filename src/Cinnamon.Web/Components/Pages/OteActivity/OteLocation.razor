@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject INotificationService NotificationService;
@inject IJSRuntime JS;
@implements IOteComponent;

<section class="ote-location-wrapper">
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        <div id="event-type" class="d-flex mb-5 m-margin-bottom-30">
            <RadioGroup TValue="int" Name="experience-type" CheckedValue="model.SelectedType" CheckedValueChanged="CheckExperienceTypeChanged">
                <p class="font-20 d-none m-d-block color-black-100 mb-1">Type of experience</p>
                <label for="type-online" class="bg-white-100 border-radius-10 prevent-select px-3 py-2 me-4 
                    text-capitalize cursor-pointer m-border-width-1 m-border-style-solid m-border-radius-5 m-border-color-grey-200 m-margin-right-5">
                    <Radio class="checkbox-round" ElementId="type-online"  TValue="int" Value="2">Online</Radio>
                </label>
                <label for="type-in-person" class="bg-white-100 border-radius-10 prevent-select px-3 py-2 
                    text-capitalize cursor-pointer m-border-width-1 m-border-style-solid m-border-radius-5 m-border-color-grey-200">
                    <Radio class="checkbox-round" ElementId="type-in-person" TValue="int" Value="1">In-Person</Radio>
                </label>
            </RadioGroup>
        </div>
        <div id="event-location">
            <div class="d-flex justify-content-between mb-5 align-items-baseline m-margin-bottom-30">
                <label class="d-flex align-items-center m-d-none">
                    <span class="rounded-circle bg-orange-100 color-white-100 round-padding me-2">3</span>
                    <p class="font-20 color-black-100 mb-0">Venue/Map Location</p>
                </label>
                <p class="mb-0 required-in-person font-16">
                    <span class="text-capitalize font-20 color-black-100 font-weight-700 d-none m-d-block">
                        Where is your experience located? 
                    </span>
                    <span>
                        *(required if in-person)
                    </span>
                </p>
            </div>
            <div>
                <Validations @ref="formValidation" Model="model" Mode="FormMode">
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                house no.
                            </FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="DisableLocation" id="event-name-words-input" Size="Size.Medium" 
                                    class="font-18 border-radius-10 m-font-16 m-border-radius-5" Role="TextRole.Text" @bind-Text="model.HouseNo">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Field class="mb-4" >
                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            region
                        </FieldLabel>
                        <FieldBody>
                            <Select Disabled="DisableLocation" TValue="string" Size="Size.Medium" class="@RegionClass" 
                                SelectedValue="model.Region.Code" SelectedValueChanged="SelectedRegionChanged">
                                <SelectItem Value='"none"' Disabled class="text-capitalize">--Select Region--</SelectItem>
                                @foreach (var item in regions)
                                {
                                    <SelectItem Value="item.Value.Code">@item.Value.Name</SelectItem>
                                }
                            </Select>
                            <div class="invalid-feedback">The region field is mandatory.</div>
                        </FieldBody>
                    </Field>
                    <Field class="mb-4" >
                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            Town/City
                        </FieldLabel>
                        <FieldBody>
                            <Select Disabled="DisableLocation" TValue="string" Size="Size.Medium" class="@CityClass"
                                    SelectedValue="model.City.Code" SelectedValueChanged="SelectedCityChanged">
                                <SelectItem Value='"none"' Disabled class="text-capitalize">--Select City--</SelectItem>
                                @foreach (var item in cities)
                                {
                                    <SelectItem Value="item.Value.Code">@item.Value.Name</SelectItem>
                                }
                            </Select>
                            <div class="invalid-feedback">The city field is mandatory.</div>
                        </FieldBody>
                    </Field>
                    <Field class="mb-4" >
                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            barangay
                        </FieldLabel>
                        <FieldBody>
                            <Select Disabled="DisableLocation" TValue="string" Size="Size.Medium" class="@BarangayClass"
                                    SelectedValue="model.Barangay.Code" SelectedValueChanged="SelectedBarangayChanged">
                                <SelectItem Value='"none"' Disabled class="text-capitalize">--Select Barangay--</SelectItem>
                                @foreach (var item in barangays)
                                {
                                    <SelectItem Value="item.Value.Code">@item.Value.Name</SelectItem>
                                }
                            </Select>
                            <div class="invalid-feedback">The barangay field is mandatory.</div>
                        </FieldBody>
                    </Field>
                    <Validation>
                        <Field class="mb-4">
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                postal code
                            </FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="DisableLocation" id="event-name-words-input" Size="Size.Medium" 
                                    class="font-18 border-radius-10 m-font-16 m-border-radius-5" Role="TextRole.Text" @bind-Text="model.PostaCode">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Validations>
            </div>
        </div>
    </div>
    <h3 class="font-24 font-weight-700 color-black-100 my-4 m-font-20">Where you’ll be</h3>
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        <div class="mb-4 d-none m-d-block">
            <TextEdit Disabled="DisableLocation" Placeholder="search your location" 
                        id="19d13aa1-90c0-4232-a7bc-62a772baa223" Size="Size.Medium" 
                        class="font-18 border-radius-10 m-font-16 m-border-radius-5" Role="TextRole.Text" @bind-Text="model.PinnedLocation" />
        </div>
        <div id="iframe-map" class="mb-4">
            @{
                var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q=" + (!string.IsNullOrEmpty(model.PinnedLocation) ? model.PinnedLocation : "''");
                <iframe id="mapframe" height="373" frameborder="0" style="border:0" src="@map" allowfullscreen class="iframe-search-modal w-100"></iframe>
            }
        </div>
        <div id="map-pinned-location">
            <Row VerticalGutter="10" HorizontalGutter="10">
                <Column ColumnSize="ColumnSize.Is12.Is12.OnTablet.Is6.OnDesktop" class="m-d-none">
                    <TextEdit Disabled="DisableLocation" Placeholder="search your location" 
                        id="19d13aa1-90c0-4232-a7bc-62a772baa223" Size="Size.Medium" 
                        class="font-18 border-radius-10 m-font-16 m-border-radius-5" Role="TextRole.Text" @bind-Text="model.PinnedLocation" />
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is12.OnTablet.Is6.OnDesktop">
                    <Button Disabled="DisableLocation" class="bg-orange-100 color-white-100 
                        text-capitalize w-100 font-20 hover-color-white px-5 border-radius-10 m-border-radius-5">
                        cofirm location
                    </Button>
                </Column>
            </Row>
        </div>
    </div>
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>

@code 
{
    [Parameter]
    public EventCallback OnNextClick {get; set;}

    [Parameter]
    public EventCallback OnPrevClick {get; set;}

    private FormModel model = new();
    private Validations? formValidation;
    private bool showErrors = false;
    private IDictionary<string, Barangay> barangays = new Dictionary<string, Barangay>();
    private IDictionary<string, Region> regions = new Dictionary<string, Region>();
    private IDictionary<string, City> cities = new Dictionary<string, City>();

    protected override async Task OnInitializedAsync()
    {
        await LoadRegions();
    }

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }

    private async Task PrevClick()
    {
        if(OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    private bool DisableLocation 
    {
        get 
        {
            return model.SelectedType == 2;
        }
    }

    private ValidationMode FormMode 
    {
        get 
        {
            return DisableLocation ? ValidationMode.Manual : (showErrors ? ValidationMode.Auto : ValidationMode.Manual);
        }
    }

    private async Task LoadRegions()
    {
        try
        {
            regions.Clear();
            var regionRes = await activityApiHandler.GetAllRegions();
            if(!regionRes.Succeeded || regionRes.Result is null || !regionRes.Result.IsSuccess)
            {
                await NotificationService.Error("An error occured. Please try again later.", "Error");
                return;
            }

            var rg = regionRes.Result.Result.OrderBy(r => r.Name);

            foreach(var item in rg)
            {
                if(!regions.ContainsKey(item.Code))
                {
                    regions.Add(
                        item.Code,
                        new Region {
                            Code = item.Code,
                            Name = item.Name
                        }
                    );
                }
            }
        }
        catch (System.Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task SelectedRegionChanged(string code)
    {
        if(regions.ContainsKey(code))
        {
            var region = regions[code];
            if(region is not null)
            {
                model.Region.Code = region.Code;
                model.Region.Name = region.Name;
                await LoadCities();
            }
        }
    }

    private async Task LoadCities()
    {
        try
        {
            cities.Clear();
            var cityRes = await activityApiHandler.GetAllCitiesByRegionCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllCitiesArgs {
                CountPerPage = 1000,
                RegionCode = model.Region.Code
            });
            if(cityRes.Succeeded && cityRes.Result is not null && cityRes.Result.IsSuccess)
            {
                var ct = cityRes.Result.Result.OrderBy(c => c.Name);
                foreach(var item in ct)
                {
                    if(!cities.ContainsKey(item.Code))
                    {
                        cities.Add(
                            item.Code,
                            new City {
                                Code = item.Code,
                                Name = item.Name,
                                IsCity = item.IsCity,
                                IsMunicipality = item.IsMunicipality
                            }
                        );
                    }
                }
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task SelectedCityChanged(string code)
    {
        if(cities.ContainsKey(code))
        {
            var city = cities[code];
            if(city is not null)
            {
                model.City.Code = city.Code;
                model.City.Name = city.Name;
                model.City.IsCity = city.IsCity;
                model.City.IsMunicipality = city.IsMunicipality;
                await LoadBarangays();
            }
        }
    }

    private async Task LoadBarangays()
    {
        try
        {
            barangays.Clear();
            var barangayRes = await activityApiHandler.GetAllBarangaysByCityCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllBarangaysArgs {
                CityCode = model.City.Code,
                CountPerPage = 1000,
                IsCity = model.City.IsCity,
                IsMunicipality = model.City.IsMunicipality
            });
            if(barangayRes.Succeeded && barangayRes.Result is not null && barangayRes.Result.IsSuccess)
            {
                var br = barangayRes.Result.Result.OrderBy(b => b .Name);
                foreach(var item in br)
                {
                    if(!barangays.ContainsKey(item.Code))
                    {
                        barangays.Add(
                            item.Code,
                            new Barangay {
                                Code = item.Code,
                                Name = item.Name
                            }
                        );
                    }
                }
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    public async Task<bool> FieldValid()
    {
        // for online type no need to validate 
        if(model.SelectedType == 2)
        {
            return true;
        }
        if (!string.IsNullOrEmpty(model.PinnedLocation))
        {
            return true;
        }
        else
        {
            if (formValidation is not null)
            {
                bool valid = await formValidation.ValidateAll() && !string.IsNullOrEmpty(model.Region.Code)
                    && !string.IsNullOrEmpty(model.City.Code) && !string.IsNullOrEmpty(model.Barangay.Code);
                showErrors = true;
                StateHasChanged();
                await Task.Delay(300); // add delay to populate is-invalid class
                if (!valid)
                {
                    await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-location-wrapper .is-invalid");
                }
                return valid;
            }
            return false;
        }

    }

    private Task SelectedBarangayChanged(string code)
    {
        if(barangays.ContainsKey(code))
        {
            var barangay = barangays[code];
            if(barangay is not null)
            {
                model.Barangay.Code = barangay.Code;
                model.Barangay.Name = barangay.Name;
            }
        }
        return Task.CompletedTask;
    }

    private string RegionClass {
        get {
            string defaultStyle = "form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5";
            if(showErrors)
            {
                if(string.IsNullOrEmpty(model.Region.Code))
                {
                    return $"{defaultStyle} is-invalid";
                }
                return $"{defaultStyle} is-valid";
            }
            return defaultStyle;
        }
    }

    private string CityClass {
        get {
            string defaultStyle = "form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5";
            if(showErrors)
            {
                if(string.IsNullOrEmpty(model.City.Code))
                {
                    return $"{defaultStyle} is-invalid";
                }
                return $"{defaultStyle} is-valid";
            }
            return defaultStyle;
        }
    }

    private string BarangayClass {
        get {
            string defaultStyle = "form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5";
            if(showErrors)
            {
                if(string.IsNullOrEmpty(model.Barangay.Code))
                {
                    return $"{defaultStyle} is-invalid";
                }
                return $"{defaultStyle} is-valid";
            }
            return defaultStyle;
        }
    }

    private async Task CheckExperienceTypeChanged(int type)
    {
        model.SelectedType = type;
        showErrors = false;
        ClearLocationFields();
        await formValidation.ClearAll();
    }

    public ModelData GetData()
    {
        ModelData data = new ModelData {
            BarangayCode = model.Barangay.Code,
            BarangayName = model.Barangay.Name,
            CityCode = model.City.Code,
            CityName = model.City.Name,
            ExperienceType = model.SelectedType,
            HouseNo = model.HouseNo,
            PinnedLocation = model.PinnedLocation,
            PostalCode = model.PostaCode,
            RegionCode = model.Region.Code,
            RegionName = model.Region.Name
        };
        return data;
    }

    public async Task SetState(ModelData data)
    {
        model.HouseNo = data.HouseNo;
        model.PinnedLocation = data.PinnedLocation;
        model.PostaCode = data.PostalCode;
        model.SelectedType = data.ExperienceType;

        await LoadRegions();
        //model.Region.Code = data.RegionCode;
        //model.Region.Name = data.RegionName;
        await SelectedRegionChanged(data.RegionCode);

        //model.City.Code = data.CityCode;
        //model.City.Name = data.CityName;
        await SelectedCityChanged(data.CityCode);

        //model.Barangay.Code = data.BarangayCode;
        //model.Barangay.Name = data.BarangayName;
        await SelectedBarangayChanged(data.BarangayCode);
        
        //await SelectedBarangayChanged(model.Barangay.Code);
        
        StateHasChanged();
    }

    private void ClearLocationFields()
    {
        model.HouseNo        = string.Empty;
        model.Region.Code    = "none";
        model.Region.Name    = string.Empty;
        model.City.Code      = "none";
        model.City.Name      = string.Empty;
        model.Barangay.Code  = "none";
        model.Barangay.Name  = string.Empty;
        model.PostaCode      = string.Empty;
        model.PinnedLocation = string.Empty;
    }

    public class ModelData
    {
        public int ExperienceType {get; set;}
        public string HouseNo {get; set;}
        public string PostalCode {get; set;}
        public string PinnedLocation {get; set;}
        public string RegionName {get; set;}
        public string RegionCode {get; set;}
        public string CityName {get; set;}
        public string CityCode {get; set;}
        public string BarangayName {get; set;}
        public string BarangayCode {get; set;}
    }

    private class FormModel 
    {
        [Required]
        public int SelectedType {get; set;} = 1;

        [Required(ErrorMessage = "The house # field is mandatory.")]
        public string HouseNo {get; set;}

        [Required(ErrorMessage = "The postal code field is mandatory.")]
        public string PostaCode {get; set;}

        public string PinnedLocation {get; set;}

        [Required]
        public Region Region {get; set;} = new();

        [Required]
        public City City {get; set;} = new();

        [Required]
        public Barangay Barangay {get; set;} = new();
    }

    private class Region 
    {
        public string Name {get; set;}

        [Required(ErrorMessage = "The region field is mandatory.")]
        public string Code {get; set;}
    }

    private class City 
    {
        public string Name {get; set;}

        [Required(ErrorMessage = "The city field is mandatory.")]
        public string Code {get; set;}

        public bool IsCity {get; set;}
        public bool IsMunicipality {get; set;}
    }

    private class Barangay 
    {
        public string Name {get; set;}

        [Required(ErrorMessage = "The barangay field is mandatory.")]
        public string Code {get; set;}
    }
}
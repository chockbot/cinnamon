@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject INotificationService NotificationService;
@inject IJSRuntime JS;
@implements IOteComponent;

<section class="ote-online-wrapper">
    <div class="d-flex justify-content-between">
        <p class="header-title">
            Online Event Page
        </p>
        <label @onclick="() => howToModal.ShowModal()" class="cursor-pointer">
            <span class="font-14 font-weight-700 color-green-100 text-decoration-underline">How to do this</span>
            <img src="images/ote/green-how-do-this.png" alt="icon">
        </label>
    </div>
    <p class="font-20 color-grey-100 text-justify m-font-16">
        Attendees will join your online event through your virtual venue. Utilize this space to
        integrate your online meeting or event hosting platform and provide exclusive content.
        We'll direct your ticket holders to this page from your event listing and in reminder
        emails.
    </p>
    <div class="my-3 border-radius-10">
        <Validations @ref="ticketListFormValidation" Model="modelTicketList" Mode="ValidationMode.Auto">
            <div class="accordion" id="pricings-accordion">
                @foreach (var item in modelTicketList.TicketInformations)
                {
                    <div class="accordion-item" @key="item">
                        <h2 class="accordion-header">
                            <button style='@(!item.Valid ? "border: 1px solid #dc3545 !important;" : "")'
                                    class='@(item.Valid ? "accordion-button bg-white-200 font-20 m-font-16" : "accordion-button bg-white-200 font-20 m-font-16 is-invalid")'
                                    type="button" data-bs-toggle="collapse" data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                @item.Title
                            </button>
                        </h2>
                        <div id='@($"collapse-{item.Id}")' class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#pricings-accordion">
                            <div class="accordion-body bg-white-200">
                                <div class="item-form-body">
                                    <div class="col-12 d-flex justify-content-end">
                                        <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" @onclick="() => DeleteClick(item)">
                                            <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                                        </Button>
                                    </div>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Video conference link
                                            </FieldLabel>
                                            <FieldBody>
                                                <TextEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.VideoLink">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Title
                                            </FieldLabel>
                                            <FieldBody>
                                                <TextEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Title">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Description
                                            </FieldLabel>
                                            <FieldBody>
                                                <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Description">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </MemoEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    @if (StateModel.PricingData.ItemPrices.Count != 0)
                                    {
                                        <Validation>
                                            <Field class="mb-4">
                                                <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                    Ticket Conditions
                                                </FieldLabel>
                                                <FieldBody>
                                                    <Select TValue="string" Size="Size.Medium" class="@RestrictionClass" @bind-SelectedValue="item.TicketRestriction">
                                                        <SelectItem Value="string.Empty" Disabled class="text-capitalize">Select Ticket Conditions</SelectItem>
                                                        <SelectItem Value='1' Disabled="@allRestrictionDisabled">All</SelectItem>
                                                        @foreach (var item in StateModel.PricingData.ItemPrices)
                                                        {
                                                            <SelectItem Value="@item.Name" Disabled="@item.Disabled">@item.Name</SelectItem>
                                                        }
                                                    </Select>
                                                    <div class="invalid-feedback">The ticket restriction is mandatory.</div>
                                                </FieldBody>
                                            </Field>
                                        </Validation>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Validations>
    </div>
    @if (modelTicketList.TicketInformations.Count > 0)
    {
        <Divider class="d-none m-d-block" />
    }
    <div class="border-radius-10 bg-white-200 p-4 my-3 m-bg-white-100 m-padding-0 m-margin-top-30">
        <Validations @ref="ticketFormValidation" Mode="FormMode" Model="modelTicketInfo">
            @if (DisplayDelete)
            {
                <div class="col-12 d-flex justify-content-end">
                    <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" @onclick="() => DeleteClick(modelTicketInfo)">
                        <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                    </Button>
                </div>
            }

            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        Video conference link
                    </FieldLabel>
                    <FieldBody>
                        <TextEdit class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelTicketInfo.VideoLink">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        Title
                    </FieldLabel>
                    <FieldBody>
                        <TextEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="modelTicketInfo.Title">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        Description
                    </FieldLabel>
                    <FieldBody>
                        <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="modelTicketInfo.Description">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </MemoEdit>
                    </FieldBody>
                </Field>
            </Validation>
            @if (StateModel.PricingData.ItemPrices.Count != 0)
            {
                <Validation>
                    <Field class="mb-4">
                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            Ticket Conditions
                        </FieldLabel>
                        <FieldBody>
                            <Select TValue="string" Size="Size.Medium" class="@RestrictionClass" @bind-SelectedValue="modelTicketInfo.TicketRestriction">
                                <SelectItem Disabled Value="0">Select Ticket Conditions</SelectItem>
                                <SelectItem Value="1" Disabled="@allRestrictionDisabled">All</SelectItem>
                                @foreach (var item in StateModel.PricingData.ItemPrices)
                                {
                                    <SelectItem Disabled="item.Disabled" Value="@item.Name">@item.Name</SelectItem>
                                }
                            </Select>
                            <div class="invalid-feedback">The ticket restriction is mandatory.</div>
                        </FieldBody>
                    </Field>
                </Validation>
            }
            <div>
                <Button Clicked="AddMoreTicket" Disabled="@allTicketRestrictionsSelected" class="bg-orange-100 color-white-100 text-capitalize font-20 hover-color-white px-5 border-radius-10 m-border-radius-5 m-width-100">
                    add more
                </Button>
            </div>
        </Validations>
    </div>
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>
<ConfirmDialog @ref="confirmDialogRef" AcceptLabel="Yes" DeclineLabel="No"
               OnConfirmationChanged="ConfirmDeleteChanged">
    <HeaderContent>
        <p class="m-0">Confirm Action</p>
    </HeaderContent>
    <BodyContent>
        <p class="m-0">Are you sure you want to remove this ticket?</p>
    </BodyContent>
</ConfirmDialog>
<HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Create Online Event Page" />

@code 
{
    [Parameter]
    public EventCallback OnNextClick { get; set; }
    [Parameter]
    public EventCallback OnPrevClick { get; set; }
    [Parameter]
    public ModelState StateModel {get; set;} = new ();

    [Parameter]
    public string Token { get; set; }
    private HowToModal howToModal { get; set; }
    public string htmlString = Resources.App.OnlineEventString;
    private TicketInformation modelTicketInfo = new();
    private TicketInformation ticketToDelete = new();
    private TicketList modelTicketList = new();
    private TicketList existingList = new TicketList();
    private Validations? ticketFormValidation;
    private Validations? ticketListFormValidation;
    private bool showErrors = false;
    private ConfirmDialog confirmDialogRef { get; set; }
    private bool allTicketRestrictionsSelected = false;
    private bool allRestrictionDisabled = false;
    private bool DisplayDelete = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

        }
        else
        {
            if (existingList.TicketInformations.Count == 0)
            {
                DisplayDelete = false;
                AddMoreTicket();
            }
        }
    }
    protected override void OnParametersSet()
    {
        if (StateModel.PricingData != null)
        {
            var listOfPricing = new List<OtePricing.ModelData.ItemPrice>();
            foreach (var item in StateModel.PricingData.ItemPrices)
            {
                listOfPricing.Add(new OtePricing.ModelData.ItemPrice { Id = item.Id, Name = item.Name });
            }
            StateModel.PricingData = new OtePricing.ModelData
            {
                ItemPrices = listOfPricing
            };
            // Disable the selected item in the dropdown
            if (existingList.TicketInformations.Count != 0)
            {
                foreach (var item in existingList.TicketInformations)
                {
                    if (item.TicketRestriction == "1")
                    {
                        DisableAllPrices();
                        allRestrictionDisabled = true;
                    }
                    else
                    {
                        if (item.TicketRestriction == "0")
                        {
                            EnableAllPrices();
                            allRestrictionDisabled = false;
                        }
                        else
                        {
                            allRestrictionDisabled = true;
                            StateModel.PricingData.ItemPrices.Where(a => a.Name == item.TicketRestriction).FirstOrDefault().Disabled = true;
                        }
                    }
                }
            }
        }
    }

    private async Task NextClick()
    {
        if (OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }

    private async Task PrevClick()
    {
        if (OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    public async Task<bool> FieldValid()
    {
        if (ticketFormValidation is not null && ticketListFormValidation is not null)
        {
            bool ticketConditionValid = !string.IsNullOrEmpty(modelTicketInfo.TicketRestriction) && modelTicketInfo.TicketRestriction != "0";
            bool ticketValid = await ticketFormValidation.ValidateAll() && ticketConditionValid;
            bool ticketConditionsValid = modelTicketList.TicketInformations.All(ticket => !string.IsNullOrEmpty(ticket.TicketRestriction) && ticket.TicketRestriction != "0");
            bool ticketListValid = await ticketListFormValidation.ValidateAll() && ticketConditionsValid;

            bool valid = ticketValid && ticketListValid;

            showErrors = true;
            StateHasChanged();
            await Task.Delay(300); // add delay to populate is-invalid class

            if (!valid)
            {
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-online-wrapper .is-invalid");
            }

            return valid;
        }
        return false;
    }

    public ModelData GetData()
    {
        ModelData data = new ModelData
            {
                TicketInfos = modelTicketList.TicketInformations.Select(p =>
                {
                    return new ModelData.TicketInfo
                    {
                        Id = p.Id,
                        Title = p.Title,
                        VideoLink = p.VideoLink,
                        Description = p.Description,
                        TicketRestriction = p.TicketRestriction,
                    };
                }).ToList()
            };
        data.TicketInfos.Add(new ModelData.TicketInfo
            {
                Id = modelTicketInfo.Id,
                Title = modelTicketInfo.Title,
                Description = modelTicketInfo.Description,
                VideoLink = modelTicketInfo.VideoLink,
                TicketRestriction = modelTicketInfo.TicketRestriction,
            });
        return data;
    }

    public void SetState(ModelData data)
    {
        //existing ticket
        foreach (var item in data.TicketInfos)
        {
            existingList.TicketInformations.Add(new TicketInformation
                {
                    Id = item.Id,
                    Description = item.Description,
                    Title = item.Title,
                    VideoLink = item.VideoLink,
                    TicketRestriction = item.TicketRestriction,
                });
        }
        data.TicketInfos = data.TicketInfos.OrderBy(a => a.Id).ToList();
        var last = data.TicketInfos.LastOrDefault();
        if (last is not null)
        {
            var notLast = data.TicketInfos.Where(p => p.Id != last.Id);
            foreach (var item in notLast)
            {
                modelTicketList.TicketInformations.Add(new TicketInformation
                    {
                        Id = item.Id,
                        Description = item.Description,
                        Title = item.Title,
                        VideoLink = item.VideoLink,
                        TicketRestriction = item.TicketRestriction,
                        IsNew = false,
                    });
            }
            modelTicketInfo.Id = last.Id;
            modelTicketInfo.Title = last.Title;
            modelTicketInfo.Description = last.Description;
            modelTicketInfo.TicketRestriction = last.TicketRestriction;
            modelTicketInfo.VideoLink = last.VideoLink;
            modelTicketInfo.IsNew = false;
        }
    }

    private ValidationMode FormMode
    {
        get
        {
            return showErrors ? ValidationMode.Auto : ValidationMode.Manual;
        }
    }

    private async Task AddMoreTicket()
    {
        //check the first item
        if (existingList.TicketInformations.Count == 1)
        {
            if (existingList.TicketInformations.FirstOrDefault().TicketRestriction == "1")
            {
                DisableAllPrices();
            }
        }
        else
        {
            DisplayDelete = true;
        }
        modelTicketList.TicketInformations = existingList.TicketInformations;
        int maxId = modelTicketList.TicketInformations.Count == 0 ? 1 : modelTicketList.TicketInformations.Max(s => s.TempId) + 1;
        int order = modelTicketList.TicketInformations.Count == 0 ? 1 : modelTicketList.TicketInformations.Max(s => s.Order) + 1;
        existingList.TicketInformations.Add(new TicketInformation { TempId = maxId, Order = order, IsNew = true, TicketRestriction = "0" });
        var last = existingList.TicketInformations.LastOrDefault();
        if (last is not null)
        {
            modelTicketList.TicketInformations = existingList.TicketInformations.Where(p => p.TempId != last.TempId).ToList();
            //Update Pricing Availability
            foreach (var item in modelTicketList.TicketInformations)
            {
                if (!string.IsNullOrEmpty(item.TicketRestriction))
                {
                    if (item.TicketRestriction == "1")
                    {
                        DisableAllPrices();
                    }
                    else
                    {
                        if (item.TicketRestriction == "0")
                        {
                            EnableAllPrices();
                            allRestrictionDisabled = false;
                        }
                        else
                        {
                            allRestrictionDisabled = true;
                            StateModel.PricingData.ItemPrices.Where(a => a.Name == item.TicketRestriction).FirstOrDefault().Disabled = true;
                        }
                    }
                }
            }
            modelTicketInfo = last;
        }
    }

    private async Task DeleteClick(TicketInformation ticket)
    {
        ticketToDelete = ticket;
        await confirmDialogRef.Open();
    }

    private async Task ConfirmDeleteChanged(bool value)
    {
        if (value)
        {
            //existing online ticket info
            modelTicketList.TicketInformations = existingList.TicketInformations;
            if (ticketToDelete.TempId == 0)
            {
                modelTicketList.TicketInformations.Where(a => a.Id == ticketToDelete.Id).FirstOrDefault().IsDeleted = true;
                if (ticketToDelete.TicketRestriction != "1")
                {
                    StateModel.PricingData.ItemPrices.Where(a => a.Name == ticketToDelete.TicketRestriction).FirstOrDefault().Disabled = false;
                }
                var deleteTicket = await activityApiHandler.DeleteOnlineEvent(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteOnlineEventArgs
                    {
                        Id = ticketToDelete.Id
                    }, Token);
                if (deleteTicket.Result != null && deleteTicket.Result.IsSuccess)
                {
                    existingList.TicketInformations = modelTicketList.TicketInformations.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                    var last = existingList.TicketInformations.LastOrDefault();
                    if (last is not null)
                    {
                        modelTicketList.TicketInformations = existingList.TicketInformations.Where(p => p.Id != last.Id).ToList();
                        modelTicketInfo = last;
                    }
                    else
                    {
                        AddMoreTicket();
                        EnableAllPrices();
                    }
                }
            }
            else
            {
                modelTicketList.TicketInformations.Where(a => a.TempId == ticketToDelete.TempId).FirstOrDefault().IsDeleted = true;
                if (!string.IsNullOrEmpty(ticketToDelete.TicketRestriction))
                {
                    if (ticketToDelete.TicketRestriction == "1")
                    {
                        allRestrictionDisabled = false;
                        DisableAllPrices();
                    }
                    else if (ticketToDelete.TicketRestriction == "0")
                    {
                        //EnableAllPrices();
                        //allRestrictionDisabled = false;
                    }
                    else
                    {
                        StateModel.PricingData.ItemPrices.Where(a => a.Name == ticketToDelete.TicketRestriction).FirstOrDefault().Disabled = false;
                    }
                }
                existingList.TicketInformations = modelTicketList.TicketInformations.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                var last = existingList.TicketInformations.LastOrDefault();
                if (last is not null && last.TempId != 0)
                {
                    modelTicketList.TicketInformations = existingList.TicketInformations.Where(p => p.TempId != last.TempId).ToList();
                    modelTicketInfo = last;
                }
                else if (last is not null && last.TempId == 0)
                {
                    modelTicketList.TicketInformations = existingList.TicketInformations.Where(p => p.Id != last.Id).ToList();
                    modelTicketInfo = last;
                }
                else
                {
                    AddMoreTicket();
                    EnableAllPrices();
                }
            }

        }
    }
    private string RestrictionClass
    {
        get
        {
            string defaultStyle = "form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5";
            if (showErrors)
            {
                if (string.IsNullOrEmpty(modelTicketInfo.TicketRestriction) || modelTicketInfo.TicketRestriction == "0")
                {
                    return $"{defaultStyle} is-invalid";

                }
                else
                {
                    return $"{defaultStyle} is-valid";
                }
            }
            return defaultStyle;
        }
    }
    private void DisableAllPrices()
    {
        foreach (var item in StateModel.PricingData.ItemPrices)
        {
            item.Disabled = true;
        }
    }
    private void EnableAllPrices()
    {
        foreach (var item in StateModel.PricingData.ItemPrices)
        {
            item.Disabled = false;
        }
        allRestrictionDisabled = false;
    }
    public class ModelData
    {
        public IList<TicketInfo> TicketInfos { get; set; }
        public class TicketInfo
        {
            public int Id { get; set; }
            public string VideoLink { get; set; }
            public string Title { get; set; }
            public string Description { get; set; }
            public string TicketRestriction { get; set; }
            public int OteSchedulePricingGroupId { get; set; }
        }
    }

    private class TicketList
    {
        public IList<TicketInformation> TicketInformations { get; set; } = new List<TicketInformation>();
    }

    public class TicketInformation
    {
        [Required(ErrorMessage = "The video link field is mandatory.")]
        public string VideoLink { get; set; }

        [Required(ErrorMessage = "The title is mandatory.")]
        public string Title { get; set; }

        [Required(ErrorMessage = "The description is mandatory.")]
        public string Description { get; set; }

        [Required(ErrorMessage = "The conditions is mandatory.")]
        public string TicketRestriction { get; set; }
        // extras
        public int Order { get; set; }
        public int TempId { get; set; }
        public bool IsNew { get; set; }
        public bool IsDeleted { get; set; } = false;
        public int Id { get; set; }
        public bool Valid
        {
            get
            {
                return !string.IsNullOrEmpty(VideoLink) &&
              !string.IsNullOrEmpty(Title) &&
              !string.IsNullOrEmpty(TicketRestriction) &&
              (string.IsNullOrEmpty(VideoLink) || VideoLink != "0");
            }
        }
    }

    public class ModelState 
    {
        public OteLocation.ModelData LocationData { get; set; } = new();
        public OtePricing.ModelData PricingData { get; set; } = new();
    }
}

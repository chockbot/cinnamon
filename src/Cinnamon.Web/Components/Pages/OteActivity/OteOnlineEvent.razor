@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject INotificationService NotificationService;
@inject IJSRuntime JS;
@implements IOteComponent;

<section class="ote-online-wrapper">
    <p class="header-title">
        Online Event Page
    </p>
    <p class="font-20 color-grey-100 text-justify m-font-16">
        Note: A one-time event refers to a specific occurrence or happening that takes place at a
        designated time and location. It could be a seminar, workshop, conference, concert,
        or any other event that is not recurring on a regular basis.
    </p>
    <div class="my-3 border-radius-10">
        <Validations @ref="ticketListFormValidation" Model="modelTicketInfo" Mode="ValidationMode.Auto">
            <div class="accordion" id="pricings-accordion">
                @foreach (var item in modelTicketList.TicketInformations)
                {
                    <div class="accordion-item" @key="item">
                        <h2 class="accordion-header">
                            <button style='@(!item.Valid ? "border: 1px solid #dc3545 !important;" : "")'
                                    class='@(item.Valid ? "accordion-button bg-white-200 font-20 m-font-16" : "accordion-button bg-white-200 font-20 m-font-16 is-invalid")'
                                    type="button" data-bs-toggle="collapse" data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                @item.Title
                            </button>
                        </h2>
                        <div id='@($"collapse-{item.Id}")' class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#pricings-accordion">
                            <div class="accordion-body bg-white-200">
                                <div class="item-form-body">
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Video conference link
                                            </FieldLabel>
                                            <FieldBody>
                                                <TextEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.VideoLink">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Title
                                            </FieldLabel>
                                            <FieldBody>
                                                <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Title">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </MemoEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                Description
                                            </FieldLabel>
                                            <FieldBody>
                                                <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Description">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </MemoEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Field class="mb-4">
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            Ticket Restriction
                                        </FieldLabel>
                                        <FieldBody>
                                            <Select TValue="string" Size="Size.Medium" SelectedValue="item.TicketRestriction">
                                                <SelectItem Value='"none"' Disabled class="text-capitalize">-Select Ticket Restriction-</SelectItem>
                                                @foreach (var item in Summary.PricingData.ItemPrices)
                                                {
                                                    <SelectItem Value="item.Name">@item.Name</SelectItem>
                                                }
                                            </Select>
                                            <div class="invalid-feedback">The ticket restriction is mandatory.</div>
                                        </FieldBody>
                                    </Field>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Validations>
    </div>

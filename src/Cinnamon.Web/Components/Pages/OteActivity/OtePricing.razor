    private Task CreateQuestion()
    {
        formQuestion = new CustomQuestion();
        questionAction = QuestionAction.Create;
        return modalCustomQuestion?.Show();
    }

    private Task CloseCustomQuestion()
    {
        formQuestion.Question = string.Empty;
        return modalCustomQuestion?.Close(CloseReason.UserClosing);
    }

    private Task AddQuestion()
    {
        var lastId = questions.Count == 0 ? 0 : questions.Max(q => q.Id);
        questions.Add(new CustomQuestion {
            Id = lastId + 1,
            Question = formQuestion.Question,
            Required = formQuestion.Required,
            IsNew = true
        });
        formQuestion.Question = string.Empty;
        return CloseCustomQuestion();
    }

    private Task SaveUpdated()
    {
        var question = questions.FirstOrDefault(q => q.Id == formQuestion.Id);
        if(question is not null)
        {
            question.Question = formQuestion.Question;
            question.Required = formQuestion.Required;
        }
        return CloseCustomQuestion();
    }

    private Task SaveQuestion()
    {
        if(questionAction == QuestionAction.Create)
        {
            return AddQuestion();
        }

        return SaveUpdated();
    }

    private Task RemoveQuestion(CustomQuestion question)
    {
        questions.Remove(question);
        if(!question.IsNew)
        {
            deletedQuestions.Add(question);
        }
        return Task.CompletedTask;
    }

    private Task UpdateQuestion(CustomQuestion question)
    {
        formQuestion = new CustomQuestion {
            FieldType = question.FieldType,
            Id = question.Id,
            Question = question.Question,
            Required = question.Required
        };
        questionAction = QuestionAction.Edit;
        return modalCustomQuestion?.Show();
    }

    private IEnumerable<CustomQuestion> FilteredQuestions 
    {
        get {
            return questions.Where(q => q.Question != "##Name" && q.Question != "##Email" && q.Question != "##Phone");
        }
    }

    private Task SetPredefinedQuestion(string question, string status)
    {
        var fieldType = Cinnamon.Framework.Enums.FieldType.TextArea.ToString();
        switch (question)
        {
            case "##Name":
                nameQuestion = status;
                fieldType = Cinnamon.Framework.Enums.FieldType.Text.ToString();
                break;
            case "##Email":
                emailQuestion = status;
                fieldType = Cinnamon.Framework.Enums.FieldType.Email.ToString();
                break;
            case "##Phone":
                phoneQuestion = status;
                fieldType = Cinnamon.Framework.Enums.FieldType.PhoneNumber.ToString();
                break;
        }

        var existingQuestion = questions.FirstOrDefault(q => q.Question == question);
        if(status == "Off")
        {
            if(existingQuestion is not null)
            {
                RemoveQuestion(existingQuestion);
            }
        }
        else 
        {
            if(existingQuestion is null)
            {
                var lastId = questions.Count == 0 ? 0 : questions.Max(q => q.Id);
                questions.Add(new CustomQuestion {
                    Id = lastId + 1,
                    Question = question,
                    Required = status == "Required",
                    IsNew = true,
                    FieldType = fieldType
                });
            }
            else {
                existingQuestion.Required = status == "Required";
            }
        }
        return Task.CompletedTask;
    }

    private Task SetPredefinedQuestionState()
    {
        var nameQuestion = questions.FirstOrDefault(q => q.Question == "##Name");
        var emailQuestion = questions.FirstOrDefault(q => q.Question == "##Email");
        var phoneQuestion = questions.FirstOrDefault(q => q.Question == "##Phone");

        if(nameQuestion is not null)
        {
            this.nameQuestion = nameQuestion.Required ? "Required" : "Optional";
        }
        else 
        {
            this.nameQuestion = "Off";
        }

        if(emailQuestion is not null)
        {
            this.emailQuestion = emailQuestion.Required ? "Required" : "Optional";
        }
        else 
        {
            this.emailQuestion = "Off";
        }

        if(phoneQuestion is not null)
        {
            this.phoneQuestion = phoneQuestion.Required ? "Required" : "Optional";
        }
        else 
        {
            this.phoneQuestion = "Off";
        }

        return Task.CompletedTask;
    }

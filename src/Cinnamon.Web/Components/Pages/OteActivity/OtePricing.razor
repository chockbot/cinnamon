    public class PriceIfNotFreeAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext validationContext)
        {
            OtePricing price = new OtePricing();
            var pricing = (Pricing)validationContext.ObjectInstance;
            if (!pricing.IsFree && pricing.Price <= 0 || !pricing.IsFree && pricing.Price == null)
            {
                price.showErrors = true;
                return new ValidationResult("If the ticket is not free, the price must be greater than 0.");
            }
            else
            {
                price.showErrors = false;
            }
            return ValidationResult.Success;
        }
    }
    public class MaxSlotsIfNotUnlimitedAttribute : ValidationAttribute
    {
        protected override ValidationResult IsValid(object value, ValidationContext validationContext)
        {
            OtePricing price = new OtePricing();
            var pricing = (Pricing)validationContext.ObjectInstance;
            if (!pricing.IsUnlimited && pricing.MaxSlots <= 0 || !pricing.IsUnlimited && pricing.MaxSlots == null)
            {
                price.showErrors = true;
                return new ValidationResult("If the ticket is not unlimited, the max slot must be greater than 0.");
            }
            else
            {
                price.showErrors = false;
            }
            return ValidationResult.Success;
        }
    }

    private class ModalTicketPricing
    {
        public decimal TicketPrice { get; set; }
        public bool IsAbsorbFee { get; set; }
        public decimal ServiceFee
        {
            get
            {
                return (TicketPrice * 0.05m);
            }
        }

        public decimal HandlingFee
        {
            get
            {
                return 15;
            }
        }

        public decimal SubTotal
        {
            get
            {
                if (!IsAbsorbFee) return TicketPrice + ServiceFee + HandlingFee;
                return TicketPrice;
            }
        }

        public decimal PayoutAmount
        {
            get
            {
                if (!IsAbsorbFee) return TicketPrice;

                return SubTotal - ServiceFee - HandlingFee;
            }
        }
    }


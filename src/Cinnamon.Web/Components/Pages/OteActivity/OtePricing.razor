@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Framework.ValidationAttributes;
@using Cinnamon.Framework.Extensions.String;
@using Cinnamon.Framework.Helpers;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject INotificationService NotificationService
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime JS
@implements IOteComponent

<section class="ote-pricing-wrapper">
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        <div class="mb-4">
            <div class="d-flex justify-content-between">
                <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                    <span>
                        schedule
                    </span>
                    <span class="rounded-circle bg-orange-100 color-white-100 round-padding ms-2 m-d-none">4</span>
                </h3>
                <label @onclick="ViewGuide" class="cursor-pointer">
                    <span class="font-14 font-weight-700 color-green-100 text-decoration-underline">How to do this</span>
                    <img src="images/ote/green-how-do-this.png" alt="icon">
                </label>
            </div>
            <p class="font-16 color-grey-100 text-justify">
                Plan and organize your event by setting up your preferred schedule, creating your event duration and recurring options with ease.
            </p>
        </div>
        <Validations @ref="scheduleFormValidation" Mode="FormMode" Model="ModelState">
            <div class="data-form">
                <div class="event-time">
                    <div class="d-flex mb-3 flex-column flex-md-row">
                        <div class="box-width me-3 m-width-100 mb-3 mb-md-0">
                            <label for="" class="text-capitalize font-20 color-black-100 m-font-18">
                                Event Duration
                            </label>
                            <Row HorizontalGutter="15">
                                <Column ColumnSize="ColumnSize.Is3.OnMobile.Is6.OnDesktop">
                                    <Validation>
                                        <Field>
                                            <FieldBody>
                                                <NumericPicker class="text-center border-radius-10 m-border-radius-5 px-2 m-font-16"
                                                               Min="1" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                               TValue="int" @bind-Value="ModelState.EventDurationCount">
                                                </NumericPicker>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is4.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldBody>
                                            <Select TValue="string" Size="Size.Medium" class="@RecurrencesClass"
                                                    @bind-SelectedValue="ModelState.EventDurationTimeUnit">
                                                <SelectItem Value='@("hrs")'>hrs</SelectItem>
                                                <SelectItem Value='@("days")'>days</SelectItem>
                                                <SelectItem Value='@("weeks")'>weeks</SelectItem>
                                                <SelectItem Value='@("months")'>months</SelectItem>
                                            </Select>
                                        </FieldBody>
                                    </Field>
                                </Column>
                            </Row>
                        </div>
                        <div class="box-width">
                            <Validation>
                                <Field>
                                    <FieldLabel class="text-capitalize font-20 color-black-100 m-font-18">
                                        Start Time
                                    </FieldLabel>
                                    <FieldBody>
                                        <TimeEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5"
                                                  Size="Size.Medium" TValue="TimeSpan" @bind-Time="ModelState.EventDurationTimeStart" />
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                    </div>
                </div>

                <Divider class="my-4" />

                <div class="event-recurrence d-flex flex-column flex-md-row mb-0 mb-md-3">
                    <div class="box-width me-3 mb-3 mb-md-0">
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                recurrences
                            </FieldLabel>
                            <FieldBody>
                                <Select TValue="string" Size="Size.Medium" class="@RecurrencesClass"
                                        SelectedValueChanged="RecurrenceChanged" SelectedValue="ModelState.Recurrences">
                                    <SelectItem Value='@("do-not-repeat")'>Do not repeat</SelectItem>
                                    <SelectItem Value='@("every-weekday")'>Every weekday</SelectItem>
                                    <SelectItem Value='@("daily")'>Daily</SelectItem>
                                    <SelectItem Value='@("weekly")'>Weekly</SelectItem>
                                    <SelectItem Value='@("monthly")'>Monthly</SelectItem>
                                </Select>
                                <div class="invalid-feedback">The recurrences field is mandatory.</div>
                            </FieldBody>
                        </Field>
                    </div>

                    @if (ModelState.Recurrences == "do-not-repeat")
                    {
                        <div class="box-width">
                            <Validation>
                                <Field>
                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                        start date
                                    </FieldLabel>
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationStart">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                    }
                </div>

                @if (ModelState.Recurrences != "do-not-repeat")
                {
                    <div class="d-flex">
                        <div class="box-width me-3">
                            <Validation>
                                <Field>
                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                        start
                                    </FieldLabel>
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationStart">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                        <div class="box-width">
                            <Validation>
                                <Field>
                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                        end
                                    </FieldLabel>
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationEnd">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                    </div>

                    <div class="weekly-repeat-every mt-4">
                        <label for="durationCount" class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            repeat every
                        </label>
                        <div class="repeat-every-flex d-flex align-items-baseline align-items-md-center flex-column flex-md-row">
                            <div class="box-width me-3 mb-3 mb-md-0">
                                <Validation>
                                    <Field>
                                        <FieldBody>
                                            <div class="d-flex">
                                                <NumericPicker ElementId="durationCount"
                                                               class="text-center me-3 border-radius-10 m-border-radius-5 m-font-16"
                                                               style="width: 90px;" Min="1" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                           TValue="int" @bind-Value="ModelState.DurationEvery">
                                                </NumericPicker>
                                                <Button Disabled class="bg-grey-200 px-4">
                                                @ModelState.RepeatEvery
                                                </Button>
                                            </div>
                                            </FieldBody>
                                            </Field>
                                            </Validation>
                                        </div>
                                        @if (ModelState.Recurrences == "every-weekday")
                            {
                                <div class="d-flex justify-content-center m-width-100">
                                    <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                                    <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">M</span>
                                    <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                                    <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">W</span>
                                    <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                                    <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">F</span>
                                    <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                                </div>
                            }

                            @if (ModelState.Recurrences == "weekly")
                            {
                                <div class="d-flex justify-content-center m-width-100">
                                    @foreach (var item in dayItems)
                                    {
                                        <span @key="item" class="@SetDayStyle(item.Selected)" @onclick="() => OnWeeklyDaySelected(item)">@item.Day</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @if (ModelState.Recurrences == "monthly")
                    {
                        <div class="mt-5">
                            <RadioGroup TValue="int" @bind-CheckedValue="ModelState.MonthSelection">
                                <Validation>
                                    <Field class="mb-3">
                                        <FieldBody>
                                            <div class="d-flex align-items-center">
                                                <label for="type-on-day" class="cursor-pointer">
                                                    <Radio class="checkbox-round cursor-pointer" ElementId="type-on-day" TValue="int" Value="1">On day</Radio>
                                                </label>
                                                <NumericPicker Disabled="ModelState.MonthSelection == 2" class="text-center ms-3 border-radius-10 m-border-radius-5"
                                                               style="width: 90px;" Min="1" Max="31" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                       TValue="int" @bind-Value="ModelState.OnDayDate">
                                                </NumericPicker>
                                            </div>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                                <Field>
                                    <FieldBody>
                                        <div class="d-flex align-items-center">
                                            <label for="type-on-the" class="cursor-pointer">
                                                <Radio class="checkbox-round cursor-pointer" ElementId="type-on-the" TValue="int" Value="2">On the</Radio>
                                            </label>
                                            <div class="box-width ms-3">
                                                <Select Disabled="ModelState.MonthSelection == 1" TValue="string" Size="Size.Medium"
                                                        class="form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5"
                                                @bind-SelectedValue="ModelState.MonthRepeat">
                                                    <SelectItem Value='@("first")'>First</SelectItem>
                                                    <SelectItem Value='@("second")'>Second</SelectItem>
                                                    <SelectItem Value='@("third")'>Third</SelectItem>
                                                    <SelectItem Value='@("fourth")'>Fourth</SelectItem>
                                                    <SelectItem Value='@("last")'>Last</SelectItem>
                                                </Select>
                                            </div>
                                            <div class="box-width ms-3">
                                                <Select Disabled="ModelState.MonthSelection == 1" TValue="string" Size="Size.Medium"
                                                        class="box-width form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5"
                                                @bind-SelectedValue="ModelState.MonthDay">
                                                    <SelectItem Value='@("sunday")'>Sunday</SelectItem>
                                                    <SelectItem Value='@("monday")'>Monday</SelectItem>
                                                    <SelectItem Value='@("tuesday")'>Tuesday</SelectItem>
                                                    <SelectItem Value='@("wednesday")'>Wednesday</SelectItem>
                                                    <SelectItem Value='@("thursday")'>Thursday</SelectItem>
                                                    <SelectItem Value='@("friday")'>Friday</SelectItem>
                                                    <SelectItem Value='@("saturday")'>Saturday</SelectItem>
                                                </Select>
                                            </div>
                                        </div>
                                    </FieldBody>
                                </Field>
                            </RadioGroup>
                        </div>
                    }
                }
                <div class="text-center color-grey-100 mt-4">
                    <p class="m-0 font-20 m-font-18">@ScheduleMessageInfo</p>
                </div>
            </div>
        </Validations>
    </div>

    <div class="border-radius-10 bg-white-200 p-4 my-4 m-bg-white-100 m-padding-0 m-margin-top-30">
        <div>
            <h3 class="font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                Add date overrides
            </h3>
            <p class="font-16 color-grey-100 text-justify">
                Customize recurrence patterns with override dates, providing flexible scheduling control for specific instances.
            </p>
            <div class="text-center">
                <Button Clicked="ViewCalendar" class="bg-transparent rounded-pill border-color-orange-100 px-5 my-4 color-orange-100 hover-color-primary">
                    Add date override
                </Button>
            </div>
            <Divider DividerType="DividerType.Dashed" class="m-0" />
            <div>
                <Table FullWidth>
                    <TableBody>
                        @foreach (var item in dateOverrides)
                        {
                            <TableRow @key="item" VerticalAlignment="VerticalAlignment.Middle">
                                <TableRowCell>
                                    <span>@item.Value.Date.ToString("MMMM dd, yyyy")</span>
                                </TableRowCell>
                                <TableRowCell>
                                    <span>@TimeToString(item.Value.TimeStart)- @TimeToString(item.Value.TimeEnd)</span>
                                </TableRowCell>
                                <TableHeaderCell>
                                    <Button Clicked="() => dateOverrides.Remove(item.Key)">
                                        <img src="/images/ote/delete-icon.png" alt="delete">
                                    </Button>
                                </TableHeaderCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </div>
        </div>
    </div>

    @*Ticket Limit*@
    <div class="border-radius-10 bg-white-200 p-4 my-4 m-bg-white-100 m-padding-0 m-margin-top-30">
        <Field>
            <FieldLabel>
                <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                    Max Ticket per Customer
                </h3>
            </FieldLabel>
            <div class="ticket-limit-group">
                <FieldBody>
                    <RadioGroup TValue="int" Name="limit-type" CheckedValue="ModelState.IsLimit" CheckedValueChanged="CheckLimitChanged">
                        <label for="no-limit" class="border-radius-10 prevent-select py-2 text-capitalize cursor-pointer">
                            <Radio class="checkbox-round" ElementId="no-limit" TValue="int" Value="1">No Limit</Radio>
                        </label>
                        <label for="set-limit" class="border-radius-10 label-set-limit">
                            <Radio class="checkbox-round" ElementId="set-limit" TValue="int" Value="2">Set Limit</Radio>
                        </label>
                    </RadioGroup>
                    @if (ModelState.IsLimit == 2)
                    {
                        <label for="specify-limit" class="border-radius-10 prevent-select px-3 py-2 specific-text">Specify:</label>
                        <NumericPicker ElementId="specify-limit" Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium" class="@LimitClass" @bind-Value="ModelState.EventTicketLimit">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </NumericPicker>
                    }
                 </FieldBody>
            </div>
        </Field>
    </div>

    <Divider class="d-none m-d-block" />
    <div class="my-3 border-radius-10">
        <Validations @ref="pringListFormValidation" Model="modelPricingList" Mode="ValidationMode.Auto">
            <div class="accordion" id="pricings-accordion">
                @foreach (var item in modelPricingList.Pricings)
                {
                    <div class="accordion-item" @key="item">
                        <h2 class="accordion-header">
                            <button style='@(!item.Valid ? "border: 1px solid #dc3545 !important;" : "")'
                                    class='@(item.Valid ? "accordion-button bg-white-200 font-20 m-font-16" : "accordion-button bg-white-200 font-20 m-font-16 is-invalid")'
                                    type="button" data-bs-toggle="collapse" data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                @item.Name
                            </button>
                        </h2>
                        <div id='@($"collapse-{item.Id}")' class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#pricings-accordion">
                            <div class="accordion-body bg-white-200">
                                <div class="item-form-body">
                                    <div class="col-12 d-flex justify-content-end">
                                        <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" Disabled="item.TicketSold != 0 ? true : false" @onclick="() => DeleteClick(item)">
                                            <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                                        </Button>
                                    </div>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                ticket name
                                            </FieldLabel>
                                            <FieldBody>
                                                <TextEdit ReadOnly="item.TicketSold != 0 ? true : false" class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Name">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                admission description
                                            </FieldLabel>
                                            <FieldBody>
                                                <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Description">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </MemoEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Row VerticalGutter="10" class="mb-2">
                                        <Column ColumnSize="ColumnSize.Is7">
                                            <Validation>
                                                <Field>
                                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                        price
                                                    </FieldLabel>
                                                    <FieldBody>
                                                        <NumericPicker Decimals="0" ShowStepButtons="false" TValue="decimal" Size="Size.Medium"
                                                                       class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.Price">
                                                            <Feedback>
                                                                <ValidationError />
                                                            </Feedback>
                                                        </NumericPicker>
                                                    </FieldBody>
                                                </Field>
                                            </Validation>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is5">
                                            <Validation>
                                                <Field>
                                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                        max slots
                                                    </FieldLabel>
                                                    <FieldBody>
                                                        <NumericPicker Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium"
                                                                       class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.MaxSlots">
                                                            <Feedback>
                                                                <ValidationError />
                                                            </Feedback>
                                                        </NumericPicker>
                                                    </FieldBody>
                                                </Field>
                                            </Validation>
                                        </Column>
                                    </Row>
                                    <Row VerticalGutter="10" class="mb-4">
                                        <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                                            <div class="d-flex justify-content-between mb-3">
                                                <span class="font-14 font-weight-700 color-orange-100">
                                                    Buyer total: ₱ @(CalCulateBuyerTotal(item).ToString("#,##0.00"))
                                                </span>
                                                <span @onclick="() => ViewDetails(item)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                                                    view details
                                                </span>
                                            </div>
                                            <div>
                                                <Check TValue="bool" Size="Size.Medium" @bind-Checked="item.AbsorbFees">
                                                    Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                                                </Check>
                                            </div>
                                        </Column>
                                    </Row>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Validations>
    </div>
    @if (modelPricingList.Pricings.Count > 0)
    {
        <Divider class="d-none m-d-block" />
    }
    <div class="border-radius-10 bg-white-200 p-4 my-3 m-bg-white-100 m-padding-0 m-margin-top-30">
        <div class="mb-4">
            <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                <span>
                    pricing
                </span>
                <span class="rounded-circle bg-orange-100 color-white-100 round-padding ms-2 m-d-none">5</span>
            </h3>
            <p class="font-16 color-grey-100 text-justify">
                Create your event pricing with essential details, ensuring simplicity and clarity for organizers and attendees.
            </p>
            <p class="font-16 color-grey-100 text-justify">
                Note: If tickets have already been purchased, users cannot delete ticket details. You can only edit the
                ticket description, price, and maximum slots. The ticket name is fixed, and the section cannot be
                deleted.
            </p>
        </div>
        <Validations @ref="pricingFormValidation" Mode="FormMode" Model="modelPricing">
            <div class="col-12 d-flex justify-content-end">
                @if (DisplayDelete)
                {
                    <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" Disabled="modelPricing.TicketSold != 0 ? true : false" @onclick="() => DeleteClick(modelPricing)">
                        <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                    </Button>
                }
            </div>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        ticket name
                    </FieldLabel>
                    <FieldBody>
                        <TextEdit ReadOnly="modelPricing.TicketSold != 0 ? true : false" class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Name">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        admission description
                    </FieldLabel>
                    <FieldBody>
                        <MemoEdit class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Description">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </MemoEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Row VerticalGutter="10">
                <Column ColumnSize="ColumnSize.Is7">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                price
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Decimals="0" ShowStepButtons="false" TValue="decimal" Size="Size.Medium"
                                               class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.Price">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
                <Column ColumnSize="ColumnSize.Is5">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                max slots
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium"
                                               class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.MaxSlots">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
            </Row>
            <Row VerticalGutter="10" class="mb-4">
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="font-14 font-weight-700 color-orange-100">
                            Buyer total: ₱ @(CalCulateBuyerTotal(modelPricing).ToString("#,##0.00"))
                        </span>
                        <span @onclick="() => ViewDetails(modelPricing)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                            view details
                        </span>
                    </div>
                    <div>
                        <Check TValue="bool" Size="Size.Medium" @bind-Checked="modelPricing.AbsorbFees">
                            Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                        </Check>
                    </div>
                </Column>
            </Row>
            <div>
                <Button Clicked="AddMoreTicketPrice" class="bg-orange-100 color-white-100 text-capitalize font-20 hover-color-white px-5 border-radius-10 m-border-radius-5 m-width-100">
                    add more ticket price
                </Button>
            </div>

    public ModelData GetData()
    {
        bool isRecurrence = ModelState.Recurrences != "do-not-repeat";
        bool isMonthly = ModelState.Recurrences == "monthly";

        string weekString = ModelState.Recurrences switch
        {
            "every-weekday" => "MON|TUE|WED|THU|FRI",
            "weekly" => string.Join("|", dayItems.Where(i => i.Selected).Select(i => i.Value)),
            _ => ""
        };

        ModelData data = new ModelData
            {
                DateFrom = ModelState.DateFrom,
                DateTo = ModelState.DateTo,
                Recurrences = ModelState.Recurrences,

                DurationEnd = isRecurrence ? ModelState.DurationEnd : null,
                DurationStart = isRecurrence ? ModelState.DurationStart : null,
                DurationEvery = isRecurrence ? ModelState.DurationEvery : null,
                MonthDay = isMonthly ? ModelState.MonthDay : null,
                MonthRepeat = isMonthly ? ModelState.MonthRepeat : null,
                MonthSelection = isMonthly ? ModelState.MonthSelection : null,
                OnDayDate = isMonthly ? ModelState.OnDayDate : null,
                WeekString = weekString,
                EventDurationCount = ModelState.EventDurationCount,
                EventDurationTimeUnit = ModelState.EventDurationTimeUnit,
                EventTicketLimit = ModelState.EventTicketLimit,
                IsLimit = ModelState.EventTicketLimit != 0 ? 2 : 1,

                ItemPrices = modelPricingList.Pricings.Select(p =>
                {
                    return new ModelData.ItemPrice
                    {
                        AbsorbFees = p.AbsorbFees,
                        MaxSlots = p.MaxSlots,
                        Price = p.Price,
                        Description = p.Description,
                        Id = p.Id,
                        Name = p.Name,
                        TicketSold = p.TicketSold
                    };
                }).ToList(),
                DateOverrides = dateOverrides.Select(s =>
                {
                    return new ModelData.DateOverride
                    {
                        Date = s.Key,
                        TimeEnd = s.Value.TimeEnd,
                        TimeStart = s.Value.TimeStart
                    };
                }).ToList()
            };
        data.ItemPrices.Add(new ModelData.ItemPrice
            {
                AbsorbFees = modelPricing.AbsorbFees,
                MaxSlots = modelPricing.MaxSlots,
                Price = modelPricing.Price,
                Description = modelPricing.Description,
                Id = modelPricing.Id,
                Name = modelPricing.Name,
                TicketSold = modelPricing.TicketSold
            });
        return data;
    }

    public Task SetState(ModelData data)
    {
        RecurrenceChanged(data.Recurrences);

        // set selected days
        var days = data.WeekString.Split("|");
        foreach (var item in dayItems)
        {
            item.Selected = days.Contains(item.Value);
        }

        //existing ticket
        foreach (var item in data.ItemPrices)
        {
            existingList.Pricings.Add(new Pricing
                {
                    AbsorbFees = item.AbsorbFees,
                    Description = item.Description,
                    Id = item.Id,
                    MaxSlots = item.MaxSlots,
                    Price = item.Price,
                    Name = item.Name,
                    TicketSold = item.TicketSold
                });
        }

        data.ItemPrices = data.ItemPrices.OrderBy(t => t.Id).ToList();

        var last = data.ItemPrices.LastOrDefault();
        if (last is not null)
        {
            var notLast = data.ItemPrices.Where(p => p.Id != last.Id);
            foreach (var item in notLast)
            {
                modelPricingList.Pricings.Add(new Pricing
                    {
                        AbsorbFees = item.AbsorbFees,
                        Description = item.Description,
                        Id = item.Id,
                        MaxSlots = item.MaxSlots,
                        Price = item.Price,
                        Name = item.Name,
                        TicketSold = item.TicketSold,
                        IsNew = false,
                    });
            }
            modelPricing.AbsorbFees = last.AbsorbFees;
            modelPricing.Description = last.Description;
            modelPricing.Id = last.Id;
            modelPricing.MaxSlots = last.MaxSlots;
            modelPricing.Price = last.Price;
            modelPricing.Name = last.Name;
            modelPricing.TicketSold = last.TicketSold;
            modelPricing.IsNew = false;
        }

        return Task.CompletedTask;
    }


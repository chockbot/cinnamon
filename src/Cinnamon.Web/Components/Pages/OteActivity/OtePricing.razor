                </Row>
                <Row VerticalGutter="5" class="mb-1">
                    <Column ColumnSize="ColumnSize.Is12.Is12.OnDesktop">
                        @if (modelPricing.IsFree)
                        {
                            <div class="accept-reg">
                                <p class="approval">Required Approval</p>
                                <div class="form-check form-switch">
                                    <Switch TValue="bool" @bind-Checked="modelPricing.RequiredApproval" class="form-check-input" />
                                </div>
                            </div>
                            <p class="approval-text">If enabled, guests need to be manually approved before receiving their tickets.</p>
                        }
                        else
                        {
                            <div class="check-section">
                                <Check TValue="bool" Size="Size.Medium" @bind-Checked="modelPricing.AbsorbFees"></Check>
                                <p class="approval-text">Absorb Fees: Ticketing fees are deducted from your ticket revenue. <span><a class="learn-more" @onclick="() => ViewDetails(modelPricing)">Learn more...</a></span></p>
                            </div>
                            <div class="accept-reg">
                                <p class="approval">Required Approval</p>
                                <div class="form-check form-switch">
                                    <Switch TValue="bool" @bind-Checked="modelPricing.RequiredApproval" class="form-check-input" />
                                </div>
                            </div>
                            <p class="approval-text">If enabled, guests need to be manually approved before receiving their tickets.</p>
                        }
                    </Column>
                </Row>
            </Validations>
        </ModalBody>
        <ModalFooter>
            <div class="button-footer">
                <Button class="btn-cancel" @onclick="() => OnCancelEdit()">
                    Cancel
                </Button>
                <Button class="btn-save" @onclick="() => AddMoreTicketPrice()">
                    Save
                </Button>
            </div>
        </ModalFooter>
    </ModalContent>
</Modal>


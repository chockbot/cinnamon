@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Framework.ValidationAttributes;
@using Cinnamon.Framework.Extensions.String;
@using Cinnamon.Framework.Helpers;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject INotificationService NotificationService
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime JS
@implements IOteComponent

<section class="ote-pricing-wrapper">
    @*Ticket Limit*@
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0 m-margin-top-30">
        <Field>
            <FieldLabel>
                <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                    Max Ticket per Customer
                </h3>
            </FieldLabel>
            <div class="ticket-limit-group">
                <FieldBody>
                    <RadioGroup TValue="int" Name="limit-type" CheckedValue="ModelState.IsLimit" CheckedValueChanged="CheckLimitChanged">
                        <label for="no-limit" class="border-radius-10 prevent-select py-2 text-capitalize cursor-pointer">
                            <Radio class="checkbox-round" ElementId="no-limit" TValue="int" Value="1">No Limit</Radio>
                        </label>
                        <label for="set-limit" class="border-radius-10 label-set-limit">
                            <Radio class="checkbox-round" ElementId="set-limit" TValue="int" Value="2">Set Limit</Radio>
                        </label>
                    </RadioGroup>
                    @if (ModelState.IsLimit == 2)
                    {
                        <label for="specify-limit" class="border-radius-10 prevent-select px-3 py-2 specific-text">Specify:</label>
                        <NumericPicker ElementId="specify-limit" Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium" class="@LimitClass" @bind-Value="ModelState.EventTicketLimit">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </NumericPicker>
                    }
                 </FieldBody>
            </div>
        </Field>
    </div>

    <Divider class="d-none m-d-block" />

    <div class="my-3 border-radius-10">
        <Validations @ref="pringListFormValidation" Model="modelPricingList" Mode="ValidationMode.Auto">
            <div class="accordion" id="pricings-accordion">
                @foreach (var item in modelPricingList.Pricings)
                {
                    <div class="accordion-item" @key="item">
                        <h2 class="accordion-header">
                            <button style='@(!item.Valid ? "border: 1px solid #dc3545 !important;" : "")'
                                    class='@(item.Valid ? "accordion-button bg-white-200 font-20 m-font-16" : "accordion-button bg-white-200 font-20 m-font-16 is-invalid")'
                                    type="button" data-bs-toggle="collapse" data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                @item.Name
                            </button>
                        </h2>
                        <div id='@($"collapse-{item.Id}")' class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#pricings-accordion">
                            <div class="accordion-body bg-white-200">
                                <div class="item-form-body">
                                    <div class="col-12 d-flex justify-content-end">
                                        <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" Disabled="item.TicketSold != 0 ? true : false" @onclick="() => DeleteClick(item)">
                                            <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                                        </Button>
                                    </div>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                ticket name
                                            </FieldLabel>
                                            <FieldBody>
                                                <TextEdit ReadOnly="item.TicketSold != 0 ? true : false" class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Name">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Validation>
                                        <Field class="mb-4">
                                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                admission description
                                            </FieldLabel>
                                            <FieldBody>
                                                <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Description">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </MemoEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Row VerticalGutter="10" class="mb-2">
                                        <Column ColumnSize="ColumnSize.Is7">
                                            <Validation>
                                                <Field>
                                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                        price
                                                    </FieldLabel>
                                                    <FieldBody>
                                                        <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="decimal?" Size="Size.Medium"
                                                                       class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.Price">
                                                            <Feedback>
                                                                <ValidationError />
                                                            </Feedback>
                                                        </NumericPicker>
                                                    </FieldBody>
                                                </Field>
                                            </Validation>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is5">
                                            <Validation>
                                                <Field>
                                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                        max slots
                                                    </FieldLabel>
                                                    <FieldBody>
                                                        <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="int?" Size="Size.Medium"
                                                                       class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.MaxSlots">
                                                            <Feedback>
                                                                <ValidationError />
                                                            </Feedback>
                                                        </NumericPicker>
                                                    </FieldBody>
                                                </Field>
                                            </Validation>
                                        </Column>
                                    </Row>
                                    <Row VerticalGutter="10" class="mb-4">
                                        <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                                            <div class="d-flex justify-content-between mb-3">
                                                <span class="font-14 font-weight-700 color-orange-100">
                                                    Buyer total: ₱ @(CalCulateBuyerTotal(item).ToString("#,##0.00"))
                                                </span>
                                                <span @onclick="() => ViewDetails(item)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                                                    view details
                                                </span>
                                            </div>
                                            <div>
                                                <Check TValue="bool" Size="Size.Medium" @bind-Checked="item.AbsorbFees">
                                                    Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                                                </Check>
                                            </div>
                                        </Column>
                                    </Row>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </Validations>
    </div>

    @if (modelPricingList.Pricings.Count > 0)
    {
        <Divider class="d-none m-d-block" />
    }

    <div class="border-radius-10 bg-white-200 p-4 my-3 m-bg-white-100 m-padding-0 m-margin-top-30">
        <div class="mb-4">
            <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                <span>
                    pricing
                </span>
                <span class="rounded-circle bg-orange-100 color-white-100 round-padding ms-2 m-d-none">5</span>
            </h3>
            <p class="font-16 color-grey-100 text-justify">
                Create your event pricing with essential details, ensuring simplicity and clarity for organizers and attendees.
            </p>
            <p class="font-16 color-grey-100 text-justify">
                Note: If tickets have already been purchased, users cannot delete ticket details. You can only edit the
                ticket description, price, and maximum slots. The ticket name is fixed, and the section cannot be
                deleted.
            </p>
        </div>
        <Validations @ref="pricingFormValidation" Mode="FormMode" Model="modelPricing">
            <div class="col-12 d-flex justify-content-end">
                @if (DisplayDelete)
                {
                    <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" Disabled="modelPricing.TicketSold != 0 ? true : false" @onclick="() => DeleteClick(modelPricing)">
                        <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                    </Button>
                }
            </div>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        ticket name
                    </FieldLabel>
                    <FieldBody>
                        <TextEdit ReadOnly="modelPricing.TicketSold != 0 ? true : false" class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Name">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        admission description
                    </FieldLabel>
                    <FieldBody>
                        <MemoEdit class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Description">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </MemoEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Row VerticalGutter="10">
                <Column ColumnSize="ColumnSize.Is7">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                price
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="decimal?" Size="Size.Medium"
                                               class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.Price">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
                <Column ColumnSize="ColumnSize.Is5">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                max slots
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="int?" Size="Size.Medium"
                                               class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.MaxSlots">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
            </Row>
            <Row VerticalGutter="10" class="mb-4">
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="font-14 font-weight-700 color-orange-100">
                            Buyer total: ₱ @(CalCulateBuyerTotal(modelPricing).ToString("#,##0.00"))
                        </span>
                        <span @onclick="() => ViewDetails(modelPricing)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                            view details
                        </span>
                    </div>
                    <div>
                        <Check TValue="bool" Size="Size.Medium" @bind-Checked="modelPricing.AbsorbFees">
                            Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                        </Check>
                    </div>
                </Column>
            </Row>
            <div>
                <Button Clicked="AddMoreTicketPrice" class="bg-orange-100 color-white-100 text-capitalize font-20 hover-color-white px-5 border-radius-10 m-border-radius-5 m-width-100">
                    add more ticket price
                </Button>
            </div>
        </Validations>
    </div>
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>

<Modal @ref="modalFeeBreakdown">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <p class="font-20 font-weight-700 color-black-100 mb-0">Absorb Fees Breakdown</p>
            <button type="button" style="top: 22px; right: 20px;" class="btn-close position-absolute" @onclick="CloseDetails" />
        </ModalHeader>
        <ModalBody class="px-4">
            <div class="color-black-100">
                <label class="font-weight-700 font-16 mb-2">Cost of Buyer</label>
                <div class="mb-2 d-flex color-grey-100 justify-content-between">
                    <p class="mb-0">Ticket Price:</p>
                    <p class="mb-0">₱ @modalTicketPricing.TicketPrice.ToString("#,##0.00")</p>
                </div>
                <div class="mb-2 d-flex color-grey-100 justify-content-between">
                    <p class="mb-0">Service Fee:</p>
                    <p class="mb-0">₱ @modalTicketPricing.ServiceFee.ToString("#,##0.00")</p>
                </div>
                <div class="mb-2 d-flex color-grey-100 justify-content-between">
                    <p class="mb-0">Handling Fee:</p>
                    <p class="mb-0">₱ @modalTicketPricing.HandlingFee.ToString("#,##0.00")</p>
                </div>
                <div class="mb-2 d-flex font-weight-700 justify-content-between">
                    <p class="mb-0">Total:</p>
                    <p class="mb-0">₱ @modalTicketPricing.SubTotal.ToString("#,##0.00")</p>
                </div>
            </div>
            <div class="color-black-100 mt-4">
                <label class="font-weight-700 font-16 mb-1">Your Payout</label>
                <div class="mb-2 d-flex color-grey-100 justify-content-between">
                    <p class="mb-0">Ticket Revenue:</p>
                    <p class="mb-0">₱ @modalTicketPricing.PayoutAmount.ToString("#,##0.00")</p>
                </div>
            </div>
            <div class="color-grey-100 font-12 mt-4">
                <p class="mb-0">Note: Service will may change depending on the payment method used.</p>
                <p class="mb-0">E-wallet - 3%</p>
                <p class="mb-0">Cards - 5%</p>
            </div>
        </ModalBody>
    </ModalContent>
    </Modal>
<Modal @ref="modalError">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <p class="font-20 font-weight-700 color-black-100 mb-0">Error Message</p>
            <button type="button" style="top: 22px; right: 20px;" class="btn-close position-absolute" @onclick="CloseErrorMessage" />
        </ModalHeader>

        <ModalBody class="px-4">
            <div class="color-black-100">
                @errorMessageAlert
            </div>
        </ModalBody>
    </ModalContent>
    </Modal>
<ConfirmDialog @ref="confirmDialogRef" AcceptLabel="Yes" DeclineLabel="No"
           OnConfirmationChanged="ConfirmDeleteChanged">
    <HeaderContent>
        <p class="m-0">Confirm Action</p>
    </HeaderContent>
    <BodyContent>
        <p class="m-0">Are you sure you want to remove this ticket?</p>
    </BodyContent>
</ConfirmDialog>

@code
{
    [Parameter]
    public EventCallback OnNextClick { get; set; }

    [Parameter]
    public EventCallback OnPrevClick { get; set; }

    [Parameter]
    public Pricing ModelState { get; set; } = new();

    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public ComponentSummary Summary { get; set; }

    private Pricing modelPricing = new();
    private Pricing priceToDelete = new();
    private PricingList modelPricingList = new();
    private PricingList existingList = new PricingList();
    private Validations? pricingFormValidation;
    private Validations? pringListFormValidation;
    private Validation? maxTicketLimit;
    private bool showErrors = false;
    private string errorMessageAlert { get; set; }
    private bool DisplayDelete = true;
    private Modal? modalFeeBreakdown { get; set; }
    private Modal modalError { get; set; }
    private ModalTicketPricing modalTicketPricing = new();
    private ConfirmDialog confirmDialogRef { get; set; }

    private async Task NextClick()
    {
        if (OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }

    private async Task PrevClick()
    {
        if (OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    public async Task<bool> FieldValid()
    {
        if (pricingFormValidation is not null && pringListFormValidation is not null)
        {
            bool pricingValid = await pricingFormValidation.ValidateAll();
            bool pricingListValid = await pringListFormValidation.ValidateAll();
            bool isSetLimit = true;
            if(ModelState.IsLimit == 2)
            {
                isSetLimit = ModelState.EventTicketLimit != 0;
            }
            bool valid = pricingValid && pricingListValid && isSetLimit;
            showErrors = true;
            StateHasChanged();
            await Task.Delay(300); // add delay to populate is-invalid class
            if (!valid)
            {
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-pricing-wrapper .is-invalid");
            }
            return valid;
        }
        return false;
    }

    private ValidationMode FormMode
    {
        get
        {
            return showErrors ? ValidationMode.Auto : ValidationMode.Manual;
        }
    }

    private string LimitClass
    {
        get
        {
            string defaultClass = "field-width form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5 px-2";
            if(showErrors)
            {
                if(ModelState.EventTicketLimit == 0)
                {
                    return $"{defaultClass} is-invalid";
                }
                return $"{defaultClass} is-valid";
            }
            return defaultClass;
        }
    }

    public ModelData GetData()
    {
        ModelData data = new ModelData
        {
            EventTicketLimit = ModelState.EventTicketLimit,
            IsLimit = ModelState.EventTicketLimit != 0 ? 2 : 1,

            ItemPrices = modelPricingList.Pricings.Select(p =>
            {
                return new ModelData.ItemPrice
                {
                    AbsorbFees = p.AbsorbFees,
                    MaxSlots = p.MaxSlots,
                    Price = p.Price,
                    Description = p.Description,
                    Id = p.Id,
                    Name = p.Name,
                    TicketSold = p.TicketSold
                };
            }).ToList()
        };
        data.ItemPrices.Add(new ModelData.ItemPrice
        {
            AbsorbFees = modelPricing.AbsorbFees,
            MaxSlots = modelPricing.MaxSlots,
            Price = modelPricing.Price,
            Description = modelPricing.Description,
            Id = modelPricing.Id,
            Name = modelPricing.Name,
            TicketSold = modelPricing.TicketSold
        });
        return data;
    }

    public Task SetState(ModelData data)
    {
        //existing ticket
        foreach (var item in data.ItemPrices)
        {
            existingList.Pricings.Add(new Pricing
                {
                    AbsorbFees = item.AbsorbFees,
                    Description = item.Description,
                    Id = item.Id,
                    MaxSlots = item.MaxSlots,
                    Price = item.Price,
                    Name = item.Name,
                    TicketSold = item.TicketSold
                });
        }

        data.ItemPrices = data.ItemPrices.OrderBy(t => t.Id).ToList();

        var last = data.ItemPrices.LastOrDefault();
        if (last is not null)
        {
            var notLast = data.ItemPrices.Where(p => p.Id != last.Id);
            foreach (var item in notLast)
            {
                modelPricingList.Pricings.Add(new Pricing
                    {
                        AbsorbFees = item.AbsorbFees,
                        Description = item.Description,
                        Id = item.Id,
                        MaxSlots = item.MaxSlots,
                        Price = item.Price,
                        Name = item.Name,
                        TicketSold = item.TicketSold,
                        IsNew = false,
                    });
            }
            modelPricing.AbsorbFees = last.AbsorbFees;
            modelPricing.Description = last.Description;
            modelPricing.Id = last.Id;
            modelPricing.MaxSlots = last.MaxSlots;
            modelPricing.Price = last.Price;
            modelPricing.Name = last.Name;
            modelPricing.TicketSold = last.TicketSold;
            modelPricing.IsNew = false;
        }

        return Task.CompletedTask;
    }

    private async Task ViewDetails(Pricing ticketPricing)
    {
        if (modalFeeBreakdown is not null)
        {
            modalTicketPricing.TicketPrice = ticketPricing.Price ?? 0m;
            modalTicketPricing.IsAbsorbFee = ticketPricing.AbsorbFees;
            await modalFeeBreakdown.Show();
        }
    }

    private async Task CloseDetails()
    {
        if (modalFeeBreakdown is not null)
        {
            await modalFeeBreakdown.Close(CloseReason.UserClosing);
        }
    }

    private async Task CloseErrorMessage()
    {
        await modalError.Close(CloseReason.UserClosing);
    }

    private decimal CalCulateBuyerTotal(Pricing ticketPrice)
    {
        decimal ticketPriceValue = ticketPrice.Price ?? 0m;
        ModalTicketPricing price = new ModalTicketPricing { IsAbsorbFee = ticketPrice.AbsorbFees, TicketPrice = ticketPriceValue };
        return price.SubTotal;
    }

    private string TimeToString(TimeSpan time)
    {
        return DateTime.Today.Add(time).ToString("hh:mmtt");
    }
    public class ModelData
    {
        public IList<ItemPrice> ItemPrices { get; set; } = new List<ItemPrice>();
        public int TicketSold { get; set; }
        public int IsLimit { get; set; } = 1;
        public int EventTicketLimit { get; set; }

        public class ItemPrice
        {
            public int Id { get; set; }
            public decimal? Price { get; set; }
            public int? MaxSlots { get; set; }
            public bool AbsorbFees { get; set; }
            public string Description { get; set; }
            public string Name { get; set; }
            public int TicketSold { get; set; }
            public bool Disabled { get; set; } = false;
        }
    }

    private class PricingList
    {
        public IList<Pricing> Pricings { get; set; } = new List<Pricing>();
    }

    public class Pricing
    {
        [Required(ErrorMessage = "The price field is mandatory.")]
        [Range(1, int.MaxValue, ErrorMessage = "The price field is mandatory.")]
        public decimal? Price { get; set; } = null;

        [Required(ErrorMessage = "The max slots field is mandatory.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please specify the maximum slot number.")]
        public int? MaxSlots { get; set; } = null;

        [Required(ErrorMessage = "The absorb fees field is mandatory.")]
        public bool AbsorbFees { get; set; }

        [Required(ErrorMessage = "The description field is mandatory.")]
        public string Description { get; set; }

        [Required(ErrorMessage = "The name field is mandatory.")]
        public string Name { get; set; }


        [Range(1, int.MaxValue, ErrorMessage = "Please specify max ticket per customer.")]
        public int EventTicketLimit { get; set; }
        public int IsLimit { get; set; } = 1;

        public int TicketSold { get; set; }

        // extras
        public bool IsOpen { get; set; } = false;
        public int Order { get; set; }
        public int TempId { get; set; }
        public bool IsNew { get; set; }
        public bool IsDeleted { get; set; } = false;
        public int Id { get; set; }
        public bool Valid
        {
            get
            {
                return !string.IsNullOrEmpty(Description) && Price > 0 && MaxSlots > 0;
            }
        }
    }

    private class ModalTicketPricing
    {
        public decimal TicketPrice { get; set; }
        public bool IsAbsorbFee { get; set; }
        public decimal ServiceFee
        {
            get
            {
                return (TicketPrice * 0.05m);
            }
        }

        public decimal HandlingFee
        {
            get
            {
                return 15;
            }
        }

        public decimal SubTotal
        {
            get
            {
                if (!IsAbsorbFee) return TicketPrice + ServiceFee + HandlingFee;
                return TicketPrice;
            }
        }

        public decimal PayoutAmount
        {
            get
            {
                if (!IsAbsorbFee) return TicketPrice;

                return SubTotal - ServiceFee - HandlingFee;
            }
        }
    }

    private record DayItem
    {
        public string Day { get; set; }
        public string Value { get; set; }
        public string DayString { get; set; }
        public bool Selected { get; set; }
    }

    public class ComponentSummary
    {
        public OteOnlineEvent.ModelData OnlineData { get; set; }
    }

    private async Task AddMoreTicketPrice()
    {
        if (pricingFormValidation is not null)
        {
            bool priceValid = await pricingFormValidation.ValidateAll();
            if (priceValid)
            {
                if (existingList.Pricings.Count == 0)
                {
                    modelPricing.TempId = 1;
                    if (modelPricing.IsDeleted)
                    {
                        modelPricing.Price = 0;
                        modelPricing.Name = string.Empty;
                        modelPricing.Description = string.Empty;
                        modelPricing.MaxSlots = 0;
                        modelPricing.IsNew = true;
                        modelPricing.IsDeleted = false;
                    }
                    else
                    {
                        existingList.Pricings.Add(modelPricing);
                    }
                }
                modelPricingList.Pricings = existingList.Pricings;
                int maxId = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.TempId) + 1;
                int order = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.Order) + 1;
                existingList.Pricings.Add(new Pricing { TempId = maxId, Order = order, IsNew = true });
                var last = existingList.Pricings.LastOrDefault();
                if (last is not null)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.TempId != last.TempId).ToList();
                    modelPricing = last;
                }
            }
        }
    }

    private async Task DeleteClick(Pricing price)
    {
        priceToDelete = price;
        //delete created online event if meron
        if (Summary is not null)
        {
            var onlineTicket = Summary.OnlineData.TicketInfos.Where(a => a.TicketRestriction == priceToDelete.Name).FirstOrDefault();
            if (onlineTicket is not null)
            {
                errorMessageAlert = "Ticket " + onlineTicket.TicketRestriction + " already contains information. Kindly remove the ticket information from the online event page in order to continue.";
                await modalError.Show();
                return;
            }
        }
        await confirmDialogRef.Open();
    }

    private async Task ConfirmDeleteChanged(bool value)
    {
        if (value)
        {
            modelPricingList.Pricings = existingList.Pricings;
            if (priceToDelete.TempId == 0)
            {
                modelPricingList.Pricings.Where(a => a.Id == priceToDelete.Id).FirstOrDefault().IsDeleted = true;
                var deleteTicket = await activityApiHandler.DeleteTicket(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteTicketArgs
                    {
                        Id = priceToDelete.Id
                    }, Token);
                if (deleteTicket.Result != null && deleteTicket.Result.IsSuccess)
                {
                    existingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                    var last = existingList.Pricings.LastOrDefault();
                    if (last is not null)
                    {
                        modelPricingList.Pricings = existingList.Pricings.Where(p => p.Id != last.Id).ToList();
                        modelPricing = last;
                    }
                    else
                    {
                        AddMoreTicketPrice();
                    }
                }
            }
            else
            {
                modelPricingList.Pricings.Where(a => a.TempId == priceToDelete.TempId).FirstOrDefault().IsDeleted = true;
                existingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                var last = existingList.Pricings.LastOrDefault();
                if (last is not null && last.TempId != 0)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.TempId != last.TempId).ToList();
                    modelPricing = last;
                }
                else if (last is not null && last.TempId == 0)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.Id != last.Id).ToList();
                    modelPricing = last;
                }
                else
                {
                    existingList.Pricings.Clear();
                    AddMoreTicketPrice();
                }
            }
        }
    }

   

    private async Task CheckLimitChanged(int type)
    {
        ModelState.IsLimit = type;
        if (type == 1)
        {
            ModelState.EventTicketLimit = 0;
        }
        StateHasChanged();
    }
}
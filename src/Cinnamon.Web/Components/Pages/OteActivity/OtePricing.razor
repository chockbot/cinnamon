            IsOpen           = ModelState.IsOpen,
            IsCapacity       = ModelState.IsCapacity,
            CapacityCount    = ModelState.CapacityCount,
            ItemPrices = modelPricingList.Pricings.Select(p =>
            {
                return new ModelData.ItemPrice
                {
                    AbsorbFees       = p.AbsorbFees,
                    MaxSlots         = p.MaxSlots,
                    Price            = p.Price,
                    Description      = p.Description,
                    Id               = p.Id,
                    Name             = p.Name,
                    TicketSold       = p.TicketSold,
                    RequiredApproval = p.RequiredApproval,
                    IsUnlimited      = p.IsUnlimited,
                    ReserveSeatUuid  = p.ReserveSeatUuid
                };
            }).ToList(),
            CustomAcceptedBody = customAcceptedMessageOrig,
            CustomDeclinedBody = customDeclinedMesasgeOrig,
            CustomPendingBody = customPendingMessageOrig,
            NewQuestions = questions.Where(q => q.IsNew).ToList(),
            UpdatedQuestions = questions.Where(q => !q.IsNew).ToList(),
            DeletedQuestions = deletedQuestions.Select(q => q.Id).ToList()
        };
        return data;
    }

    public Task SetState(ModelData data)
    {
        foreach (var item in data.ItemPrices)
        {
            modelPricingList.Pricings.Add(new Pricing
                {
                    AbsorbFees       = item.AbsorbFees,
                    Description      = item.Description,
                    Id               = item.Id,
                    MaxSlots         = item.MaxSlots,
                    Price            = item.Price,
                    Name             = item.Name,
                    TicketSold       = item.TicketSold,
                    RequiredApproval = item.RequiredApproval,
                    IsUnlimited      = item.IsUnlimited,
                    IsFree           = item.IsFree
                });
        }
        customAcceptedMessageOrig = data.CustomAcceptedBody;
        customDeclinedMesasgeOrig = data.CustomDeclinedBody;
        customPendingMessageOrig = data.CustomPendingBody;

        customAcceptedMessage = data.CustomAcceptedBody;
        customDeclinedMesasge = data.CustomDeclinedBody;
        customPendingMessage = data.CustomPendingBody;

        if(data.UpdatedQuestions is not null && data.UpdatedQuestions.Count > 0)
        {
            questions.AddRange(data.UpdatedQuestions.Select(q => new CustomQuestion {
                FieldType = q.FieldType,
                Question = q.Question,
                Required = q.Required,
                Id = q.Id
            }));
        }

        SetPredefinedQuestionState();

        return Task.CompletedTask;
    }


    private void onClickMenu(int ticketId)
    {
        if (activeMenuId == ticketId)
        {
            activeMenuId = null; // Close the menu if it's already open
        }
        else
        {
            activeMenuId = ticketId; // Open the menu for the clicked ticket
        }
    }

    private string ShowMenu(int ticketId)
    {
        return activeMenuId == ticketId ? "show" : "";
    }

    private async Task EditClick(Pricing pricing)
    {
        if(pricing.TicketSold > 0)
        {
             await NotificationService.Info("This ticket has already been purchased; other details cannot be edited. You can only edit the ticket name and quantity.", "Information");
        }
        await OnEditTicket(pricing);
    }

    private async Task OnEditTicket(Pricing ticket)
    {
        modelPricing = new Pricing
            {
                Id               = ticket.Id,
                Name             = ticket.Name,
                Price            = ticket.Price,
                MaxSlots         = ticket.MaxSlots,
                AbsorbFees       = ticket.AbsorbFees,
                IsNew            = ticket.IsNew,
                TempId           = ticket.TempId,
                TicketSold       = ticket.TicketSold,
                RequiredApproval = ticket.RequiredApproval,
                IsUnlimited      = ticket.IsUnlimited,
                IsFree           = ticket.IsFree
            };
        isEditing = true;
        await ticketModal.Show();
    }
    private async Task OnCancelEdit()
    {
        await ticketModal.Hide();
        pricingFormValidation.ClearAll();
        isEditing = false;
        modelPricing = new Pricing();
    }


@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Framework.ValidationAttributes;
@using Cinnamon.Framework.Extensions.String;
@using Cinnamon.Framework.Helpers;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject INotificationService NotificationService
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime JS
@inject Cinnamon.Framework.Providers.IJsonSerializationProvider jsonSerializationProvider
@implements IOteComponent
@implements IAsyncDisposable

<section class="ote-pricing-wrapper">
    @*Ticket Limit*@
    <div class="border-radius-10 bg-white-200 p-4 m-padding-2 m-margin-top-30">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div id="error-message-container" class="mb-4 invalid is-invalid">
                <ul id="error-list" class="fw-bold mb-0">
                    @((MarkupString)errorMessage)
                </ul>
            </div>
        }
        <Field>
            <FieldLabel>
                <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                    Max Ticket per Customer
                </h3>
            </FieldLabel>
            <div class="ticket-limit-group">
                <FieldBody>
                    <RadioGroup TValue="int" Name="limit-type" CheckedValue="ModelState.IsLimit" CheckedValueChanged="CheckLimitChanged">
                        <label for="no-limit" class="border-radius-10 prevent-select py-2 text-capitalize cursor-pointer">
                            <Radio class="checkbox-round" ElementId="no-limit" TValue="int" Value="1">No Limit</Radio>
                        </label>
                        <label for="set-limit" class="border-radius-10 label-set-limit">
                            <Radio class="checkbox-round" ElementId="set-limit" TValue="int" Value="2">Set Limit</Radio>
                        </label>
                    </RadioGroup>
                    @if (ModelState.IsLimit == 2)
                    {
                        <label for="specify-limit" class="border-radius-10 prevent-select px-3 py-2 specific-text">Specify:</label>
                        <NumericPicker ElementId="specify-limit" Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium" class="@LimitClass" @bind-Value="ModelState.EventTicketLimit">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </NumericPicker>
                    }
                </FieldBody>
            </div>
        </Field>
    </div>
    <div class="mt-3 border-radius-10 bg-white-200 p-4 m-padding-2 m-margin-top-30">
        <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
            Tickets
        </h3>
        <p class="sub-text">Note: If tickets have already been purchased, users cannot delete or update other ticket details. You can only update the ticket name and total ticket quantity.</p>
        <div class="ticket-options">
            <div class="div-option-details email-box" id="hoverDiv" @onclick="() => registrationModal.Show()">
                <img class="option-img image-holder" src="images/ote/registration.png" alt="cover-photo">
                <div class="option-name text-box">
                    <p class="registration">Registration</p>
                    <p class="reg-status">@((ModelState.IsOpen == true) ? "Open" : "Closed")</p>
                </div>
                <div class="effect hover1"></div>
            </div>
            <div class="div-option-details email-box" id="hoverDiv" @onclick="() => capacityModal.Show()">
                <img class="option-img image-holder" src="images/ote/capacity.png" alt="cover-photo">
                <div class="option-name text-box">
                    <p class="registration">Waitlist Capacity</p>
                    <p class="reg-status">@((ModelState.IsCapacity == true) ? $"{ModelState.CapacityCount}" : "Off") &#x2022; Waitlist</p>
                </div>
                <div class="effect hover2"></div>
            </div>
            <div class="div-option-details email-box" id="hoverDiv" @onclick="ShowAddTicketModal">
                <img class="option-img image-holder" src="images/ote/add.png" alt="cover-photo">
                <div class="option-name text-box">
                    <p class="registration">Add Tickets</p>
                    <p class="reg-status">@modelPricingList.Pricings.Count() tickets available</p>
                </div>
                <div class="effect hover3"></div>
            </div>
        </div>
        <div class="ticket-section mt-3">
            @foreach (var ticket in modelPricingList.Pricings)
            {
                int ticketId = ticket.Id == 0 ? ticket.TempId : ticket.Id;
                <div class="ticket-box">
                    <div class="ticket-section-name">
                        <p class="ticket-title">@ticket.Name</p>
                        <div class="dropdown-mobile">
                            <button class="btn-menu " type="button" id="dropdownMenuButton-@ticketId" data-bs-toggle="dropdown"
                                    aria-expanded="false" border="none" @onclick="() => onClickMenu(ticketId)">
                                <div class="menu">
                                    <img src="images/ote/dots.png">
                                </div>
                            </button>
                            <ul class="dropdown-menu @ShowMenu(ticketId)" aria-labelledby="dropdownMenuButton-@ticketId">
                                <li class="dropdown-item" @onclick="() => EditClick(ticket)">
                                    Edit
                                </li>
                                <li class="dropdown-item" @onclick="() => DeleteClick(ticket)">
                                    Delete
                                </li>
                            </ul>
                        </div>
                    </div>
                    <p class="ticket-price">
                        @((ticket.Price == 0) ? "Free" : $"₱{ticket.Price:N0}")
                    </p>
                    <div class="d-flex justify-content-between">
                        <div class="approval-section">
                            <p class="approval">Required Approval</p>
                            <Tooltip Text="If enabled, guests need to be manually approved before receiving their tickets." Multiline>
                                <img class="info-img" src="images/Dashboard/info.png" alt="cover-photo">
                            </Tooltip>
                        </div>
                        <div class="form-check form-switch">
                            <Switch @bind-Checked="ticket.RequiredApproval" TValue="bool" class="form-check-input" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="mt-3 border-radius-10 bg-white-200 p-4 m-padding-2 m-margin-top-30 registration-section">
        <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
            Registration Emails
        </h3>
        <p class="sub-text">
            Customize the emails sent when a guest registers for the event and for when you approve or decline their registration.
        </p>

        <Row HorizontalGutter="10" class="mb-4">
            <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is1.OnY">
                <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" id="hoverDiv" 
                    @onclick="OnPendingEmailTemplateClick">
                    <div class="d-flex align-items-center mb-2 text-box">
                        <img class="me-2 image-holder" src="images/ote/tiny-clock.png" alt="clock">
                        <p class="font-16 color-grey-100 mb-0">Pending Approval</p>
                    </div>
                    <div class="line-effect div-line mb-1"></div>
                    <div class="line-effect div-line-75 mb-2"></div>
                    @if(string.IsNullOrEmpty(customPendingMessageOrig))
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-red me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0 text-box">No message yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-green me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">Message already set</p>
                        </div>
                    }
                    <div class="effect hover4"></div>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is1.OnY">
                <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" id="hoverDiv"
                    @onclick="OnAcceptedTemplateClick">
                    <div class="d-flex align-items-center mb-2 text-box">
                        <img class="me-2" src="images/ote/tiny-check.png" alt="check">
                        <p class="font-16 color-grey-100 mb-0">Going</p>
                    </div>
                    <div class="line-effect div-line mb-1"></div>
                    <div class="line-effect div-line-75 mb-2"></div>
                    @if(string.IsNullOrEmpty(customAcceptedMessageOrig))
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-red me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">No message yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-green me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">Message already set</p>
                        </div>
                    }
                    <div class="effect hover5"></div>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is1.OnY">
                <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" id="hoverDiv"
                    @onclick="OnDeclinedTemplateClick">
                    <div class="d-flex align-items-center mb-2 text-box">
                        <img class="me-2" src="images/ote/tiny-close.png" alt="close">
                        <p class="font-16 color-grey-100 mb-0">Declined</p>
                    </div>
                    <div class="line-effect div-line mb-1"></div>
                    <div class="line-effect div-line-75 mb-2"></div>
                    @if(string.IsNullOrEmpty(customDeclinedMesasgeOrig))
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-red me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">No message yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-green me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">Message already set</p>
                        </div>
                    }
                    <div class="effect hover6"></div>
                </div>
            </Column>
        </Row>

        <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
            Registration Questions
        </h3>
        <p class="sub-text mb-4">
            We will ask guests the following questions when they register for the event.
        </p>

        <Row class="align-items-center mb-2">
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <label for="">Name</label>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <Dropdown Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center">
                        <DropdownToggle Size="Size.Small">
                            @nameQuestion
                        </DropdownToggle>
                        <DropdownMenu class="border-radius-10 mt-1">
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Name", "Off")'>Off</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Name", "Optional")'>Optional</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Name", "Required")'>Required</DropdownItem>
                        </DropdownMenu>
                    </Dropdown>
                </div>
            </Column>
        </Row>
        <Row class="align-items-center mb-2">
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <label for="">Email Address</label>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <Dropdown Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center">
                        <DropdownToggle Size="Size.Small">
                            @emailQuestion
                        </DropdownToggle>
                        <DropdownMenu class="border-radius-10 mt-1">
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Email", "Off")'>Off</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Email", "Optional")'>Optional</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Email", "Required")'>Required</DropdownItem>
                        </DropdownMenu>
                    </Dropdown>
                </div>
            </Column>
        </Row>
        <Row class="align-items-center mb-4">
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <label for="">Phone Number</label>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
                <div>
                    <Dropdown Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center">
                        <DropdownToggle Size="Size.Small">
                            @phoneQuestion
                        </DropdownToggle>
                        <DropdownMenu class="border-radius-10 mt-1">
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Phone", "Off")'>Off</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Phone", "Optional")'>Optional</DropdownItem>
                            <DropdownItem Clicked='() => SetPredefinedQuestion("##Phone", "Required")'>Required</DropdownItem>
                        </DropdownMenu>
                    </Dropdown>
                </div>
            </Column>
        </Row>

        <div>
            <Button Clicked="CreateQuestion" class="color-green-100 bg-white-100 font-16 mb-3 btn-question">
                + <span class="ms-2">Add Questions</span>
            </Button>

            @foreach (var question in FilteredQuestions)
            {
                <div @key="question" class="bg-white-100 mb-2 p-3 border-radius-10 d-flex justify-content-between align-items-center">
                    <p class="font-16 color-grey-100 mb-0">
                        @question.Question
                    </p>
                    <div class="ms-3 d-flex">
                        <Button class="p-0" Clicked="() => UpdateQuestion(question)">
                            <img src="images/ote/blue-small-edit.png" alt="edit">
                        </Button>
                        <Button class="p-0" Clicked="() => RemoveQuestion(question)">
                            <img src="images/ote/red-small-delete.png" alt="delete">
                        </Button>
                    </div>
                </div>
            }
        </div>
    </div>

    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>

<!--- custom question modal !-->
<Modal @ref="modalCustomQuestion">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            @if(questionAction == QuestionAction.Edit)
            {
                <p class="font-20 font-weight-700 color-black-100 mb-0">Edit Question</p>
            }
            else
            {
                <p class="font-20 font-weight-700 color-black-100 mb-0">Add Question</p>
            }
        </ModalHeader>
        <ModalBody class="px-4">
            <Field class="mb-3">
                <FieldLabel class="color-grey-100 mb-0">Question</FieldLabel>
                <FieldBody>
                    <MemoEdit @bind-Text="formQuestion.Question" Rows="5" />
                </FieldBody>
            </Field>
            <div class="d-flex">
                <label class="color-black-100 font-weight-700 me-3">Required</label>
                <div class="form-check form-switch">
                    <Switch class="form-check-input" @bind-Checked="formQuestion.Required" TValue="bool" />
                </div>
            </div>
        </ModalBody>
        <ModalFooter>
            <div class="button-footer">
                <Button class="btn-cancel" Clicked="CloseCustomQuestion">
                    Cancel
                </Button>
                <Button class="btn-save" Clicked="SaveQuestion">
                    Save
                </Button>
            </div>
        </ModalFooter>
    </ModalContent>
    </Modal>

    @*Registration Modal*@
    <Modal @ref="registrationModal">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <p class="font-20 font-weight-700 color-black-100 mb-0">Registration</p>
        </ModalHeader>
        <ModalBody class="px-4">
            <p class="approval-text">Close registration to stop accepting new guests or stop selling tickets. Please note that capacity, availability and registration question settings apply when registration is open.</p>
            <div class="accept-reg">
                <p class="approval">Accept Registration</p>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@(ModelState.IsOpen)" @onchange="((e) => CheckRegistration(e))">
                </div>
            </div>
        </ModalBody>
        <ModalFooter>
            <div class="button-footer">
                <Button class="btn-cancel" @onclick="() => registrationModal.Hide()">
                    Cancel
                </Button>
                <Button class="btn-save" @onclick="() => registrationModal.Hide()">
                    Save
                </Button>
            </div>
        </ModalFooter>
    </ModalContent>
    </Modal>

    <Offcanvas @ref="offcanvas" Closing="OffCanvasClosing" ShowBackdrop Placement="Placement.End">
    <OffcanvasHeader class="px-0 py-4 bg-white-100">
        <div class="px-3 d-flex justify-content-between position-relative w-100">
            @if (selectedEmailTemplate == 0)
            {
                <img src="images/ote/tiny-clock.png" alt="clock">
            }
            @if (selectedEmailTemplate == 1)
            {
                <img src="images/ote/tiny-check.png" alt="check">
            }
            @if (selectedEmailTemplate == 2)
            {
                <img src="images/ote/tiny-close.png" alt="close">
            }
            <button class="btn-close" style="right: 0;" @onclick="CloseOffCanvas" />
        </div>
    </OffcanvasHeader>
    <OffcanvasBody class="px-0 pt-0">
        <Divider class="m-0" />
        <div class="p-3">
            @if (selectedEmailTemplate == 0)
            {
                <div id="pending-email-setup">
                    <p class="font-20 color-black-100 font-weight-900 mb-1">Pending Approval / Waitlist Email</p>
                    <p class="font-16 color-grey-100 mb-4">
                        This email is sent when a guest registers for the event, notifying them that their registration is
                        pending approval or that they are on the waitlist.
                    </p>
                    <div class="white-bg-shadow p-3 border-radius-10">
                        <p class="font-16 color-black-100 font-weight-700">Registration pending approval for the event</p>
                        <MemoEdit @bind-Text="customPendingMessage" Rows="7" class="mb-1" Placeholder="Add custom message here..." />
                    </div>
                </div>
            }

            @if (selectedEmailTemplate == 1)
            {
                <div id="accepted-email-setup">
                    <p class="font-20 color-black-100 font-weight-900 mb-1">Confirmation Email</p>
                    <p class="font-16 color-grey-100 mb-4">
                        This email is sent when a guest registers or when you approve a guest who is pending approval.
                    </p>
                    <div class="white-bg-shadow p-3 border-radius-10">
                        <p class="font-16 color-black-100 font-weight-700">Registration confirmed for the event</p>
                        <MemoEdit @bind-Text="customAcceptedMessage" Rows="7" class="mb-1" Placeholder="Add custom message here..." />
                    </div>
                </div>
            }

            @if (selectedEmailTemplate == 2)
            {
                <div id="declined-email-setup">
                    <p class="font-20 color-black-100 font-weight-900 mb-1">Declined Email</p>
                    <p class="font-16 color-grey-100 mb-4">
                        This email is sent when you decline a guest who is pending approval or on the waitlist.
                    </p>
                    <div class="white-bg-shadow p-3 border-radius-10">
                        <p class="font-16 color-black-100 font-weight-700">Registration not accepted for the event</p>
                        <MemoEdit Rows="7" @bind-Text="customDeclinedMesasge" class="mb-1" Placeholder="Add custom message here..." />
                    </div>
                </div>
            }
        </div>
    </OffcanvasBody>
    <OffcanvasFooter>
        <div class="w-100">
            <Divider />
            <Button Clicked="OnOffCanvasSave" class="bg-orange-100 color-white-100 px-4 me-2">
                Save
            </Button>
            <Button Clicked="OnOffCanvasCancel" class="bg-grey-300 color-black-200">
                Cancel
            </Button>
        </div>
    </OffcanvasFooter>
</Offcanvas>

@*Capacity Modal*@
<Modal @ref="capacityModal">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <p class="font-20 font-weight-700 color-black-100 mb-0">Waitlist</p>
        </ModalHeader>
        <ModalBody class="px-4">
            <p class="approval-text">When turned on, customers can join the waitlist up to the number indicated below.</p>
            <p class="field-title">Number of waitlist slot</p>
            <NumericPicker Placeholder="0" ShowStepButtons="false" TValue="int" class="capacity-input" @bind-Value="ModelState.CapacityCount" Disabled="!ModelState.IsCapacity"></NumericPicker>
            <div class="accept-capacity">
                <p class="approval">Waitlist</p>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@(ModelState.IsCapacity)" @onchange="((e) => CheckCapacity(e))">
                </div>
            </div>
        </ModalBody>
        <ModalFooter>
            <div class="button-footer">
                <Button class="btn-cancel" @onclick="() => capacityModal.Hide()">
                    Cancel
                </Button>
                <Button class="btn-save" @onclick="() => capacityModal.Hide()">
                    Save
                </Button>
            </div>
        </ModalFooter>
    </ModalContent>
    </Modal>

    @*Add Ticket Modal*@
<Modal @ref="ticketModal">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <p class="font-20 font-weight-700 color-black-100 mb-0">@((isEditing ? "Edit" : "Add") + " your Ticket")</p>
        </ModalHeader>
        <ModalBody class="px-4">
            <Validations @ref="pricingFormValidation" Mode="FormMode" Model="modelPricing">
                <Validation>
                    <Field class="mb-4">
                        <FieldLabel class="font-16 text-capitalize color-black-100 mb-1 m-font-16">
                            ticket name
                        </FieldLabel>
                        <FieldBody>
                            <TextEdit class="font-16 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Name">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </FieldBody>
                    </Field>
                </Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-16 text-capitalize color-black-100 mb-1 m-font-16">
                        Ticket Type
                    </FieldLabel>
                    <FieldBody>
                        @if(modelPricing.TicketSold > 0)
                        {
                            <label id="@modelPricing.Id" class="switch-light switch-candy">
                                <input type="checkbox" checked=@(!modelPricing.IsFree) @onchange="CheckboxChanged" disabled>
                                <span>
                                    <span>Free</span>
                                    <span>Paid</span>
                                    <a></a>
                                </span>
                            </label>
                        }
                        else
                        {
                            <label id="@modelPricing.Id" class="switch-light switch-candy" onclick="">
                                <input type="checkbox" checked=@(!modelPricing.IsFree) @onchange="CheckboxChanged">
                                <span>
                                    <span>Free</span>
                                    <span>Paid</span>
                                    <a></a>
                                </span>
                            </label>
                        }
                        
                    </FieldBody>
                </Field>
                <Row VerticalGutter="10">
                    <Column ColumnSize="ColumnSize.Is7">
                        <Validation @ref="price">
                            <Field>
                                <FieldLabel class="font-16 text-capitalize color-black-100 mb-1 m-font-16">
                                    price
                                </FieldLabel>
                                <FieldBody>
                                    @if (modelPricing.TicketSold > 0)
                                    {
                                        <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="decimal?" Size="Size.Medium"
                                                       class="font-16 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.Price" Disabled>
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    }
                                    else
                                    {
                                        <NumericPicker Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="decimal?" Size="Size.Medium"
                                                       class="font-16 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.Price" @onkeyup="PriceChanged" Disabled=@modelPricing.IsFree>
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    }
                                    
                                    @if (!modelPricing.IsFree)
                                    {
                                        <span class="font-14 font-weight-700 color-#343D4C-100">
                                            Buyer total: ₱ @(CalCulateBuyerTotal(modelPricing).ToString("#,##0.00"))
                                        </span>
                                    }
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is5">
                        <Validation @ref="maxSlotValidation">
                            <Field>
                                <FieldLabel class="font-16 text-capitalize color-black-100 mb-1 m-font-16">
                                    Total Ticket Qty.
                                </FieldLabel>
                                <FieldBody>

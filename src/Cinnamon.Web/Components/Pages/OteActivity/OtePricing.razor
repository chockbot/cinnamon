    private async Task AddMoreTicketPrice()
    {
        if (pricingFormValidation is not null)
        {
            bool priceValid = await pricingFormValidation.ValidateAll();
            if (priceValid)
            {
                if (isEditing)
                {
                    if (!modelPricing.IsNew)
                    {
                        var existingTicket = modelPricingList.Pricings.FirstOrDefault(t => t.Id == modelPricing.Id);
                        if (existingTicket != null)
                        {
                            existingTicket.Name = modelPricing.Name;
                            existingTicket.Price = modelPricing.Price;
                            existingTicket.MaxSlots = modelPricing.MaxSlots;
                            existingTicket.AbsorbFees = modelPricing.AbsorbFees;
                            existingTicket.RequiredApproval = modelPricing.RequiredApproval;
                            existingTicket.IsUnlimited = modelPricing.IsUnlimited;
                            existingTicket.IsFree = modelPricing.IsFree;
                            await ticketModal.Hide();
                            isEditing = false;
                            modelPricing = new Pricing();
                            pricingFormValidation.ClearAll();
                        }
                    }
                    else
                    {
                        var existingTicket = modelPricingList.Pricings.FirstOrDefault(t => t.TempId == modelPricing.TempId);
                        if (existingTicket != null)
                        {
                            existingTicket.Name = modelPricing.Name;
                            existingTicket.Price = modelPricing.Price;
                            existingTicket.MaxSlots = modelPricing.MaxSlots;
                            existingTicket.AbsorbFees = modelPricing.AbsorbFees;
                            existingTicket.RequiredApproval = modelPricing.RequiredApproval;
                            existingTicket.IsUnlimited = modelPricing.IsUnlimited;
                            existingTicket.IsFree = modelPricing.IsFree;
                            await ticketModal.Hide();
                            isEditing = false;
                            modelPricing = new Pricing();
                            pricingFormValidation.ClearAll();
                        }
                    }

                }
                else
                {
                    int maxId = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.TempId) + 1;
                    int order = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.Order) + 1;
                    modelPricing.TempId = maxId;
                    modelPricing.Order = order;
                    modelPricing.IsNew = true;
                    modelPricing.IsFree = true;
                    modelPricingList.Pricings.Add(modelPricing);
                    await ticketModal.Hide();
                    modelPricing = new Pricing();
                    pricingFormValidation.ClearAll();
                }
            }
        }
    }

    private async Task DeleteClick(Pricing price)
    {
        priceToDelete = price;
        if (price.TicketSold > 0)
        {
            await NotificationService.Info("This ticket has already been purchased; details cannot be deleted. You can only edit the ticket name and quantity.", "Information");
            await OnEditTicket(price);
            return;
        }
        //delete created online event if meron
        if (Summary is not null)
        {
            var onlineTicket = Summary.OnlineData.TicketInfos.Where(a => a.TicketRestriction == priceToDelete.Name).FirstOrDefault();
            if (onlineTicket is not null)
            {
                await NotificationService.Info("Ticket " + onlineTicket.TicketRestriction + " already contains information. Kindly remove the ticket information from the online event page in order to continue.", "Information");
                return;
            }
        }
        await confirmDialogRef.Open();
    }

    private async Task ConfirmDeleteChanged(bool value)
    {
        if (value)
        {
            if (priceToDelete.TempId == 0)
            {
                modelPricingList.Pricings.Where(a => a.Id == priceToDelete.Id).FirstOrDefault().IsDeleted = true;
                var deleteTicket = await activityApiHandler.DeleteTicket(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteTicketArgs
                    {
                        Id = priceToDelete.Id
                    }, Token);
                if (deleteTicket.Result != null && deleteTicket.Result.IsSuccess)
                {
                    modelPricingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                }
            }
            else
            {
                modelPricingList.Pricings.Where(a => a.TempId == priceToDelete.TempId).FirstOrDefault().IsDeleted = true;
                modelPricingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
            }
        }
    }

    private async Task CheckLimitChanged(int type)
    {
        ModelState.IsLimit = type;
        if (type == 1)

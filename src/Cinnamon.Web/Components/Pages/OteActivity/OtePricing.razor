    private async Task SetOverrideDates()
    {
        if(calendar is null) return;

        var dates = calendar.GetClickedDates;
        foreach(var date in dates)
        {
            if(dateOverrides.ContainsKey(date.Date))
            {
                dateOverrides[date.Date].TimeStart = modelSchedule.TimeStart;
                dateOverrides[date.Date].TimeEnd = modelSchedule.TimeEnd;
            }
            else 
            {
                dateOverrides.Add(date.Date, new DateOverride {
                    Date = date.Date,
                    TimeEnd = modelSchedule.TimeEnd,
                    TimeStart = modelSchedule.TimeStart
                });
            }
        }

        await CloseCalendar();
    }


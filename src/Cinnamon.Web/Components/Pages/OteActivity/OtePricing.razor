    private async Task DeleteClick(Pricing price)
    {
        priceToDelete = price;
        //delete created online event if meron
        if (Summary is not null)
        {
            var onlineTicket = Summary.OnlineData.TicketInfos.Where(a => a.TicketRestriction == priceToDelete.Name).FirstOrDefault();
            if (onlineTicket is not null)
            {
                errorMessageAlert = "Ticket " + onlineTicket.TicketRestriction + " already contains information. Kindly remove the ticket information from the online event page in order to continue.";
                await modalError.Show();
                return;
            }
        }
        await confirmDialogRef.Open();
    }

    private async Task ConfirmDeleteChanged(bool value)
    {
        if (value)
        {
            modelPricingList.Pricings = existingList.Pricings;
            if (priceToDelete.TempId == 0)
            {
                modelPricingList.Pricings.Where(a => a.Id == priceToDelete.Id).FirstOrDefault().IsDeleted = true;
                var deleteTicket = await activityApiHandler.DeleteTicket(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteTicketArgs
                    {
                        Id = priceToDelete.Id
                    }, Token);
                if (deleteTicket.Result != null && deleteTicket.Result.IsSuccess)
                {
                    existingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                    var last = existingList.Pricings.LastOrDefault();
                    if (last is not null)
                    {
                        modelPricingList.Pricings = existingList.Pricings.Where(p => p.Id != last.Id).ToList();
                        modelPricing = last;
                    }
                    else
                    {
                        AddMoreTicketPrice();
                    }
                }
            }
            else
            {
                modelPricingList.Pricings.Where(a => a.TempId == priceToDelete.TempId).FirstOrDefault().IsDeleted = true;
                existingList.Pricings = modelPricingList.Pricings.Where(a => !a.IsDeleted).OrderBy(a => a.Order).ToList();
                var last = existingList.Pricings.LastOrDefault();
                if (last is not null && last.TempId != 0)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.TempId != last.TempId).ToList();
                    modelPricing = last;
                }
                else if (last is not null && last.TempId == 0)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.Id != last.Id).ToList();
                    modelPricing = last;
                }
                else
                {
                    existingList.Pricings.Clear();
                    AddMoreTicketPrice();
                }
            }
        }
    }

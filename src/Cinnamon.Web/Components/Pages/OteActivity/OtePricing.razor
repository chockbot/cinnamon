    private async Task AddMoreTicketPrice()
    {
        if (pricingFormValidation is not null)
        {
            bool priceValid = await pricingFormValidation.ValidateAll();
            if (priceValid)
            {
                if (existingList.Pricings.Count == 0)
                {
                    modelPricing.TempId = 1;
                    if (modelPricing.IsDeleted)
                    {
                        modelPricing.Price = 0;
                        modelPricing.Name = string.Empty;
                        modelPricing.Description = string.Empty;
                        modelPricing.MaxSlots = 0;
                        modelPricing.IsNew = true;
                        modelPricing.IsDeleted = false;
                    }
                    else
                    {
                        existingList.Pricings.Add(modelPricing);
                        return;
                    }
                }
                modelPricingList.Pricings = existingList.Pricings;
                int maxId = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.TempId) + 1;
                int order = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.Order) + 1;
                existingList.Pricings.Add(new Pricing { TempId = maxId, Order = order, IsNew = true });
                var last = existingList.Pricings.LastOrDefault();
                if (last is not null)
                {
                    modelPricingList.Pricings = existingList.Pricings.Where(p => p.TempId != last.TempId).ToList();
                    modelPricing = last;
                }
            }
        }
    }

    private async Task CheckLimitChanged(int type)

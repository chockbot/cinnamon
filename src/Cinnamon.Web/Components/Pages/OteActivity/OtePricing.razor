    private Task GenerateEventDates()
    {
        var every = ModelState.DurationEvery;
        var dateStart = ModelState.DurationStart;
        var dateEnd = ModelState.DurationEnd;

        var timeStart = ModelState.EventDurationTimeStart;
        var timeDuration = ModelState.DateTo - ModelState.DateFrom;

        string weekString = ModelState.Recurrences switch
        {
            "every-weekday" => "MON|TUE|WED|THU|FRI",
            "weekly" => string.Join("|", dayItems.Where(i => i.Selected).Select(i => i.Value)),
            _ => ""
        };

        var monthSelection = ModelState.MonthSelection;
        var onDayDate = ModelState.OnDayDate;
        var monthRepeat = ModelState.MonthRepeat;
        var monthDay = ModelState.MonthDay;

        generatedDates = ModelState.Recurrences switch {
            "every-weekday" => recurrenceHelper.GenerateWeekday(every, dateStart, dateEnd, timeDuration, timeStart),
            "daily" => recurrenceHelper.GenerateDaily(every, dateStart, dateEnd, timeDuration, timeStart),
            "weekly" => recurrenceHelper.GenerateWeekly(every, dateStart, dateEnd, timeDuration, timeStart, weekString),
            "monthly" => recurrenceHelper.GenerateMonthly(every, dateStart, dateEnd, timeDuration, timeStart, monthSelection, 
                onDayDate, monthRepeat, monthDay),
            _ => recurrenceHelper.GenerateNoRepeat(ModelState.DateFrom, ModelState.DateTo)
        };
        return Task.CompletedTask;
    }

    private async Task SetOverrideDates()
    {
        if (calendar is null) return;

        var dates = calendar.GetClickedDates;
        foreach (var date in dates)
        {
            if (dateOverrides.ContainsKey(date.Date))
            {
                dateOverrides[date.Date].TimeStart = ModelState.TimeStart;
                dateOverrides[date.Date].TimeEnd = ModelState.TimeEnd;
            }
            else
            {
                dateOverrides.Add(date.Date, new DateOverride
                    {
                        Date = date.Date,
                        TimeEnd = ModelState.TimeEnd,
                        TimeStart = ModelState.TimeStart
                    });
            }
        }

        await CloseCalendar();
    }


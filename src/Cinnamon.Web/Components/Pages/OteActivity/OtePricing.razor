    private string ScheduleMessageInfo 
    {
        get 
        {
            string durationStart = modelSchedule.DurationStart.ToString("MM/dd/yyyy");
            string durationEnd = modelSchedule.DurationEnd.ToString("MM/dd/yyyy");

            if(modelSchedule.Recurrences == "do-not-repeat")
            {
                return "Repeat only once.";
            }

            if(modelSchedule.Recurrences == "every-weekday")
            {
                if(modelSchedule.DurationEvery == 1)
                {
                    return $"Occurs every Monday through Friday until {durationEnd}.";
                }

                return $@"Occurs every {modelSchedule.DurationEvery} weeks on Monday, Tuesday, Wednesday, 
                    Thursday and Friday starting {durationStart} until {durationEnd}";
            }

            if(modelSchedule.Recurrences == "daily")
            {
                if(modelSchedule.DurationEvery == 1)
                {
                    return $"Occurs every day starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {modelSchedule.DurationEvery} days starting {durationStart} until {durationEnd}";
            }

            if(modelSchedule.Recurrences == "weekly")
            {
                var days = dayItems.Where(d => d.Selected).Select(d => d.DayString);
                string selectedDaysString = DayStrings(days);

                if(modelSchedule.DurationEvery == 1)
                {
                    return $"Occurs every {selectedDaysString} starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {modelSchedule.DurationEvery} weeks on {selectedDaysString} starting {durationStart} until {durationEnd}";
            }

            if(modelSchedule.Recurrences == "monthly")
            {
                string everyMonthString = modelSchedule.DurationEvery > 1 ? $"{modelSchedule.DurationEvery} months" : "month";

                if(modelSchedule.MonthSelection == 1)
                {
                    return $"Occurs every {everyMonthString} on day {modelSchedule.OnDayDate} starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {everyMonthString} on the {modelSchedule.MonthRepeat} {modelSchedule.MonthDay.Capitalize()} starting {durationStart} until {durationEnd}";
            }

            return string.Empty;
        }
    }

    private string DayStrings(IEnumerable<string> strings)
    {
        string dayString = string.Empty;
        if(strings.Count() > 1)
        {
            dayString = string.Join(", ", strings.Take(strings.Count() -1));
            dayString += " and " + strings.Last();
        }
        else 
        {
            dayString = strings.FirstOrDefault();
        }

        return dayString;
    }


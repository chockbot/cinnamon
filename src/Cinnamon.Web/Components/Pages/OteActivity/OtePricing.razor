@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Framework.ValidationAttributes;
@inject INotificationService NotificationService;
@inject IJSRuntime JS;
@implements IOteComponent;

<section class="ote-pricing-wrapper">
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        <div class="mb-4">
            <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                <span>
                    schedule
                </span>
                <span class="rounded-circle bg-orange-100 color-white-100 round-padding ms-2 m-d-none">4</span>
            </h3>
            <p class="font-16 color-grey-100 text-justify">
                Create your event schedule by selecting your preferred sessions and activities from the provided options.
            </p>
        </div>
        <Validations @ref="scheduleFormValidation" Mode="FormMode" Model="modelSchedule">
            <div class="data-form">
                <div id="ote-pricing-from-date" class="mb-2">
                    <label for="" class="text-capitalize font-20 color-black-100 m-font-18">from</label>
                    <div class="d-flex">
                        <div id="date-from" class="me-3 box-width date-left">
                            <Validation @ref="dateFromValidation">
                                <Field class="mb-3">
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium" 
                                            TValue="DateTime" @bind-Date="modelSchedule.DateFrom">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                        <div id="time-from" class="date-right">
                            <Field class="mb-3">
                                <FieldBody>
                                    <TimeEdit class='@TimeFromClass' Size="Size.Medium" TValue="TimeSpan" @bind-Time="modelSchedule.TimeFrom" />
                                </FieldBody>
                            </Field>
                        </div>
                    </div>
                </div>
                <div id="ote-pricing-to-date" class="mb-2">
                    <label for="" class="text-capitalize font-20 color-black-100 m-font-18">to</label>
                    <div class="d-flex">
                        <div id="date-to" class="me-3 box-width date-left">
                            <Validation @ref="dateToValidation">
                                <Field class="mb-3">
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium" 
                                            TValue="DateTime" @bind-Date="modelSchedule.DateTo">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                        <div id="time-to" class="date-right">
                            <Field class="mb-3">
                                <FieldBody>
                                    <TimeEdit class='@TimeToClass' Size="Size.Medium" TValue="TimeSpan" @bind-Time="modelSchedule.TimeTo" />
                                </FieldBody>
                            </Field>
                        </div>
                    </div>
                </div>
                <div class="box-width">
                    <Field class="mb-3">
                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                            recurrences
                        </FieldLabel>
                        <FieldBody>
                            <Select TValue="string" Size="Size.Medium" class="@RecurrencesClass" 
                                SelectedValueChanged="RecurrenceChanged">
                                <SelectItem Value='@("do-not-repeat")'>Do not repeat</SelectItem>
                                <SelectItem Value='@("every-weekday")'>Every weekday</SelectItem>
                                <SelectItem Value='@("daily")'>Daily</SelectItem>
                                <SelectItem Value='@("weekly")'>Weekly</SelectItem>
                                <SelectItem Value='@("monthly")'>Monthly</SelectItem>
                            </Select>
                            <div class="invalid-feedback">The recurrences field is mandatory.</div>
                        </FieldBody>
                    </Field>
                </div>
                @if(modelSchedule.Recurrences != "do-not-repeat")
                {
                    <div class="d-flex">
                        <div class="box-width me-3">
                            <Validation>
                                <Field>
                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                        start
                                    </FieldLabel>
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium" 
                                            TValue="DateTime" @bind-Date="modelSchedule.DurationStart">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                        <div class="box-width">
                            <Validation>
                                <Field>
                                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                        end
                                    </FieldLabel>
                                    <FieldBody>
                                        <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium" 
                                            TValue="DateTime" @bind-Date="modelSchedule.DurationEnd">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                    </div>

                    <div class="mt-4">
                        <Validation>
                            <Field>
                                <FieldLabel For="durationCount" class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                    repeat every
                                </FieldLabel>
                                <FieldBody>
                                    <div class="d-flex">
                                        <NumericPicker ElementId="durationCount" class="text-center me-3 border-radius-10 m-border-radius-5" 
                                            style="width: 90px;" Min="0" Size="Size.Medium" ShowStepButtons="false" Decimals="0" 
                                            TValue="int" @bind-Value="modelSchedule.DurationEvery">
                                        </NumericPicker>
                                        <Button Disabled class="bg-grey-200 px-4">
                                            @modelSchedule.RepeatEvery
                                        </Button>
                                    </div>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </div>

                    @if(modelSchedule.Recurrences == "every-weekday")
                    {
                        <div class="d-flex justify-content-center mt-4">
                            <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                            <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">M</span>
                            <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                            <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">W</span>
                            <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                            <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">F</span>
                            <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                        </div>
                    }

                    @if(modelSchedule.Recurrences == "weekly")
                    {
                        <div class="d-flex justify-content-center mt-4">
                            @foreach (var item in dayItems)
                            {
                                <span @key="item" class="@SetDayStyle(item.Selected)" @onclick="() => item.Selected = !item.Selected">@item.Day</span>   
                            }
                        </div>
                    }

                    @if(modelSchedule.Recurrences == "monthly")
                    {
                        <div class="mt-5">
                            <RadioGroup TValue="int" @bind-CheckedValue="modelSchedule.MonthSelection">
                                <Validation>
                                    <Field class="mb-3">
                                        <FieldBody>
                                            <div class="d-flex align-items-center">
                                                <label for="type-on-day" class="cursor-pointer">
                                                    <Radio class="checkbox-round cursor-pointer" ElementId="type-on-day" TValue="int" Value="1">On day</Radio>
                                                </label>
                                                <NumericPicker Disabled="modelSchedule.MonthSelection == 2" class="text-center ms-3 border-radius-10 m-border-radius-5" 
                                                    style="width: 90px;" Min="0" Size="Size.Medium" ShowStepButtons="false" Decimals="0" 
                                                    TValue="int" @bind-Value="modelSchedule.OnDayDate">
                                                </NumericPicker>
                                            </div>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                                <Field>
                                    <FieldBody>
                                        <div class="d-flex align-items-center">
                                            <label for="type-on-the" class="cursor-pointer">
                                                <Radio class="checkbox-round cursor-pointer" ElementId="type-on-the" TValue="int" Value="2">On the</Radio>
                                            </label>
                                            <div class="box-width ms-3">
                                                <Select Disabled="modelSchedule.MonthSelection == 1" TValue="string" Size="Size.Medium" 
                                                    class="form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5"
                                                    @bind-SelectedValue="modelSchedule.MonthRepeat">
                                                    <SelectItem Value='@("first")'>First</SelectItem>
                                                    <SelectItem Value='@("second")'>Second</SelectItem>
                                                    <SelectItem Value='@("third")'>Third</SelectItem>
                                                    <SelectItem Value='@("fourth")'>Fourth</SelectItem>
                                                    <SelectItem Value='@("last")'>Last</SelectItem>
                                                </Select>
                                            </div>
                                            <div class="box-width ms-3">
                                                <Select Disabled="modelSchedule.MonthSelection == 1" TValue="string" Size="Size.Medium" 
                                                    class="box-width form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5">
                                                    <SelectItem Value='@("sunday")'>Sunday</SelectItem>
                                                    <SelectItem Value='@("monday")'>Monday</SelectItem>
                                                    <SelectItem Value='@("tuesday")'>Tuesday</SelectItem>
                                                    <SelectItem Value='@("wednesday")'>Wednesday</SelectItem>
                                                    <SelectItem Value='@("thursday")'>Thursday</SelectItem>
                                                    <SelectItem Value='@("friday")'>Friday</SelectItem>
                                                    <SelectItem Value='@("saturday")'>Saturday</SelectItem>
                                                </Select>
                                            </div>
                                        </div>
                                    </FieldBody>
                                </Field>
                            </RadioGroup>
                        </div>
                    }
                }
            </div>
        </Validations>
    </div>
    <Divider class="d-none m-d-block" />
    <div class="my-3 border-radius-10">
        <Validations @ref="pringListFormValidation" Model="modelPricingList" Mode="ValidationMode.Auto">
            <div class="accordion" id="pricings-accordion">
                @foreach (var item in modelPricingList.Pricings)
                {
                    <div class="accordion-item" @key="item">
                        <h2 class="accordion-header">
                            <button style='@(!item.Valid ? "border: 1px solid #dc3545 !important;" : "")' 
                                class='@(item.Valid ? "accordion-button bg-white-200 font-20 m-font-16" : "accordion-button bg-white-200 font-20 m-font-16 is-invalid")' 
                                type="button" data-bs-toggle="collapse" data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                @($"{modelSchedule.DateFrom.ToString("MMM dd, yyyy")} | {modelSchedule.DateFrom.ToString("hh:mm tt")} | {item.Price.ToString("#,##0.00")}")
                            </button>
                        </h2>
                        <div id='@($"collapse-{item.Id}")' class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#pricings-accordion">
                        <div class="accordion-body bg-white-200">
                            <div class="item-form-body">
                                <Validation>
                                    <Field class="mb-4">
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            ticket name
                                        </FieldLabel>
                                        <FieldBody>
                                            <TextEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Name" >
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </TextEdit>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                                <Validation>
                                    <Field class="mb-4">
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            admission description
                                        </FieldLabel>
                                        <FieldBody>
                                            <MemoEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5" Rows="3" @bind-Text="item.Description" >
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </MemoEdit>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                                <Row VerticalGutter="10" class="mb-2">
                                    <Column ColumnSize="ColumnSize.Is7">
                                        <Validation>
                                            <Field>
                                                <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                    price
                                                </FieldLabel>
                                                <FieldBody>
                                                    <NumericPicker Decimals="0" ShowStepButtons="false" TValue="decimal" Size="Size.Medium" 
                                                        class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.Price">
                                                        <Feedback>
                                                            <ValidationError />
                                                        </Feedback>
                                                    </NumericPicker>
                                                </FieldBody>
                                            </Field>
                                        </Validation>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is5">
                                        <Validation>
                                            <Field>
                                                <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                                    max slots
                                                </FieldLabel>
                                                <FieldBody>
                                                    <NumericPicker Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium" 
                                                        class="font-18 border-radius-10 m-font-16 m-border-radius-5" @bind-Value="item.MaxSlots" >
                                                        <Feedback>
                                                            <ValidationError />
                                                        </Feedback>
                                                    </NumericPicker>
                                                </FieldBody>
                                            </Field>
                                        </Validation>
                                    </Column>
                                </Row>
                                <Row VerticalGutter="10" class="mb-4">
                                    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                                        <div class="d-flex justify-content-between mb-3">
                                            <span class="font-14 font-weight-700 color-orange-100">Buyer total: P 12.73</span>
                                            <span @onclick="() => ViewDetails(item)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                                                view details
                                            </span>
                                        </div>
                                        <div>
                                            <Check TValue="bool" Size="Size.Medium" @bind-Checked="item.AbsorbFees">
                                                Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                                            </Check>
                                        </div>
                                    </Column>
                                </Row>
                            </div>
                        </div>
                        </div>
                    </div>
                }
            </div>
        </Validations>
    </div>
    @if(modelPricingList.Pricings.Count > 0)
    {
        <Divider class="d-none m-d-block" />
    }
    <div class="border-radius-10 bg-white-200 p-4 my-3 m-bg-white-100 m-padding-0 m-margin-top-30">
        <div class="mb-4">
            <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                <span>
                    pricing
                </span>
                <span class="rounded-circle bg-orange-100 color-white-100 round-padding ms-2 m-d-none">5</span>
            </h3>
            <p class="font-16 color-grey-100 text-justify">
                Add your price range or your admission categories for every budget. From affordable offers to more premium experience. 
                Fill up prices and max slots for every category. 
            </p>
        </div>
        <Validations @ref="pricingFormValidation" Mode="FormMode" Model="modelPricing">
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        ticket name
                    </FieldLabel>
                    <FieldBody>
                        <TextEdit class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Name" >
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Validation>
                <Field class="mb-4">
                    <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                        admission description
                    </FieldLabel>
                    <FieldBody>
                        <MemoEdit class="font-18 border-radius-10 m-border-radius-5 m-font-16" Rows="3" @bind-Text="modelPricing.Description" >
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </MemoEdit>
                    </FieldBody>
                </Field>
            </Validation>
            <Row VerticalGutter="10">
                <Column ColumnSize="ColumnSize.Is7">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                price
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Decimals="0" ShowStepButtons="false" TValue="decimal" Size="Size.Medium" 
                                    class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.Price">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
                <Column ColumnSize="ColumnSize.Is5">
                    <Validation>
                        <Field>
                            <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                max slots
                            </FieldLabel>
                            <FieldBody>
                                <NumericPicker Decimals="0" ShowStepButtons="false" TValue="int" Size="Size.Medium" 
                                    class="font-18 border-radius-10 m-border-radius-5 m-font-16" @bind-Value="modelPricing.MaxSlots" >
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </NumericPicker>
                            </FieldBody>
                        </Field>
                    </Validation>
                </Column>
            </Row>
            <Row VerticalGutter="10" class="mb-4">
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="font-14 font-weight-700 color-orange-100">
                            Buyer total: ₱ @(CalCulateBuyerTotal(modelPricing).ToString("#,##0.00"))
                        </span>
                        <span @onclick="() => ViewDetails(modelPricing)" class="font-14 color-grey-100 text-decoration-underline cursor-pointer text-capitalize m-d-none">
                            view details
                        </span>
                    </div>
                    <div>
                        <Check TValue="bool" Size="Size.Medium" @bind-Checked="modelPricing.AbsorbFees">
                            Absorb Fees: Ticketing fees are deducted from your ticket revenue.
                        </Check>
                    </div>
                </Column>
            </Row>
            <div>
                <Button Clicked="AddMoreTicketPrice" class="bg-orange-100 color-white-100 text-capitalize font-20 hover-color-white px-5 border-radius-10 m-border-radius-5 m-width-100">
                    add more ticket price
                </Button>
            </div>
        </Validations>
    </div>
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />

    <Modal @ref="modalFeeBreakdown">
        <ModalContent Centered class="border-radius-15">
            <ModalHeader class="justify-content-center pb-0">
                <p class="font-20 font-weight-700 color-black-100 mb-0">Absorb Fees Breakdown</p>
                <button type="button" style="top: 22px; right: 20px;" class="btn-close position-absolute" @onclick="CloseDetails" />
            </ModalHeader>
            <ModalBody class="px-4">
                <div class="color-black-100">
                    <label class="font-weight-700 font-16 mb-2">Cost of Buyer</label>
                    <div class="mb-2 d-flex color-grey-100 justify-content-between">
                        <p class="mb-0">Ticket Price:</p>
                        <p class="mb-0">₱ @modalTicketPricing.TicketPrice.ToString("#,##0.00")</p>
                    </div>
                    <div class="mb-2 d-flex color-grey-100 justify-content-between">
                        <p class="mb-0">Service Fee:</p>
                        <p class="mb-0">₱ @modalTicketPricing.ServiceFee.ToString("#,##0.00")</p>
                    </div>
                    <div class="mb-2 d-flex color-grey-100 justify-content-between">
                        <p class="mb-0">Handling Fee:</p>
                        <p class="mb-0">₱ @modalTicketPricing.HandlingFee.ToString("#,##0.00")</p>
                    </div>
                    <div class="mb-2 d-flex font-weight-700 justify-content-between">
                        <p class="mb-0">Total:</p>
                        <p class="mb-0">₱ @modalTicketPricing.SubTotal.ToString("#,##0.00")</p>
                    </div>
                </div>
                <div class="color-black-100 mt-4">
                    <label class="font-weight-700 font-16 mb-1">Your Payout</label>
                    <div class="mb-2 d-flex color-grey-100 justify-content-between">
                        <p class="mb-0">Ticket Revenue:</p>
                        <p class="mb-0">₱ @modalTicketPricing.PayoutAmount.ToString("#,##0.00")</p>
                    </div>
                </div>
                <div class="color-grey-100 font-12 mt-4">
                    <p class="mb-0">Note: Service will may change depending on the payment method used.</p>
                    <p class="mb-0">E-wallet - 3%</p>
                    <p class="mb-0">Cards - 5%</p>
                </div>
            </ModalBody>
        </ModalContent>
    </Modal>
</section>

@code 
{
    [Parameter]
    public EventCallback OnNextClick {get; set;}

    [Parameter]
    public EventCallback OnPrevClick {get; set;}

    private Schedule modelSchedule = new();
    private Pricing modelPricing = new();
    private PricingList modelPricingList = new();
    private Validations? scheduleFormValidation;
    private Validations? pricingFormValidation;
    private Validations? pringListFormValidation;
    private Validation? dateFromValidation;
    private Validation? dateToValidation;
    private bool showErrors = false;
    private Modal? modalFeeBreakdown {get; set;}
    private ModalTicketPricing modalTicketPricing = new();
    private IList<DayItem> dayItems = new List<DayItem> {
        new DayItem { Day = "S", Value = "sunday"},
        new DayItem { Day = "M", Value = "monday"},
        new DayItem { Day = "T", Value = "tuesday", Selected = true},
        new DayItem { Day = "W", Value = "wednesday", Selected = true},
        new DayItem { Day = "T", Value = "thursday", Selected = true},
        new DayItem { Day = "F", Value = "friday"},
        new DayItem {Day = "S", Value = "saturday"}
    };

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }

    private async Task PrevClick()
    {
        if(OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    public async Task<bool> FieldValid()
    {
        if(pricingFormValidation is not null && scheduleFormValidation is not null && pricingFormValidation is not null)
        {
            bool pricingValid = await pricingFormValidation.ValidateAll();
            bool scheduleValid = await scheduleFormValidation.ValidateAll();
            bool pricingListValid = await pringListFormValidation.ValidateAll();
            bool valid = pricingValid && scheduleValid && pricingListValid;
            showErrors = true;
            StateHasChanged();
            await Task.Delay(300); // add delay to populate is-invalid class
            if(!valid)
            {
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-pricing-wrapper .is-invalid");
            }
            return valid;
        }
        return false;
    }

    private ValidationMode FormMode 
    {
        get 
        {
            return showErrors ? ValidationMode.Auto : ValidationMode.Manual;
        }
    }

    private string TimeFromClass
    {
        get
        {
            string defaultClass = "font-18 border-radius-10 m-font-16 m-border-radius-5";
            if(dateFromValidation is not null && showErrors)
            {
                if(dateFromValidation.Status == ValidationStatus.Error)
                {
                    return $"{defaultClass} is-invalid";
                }
                else 
                {
                    return $"{defaultClass} is-valid";
                }
            }
            return defaultClass;
        }
    }

    private string TimeToClass
    {
        get 
        {
            string defaultClass = "font-18 border-radius-10 m-font-16 m-border-radius-5";
            if(dateToValidation is not null && showErrors)
            {
                if(dateToValidation.Status == ValidationStatus.Error)
                {
                    return $"{defaultClass} is-invalid";
                }
                else 
                {
                    return $"{defaultClass} is-valid";
                }
            }
            return defaultClass; 
        }
    }

    private string RecurrencesClass
    {
        get
        {
            string defaultClass = "field-width form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5";
            if(showErrors)
            {
                if(string.IsNullOrEmpty(modelSchedule.Recurrences))
                {
                    return $"{defaultClass} is-invalid";
                }
                return $"{defaultClass} is-valid";
            }
            return defaultClass;
        }
    }

    private async Task AddMoreTicketPrice()
    {
        bool priceValid = await pricingFormValidation.ValidateAll();
        if(priceValid)
        {
            modelPricing.Id = modelPricingList.Pricings.Count + 1;
            modelPricingList.Pricings.Add(modelPricing);
            modelPricing = new();
        }
    }

    public ModelData GetData()
    {
        ModelData data = new ModelData 
        {
            DateFrom = modelSchedule.DateFrom,
            DateTo = modelSchedule.DateTo,
            Recurrences = modelSchedule.Recurrences,
            ItemPrices = modelPricingList.Pricings.Select(p => {
                return new ModelData.ItemPrice {
                    AbsorbFees = p.AbsorbFees,
                    MaxSlots = p.MaxSlots,
                    Price = p.Price,
                    Description = p.Description,
                    Id = p.Id,
                    Name = p.Name
                };
            }).ToList()
        };
        data.ItemPrices.Add(new ModelData.ItemPrice {
            AbsorbFees = modelPricing.AbsorbFees,
            MaxSlots = modelPricing.MaxSlots,
            Price = modelPricing.Price,
            Description = modelPricing.Description,
            Id = modelPricing.Id,
            Name = modelPricing.Name
        });
        return data;
    }

    public void SetState(ModelData data)
    {
        modelSchedule.DateFrom = data.DateFrom;
        modelSchedule.DateTo = data.DateTo;
        modelSchedule.TimeFrom = data.DateFrom.TimeOfDay;
        modelSchedule.TimeTo = data.DateTo.TimeOfDay;
        modelSchedule.Recurrences = data.Recurrences;

        data.ItemPrices = data.ItemPrices.OrderBy(t => t.Id).ToList();

        var last = data.ItemPrices.LastOrDefault();
        if(last is not null)
        {
            var notLast = data.ItemPrices.Where(p => p.Id != last.Id);
            foreach(var item in notLast)
            {
                modelPricingList.Pricings.Add(new Pricing {
                    AbsorbFees = item.AbsorbFees,
                    Description = item.Description,
                    Id = item.Id,
                    MaxSlots = item.MaxSlots,
                    Price = item.Price,
                    Name = item.Name
                });
            }

            modelPricing.AbsorbFees = last.AbsorbFees;
            modelPricing.Description = last.Description;
            modelPricing.Id = last.Id;
            modelPricing.MaxSlots = last.MaxSlots;
            modelPricing.Price = last.Price;
            modelPricing.Name = last.Name;
        }

        StateHasChanged();
    }

    private async Task ViewDetails(Pricing ticketPricing)
    {
        if(modalFeeBreakdown is not null)
        {
            modalTicketPricing.TicketPrice = ticketPricing.Price;
            modalTicketPricing.IsAbsorbFee = ticketPricing.AbsorbFees;
            await modalFeeBreakdown.Show();
        }
    }

    private async Task CloseDetails()
    {
        if(modalFeeBreakdown is not null)
        {
            await modalFeeBreakdown.Close(CloseReason.UserClosing);
        }
    }

    private decimal CalCulateBuyerTotal(Pricing ticketPrice)
    {
        ModalTicketPricing price = new ModalTicketPricing {IsAbsorbFee = ticketPrice.AbsorbFees, TicketPrice = ticketPrice.Price};
        return price.SubTotal;
    }

    private string SetDayStyle(bool selected)
    {
        var style = "font-20 prevent-select cursor-pointer rounded-pill round-day me-2";
        if(selected) return $"{style} bg-orange-100 color-white-100";
        else return style;
    }

    private Task RecurrenceChanged(string value)
    {
        modelSchedule.Recurrences = value;
        modelSchedule.RepeatEvery = value switch {
            "do-not-repeat" => "Do not repeat",
            "every-weekday" => "Week",
            "daily" => "Day",
            "weekly" => "Weekly",
            "monthly" => "Monthly",
            _ => "Do not repeat"
        };
        return Task.CompletedTask;
    }

    public class ModelData
    {
        public DateTime DateFrom {get; set;}
        public DateTime DateTo {get; set;}
        public string Recurrences {get; set;}
        public IList<ItemPrice> ItemPrices {get; set;}

        public class ItemPrice 
        {
            public int Id {get; set;}
            public decimal Price {get; set;}
            public int MaxSlots {get; set;}
            public bool AbsorbFees {get; set;}
            public string Description {get; set;}
            public string Name {get; set;}
        }
    }

    private class PricingList
    {
        public IList<Pricing> Pricings {get; set;} = new List<Pricing>();
    }

    public class Schedule 
    {
        private DateTime dateFrom = DateTime.Now;
        [Required(ErrorMessage = "The date from field is mandatory.")]
        [DateOnwards(ErrorMessage = "Past dates not allowed.", Strict = false)]
        public DateTime DateFrom 
        {
            get
            {
                dateFrom = dateFrom.Date + TimeFrom;
                return dateFrom;
            }
            set
            {
                dateFrom = value;
            }
        }

        [Required(ErrorMessage = "The time field is mandatory.")]
        public TimeSpan TimeFrom {get; set;} = DateTime.Now.TimeOfDay;

        private DateTime dateTo = DateTime.Now;
        [Required(ErrorMessage = "The date to field is mandatory.")]
        [DateOnwards(ErrorMessage = "Past dates not allowed.", Strict = false)]
        [DateLessThan("DateFrom", ErrorMessage = "Invalid date range.")]
        public DateTime DateTo
        {
            get 
            {
                dateTo = dateTo.Date + TimeTo;
                return dateTo;
            }
            set 
            {
                dateTo = value;
            }
        }

        [Required(ErrorMessage = "The time field is mandatory.")]
        public TimeSpan TimeTo {get; set;} = DateTime.Now.TimeOfDay;

        [Required(ErrorMessage = "The recurrences field is mandatory.")]
        public string Recurrences {get; set;} = "do-not-repeat";

        [Required(ErrorMessage = "The date to field is mandatory.")]
        [DateOnwards(ErrorMessage = "Past dates not allowed.", Strict = false)]
        public DateTime DurationStart {get; set;} = DateTime.Now;

        [Required(ErrorMessage = "The date to field is mandatory.")]
        [DateOnwards(ErrorMessage = "Past dates not allowed.", Strict = false)]
        [DateLessThan("DurationStart", ErrorMessage = "Invalid date range.")]
        public DateTime DurationEnd {get; set;} = DateTime.Now;

        public int DurationEvery {get; set;} = 1;
        public string RepeatEvery {get; set;}

        // monthly section fields
        public int MonthSelection {get; set;} = 1;
        public string MonthRepeat {get; set;} = "first";
        public string MonthDay {get; set;} = "sunday";
        
        [Range(1, 31)]
        public int OnDayDate {get; set;} = 1;

    }

    public class Pricing 
    {
        [Required(ErrorMessage = "The price field is mandatory.")]
        [Range(1, int.MaxValue, ErrorMessage = "The price field is mandatory.")]
        public decimal Price {get; set;}

        [Required(ErrorMessage = "The max slots field is mandatory.")]
        [Range(1, int.MaxValue, ErrorMessage = "Please specify the maximum slot number.")]
        public int MaxSlots {get; set;}

        [Required(ErrorMessage = "The absorb fees field is mandatory.")]
        public bool AbsorbFees {get; set;}

        [Required(ErrorMessage = "The description field is mandatory.")]
        public string Description {get; set;}

        [Required(ErrorMessage = "The name field is mandatory.")]
        public string Name {get; set;}

        // extras
        public bool IsOpen {get; set;} = false;
        public int Id {get; set;}
        public bool Valid 
        {
            get{
                return !string.IsNullOrEmpty(Description) && Price > 0 && MaxSlots > 0;
            }
        }
    }

    private class ModalTicketPricing
    {
        public decimal TicketPrice {get; set;}
        public bool IsAbsorbFee {get; set;}
        public decimal ServiceFee 
        {
            get 
            {
                return (TicketPrice * 0.05m);
            }
        }

        public decimal HandlingFee 
        {
            get {
                return 15;
            }
        }

        public decimal SubTotal 
        {
            get
            {
                if(!IsAbsorbFee) return TicketPrice + ServiceFee + HandlingFee;
                return TicketPrice;
            }
        }

        public decimal PayoutAmount 
        {
            get 
            {
                if(!IsAbsorbFee) return TicketPrice;

                return SubTotal - ServiceFee - HandlingFee;
            }
        }
    }

    private record DayItem 
    {
        public string Day {get; set;}
        public string Value {get; set;}
        public bool Selected {get; set;}
    }
}
    public class SeatPlan
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Payload { get; set; }
    }

    public Task CreateDefaultTickets(string payload)
    {
        modelPricingList.Pricings.Clear();
        var tickets = jsonSerializationProvider.Deserialize<Cinnamon.Framework.Models.SeatPlan.Format>(payload);
        foreach(var ticket in tickets.Categories)
        {
            int maxId = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.TempId) + 1;
            int order = modelPricingList.Pricings.Count == 0 ? 1 : modelPricingList.Pricings.Max(s => s.Order) + 1;

            var cat = ticket.Value;
            modelPricingList.Pricings.Add(new Pricing {
                Name = cat.Name,
                Price = 0,
                MaxSlots = cat.Rows.Sum(r => r.Value.Seats.Count),
                AbsorbFees = false,
                IsFree = true,
                RequiredApproval = false,
                IsUnlimited = false,
                TempId = maxId,
                Order = order,
                ReserveSeatUuid = cat.Uuid,
                IsNew = true
            });
        }

        isReservedSeats = true;

        StateHasChanged();

        return Task.CompletedTask;
    }

    private Task ShowAddTicketModal()
    {
        if(isReservedSeats)
        {
            return NotificationService.Info("You have already added reserved seats. You will not be able to add another ticket.", "Information");
        }

        return ticketModal.Show();
    }

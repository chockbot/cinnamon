    public async Task<bool> FieldValid()
    {
        bool isSetLimit = true;
        bool checkTicket = true;
        if (ModelState.IsLimit == 2)
        {
            isSetLimit = ModelState.EventTicketLimit != 0;
        }
        checkTicket = modelPricingList.Pricings.Count != 0 ? true : false;
        if (!checkTicket)
        {
            StateHasChanged();
            await Task.Delay(300);
            errorMessage = "<li>Please add ticket/s to proceed.</li>";
            await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-pricing-wrapper .is-invalid");
            showErrors = true;
            return false;
        }
        bool valid = isSetLimit && checkTicket;
        StateHasChanged();
        await Task.Delay(300); // add delay to populate is-invalid class
        if (!valid)
        {
            showErrors = true;
            await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-pricing-wrapper .is-invalid");
        }
        errorMessage = string.Empty;
        return valid;
    }


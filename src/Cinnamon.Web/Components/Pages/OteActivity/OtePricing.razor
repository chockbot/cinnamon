            "daily" => GenerateDaily(every, dateStart, dateEnd, timeDuration, timeStart),
            "weekly" => GenerateWeekly(every, dateStart, dateEnd, timeDuration, timeStart, weekString),
            "monthly" => GenerateMonthly(every, dateStart, dateEnd, timeDuration, timeStart, monthSelection, 

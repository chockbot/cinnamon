                                        <div class="form-check form-switch">
                                            <Switch ReadOnly="isReservedSeats" TValue="bool" @bind-Checked="modelPricing.IsUnlimited" @onchange="((e) => IsUnlimitedChanged(e))" class=" form-check-input" />
                                        </div>
                                    </div>
                                </FieldBody>

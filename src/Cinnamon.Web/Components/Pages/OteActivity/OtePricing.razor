    private string ScheduleMessageInfo
    {
        get
        {
            string durationStart = ModelState.DurationStart.ToString("MM/dd/yyyy");
            string durationEnd = ModelState.DurationEnd.ToString("MM/dd/yyyy");

            if (ModelState.Recurrences == "do-not-repeat")
            {
                return "Repeat only once.";
            }

            if (ModelState.Recurrences == "every-weekday")
            {
                if (ModelState.DurationEvery == 1)
                {
                    return $"Occurs every Monday through Friday until {durationEnd}.";
                }

                return $@"Occurs every {ModelState.DurationEvery} weeks on Monday, Tuesday, Wednesday,
                    Thursday and Friday starting {durationStart} until {durationEnd}";
            }

            if (ModelState.Recurrences == "daily")
            {
                if (ModelState.DurationEvery == 1)
                {
                    return $"Occurs every day starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {ModelState.DurationEvery} days starting {durationStart} until {durationEnd}";
            }

            if (ModelState.Recurrences == "weekly")
            {
                var days = dayItems.Where(d => d.Selected).Select(d => d.DayString);
                string selectedDaysString = DayStrings(days);

                if (ModelState.DurationEvery == 1)
                {
                    return $"Occurs every {selectedDaysString} starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {ModelState.DurationEvery} weeks on {selectedDaysString} starting {durationStart} until {durationEnd}";
            }

            if (ModelState.Recurrences == "monthly")
            {
                string everyMonthString = ModelState.DurationEvery > 1 ? $"{ModelState.DurationEvery} months" : "month";

                if (ModelState.MonthSelection == 1)
                {
                    return $"Occurs every {everyMonthString} on day {ModelState.OnDayDate} starting {durationStart} until {durationEnd}";
                }

                return $"Occurs every {everyMonthString} on the {ModelState.MonthRepeat} {ModelState.MonthDay.Capitalize()} starting {durationStart} until {durationEnd}";
            }

            return string.Empty;
        }
    }

    private string DayStrings(IEnumerable<string> strings)
    {
        string dayString = string.Empty;
        if (strings.Count() > 1)
        {
            dayString = string.Join(", ", strings.Take(strings.Count() - 1));
            dayString += " and " + strings.Last();
        }
        else
        {
            dayString = strings.FirstOrDefault();
        }

        return dayString;
    }


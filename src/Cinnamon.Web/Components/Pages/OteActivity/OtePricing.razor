    private async Task OnOffCanvasSave()
    {
        switch (selectedEmailTemplate)
        {
            case 0:
                await SavePendingTemplate();
                await NotificationService.Success("Custom pending email template updated.", "Success");
                break;
            case 1:
                await SaveAcceptedTemplate();
                await NotificationService.Success("Custom approved email template updated.","Success");
                break;
            default:
                await SaveDeclinedTemplate();
                await NotificationService.Success("Custom declined email template updated.", "Success");
                break;

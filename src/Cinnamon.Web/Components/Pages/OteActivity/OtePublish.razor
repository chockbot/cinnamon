@namespace Cinnamon.Web.Components.Pages.OteActivity
@using Cinnamon.Web.Components;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Framework.Helpers;
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject NavigationManager NavigationManager;
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime JS;
@implements IOteComponent;
@inject INotificationService NotificationService
@inject IJSRuntime JS

<LoadingIndicator @ref="loadingIndicator" FullScreen FadeIn>
    <section class="ote-publish-wrapper">
        @if (Summary is not null)
        {
            <div class="border-radius-10 p-4 bg-white-200 m-bg-white-100 m-padding-0 mb-3">
                <p class="font-20 font-weight-700 color-black-100">Overview</p>
                <div class="summary-section">
                    @*<div class="event-image">
                <input type="hidden" id="@Summary.InputDataId" name="@Summary.InputDataId" class="img-event" />
                <img id="@Summary.ImageSrcId" class="cover-image" src="@Summary.ImageSrc" alt="cover-photo">
                </div>*@
                    <div class="event-details">
                        <div>
                            @*Title*@
                            <p class="event-name">@Summary.EventData.Name</p>
                            @*Location*@
                            @if (Summary.EventData.ExperienceType == 1)
                            {
                                string address = string.IsNullOrEmpty(Summary.EventData.PinnedLocation) ? $"{Summary.EventData.BarangayName + ", " + Summary.EventData.CityName + ", " + Summary.EventData.RegionName}" : Summary.EventData.PinnedLocation;
                                <div>
                                    <p class="event-details ">
                                        @address
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <p class="event-details">
                                        Online
                                    </p>
                                </div>
                            }
                            @*Schedule*@
                            <div>
                                <p class="event-details">
                                    @if (Summary.ScheduleData.Recurrences != "do-not-repeat")
                                    {
                                        string eventSchedule = $"{Summary.ScheduleData.DurationStart?.ToString("MMM dd")} - {Summary.ScheduleData.DurationEnd?.ToString("MMM dd, yyyy")}";
                                        @eventSchedule
                                    }
                                    else if (Summary.ScheduleData != null)
                                    {
                                        @Summary.ScheduleData.DateFrom.ToString("MMM dd, yyyy")
                                    }
                                </p>
                                <p class="event-details text-uppercase">
                                    @Summary.ScheduleData.DateFrom.ToString("hh:mm tt")
                                </p>
                            </div>
                        </div>
                        @*Calendar*@
                        @if (Summary.ScheduleData.Recurrences != "do-not-repeat")
                        {
                            <button class="view-calendar" @onclick="() => ViewCalendar()">View Calendar</button>
                        }
                        @*Tickets*@
                        <div>
                            <p class="prices-title">Ticket Prices</p>
                            @foreach (var item in Summary.PricingData.ItemPrices)
                            {
                                <div class="ticket-details">
                                    <p class="event-details">@item.Name</p>
                                    <p class="event-details"> @((item.Price == 0) ? "Free" : $"₱{item.Price:N0}")</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="border-radius-10 p-4 bg-white-200 m-bg-white-100 m-padding-0 mb-3">
                <p class="font-20 font-weight-700 color-black-100">Scheduled Emails</p>

                <Row VerticalGutter="20" HorizontalGutter="20">
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                        <div id="reminderDiv" @onmousemove="ReminderHoverMove" @onmouseleave="ReminderHoverLeave" @onclick="() => OnSelectedScheduledEmail(0)" 
                            class="bg-white-100 p-2 border-radius-10 cursor-pointer email-box">
                            <div class="d-flex align-items-center mb-2 text-box">
                                <img class="me-2" src="images/ote/red-bell.png" alt="bell">
                                <span class="font-16 color-black-100">Add Reminder Email</span>
                            </div>
                            <div class="line-effect div-line mb-2"></div>
                            <div class="line-effect div-line-75 mb-2"></div>
                            @if(ReminderEmailNotSet)
                            {
                                <div class="d-flex align-items-center mb-2 text-box">
                                    <div class="small-circle-red me-2">
                                    </div>
                                    <p class="font-16 color-grey-100 mb-0">No message yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center mb-2 text-box">
                                    <div class="small-circle-green me-2">
                                    </div>
                                    <p class="font-16 color-grey-100 mb-0">Message already set</p>
                                </div>
                            }
                            <div class="effect hover1"></div>
                        </div>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                        <div id="feedbackDiv" @onmousemove="FeedbackHoverMove" @onmouseleave="FeedbackHoverLeave" @onclick="() => OnSelectedScheduledEmail(1)" 
                            class="bg-white-100 p-2 border-radius-10 cursor-pointer email-box">
                            <div class="d-flex align-items-center mb-2 text-box">
                                <img class="me-2" src="images/ote/yellow-star.png" alt="bell">
                                <span class="font-16 color-black-100">Add Feedback Email</span>
                            </div>
                            <div class="line-effect div-line mb-2"></div>
                            <div class="line-effect div-line-75 mb-2"></div>
                            @if(FeedBackEmailNotSet)
                            {
                                <div class="d-flex align-items-center mb-2 text-box">
                                    <div class="small-circle-red me-2">
                                    </div>
                                    <p class="font-16 color-grey-100 mb-0">No message yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center mb-2 text-box">
                                    <div class="small-circle-green me-2">
                                    </div>
                                    <p class="font-16 color-grey-100 mb-0">Message already set</p>
                                </div>
                            }
                            <div class="effect hover2"></div>
                        </div>
                    </Column>
                </Row>
            </div>
            <div class="border-radius-10 p-4 bg-white-200 m-bg-white-100 m-padding-0">
                <div>
                    <p class="font-20 font-weight-700 color-black-100">Here are some important things you need to know:</p>
                    <Row HorizontalGutter="20" VerticalGutter="20">
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                            <div class="box-border border-radius-20 pt-3 pb-4 px-3 text-center bg-white-100 h-100 position-relative">
                                <p class="mb-5 font-20 font-weight-700 color-black-100">
                                    What’s gonna happen
                                    <br>
                                    when availed the
                                    <br>
                                    ticket events?
                                </p>
                                <div class="publish-read-more">
                                    <Button Clicked="() => userFlowModal.ShowModal()" class="px-4 py-1 rounded-pill bg-orange-100 color-white-100 font-14 font-weight-700 hover-color-white read-more-btn" Type="ButtonType.Button">
                                        Read more
                                    </Button>
                                </div>
                            </div>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                            <div class="box-border border-radius-20 pt-3 pb-4 px-3 text-center bg-white-100 h-100 position-relative">
                                <p class="mb-5 font-20 font-weight-700 color-black-100">
                                    How will I get paid
                                    <br>
                                    from this event?
                                </p>
                                <div class="publish-read-more">
                                    <Button Clicked="() => moneyFlowsModal.ShowModal()" class="px-4 py-1 rounded-pill bg-orange-100 color-white-100 font-14 font-weight-700 hover-color-white read-more-btn" Type="ButtonType.Button">
                                        Read more
                                    </Button>
                                </div>
                            </div>
                        </Column>
                    </Row>
                    <p class="font-20 font-weight-700 color-black-100">Terms & Conditions</p>
                    <div class="terms-condition-section">
                        <span class="d-inline-flex align-items-center cursor-pointer prevent-select">
                            <img @onclick="() => model.AcceptTerms = !model.AcceptTerms" class="me-1" src='@(model.AcceptTerms ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                            <p class="terms-link-text">I have read and agreed to the <span><a class="terms-link" href="help/terms" target="_blank">Terms & Conditions</a></span></p>
                        </span>
                        @if (showErrorMessage && !model.AcceptTerms)
                        {
                            <p class="mb-0 font-12 is-invalid text-danger">Please accept terms and condition</p>
                        }
                    </div>
                </div>
            </div>
            <div class="section-footer mt-4 d-flex">
                @if (HavePrevious)
                {
                    <Button class="@PrevButtonClass" @onclick="PrevClick">
                        Back
                    </Button>
                }
                <Button class="@NextButtonClass" @onclick="NextClick">
                    <ChildContent>
                        Publish
                    </ChildContent>
                </Button>
            </div>
            <Modal @ref="modalCalendar">
                <ModalContent Centered>
                <ModalHeader class="py-2 px-4 border-1-solid justify-content-center border-bottom-1-solid border-color-grey-200 position-relative">
                    <p class="font-16 m-0 font-weight-700">View Calendar</p>
                    <button type="button" style="top: 13px; right: 20px;" class="btn-close position-absolute" @onclick="() => HideCalendar()" />
                </ModalHeader>
                <ModalBody>
                    <Calendar ViewOnly StrikeOutNotSelected
                              SelectedDates="SelectedDates" OnSelectedDate="SelectedDate" CurrentDate="SelectedDates.FirstOrDefault()" />
                        </ModalBody>
                        </ModalContent>
                        </Modal>
        }
    </section>
</LoadingIndicator>
<UserFlowModal @ref=userFlowModal Image="user-flow-ote.webp" MobileImage="user-flow-ote-mobile.png" />
<UserFlowModal @ref=moneyFlowsModal Image="money-flow-ote.webp" MobileImage="money-flow-ote-mobile.png" />
<Offcanvas @ref="rightsideOffcanvas" Closing="OffCanvasClosing" ShowBackdrop Placement="Placement.End">
    <OffcanvasHeader class="px-0 py-4 bg-white-100">
        <div class="px-3 d-flex justify-content-between position-relative w-100">
            @if (selectedEmailSchedule == 0)
            {
                <img src="images/ote/small-red-bell.png" alt="bell">
            }
            @if (selectedEmailSchedule == 1)
            {
                <img src="images/ote/small-yello-star.png" alt="bell">
            }
            <button class="btn-close" style="right: 0;" @onclick="OnOffCanvasCancelled" />
        </div>
    </OffcanvasHeader>
    <OffcanvasBody class="px-0 pt-0">
        <Divider class="m-0" />
        <div class="p-3">
            @if (selectedEmailSchedule == 0)
            {
                <div id="reminder-email-setup">
                    <Field>
                        <FieldLabel For="numberDays" class="font-20 font-weight-700 color-black-100">
                            Reminder Email
                        </FieldLabel>
                        <FieldBody>
                            <p class="font-16 color-grey-100 my-3">Set email date to be send</p>
                            <div class="d-flex align-items-center">
                                <div style="width: 70px;">
                                    <NumericPicker style="box-shadow: 0px 0px 48px 0px rgba(217, 217, 217, 0.6)"
                                               TextAlignment="TextAlignment.Center" Border="Border.Is0"
                                                   id="numberDays" Min="1" Max="5" TValue="int" ShowStepButtons="true" @bind-Value="reminderNotification.Days" />
                                </div>
                                <span class="ms-3">day/s before the event starts.</span>
                            </div>
                        </FieldBody>
                    </Field>
                    <div class="font-16 color-black-100 p-3 mt-4 border-radius-5 white-bg-shadow">
                        <Field class="mb-3">
                            <FieldLabel class="mb-2 font-16 font-weight-700">Subject</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="reminderNotification.Subject" />
                            </FieldBody>
                        </Field>
                        <Field>
                            <FieldLabel class="mb-2 font-16 font-weight-700">Body</FieldLabel>
                            <FieldBody>
                                <MemoEdit @bind-Text="reminderNotification.Body" Rows="7" Placeholder="Add custom message here." />
                            </FieldBody>
                        </Field>
                    </div>
                </div>
            }

            @if (selectedEmailSchedule == 1)
            {
                <div id="feedback-email-setup">
                    <Field>
                        <FieldLabel For="numberDays" class="font-20 font-weight-700 color-black-100">
                            Feedback Email
                        </FieldLabel>
                        <FieldBody>
                            <p class="font-16 color-grey-100 my-3">When should the feedback email be sent?</p>
                            <div class="d-flex align-items-center">
                                <div style="width: 70px;">
                                    <span class="white-bg-shadow">
                                        <NumericPicker @bind-Value="feedbackNotification.Days" style="box-shadow: 0px 0px 48px 0px rgba(217, 217, 217, 0.6)"
                                                   TextAlignment="TextAlignment.Center" Border="Border.Is0"
                                                       id="numberDays" Min="1" Max="5" TValue="int" ShowStepButtons="true" />
                                    </span>
                                </div>
                                <span class="ms-3">day/s after the event ends.</span>
                            </div>
                        </FieldBody>
                    </Field>
                    <div class="font-16 color-black-100 p-3 mt-4 border-radius-5 white-bg-shadow">
                        <Field class="mb-3">
                            <FieldLabel class="mb-2 font-16 font-weight-700">Subject</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="feedbackNotification.Subject" />
                            </FieldBody>
                        </Field>
                        <Field>
                            <FieldLabel class="mb-2 font-16 font-weight-700">Body</FieldLabel>
                            <FieldBody>
                                <MemoEdit @bind-Text="feedbackNotification.Body" Rows="7" Placeholder="Add custom message here." />
                            </FieldBody>
                        </Field>
                        <p class="font-14 color-grey-100 my-3">
                            What did you think of 
                            <span class="text-capitalize">@EventName</span>
                            ?
                        </p>
                        <div class="d-flex">
                            <span class="font-24 d-block px-2 py-1 white-bg-shadow me-2">&#128544;</span>
                            <span class="font-24 d-block px-2 py-1 white-bg-shadow me-2">&#128542;</span>
                            <span class="font-24 d-block px-2 py-1 white-bg-shadow me-2">&#128528;</span>
                            <span class="font-24 d-block px-2 py-1 white-bg-shadow me-2">&#128512;</span>
                            <span class="font-24 d-block px-2 py-1 white-bg-shadow me-2">&#128525;</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </OffcanvasBody>
    <OffcanvasFooter>
        <div class="w-100">
            <Divider />
            <Button Clicked="OnOffCanvasSaved" class="bg-orange-100 color-white-100 px-4 me-2">
                Save
            </Button>
            <Button Clicked="OnOffCanvasCancelled" class="bg-grey-300 color-black-200">
                Cancel
            </Button>
        </div>
    </OffcanvasFooter>
</Offcanvas>

@code
{
    [Parameter]
    public EventCallback OnNextClick { get; set; }

    [Parameter]
    public EventCallback OnPrevClick { get; set; }

    [Parameter]
    public ComponentSummary Summary { get; set; } = new();

    [Parameter]
    public string Token { get; set; }

    private GenerateRecurrenceDate recurrenceHelper = new();

    private Calendar? summaryCalendar;

    private List<DateSchedule> scheduleDates = new();

    private int activityId = 0;

    private bool accepTerms = true;

    LoadingIndicator loadingIndicator;
    private FormModel model = new();
    private bool invokingNext = false;
    private bool showErrorMessage = false;
    private UserFlowModal? userFlowModal;
    private UserFlowModal? moneyFlowsModal;
    public bool HavePrevious { get; set; } = true;
    public string NextButtonExtraClass { get; set; }
    private Modal? modalCalendar { get; set; }

    public bool IsShowCalendar { get; set; } = false;

    private Offcanvas? rightsideOffcanvas;

    private int selectedEmailSchedule = 0;
    private ScheduleNotification reminderNotification = new();
    private ScheduleNotification feedbackNotification = new();
    private ScheduleNotification reminderNotificationOrig = new();
    private ScheduleNotification feedbackNotificationOrig = new();

    private DateTime selectedDate;
    private bool displayCalendar { get; set; }
    public EventCallback<DateTime> OnSelectedDate { get; set; }
    private IList<DateTime> SelectedDates
    {
        get
        {
            IList<DateTime> dates = new List<DateTime>();
            if (GeneratedDates is not null)
            {
                dates = GeneratedDates.Select(d => d.DateStart).ToList();
            }
            return dates;
        }
    }
    private async Task SelectedDate(DateTime date)
    {
        if (SelectedDates.Any(d => d.Date == date.Date))
        {
            displayCalendar = true;
            selectedDate = date;
            if (OnSelectedDate.HasDelegate)
            {
                await OnSelectedDate.InvokeAsync(date);
            }
        }
    }
    public Task<bool> FieldValid()
    {
        bool result = true;
        if (!model.AcceptTerms)
        {
            result = false;
            showErrorMessage = true;
        }
        return Task.Run<bool>(() => result);
    }

    private async Task NextClick()
    {
        if (OnNextClick.HasDelegate)
        {
            await loadingIndicator.Show();
            invokingNext = true;
            await OnNextClick.InvokeAsync();
            invokingNext = false;
            await loadingIndicator.Hide();
        }
    }

    private async Task PrevClick()
    {
        if (OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }

    public ModelData GetData()
    {
        return new ModelData
            {
                AcceptTerms = model.AcceptTerms,
                EmailFeedback = feedbackNotificationOrig,
                EmailReminder = reminderNotificationOrig
            };
    }

    public Task SetState(IEnumerable<BookedDate> bookedDates, int activityId, bool AcceptTerms,
        ScheduleNotification feedback, ScheduleNotification reminder)
    {
        this.activityId = activityId;
        foreach (var item in bookedDates)
        {
            scheduleDates.Add(new DateSchedule
                {
                    Id = item.Id,
                    NewDate = item.Date,
                    OldDate = item.Date
                });
        }
        this.accepTerms = AcceptTerms;

        this.feedbackNotificationOrig = new ScheduleNotification
            {
                Body = feedback.Body,
                Days = feedback.Days,
                Subject = feedback.Subject
            };
        this.feedbackNotification = feedback;

        this.reminderNotificationOrig = new ScheduleNotification
            {
                Body = reminder.Body,
                Days = reminder.Days,
                Subject = reminder.Subject
            };
        this.reminderNotification = reminder;

        return Task.CompletedTask;
    }

    private Task NavigateToTerms()
    {
        NavigationManager.NavigateTo("/help/terms");
        return Task.CompletedTask;
    }

    private class FormModel
    {
        public bool AcceptTerms { get; set; } = true;
        public IEnumerable<BookedDate> bookedDates { get; set; }
        public int activityId { get; set; }
    }

    public class ModelData
    {
        public bool AcceptTerms { get; set; }
        public IEnumerable<BookedDate> bookedDates { get; set; }
        public int activityId { get; set; }
        public ScheduleNotification EmailReminder { get; set; }
        public ScheduleNotification EmailFeedback { get; set; }

    }
    private string NextButtonClass
    {
        get
        {
            return $"bg-orange-100 color-white-100 text-capitalize font-24 hover-color-white px-5 border-radius-10 m-font-20 m-border-radius-5 m-width-100 {NextButtonExtraClass}";
        }
    }

    private string PrevButtonClass
    {
        get
        {
            return "me-2 bg-white-200 color-black-100 text-capitalize font-24 hover-color-black-100 px-5 border-radius-10 m-font-20 m-border-radius-5 m-width-100 m-margin-right-10";
        }
    }
    public class ComponentSummary
    {
        public OteEvent.ModelData EventData { get; set; }
        public OteSchedule.ModelData ScheduleData { get; set; }
        public OtePricing.ModelData PricingData { get; set; }
        public OtePublish.ModelData PublishData { get; set; }
        public OteOnlineEvent.ModelData OnlineData { get; set; }
        //public string ImageSrcId { get; set; }
        //public string InputDataId { get; set; }
        //public string ImageSrc { get; set; }

        // extra options
        public IEnumerable<BookedDate> BookedDates { get; set; }
    }

    private Task ShowOffcanvas()
    {
        return rightsideOffcanvas?.Show();
    }

    private Task HideOffcanvas()
    {
        return rightsideOffcanvas?.Close(CloseReason.UserClosing);
    }

    public Task OnSelectedScheduledEmail(int selected)
    {
        selectedEmailSchedule = selected;
        return ShowOffcanvas();
    }

    private async Task OnOffCanvasSaved()
    {
        switch (selectedEmailSchedule)
        {
            case 0:
                await SaveEmailReminder();
                await NotificationService.Success("Custom reminder email template updated.", "Success");
                break;
            default:
                await SaveEmailFeedback();
                await NotificationService.Success("Custom email feedback template updated.", "Success");
                break;
        }
    }

    private Task OnOffCanvasCancelled()
    {
        if (selectedEmailSchedule == 0) return CancelEmailReminder();

        return CancelEmailFeedback();
    }

    private Task SaveEmailReminder()
    {
        reminderNotificationOrig.Days = reminderNotification.Days;
        reminderNotificationOrig.Body = reminderNotification.Body;
        reminderNotificationOrig.Subject = reminderNotification.Subject;
        return HideOffcanvas();
    }

    private Task CancelEmailReminder()
    {
        reminderNotification.Days = reminderNotificationOrig.Days;
        reminderNotification.Body = reminderNotificationOrig.Body;
        reminderNotification.Subject = reminderNotificationOrig.Subject;
        return HideOffcanvas();
    }

    private Task SaveEmailFeedback()
    {
        feedbackNotificationOrig.Days = feedbackNotification.Days;
        feedbackNotificationOrig.Body = feedbackNotification.Body;
        feedbackNotificationOrig.Subject = feedbackNotification.Subject;
        return HideOffcanvas();
    }

    private Task CancelEmailFeedback()
    {
        feedbackNotification.Days = feedbackNotificationOrig.Days;
        feedbackNotification.Body = feedbackNotificationOrig.Body;
        feedbackNotification.Subject = feedbackNotificationOrig.Subject;
        return HideOffcanvas();
    }

    private string EventName
    {
        get
        {
            if (Summary is not null && Summary.EventData is not null) return Summary.EventData.Name;

            return string.Empty;
        }
    }

    private bool ReminderEmailNotSet
    {
        get
        {
            return string.IsNullOrEmpty(reminderNotificationOrig.Subject) && string.IsNullOrEmpty(reminderNotificationOrig.Body);
        }
    }

    private bool FeedBackEmailNotSet
    {
        get
        {
            return string.IsNullOrEmpty(feedbackNotificationOrig.Body) && string.IsNullOrEmpty(feedbackNotificationOrig.Subject);
        }
    }

    public class BookedDate
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public DateTime NewDate { get; set; }
    }

    private Task OffCanvasClosing(OffcanvasClosingEventArgs e)
    {
        e.Cancel = !(e.CloseReason == CloseReason.UserClosing);
        return Task.CompletedTask;
    }

    private class DateSchedule
    {
        public int Id { get; set; }

        [Required]
        public DateTime OldDate { get; set; }

        [Required]
        public DateTime NewDate { get; set; }
    }
    private async Task ViewCalendar()
    {
        await modalCalendar?.Show();
        StateHasChanged();
    }
    private async Task HideCalendar()
    {
        await modalCalendar?.Hide();
        StateHasChanged();
    }

    public class ScheduleNotification
    {
        public int Days { get; set; } = 1;
        public string Subject { get; set; }
        public string Body { get; set; }
    }

    private IEnumerable<GenerateRecurrenceDate.DateItem> GeneratedDates
    {
        get
        {
            IEnumerable<GenerateRecurrenceDate.DateItem> dates = Enumerable.Empty<GenerateRecurrenceDate.DateItem>();

            if (Summary is not null && Summary.ScheduleData is not null)
            {
                var every = Summary.ScheduleData.DurationEvery ?? 0;
                var dateStart = Summary.ScheduleData.DurationStart ?? DateTime.Now;
                var dateEnd = Summary.ScheduleData.DurationEnd ?? DateTime.Now; ;

                var timeStart = dateStart.TimeOfDay;
                var timeDuration = Summary.ScheduleData.DateTo - Summary.ScheduleData.DateFrom;
                string weekString = Summary.ScheduleData.WeekString ?? string.Empty;

                var monthSelection = Summary.ScheduleData.MonthSelection ?? 0;
                var onDayDate = Summary.ScheduleData.OnDayDate ?? 0;
                var monthRepeat = Summary.ScheduleData.MonthRepeat ?? string.Empty;
                var monthDay = Summary.ScheduleData.MonthDay ?? string.Empty;

                dates = Summary.ScheduleData.Recurrences switch
                {
                    "every-weekday" => recurrenceHelper.GenerateWeekday(every, dateStart, dateEnd, timeDuration, timeStart),
                    "daily" => recurrenceHelper.GenerateDaily(every, dateStart, dateEnd, timeDuration, timeStart),
                    "weekly" => recurrenceHelper.GenerateWeekly(every, dateStart, dateEnd, timeDuration, timeStart, weekString),
                    "monthly" => recurrenceHelper.GenerateMonthly(every, dateStart, dateEnd, timeDuration, timeStart, monthSelection,
                        onDayDate, monthRepeat, monthDay),
                    _ => recurrenceHelper.GenerateNoRepeat(Summary.ScheduleData.DateFrom, Summary.ScheduleData.DateTo)
                };
            }

            return dates;
        }
    }


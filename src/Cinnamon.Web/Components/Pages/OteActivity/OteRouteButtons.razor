@namespace Cinnamon.Web.Components.Pages.OteActivity

<div class="section-footer mt-4 d-flex">
    @if(HavePrevious)
    {
        <Button class="me-2 bg-white-200 color-black-100 text-capitalize font-24 
            hover-color-black-100 px-5 border-radius-10" @onclick="PreviousClick">
            Back
        </Button>
    }
    <Button class="bg-orange-100 color-white-100 text-capitalize font-24 
        hover-color-white px-5 border-radius-10" @onclick="NextClick">
        Next
    </Button>
</div>

@code 
{
    [Parameter]
    public bool HavePrevious {get; set;} = true;

    [Parameter]
    public EventCallback OnPreviousClick {get; set;}

    [Parameter]
    public EventCallback OnNextClick {get; set;}

    private async Task PreviousClick()
    {
        if(OnPreviousClick.HasDelegate)
        {
            await OnPreviousClick.InvokeAsync();
        }
    }

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            await OnNextClick.InvokeAsync();
        }
    }
}
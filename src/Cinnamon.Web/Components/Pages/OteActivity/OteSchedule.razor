@namespace Cinnamon.Web.Components.Pages.OteActivity
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Framework.ValidationAttributes;
@using Cinnamon.Framework.Extensions.String;
@using Cinnamon.Framework.Helpers;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject INotificationService NotificationService
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime JS
@implements IOteComponent

<section class="ote-pricing-wrapper">
    <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
        <div class="mb-4">
            <div class="d-flex justify-content-between">
                <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                    <span>
                        schedule
                    </span>
                </h3>
                <label @onclick="ViewGuide" class="cursor-pointer">
                    <span class="font-14 font-weight-700 color-green-100 text-decoration-underline">How to do this</span>
                    <img src="images/ote/green-how-do-this.svg" alt="icon">
                </label>
            </div>
            <p class="font-16 color-grey-100 text-justify">
                Plan and organize your event by setting up your preferred schedule, creating your event duration and recurring options with ease.
            </p>
        </div>
        <Validations @ref="scheduleFormValidation" Mode="FormMode" Model="ModelState">
            <div class="data-form">
                <div class="event-time">
                    <div class="d-flex mb-3 flex-column flex-md-row">
                        <div class="box-width me-3 m-width-100 mb-3 mb-md-0">
                            <label for="" class="text-capitalize font-20 color-black-100 m-font-18">
                                Event Duration
                            </label>
                            <Row HorizontalGutter="15">
                                <Column ColumnSize="ColumnSize.Is3.OnMobile.Is6.OnDesktop">
                                    <Validation>
                                        <Field>
                                            <FieldBody>
                                                <NumericPicker class="text-center border-radius-10 m-border-radius-5 px-2 m-font-16"
                                                               Min="1" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                               TValue="int" @bind-Value="ModelState.EventDurationCount">
                                                </NumericPicker>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is4.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldBody>
                                            <Select TValue="string" Size="Size.Medium" class="@RecurrencesClass"
                                                    @bind-SelectedValue="ModelState.EventDurationTimeUnit">
                                                <SelectItem Value='@("hrs")'>hrs</SelectItem>
                                                <SelectItem Value='@("days")'>days</SelectItem>
                                                <SelectItem Value='@("weeks")'>weeks</SelectItem>
                                                <SelectItem Value='@("months")'>months</SelectItem>
                                            </Select>
                                        </FieldBody>
                                    </Field>
                                </Column>
                            </Row>
                        </div>
                        <div class="box-width">
                            <Validation>
                                <Field>
                                    <FieldLabel class="text-capitalize font-20 color-black-100 m-font-18">
                                        Start Time
                                    </FieldLabel>
                                    <FieldBody>
                                        <TimeEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5"
                                                  Size="Size.Medium" TValue="TimeSpan" @bind-Time="ModelState.EventDurationTimeStart" />
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </div>
                    </div>
                </div>

                <Divider class="my-4" />

                @if (AlreadyHaveBooked)
                {
                    <h3 class="font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
                        Event Recurrences
                    </h3>
                    <p class="font-16 color-grey-100 text-justify">
                        You can manually adjust individual occurrences after customers bought tickets to your event.
                        Make sure to update any reminders or invitations associated with the event series.
                    </p>

                    @* <Row VerticalGutter="10">
                @foreach (var item in RescheduleStringDates)
                {
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class="font-20 color-black-100">
                • @item
                </Column>
                }
                </Row> *@

                    <div>
                        <Button class="font-16 color-grey-100 bg-white-100 border-1-solid border-color-grey-200"
                            Clicked="() => seeScheduleCalendarModal?.Show()">
                            See Schedule
                        </Button>

                        <Button Clicked="() => modalReschedule?.Show()"
                                class="bg-orange-100 color-white-100 hover-color-white font-16">
                            Reschedule Event
                        </Button>
                    </div>
                }
                else
                {
                    <div class="event-recurrence d-flex flex-column flex-md-row mb-0 mb-md-3">
                        <div class="box-width me-3 mb-3 mb-md-0">
                            <Field>
                                <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                    recurrences
                                </FieldLabel>
                                <FieldBody>
                                    <Select TValue="string" Size="Size.Medium" class="@RecurrencesClass"
                                        SelectedValueChanged="RecurrenceChanged" SelectedValue="ModelState.Recurrences">
                                        <SelectItem Value='@("do-not-repeat")'>Do not repeat</SelectItem>
                                        <SelectItem Value='@("every-weekday")'>Every weekday</SelectItem>
                                        <SelectItem Value='@("daily")'>Daily</SelectItem>
                                        <SelectItem Value='@("weekly")'>Weekly</SelectItem>
                                        <SelectItem Value='@("monthly")'>Monthly</SelectItem>
                                    </Select>
                                    <div class="invalid-feedback">The recurrences field is mandatory.</div>
                                </FieldBody>
                            </Field>
                        </div>

                        @if (ModelState.Recurrences == "do-not-repeat")
                        {
                            <div class="box-width">
                                <Validation>
                                    <Field>
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            start date
                                        </FieldLabel>
                                        <FieldBody>
                                            <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationStart">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </DateEdit>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                            </div>
                        }
                    </div>

                    @if (ModelState.Recurrences != "do-not-repeat")
                    {
                        <div class="d-flex">
                            <div class="box-width me-3">
                                <Validation>
                                    <Field>
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            start
                                        </FieldLabel>
                                        <FieldBody>
                                            <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationStart">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </DateEdit>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                            </div>
                            <div class="box-width">
                                <Validation>
                                    <Field>
                                        <FieldLabel class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                            end
                                        </FieldLabel>
                                        <FieldBody>
                                            <DateEdit class="font-18 border-radius-10 field-width m-font-16 m-border-radius-5" Size="Size.Medium"
                                              TValue="DateTime" @bind-Date="ModelState.DurationEnd">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </DateEdit>
                                        </FieldBody>
                                    </Field>
                                </Validation>
                            </div>
                        </div>

                        <div class="weekly-repeat-every mt-4">
                            <label for="durationCount" class="font-20 text-capitalize color-black-100 mb-1 m-font-18">
                                repeat every
                            </label>
                            <div class="repeat-every-flex d-flex align-items-baseline align-items-md-center flex-column flex-md-row">
                                <div class="box-width me-3 mb-3 mb-md-0">
                                    <Validation>
                                        <Field>
                                            <FieldBody>
                                                <div class="d-flex">
                                                    <NumericPicker ElementId="durationCount"
                                                                   class="text-center me-3 border-radius-10 m-border-radius-5 m-font-16"
                                                                   style="width: 90px;" Min="1" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                           TValue="int" @bind-Value="ModelState.DurationEvery">
                                                    </NumericPicker>
                                                    <Button Disabled class="bg-grey-200 px-4">
                                                    @ModelState.RepeatEvery
                                                    </Button>
                                                </div>
                                                </FieldBody>
                                                </Field>
                                                </Validation>
                                            </div>
                                            @if (ModelState.Recurrences == "every-weekday")
                                {
                                    <div class="d-flex justify-content-center m-width-100">
                                        <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                                        <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">M</span>
                                        <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                                        <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">W</span>
                                        <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">T</span>
                                        <span class="font-20 rounded-pill round-day bg-orange-100 color-white-100 me-2 prevent-select">F</span>
                                        <span class="font-20 rounded-pill round-day me-2 cursor-none prevent-select">S</span>
                                    </div>
                                }

                                @if (ModelState.Recurrences == "weekly")
                                {
                                    <div class="d-flex justify-content-center m-width-100">
                                        @foreach (var item in dayItems)
                                        {
                                            <span @key="item" class="@SetDayStyle(item.Selected)" @onclick="() => OnWeeklyDaySelected(item)">@item.Day</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @if (ModelState.Recurrences == "monthly")
                        {
                            <div class="mt-5">
                                <RadioGroup TValue="int" @bind-CheckedValue="ModelState.MonthSelection">
                                    <Validation>
                                        <Field class="mb-3">
                                            <FieldBody>
                                                <div class="d-flex align-items-center">
                                                    <label for="type-on-day" class="cursor-pointer">
                                                        <Radio class="checkbox-round cursor-pointer" ElementId="type-on-day" TValue="int" Value="1">On day</Radio>
                                                    </label>
                                                    <NumericPicker Disabled="ModelState.MonthSelection == 2" class="text-center ms-3 border-radius-10 m-border-radius-5"
                                                                   style="width: 90px;" Min="1" Max="31" Size="Size.Medium" ShowStepButtons="false" Decimals="0"
                                                       TValue="int" @bind-Value="ModelState.OnDayDate">
                                                    </NumericPicker>
                                                </div>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <Field>
                                        <FieldBody>
                                            <div class="d-flex align-items-center">
                                                <label for="type-on-the" class="cursor-pointer">
                                                    <Radio class="checkbox-round cursor-pointer" ElementId="type-on-the" TValue="int" Value="2">On the</Radio>
                                                </label>
                                                <div class="box-width ms-3">
                                                    <Select Disabled="ModelState.MonthSelection == 1" TValue="string" Size="Size.Medium"
                                                            class="form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5"
                                                @bind-SelectedValue="ModelState.MonthRepeat">
                                                        <SelectItem Value='@("first")'>First</SelectItem>
                                                        <SelectItem Value='@("second")'>Second</SelectItem>
                                                        <SelectItem Value='@("third")'>Third</SelectItem>
                                                        <SelectItem Value='@("fourth")'>Fourth</SelectItem>
                                                        <SelectItem Value='@("last")'>Last</SelectItem>
                                                    </Select>
                                                </div>
                                                <div class="box-width ms-3">
                                                    <Select Disabled="ModelState.MonthSelection == 1" TValue="string" Size="Size.Medium"
                                                            class="box-width form-control font-18 text-capitalize color-black-100 border-radius-10 m-font-16 m-border-radius-5"
                                                @bind-SelectedValue="ModelState.MonthDay">
                                                        <SelectItem Value='@("sunday")'>Sunday</SelectItem>
                                                        <SelectItem Value='@("monday")'>Monday</SelectItem>
                                                        <SelectItem Value='@("tuesday")'>Tuesday</SelectItem>
                                                        <SelectItem Value='@("wednesday")'>Wednesday</SelectItem>
                                                        <SelectItem Value='@("thursday")'>Thursday</SelectItem>
                                                        <SelectItem Value='@("friday")'>Friday</SelectItem>
                                                        <SelectItem Value='@("saturday")'>Saturday</SelectItem>
                                                    </Select>
                                                </div>
                                            </div>
                                        </FieldBody>
                                    </Field>
                                </RadioGroup>
                            </div>
                        }
                    }
                    <div class="text-center color-grey-100 mt-4">
                        <p class="m-0 font-20 m-font-18">@ScheduleMessageInfo</p>
                    </div>
                }


            </div>
        </Validations>
    </div>

    @if (!AlreadyHaveBooked)
    {
        <div class="border-radius-10 bg-white-200 p-4 my-4 m-bg-white-100 m-padding-0 m-margin-top-30">
            <div>
                <h3 class="font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20 ">
                    Add date overrides
                </h3>
                <p class="font-16 color-grey-100 text-justify">
                    Customize recurrence patterns with override dates, providing flexible scheduling control for specific instances.
                </p>
                <div class="text-center">
                    <Button Clicked="ViewCalendar" class="bg-transparent rounded-pill border-color-orange-100 px-5 my-4 color-orange-100 hover-color-primary">
                        Add date override
                    </Button>
                </div>
                <Divider DividerType="DividerType.Dashed" class="m-0" />
                <div>
                    <Table FullWidth>
                    <TableBody>
                        @foreach (var item in dateOverrides)
                            {
                                <TableRow @key="item" VerticalAlignment="VerticalAlignment.Middle">
                                    <TableRowCell>
                                        <span>@item.Value.Date.ToString("MMMM dd, yyyy")</span>
                                    </TableRowCell>
                                    <TableRowCell>
                                        <span>@TimeToString(item.Value.TimeStart)- @TimeToString(item.Value.TimeEnd)</span>
                                    </TableRowCell>
                                    <TableHeaderCell>
                                        <Button Clicked="() => dateOverrides.Remove(item.Key)">
                                            <img src="/images/ote/delete-icon.png" alt="delete">
                                        </Button>
                                    </TableHeaderCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </div>
            </div>
        </div>
    }
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
    <Modal @ref="modalScheduleGuid">
        <ModalContent Size="ModalSize.Large" class="border-radius-20">
            <ModalHeader class="justify-content-center pb-0">
                <div class="d-flex justify-content-center align-items-center m-margin-top-75">
                    <img src="images/ote/light-bulb.png" class="me-3 m-d-none" alt="icon">
                    <p class="font-32 font-weight-700 color-black-100 mb-0 m-font-24">Create a better schedule</p>
                </div>
                <button type="button" style="top: 28px; right: 20px;" class="btn-close position-absolute" @onclick="CloseGuide" />
            </ModalHeader>
            <ModalBody class="color-grey-100 font-18 m-font-16">
                <p>
                    Follow these guidelines based on the recurrence frequency, you can effectively structure the schedule for your one-time event,
                    ensuring clarity and engagement for all participants.
                </p>
                <ol class="ps-4">
                    <li class="color-black-100 font-weight-700 mb-3">
                        Do Not Repeat:
                        <div class="font-weight-400 color-grey-100" style="margin-left: -17px;">
                            <p>-Indicates that a particular event or activity should not occur again after its initial instance.</p>
                            <p class="mb-0">Sample:</p>
                            <p class="mb-0">"Special Anniversary Dinner on January 15, 2024, at 7:00 PM."</p>
                        </div>
                    </li>
                    <li class="color-black-100 font-weight-700 mb-3">
                        Daily:
                        <div class="font-weight-400 color-grey-100" style="margin-left: -17px;">
                            <p>-Daily recurrences involve events or activities that happen regularly and repeat on a daily basis.</p>
                            <p class="mb-0">Sample:</p>
                            <p class="mb-0">Event: Daily Morning Yoga Sessions</p>
                            <p class="mb-0">Start Date: March 1, 2024</p>
                            <p class="mb-0">End Date: March 15, 2024</p>
                            <p class="mb-0">From: 7:00 AM</p>
                            <p class="mb-0">To: 8:00 AM</p>
                            <p class="mb-0">Recurring Daily: Monday to Friday</p>
                        </div>
                    </li>
                    <li class="color-black-100 font-weight-700 mb-3">
                        Weekly:
                        <div class="font-weight-400 color-grey-100" style="margin-left: -17px;">
                            <p>-Weekly recurrences refer to events or activities that occur regularly and repeat every seven days.</p>
                            <p class="mb-0">Sample:</p>
                            <p class="mb-0">Event: Weekly Photography Class</p>
                            <p class="mb-0">Start Date: April 1, 2024</p>
                            <p class="mb-0">End Date: June 30, 2024</p>
                            <p class="mb-0">From: 6:00 PM</p>
                            <p class="mb-0">To: 8:00 PM</p>
                            <p class="mb-0">Recurring Weekly: Every Saturday</p>
                        </div>
                    </li>
                    <li class="color-black-100 font-weight-700 mb-3">
                        Monthly:
                        <div class="font-weight-400 color-grey-100" style="margin-left: -17px;">
                            <p>-Monthly recurrences denote events or activities that regularly repeat every calendar month.</p>
                            <p class="mb-0">Sample: Event: Monthly Book Club Meeting</p>
                            <p class="mb-0">Start Date: July 1, 2024</p>
                            <p class="mb-0">End Date: December 31, 2024</p>
                            <p class="mb-0">From: 4:00 PM</p>
                            <p class="mb-0">To: 6:00 PM</p>
                            <p class="mb-0">Recurring Monthly: First Sunday of Each Month</p>
                        </div>
                    </li>
                </ol>
            </ModalBody>
        </ModalContent>
        </Modal>
    <Modal @ref="modalCalendar">
        <ModalContent>
            <ModalHeader class="justify-content-center">
                <p class="m-0 color-black-100">Select the date(s) you want to assign specific hours</p>
            </ModalHeader>
            <ModalBody>
                <Calendar @ref="calendar" StoreClickedItems ViewOnly="false" StrikeOutNotSelected UnHighlightLoadedDates Flat
                          SelectedDates="generatedDates.Select(g => g.Date)"
                          CurrentDate="generatedDates.Select(g => g.Date).FirstOrDefault()" />
                </ModalBody>

                <ModalFooter class="d-block">
                <div>
                    <h3 class="font-20 text-center color-black-100">What hours will you be available?</h3>
                    <div class="d-flex justify-content-center mt-4 mb-3 align-items-center">
                        <Field>
                            <FieldBody>
                                <TimeEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5"
                                          Size="Size.Medium" TValue="TimeSpan" @bind-Time="ModelState.TimeStart" />
                            </FieldBody>
                        </Field>
                        <span class="mx-2">-</span>
                        <Field>
                            <FieldBody>
                                <TimeEdit class="font-18 border-radius-10 m-font-16 m-border-radius-5"
                                          Size="Size.Medium" TValue="TimeSpan" @bind-Time="ModelState.TimeEnd" />
                            </FieldBody>
                        </Field>
                    </div>
                </div>
                </ModalFooter>

                <ModalFooter class="justify-content-center pt-4">
                <Button Clicked="CloseCalendar" class="text-capitalize bg-transparent border-color-grey-200 border-radius-10 px-5">
                    cancel
                </Button>
                <Button Clicked="SetOverrideDates" class="text-capitalize bg-orange-100 color-white-100 border-radius-10 px-5 hover-color-white">
                    apply
                </Button>
                </ModalFooter>

                </ModalContent>
                </Modal>
    <Modal @ref="modalError">
                <ModalContent Centered class="border-radius-15">
            <ModalHeader class="justify-content-center pb-0">
                <p class="font-20 font-weight-700 color-black-100 mb-0">Error Message</p>
                <button type="button" style="top: 22px; right: 20px;" class="btn-close position-absolute" @onclick="CloseErrorMessage" />
            </ModalHeader>

            <ModalBody class="px-4">
                <div class="color-black-100">
                    @errorMessageAlert
                </div>
            </ModalBody>
        </ModalContent>
        </Modal>
    <Modal @ref="modalReschedule">
        <ModalContent Centered>

            <ModalHeader class="justify-content-center position-relative">
                <p class="font-weight-700 m-0 color-black-100">Reschedule Event </p>
                <button type="button" style="top: 28px; right: 25px; width 15px; height: 15px;"
                        class="btn-close position-absolute p-0"
                        @onclick="() => modalReschedule.Close(CloseReason.UserClosing)" />
            </ModalHeader>

            <ModalBody class="pt-0">
                <p class="font-16 m-font-14 color-grey-100 text-center mb-4">
                    As an activity providers you should be able to tag what is the NEW
                    date for the customers that bought the tickets
                </p>
                @* <Divider class="mt-0 mb-3" /> *@
                <Row HorizontalGutter="20">
                    <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop">
                        @if (viewReschedules.Count > 0)
                        {
                            <div class="border-1-solid border-color-grey-200 border-radius-10 overflow-hidden">
                                <Calendar @ref="rescheduleCalendar" CurrentDate="viewReschedules.First().NewDate" Flat
                                      SelectedDates="viewReschedules.Select(s => s.NewDate)" ViewOnly
                                      OnNextMonthChanged="OnCurrentMonthChangedCalendarView"
                                      OnPreviousMonthChanged="OnCurrentMonthChangedCalendarView" />
                            </div>
                        }
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                        <div class="mt-3 mt-md-0">
                            <p class="text-capitalize font-16 color-black-100 mb-2 font-weight-700">select date range</p>

                            <Validations @ref="scheduleFilterValidation" Mode="ValidationMode.Manual" Model="scheduleFilter">
                                <Row>
                                    <Column ColumnSize="ColumnSize.Is6.Is12.OnDesktop">
                                        <Validation>
                                            <Field class="mb-3">
                                                <FieldLabel class="font-12 text-capitalize color-grey-100 mb-1">
                                                    From
                                                </FieldLabel>
                                                <FieldBody>
                                                    <DateEdit class="font-16 border-radius-10 field-width m-border-radius-5 color-grey-100"
                                                              Size="Size.ExtraSmall"
                                                              TValue="DateTime" @bind-Date="scheduleFilter.DateFrom">
                                                        <Feedback>
                                                            <ValidationError />
                                                        </Feedback>
                                                    </DateEdit>
                                                </FieldBody>
                                            </Field>
                                        </Validation>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is6.Is12.OnDesktop">
                                        <Validation>
                                            <Field>
                                                <FieldLabel class="font-12 text-capitalize color-grey-100 mb-1">
                                                    To
                                                </FieldLabel>
                                                <FieldBody>
                                                    <DateEdit class="font-16 border-radius-10 field-width m-border-radius-5 color-grey-100"
                                                              Size="Size.ExtraSmall"
                                                              TValue="DateTime" @bind-Date="scheduleFilter.DateTo">
                                                        <Feedback>
                                                            <ValidationError />
                                                        </Feedback>
                                                    </DateEdit>
                                                </FieldBody>
                                            </Field>
                                        </Validation>
                                    </Column>
                                </Row>
                            </Validations>

                            <Button Clicked="FilterDateSchedule"
                                    class="font-16 bg-grey-200 color-grey-100 px-3 py-1 mt-0 mt-md-3 w-100 m-width-50">
                                Search
                            </Button>
                        </div>
                    </Column>
                </Row>

                <Divider class="my-4" />

                <Table Borderless>
                    <TableHeader>
                        <TableHeaderCell class="color-black-100">
                            Current Date
                        </TableHeaderCell>
                        <TableHeaderCell>

                        </TableHeaderCell>
                        <TableHeaderCell class="color-black-100">
                            New Date
                        </TableHeaderCell>
                    </TableHeader>
                </Table>
                <div id="available-dates">
                    @foreach (var item in filteredSchedules.OrderBy(d => d.OldDate))
                    {
                        <div class="d-flex justify-content-center align-items-center mb-3">
                            <DateEdit Disabled class="reschedule-date-width color-black-100 font-18 border-radius-10 m-font-16 m-border-radius-5"
                                  Size="Size.ExtraSmall"
                                  TValue="DateTime" @bind-Date="item.OldDate">
                            </DateEdit>
                            <img src="images/icons/date-to.png" class="mx-2" alt="icon">
                            <DateEdit class="reschedule-date-width color-black-100 font-18 border-radius-10 m-font-16 m-border-radius-5"
                                  Size="Size.ExtraSmall"
                                  TValue="DateTime" @bind-Date="item.NewDate">
                            </DateEdit>

    private async Task OnCurrentMonthChanged(Calendar.CalendarCurrentMonth value)
    {
        var from = new DateTime(value.Year, value.Month, 1);
        var to = from.LastDayOfMonth();

        var dateItems = await LoadScheduleDates(from, to);
        if (dateItems.Count() > 0)
        {
            viewSchedules.Clear();
            viewSchedules.AddRange(dateItems);

            seeScheduleCalendar.LoadCalendarItems();
        }
    }

    private async Task OnCurrentMonthChangedCalendarView(Calendar.CalendarCurrentMonth value)
    {
        var from = new DateTime(value.Year, value.Month, 1);
        var to = from.LastDayOfMonth();

        var dateItems = await LoadScheduleDates(from, to);
        if (dateItems.Count() > 0)
        {
            viewReschedules.Clear();
            viewReschedules.AddRange(dateItems);

            rescheduleCalendar.LoadCalendarItems();
        }
    }

    private async Task<IEnumerable<DateReschedule>> LoadScheduleDates(DateTime from, DateTime to)
    {
        try
        {
            var result = await activityApiHandler.OteScheduleDates(new Framework.ApiCommand.ApiCore.Activity.Request.OteScheduleDatesArgs
                {
                    ActivityId = ModelState.ActivityId,
                    From = from.ToString("yyyyMMdd"),
                    To = to.ToString("yyyyMMdd")
                }, Token);
            if (result.Succeeded && result.Result is not null && result.Result.IsSuccess && result.Result.Result.Count() > 0)
            {
                return result.Result.Result.Select(d => new DateReschedule
                    {
                        Id = d.Id,
                        NewDate = d.Date,
                        OldDate = d.Date
                    });
            }

            return Enumerable.Empty<DateReschedule>();
        }
        catch (Exception ex)
        {
            return Enumerable.Empty<DateReschedule>();
        }
    }

    private async Task FilterDateSchedule()
    {
        if (scheduleFilterValidation is not null && await scheduleFilterValidation.ValidateAll())
        {
            var items = await LoadScheduleDates(scheduleFilter.DateFrom, scheduleFilter.DateTo);
            filteredSchedules.Clear();
            foreach (var item in items)
            {
                if (appliedSchedules.ContainsKey(item.Id))
                {
                    item.NewDate = appliedSchedules[item.Id].NewDate;
                }
                filteredSchedules.Add(item);
            }
        }
    }

    private record DateReschedule
    {
        public int Id { get; set; }

        [Required]
        public DateTime OldDate { get; set; }

        [Required]
        public DateTime NewDate { get; set; }
    }

    private record DateItem
    {
        public DateTime Date { get; set; }
        public DateTime DateStart { get; set; }
        public DateTime DateEnd { get; set; }
    }

    private class ScheduleFilter
    {
        [Required]
        public DateTime DateFrom { get; set; } = DateTime.Now.FirstDayOfMonth();

        [DateLessThan("DateFrom", ErrorMessage = "Invalid date range.")]
        public DateTime DateTo { get; set; } = DateTime.Now.LastDayOfMonth();
    }

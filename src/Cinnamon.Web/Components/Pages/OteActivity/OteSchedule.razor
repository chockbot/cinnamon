    private async Task UpdateReschedule()
    {
        foreach (var item in filteredSchedules)
        {
            if (appliedSchedules.ContainsKey(item.Id))
            {
                var appliedSchedule = appliedSchedules[item.Id];
                appliedSchedule.NewDate = item.NewDate;
            }
            else
            {
                appliedSchedules.Add(item.Id, new DateReschedule
                    {
                        Id = item.Id,
                        NewDate = item.NewDate,
                        OldDate = item.OldDate
                    });
            }
        }
        await modalReschedule?.Close(CloseReason.UserClosing);
    }


    public async Task<bool> FieldValid()
    {
        if (scheduleFormValidation is not null)
        {
            bool scheduleValid = await scheduleFormValidation.ValidateAll();
            if (!scheduleValid)
            {
                showErrors = true;
                StateHasChanged();
                await Task.Delay(300); // add delay to populate is-invalid class
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".ote-pricing-wrapper .is-invalid");
            }
            return scheduleValid;
        }
        return false;
    }


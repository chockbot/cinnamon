@namespace Cinnamon.Web.Components.Pages.OteActivity
@implements IOteComponent;
@inject IJSRuntime JS;  

<section class="ote-summary-wrapper">
    @if(Summary is not null)
    {
        <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
            <div>
                <h3 class="text-uppercase font-24 font-weight-700 color-orange-100 mb-2">@Summary.EventData.Name</h3>
                <p class="font-20 color-black-100 mb-0">
                    @((MarkupString)Summary.EventData.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>"))
                </p>
            </div>
            <Divider />
            <div>
                <h3 class="text-capitalize font-24 font-weight-700 color-orange-100 mb-2">Date & Time</h3>
                /* Switch case for recurrences */
                @switch (Summary.PricingData.Recurrences)
                {
                    case "daily":
                        DateTime? dailyStartDate = Summary.PricingData.DurationStart;
                        DateTime? dailyEndDate = Summary.PricingData.DurationEnd;
                        int dailyDurationEvery = Summary.PricingData.DurationEvery.HasValue ? Summary.PricingData.DurationEvery.Value : 1;
                        while (dailyStartDate.HasValue && dailyEndDate.HasValue && dailyStartDate.Value.Date <= dailyEndDate.Value.Date)
                        {
                            <p class="font-20 color-black-100 mb-0">
                                @dailyStartDate.Value.ToString("MMMM dd, yyyy")
                            </p>
                            dailyStartDate = dailyStartDate.Value.AddDays(dailyDurationEvery);
                        }
                        break;
                    case "weekly":
                        DateTime? weeklyStartDate = Summary.PricingData.DurationStart;
                        DateTime? weeklyEndDate = Summary.PricingData.DurationEnd;
                        List<string> weeklySelectedDays = Summary.PricingData.WeekString.Split('|').ToList();
                        int weeklyDurationEvery = Summary.PricingData.DurationEvery.HasValue ? Summary.PricingData.DurationEvery.Value : 1;
                        while (weeklyStartDate.HasValue && weeklyEndDate.HasValue && weeklyStartDate.Value.Date <= weeklyEndDate.Value.Date)
                        {
                            if (weeklySelectedDays.Contains(weeklyStartDate.Value.ToString("ddd").ToUpper()))
                            {
                            <p class="font-20 color-black-100 mb-0">
                                @weeklyStartDate.Value.ToString("MMMM dd, yyyy")
                            </p>
                            }
                            weeklyStartDate = weeklyStartDate.Value.AddDays(weeklyDurationEvery);
                        }
                        break;
                    case "monthly":
                        DateTime? monthlyStartDate = Summary.PricingData.DurationStart;
                        DateTime? monthlyEndDate = Summary.PricingData.DurationEnd;
                        int monthlyDurationEvery = Summary.PricingData.DurationEvery.HasValue ? Summary.PricingData.DurationEvery.Value : 1;
                        int? onDayDate = Summary.PricingData.OnDayDate;

                        if (onDayDate.HasValue)
                        {
                            monthlyStartDate = new DateTime(monthlyStartDate.Value.Year, monthlyStartDate.Value.Month, onDayDate.Value);
                        }
                        while (monthlyStartDate.HasValue && monthlyEndDate.HasValue && monthlyStartDate.Value.Date <= monthlyEndDate.Value.Date)
                        {
                            <p class="font-20 color-black-100 mb-0">
                                @monthlyStartDate.Value.ToString("MMMM dd, yyyy")
                                Month Day: @Summary.PricingData.MonthDay |
                                Month Repeat: @Summary.PricingData.MonthRepeat |
                                Month Select: @Summary.PricingData.MonthSelection |
                                Month OnDayDate: @Summary.PricingData.OnDayDate
                            </p>
                            monthlyStartDate = monthlyStartDate.Value.AddMonths(monthlyDurationEvery);
                        }
                        break;
                    case "every-weekday":
                        DateTime? everyWeekDayStartDate = Summary.PricingData.DurationStart;
                        DateTime? everyWeekDayEndDate = Summary.PricingData.DurationEnd;
                        List<string> everyWeekDaySelectedDays = Summary.PricingData.WeekString.Split('|').ToList();
                        int everyWeekDayDurationEvery = Summary.PricingData.DurationEvery.HasValue ? Summary.PricingData.DurationEvery.Value : 1;
                        while (everyWeekDayStartDate.HasValue && everyWeekDayEndDate.HasValue && everyWeekDayStartDate.Value.Date <= everyWeekDayEndDate.Value.Date);
                        {
                            if (everyWeekDaySelectedDays.Contains(everyWeekDayStartDate.Value.ToString("ddd").ToUpper()))
                            {
                            <p class="font-20 color-black-100 mb-0">
                                @everyWeekDayStartDate.Value.ToString("MMMM dd, yyyy")
                            </p>
                            }
                            everyWeekDayStartDate = everyWeekDayStartDate.Value.AddDays(everyWeekDayDurationEvery);
                        }
                        break;
                    default:
                    <p class="font-20 color-black-100 mb-0">
                        @Summary.PricingData.Recurrences
                        No recurrences
                    </p>
                    break;
                }
            </div>  
            <Divider />
            @if(Summary.LocationData.ExperienceType == 1)
            {
                string address = string.IsNullOrEmpty(Summary.LocationData.PinnedLocation) ? $"{Summary.LocationData.BarangayName + ", " + Summary.LocationData.CityName + ", " + Summary.LocationData.RegionName}" : Summary.LocationData.PinnedLocation;
                <div>
                    <h3 class="text-uppercase font-24 font-weight-700 color-orange-100 mb-2">venue</h3>
                    <p class="font-20 color-black-100 mb-0 text-capitalize">
                        @address
                    </p>
                    <Divider />
                </div>
            }
            <div>
                <h3 class="text-capitalize font-24 font-weight-700 color-orange-100 mb-4">ticket prices</h3>
                @foreach (var item in Summary.PricingData.ItemPrices)
                {
                    <p class="font-20 font-weight-700 color-green-100 mb-2">₱ @item.Price.ToString("#,###")</p>
                    <p class="font-16 color-grey-100 mb-3">@item.Description</p>
                }
            </div>
        </div>
    }
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>

@code 
{
    [Parameter]
    public EventCallback OnNextClick {get; set;}

    [Parameter]
    public EventCallback OnPrevClick {get; set;}
    
    [Parameter]
    public ComponentSummary Summary {get; set;}

    private bool invokingNext = false;

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            invokingNext = true;
            await OnNextClick.InvokeAsync();
            invokingNext = false;
        }
    }

    private async Task PrevClick()
    {
        if(OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }
    public Task<bool> FieldValid()
    {
        return Task.Run<bool>(() => true);
    }

    public class ComponentSummary 
    {
        public OteEvent.ModelData EventData {get; set;}
        public OteLocation.ModelData LocationData {get; set;}
        public OtePricing.ModelData PricingData {get; set;}
        public OtePublish.ModelData PublishData {get; set;}
        public OteOnlineEvent.ModelData OnlineData { get; set; }
    }
}

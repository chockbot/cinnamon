@namespace Cinnamon.Web.Components.Pages.OteActivity
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Framework.Helpers;
@implements IOteComponent;
@inject IJSRuntime JS;  

<section class="ote-summary-wrapper">
    @if(Summary is not null)
    {
        <div class="border-radius-10 bg-white-200 p-4 m-bg-white-100 m-padding-0">
            <div>
                <h3 class="text-uppercase font-24 font-weight-700 color-orange-100 mb-2">@Summary.EventData.Name</h3>
                <p class="font-20 color-black-100 mb-0">
                    @((MarkupString)Summary.EventData.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>"))
                </p>
            </div>
            <Divider />
            <div>
                <h3 class="text-capitalize font-24 font-weight-700 color-orange-100 mb-2">Date & Time</h3>
                <div class="date-group">
                @foreach (var date in GeneratedDates)
                {
                    <p class="font-20 color-black-100 mb-0">
                        • @date.Date.ToString("MMMM dd, yyyy") | @date.DateStart.ToString("hh:mm tt") - @date.DateEnd.ToString("hh:mm tt")
                    </p>
                }
                </div>
            </div>  
            <Divider />
            @if(Summary.LocationData.ExperienceType == 1)
            {
                string address = string.IsNullOrEmpty(Summary.LocationData.PinnedLocation) ? $"{Summary.LocationData.BarangayName + ", " + Summary.LocationData.CityName + ", " + Summary.LocationData.RegionName}" : Summary.LocationData.PinnedLocation;
                <div>
                    <h3 class="text-uppercase font-24 font-weight-700 color-orange-100 mb-2">venue</h3>
                    <p class="font-20 color-black-100 mb-0 text-capitalize">
                        @address
                    </p>
                    <Divider />
                </div>
            }
            <div>
                <h3 class="text-capitalize font-24 font-weight-700 color-orange-100 mb-4">ticket prices</h3>
                @foreach (var item in Summary.PricingData.ItemPrices)
                {
                    <p class="font-20 font-weight-700 color-green-100 mb-2">₱ @item.Price.ToString("#,###")</p>
                    <p class="font-16 color-grey-100 mb-3">@item.Description</p>
                }
            </div>
        </div>
    }
    <OteRouteButtons HavePrevious OnNextClick="NextClick" OnPreviousClick="PrevClick" />
</section>

@code 
{
    [Parameter]
    public EventCallback OnNextClick {get; set;}

    [Parameter]
    public EventCallback OnPrevClick {get; set;}

    [Parameter]
    public ComponentSummary Summary {get; set;}

    private bool invokingNext = false;

    private GenerateRecurrenceDate recurrenceHelper = new();

    private async Task NextClick()
    {
        if(OnNextClick.HasDelegate)
        {
            invokingNext = true;
            await OnNextClick.InvokeAsync();
            invokingNext = false;
        }
    }

    private async Task PrevClick()
    {
        if(OnPrevClick.HasDelegate)
        {
            await OnPrevClick.InvokeAsync();
        }
    }
    public Task<bool> FieldValid()
    {
        return Task.Run<bool>(() => true);
    }

    private IEnumerable<GenerateRecurrenceDate.DateItem> GeneratedDates 
    {
        get 
        {
            IEnumerable<GenerateRecurrenceDate.DateItem> dates = Enumerable.Empty<GenerateRecurrenceDate.DateItem>();
            
            if(Summary is not null && Summary.PricingData is not null)
            {
                var every = Summary.PricingData.DurationEvery ?? 0;
                var dateStart = Summary.PricingData.DurationStart ?? DateTime.Now;
                var dateEnd = Summary.PricingData.DurationEnd ?? DateTime.Now;;

                var timeStart = Summary.PricingData.DateFrom.TimeOfDay;
                var timeDuration = Summary.PricingData.DateTo - Summary.PricingData.DateFrom;

                string weekString = Summary.PricingData.WeekString ?? string.Empty;

                var monthSelection = Summary.PricingData.MonthSelection ?? 0;
                var onDayDate = Summary.PricingData.OnDayDate ?? 0;
                var monthRepeat = Summary.PricingData.MonthRepeat ?? string.Empty;
                var monthDay = Summary.PricingData.MonthDay ?? string.Empty;

                if(Summary.PricingData.BookedDates is not null && Summary.PricingData.BookedDates.Count() > 0)
                {
                    dates = Summary.PricingData.BookedDates.DistinctBy(d => d.NewDate).Select(d => new GenerateRecurrenceDate.DateItem {
                        Date = d.NewDate.Date,
                        DateStart = d.NewDate.Date.Add(timeStart),
                        DateEnd = d.NewDate.Date.Add(timeStart).Add(timeDuration)
                    });
                }
                else 
                {
                    dates = Summary.PricingData.Recurrences switch {
                        "every-weekday" => recurrenceHelper.GenerateWeekday(every, dateStart, dateEnd, timeDuration, timeStart),
                        "daily" => recurrenceHelper.GenerateDaily(every, dateStart, dateEnd, timeDuration, timeStart),
                        "weekly" => recurrenceHelper.GenerateWeekly(every, dateStart, dateEnd, timeDuration, timeStart, weekString),
                        "monthly" => recurrenceHelper.GenerateMonthly(every, dateStart, dateEnd, timeDuration, timeStart, monthSelection, 
                            onDayDate, monthRepeat, monthDay),
                        _ => recurrenceHelper.GenerateNoRepeat(Summary.PricingData.DateFrom, Summary.PricingData.DateTo)
                    };
                }
            }

            return dates;
        }    
    }

    public class ComponentSummary 
    {
        public OteEvent.ModelData EventData {get; set;}
        public OteLocation.ModelData LocationData {get; set;}
        public OtePricing.ModelData PricingData {get; set;}
        public OtePublish.ModelData PublishData {get; set;}
        public OteOnlineEvent.ModelData OnlineData { get; set; }
    }
}

@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models;
@inject IJSRuntime jsRuntime
@using Blazorise.Components
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Microsoft.AspNetCore.WebUtilities;
@using System.Net.Http.Headers;
@using Newtonsoft.Json;
@inject IActivityApiHandler activityApiHandler;
@inject Cinnamon.Web.Config.Config config;
@inject NavigationManager NavigationManager;

@*<ExperienceCreationGuideModal @ref="experienceCreationGuideModal"></ExperienceCreationGuideModal>*@

<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>

<div class="creation-overview color-black-100">
    <div class="row">
        @if (Model.Activity.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.ExperienceViaAppointment)
        {
            <div class="form-group">
                <table>
                    <tr>
                        <td>
                            <label for="title" class="form-control-label right-margin">Schedule Type</label>
                        </td>
                    </tr>
                </table>
                <div class="row">
                    <div class="col-lg-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="experience-type" id="via-cinnamon" @onchange="@(()=>ScheduleTypeChanged(1))" value="1" checked="@(Model.Activity.ScheduleType == Framework.Enums.Enums.ScheduleType.Internal ? true : false)">
                            <label class="form-check-label" for="online">
                                Cinnamon
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="experience-type" id="in-person" @onchange="@(()=>ScheduleTypeChanged(2))" value="2" checked="@(Model.Activity.ScheduleType == Framework.Enums.Enums.ScheduleType.Calendly ? true : false)">
                            <label class="form-check-label" for="in-person">
                                Calendly
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="calendly-button-section">
                            @if (Model.Activity.ScheduleType == Framework.Enums.Enums.ScheduleType.Calendly)
                            {
                                <button id="btnScheduleViaCalendly" type="button" class="btn btn-primary border-0" @onclick=ScheduleViaCalendly>Schedule Via Calendly</button>
                                <small class="form-text text-muted sub-details d-none d-sm-block d-md-block d-lg-block d-xl-block">@Model.Activity.SchedulingUrl</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="form-group">
            <table class="field-heading-section">
                <tr>
                    <td class="td-field-number d-none d-sm-table-cell">
                        <label class="field-number">1</label>
                    </td>
                    <td class="td-field-title">
                        <label for="title" class="form-control-label right-margin font-20 m-font-18">Title</label>
                    </td>
                    <td class="how-to-guide" style="display:flex" @onclick="() => howToModal.ShowModal()">
                        <label>How to do this</label>
                        <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon"/>
                    </td>
                </tr>
            </table>
            <input type="text" id="create-activity-title" @bind="Model.Activity.Title" class="form-control @RequiredCheck(Model.Activity.Title)" />
            <small class="form-text text-muted sub-details d-none d-sm-block d-md-block d-lg-block d-xl-block">Create a title for your class, activity or experience!</small>
            <small class="form-text text-muted sub-details pull-right" id="label-title-editor"></small>
        </div>
        <div class="form-group">
            <table class="field-heading-section">
                <tr>
                    <td class="td-field-number d-none d-sm-table-cell">
                        <label class="field-number-top-margin">2</label>
                    </td>
                    <td class="td-field-title">
                        <label for="title" class="form-control-label label-top-margin right-margin font-20 m-font-18">Description</label>
                    </td>
                </tr>
            </table>
            <textarea id="create-activity-description" @bind="Model.Activity.Description" class="@RequiredMin(Model.Activity.Description,20)"></textarea>
            <small class="form-text text-muted sub-details d-none d-sm-block d-md-block d-lg-block d-xl-block">Describe what you will offer!</small>
            <small class="form-text text-muted sub-details pull-right" id="label-description-editor"></small>
        </div>
        <div class="col col-12">
            <label for="category" class="form-control-label label-top-margin font-20 m-font-18 mb-1">Category</label>
            <select id="create-activity-category" @bind="Model.Activity.ExperienceCategoryId" class="form-control @RequiredCheck(Model.Activity.ExperienceCategoryId)">
                <option value="0">--Select Category--</option>
                @foreach (var cat in Model.ExperienceCategories.Where(e => e.Category != "New" && e.Category != "Shows & Concerts" && e.Category != "Event" && e.Category != "Corporate" && e.Category != "Tours & Attractions"))
                {
                    <option value="@cat.Id">@cat.Category</option>
                }
            </select>
        </div>
        <div class="col col-12">
            <label for="sub-category" class="form-control-label label-top-margin font-20 m-font-18 mb-1">Sub Category</label>
            @if (Model.Activity.ExperienceCategoryId != 0)
            {
                <select id="create-activity-sub-category" @bind="Model.Activity.SubCategoryId" class="form-control @RequiredCheck(Model.Activity.SubCategoryId)">
                    <option value="0">--Select Subcategory--</option>
                    @foreach (var cat in Model.SubCategories.Where(s => s.CategoryId == Model.Activity.ExperienceCategoryId).OrderBy(s => s.Name))
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            }
            else
            {
                <select id="create-activity-sub-category" class="form-control" disabled>
                    <option disabled selected>Select Sub-category</option>
                </select>
            }
        </div>
    </div>
</div>
<HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Create a better headline" />
@code {
    [Parameter]
    public Models.ExperienceCreationModel Model { get; set; }

    public string Code { get; set; }

    private HowToModal howToModal { get; set; }

    ExperienceCreationGuideModal experienceCreationGuideModal = new ExperienceCreationGuideModal();

    public string htmlString = Resources.App.OverviewString;

    protected override async Task OnInitializedAsync()
    {
    }

    private string ShowErrorMessage()
    {
        return Model.HasError ? "block" : "none";
    }

    private string RequiredCheck(String? value)
    {
        if (Model.HasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (Model.HasError && (value == null || value.Value == 0))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredMin(string text, int min)
    {
        if (!Model.HasError && string.IsNullOrEmpty(text)) return "form-control";
        if (Model.HasError && string.IsNullOrEmpty(text)) return "form-control invalid";

        // var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        // if (Model.HasError && length < min) return "form-control invalid";
        return "form-control";
    }

    public bool IsAllFieldsValidated()
    {
        if (string.IsNullOrEmpty(Model.Activity.Title)) return false;
        if (string.IsNullOrEmpty(Model.Activity.Description)) return false;
        //if (IsWordsLengthMin(Model.Activity.Description, 20)) return false;
        if (Model.Activity.ExperienceCategoryId <= 0) return false;
        if (Model.Activity.SubCategoryId <= 0) return false;

        return true;
    }

    private bool IsWordsLengthMin(string text, int min)
    {
        if (string.IsNullOrEmpty(text)) return true;

        var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        return length < min;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Overview Page");

            // await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.init", "#label-title-editor", "#create-activity-title", "Max", 15);
            // await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.init", "#label-description-editor", "#create-activity-description", "Min", 20);

            // await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.max", "#label-title-editor", "#create-activity-title", "Max", 15);
            // await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.maxMinWords.min", "#label-description-editor", "#create-activity-description", "Min", 20);

            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("code", out var code))
            {
                Code = code;
                await GetSchedulingUrl(code);
            }
        }
    }

    private void ScheduleTypeChanged(int val)
    {
        Model.Activity.ScheduleType = (Framework.Enums.Enums.ScheduleType)val;
    }

    private void ScheduleViaCalendly()
    {
        var url = $"{config.Authentication.Calendly.MainUrl}/oauth/authorize?client_id={config.Authentication.Calendly.ClientId}&response_type=code&redirect_uri={config.Authentication.Calendly.RedirectUri}";

        NavigationManager.NavigateTo(url);
    }

    private async Task GetSchedulingUrl(string code)
    {
        var postData = new List<KeyValuePair<string, string>>
        {
        };

        var tokenModel = new TokenModel();
        var userModel = new UserModel();

        HttpContent content = new FormUrlEncodedContent(postData);
        content.Headers.ContentType = new MediaTypeHeaderValue("application/x-www-form-urlencoded");

        using (var client = new HttpClient())
        {
            using (HttpResponseMessage response = await client.PostAsync($"{config.Authentication.Calendly.AuthUrl}oauth/token?grant_type=authorization_code&client_id={config.Authentication.Calendly.ClientId}&client_secret={config.Authentication.Calendly.ClientSecret}&code={code}&redirect_uri={config.Authentication.Calendly.RedirectUri}", content))
            {
                if (response.IsSuccessStatusCode)
                {
                    tokenModel = JsonConvert.DeserializeObject<TokenModel>(response.Content.ReadAsStringAsync().Result);
                }
            }
        }

        using (var client = new HttpClient())
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{config.Authentication.Calendly.ApiUrl}users/me");
            request.Headers.Add("Authorization", $"Bearer {tokenModel.AccessToken}");
            using (HttpResponseMessage response = await client.SendAsync(request))
            {
                if (response.IsSuccessStatusCode)
                {
                    userModel = JsonConvert.DeserializeObject<UserModel>(response.Content.ReadAsStringAsync().Result);

                    Model.Activity.SchedulingUrl = userModel.Resource.SchedulingUrl;
                    Model.Activity.ScheduleType = Framework.Enums.Enums.ScheduleType.Calendly;
                }       
            }
        }

        StateHasChanged();
    }
}

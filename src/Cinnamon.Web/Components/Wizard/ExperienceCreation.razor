@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@inject IJSRuntime jsRuntime

<h3 class="fw-bold mb-2">Experience creation</h3>
<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>
<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.nameThatExperience
            </label>
            <p>
                @Resources.App.nameThatExperienceParagraph
            </p>
        </div>
        <div class="textarea-container col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="d-flex flex-column">
                <textarea maxlength="80" @bind="activityModel.Title"></textarea>
                <label>@Resources.App.textAreaExperienceMax</label>
            </div>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.typeofExperience
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="experience-type" id="in-person" value=1 checked @oninput="CheckboxChanged">
                <label class="form-check-label" for="in-person">
                    @Resources.App.inPersonType
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="experience-type" id="online" value=2 @oninput="CheckboxChanged">
                <label class="form-check-label" for="online">
                    @Resources.App.onlineType
                </label>
            </div>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.experienceLocated
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if(viewModel.AddressDisable(activityModel.ExperienceTypeId))
            {
                <input class="form-control" placeholder="Address 1" disabled/>
                <input class="form-control my-3" placeholder="Address 2" disabled />
                <input class="form-control my-3" placeholder="District" disabled />
                <input class="form-control my-3" placeholder="City" disabled />
            }
            else{
                <input class="form-control @RequiredCheck(viewModel.Address1)" placeholder="Address 1" required @bind="viewModel.Address1"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.Address2)" placeholder="Address 2" required @bind="viewModel.Address2"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.District)" placeholder="District" required @bind="viewModel.District"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.City)" placeholder="City" required @bind="viewModel.City"/>
            }
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
               @Resources.App.experienceCategory
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <select class="form-control" >
                <option disabled selected>Select Category</option>
               @foreach(var cat in viewModel.ExperienceCategory)
               {
                   <option value="@cat.Category">@cat.Category</option>
               }
            </select>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.searchTags
            </label>
        </div>
        <div class="tagsinputcontainer col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <input id="tagsSearch" class="form-control" type="text" name="tags" value="" data-role="tagsinput" />
        </div>
    </div>
</div>

@code {
    IJSObjectReference module;
    [Parameter]
    public ActivityModel activityModel { get; set; }
    [Parameter]
    public ExperienceCreationViewModel viewModel { get; set; }

    private void CheckboxChanged(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            int value = int.Parse(e.Value.ToString());
            activityModel.ExperienceTypeId = value;
        }
    }

    private string RequiredCheck(String? value) {
        if (viewModel.HasError && String.IsNullOrEmpty(value)) {
            return "invalid";
        }

        return "";
    }

    private string ShowErrorMessage() {
        return viewModel.HasError ? "block" : "none";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Details Page Loaded");
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/ExperienceCreation.js");
        }
        await module.InvokeVoidAsync("TagsInputInit");
    }
}
    
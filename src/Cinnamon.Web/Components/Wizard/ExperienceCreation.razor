@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Models
@inject IJSRuntime jsRuntime

<h3 class="fw-bold mb-2">Experience creation</h3>
<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>
<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">
    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.nameThatExperience
            </label>
            <p>
                @Resources.App.nameThatExperienceParagraph
            </p>
        </div>
        <div class="textarea-container col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="d-flex flex-column">
                <textarea maxlength="80" @bind="activityModel.Title" class="@RequiredCheck(activityModel.Title)"></textarea>
                <label>@Resources.App.textAreaExperienceMax</label>
            </div>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.typeofExperience
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="experience-type" id="in-person" checked @onchange="@(()=>CheckboxChanged(1))">
                <label class="form-check-label" for="in-person">
                    @Resources.App.inPersonType
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="experience-type" id="online" @onchange="@(()=>CheckboxChanged(2))">
                <label class="form-check-label" for="online">
                    @Resources.App.onlineType
                </label>
            </div>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.experienceLocated
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            @if(viewModel.AddressDisable(activityModel.ExperienceTypeId))
            {
                <input class="form-control" placeholder="Address 1" disabled/>
                <input class="form-control my-3" placeholder="Address 2" disabled />
                <input class="form-control my-3" placeholder="District" disabled />
                <input class="form-control my-3" placeholder="City" disabled />
            }
            else{
                <input class="form-control @RequiredCheck(viewModel.Address.Address1)" placeholder="Address 1" required @bind="viewModel.Address.Address1"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.Address.Address2)" placeholder="Address 2" required @bind="viewModel.Address.Address2"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.Address.District)" placeholder="District" required @bind="viewModel.Address.District"/>
                <input class="form-control my-3 @RequiredCheck(viewModel.Address.City)" placeholder="City" required @bind="viewModel.Address.City"/>
            }
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
               @Resources.App.experienceCategory
            </label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
            <select @bind="activityModel.ExperienceCategoryId" class="form-control @RequiredCheck(activityModel.ExperienceCategoryId)">
                <option disabled selected>Select Category</option>
                @foreach (var cat in viewModel.ExperienceCategory)
                {
                    <option value="@cat.Id">@cat.Category</option>
                }
           </select>
        </div>
    </div>
    <div class="row mrow">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12 label-container-section text-lg-start text-md-start text-sm-center">
            <label class="fw-bold title-description">
                @Resources.App.searchTags
            </label>
        </div>
        <div class="tagsinputcontainer col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center d-flex flex-column">
            <div class="bootstrap-tagsinput @RequiredCheck(viewModel.SearchTags) d-flex flex-row flex-wrap ">
                @foreach (var tag in viewModel.SearchTags)
                {
                    <span class="tag label label-info m-1">
                        @tag.Value<span data-role="remove" @onclick="(()=>RemoveSearchTag(tag.Key))">

                        </span>
                    </span>
                }
                <input type="text" placeholder="" size="@SearchTagLength" @bind-value="SearchTag" @bind-value:event="oninput" @onkeydown="Enter">
            </div>
            <label>@Resources.App.searchTagMessage</label>
        </div>
    </div>
</div>

@code {
    IJSObjectReference module;
    [Parameter]
    public ActivityModel activityModel { get; set; }
    [Parameter]
    public ExperienceCreationViewModel viewModel { get; set; }
    public string SearchTag { get; set; }
    public int SearchTagLength { get; set; } = 0;
    private void CheckboxChanged(int val)
    {
        activityModel.ExperienceTypeId = val;
    }

    public void Enter(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            if (viewModel.SearchTags.Count < 5 && (viewModel.SearchTags.Where(x=>x.Value == SearchTag).FirstOrDefault()) == null)
            {
                viewModel.SearchTags.Add(new ExperienceCreationViewModel.SearchTag(){ Key = viewModel.SearchTags.Count + 1, Value = SearchTag });
            }
            SearchTag = string.Empty;
        }
    }

    private string RequiredCheck(List<ExperienceCreationViewModel.SearchTag> searchTags)
    {
        if (viewModel.HasError && searchTags.Count == 0)
        {
            return "invalid";
        }

        return "";
    }

    private void RemoveSearchTag(int Id){
        viewModel.SearchTags = viewModel.SearchTags.Where(x => x.Key != Id).ToList();
    }

    private string RequiredCheck(String? value) {
        if (viewModel.HasError && String.IsNullOrEmpty(value)) {
            return "invalid";
        }

        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (viewModel.HasError && value == null)
        {
            return "invalid";
        }

        return "";
    }

    private string ShowErrorMessage() {
        return viewModel.HasError ? "block" : "none";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Details Page Loaded");
        }
    }
}
    
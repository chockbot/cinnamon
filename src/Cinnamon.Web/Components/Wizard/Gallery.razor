@namespace Cinnamon.Web.Components
@inject IJSRuntime jsRuntime
@using Blazorise.Components
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@using System;
@using System.Text.RegularExpressions;

<div class="gallery-section col-12">
    @if(!string.IsNullOrEmpty(errorMessage))
    {
        <div id="error-message-container" class="mb-4 invalid">
            <ul id="error-list" class="fw-bold">
                @((MarkupString)errorMessage)
            </ul>
        </div>
    }

    <div class="row">
        <div class="form-group">
            <table class="field-heading-section">
                <tr>
                    <td>
                        <label for="title" class="form-control-label label-top-margin right-margin font-20 m-font-18">Post Pictures</label>
                    </td>
                    <td>
                        <img src="images/experience-creation/info-icon.svg" id="info-gallery" class="d-xl-none d-lg-none d-md-none d-sm-none d-block label-top-margin" alt="check-icon" data-image-url="images/experience-creation/creation-guide-step-5.svg" />
                    </td>
                </tr>
            </table>
            <p class="form-text text-muted label-top-margin">Pictures must have:</p>
            <ul>
                <li>Different angles and details, including photos of people at work.</li>
                <li>Innocent, yet illuminating, snippets from the experience.</li>
                <li>Top-notch picture quality, free from excessive effects like distortion, superimposition of text, and watermarks.</li>
            </ul>
            <div class="cover-photo-image-container-wrapper text-center mt-4">
                <div class="text-start font-16 mb-4 d-flex" style="justify-content: space-between;">
                    <div class="d-flex">
                        <span class="field-number d-inline-block me-2 flex-shrink-0">6</span>
                        <p class="color-grey-100 mb-0 ">
                            Cover Photo
                        </p>
                    </div>
                    <div class="how-to-guide" style="display:flex" @onclick="() => howToModal.ShowModal()">
                        <label>How to do this</label>
                        <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
                    </div>
                </div>
                <label for="cover-photo-upload" class="cursor-pointer w-100">
                    <InputFile id="cover-photo-upload" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="LoadFile" />
                    <div class='@(!coverPhotoItem.Display ? "empty-image-container bg-white-100" : "d-none")'>
                        <div>
                            <img src="images/gallery-icon.png" alt="gallery-icon">
                            <p class="mb-0 mt-1 font-16 color-grey-100">JPEG or PNG only</p>
                        </div>
                    </div>
                    <Row class="cover-photo-image-container justify-content-center" HorizontalGutter="30" VerticalGutter="30">
                        <div class='@(coverPhotoItem.Display ? "col-12 col-md-6 mb-4" : "d-none")' id="@coverPhotoItem.ContainerId">
                            <input type="hidden" id="@coverPhotoItem.InputDataId" name= "@coverPhotoItem.InputDataId" class="generated-input-data" />
                            <img id="@coverPhotoItem.ImageSrcId" class="w-100 border-1-dashed border-color-black-100" src="" alt="supporting-photo">
                            <img class="mt-2 cursor-pointer" @onclick="() => coverPhotoItem.Display = false" src="images/trashcan-icon.png" alt="delete">
                        </div>
                    </Row>
                </label>
            </div>
            <div class="photo-upload-section supporting-images-container-wrapper text-center">
                <div class="text-start font-16 mb-2 d-flex" style="justify-content: space-between;">
                    <div class="d-flex">
                        <span class="field-number d-inline-block me-2 flex-shrink-0">7</span>
                         <p class="color-grey-100 mb-0">Supporting Photos</p>
                    </div>
                    <div class="how-to-guide" style="display:flex" @onclick="() => howToModalSupporting.ShowModal()">
                        <label>How to do this</label>
                        <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
                    </div>
                </div>
                <p class="color-grey-100 font-16 supporting-text">
                   (Mimimum of 4 Photos. Maximum of 6 Photos)
                </p>
                <label for="photo-upload" style="cursor: pointer;">
                    <Button Type="ButtonType.Button" style="pointer-events: none;" Border="Border.Is0" class="btn-primary">
                        Choose Photos
                    </Button>
                    <InputFile multiple id="photo-upload" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="@LoadFiles" />
                    @if(imageItems.Count == 0)
                    {
                        <div class="empty-image-container bg-white-100 mt-4">
                            <div>
                                <img src="images/gallery-icon.png" alt="gallery-icon">
                                <p class="mb-0 mt-1 font-16 color-grey-100">JPEG or PNG only</p>
                            </div>
                        </div>
                    }
                </label>
                <Row class="supporting-images-container mt-4" HorizontalGutter="30" VerticalGutter="30">
                    @foreach(var item in imageItems)
                    {
                        <div @key="item" class='@(item.Display ? "col-12 col-md-6 mb-4" : "d-none")' id="@item.ContainerId">
                            <label for="@item.InputFileSrcId" class="cursor-pointer">
                                <InputFile id="@item.InputFileSrcId" accept=".png,.jpg,.jpeg" name="@item.InputFileSrcId" class="d-none" OnChange="(e) => LoadPerPhoto(e, item)" />
                                <input type="hidden" id="@item.InputDataId" name= "@item.InputDataId" class="generated-input-data" />
                                <img id="@item.ImageSrcId" class="w-100 border-1-dashed border-color-black-100" src="" alt="supporting-photo">
                            </label>
                            <img class="mt-2 cursor-pointer" @onclick="() => imageItems.Remove(item)" src="images/trashcan-icon.png" alt="delete">
                        </div>
                    }
                </Row>
            </div>
            <div class="cover-photo-image-container-wrapper mt-4">
                <div class="d-flex">
                    <span class="field-number d-inline-block me-2 flex-shrink-0">8</span>
                    <p class="color-grey-100 mb-0">
                        Supporting Video (Optional)
                    </p>
                </div>
                <div class="video-url mt-3">
                    <div class="col-12 col-lg-12 col-md-12 col-sm-12">
                        <label for="title" class="form-control-label mb-2 font-20 m-font-18">Url</label>
                        <p class="url-description">Enhance your activity with a video by pasting the link below. We recommend using YouTube or Vimeo.</p>
                        <input class="form-control @RequiredCheck(Model.Activity.VideoLink)" id="video-url" @bind="Model.Activity.VideoLink" placeholder="Paste your link here..." />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <ImageCropper @ref="imageCropper" />
</div>
<HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Cover Photo Guidelines" />
<HowToModal @ref="howToModalSupporting" HtmlContent="@htmlSupporting" Title="Supporting Photo Guidelines" />
@code 
{
    [Parameter]
    public Models.ExperienceCreationModel? Model { get; set; }

    private string errorMessage = string.Empty;

    private ImageCropper? imageCropper;

    private IList<ImageItem> imageItems = new List<ImageItem>();

    private ImageItem coverPhotoItem = new() { ContainerId = "cover-photo-container", 
        Display = false, FileSize = 0, 
        ImageSrcId = "cover-photo-image-src", 
        InputDataId = "cover-photo-input-data", Order = 0};

    private HowToModal howToModal { get; set; }

    private HowToModal howToModalSupporting { get; set; }

    public string htmlString = Resources.App.CoverPhotoString;

    public string htmlSupporting = Resources.App.SupportingPhotoString;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(3000);

            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Photos");
        }
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        if(imageCropper is not null)
        {
            var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                FileInputIndex = 0,
                FileSrcSelector = "#cover-photo-upload",
                Title = "Crop selected image",
                OuputSelector = $"#{coverPhotoItem.InputDataId}",
                HeightRatio = 5,
                WidthRatio = 4
            });
            if(cropperResult.Cropped)
            {
                await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{coverPhotoItem.ImageSrcId}", $"#{coverPhotoItem.InputDataId}");
                coverPhotoItem.FileSize = cropperResult.FileSize;
                coverPhotoItem.Display = true;
            }
            else 
            {
                coverPhotoItem.Display = false;
            }
        }
    }

    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles();
        var lastIndex = imageItems.Count > 0 ? imageItems.OrderByDescending(i => i.Order).First().Order + 1 : 1;

        for(int i = 0; i < files.Count; i++)
        {
            string inputId = $"img-preview-input-{lastIndex}";
            string imgId = $"img-preview-src-{lastIndex}";
            string inputFileSrc = $"input-file-src-{lastIndex}";

            var imageItem = new ImageItem {
                ContainerId = $"{imgId}-{inputId}", 
                FileSize = 0, 
                ImageSrcId = imgId, 
                InputDataId = inputId, 
                Order = lastIndex,
                InputFileSrcId = inputFileSrc
            };
            imageItems.Add(imageItem);
            StateHasChanged();
            lastIndex++;

            if(imageCropper is not null)
            {
                var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                    FileInputIndex = i,
                    FileSrcSelector = "#photo-upload",
                    Title = "Crop selected image",
                    OuputSelector = $"#{imageItem.InputDataId}",
                    HeightRatio = 4,
                    WidthRatio = 5
                });
                if(cropperResult.Cropped)
                {
                    await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{imgId}", $"#{inputId}");
                    imageItem.FileSize = cropperResult.FileSize;
                    imageItem.Display = true;
                }
                else 
                {
                    imageItems.Remove(imageItem);
                    lastIndex--;
                }
            }
            StateHasChanged();
        }
    }

    public async Task<bool> UploadImages(int createdActivityId)
    {
        var selectors = new List<ImageSelector>();
        selectors.Add(new ImageSelector {
            Order = coverPhotoItem.Order,
            Selector = $"#{coverPhotoItem.InputDataId}"
        });
        selectors.AddRange(imageItems.Select(i => {
            return new ImageSelector {
                Order = i.Order,
                Selector = $"#{i.InputDataId}"
            };
        }));

        var result = await jsRuntime.InvokeAsync<UploadResult>("MyLib.Pages.activity.creation.uploadListImages", 
                selectors, createdActivityId, new List<int>());
        return result.Success ?? false;
    }

    public bool IsAllFieldsValidated()
    {
        var supportedPhotosCount = imageItems.Count;
        var isHaveCoverPhoto = coverPhotoItem.Display;
        var totalFileSize = imageItems.Sum(i => i.FileSize) + coverPhotoItem.FileSize;
        var VideoLink = Model.Activity.VideoLink;

        var message = string.Empty;
        var isAllFieldsValid = true;
        if(supportedPhotosCount < 4 )
        {
            isAllFieldsValid = false;
            message += "<li>Minimum of 4 supported photos</li>";
        }
        if(supportedPhotosCount > 6)
        {
            isAllFieldsValid = false;
            message += "<li>Maximum of 6 supported photos</li>";
        }
        if(!isHaveCoverPhoto)
        {
            isAllFieldsValid = false;
            message += "<li>Required cover photo</li>";
        }
        if(totalFileSize > 25)
        {
            isAllFieldsValid = false;
            message += "<li>Total file size must only 25MB</li>";
        }
        if (!string.IsNullOrEmpty(VideoLink))
        {
            // Using regular expressions to check for YouTube or Vimeo links
            Regex youtubeRegex = new Regex(@"(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})", RegexOptions.IgnoreCase);
            Regex vimeoRegex = new Regex(@"(?:https?:\/\/)?(?:www\.)?(?:vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|video\/|)(\d+)(?:$|\/|\?))", RegexOptions.IgnoreCase);
            if (!youtubeRegex.IsMatch(VideoLink) && !vimeoRegex.IsMatch(VideoLink))
            {
                isAllFieldsValid = false;
                message += "<li>Please provide YouTube or Vimeo links only; other links are invalid.</li>";
            }
        }
        errorMessage = message;
        return isAllFieldsValid;
    }
    private string RequiredCheck(String? value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            // Using regular expressions to check for YouTube or Vimeo links
            Regex youtubeRegex = new Regex(@"(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})", RegexOptions.IgnoreCase);
            Regex vimeoRegex = new Regex(@"(?:https?:\/\/)?(?:www\.)?(?:vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|video\/|)(\d+)(?:$|\/|\?))", RegexOptions.IgnoreCase);

            if (!youtubeRegex.IsMatch(value) && !vimeoRegex.IsMatch(value))
            {
                return "invalid";
            }
            return "";
        }
        return "";
    }
    private async Task LoadPerPhoto(InputFileChangeEventArgs e, ImageItem imageItem)
    {
        if(imageCropper is not null)
        {
            var cropperResult = await imageCropper.CropImage(new ImageCropper.ImageCropperOptions {
                FileInputIndex = 0,
                FileSrcSelector = $"#{imageItem.InputFileSrcId}",
                Title = "Crop selected image",
                OuputSelector = $"#{imageItem.InputDataId}",
                HeightRatio = 4,
                WidthRatio = 5
            });
            if(cropperResult.Cropped)
            {
                await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.creation.previewImage", $"#{imageItem.ImageSrcId}", $"#{imageItem.InputDataId}");
                imageItem.FileSize = cropperResult.FileSize;
                imageItem.Display = true;
            }
        }
    }

    private class ImageItem 
    {
        public string ContainerId {get; set;} = string.Empty;
        public string ImageSrcId {get; set;} = string.Empty;
        public string InputDataId {get; set;} = string.Empty;
        public decimal FileSize {get; set;} = 0;
        public bool Display {get; set;} = false;
        public int Order {get; set;} = 0;
        public string InputFileSrcId {get; set;}
    }

    private class UploadResult 
    {
        public string? Message {get; set;}
        public bool? Success {get; set;}
    }

    private class ImageSelector 
    {
        public string Selector {get; set;}
        public int Order {get; set;}
    }
}

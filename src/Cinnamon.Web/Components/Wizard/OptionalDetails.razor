@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models;
@inject IJSRuntime jsRuntime
@using Blazorise.Components
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@using Blazorise.RichTextEdit;

<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>Fill in required field</li>
    </ul>
</div>
<div class="editor-customer-requirement-provide-wrapper color-black-100">
    <div class="editor-customer-requirement-provide">
        <div class="form-group">
            <table class="field-heading-section">
                <tr>
                    <td>
                        <label class="field-number-top-margin d-none d-sm-block d-md-block d-lg-block d-xl-block">5</label>
                    </td>
                    <td>
                        <label for="title" class="form-control-label label-top-margin font-20 m-font-18 mt-0">What should your students bring with them and what materials you will provide? (optional) <img src="images/experience-creation/info-icon.svg" id="info-optional-details" class="d-xl-none d-lg-none d-md-none d-sm-none d-block info-icon left-margin" alt="check-icon" data-image-url="images/experience-creation/creation-guide-step-4.svg" /></label>
                    </td>
                </tr>
            </table>
            <small class="form-text text-muted sub-details">Should your customer have their own tablet or computer for their online experience? How about their own water bottle for their face to face experience? Describe the things that they need to prepare and bring for the best experience possible.</small>

            <div class="textarea-container col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
                <div class="d-flex flex-column">
                    <RichTextEdit @ref="EditCustomerBring"
                                  Theme="RichTextEditTheme.Snow"
                                  ContentChanged="@EditCustomerRequirement"
                                  PlaceHolder="Type your post here..."
                                  SubmitOnEnter="false"
                                  ToolbarPosition="Placement.Start" id="customer-bring-with-them">
                        <Editor></Editor>
                        <Toolbar>
                            <RichTextEditToolbarGroup>
                                <RichTextEditToolbarButton Action="RichTextEditAction.Bold" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Italic" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="ordered" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="bullet" />
                            </RichTextEditToolbarGroup>
                        </Toolbar>
                    </RichTextEdit>
                    <label id="label-customer-requirement-editor"></label>
                </div>
            </div>
        </div>

        <div class="form-group">
            <table class="field-heading-section">
                <tr>
                    <td>
                        <label for="title" class="form-control-label label-top-margin font-20 m-font-18">Add your class policies (optional)</label>
                    </td>
                </tr>
            </table>
            <small class="form-text text-muted sub-details">Add your class policies regarding about the rules and regulations of your class. Tackle your reminders or what not to do, discuss to them what will happen if there are conflicts in schedule example are absences, internet problem or confusion in session consumption.</small>
            <div class="how-to-guide" style="display:flex" @onclick="() => howToModal.ShowModal()">
                <label>How to do this</label>
                <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
            </div>
            <div class="textarea-container col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
                <div class="d-flex flex-column">
                    <RichTextEdit @ref="EditClassPolicies"
                                  Theme="RichTextEditTheme.Snow"
                                  ContentChanged="@EditPolicies"
                                  PlaceHolder="Type your post here..."
                                  SubmitOnEnter="false"
                                  ToolbarPosition="Placement.Start" id="customer-bring-with-them">
                        <Editor></Editor>
                        <Toolbar>
                            <RichTextEditToolbarGroup>
                                <RichTextEditToolbarButton Action="RichTextEditAction.Bold" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Italic" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="ordered" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="bullet" />
                            </RichTextEditToolbarGroup>
                        </Toolbar>
                    </RichTextEdit>
                    <label id="label-customer-requirement-editor"></label>
                </div>
            </div>
        </div>
    </div>
</div>
<HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Sample Policy" />
@code {
    [Parameter]
    public Models.ExperienceCreationModel Model { get; set; }

    ExperienceCreationGuideModal experienceCreationGuideModal = new ExperienceCreationGuideModal();

    private HowToModal howToModal { get; set; }

    public string htmlString = Resources.App.OptionalString;

    private int maxEditorWordLimit = 80;
    private RichTextEdit EditCustomerBring;
    private RichTextEdit EditClassPolicies;
    IJSObjectReference module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(3000);

            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Requirements");

            await jsRuntime
                 .InvokeVoidAsync("MyLib.Pages.activity.quillLimitWords.init", ".editor-specific-will-provide .ql-container", "#label-specific-editor", maxEditorWordLimit);

            await jsRuntime
                .InvokeVoidAsync("MyLib.Pages.activity.quillLimitWords.init", ".editor-customer-requirement-provide .ql-container", "#label-customer-requirement-editor", maxEditorWordLimit);

            //module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/experience-image-helper.js");
        }
    }

    private string ShowErrorMessage()
    {
        return Model.HasError ? "block" : "none";
    }

    private string RequiredCheck(String? value)
    {
        if (Model.HasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (Model.HasError && (value == null || value.Value == 0))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredMin(string text, int min)
    {
        if (!Model.HasError && string.IsNullOrEmpty(text)) return "";
        if (Model.HasError && string.IsNullOrEmpty(text)) return "invalid";

        var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        if (Model.HasError && length < min) return "invalid";
        return string.Empty;
    }

    public bool IsAllFieldsValidated()
    {
        if (string.IsNullOrEmpty(Model.Activity.Title)) return false;
        if (string.IsNullOrEmpty(Model.Activity.Description)) return false;
        if (IsWordsLengthMin(Model.Activity.Description, 20)) return false;
        if (Model.Activity.ExperienceCategoryId <= 0) return false;

        return true;
    }

    private bool IsWordsLengthMin(string text, int min)
    {
        if (string.IsNullOrEmpty(text)) return true;

        var length = text.Trim().Split(" ").Where(t => !string.IsNullOrEmpty(t)).Count();
        return length < min;
    }

    private async Task EditCustomerRequirement()
    {
        Model.Activity.CustomerBringWithThem = await EditCustomerBring.GetHtmlAsync();
    }
    private async Task EditPolicies()
    {
        Model.Activity.ClassPolicies = await EditClassPolicies.GetHtmlAsync();
    }
}

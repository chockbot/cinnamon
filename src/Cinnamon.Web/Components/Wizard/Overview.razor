@namespace Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Data
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime jsRuntime

<div class="container">
    <div class="section-1 row">
        <div class="col-lg-5 justify-content-center col-md-5 justify-content-center">
            <img src="images/Cinnamon Maker/1st photo.jpg" class="img-fluid">
        </div>
        <div class="col-lg-7 col-md-7 col-sm-12 justify-content-center col-12 justify-content-center p-4">
            <h4>How do you create a Cinnamon Maker profile that stands out?</h4>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td><img src="images/Cinnamon Maker/1st ICON.png" class="img-icon text-center"></td>
                        <td>- Take your time building your profile to ensure that it is exactly as you desire.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/2nd ICON.png" class="img-icon text-center"></td>
                        <td>- Connect to your relevant professional organizations to boost your credibility.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/3rd ICON.png" class="img-icon text-center"></td>
                        <td>- Deliver an accurate description of the experience you will provide to assist you get more customers.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/4th ICON.png" class="img-icon text-center"></td>
                        <td>- Show me what you look like! Put up a profile picture that shows your face clearly.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/5th ICON.png" class="img-icon text-center"></td>
                        <td>- We may ask you to show your ID so that everyone can feel safe in our community.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="section-2 row">
        <div class="col-lg-6 justify-content-center col-md-7 col-sm-12 justify-content-center col-12 justify-content-center p-4">
            <h4>Who we are in Cinnamon?</h4>
            <h6>Cinnamon Makers are enthusiastic people who may give individual, families, especially those with children, a memorable and exciting opportunity to try something new. Here are the traits of a Cinnamon Maker:</h6>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td style="font-weight:bold">C</td>
                        <td>- Creative : Able to deliver unique and creative experiences</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">I</td>
                        <td>- Intuitive : Able to discern or understand the situation or customer at the onset</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">N</td>
                        <td>- Nurturing : Takes good care of the customer and has the customer’s welfare in mind</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">N</td>
                        <td>- Neighborly : Is a good “neighbor” by creating a safe space for the customer</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">A</td>
                        <td>- Adaptable : Can come up with alternative ideas when the need arises; Can adjust based on the situation</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">M</td>
                        <td>- Munificent : Generous in sharing knowledge and experience so that the customer would really see the experience as worth its cost</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">O</td>
                        <td>- Open : Has a listening ear to his/her customers. Able to receive feedback well, whether positive or negative</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold">N</td>
                        <td>- Notable : Can create a notable or memorable experience for the customers</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-lg-6 justify-content-center pt-3 col-md-5 justify-content-center pt-3">
                <img src="images/Cinnamon Maker/2nd photo.jpg" class="img-fluid">
            </div>
    </div>

    <div class="section-3 row">
        <div class="col-lg-5 justify-content-center col-md-5 justify-content-center">
            <img src="images/Cinnamon Maker/3rd photo.jpg" class="img-fluid">
        </div>
        <div class="col-lg-7 col-md-7 col-sm-12 justify-content-center col-12 justify-content-center  p-4">
            <h4>Now, let's talk about what you should stay away from</h4>
            <table class="table table-borderless">
                <tbody>
                    <tr>
                        <td><img src="images/Cinnamon Maker/6th ICON.png" class="img-icon text-center"></td>
                        <td> - Giving any false or misleading information about who you are.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/7th ICON.png" class="img-icon text-center"></td>
                        <td> - Asking to pay the fees outside of the Cinnamon platform.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/8th ICON.png" class="img-icon text-center"></td>
                        <td> - Creating more than one account. Always remember that you can make more experiences.</td>
                    </tr>
                    <tr>
                        <td><img src="images/Cinnamon Maker/9th ICON.png" class="img-icon text-center"></td>
                        <td> - Offering a service that is outside the set boundaries of Cinnamon.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
@code {

}

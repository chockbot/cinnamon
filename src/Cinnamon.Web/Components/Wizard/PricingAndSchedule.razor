@namespace Cinnamon.Web.Components
@using Cinnamon.Web.Models;
@inject IJSRuntime jsRuntime
@using Blazorise.Components
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;

<div id="error-message-container" class="mb-4" style="display:@ShowErrorMessage();">
    <ul id="error-list" class="fw-bold">
        <li>@ErrorMessage</li>
    </ul>
</div>
<div class="col-lg-12 justify-content-start col-md-12 justify-content-start col-sm-12 justify-content-center col-12 justify-content-center">
    <label for="title" class="pricing-title color-black-100">Pricing & Schedule</label>
</div>

<div class="pricing-schedule-section color-black-100">
    <div class="accordion" id="activitySchedules">
        @foreach (var scheduleModel in Model.Activity.ActivitySchedules.Where(a => !a.IsNew))
        {
            var accordionId = $"panel-section{scheduleModel.Id}";
            var accordionHeaderId = $"header-section{scheduleModel.Id}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@accordionHeaderId">
                    <div class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="true" aria-controls="@accordionId">
                        <span class="accordion-title">
                            @if (string.IsNullOrEmpty(scheduleModel.Name))
                            {
                                <span>N/A</span>
                            }
                            else
                            {
                                <span>@scheduleModel.Name</span>
                            }
                        </span>
                        <div class="ms-auto">
                            <span class="span-price">P @Math.Truncate(scheduleModel.Price)</span>
                        </div>
                    </div>
                </h2>
                <div id="@accordionId" class="accordion-collapse collapse" aria-labelledby="panel-section">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="form-group">
                                <div class="form-check form-switch">
                                    <div class="row">
                                       <div class="col-lg-12 col-sm-12 col-12 justify-content-start d-flex activity-expiration">
                                           <label for="title" class="form-control-label">Set Inactive/Active:</label>
                                           <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="scheduleModel.IsActiveSchedule">
                                       </div>
                                        <small class="form-text text-muted sub-details">You can set this as INACTIVE to mark as hidden/deleted, this will not be displayed.</small>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="title" class="form-control-label label-top-margin">Schedule Name</label>
                                <input class="form-control @RequiredCheck(scheduleModel.Name)" id="schedule-name" required @bind="scheduleModel.Name" />
                                <small class="form-text text-muted sub-details">Example: Beginner lessons for 5-9 y/o</small>
                            </div>
                            <div class="form-group">
                                <label for="title" class="form-control-label label-top-margin">Schedule Day & Time</label>
                                <input class="form-control @RequiredCheck(scheduleModel.DateTime)" id="schedule-time" required @bind="scheduleModel.DateTime" />
                                <small class="form-text text-muted sub-details">Example: Monday, Tuesday and Friday 9 a.m.–5 p.m. If a schedule is to be defined with the enrollee, you can put words in this section to explain the setup. Example: "Schedule will be determined with the enrollee".</small>
                            </div>
                            <div class="col col-lg-3">
                                <label for="title" class="form-control-label label-top-margin">Price</label>
                                <input class="form-control unit-input @RequiredCheck(scheduleModel.Price)" id="price-input" placeholder="Price" required @bind="scheduleModel.Price" />
                            </div>
                            <div class="col col-lg-3">
                                <label for="title" class="form-control-label label-top-margin">Session/s</label>
                                <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit2)" id="unit2-input" required @bind="scheduleModel.PerUnit2" type="number" min="1" maxlength="2" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" />
                            </div>
                            @*Expiration Section*@
                            <div class="col-lg-12 d-flex justify-content-center col-12 d-flex justify-content-center">
                                <label for="title" class="expiration-title">Activity Expiration</label>
                            </div>
                            <hr>
                            <div class="col-lg-12 col-sm-12 col-12 justify-content-start d-flex activity-expiration">
                                <label class="fw-bold title-description">
                                    Set Activity Expiration:
                                </label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input set-session" type="checkbox" id="flexSwitchCheckDefault" @bind="scheduleModel.IsSetSession">
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center mt-1">
                                <small class="form-text text-muted sub-details">Set your activity expiration to automatically manage your sessions for a specific timeframe. You can "Start on a specific date" (3rd day of the month, etc), or at the start of your customers first attendance.</small>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12 col-12 d-block set-expiration">
                                <label class="fw-bold title-description">
                                    Set expiration period
                                </label>
                                <div>
                                    <small class="form-text text-muted sub-details">Select how LONG your sessions should be consumed by your customers. </small>
                                </div>
                                @if (scheduleModel.IsSetSession == false)
                                {
                                    scheduleModel.SessionName = null;
                                    scheduleModel.HasExpiration = 0;
                                    scheduleModel.StartDate = null;
                                    <select class="form-control session-period" @bind="scheduleModel.SessionName" disabled="true">
                                        <option disabled selected>Select Period</option>
                                        @foreach (var sessionPeriod in Model.SessionPeriods)
                                        {
                                            <option value="@sessionPeriod">@sessionPeriod</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <select class="form-control session-period @RequiredCheck(scheduleModel.SessionName)" @bind="scheduleModel.SessionName">
                                        <option disabled selected>Select Period</option>
                                        @foreach (var sessionPeriod in Model.SessionPeriods)
                                        {
                                            <option value="@sessionPeriod">@sessionPeriod</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12 col-12 d-block expiration-start">
                                <label class="fw-bold title-description">
                                    Define start of expiration
                                </label>

                                <div class="form-check at-start">
                                    @if (scheduleModel.SessionName != null)
                                    {
                                        <input class="form-check-input @RequiredCheck(scheduleModel.HasExpiration)" type="radio" name="at-start-@scheduleModel.Id" id="at-start-@scheduleModel.Id" checked="@(scheduleModel.HasExpiration == 1 ? true : false)" @onchange="@(()=>CheckboxChanged(1,scheduleModel))">
                                        <label class="form-check-label" for="at-start">
                                            At the start of
                                        </label>
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="radio" name="at-start-@scheduleModel.Id" id="at-start-@scheduleModel.Id" checked="@(scheduleModel.HasExpiration == 1 ? true : false)" @onchange="@(()=>CheckboxChanged(1,scheduleModel))" disabled>
                                        <label class="form-check-label" for="at-start">
                                            At the start of
                                        </label>
                                    }

                                    @if (scheduleModel.HasExpiration == 1 && scheduleModel.SessionName != null)
                                    {
                                        <DateEdit Class="@RequiredCheck(scheduleModel.StartDate)" data-class="start-date" TValue="DateTime?" Placeholder="" @bind-Date="scheduleModel.StartDate">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    }
                                    else
                                    {
                                        <Tooltip Text="Please select expiration period to be able to enter start date." TextColor="TextColor.Danger" Multiline>
                                        <DateEdit TValue="DateTime?" Placeholder="" @bind-Date="scheduleModel.StartDate" ReadOnly>
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </DateEdit>
                                    </Tooltip>
                                    }
                                </div>

                                <div class="form-check first-attendance d-flex">
                                    @if (scheduleModel.SessionName != null)
                                    {
                                        <input class="form-check-input @RequiredCheck(scheduleModel.HasExpiration)" type="radio" name="first-attendance-@scheduleModel.Id" id="first-attendance-@scheduleModel.Id" checked="@(scheduleModel.HasExpiration == 2 ? true : false)" @onchange="@(()=>CheckboxChanged(2,scheduleModel))">
                                        <label class="form-check-label" for="first-attendance">
                                            Start of first attendance
                                        </label>
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="radio" name="first-attendance-@scheduleModel.Id" id="first-attendance-@scheduleModel.Id" checked="@(scheduleModel.HasExpiration == 2 ? true : false)" @onchange="@(()=>CheckboxChanged(2,scheduleModel))" disabled>
                                        <label class="form-check-label" for="first-attendance">
                                            Start of first attendance
                                        </label>
                                    }
                                </div>
                                @if (scheduleModel.HasExpiration == 2 && scheduleModel.SessionName != null)
                                {
                                    <div class="attendance-note">
                                        <small class="form-text text-muted sub-details">Note: Kindly check the first date that your customer attended in the CHECK ATTENDANCE section. This will be the start date of the validity period.</small>
                                    </div>
                                }
                            </div>
                            @if (scheduleModel.HasExpiration == 1 && scheduleModel.StartDate != null)
                            {
                                string ordinal = "";
                                DateTime frequency = DateTime.Now;
                                int day = scheduleModel.StartDate.Value.Day;
                                switch (scheduleModel.SessionName)
                                {
                                    case "2 Weeks":
                                        frequency = scheduleModel.StartDate.Value.AddDays(14);
                                        break;
                                    case "3 Weeks":
                                        frequency = scheduleModel.StartDate.Value.AddDays(21);
                                        break;
                                    case "1 Month":
                                        frequency = scheduleModel.StartDate.Value.AddMonths(1);
                                        break;
                                    case "2 Months":
                                        frequency = scheduleModel.StartDate.Value.AddMonths(2);
                                        break;
                                    case "3 Months":
                                        frequency = scheduleModel.StartDate.Value.AddMonths(3);
                                        break;
                                }

                                switch (frequency.Day)
                                {
                                    case 1:
                                    case 21:
                                    case 31:
                                        ordinal = "st";
                                        break;
                                    case 2:
                                    case 22:
                                        ordinal = "nd";
                                        break;
                                    case 3:
                                    case 23:
                                        ordinal = "rd";
                                        break;
                                    default:
                                        ordinal = "th";
                                        break;
                                }
                                switch (scheduleModel.SessionName)
                                {
                                    case "2 Weeks":
                                    case "3 Weeks":
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                            <small class="form-text text-muted sub-details">
                                                The expiration period is @scheduleModel.SessionName (calendar days) and will start on @scheduleModel.StartDate.Value.ToString("dd/MM/yyyy").
                                            </small>
                                        </div>
                                        break;
                                    case "1 Month":
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                            <small class="form-text text-muted sub-details">
                                                The expiration period is @scheduleModel.SessionName and the cutoff is every @frequency.Day@ordinal day of the month.
                                            </small>
                                        </div>
                                        break;
                                    case "2 Months":
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                            <small class="form-text text-muted sub-details">
                                                The expiration period is @scheduleModel.SessionName, and the cutoff is every @frequency.Day@ordinal day of the 3rd month.
                                            </small>
                                        </div>
                                        break;
                                    case "3 Months":
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 d-flex justify-content-center expiration-period-note">
                                            <small class="form-text text-muted sub-details">
                                                The expiration period is @scheduleModel.SessionName, and the cutoff is every @frequency.Day@ordinal day of the 4th month.
                                            </small>
                                        </div>
                                        break;
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="pricing-schedule">
        <div class="row mt-2">
            @foreach (var scheduleModel in Model.Activity.ActivitySchedules.Where(a => a.IsNew))
            {
                <div class="form-group">
                    <div class="form-check form-switch">
                        <div class="row">

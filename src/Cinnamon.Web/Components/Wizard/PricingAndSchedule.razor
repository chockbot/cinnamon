                            </td>
                            <td class="td-field-title">
                                <label for="title" class="form-control-label label-top-margin right-margin">Schedule Name</label>
                            </td>
                            <td class="how-to-guide" style="display:flex" @onclick="() => howToModal.ShowModal()">

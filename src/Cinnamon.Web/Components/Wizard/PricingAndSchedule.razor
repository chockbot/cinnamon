                                <img src="images/experience-creation/guide-icon.png" id="info-title" class="guide-icon" alt="check-icon" />
                            </td>
                        </tr>
                    </table>
                    <input class="form-control @RequiredCheck(scheduleModel.Name)" id="schedule-name" required @bind="scheduleModel.Name" />
                    <small class="form-text text-muted sub-details">Example: Beginner lessons for 5-9 y/o</small>
                </div>
                <div class="form-group">
                    <label for="title" class="form-control-label label-top-margin">Schedule Day & Time</label>
                    <input class="form-control @RequiredCheck(scheduleModel.DateTime)" id="schedule-time" required @bind="scheduleModel.DateTime" />
                    <small class="form-text text-muted sub-details">Example: Monday, Tuesday and Friday 9 a.m.–5 p.m. If a schedule is to be defined with the enrollee, you can put words in this section to explain the setup. Example: "Schedule will be determined with the enrollee".</small>
                </div>
                <div class="col col-lg-3">
                    <label for="title" class="form-control-label label-top-margin">Price</label>
                    <input class="form-control unit-input @RequiredCheck(scheduleModel.Price)" id="price-input" placeholder="Price" required @bind="scheduleModel.Price" />
                </div>
                <div class="col col-lg-3">
                    <label for="title" class="form-control-label label-top-margin">Session/s</label>
                    <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit2)" id="unit2-input" required @bind="scheduleModel.PerUnit2" type="number" min="1" maxlength="2" oninput="javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);" />
                </div>
                @*Expiration Section*@
                <div class="col-lg-12 d-flex justify-content-center col-12 d-flex justify-content-center">

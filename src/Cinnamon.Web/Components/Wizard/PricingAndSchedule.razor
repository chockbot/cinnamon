<br />
<div class="col-lg-12 justify-content-start col-md-12 justify-content-start col-sm-12 justify-content-center col-12 justify-content-center">
    <label for="title" class="pricing-title color-black-100">
        Add-ons
    </label>
    <label for="sub-title" class="addons-sub-title">
        Add extra materials or services that you can charge your customers. These additions provide valuable support and resources for your students. Some examples are - jersey or uniform fee, tournament fees, membership fee, materials fee and more! You can add more than one item/service to offer.
    </label>
</div>
<div class="pricing-schedule-section col-lg-12 col-md-12 col-sm-12 col-12">
    <div class="accordion" id="activitySchedules">
        @foreach (var addOnModels in Model.Activity.AddOns.Where(a => !a.IsNew && !a.IsDeleted))
        {
            var accordionId = $"panel-section{addOnModels.Id}";
            var accordionHeaderId = $"header-section{addOnModels.Id}";

            <div class="accordion-item">
                <h2 class="accordion-header" id="@accordionHeaderId">
                    <div class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@accordionId" aria-expanded="true" aria-controls="@accordionId">
                        <span class="accordion-title">
                            @if (string.IsNullOrEmpty(addOnModels.Name))
                            {
                                <span>N/A</span>
                            }
                            else
                            {
                                <span>@addOnModels.Name</span>
                            }
                        </span>
                        <div class="ms-auto">
                            <span class="span-price">P @Math.Truncate(addOnModels.Price)</span>
                        </div>
                    </div>
                </h2>
                <div id="@accordionId" class="accordion-collapse collapse" aria-labelledby="panel-section">
                    <div class="accordion-body">
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end">
                                <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" @onclick="() => DeleteClick(addOnModels)">
                                    <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                                </Button>
                            </div>
                            <div class="col-12 col-lg-8 col-md-7 col-sm-12">
                                <label for="title" class="form-control-label color-black-100">Add Item/Service</label>
                                <input class="form-control @RequiredCheck(addOnModels)" id="schedule-name" required @bind="addOnModels.Name" />
                            </div>
                            <div class="col-12 col-lg-4 col-md-5 col-sm-12">
                                <label for="title" class="form-control-label color-black-100">Price</label>
                                <input class="form-control unit-input @RequiredCheck(addOnModels)" id="price-input" type="number" placeholder="Price" required @bind="addOnModels.Price" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="pricing-schedule">
        <div class="row">
            @foreach (var addOnsModel in Model.Activity.AddOns.Where(a => a.IsNew))
            {
                <div class="row">
                    <div class="col-12 col-lg-8 col-md-7 col-sm-12">
                        <label for="title" class="form-control-label label-top-margin color-black-100">Add Item/Service</label>
                        <input class="form-control @RequiredCheck(addOnsModel)" id="schedule-name" required @bind="addOnsModel.Name" />
                    </div>
                    <div class="col-12 col-lg-4 col-md-5 col-sm-12">
                        <label for="title" class="form-control-label label-top-margin color-black-100">Price</label>
                        <input class="form-control unit-input @RequiredCheck(addOnsModel)" id="price-input" type="number" placeholder="Price" required @bind="addOnsModel.Price" />
                    </div>
                    <div class="col-12 justify-content-start">
                        <p class="example-add-on">Example: Uniform fee  - 1500</p>
                    </div>
                </div>
            }
            <div class="form-group">
                <button id="btnAddOns" type="button" class="btn btn-primary border-0" @onclick=CreateAddOns>Add More</button>
            </div>
        </div>
    </div>
</div>


<HowToModal @ref="howToModal" HtmlContent="@htmlString" Title="Create a better schedule" />
@code {
    [Parameter]
    public Models.ExperienceCreationModel Model { get; set; }

    DateTime? selectedDate;

    public string frequency { get; set; }

    IJSObjectReference module;

    private HowToModal howToModal { get; set; }

    ExperienceCreationGuideModal experienceCreationGuideModal = new ExperienceCreationGuideModal();

    public string htmlString = Resources.App.ScheduleString;

    public AddOn addOnToDelete = new AddOn();

    private ConfirmDialog confirmDialogRef { get; set; }

    private string ErrorMessage { get; set; } = "Fill in required field";

    protected override async Task OnInitializedAsync()
    {
        AddSchedule();
        CreateAddOns();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Creation.js");
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Price");
        }
    }

    private string ShowErrorMessage()
    {
        return Model.HasError ? "block" : "none";
    }

    private string RequiredCheck(String? value)
    {
        if (Model.HasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(DateTime? value)
    {
        if (Model.HasError && !value.HasValue)
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(AddOn addOn)
    {
        if (!addOn.IsNew)
        {
            if (string.IsNullOrEmpty(addOn.Name) || addOn.Price == 0 || string.IsNullOrEmpty(addOn.UnitPrice))
                return "invalid";
            if (!IsPositiveNumeric(addOn.Price))
                return "invalid";
        }
        else
        {
            if ((string.IsNullOrEmpty(addOn.Name) && addOn.Price != 0) || (!string.IsNullOrEmpty(addOn.Name) && addOn.Price == 0))
                return "invalid";
            if (!IsPositiveNumeric(addOn.Price)) return "invalid";
        }
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (Model.HasError && (value == null || value.Value <= 0))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (Model.HasError && (value == null || value <= 0))
        {
            return "invalid";
        }

        return "";
    }


    public bool IsAllFieldsValidated()
    {
        if (!IsAllSchedulesValid() || !IsAddOnsValid()) return false;
        return true;
    }

    private bool IsAllSchedulesValid()
    {
        bool isSingle = Model.Activity.ActivitySchedules.Count == 1;

        foreach (var schedule in Model.Activity.ActivitySchedules)
        {
            if ((string.IsNullOrEmpty(schedule.Name) ||
                string.IsNullOrEmpty(schedule.DateTime) ||
                schedule.Price <= 0 ||
                string.IsNullOrEmpty(schedule.UnitPrice) ||
                schedule.PerUnit1 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit1) ||
                schedule.PerUnit2 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit2)) && (schedule.IsActiveSchedule || isSingle))
                return false;

            if (schedule.IsSetSession == true)
            {
                if(schedule.HasExpiration == 0)
                    return false;
            }
            if (schedule.IsSetSession == true && schedule.HasExpiration == 1)
            {
                if ((string.IsNullOrEmpty(schedule.SessionName)
                || !schedule.StartDate.HasValue))

                    return false;
            }
            if (schedule.IsSetSession == true && schedule.HasExpiration == 2)
            {
                if (string.IsNullOrEmpty(schedule.SessionName))
                    return false;
            }
        }
        return true;
    }

    private bool IsAddOnsValid()
    {
        Model.Activity.AddOns = Model.Activity.AddOns.Where(a => !a.IsDeleted).ToList();
        foreach (var addOn in Model.Activity.AddOns)
        {
            if (!addOn.IsNew)
            {
                if (string.IsNullOrEmpty(addOn.Name) || addOn.Price == 0 || string.IsNullOrEmpty(addOn.UnitPrice))
                {
                    ErrorMessage = "Fill in required field";
                    return false;
                }

                if (!IsPositiveNumeric(addOn.Price))
                {
                    ErrorMessage = "Invalid Input. Please enter a positive number only.";
                    return false;
                }
            }
            else
            {
                if ((string.IsNullOrEmpty(addOn.Name) && addOn.Price != 0) || (!string.IsNullOrEmpty(addOn.Name) && addOn.Price == 0))
                {
                    ErrorMessage = "Fill in required field";
                    return false;
                }

                if (!IsPositiveNumeric(addOn.Price))
                {
                    ErrorMessage = "Invalid Input. Please enter a positive number only.";
                    return false;
                }

            }
        }
        return true;
    }

    private void CheckboxChanged(int val, ActivitySchedule schedule)
    {
        schedule.HasExpiration = val;
    }

    private void AddSchedule()
    {
        module.InvokeVoidAsync("scrollToPricingandSchedule");

        foreach (var item in Model.Activity.ActivitySchedules)
        {
            item.IsNew = false;
        }

        var maxIdItem = Model.Activity.ActivitySchedules.MaxBy(x => x.Id);
        var MaxOrder = Model.Activity.ActivitySchedules.MaxBy(s => s.Order);
        var maxId = 0;
        int order = 0;

        if (maxIdItem != null)
        {
            maxId = maxIdItem.Id;
        }
        if (MaxOrder != null)
        {
            order = maxIdItem.Order;
        }

        Model.Activity.ActivitySchedules.Add(new ActivitySchedule { Id = maxId + 1, PerUnit1 = 1, PerUnit2 = 1, Order = order + 1, IsNew = true });
    }
    private void CreateAddOns()
    {
        foreach (var item in Model.Activity.AddOns.Where(a => !a.IsDeleted))
        {
            item.IsNew = false;
        }

        var maxIdItem = Model.Activity.AddOns.MaxBy(x => x.Id);
        var MaxOrder = Model.Activity.AddOns.MaxBy(s => s.Order);
        var maxId = 0;
        int order = 0;

        if (maxIdItem != null)
        {
            maxId = maxIdItem.Id;
        }
        if (MaxOrder != null)
        {
            order = maxIdItem.Order;
        }

        Model.Activity.AddOns.Add(new AddOn { Id = maxId + 1, Order = order + 1, IsNew = true, IsDeleted = false});
    }

    private void DeleteClick(AddOn addOn)
    {
        Model.Activity.AddOns.Where(a => a.Id == addOn.Id).FirstOrDefault().IsDeleted = true;
        Model.Activity.AddOns = Model.Activity.AddOns.Where(a => !a.IsNew && !a.IsDeleted).OrderBy(a => a.Order).ToList();
    }

    private bool IsPositiveNumeric(decimal value)
    {
        return value >= -1;
    }
}

@code {
    [Parameter]
    public Models.ExperienceCreationModel Model { get; set; }

    DateTime? selectedDate;

    public string frequency { get; set; }

    ExperienceCreationGuideModal experienceCreationGuideModal = new ExperienceCreationGuideModal();

    List<ActivityScheduleTime> activityScheduleTimes = new List<ActivityScheduleTime>();
    List<ScheduleTime> scheduleTimes = new List<ScheduleTime>();

    Dictionary<int, string> dayOfWeekDictionary = new Dictionary<int, string>();

    DateTime startTime = new DateTime(2000, 1, 1, 0, 0, 0);
    DateTime endTime = new DateTime(2000, 1, 1, 23, 45, 0);
    List<DateTime> dateTimes = new List<DateTime>();

    protected override async Task OnInitializedAsync()
    {
        dayOfWeekDictionary.Add(0, "SUN");
        dayOfWeekDictionary.Add(1, "MON");
        dayOfWeekDictionary.Add(2, "TUE");
        dayOfWeekDictionary.Add(3, "WED");
        dayOfWeekDictionary.Add(4, "THU");
        dayOfWeekDictionary.Add(5, "FRI");
        dayOfWeekDictionary.Add(6, "SAT");

        while (startTime <= endTime)
        {
            dateTimes.Add(startTime);
            startTime = startTime.Add(new TimeSpan(0, 15, 0));
        }

        await AddSchedule();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "XP Price");
        }
    }

    private string ShowErrorMessage()
    {
        return Model.HasError ? "block" : "none";
    }

    private string RequiredCheck(String? value)
    {
        if (Model.HasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }
        return "";
    }
    private string RequiredCheck(DateTime? value)
    {
        if (Model.HasError && !value.HasValue)
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(int? value)
    {
        if (Model.HasError && (value == null || value.Value == 0))
        {
            return "invalid";
        }
        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (Model.HasError && (value == null || value == 0))
        {
            return "invalid";
        }

        return "";
    }

    public bool IsAllFieldsValidated()
    {
        if (Model.Activity.ScheduleType == Framework.Enums.Enums.ScheduleType.Internal)
        {
            if (!IsAllSchedulesValid()) return false;
            if (!AreAllSchedulesValid()) return false;

            return true;
        }
        else
        {
            return true;
        }
    }

    private bool IsAllSchedulesValid()
    {
        foreach (var schedule in Model.Activity.ActivitySchedules)
        {
            if (string.IsNullOrEmpty(schedule.Name))
                return false;

            if (schedule.PriceType == Framework.Enums.Enums.PriceType.PayToReserve)
            {
                if (schedule.Price == 0)
                {
                    return false;
                }
            }
        }

        return true;
    }
    private void CheckboxChanged(int val, ActivitySchedule schedule)
    {
        schedule.HasExpiration = val;
    }
    private async Task AddSchedule()
    {
        foreach (var item in Model.Activity.ActivitySchedules)
        {
            item.IsNew = false;
        }

        var maxIdItem = Model.Activity.ActivitySchedules.MaxBy(x => x.Id);
        var MaxOrder = Model.Activity.ActivitySchedules.MaxBy(s => s.Order);
        var maxId = 0;
        int order = 0;
        int scheduleTimeId = 1;

        if (maxIdItem != null)
        {
            maxId = maxIdItem.Id;
        }
        if (MaxOrder != null)
        {
            order = maxIdItem.Order;
        }

        Model.Activity.ActivitySchedules.Add(new ActivitySchedule { Id = maxId + 1, PerUnit1 = 1, PerUnit2 = 1, Order = order + 1, IsNew = true, SessionName = null });

        scheduleTimes = new List<ScheduleTime>();

        for (int i = 0; i < 7; i++)
        {
            scheduleTimes.Add(new ScheduleTime
            {
                DayOfWeek = i,
                Sort = i,
                IsEnabled = true,
                ActivityScheduleTimes = new List<ActivityScheduleTime>()
                {
                    new ActivityScheduleTime
                    {
                        ActivityScheduleTimeId = DateTime.Now.Ticks,
                        DayOfWeek = i,
                        StartTime = "09:00 AM",
                        EndTime = "05:00 PM",
                    }
                }
            });
        }

        await SortAndAssign(scheduleTimes);
    }

    private bool HasOverlap(DateTime start1, DateTime end1, DateTime start2, DateTime end2)
    {
        return start1 < end2 && end1 > start2;
    }

    private async Task AddScheduleTime(ScheduleTime schedule)
    {
        var scheduleTime = scheduleTimes.FirstOrDefault(s => s.DayOfWeek == schedule.DayOfWeek);

        if (scheduleTime.ActivityScheduleTimes.Any())
        {
            DateTime newStartTime = DateTime.ParseExact(scheduleTime.ActivityScheduleTimes.OrderByDescending(t => t.ActivityScheduleTimeId).FirstOrDefault().EndTime, "hh:mm tt", CultureInfo.InvariantCulture);

            newStartTime = newStartTime.Add(new TimeSpan(1, 0, 0));

            DateTime newEndTime = newStartTime.Add(new TimeSpan(1, 0, 0));


            scheduleTime.ActivityScheduleTimes.Add(new ActivityScheduleTime
            {
                ActivityScheduleTimeId = DateTime.Now.Ticks,
                DayOfWeek = scheduleTime.DayOfWeek,
                StartTime = newStartTime.ToString("hh:mm tt"),
                EndTime = newEndTime.ToString("hh:mm tt"),
            });
        }
        else
        {
            scheduleTime.ActivityScheduleTimes.Add(new ActivityScheduleTime
            {
                ActivityScheduleTimeId = DateTime.Now.Ticks,
                DayOfWeek = scheduleTime.DayOfWeek,
                StartTime = "09:00 AM",
                EndTime = "05:00 PM",
            });
        }

        await SortAndAssign(scheduleTimes);
        AreAllSchedulesValid();
    }

    private async Task RemoveScheduleTime(long activityScheduleTimeId)
    {
        foreach (var item in scheduleTimes)
        {
            item.ActivityScheduleTimes = item.ActivityScheduleTimes.Where(a => a.ActivityScheduleTimeId != activityScheduleTimeId).ToList();
        }

        await SortAndAssign(scheduleTimes);
        AreAllSchedulesValid();
    }

    private async Task SortAndAssign(List<ScheduleTime> scheduleTimes)
    {
        scheduleTimes = scheduleTimes.OrderBy(a => a.Sort).ToList();

        Model.Activity.ActivitySchedules.OrderByDescending(a => a.Id).FirstOrDefault().ScheduleTimes = scheduleTimes;
    }

    private bool AreAllSchedulesValid()
    {
        bool isValid = true;

        foreach (var scheduleTime in scheduleTimes)
        {
            foreach (var activityScheduleTime in scheduleTime.ActivityScheduleTimes)
            {
                DateTime activityScheduleStartTime = DateTime.ParseExact(activityScheduleTime.StartTime, "hh:mm tt", CultureInfo.InvariantCulture);
                DateTime activityScheduleEndTime = DateTime.ParseExact(activityScheduleTime.EndTime, "hh:mm tt", CultureInfo.InvariantCulture);

                if (activityScheduleStartTime > activityScheduleEndTime)
                {
                    isValid = false;
                    activityScheduleTime.Message = "Choose an end time later than the start time.";
                }
                else
                {
                    var otherScheduleTimes = scheduleTime.ActivityScheduleTimes.Where(s => s.ActivityScheduleTimeId != activityScheduleTime.ActivityScheduleTimeId);

                    foreach (var otherScheduleTime in otherScheduleTimes)
                    {
                        DateTime otherScheduleStartTime = DateTime.ParseExact(otherScheduleTime.StartTime, "hh:mm tt", CultureInfo.InvariantCulture);
                        DateTime otherScheduleEndTime = DateTime.ParseExact(otherScheduleTime.EndTime, "hh:mm tt", CultureInfo.InvariantCulture);

                        bool hasOverlap = HasOverlap(activityScheduleStartTime, activityScheduleEndTime, otherScheduleStartTime, otherScheduleEndTime);

                        if (hasOverlap)
                        {
                            isValid = false;
                            activityScheduleTime.Message = "Times overlap with another set of times.";
                        }
                        else
                        {
                            activityScheduleTime.Message = "";
                        }
                    }
                }

            }
        }

        return isValid;
    }

    private async Task SetScheduleStartTime(ChangeEventArgs e, long activityScheduleTimeId)
    {
        foreach (var item in scheduleTimes)
        {
            var timeDetail = item.ActivityScheduleTimes.FirstOrDefault(a => a.ActivityScheduleTimeId == activityScheduleTimeId);

            if (timeDetail != null)
            {
                timeDetail.StartTime = e.Value.ToString();
            }
        }

        AreAllSchedulesValid();
    }

    private async Task SetScheduleEndTime(ChangeEventArgs e, long activityScheduleTimeId)
    {
        foreach (var item in scheduleTimes)
        {
            var timeDetail = item.ActivityScheduleTimes.FirstOrDefault(a => a.ActivityScheduleTimeId == activityScheduleTimeId);

            if (timeDetail != null)
            {
                timeDetail.EndTime = e.Value.ToString();
            }
        }

        AreAllSchedulesValid();
    }

    private async Task SetPriceType(ChangeEventArgs e, ActivitySchedule activitySchedule)
    {
        activitySchedule.PriceType = (Framework.Enums.Enums.PriceType)int.Parse(e.Value.ToString());
    }
}

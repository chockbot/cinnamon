@code {
    [Parameter]
    public CreationViewModel ViewModel { get; set; }


    private void OnClickNext()
    {
        if (ViewModel.IsComplete)
        {
            var res = Task.Run(() => ViewModel.SaveActivity(ViewModel.activity)).Result;
            if (res)
            {
                //Dashboard
                navigationManager.NavigateTo("/");
            }
            else
            {
                //Do something
            }
        }
        else
        {
            ViewModel.NextStep();
        }
    }


    private string MainButtonText()
    {
        return ViewModel.IsComplete ? "Publish" : "Continue";
    }

}

@namespace Cinnamon.Web.Components
@using Cinnamon.Core

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.Name)" id="name-input" placeholder="Detailed Activity Breakdown" required @bind="scheduleModel.Name" />
       <i class="fa fa-trash" id="delete-icon" @onclick=DeleteSchedule></i>
   
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <p>
            Detailed activity breakdown if needed (age group, different sub-activity, etc)
        </p>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.DateTime)" placeholder="Frequency of Experience" required @bind="scheduleModel.DateTime" />
        <p>
            Example: Monday, Tuesday and Friday - 9am-5pm
        </p>
    </div>
    <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-lg-start text-md-start text-sm-center">
        <input class="form-control @RequiredCheck(scheduleModel.Price)" id="price-input" placeholder="Price" required @bind="scheduleModel.Price" />
        <div class="per-text">per</div>
        <input class="form-control @RequiredCheck(scheduleModel.PriceUnit1)" id="unit1-input" placeholder="Unit 1" required @bind="scheduleModel.PriceUnit1" />
        <div class="per-text">per</div>
        <input class="form-control @RequiredCheck(scheduleModel.PriceUnit2)" id="unit2-input" placeholder="Unit 2" required @bind="scheduleModel.PriceUnit2" />
    </div>

    <hr class="solid">
</div>
@code {
    [Parameter]
    public ScheduleModel scheduleModel { get; set; }
    [Parameter]
    public ExperienceSetupViewModel parentViewModel { get; set; }

    private void DeleteSchedule() {
        parentViewModel.RemoveSchedule(scheduleModel);
    }

    private string RequiredCheck(String? value)
    {
        if (parentViewModel.HasErrors && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }

        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (parentViewModel.HasErrors && (value == null || value == 0))
        {
            return "invalid";
        }

        return "";
    }

    private string ShowErrorMessage()
    {
        return parentViewModel.HasErrors ? "block" : "none";
    }

}

@namespace Cinnamon.Web.Components
@using Models
@using Models.Entities

<div class="row"> 
    <div class="col-lg-9 col-md-9 col-sm-11 col-11 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.Name)" id="name-input" placeholder="Detailed Activity Breakdown" required @bind="scheduleModel.Name" />
      
        @*<a class="button" @onclick=DeleteSchedule>
            <img src="images/icon-delete.png" class="img-icon">
        </a>
        @*<i class="fa fa-trash" id="delete-icon" @onclick=DeleteSchedule></i>*@
    </div>
    <div class="col-lg-3 justify-content-start col-md-3 justify-content-start col-sm-1 justify-content-start col-1 justify-content-start text-lg-start text-md-start text-sm-center label-container-section">
        <div class="form-check form-switch">
            <span class="active-label">Set Inactive/Active:</span>
            <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="scheduleModel.IsActiveSchedule">
            
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <p>
            Detailed activity breakdown if needed (age group, different sub-activity, etc)
        </p>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center label-container-section">
        <input class="form-control @RequiredCheck(scheduleModel.DateTime)" placeholder="Frequency of Experience" required @bind="scheduleModel.DateTime" />
        <p>
            Example: Monday, Tuesday and Friday - 9am-5pm
        </p>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-lg-start text-md-start text-sm-center px-0">
        <input class="form-control unit-input @RequiredCheck(scheduleModel.Price)" id="price-input" placeholder="Price" required @bind="scheduleModel.Price" />
        <input class="form-control unit-input @RequiredCheck(scheduleModel.UnitPrice)" id="price-input" placeholder="Unit Price" required @bind="scheduleModel.UnitPrice" readonly />
        <div class="per-text">per</div>
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit1)" id="unit1-input" required @bind="scheduleModel.PerUnit1" />
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PriceUnit1)" id="unit1-input" placeholder="Unit 1" required @bind="scheduleModel.PriceUnit1" readonly />
        <div class="per-text">per</div>
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PerUnit2)" id="unit2-input" required @bind="scheduleModel.PerUnit2" />
        <input class="form-control unit-input @RequiredCheck(scheduleModel.PriceUnit2)" id="unit2-input" placeholder="Unit 2" required @bind="scheduleModel.PriceUnit2" readonly />
    </div>
    
</div>

@code 
{
    [Parameter]
    public ActivitySchedule scheduleModel { get; set; }

    [Parameter]
    public ExperienceCreationModel Model { get; set; }

    [Parameter]
    public EventCallback<ExperienceCreationModel> ModelChanged {get; set;}

    private async Task DeleteSchedule() 
    {
        Model.Activity.ActivitySchedules.Remove(scheduleModel);
        await ModelChanged.InvokeAsync(Model);
    }

    private string RequiredCheck(String? value)
    {
        if (Model.HasError && String.IsNullOrEmpty(value))
        {
            return "invalid";
        }

        return "";
    }

    private string RequiredCheck(Decimal? value)
    {
        if (Model.HasError && (value == null || value == 0))
        {
            return "invalid";
        }

        return "";
    }

    private string ShowErrorMessage()
    {
        return Model.HasError ? "block" : "none";
    }

}

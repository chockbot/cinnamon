@namespace Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components
@using Models.Entities'

<Modal @ref="ModalRef">
    <ModalContent Padding="Padding.Is1">
        <ModalHeader Border="Border.Is0">
            <ModalTitle class="text-center col font-20 font-weight-700 color-black-000">Add Enrollees</ModalTitle>
            <Button Type="ButtonType.Button" class="btn-close" Clicked="() => ModalRef.Close(CloseReason.UserClosing)"></Button>
        </ModalHeader>
        <ModalBody Padding="Padding.Is0.FromTop">
            <Divider Margin="Margin.Is0.FromTop" />
            <p class="font-14 text-center color-black-100 mb-2">
                We do not share your information. It will be used when you purchase an experience for attendance monitoring.
            </p>
            <div class="list-enrollees mb-4">
                @for (int i = 0; i < localStateFamilyMembers.Count; i++)
                {
                    <ChildItem ErolleeCount="i + 1" @bind-Model="localStateFamilyMembers[i]" OnDelete="OnDeleteFamily" />
                }
            </div>
            <Div Display="Display.Flex" Flex="Flex.JustifyContent.End.OnDesktop.JustifyContent.Center.OnMobile">
                <Button class="me-2 font-weight-700 font-16" Border="Border.Is0"
                        TextColor="TextColor.White" Color="Color.Primary" style="width: 120px;" @onclick="AddFamilyMember">
                    Add More
                </Button>
                <Button Border="Border.Is0" class="font-weight-700 font-16" @onclick="OnSaveFamilyMember"
                    TextColor="TextColor.White" Color="Color.Primary" style="width: 120px;">
                    Submit
                </Button>
            </Div>
        </ModalBody>
    </ModalContent>
</Modal>

@code 
{
    private Modal ModalRef { get; set;}

    [Parameter]
    public IList<FamilyMember> Model { get; set; }

    [Parameter]
    public EventCallback<OnSaveButtonEventArgs> SaveEditedFamilyMember { get; set; } 

    private IList<FamilyMember> localStateFamilyMembers = new List<FamilyMember>();

    public string ModalDisplay = "none;";

    public string ModalClass = "";

    public bool ShowBackdrop = false;
    private bool isAutoSelectFlag = false;

    private Task OnSaveFamilyMember()
    {
        if(SaveEditedFamilyMember.HasDelegate)
        {
            SaveEditedFamilyMember.InvokeAsync(new OnSaveButtonEventArgs {FamilyMembers = localStateFamilyMembers, IsAutoSelect = isAutoSelectFlag});
        }
        return Task.CompletedTask;
    }

    private void OnDeleteFamily(FamilyMember member)
    {
        localStateFamilyMembers.Remove(member);

    }

    private void AddFamilyMember()
    {
        localStateFamilyMembers.Add(new() { BirthMonth = "january", BirthYear = 1900, Gender = "male", IsNew=true});
    }

    public void AddMemberField(int fieldCount, bool isAutoSelect = false)
    {
        while(fieldCount-- > 0)
        {
            AddFamilyMember();
        }
        StateHasChanged();
        this.isAutoSelectFlag = isAutoSelect;
    }

    public async Task Open()
    {
        localStateFamilyMembers = Model;
        await ModalRef.Show();
        StateHasChanged();
    }

    public async Task Close()
    {
        await ModalRef.Close(CloseReason.None);
    }

    public class OnSaveButtonEventArgs
    {
        public IList<FamilyMember>? FamilyMembers {get; set;}
        public bool IsAutoSelect { get; set; }
    }
}

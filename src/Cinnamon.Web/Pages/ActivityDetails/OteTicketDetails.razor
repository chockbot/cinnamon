@page "/transactions/ote-tickets/{Guid}/{Token}"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Framework.ApiCommand.ApiCore.DTO.Activity;
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler;
@inject IAccountApiHandler accountApiHandler
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService;
@inject IChatApiHandler chatApiHandler;


@if(ticketDetails is not null)
{
    @if (ticketDetails.EventLocation != "Online")
    {
        <div class="ticket-details-wrapper py-5">
            <Container>
                <div class="@(ticketDetails.Tickets.Count() > 1 ? "" : "ticket-info") row">
                    @foreach (var item in ticketDetails.Tickets)
                    {
                        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class="mb-3">
                            <div class="ticket-box overflow-hidden">
                                @if(ticketDetails.EventName.ToLower().Contains("jpark"))
                                {
                                    <div class="bg-orange-100 color-white-100 py-3">
                                        <p class="text-center mb-0 font-24" style='font-family: "Sansita One';">Cinnamon.ph</p>
                                    </div>
                                    <div class="ticket-details">
                                        <Row class="align-items-center">
                                            <Column ColumnSize="ColumnSize.Is12" class="px-3">
                                                <div class="ps-3">
                                                    <p class="font-weight-900 color-black-100 font-20 mb-0">@ticketDetails.EventName</p>
                                                    <p class="font-16 color-grey-100 mb-1">@ticketDetails.EventLocation</p>
                                                    <div class="text-center">
                                                        <img style="min-width: 200px; height: auto;" src="images/ote/company-logos/jpark-logo.png" alt="logo">
                                                    </div>
                                                    <Row class="mt-3">
                                                        <Column ColumnSize="ColumnSize.Is7">
                                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-calendar-icon.png" alt="calendar">
                                                                <p class="font-16 color-grey-100 mb-0 m-font-12">@ticketDetails.EventDate.ToString("MMMM dd, yyyy")</p>
                                                            </div>
                                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-ticket-icon.png" alt="ticket">
                                                                <p class="font-16 color-grey-100 mb-0 m-font-12">@item.Name</p>
                                                            </div>
                                                        </Column>
                                                        <Column ColumnSize="ColumnSize.Is5">
                                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-clock-icon.png" alt="clock">
                                                                <p class="font-14 color-grey-100 mb-0 m-font-12">@ticketDetails.EventDate.ToString("hh:mm tt")</p>
                                                            </div>
                                                        </Column>
                                                    </Row>
                                                </div>
                                            </Column>
                                        </Row>
                                        <div class="qr-details">
                                            <div class="text-center">
                                                <img class="img-qrcode" src="@item.QRCodeData" alt="qrcode">
                                                <p class="mb-0">
                                                    QR Code Number: @FormattedId(item.Id)
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="d-flex align-items-center justify-content-between py-3 px-5">
                                        <p class="mb-0">
                                            QR Code Number: @FormattedId(item.Id)
                                        </p>
                                        <img style="width: 100px; height: auto;" src="images/ote/company-logos/jpark-logo.png" alt="logo">
                                    </div> *@
                                }
                                else 
                                {
                                    <div class="p-3">
                                        <div>
                                            <h3 class="font-weight-700 font-30 color-black-100 mb-2 text-capitalize m-font-14">@ticketDetails.EventName</h3>
                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-pin-icon.png" alt="location">
                                                <p class="font-14 color-grey-100 mb-0 m-font-12">@ticketDetails.EventLocation</p>
                                            </div>
                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-calendar-icon.png" alt="calendar">
                                                <p class="font-14 color-grey-100 mb-0 m-font-12">@ticketDetails.EventDate.ToString("MMMM dd, yyyy")</p>
                                            </div>
                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-clock-icon.png" alt="clock">
                                                <p class="font-14 color-grey-100 mb-0 m-font-12">@ticketDetails.EventDate.ToString("hh:mm tt")</p>
                                            </div>
                                            <div class="d-flex mb-1 mb-md-3 align-items-center">
                                                <img class="me-2 m-width-10-px h-auto" src="images/ote/ticket-ticket-icon.png" alt="ticket">
                                                <p class="font-14 color-grey-100 mb-0 m-font-12">@item.Name</p>
                                            </div>
                                            <div class="text-center">
                                                <img class="img-qrcode" src="@item.QRCodeData" alt="qrcode">
                                                <p>@FormattedId(item.Id)</p>
                                            </div>
                                            <div>
                                                <p class="font-18 color-black-100 font-weight-700 text-center m-font-10 mb-0">Thank you for choosing <span class="font-weight-400 color-orange-100 font-familt-backline">Cinnamon!</span></p>
                                            </div>
                                        </div>
                                    </div>                                    
                                }
                            </div>
                        </Column>
                    }
                </div>
            </Container>
        </div>
    }
    else 
    {
        <Container>
            <Row class="mb-4 mt-5 ticket-box">
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <div class="event-image">
                        <img class="img-banner" src="@ticketDetails.ImageSrc" alt="event banner">
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <div class="event-details">
                        <p class="event-title">@ticketDetails.EventName</p>
                        <div class="event-type d-flex">
                            <img class="xp-type-img me-2" src="images/activity-summary/laptop-icon.png" alt="online" />
                            <label class="font-14 font-weight-700 color-white-100 rounded-pill bg-black-100 prevent-select px-3 py-1">Online</label>
                        </div>
                        <div class="event-schedule">
                            <p class="font-14  color-grey-100 mb-0 m-font-7">@ticketDetails.EventDate.DayOfWeek, @ticketDetails.EventDate.ToString("MMMM dd, yyyy")</p>
                            <p class="font-14 color-grey-100 mb-0 m-font-7">@ticketDetails.EventDate.ToString("hh:mm tt")</p>
                        </div>
                        <p class="event-description">@ticketDetails.EventDescription</p>
                    </div>
                </Column>
            </Row>
            <Divider />
            <Row class="mb-4 mt-4 ticket-schedule">
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile" class="event-column">
                    <p class="event-by">Event by</p>
                    <div class="d-inline-flex">
                        <div class="d-flex align-items-center me-2 me-md-5">
                            <img class="provider-avatar rounded-circle" src="@customerDetail.ProfilePath" alt="avatar">
                            <div class="ms-3">
                                <p class="text-capitalize font-16 font-weight-700 color-black-100 mb-0 m-font-16">@customerDetail.FirstName @customerDetail.LastName</p>
                                <label class="font-16 font-weight-400 color-grey-100 m-font-16">Joined @customerDetail.DateJoined.Year</label>
                            </div>
                        </div>
                    </div>
                    <button class="message-me" @onclick="() => MessageProvider(customerDetail.Id)">Message me</button>
                </Column>
                <Column ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile" class="ticket-column">
                    @foreach(var item in ticketDetails.Tickets)
                    {
                        DateTime now = DateTime.Now.Date;
                        DateTime eventDate = ticketDetails.EventDate.Date;
                        // Calculate the difference in days
                        TimeSpan timeUntilEvent = eventDate - now;
                        // Get the number of days left
                        int daysLeft = timeUntilEvent.Days;

                        <div class="online-ticket-wrapper">
                            <div class="header-title">
                                <div class="title">
                                    <img class="camera-img" src="images/camera-icon.png" alt="camera-icon">
                                    <p class="link-name">@item.LinkTitle</p>
                                </div>
                                <div class="start-in-section">
                                    @if (daysLeft == 0)
                                    {
                                        <p class="start-in">Ongoing</p>
                                    }
                                    else if (daysLeft >= 1)
                                    {
                                        <p class="start-in">Start in @daysLeft day@(daysLeft != 1 ? "s" : "")</p>
                                    }
                                    else
                                    {
                                        <p class="start-in">Expired</p>
                                    }

                                </div>
                            </div>
                            <div class="d-flex schedule-date">
                                <img class="me-2" src="images/ote/ticket-calendar-icon.png" alt="clock">
                                <label class="ote-schedule me-1">@eventDate.ToString("MMMM dd, yyyy")</label>
                            </div>
                            <div class="d-flex schedule-time">
                                <img class="me-2" src="images/ote/ticket-clock-icon.png" alt="clock">
                                <label class="ote-schedule me-1">@ticketDetails.EventDate.ToString("hh:mm tt")</label>
                            </div>
                            <Divider/>
                            @if (daysLeft > 1)
                            {
                                <Tooltip Multiline Text="Button will be enabled a day before the event.">
                                    <button class="button-disabled">View Event Link</button>
                                </Tooltip>
                                
                            }
                            else if (daysLeft == 1 || daysLeft == 0)
                            {
                                <a class="button-link" href="@item.VideoLink" target="_blank">View Event Link</a>
                            }
                            else
                            {
                                <Tooltip Multiline Text="Event ends.">
                                    <button class="button-disabled">View Event Link</button>
                                </Tooltip>
                            }
                        </div>
                    }
                </Column>
            </Row>
        </Container>
    }
}

<ModalLogin @ref="signinModal" ReturnUrl="@signInReturnUrl" />

@code 
{
    [Parameter]
    public string Guid {get; set;}
    [Parameter]
    public string Token {get; set;}

    private ModalLogin signinModal;

    private OteTicketDetailsDTO? ticketDetails;

    private bool IsOnlineEvent { get; set; } = false;

    public ClaimsPrincipal AuthState { get; set; }

    private string signInReturnUrl = string.Empty;

    private bool isAuthenticated = false;

    public CustomerProfile customerProfile = new CustomerProfile();

    public CustomerProfile customerDetail = new CustomerProfile();

    protected override async Task OnParametersSetAsync()
    {
        await LoadTickets();
        await LoadProfile();
    }

    private async Task LoadTickets()
    {
        try
        {
            if(string.IsNullOrEmpty(Guid) || string.IsNullOrEmpty(Token))
            {
                NavigationManager.NavigateTo("/not-found");
                return;
            }

            var ticketResult = await activityApiHandler.TicketDetails(Guid, Token);
            if(!ticketResult.Succeeded || ticketResult.Result is null || !ticketResult.Result.IsSuccess)
            {
                NavigationManager.NavigateTo("/not-found");
                return;
            }
            ticketDetails = ticketResult.Result.Result;

            //Get Provider Details
            var customer = await accountApiHandler.GetCustomerById(ticketDetails.ProviderId);
            if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
            {
                var args = customer.Result.Result;
                customerDetail = new CustomerProfile
                    {
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        ProfilePath = args.ProfileImg,
                        DateJoined = args.DateJoined
                    };
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please contact support.");
        }
    }

    private async Task LoadProfile()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        Token = user.FindFirstValue("Token");
        if (user != null && user.Identity != null)
        {
            isAuthenticated = user.Identity.IsAuthenticated;
            //Get User Profile
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                customerProfile = new CustomerProfile
                {
                    Birthdate = args.Birthdate,
                    Email = args.Email,
                    FirstName = args.FirstName,
                    LastName = args.LastName,
                    Id = args.Id,
                    IsMaker = args.IsMaker,
                    IsVerified = args.IsVerified,
                };
            }
        }
    }
    private async Task MessageProvider(int providerId)
    {
        if (!isAuthenticated)
        {
            signInReturnUrl = NavigationManager.Uri;
            await signinModal.Show();
            return;
        }

        var messageProviderRes = await chatApiHandler.RequestMessage(new Framework.ApiCommand.ApiCore.ChatRoom.Request.RequestMessageArgs
            {
                ProviderId = providerId
            }, Token);
        if (messageProviderRes.Succeeded && messageProviderRes.Result is not null && messageProviderRes.Result.IsSuccess)
        {
            var result = messageProviderRes.Result.Result;
            var url = $"messages/?guid={result.Guid}&token={result.Token}";

            NavigationManager.NavigateTo(url);
        }
    }
    private string FormattedId(int id)
    {
        var idString = id.ToString();
        var template = "000000";
        var referenceId = idString.Length > template.Length ? idString : template.Substring(idString.Length) + idString;
        return referenceId;
    }
}
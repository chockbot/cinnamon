    private async Task SaveEditedFamilyMember(AddChildrenModal.OnSaveButtonEventArgs args)
    {
        if (args.FamilyMembers == null) return;

        // add members
        var added = await accountApiHandler.CreateFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.CreateFamilyMemberArgs
            {
                FamilyMembers = args.FamilyMembers.Where(m => m.Id == 0 && !string.IsNullOrEmpty(m.Name?.Trim()))
                                    .Select(m =>
                                    {
                                        return new Framework.ApiCommand.ApiCore.DTO.FamilyMember.FamilyMemberDTO
                                        {
                                            BirthMonth = m.BirthMonth,
                                            BirthYear = m.BirthYear,
                                            Gender = m.Gender,
                                            Id = m.Id,
                                            Name = m.Name
                                        };
                                    }),
            }, Model.Token);

        // update members
        var updated = await accountApiHandler.UpdateFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.UpdateFamilyMemberArgs
            {
                FamilyMembers = args.FamilyMembers.Where(m => m.Id != 0 && !string.IsNullOrEmpty(m.Name?.Trim()))
                                    .Select(m =>
                                    {
                                        return new Framework.ApiCommand.ApiCore.DTO.FamilyMember.FamilyMemberDTO
                                        {
                                            BirthMonth = m.BirthMonth,
                                            BirthYear = m.BirthYear,
                                            Gender = m.Gender,
                                            Id = m.Id,
                                            Name = m.Name
                                        };
                                    })
            }, Model.Token);

        var deletedMembers = Model.Customer.FamilyMembers.Where(f => !args.FamilyMembers.Any(s => s.Id == f.Id));

        var deletedResult = await accountApiHandler.DeleteFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.DeleteFamilyMembersArgs
            {
                Ids = deletedMembers.Select(f => f.Id),
            }, Model.Token);


        // fetch again the updated family members
        var updatedMembers = await accountApiHandler.GetFamilyMembers(Model.Token);
        IDictionary<int, FamilyMember> tmpSelected = Model.Customer.FamilyMembers.Where(f => f.IsSelected).ToDictionary(f => f.Id);

        if (updatedMembers.Succeeded && updatedMembers.Result != null && updatedMembers.Result.IsSuccess)
        {
            Model.Customer.FamilyMembers = updatedMembers.Result.Result.Select(f =>
            {
                bool isSelected = tmpSelected.ContainsKey(f.Id);
                return new FamilyMember
                    {
                        BirthMonth = f.BirthMonth,
                        BirthYear = f.BirthYear,
                        Gender = f.Gender,
                        Id = f.Id,
                        Name = f.Name,
                        IsSelected = args.IsAutoSelect || isSelected
                    };
            }).ToList();
        }

        await AddChildrenModal.Close();
    }


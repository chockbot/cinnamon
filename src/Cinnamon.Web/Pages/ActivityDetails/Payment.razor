    private decimal GetTotalPerHeadPrice
    {
        get
        {
            decimal result = 0;

            if (SelectedAttendeesCount > 0 && ScheduleId != 0)
            {
                result = Model.SelectedSchedule.Price * SelectedAttendeesCount;
            }

            return result;
        }
    }

    private decimal GetAddOnsTotal
    {
        get
        {
            var selectedAddOns = Model.Activity.AddOns.Where(addOn => addOn.AddOnCount != 0).ToList();

            if (selectedAddOns == null || selectedAddOns.Count == 0)
            {
                return 0;
            }

            decimal totalAddOnPrice = selectedAddOns.Sum(addOn => addOn.Price * addOn.AddOnCount);
            return totalAddOnPrice;
        }
    }

    private decimal GetConvinienceFee
    {
        get
        {
            decimal result = 0;

            if (SelectedAttendeesCount > 0 && !IsInclusivePricing)
            {
                result = GetTotalPerHeadPrice * 0; //.05m;
            }

            return result;
        }
    }

    private decimal GetServiceFee 
    {
        get
        {
            decimal result = 0;
            if (SelectedAttendeesCount > 0 && !IsInclusivePricing)
            {
                result = 39;
            }
            return result;
        }
    }

    private decimal GetAppliedCoupon
    {
        get
        {
            decimal result = 0;

            if(Coupon.IsCouponApplied && Coupon.IsValid)
            {
                // fixed amount
                if(Coupon.DiscountType == 1)
                {
                    result = Coupon.Amount;
                }
                // percentage
                else if(Coupon.DiscountType == 0)
                {
                    decimal percentage = Coupon.Amount / 100;
                    decimal subTotal = 0;
                    if(IsInclusivePricing)
                    {
                        subTotal = GetTotalPerHeadPrice;
                    }
                    else 
                    {
                        subTotal = GetTotalPerHeadPrice + GetConvinienceFee;
                    }
                    result = subTotal * percentage;
                }
            }

            return result;
        }
    }

    private decimal GetTotalCredit
    {
        get
        {
            decimal result = 0;

            if ((Model.IsCreditApplied && Model.Customer.TotalCredits > 0))
            {
                decimal overallTotal = (GetTotalPerHeadPrice + GetAddOnsTotal + GetConvinienceFee + GetServiceFee) - GetAppliedCoupon;

                decimal creditsBalance = Model.Customer.TotalCredits;
                result = overallTotal >= creditsBalance ? creditsBalance : overallTotal;
            }

            return result;
        }
    }

    private decimal GetTotalPrice
    {
        get
        {
            decimal result = 0;
            if (SelectedAttendeesCount > 0)
            {
                decimal discount = 0;
                result = ((GetTotalPerHeadPrice + GetAddOnsTotal + GetConvinienceFee + GetServiceFee) - GetAppliedCoupon) - GetTotalCredit;
                result = result < 0 ? 0 : result;
            }
            return result;
        }
    }


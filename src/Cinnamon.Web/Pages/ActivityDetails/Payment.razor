            foreach (var item in deserializedPayload.AddOnsDetails)
            {
                // Find the corresponding AddOn in Model.Activity.AddOns based on AddOnId
                var matchingAddOn = Model.Activity.AddOns
                    .Where(a => a.Id == item.AddOnId)
                    .FirstOrDefault();

                // Update the AddOnCount if a matching AddOn is found

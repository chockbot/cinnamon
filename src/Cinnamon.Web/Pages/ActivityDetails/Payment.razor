    private async Task PopulateEnrollee()
    {
        if (enrolleeCount <= 0) return;

        if(Model.Customer.FamilyMembers.Count == 0)
        {
            await AddChildrenModal.Open();
            AddChildrenModal.AddMemberField(enrolleeCount, true);
            return;
        }

        if(enrolleeCount == Model.Customer.FamilyMembers.Count)
        {
            foreach(var member in Model.Customer.FamilyMembers)
            {
                member.IsSelected = true;
            }
            StateHasChanged();
            return;
        }

        if(enrolleeCount > Model.Customer.FamilyMembers.Count)
        {
            foreach(var member in Model.Customer.FamilyMembers)
            {
                member.IsSelected = true;
            }
            StateHasChanged();
            await AddChildrenModal.Open();
            AddChildrenModal.AddMemberField(enrolleeCount - Model.Customer.FamilyMembers.Count, true);
            return;
        }

        if(enrolleeCount < Model.Customer.FamilyMembers.Count)
        {
            isShowImportantMessage = true;
            StateHasChanged();
            return;
        }
    }
    private Task AddAddOns(AddOn addOn)
    {
        foreach (var existingAddOn in Model.Activity.AddOns.Where(a => a.Id == addOn.Id))
        {
            existingAddOn.AddOnCount++;
        }
        return Task.CompletedTask;
    }

    private Task SubtractAddOns(AddOn addOn)
    {
        foreach (var existingAddOn in Model.Activity.AddOns.Where(a => a.Id == addOn.Id))
        {
            if (existingAddOn.AddOnCount > 0)
                existingAddOn.AddOnCount--;
            else
                existingAddOn.AddOnCount = 0;
        }
        return Task.CompletedTask;
    }


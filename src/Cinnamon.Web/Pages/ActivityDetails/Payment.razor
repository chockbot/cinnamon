    private string expiringMessage = string.Empty;

    private void SelectedScheduleChanged()
    {
        var selectedSchedule = Model.Activity.ActivitySchedules.FirstOrDefault(s => s.Id == ScheduleId);
        if (selectedSchedule == null)
        {
            // schedule id not associated to activity
            NavigationManager.NavigateTo("explore");
            return;
        }
        Model.SelectedSchedule = new ActivitySchedule
            {
                DateTime = selectedSchedule.DateTime,
                Id = selectedSchedule.Id,
                Name = selectedSchedule.Name,
                PerUnit1 = selectedSchedule.PerUnit1,
                PerUnit2 = selectedSchedule.PerUnit2,
                Price = selectedSchedule.Price,
                PriceUnit1 = selectedSchedule.PriceUnit1,
                PriceUnit2 = selectedSchedule.PriceUnit2,
                UnitPrice = selectedSchedule.UnitPrice,
                IsSetSession = selectedSchedule.IsSetSession,
                SessionName = selectedSchedule.SessionName,
                HasExpiration = selectedSchedule.HasExpiration,
                StartDate = selectedSchedule.StartDate
            };

        if(Model.SelectedSchedule.IsSetSession)
        {
            if(Model.SelectedSchedule.StartDate is null)
            {
                // don't have start date setted
                NavigationManager.NavigateTo("explore");
                return;
            }

            var datePeriod = DateNextPeriod.CreateRecurring(Model.SelectedSchedule.StartDate.Value, Model.SelectedSchedule.SessionName);
            DateTime periodStart = datePeriod.PeriodStart;
            // to set the last time of the day
            DateTime periodEnd = datePeriod.PeriodEnd.AddDays(1).Date.AddSeconds(-1);

            DateTime nextPeriod = datePeriod.NextPeriod().PeriodStart;
            DateTime now = DateTime.Now;

            int daysLeft = (periodEnd - now).Days;
            int hours = (periodEnd - now).Hours;
            string durationLeft = daysLeft > 0 ? $"{daysLeft} days" : (hours > 0 ? "today" : "0 days");

            confirmationData.DaysLeft = Math.Abs((now - periodEnd).Days);
            confirmationData.DurationLeft = durationLeft;
            confirmationData.NextPeriod = nextPeriod;
            confirmationData.IsApplied = false;
            confirmationData.IsShowError = false;

            if(Model.SelectedSchedule.HasExpiration == 1)
            {

                expiringMessage = $"The expiration period is {Model.SelectedSchedule.SessionName.ToLower()} (calendar days), and is valid until the {periodEnd.Day}{ExpirationData.GetOrdinal(periodEnd.Day)} day of {periodEnd.ToString("MMMM")}. Next period is available for purchase at checkout.";

            }
            else if(Model.SelectedSchedule.HasExpiration == 2)
            {
                expiringMessage = $"Session/s must be consumed in {Model.SelectedSchedule.SessionName.ToLower()}, starting from first attendance.";
            }
        }
    }


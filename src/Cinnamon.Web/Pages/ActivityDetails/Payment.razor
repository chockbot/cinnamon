@page "/Payment/{ActivityId:int}/{ScheduleId:int}"
@page "/Payment/{ActivityId:int}/{ScheduleId:int}/{AddOnsPayLoad}"
@layout LandingMainLayout
@using Newtonsoft.Json;
@using System.Security.Claims
@using Cinnamon.Web.Enums;
@using Cinnamon.Web.Models;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Shared
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Microsoft.AspNetCore.SignalR.Client;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@inject ITransactionApiHandler transactionApiHandler;
@inject IDashboardApiHandler dashboardApiHandler
@inject IChatApiHandler chatApiHandler
@inject ILogger<Payment> logger
@using Cinnamon.Framework.Helpers;
@using Cinnamon.Web.Modules.Services;

@implements IDisposable

<PageTitle>Checkout Payment | CinnamonPH</PageTitle>
<SeoMeta Title="Checkout Payment" Subject="Checkout Payment" />

@if (IsFullyLoaded)
{
    <Container class="booking-container-wrapper pb-5">
        <Div ElementId="#b-animate" class="purchase-order-page">
            <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                <div class="d-flex align-items-center mt-3">
                    <button class="button-back">
                    <img class="cursor-pointer me-3" src="/images/payment/back-icon.png" alt="icon" @onclick="NavigateBack" />
                    </button>
                    <h4 class="fw-bold px-3 mb-0 color-grey-100 font-24 text-capitalize">Confirm experience</h4>
                </div>
                <Row HorizontalGutter="50" class="mt-5">
                    <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop.Is8.OnTablet" class="m-order-2">
                        <div>
                            @if(!isShowImportantMessage)
                            {
                                <h5 class="fw-bold" style="font-size:1.125rem;">Select who will attend</h5>
                                <p class="select-text">Choose student/s who will attend this activity. You can choose multiple student for this transaction or  you can add students if attendee is not yet listed below.</p>
                            }
                            else 
                            {
                                <h5 class="fw-bold text-danger" style="font-size:1.125rem;">Select who will attend*</h5>
                                <p class="select-text">Choose student/s who will attend this activity. You can choose multiple student for this transaction or  you can add students if attendee is not yet listed below.</p>
                            }
                            <Div class="details" Display="Display.Flex" Flex="Flex.Wrap">
                                @foreach (var item in Model.Customer.FamilyMembers.OrderBy(f => f.Id))
                                {
                                    <div class="card text-center px-3 py-2 m-1 d-flex flex-row align-items-center text-nowrap prevent-select cursor-pointer" 
                                        style="border-radius:8px;background-color:#EDF2F8;border:none;">
                                        <Check TValue="bool" id="@item.Id" Checked="item.IsSelected" CheckedChanged="v => SelectedAttendeesChanged(item, v)" class="mx-2 checkbox-round" /> 
                                        <label class="font-16" for="@item.Id">@item.Name</label>
                                    </div>
                                }
                            </Div>
                            <button class="border-radius-10 bg-orange-100 border-0 color-white-100 font-weight-700 hover-color-white mt-3 py-1 px-5 font-16" 
                                @onclick="()=>AddChildrenModal.Open()">Add</button>
                        </div>
                        <Divider class="my-4" />
                        @if (ScheduleId != 0)
                        {
                            <div>
                                <div class="d-flex selected-schedule">
                                    <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-0">Activity Selected</h5>
                                    <Button Type="ButtonType.Button" Clicked="OnClickChange" class="change-button">
                                       Change
                                    </Button>
                                </div>
                                <div class="drop-shadow-selected border-1-solid border-color-grey-200 border-radius-10 overflow-hidden mt-3">
                                    <div class="d-flex justify-content-between font-18 m-font-16 font-weight-700 color-black-100 bg-white-200 p-2
                                    border-bottom-1-solid border-color-grey-200">
                                        <p class="m-0 text-capitalize">@Model.SelectedSchedule.Name</p>
                                        <p class="m-0 m-margin-left-10">₱ @Model.SelectedSchedule.Price.ToString("#,##0.00")</p>
                                    </div>
                                    <div class="p-3">
                                        <Row class="mt-3" VerticalGutter="10">
                                            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                                                <div class="d-flex w-100 align-items-start">
                                                    <label>
                                                        <img src="images/payment/price-tag-icon.png" alt="price-tag">
                                                    </label>
                                                    <div class="ms-2">
                                                        <p class="mb-0 font-14 font-weight-700 color-black-100">Price Details:</p>
                                                        <p class="mb-0 font-16 color-grey-100">
                                                            ₱ @Model.SelectedSchedule.Price.ToString("#,##0") / @Model.SelectedSchedule.PerUnit1
                                                            @Model.SelectedSchedule.PriceUnit1 / @Model.SelectedSchedule.PerUnit2 @Model.SelectedSchedule.PriceUnit2
                                                        </p>
                                                    </div>
                                                </div>
                                            </Column>
                                            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                                                <div class="d-flex w-100 align-items-start">
                                                    <label>
                                                        <img src="images/payment/expired-icon.png" alt="expiration">
                                                    </label>
                                                    <div class="ms-2">
                                                        <p class="mb-0 font-14 font-weight-700 color-black-100">Expiration:</p>
                                                        @if (Model.SelectedSchedule.IsSetSession)
                                                        {
                                                            <p class="mb-0 font-16 color-grey-100">Consume in - @Model.SelectedSchedule.SessionName</p>
                                                            <p class="text-danger font-12 mb-0">@expiringMessage</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="mb-0 font-16 color-grey-100">N/A</p>
                                                        }
                                                    </div>
                                                </div>
                                            </Column>
                                        </Row>
                                        <div class="d-flex m-d-block mt-3 m-margin-top-10 align-items-center justify-content-between">
                                            <div class="m-width-100">
                                                <div class="d-flex w-100 align-items-start">
                                                    <label>
                                                        <img src="images/payment/calendar-schedule-icon.png" alt="calendar">
                                                    </label>
                                                    <div class="ms-2">
                                                        <p class="mb-0 font-14 font-weight-700 color-black-100">Schedule:</p>
                                                        <p class="mb-0 font-16 color-grey-100">@Model.SelectedSchedule.DateTime</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                @if (Model.Activity.AddOns.Count != 0)
                                {
                                    <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-3">@(Model.Activity.AddOns.Count > 1 ? "Add-ons" : "Add-on")</h5>
                                    @foreach (var addOn in Model.Activity.AddOns.OrderBy(a => a.Order).ToList())
                                    {
                                        <div class="col-lg-6 col-md-8 col-sm-12 col-12 add-ons-section">
                                            <div class="prevent-select color-grey-100 font-16 d-flex border-color-grey-200">
                                                <div class="w-100 p-2">@addOn.Name</div>
                                                <div @onclick="() =>SubtractAddOns(addOn)"
                                                     class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-orange-100">
                                                    -
                                                </div>
                                                <div class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-grey-100">
                                                    @addOn.AddOnCount
                                                </div>
                                                <div @onclick="() =>AddAddOns(addOn)"
                                                     class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-orange-100">
                                                    +
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex selected-schedule">
                                 <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-0">Activity Selected</h5>
                                 <Button Type="ButtonType.Button" Clicked="OnClickChange" class="change-button">
                                    Change
                                 </Button>
                            </div>
                            <p class="nothing-text text-center">Nothing Selected</p>
                            <br />
                            @if (Model.Activity.AddOns.Count != 0)
                                {
                                    <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-3">@(Model.Activity.AddOns.Count > 1 ? "Add-ons" : "Add-on")</h5>
                                    @foreach (var addOn in Model.Activity.AddOns.OrderBy(a => a.Order).ToList())
                                    {
                                        <div class="col-lg-6 col-md-8 col-sm-12 col-12 add-ons-section">
                                            <div class="prevent-select color-grey-100 font-16 d-flex border-color-grey-200">
                                                <div class="w-100 p-2">@addOn.Name</div>
                                                <div @onclick="() =>SubtractAddOns(addOn)"
                                                     class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-orange-100">
                                                    -
                                                </div>
                                                <div class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-grey-100">
                                                    @addOn.AddOnCount
                                                </div>
                                                <div @onclick="() =>AddAddOns(addOn)"
                                                     class="width-50 p-2 border-left-1-solid border-color-grey-200 text-center cursor-pointer color-orange-100">
                                                    +
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                        }
                        <Divider class="my-4" />
                        <div>
                            <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-0">Important Information</h5>
                            <p class="text-center mt-4">
                                <span class="color-grey-100">
                                    Your Booking is Protected by
                                </span> 
                                <span class="app-name">
                                    @Resources.App.appName
                                </span>
                            </p>
                            <Row class="mt-5 m-margin-top-20">
                                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                                    <div class="d-flex w-100 h-100 align-items-center">
                                        <img class="mx-auto" src="images/payment/new-security-guranted.png" alt="icon">
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class="m-margin-top-20">
                                    <p class="font-16 color-grey-100">The cinnamon platform guarantees: </p>
                                    <ul class="font-16 color-grey-100 ">
                                        <li>
                                            <p class="mb-0">Money-back guarantee if you're not satisfied.</p>
                                        </li>
                                        <li>
                                            <p class="mb-0">Anti-scam protection.</p>
                                        </li>
                                        <li>
                                            <p class="mb-0">Secure payment.</p>
                                        </li>
                                        <li>
                                            <p class="mb-0">Accidental support (for outdoor activities).<span class="text-danger">*</span></p> 
                                            <p class="font-12 mb-0"><span class="text-danger">*</span> To follow function</p>
                                        </li>
                                    </ul>
                                </Column>
                            </Row>
                        </div>
                        <div class="mt-3">
                            <p class="font-16 font-weight-700 color-black-100">What will happen after I purchase?</p>
                            <ol class="font-16 color-grey-100" style="padding-left: 15px;">
                                <li class="mb-3">
                                    You will be added to a chat group with the activity provider to clarify /answer any of your questions. 
                                    Go to the MENU and select MESSAGES to access chat.
                                </li>
                                <li class="mb-3">
                                    You can also be contacted by the activity provider, please make sure that your email and mobile number are correct.
                                </li>
                                <li class="mb-3">
                                    You can also contact your activity provider by using the email and mobile number that can be found in the payment confirmation email.
                                </li>
                                <li class="mb-3">
                                    Cinnamon secures your payment and will be credited to the activity provider/tutor once their session/s with you is complete. 
                                </li>
                            </ol>
                        </div>
                        <Divider class="my-4" />
                        <div class="payment-container">
                            <h5 class="fw-bold font-20">Pay with</h5>
                            <div class="card-payment-method mt-3">
                                <label class="font-16 color-black-100 mb-1 m-font-12">Cards</label>
                                    <label @onclick='() => CardModal.Show()' class="cursor-pointer d-flex justify-content-between border-1-solid border-color-grey-200 px-3 py-2 border-radius-15 overflow-hidden">
                                        <div class="d-flex align-items-center">
                                            @if(SelectedPaymentCode != "CARD")
                                            {
                                                <span class="me-3 me-md-4">
                                                    <span class='@(SelectedPaymentCode == "CARD" ? "cursor-pointer checkbox-round span-radio selected" : "cursor-pointer checkbox-round span-radio")' />
                                                </span>
                                                <span class="me-2 me-md-4">
                                                    <img src="images/ote/visa.png" alt="visa-card">
                                                </span>
                                                <span class="me-2 me-md-4">
                                                    <img src="images/ote/master-card.png" alt="master-card">
                                                </span>
                                                <span class="me-2 me-md-4">
                                                    <img src="images/ote/jcb.png" alt="jcb-card">
                                                </span>
                                                <span class="me-2 me-md-4">
                                                    <img src="images/ote/american-express.png" alt="american-express-card">
                                                </span>
                                            }
                                            else
                                            {
                                                if (CardPaymentModel.CardNumber[0] == '2' || CardPaymentModel.CardNumber[0] == '5')
                                                {
                                                    <img class="me-4 h-auto" style="width: 26px;" src="images/payment/master-card.svg" alt="icon">
                                                    <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                                }
                                                else if (CardPaymentModel.CardNumber[0] == '4')
                                                {
                                                    <img class="me-4 h-auto" style="width: 36px;" src="images/payment/visa-card.svg" alt="icon">
                                                    <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                                }
                                                else
                                                {
                                                    <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                                }
                                            }
                                            
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <span class="font-16 color-black-100 me-4 cursor-pointer m-font-12">Credit or Debit Card</span>
                                            <img src="images/payment/credit-card-arrow.svg" alt="arrow">
                                        </div>
                                    </label>
                            </div>
                            <div class="ewallet-payment-method mt-3">
                                <label class="font-16">E-wallets</label>
                                <fieldset class="border-radius-5 border-1-solid border-color-grey-200 p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                            checked='@(SelectedPaymentCode == "GCASH")'
                                            @onchange='() => SelectedPaymentCode = "GCASH"'
                                            id="ewallet-gcash" name="ewallet" value="GCASH" class="me-3 checkbox-round" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/gcash.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Gcash</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                            checked='@(SelectedPaymentCode == "GRABPAY")'
                                            @onchange='() => SelectedPaymentCode = "GRABPAY"'
                                            class="me-3 checkbox-round" id="ewallet-grabpay" name="ewallet" value="GRABPAY" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/grabpay.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Grab Pay</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                            checked='@(SelectedPaymentCode == "SHOPEEPAY")'
                                            @onchange='() => SelectedPaymentCode = "SHOPEEPAY"'
                                            class="me-3 checkbox-round" id="ewallet-shopeepay" name="ewallet" value="SHOPEEPAY" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/shoppepay.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Shopee Pay</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                            checked='@(SelectedPaymentCode == "PAYMAYA")'
                                            @onchange='() => SelectedPaymentCode = "PAYMAYA"'
                                            class="me-3 checkbox-round" id="ewallet-maya" name="ewallet" value="PAYMAYA" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/maya.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Maya</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <Divider />
                            <div class="form-outline">
                                <label class="form-label" style="font-size:0.8rem;"><small> By selecting the button below, I agree to the Activity Provider’s requirements and activity policies, Cinnamon's Rebooking and Refund Policy, I agree to pay the total amount shown.</small></label>
                                <br />
                                <br />
                                <button class="btn-primary rounded border-0 py-2 px-3 m-width-100 m-d-none" style="@payButtonStyle" @onclick="OnPayConfirmedClicked" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <i class="fa fa-spinner fa-spin"></i>
                                        <span>Please wait</span>
                                    }
                                    else
                                    {
                                        <span>Pay and confirm</span>
                                    }
                                </button>
                                <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="isShowPayErrorMessage">
                                    <AlertDescription>@payErrorMessage</AlertDescription>
                                </Alert>
                            </div>
                        </div>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop.Is4.OnTablet" class="m-order-1">
                        <div class="booking-total-container sticky-top mb-3" style="top:80px;">
                            <Card>
                                <CardBody>
                                    @if(ScheduleId != 0)
                                    {
                                        <div class="d-flex" style="font-size:1.125rem">
                                            <div class="activity-img">
                                                <img src="@GetActivityFirstImage" alt="Activity Image">
                                            </div>
                                            <div class="activity-details">
                                                <span class="fw-bold activity-title">@Model.Activity.Title</span>
                                                <div class="activity-schedule">
                                                    @Model.SelectedSchedule.Name
                                                </div>
                                                <div class="activity-schedule">
                                                    @Model.SelectedSchedule.DateTime
                                                </div>
                                            </div>
                                        </div>
                                        <Divider />
                                    }
                                    else
                                    {
                                        <div class="d-flex" style="font-size:1.125rem">
                                            <div class="activity-img">
                                                <img src="@GetActivityFirstImage" alt="Activity Image">
                                            </div>
                                            <div class="activity-details">
                                                <span class="fw-bold activity-title">@Model.Activity.Title</span>
                                            </div>
                                        </div>
                                        <Divider />
                                    }
                                    <div class="price-details">
                                        <span class="fw-bold price-title">Price Details</span>

                                        @if(ScheduleId != 0)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head">
                                                <div>
                                                    @Model.SelectedSchedule.UnitPrice @Model.SelectedSchedule.LongPrice x @SelectedAttendeesCount Enrollee
                                                </div>
                                                <div>
                                                    ₱ @(GetTotalPerHeadPrice.ToString("#,##0.00"))
                                                </div>
                                            </div>
                                        }

                                        @if (Model.Activity.AddOns.Count != 0)
                                        {
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div>
                                                Add-Ons
                                            </div>
                                            <div>
                                                ₱ @(GetAddOnsTotal.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                        }

                                        @if(!IsInclusivePricing)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head">
                                                <div>
                                                    Service Fee - <span class="text-decoration-line-through">15%</span>
                                                </div>
                                                <div>
                                                    ₱ @(GetConvinienceFee.ToString("#,##0.00"))
                                                </div>
                                            </div>
                                        }

                                        @if(!IsInclusivePricing)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head service-fee">
                                                <div class="d-flex align-items-center">
                                                    <CustomTooltip MarginLeft="-100">
                                                        <TextContent>
                                                            <span class="rounded-circle service-fee-info">i</span>
                                                        </TextContent>
                                                        <TooltipContent>
                                                            <span class="color-grey-100">
                                                                This helps Cinnamon run its services and protects your payment in case the experience provider does 
                                                                something illegal or against our policy. They won't get paid until after the sessions or work have been done.
                                                            </span>
                                                        </TooltipContent>
                                                    </CustomTooltip> 
                                                    <span class="ms-1">Handling Fee</span>
                                                </div>
                                                <div>
                                                    ₱ @(GetServiceFee.ToString("#,##0.00"))
                                                </div>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div class="d-flex position-relative">
                                                <div class="position-relative" style="width: 150px;">
                                                    <TextEdit class='@(Coupon.IsCouponApplied && !Coupon.IsValid ? "is-invalid" : "")' 
                                                        style='@(Coupon.IsCouponApplied ? "background-color: #F3F6FC; padding-right: 25px" : "background-color: #F3F6FC;")' 
                                                        required Placeholder="Add coupon" Size="Size.ExtraSmall" @bind-Text="Coupon.CouponCode" />
                                                    @if(Coupon.IsCouponApplied && Coupon.IsValid)
                                                    {
                                                        <img @onclick="RemoveAppliedCoupon" class="remove-coupon-icon" src="images/payment/close.png" alt="remove">
                                                    }
                                                </div>
                                                <Button Type="ButtonType.Button" Clicked="ValidateCouponCode"
                                                    class="btn-primary font-12" Border="Border.Is0" Loading="Coupon.IsValidating" Disabled="Coupon.IsValidating"
                                                    style="border-radius: 0; padding-top: 3px; padding-bottom: 3px; margin-left: 3px;">
                                                    <LoadingTemplate>
                                                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                                                    </LoadingTemplate>
                                                    <ChildContent>
                                                        Apply
                                                    </ChildContent>
                                                </Button>
                                                @if(Coupon.IsCouponApplied && !Coupon.IsValid)
                                                {
                                                    <div class="coupon-error-message font-12">
                                                        <b style="color: #AD0C0C;">@Coupon.ErrorTitle</b>
                                                        <br>
                                                        <span class="color-grey-100">
                                                            @Coupon.ErrorDescription
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <span style='@(GetAppliedCoupon > 0 ? "color: #AD0C0C" : "")'>
                                                    @(GetAppliedCoupon > 0 ? "-" : "") ₱ @(GetAppliedCoupon.ToString("#,##0.00"))
                                                </span>
                                            </div>
                                        </div>


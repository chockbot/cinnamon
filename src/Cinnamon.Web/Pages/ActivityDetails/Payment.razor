    private string payErrorMessage = string.Empty;
    private bool isShowPayErrorMessage = false;
    private bool isLoading = false;
    private string payButtonStyle = "font-weight:700;";

    private async Task OnPayConfirmedClicked()
    {
        if (string.IsNullOrEmpty(SelectedPaymentCode))
        {
            payErrorMessage = "Please select payment method";
            isShowPayErrorMessage = true;
            return;
        }

        var selectedPaymentMethod = Payments.First(p => p.Code == SelectedPaymentCode);

        if (SelectedAttendeesCount > 0)
        {
            isLoading = true;
            payButtonStyle = "background-color: #6c757d !important;";

            var submit = await transactionApiHandler.SubmitPurchaseOrder(new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitPurchaseOrderArgs
                {
                    ActivityId = Model.Activity.ActivityId,
                    CouponCode = Coupon.IsCouponApplied && Coupon.IsValid ? Coupon.CouponCode : string.Empty,
                    NumberOfHeads = SelectedAttendeesCount,
                    ScheduleId = Model.SelectedSchedule.Id,
                    Students = Model.Customer.FamilyMembers.Where(f => f.IsSelected).Select(s =>
                    {
                        return new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitPurchaseOrderArgs.Enrollee
                        {
                            FamilyMemberId = s.Id,
                            Name = s.Name
                        };
                    }),
                    PaymentChannel = selectedPaymentMethod.Code,
                    PaymentMethod = selectedPaymentMethod.PaymentMethod,
                    CardInformation = selectedPaymentMethod.Code == "CARD" ? new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitPurchaseOrderArgs.CardDetails
                    {
                        AccountHolder = CardPaymentModel.CardHolder ?? string.Empty,
                        CardNumber = CardPaymentModel.CardNumber ?? string.Empty,
                        CVV = CardPaymentModel.CVV ?? string.Empty,
                        ExpireMonthYear = CardPaymentModel.Expiration ?? string.Empty
                    } : null,
                    IsCreditsApplied = Model.IsCreditApplied
                }, Model.Token);

            if ((!submit.Succeeded || submit.Result == null) || (submit.Succeeded && !submit.Result.IsSuccess))
            {
                payErrorMessage = submit.Result?.ErrorInfo?.Message ?? $"An error occured. Please try again later.";
                isShowPayErrorMessage = true;
                isLoading = false;
            }
            else
            {
                isLoading = false;
                var groupName = Guid.NewGuid().ToString();

                var createChatRoomResult = await chatApiHandler.CreateChatRoom(new Framework.ApiCommand.ApiCore.ChatRoom.Request.CreateChatRoomArgs
                {
                    FromUserId = Model.Customer.Id,
                    ToUserId = Model.Activity.CreatedBy,
                    ChatType = Framework.Enums.Enums.ChatType.GroupChat,
                    GroupName = groupName,
                    ChatName = $"{Model.Activity.Owner.FirstName} {Model.Activity.Owner.LastName}'s Chat Group"
                }, Model.Token);

                if (createChatRoomResult.Succeeded && createChatRoomResult.Result.IsSuccess)
                {
                    await hubConnection.SendAsync("AddToGroupAfterPayment", $"{createChatRoomResult.Result.Result.GroupName}|{createChatRoomResult.Result.Result.ChatRoomId}|{Model.Customer.Id}|{Model.Customer.FirstName}|{Model.Customer.LastName}|{Model.Customer.ProfilePath}|{Model.Activity.Owner.FirstName} {Model.Activity.Owner.LastName}'s Chat Group");
                }

                if (submit.Result.Result.Action == 1)
                {
                    NavigationManager.NavigateTo(submit.Result.Result.Url);
                }
                else
                {
                    NavigationManager.NavigateTo($"/purchase/order/?purchaseid={submit.Result.Result.Id}");
                }
            }
        }
        else
        {
            payErrorMessage = "Please include family to register";
            isShowPayErrorMessage = true;
        }
    }


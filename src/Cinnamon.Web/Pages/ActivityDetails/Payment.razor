    private async Task ValidateCouponCode()
    {
        if(!string.IsNullOrEmpty(Coupon.CouponCode) && SelectedAttendeesCount > 0)
        {
            Coupon.IsValidating = true;

            decimal subTotal = Model.SelectedSchedule.Price * SelectedAttendeesCount;
            decimal paymentProviderFee = subTotal * .05m;
            decimal serviceFee = 50;
            decimal total = subTotal + paymentProviderFee + serviceFee;

            var validateRes = await activityApiHandler.ValidateCouponCode(new Framework.ApiCommand.ApiCore.Activity.Request.ValidateCouponCodeArgs {
                ActivityId = ActivityId,
                Amount = total,
                CouponCode = Coupon.CouponCode
            }, Model.Token);
            if(!validateRes.Succeeded || validateRes.Result == null || !validateRes.Result.IsSuccess)
            {
                Coupon.IsCouponApplied = true;
                Coupon.IsValid = false;
                RemoveCouponError();
            }
            else 
            {
                var result = validateRes.Result.Result;

                Coupon.IsCouponApplied = true;
                Coupon.IsValid = true;
                Coupon.Amount = result.Amount;
                Coupon.DiscountType = result.DiscountType;
                Coupon.MaximumSpend = result.MaximumSpend;
            }

            Coupon.IsValidating = false;
        }
    }

    private void ClearCouponDetails()
    {
        Coupon.IsCouponApplied = false;
        Coupon.IsValid = false;
        Coupon.Amount = 0;
        Coupon.DiscountType = -1;
        Coupon.MaximumSpend = 0;
        Coupon.CouponCode = string.Empty;
    }


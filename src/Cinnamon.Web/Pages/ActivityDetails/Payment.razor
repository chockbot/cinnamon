                <a class="text-decoration-none text-reset" href="/Explore/@Model.Activity.ActivityId"><img src="/images/previous.png" style="width:20px;" /></a>
                <h4 class="fw-bold px-3" style="1.9rem">Confirm experience</h4>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3 mb-5">
        <div class="d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12 px-3 m-purchase-container">
            <div class="col-lg-8 col-md-8 col-sm-12 col-12 px-lg-5 px-md-5 px-sm-0 px-0 order-lg-first order-md-first order-sm-last order-last">
                <div class="col-lg-5 col-md-5 col-sm-12 col-12">
                    <h5 class="fw-bold" style="font-size:1.5rem;">Activity selected</h5>
                    <CarouselItemSchedule ScheduleModel="Model.SelectedSchedule" ButtonType="@ScheduleButtonType.Change" OnClickChange="OnClickChange" ActivityModel="activity"></CarouselItemSchedule>

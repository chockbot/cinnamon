                    {
                        <Column ColumnSize="ColumnSize.Is12.OnDesktop">
                            <Div class="details overflow-auto" Display="Display.Flex">
                                <Column class="d-flex flex-row flex-lg-wrap flex-md-wrap flex-sm-nowrap flex-nowrap">
                                    @foreach (var item in Model.Customer.FamilyMembers)
                                    {
                                        <div class="card text-center p-3 m-1 d-flex flex-row align-items-center text-nowrap" style="border-radius:8px;background-color:#EDF2F8;border:none;">
                                            <input type="checkbox" id="@item.Id" value="@item.Id" class="mx-2 checkbox-round" @onchange="() => OnSelectAttend(item)"/> <label for="@item.Id">@item.Name</label> 
                                        </div>
                                    }
                                </Column>
                            </Div>
                        </Column>
                    }
                    <button class="btn-primary rounded shadow-sm border-0 my-3 py-2 px-3" style="width:fit-content !important;" @onclick="()=>AddChildrenModal.Open()">Add</button>
                </div>
                <hr />
                <div class="payment-container col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="d-flex align-items-center justify-content-between">
                        <div><h5 class="fw-bold">Pay with</h5></div>
                        <div class="d-flex d-md-block d-lg-block d-none d-sm-none">
                            <img class="img-thumbnail" src="/images/mastercard.png" />
                            <img class="img-thumbnail" src="/images/paypal.png" />
                        </div>
                    </div>
                    <button class="d-md-none d-lg-none d-block d-sm-block" style="border:none;background-color:white" data-bs-toggle="modal" data-bs-target="#paymentModal"><i class="fas fa-credit-card mx-2"></i>Credit or debit card</button>
                    <div class="col-lg-12 col-md-12 col-12 d-md-block d-lg-block d-none d-sm-none">
                        <div class="form-outline mb-4 pb-1"> 
                            <label>Credit or debit card</label>
                            <select Class="form-control" @bind="SelectedPaymentCode">
                                <option value="" selected disabled>Select Payment Method</option>
                                @foreach (var item in Payments)
                                {
                                    <option value="@item.Code">@item.DisplayName</option>
                                }
                            </select>
                            </div>

                            <label class="mb-2">Enter Your Card Details</label>

                            <div class="row mb-2">
                                <div class="col-7">
                                <input type="text" id="formControlLgXsd" class="form-control" value="" placeholder="Card number" />
                                </div>
                                <div class="col-3">
                                    <div class="form-outline">
                                        <input type="password" id="formControlLgExpk" class="form-control"
                                                placeholder="MM/YYYY" />
                                    </div>
                                </div>
                                <div class="col-2">
                                    <div class="form-outline">
                                        <input type="password" id="formControlLgcvv" class="form-control"
                                                placeholder="CVV" />
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-7">
                                    <div class="form-outline">
                                    <label class="form-label" for="formControlLgXM">Name on card</label>
                                    <input type="text" id="formControlLgXM" class="form-control"
                                                value="" placeholder="Name"/>
                                    </div>
                                </div>
                                    <div class="col-5">
                                    <div class="form-outline">
                                    <label class="form-label" for="formControlLgXM">Contact number</label>
                                        <input type="text" id="formControlLgXM" class="form-control"
                                            value="" placeholder="contact no." />
                                    </div>
                                </div>
                            </div>
                        </div>
                    <hr />
                    <br />
                    <div class="form-outline">
                        <label class="form-label" style="font-size:0.8rem;"><small> By selecting the button below, I agree to the Cinnamon Maker’s requirements and activity policies, Cinnamon's Rebooking and Refund Policy, I agree to pay the total amount shown.</small></label>
                        <br />
                        <br />
                        <button class="btn-primary form-control rounded shadow-sm border-0 py-2 px-3" style="@payButtonStyle" @onclick="OnPayConfirmedClicked" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <i class="fa fa-spinner fa-spin"></i>
                                <span>Please wait</span>
                            }
                            else
                            {
                                <span>Pay and confirm</span>

                            }
                        </button>
                        @if(isShowPayErrorMessage)
                        {
                            <p class="text-danger">@payErrorMessage</p>
                        }
                    </div>
                </div>
            </div>
            <div class="booking-total-container col-lg-4 col-md-4 col-sm-12 col-12 order-lg-last order-md-last order-sm-first order-first">
                <div class="sticky-top mb-3" style="top:80px;">
                    <Card>
                        <CardBody>
                            <div class="d-flex" style="font-size:1.125rem">
                                <div class="activity-img">
                                    <img src="@GetActivityFirstImage" alt="Activity Image">
                                </div>
                                <div class="activity-details">
                                    <span class="fw-bold activity-title">@Model.Activity.Title</span>
                                    <div class="activity-schedule">
                                        @Model.SelectedSchedule.Name
                                    </div>
                                    <div class="activity-schedule">
                                        @Model.SelectedSchedule.DateTime
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="price-details">
                                <span class="fw-bold price-title">Price Details</span>
                                <div class="d-flex justify-content-between py-1 price-per-head">
                                    <div>
                                        @Model.SelectedSchedule.UnitPrice @Model.SelectedSchedule.LongPrice x @Model.SelectedAttendees.Count head
                                    </div>
                                    <div>
                                        @GetTotalPerHeadPrice
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between py-1 price-per-head">
                                    <div>
                                        Convinience fee - 15%
                                    </div>
                                    <div>
                                        @GetConvinienceFee
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between py-1 price-per-head">
                                    <div>
                                        <TextEdit style="background-color: #F3F6FC;" required Placeholder="Add coupon" Size="Size.ExtraSmall" />
                                    </div>
                                    <div>
                                        PHP 0.00
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between py-1 price-per-head">
                                    <div class="apply-credits">
                                        Apply credits
                                    </div>
                                    <div>
                                        PHP 0.00
                                    </div>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between py-1 total-payments">
                                    <div>
                                        Total Payments
                                    </div>
                                    <div>
                                        @GetTotalPrice
                                    </div>
                                </div>
                            </div>
                            <hr />
                            <div class="d-flex align-items-center justify-content-center protected-footer">
                                Your booking is protected by 
                                <div class="app-name">
                                    @Resources.App.appName
                                </div>
                            </div>
                        </CardBody>
                    </Card>
                    <Card class="mt-3">
                        <CardBody class="activity-owner">
                            <div class="d-flex align-items-center">
                                <div class="image-src">
                                    <img src="@GetActivityOwnerProfileSrc" alt="owner-profile">
                                </div>
                                <div class="ms-2">
                                    <p class="experience-by">Experience by</p>
                                    <p class="owner">@($"{activity.Owner.FirstName} {activity.Owner.LastName}")</p>
                                </div>
                                <div class="ms-5 verified-logo">
                                    <img src="images/VerifiedIcon.png" alt="verified-logo">
                                </div>
                            </div>
                        </CardBody>
                    </Card>
                </div>
            </div>
        </div>
    </div>

    @if (isLoaded)
    {
        <AddChildrenModal @ref="AddChildrenModal" SaveEditedFamilyMember="SaveEditedFamilyMember" 
            Model="Model.Customer.FamilyMembers.Select(f => f).ToList()" />
        <SchedulesModal @ref="ModalSched" ScheduleModel="Model.Activity.ActivitySchedules" />
    }

    <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="paymentModalLabel">Pay with</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex">
                        <img class="img-thumbnail" src="/images/mastercard.png" />
                        <img class="img-thumbnail" src="/images/paypal.png" />
                    </div>
                    <div class="form-outline mb-2 pb-1">
                        <label>Credit or debit card</label>
                        <select Class="form-control" @bind="SelectedPaymentCode">
                            <option value="" selected disabled>Select Payment Method</option>
                            @foreach (var item in Payments)
                            {
                                <option value="@item.Code">@item.DisplayName</option>
                            }
                        </select>
                    </div>

                    <p class="fw-bold mb-1">Enter Your Card Details</p>

                    <div class="row mb-2">
                        <div class="col-12 mb-2">
                            <input type="text" id="formControlLgXsd" class="form-control" value="" placeholder="Card number" />
                        </div>
                        <div class="col-6">
                            <div class="form-outline">
                                <input type="password" id="formControlLgExpk" class="form-control"
                                    placeholder="MM/YYYY" />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-outline">
                                <input type="password" id="formControlLgcvv" class="form-control"
                                    placeholder="CVV" />
                            </div>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-12">
                            <div class="form-outline">
                                <label class="form-label" for="formControlLgXM">Name on card</label>
                                <input type="text" id="formControlLgXM" class="form-control"
                                    value="" placeholder="Name" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-outline">
                                <label class="form-label" for="formControlLgXM">Contact number</label>
                                <input type="text" id="formControlLgXM" class="form-control"
                                    value="" placeholder="contact no." />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" style="background-color:#ffa942;color:white" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>
}

@code 
{
    [Parameter]
    public int ActivityId { get; set; }

    [Parameter]
    public int ScheduleId { get; set; }

    public Activity activity { get; set; }

    private PurchaseModel Model {get; set;}

    private SchedulesModal ModalSched { get; set; }

    public AddChildrenModal AddChildrenModal { get; set; }

    public bool isLoaded { get; set; } = false;

    private IEnumerable<PaymentOption> Payments {get; set;} = new List<PaymentOption>();
    
    private string SelectedPaymentCode = string.Empty;

    private enum CouponAction {
        NoCoupon = 0,
        EnteringCoupon = 1,
        AppliedCoupon = 2
    }

    private CouponAction couponAction = CouponAction.EnteringCoupon;

    private decimal couponAmount = 50;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        // get profile details
        var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!profileResult.Succeeded || profileResult.Result == null) || (profileResult.Succeeded && !profileResult.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var profile = profileResult.Result.Result;

        // get family members information
        var familyMembers = new List<Models.Entities.FamilyMember>();
        var members = await accountApiHandler.GetFamilyMembers(token);

        if(members.Succeeded && members.Result != null && members.Succeeded)
        {
            familyMembers = members.Result.Result.Select(m => {
                return new Models.Entities.FamilyMember {
                    BirthMonth = m.BirthMonth,
                    BirthYear = m.BirthYear,
                    Gender = m.Gender,
                    Name = m.Name,
                    Id = m.Id
                };
            }).ToList();
        }

        // get activity
        var activityRes = await activityApiHandler.GetActivity(ActivityId, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs {
            IncludeActivityAddress = true,
            IncludeActivityDescription = true,
            IncludeAtivitySchedules = true,
            IsActive = true,
            IncludeCustomer = true,
            IncludeActivityImages = true
        });
        if((!activityRes.Succeeded || activityRes.Result == null) || (activityRes.Succeeded && !activityRes.Result.IsSuccess))
        {
            // error when getting activity
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = activityRes.Result.Result;
        activity = new Activity
            {
                ActivityId = result.ActivityId,
                ExperienceTypeId = result.ExperienceTypeId,
                ExperienceCategoryId = result.ExperienceCategoryId,
                SubCategoryId = result.SubCategoryId,
                Title = result.Title,
                Description = result.Description,
                Price = result.Price,
                ScheduleIndicator = result.ScheduleIndicator,
                Remarks = result.Remarks,
                IsPublished = result.IsPublished,
                Address1 = result.Address1,
                Address2 = result.Address2,
                District = result.District,
                City = result.City,
                CityName = result.CityName,
                Subdivision = result.Subdivision,
                Barangay = result.Barangay,
                BarangayName = result.BarangayName,
                Region = result.Region,
                RegionName = result.RegionName,
                PostalCode = result.PostalCode,
                SpecificsYouWillProvide = result.SpecificsYouWillProvide,
                CustomerBringWithThem = result.CustomerBringWithThem,
                AdditionalRequirements = result.AdditionalRequirements,
                ActivityLevel = result.ActivityLevel,
                SkillLevel = result.SkillLevel,
                MinimumAge = result.MinimumAge,
                CanAdultsJoin = result.CanAdultsJoin,
                CreatedBy = result.CreatedBy,
                MapDetails = result.MapDetails,
                IsSetSession = result.IsSetSession,
                SessionName = result.SessionName,
                ActivitySchedules = result.ActivitySchedules.Select(e =>
                {
                    return new ActivitySchedule
                    {
                        Id = e.Id,
                        Name = e.Name,
                        DateTime = e.DateTime,
                        PerUnit1 = e.PerUnit1,
                        PerUnit2 = e.PerUnit2,
                        Price = e.Price,
                        PriceUnit1 = e.PriceUnit1,
                        PriceUnit2 = e.PriceUnit2,
                        UnitPrice = e.UnitPrice,
                        Order = e.Order
                    };
                }).ToList(),
                Images = result.Images.Select(i =>
                {
                    return new ActivityImage
                    {
                        Id = i.Id,
                        ImageSrc = i.ImageSrc,
                        Name = i.Name,
                        Order = i.Order
                    };
                }).ToList(),
                Owner = result.Owner != null ? new CustomerProfile
                {
                    // map only required fields
                    Id = result.Owner.Id,
                    Handler = result.Owner.Handler,
                    ProfilePath = result.Owner.ImageSrc,
                    FirstName = result.Owner.FirstName,
                    LastName = result.Owner.LastName
                } : null
            };
        var selectedSchedule = activity.ActivitySchedules.FirstOrDefault(s => s.Id == ScheduleId);
        if(selectedSchedule == null)
        {
            // schedule id not associated to activity
            NavigationManager.NavigateTo("explore");
            return;
        }

        Model = new PurchaseModel {
            // map only required fields
            Activity = new Activity {
                ActivityId = activity.ActivityId,
                ActivityLevel = activity.ActivityLevel,
                AdditionalRequirements = activity.AdditionalRequirements,
                Address1 = activity.Address1,
                Address2 = activity.Address2,
                CanAdultsJoin = activity.CanAdultsJoin,
                City = activity.City,
                CustomerBringWithThem = activity.CustomerBringWithThem,
                Description = activity.Description,
                District = activity.District,
                ExperienceCategoryId = activity.ExperienceCategoryId,
                ExperienceTypeId = activity.ExperienceTypeId,
                IsPublished = activity.IsPublished,
                MinimumAge = activity.MinimumAge,
                Price = activity.Price,
                Remarks = activity.Remarks,
                ScheduleIndicator = activity.ScheduleIndicator,
                SkillLevel = activity.SkillLevel,
                SpecificsYouWillProvide = activity.SpecificsYouWillProvide,
                SubCategoryId = activity.SubCategoryId,
                Title = activity.Title,
                ActivitySchedules = activity.ActivitySchedules.Select(s => {
                    return new ActivitySchedule {
                        DateTime = s.DateTime,
                        Id = s.Id,
                        Name = s.Name,
                        PerUnit1 = s.PerUnit1,
                        PerUnit2 = s.PerUnit2,
                        Price = s.Price,
                        PriceUnit1 = s.PriceUnit1,
                        PriceUnit2 = s.PriceUnit2,
                        UnitPrice = s.UnitPrice,
                    };
                }).ToList()
            },
            // map customer data fields
            Customer = new CustomerProfile {
                About = profile.About,
                Birthdate = profile.Birthdate,
                Email = profile.Email,
                FamilyMembers = familyMembers,
                FirstName = profile.FirstName,
                IsMaker = profile.IsMaker,
                LastName = profile.LastName,
                IsVerified = profile.IsVerified,
                ProfilePath = profile.ProfileImg
            },
            SelectedSchedule = new ActivitySchedule {
                DateTime = selectedSchedule.DateTime,
                Id = selectedSchedule.Id,
                Name = selectedSchedule.Name,
                PerUnit1 = selectedSchedule.PerUnit1,
                PerUnit2 = selectedSchedule.PerUnit2,
                Price = selectedSchedule.Price,
                PriceUnit1 = selectedSchedule.PriceUnit1,
                PriceUnit2 = selectedSchedule.PriceUnit2,
                UnitPrice = selectedSchedule.UnitPrice,

            },
            Token = token
        };

        isLoaded= true;

        // payment options
        Payments = new List<PaymentOption> {
            { new PaymentOption {DisplayName = "SHOPEEPAY", PaymentChannel = "SHOPEEPAY", PaymentMethod = "EWALLET", Code = "SHOPEEPAY"} },
            { new PaymentOption {DisplayName = "GRABPAY", PaymentChannel = "GRABPAY", PaymentMethod = "EWALLET", Code = "GRABPAY"}},
            { new PaymentOption {DisplayName = "PAYMAYA", PaymentChannel = "PAYMAYA", PaymentMethod = "EWALLET", Code = "PAYMAYA"}},
            { new PaymentOption {DisplayName = "GCASH", PaymentChannel = "GCASH", PaymentMethod = "EWALLET", Code = "GCASH"}}
        };
    }

    private void OnClickChange()
    {
        ModalSched.Open();
    }

    private async Task SaveEditedFamilyMember(IList<FamilyMember> familyMembers)
    {
        // add members
        var added = await accountApiHandler.CreateFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.CreateFamilyMemberArgs {
                FamilyMembers = familyMembers.Where(m => m.Id == 0 && !string.IsNullOrEmpty(m.Name?.Trim()))
                                .Select(m => {
                                    return new Framework.ApiCommand.ApiCore.DTO.FamilyMember.FamilyMemberDTO {
                                        BirthMonth = m.BirthMonth,
                                        BirthYear = m.BirthYear,
                                        Gender = m.Gender,
                                        Id = m.Id,
                                        Name = m.Name
                                    };
                                }),
        }, Model.Token);

        // update members
        var updated = await accountApiHandler.UpdateFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.UpdateFamilyMemberArgs {
                FamilyMembers = familyMembers.Where(m => m.Id != 0 && !string.IsNullOrEmpty(m.Name?.Trim()))
                                .Select(m => {
                                    return new Framework.ApiCommand.ApiCore.DTO.FamilyMember.FamilyMemberDTO {
                                        BirthMonth = m.BirthMonth,
                                        BirthYear = m.BirthYear,
                                        Gender = m.Gender,
                                        Id = m.Id,
                                        Name = m.Name
                                    };
                                })
        }, Model.Token);

        var deletedMembers = Model.Customer.FamilyMembers.Where(f => !familyMembers.Any(s => s.Id == f.Id));

        var deletedResult = await accountApiHandler.DeleteFamilyMembers(new Framework.ApiCommand.ApiCore.Account.Request.DeleteFamilyMembersArgs {
            Ids = deletedMembers.Select(f => f.Id),
        }, Model.Token);


        // fetch again the updated family members
        var updatedMembers = await accountApiHandler.GetFamilyMembers(Model.Token);
        if(updatedMembers.Succeeded && updatedMembers.Result != null && updatedMembers.Result.IsSuccess)
        {
            Model.Customer.FamilyMembers = updatedMembers.Result.Result.Select(f => {
                return new FamilyMember {
                    BirthMonth = f.BirthMonth,
                    BirthYear = f.BirthYear,
                    Gender = f.Gender,
                    Id = f.Id,
                    Name = f.Name
                };
            }).ToList();
        }

        AddChildrenModal.Close();
    }

    private void OnSelectAttend(FamilyMember familyMember)
    {
        var member = Model.SelectedAttendees.FirstOrDefault(m => m.Id == familyMember.Id);
        if(member == null)
        {
            Model.SelectedAttendees.Add(familyMember);
        }
        else
        {
            Model.SelectedAttendees.Remove(member);
        }
    }

    private string payErrorMessage = string.Empty;
    private bool isShowPayErrorMessage = false;
    private bool isLoading = false;
    private string payButtonStyle = "width:100% !important;font-weight:700;";
    private async Task OnPayConfirmedClicked()
    {
        if(string.IsNullOrEmpty(SelectedPaymentCode))
        {
            payErrorMessage = "Please select payment method";
            isShowPayErrorMessage = true;
            return;
        }

        var selectedPaymentMethod = Payments.First(p => p.Code == SelectedPaymentCode);

        if(Model.SelectedAttendees.Count > 0)
        {
            isLoading = true;
            payButtonStyle = "width:100% !important;font-weight:700;background-color: #6c757d !important;";

            var submit = await transactionApiHandler.SubmitPurchaseOrder(new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitPurchaseOrderArgs {
                ActivityId = Model.Activity.ActivityId,
                CouponCode = "temporary coupon code",
                NumberOfHeads = Model.SelectedAttendees.Count,
                ScheduleId = Model.SelectedSchedule.Id,
                Students = Model.SelectedAttendees.Select(s => {
                    return new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitPurchaseOrderArgs.Enrollee {
                        FamilyMemberId = s.Id,
                        Name = s.Name
                    };
                }),
                PaymentChannel = selectedPaymentMethod.Code,
                PaymentMethod = selectedPaymentMethod.PaymentMethod
            }, Model.Token);

            if((!submit.Succeeded || submit.Result == null) || (submit.Succeeded && !submit.Result.IsSuccess))
            {
                payErrorMessage = $"An error occured. Please try again later.";
                isShowPayErrorMessage = true;
                isLoading = false;
                payButtonStyle = "width:100% !important;font-weight:700;";
            }
            else 
            {
                isLoading = false;
                payButtonStyle = "width:100% !important;font-weight:700;";
                if(submit.Result.Result.Action == 1)
                {
                    NavigationManager.NavigateTo(submit.Result.Result.Url);
                }
                else 
                {
                    NavigationManager.NavigateTo($"/purchase/order/?purchaseid={submit.Result.Result.Id}");
                }
            }
        }
        else 
        {
            payErrorMessage = "Please include family to register";
            isShowPayErrorMessage = true;
        }
    }

    private string GetActivityFirstImage {
        get {
            if(activity.Images.Count > 0 )
            {
                return activity.Images.OrderBy(i => i.Order).First().ImageSrc;
            }
            return "https://i1.wp.com/www.slntechnologies.com/wp-content/uploads/2017/08/ef3-placeholder-image.jpg";
        }
    }

    private string GetTotalPerHeadPrice 
    {
        get 
        {
            if(Model.SelectedAttendees.Count == 0)
            {
                return "PHP 0.00";
            }
            return "PHP " + (@Model.SelectedSchedule.Price * Model.SelectedAttendees.Count).ToString("#,###.00");
        }
    }

    private string GetConvinienceFee 
    {
        get {
            if(Model.SelectedAttendees.Count == 0)
            {
                return "PHP 0.00";
            }
            return "PHP " + ((Model.SelectedSchedule.Price * Model.SelectedAttendees.Count) * .15m).ToString("#,###.00");
        }
    }

    private string GetTotalPrice 
    {
        get {
            if(Model.SelectedAttendees.Count == 0)
            {
                return "PHP 0.00";
            }
            return "PHP " + (((Model.SelectedSchedule.Price * Model.SelectedAttendees.Count) + ((Model.SelectedSchedule.Price * Model.SelectedAttendees.Count) * .15m)) - (couponAction == CouponAction.AppliedCoupon ? couponAmount : 0)).ToString("#,###.00");
        }
    }

    private string GetActivityOwnerProfileSrc
    {
        get {
            if(activity.Owner == null || string.IsNullOrEmpty(activity.Owner.ProfilePath))
            {
                return "images/profile/user.png";
            }
            return activity.Owner.ProfilePath;
        }
    }

    class PaymentOption 
    {
        public string PaymentMethod {get; set;}
        public string PaymentChannel {get; set;}
        public string DisplayName {get; set;}
        public string Code {get; set;}
    }
}

@page "/Payment/{ActivityId:int}/{ScheduleId:int}"
@layout LandingMainLayout
@using System.Security.Claims
@using Cinnamon.Web.Enums;
@using Cinnamon.Web.Models;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Shared
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Microsoft.AspNetCore.SignalR.Client;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@inject ITransactionApiHandler transactionApiHandler;
@inject IDashboardApiHandler dashboardApiHandler
@inject IChatApiHandler chatApiHandler
@inject ILogger<Payment> logger

@implements IDisposable

<PageTitle>Checkout Payment | CinnamonPH</PageTitle>
<SeoMeta Title="Checkout Payment" Subject="Checkout Payment" />

@if (IsFullyLoaded)
{
    <Div ElementId="#b-animate" class="purchase-order-page">
        <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">

            <div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3">
                <div class="d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12 px-3">
                    <div class="d-flex col-lg-8 col-md-8 col-sm-12 col-12 px-lg-5 px-md-5 px-sm-0 px-0">
                        <a class="text-decoration-none text-reset" href="/Explore/@Model.Activity.ActivityId"><img src="/images/previous.svg" style="width:20px;" /></a>
                        <h4 class="fw-bold px-3" style="1.9rem">Confirm experience</h4>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3 mb-5">
                <div class="d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12 px-3 m-purchase-container">
                    <div class="col-lg-8 col-md-8 col-sm-12 col-12 px-lg-5 px-md-5 px-sm-0 px-0 order-lg-first order-md-first order-sm-last order-last">
                        <div class="col-lg-5 col-md-5 col-sm-12 col-12">
                            <h5 class="fw-bold" style="font-size:1.5rem;">Activity selected</h5>
                            <CarouselItemSchedule ScheduleModel="Model.SelectedSchedule" ButtonType="@ScheduleButtonType.Change" OnClickChange="OnClickChange" ActivityModel="Model.Activity"></CarouselItemSchedule>
                        </div>
                        <hr />
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <h5 class="fw-bold" style="font-size:1.125rem;">Select who will attend</h5>
                            <Column ColumnSize="ColumnSize.Is12.OnDesktop">
                                <Div class="details overflow-auto" Display="Display.Flex">
                                    <Column class="d-flex flex-row flex-lg-wrap flex-md-wrap flex-sm-nowrap flex-nowrap">
                                        @foreach (var item in Model.Customer.FamilyMembers.OrderBy(f => f.Id))
                                        {
                                            <div class="card text-center p-3 m-1 d-flex flex-row align-items-center text-nowrap" style="border-radius:8px;background-color:#EDF2F8;border:none;">
                                                <Check TValue="bool" id="@item.Id" CheckedChanged="v => SelectedAttendeesChanged(item, v)" class="mx-2 checkbox-round" /> <label for="@item.Id">@item.Name</label>
                                            </div>
                                        }
                                    </Column>
                                </Div>
                            </Column>
                            <button class="btn-primary rounded border-0 my-3 py-2 px-3" style="width:fit-content !important;" @onclick="()=>AddChildrenModal.Open()">Add</button>
                        </div>
                        <hr />
                        <div class="payment-container col-lg-12 col-md-12 col-sm-12 col-12">
                            <h5 class="fw-bold font-20">Pay with</h5>
                            <div class="card-payment-method mt-3">
                                <label class="font-16">Cards</label>
                                <div @onclick="() => CardModal.Show()" class="d-flex justify-content-between border-radius-5 border-1-solid border-color-grey-200 p-3 cursor-pointer">
                                    <div class="card-label d-flex align-items-center">
                                        @if (SelectedPaymentCode != "CARD")
                                        {
                                            <img class="me-4 h-auto" src="images/payment/credit-card.svg" alt="icon">
                                            <span class="font-16">Credit or Debit Card</span>
                                        }
                                        else
                                        {
                                            if (CardPaymentModel.CardNumber[0] == '2' || CardPaymentModel.CardNumber[0] == '5')
                                            {
                                                <img class="me-4 h-auto" style="width: 26px;" src="images/payment/master-card.svg" alt="icon">
                                                <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                            }
                                            else if (CardPaymentModel.CardNumber[0] == '4')
                                            {
                                                <img class="me-4 h-auto" style="width: 36px;" src="images/payment/visa-card.svg" alt="icon">
                                                <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                            }
                                            else
                                            {
                                                <span class="font-16">@MaskedString(CardPaymentModel.CardNumber, 4)</span>
                                            }
                                        }
                                    </div>
                                    <div class="card-icon d-flex align-items-center">
                                        @if (SelectedPaymentCode != "CARD")
                                        {
                                            <img class="me-4 h-auto" style="width: 36px;" src="images/payment/visa-card.svg" alt="icon">
                                            <img class="me-4 h-auto" style="width: 26px;" src="images/payment/master-card.svg" alt="icon">
                                        }
                                        <img class="h-auto" style="width: 8px;" src="images/payment/credit-card-arrow.svg" alt="icon">
                                    </div>
                                </div>
                            </div>
                            <div class="ewallet-payment-method mt-3">
                                <label class="font-16">E-wallets</label>
                                <fieldset class="border-radius-5 border-1-solid border-color-grey-200 p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                               checked='@(SelectedPaymentCode == "GCASH")'
                                               @onchange='() => SelectedPaymentCode = "GCASH"'
                                               id="ewallet-gcash" name="ewallet" value="GCASH" class="me-3 checkbox-round" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/gcash.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Gcash</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                               checked='@(SelectedPaymentCode == "GRABPAY")'
                                               @onchange='() => SelectedPaymentCode = "GRABPAY"'
                                               class="me-3 checkbox-round" id="ewallet-grabpay" name="ewallet" value="GRABPAY" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/grabpay.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Grab Pay</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                               checked='@(SelectedPaymentCode == "SHOPEEPAY")'
                                               @onchange='() => SelectedPaymentCode = "SHOPEEPAY"'
                                               class="me-3 checkbox-round" id="ewallet-shopeepay" name="ewallet" value="SHOPEEPAY" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/shoppepay.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Shopee Pay</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="col-1">
                                            <input type="radio"
                                               checked='@(SelectedPaymentCode == "PAYMAYA")'
                                               @onchange='() => SelectedPaymentCode = "PAYMAYA"'
                                               class="me-3 checkbox-round" id="ewallet-maya" name="ewallet" value="PAYMAYA" />
                                        </div>
                                        <div class="col-2">
                                            <img class="ewallet-icon" src="images/payment/maya.svg" alt="icon">
                                        </div>
                                        <div class="col d-flex flex-column ps-2">
                                            <p class="mb-0 font-16 color-black-100">Maya</p>
                                            <p class="font-10 color-grey-100">
                                                Payment should be completed within 30 mins. Accessible 24/7.
                                            </p>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                            <hr />
                            <div class="form-outline">
                                <label class="form-label" style="font-size:0.8rem;"><small> By selecting the button below, I agree to the Activity Provider’s requirements and activity policies, Cinnamon's Rebooking and Refund Policy, I agree to pay the total amount shown.</small></label>
                                <br />
                                <br />
                                <button class="btn-primary rounded border-0 py-2 px-3 m-width-100" style="@payButtonStyle" @onclick="OnPayConfirmedClicked" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <i class="fa fa-spinner fa-spin"></i>
                                        <span>Please wait</span>
                                    }
                                    else
                                    {
                                        <span>Pay and confirm</span>

                                    }
                                </button>
                                <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="isShowPayErrorMessage">
                                    <AlertDescription>@payErrorMessage</AlertDescription>
                                </Alert>
                            </div>
                        </div>
                    </div>
                    <div class="booking-total-container col-lg-4 col-md-4 col-sm-12 col-12 order-lg-last order-md-last order-sm-first order-first">
                        <div class="sticky-top mb-3" style="top:80px;">
                            <Card>
                                <CardBody>
                                    <div class="d-flex" style="font-size:1.125rem">
                                        <div class="activity-img">
                                            <img src="@GetActivityFirstImage" alt="Activity Image">
                                        </div>
                                        <div class="activity-details">
                                            <span class="fw-bold activity-title">@Model.Activity.Title</span>
                                            <div class="activity-schedule">
                                                @Model.SelectedSchedule.Name
                                            </div>
                                            <div class="activity-schedule">
                                                @Model.SelectedSchedule.DateTime
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="price-details">
                                        <span class="fw-bold price-title">Price Details</span>
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div>
                                                @Model.SelectedSchedule.UnitPrice @Model.SelectedSchedule.LongPrice x @SelectedAttendeesCount head
                                            </div>
                                            <div>
                                                PHP @(GetTotalPerHeadPrice.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                        @if(!IsInclusivePricing)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head">
                                                <div>
                                                    Service Fee - <span style="text-decoration: line-through;">15%</span> <b>5%</b>
                                                </div>
                                                <div>
                                                    PHP @(GetConvinienceFee.ToString("#,##0.00"))
                                                </div>
                                            </div>
                                        }
                                        @if(!IsInclusivePricing)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head service-fee">
                                                <div class="d-flex align-items-center">
                                                    <CustomTooltip MarginLeft="-100">
                                                        <TextContent>
                                                            <span class="rounded-circle service-fee-info">i</span>
                                                        </TextContent>
                                                        <TooltipContent>
                                                            <span class="color-grey-100">
                                                                This helps Cinnamon run its services and protects your payment in case the experience provider does 
                                                                something illegal or against our policy. They won't get paid until after the sessions or work have been done.
                                                            </span>
                                                        </TooltipContent>
                                                    </CustomTooltip> 
                                                    <span class="ms-1">Handling Fee</span>
                                                </div>
                                                <div>
                                                    PHP @(GetServiceFee.ToString("#,##0.00"))
                                                </div>
                                            </div>
                                        }
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div class="d-flex position-relative">
                                                <div class="position-relative" style="width: 150px;">
                                                    <TextEdit class='@(Coupon.IsCouponApplied && !Coupon.IsValid ? "is-invalid" : "")' 
                                                        style='@(Coupon.IsCouponApplied ? "background-color: #F3F6FC; padding-right: 25px" : "background-color: #F3F6FC;")' 
                                                        required Placeholder="Add coupon" Size="Size.ExtraSmall" @bind-Text="Coupon.CouponCode" />
                                                    @if(Coupon.IsCouponApplied && Coupon.IsValid)
                                                    {
                                                        <img @onclick="RemoveAppliedCoupon" class="remove-coupon-icon" src="images/payment/close.png" alt="remove">
                                                    }
                                                </div>
                                                <Button Type="ButtonType.Button" Clicked="ValidateCouponCode"
                                                    class="btn-primary font-12" Border="Border.Is0" Loading="Coupon.IsValidating" Disabled="Coupon.IsValidating"
                                                    style="border-radius: 0; padding-top: 3px; padding-bottom: 3px; margin-left: 3px;">
                                                     <LoadingTemplate>
                                                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                                                    </LoadingTemplate>
                                                    <ChildContent>
                                                        Apply
                                                    </ChildContent>
                                                </Button>
                                                @if(Coupon.IsCouponApplied && !Coupon.IsValid)
                                                {
                                                    <div class="coupon-error-message font-12">
                                                        <b style="color: #AD0C0C;">Invalid Coupon Code</b>
                                                        <br>
                                                        <span class="color-grey-100">
                                                            This coupon code is not valid. Please try again with another coupon code
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <span style='@(GetAppliedCoupon > 0 ? "color: #AD0C0C" : "")'>
                                                    @(GetAppliedCoupon > 0 ? "-" : "") PHP @(GetAppliedCoupon.ToString("#,##0.00"))
                                                </span>
                                            </div>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div class="apply-credits" @onclick="() => Model.IsCreditApplied = !Model.IsCreditApplied">
                                                @if (!Model.IsCreditApplied)
                                                {
                                                    <span>Apply credits</span>
                                                }
                                                else
                                                {
                                                    <span>Remove credits</span>
                                                }
                                            </div>
                                            <div>
                                                PHP @(GetTotalCredit.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                        <hr>
                                        <div class="d-flex justify-content-between py-1 total-payments">
                                            <div>
                                                TOTAL PAYMENT
                                            </div>
                                            <div>
                                               PHP @(GetTotalPrice.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="d-flex align-items-center justify-content-center protected-footer">
                                        <CustomTooltip MarginLeft="-100">
                                            <TextContent>
                                                <span class="color-grey-100">
                                                    Your booking is protected by
                                                </span>
                                            </TextContent>
                                            <TooltipContent>
                                                <span class="color-grey-100">
                                                    Your transaction is secured! Your purchase is supported by our Terms of Use.
                                                    Any concerns about your purchase, you can reach us by sending an email to support@cinnamon.ph
                                                </span>
                                            </TooltipContent>
                                        </CustomTooltip>
                                        <div class="app-name">
                                            @Resources.App.appName
                                        </div>
                                    </div>
                                </CardBody>
                            </Card>
                            <Card class="mt-3">
                                <CardBody class="activity-owner">
                                    <div class="w-100 d-flex">
                                        <div class="image-src">
                                            <img src="@GetActivityOwnerProfileSrc" alt="owner-profile">
                                        </div>
                                        <div class="m-2 maker-profile-details">
                                            <p class="experience-by text-capitalize">Experience by</p>
                                            <p class="owner text-capitalize">@($"{Model.Activity.Owner.FirstName} {Model.Activity.Owner.LastName}")</p>
                                        </div>
                                        <div class="verified-logo">
                                            @if (Model.Activity.Owner.IsVerified == 2)
                                            {
                                                <Tooltip Multiline=true Text="For uploading and completing all identification requirements.">
                                                    <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                                </Tooltip>
                                            }
                                            @if (Model.Activity.Owner.IsOG == true)
                                            {
                                                <Tooltip Multiline=true Text="For being part of the alpha and beta testing.">
                                                    <img class="verified-logo" src="images/Badges/OG.svg" />
                                                </Tooltip>
                                            }
                                            @if (Model.Activity.Owner.IsOfficial == true)
                                            {
                                                <Tooltip Multiline=true Text="Legitimate experience provider in the platform.">
                                                    <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                                </Tooltip>
                                            }
                                            @if (MakerCompletedStudent >= 10)
                                            {
                                                var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                                <Tooltip Multiline=true Text="@rare.Description">
                                                    <img class="verified-logo" src="@rare.ImgScr" />
                                                </Tooltip>
                                            }
                                            @if (MakerCompletedStudent >= 25)
                                            {
                                                var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                                <Tooltip Multiline=true Text="@epic.Description">
                                                    <img class="verified-logo" src="@epic.ImgScr" />
                                                </Tooltip>
                                            }
                                            @if (MakerCompletedStudent >= 100)
                                            {
                                                var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                                <Tooltip Multiline=true Text="@legendary.Description">
                                                    <img class="verified-logo" src="@legendary.ImgScr" />
                                                </Tooltip>
                                            }
                                        </div>
                                    </div>
                                </CardBody>
                            </Card>
                        </div>
                    </div>
                </div>
            </div>

            <AddChildrenModal @ref="AddChildrenModal" SaveEditedFamilyMember="SaveEditedFamilyMember"
                          Model="Model.Customer.FamilyMembers.Select(f => f).ToList()" />
            <SchedulesModal @ref="ModalSched" ScheduleModel="Model.Activity.ActivitySchedules" ActivityModel="Model.Activity" />

            <Modal @ref="CardModal">
                <ModalContent Centered>
                    <ModalHeader Border="Border.Is0">
                        <p class="col-12 modal-title">Add Card Details</p>
                        <button type="button" class="btn-close" @onclick='() => CardModal.Hide()' />
                    </ModalHeader>
                    <ModalBody Padding="Padding.Is0.FromTop">
                        <Divider Margin="Margin.Is0.FromTop.Is2.FromBottom" />
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center">
                                <img class="me-3" src="images/payment/visa-card.svg" alt="icon">
                                <img src="images/payment/master-card.svg" alt="icon">
                            </div>
                            <img src="images/payment/security-guranteed.png" alt="icon">
                        </div>
                        <div class="mt-2">
                            <Validations @ref="PaymentCardValidation" Model="CardPaymentModel" Mode="ValidationMode.Manual">
                                <Validation>
                                    <Field class="mb-3">
                                        <FieldLabel class="font-16 color-grey-100">Card Number</FieldLabel>
                                        <TextEdit @bind-Text="CardPaymentModel.CardNumber">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                                <Validation>
                                    <Field class="mb-3">
                                        <FieldLabel class="font-16 color-grey-100">Name on Card</FieldLabel>
                                        <TextEdit @bind-Text="CardPaymentModel.CardHolder">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </Field>
                                </Validation>
                                <div class="row">
                                    <div class="col">
                                        <Validation>
                                            <Field class="mb-3">
                                                <FieldLabel class="font-16 color-grey-100">Expiration</FieldLabel>
                                                <TextEdit @bind-Text="CardPaymentModel.Expiration" Placeholder="Ex. 03/28">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </Field>
                                        </Validation>
                                    </div>
                                    <div class="col">
                                        <Validation>
                                            <Field class="mb-3">
                                                <FieldLabel class="font-16 color-grey-100">CVV</FieldLabel>
                                                <TextEdit @bind-Text="CardPaymentModel.CVV" Placeholder="123">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </Field>
                                        </Validation>
                                    </div>
                                </div>
                                <div>
                                    <Button Clicked="SelectCardPayment" class="btn-primary w-100 border-radius-5" Border="Border.Is0">
                                        <LoadingTemplate>
                                            <i class="fa fa-spinner fa-spin"></i> Please Wait
                                        </LoadingTemplate>
                                        <ChildContent>
                                            Submit
                                        </ChildContent>
                                    </Button>
                                </div>
                            </Validations>
                        </div>
                    </ModalBody>
                </ModalContent>
            </Modal>
        </Animate>
    </Div>
}

@code
{
    [Parameter]
    public int ActivityId { get; set; }

    [Parameter]
    public int ScheduleId { get; set; }

    private PurchaseModel Model { get; set; }

    private SchedulesModal ModalSched { get; set; }

    public AddChildrenModal AddChildrenModal { get; set; }

    public List<BadgeList> badges = new List<BadgeList>();

    public int MakerOngoingStudennt { get; set; }

    public int MakerCompletedStudent { get; set; }

    private bool IsFullyLoaded { get; set; } = false;

    private IEnumerable<PaymentOption> Payments { get; set; } = new List<PaymentOption>();

    private string SelectedPaymentCode = string.Empty;

    private Modal CardModal { get; set; }

    private Validations PaymentCardValidation { get; set; }

    private Models.Forms.CardPaymentModel CardPaymentModel { get; set; } = new();

    private CouponDetails Coupon {get; set;} = new ();

    private string Token { get; set; }

    private bool IsInclusivePricing {get; set;} = false;

    [Inject] HubConnection hubConnection { get; set; }
    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    protected override async Task OnInitializedAsync()
    {
        await FetchAccountDetails();

        await FetchSelectedAcivityAndSchedule();

        await FetchMakerBadges();

        // payment options
        Payments = new List<PaymentOption> {
            { new PaymentOption {DisplayName = "SHOPEEPAY", PaymentChannel = "SHOPEEPAY", PaymentMethod = "EWALLET", Code = "SHOPEEPAY"} },
            { new PaymentOption {DisplayName = "GRABPAY", PaymentChannel = "GRABPAY", PaymentMethod = "EWALLET", Code = "GRABPAY"}},
            { new PaymentOption {DisplayName = "PAYMAYA", PaymentChannel = "PAYMAYA", PaymentMethod = "EWALLET", Code = "PAYMAYA"}},
            { new PaymentOption {DisplayName = "GCASH", PaymentChannel = "GCASH", PaymentMethod = "EWALLET", Code = "GCASH"}},
            { new PaymentOption {DisplayName = "CARD", PaymentChannel = "CARD", PaymentMethod = "CARD", Code = "CARD"}}
        };

        IsFullyLoaded = true;

        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet()
    {
        SelectedScheduleChanged();
    }

    private async Task FetchAccountDetails()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        if (token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        // get profile details
        var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if ((!profileResult.Succeeded || profileResult.Result == null) || (profileResult.Succeeded && !profileResult.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var profile = profileResult.Result.Result;

        // get family members information
        var familyMembers = new List<Models.Entities.FamilyMember>();
        var members = await accountApiHandler.GetFamilyMembers(token);

        if (members.Succeeded && members.Result != null && members.Succeeded)
        {
            familyMembers = members.Result.Result.Select(m =>
            {
                return new Models.Entities.FamilyMember
                    {
                        BirthMonth = m.BirthMonth,
                        BirthYear = m.BirthYear,
                        Gender = m.Gender,
                        Name = m.Name,
                        Id = m.Id
                    };
            }).ToList();
        }

        Model = new PurchaseModel
            {
                // map only required fields
                Customer = new CustomerProfile
                {
                    About = profile.About,
                    Birthdate = profile.Birthdate,
                    Email = profile.Email,
                    FamilyMembers = familyMembers,
                    FirstName = profile.FirstName,
                    IsMaker = profile.IsMaker,
                    LastName = profile.LastName,
                    IsVerified = profile.IsVerified,
                    ProfilePath = profile.ProfileImg,
                    TotalCredits = profile.TotalCredits,
                    Id = profile.Id
                },
                Token = token
            };

        if (hubConnection.State == HubConnectionState.Disconnected)
        {
            try
            {
                await hubConnection.StartAsync();
            }
            catch (Exception ex)
            {
                await Task.Delay(new Random().Next(0, 5) * 1000);

                while (true)
                {
                    try
                    {
                        await hubConnection.StartAsync();

                        break;
                    }
                    catch (ObjectDisposedException e)
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);
                    }
                    catch
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);
                    }
                }
            }
        }
    }


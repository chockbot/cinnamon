@layout AdminLayout
@page "/admin/announcements"
@using System.Security.Claims;
@using System.ComponentModel.DataAnnotations;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject INotificationService NotificationService;

<PageTitle>Admin - Manage Announcements | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Announcements" Subject="Admin - Manage Announcements" Url="/admin/announcements" />

<section class="admin-dashboard-activities-wrapper">
    <div class="top-row m-d-none">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between mt-5">
        <p class="m-0 font-32 m-font-20 color-orange-100 font-weight-700">Create Announcement</p>
    </div>

    <Row class="bg-white-200 border-radius-10 p-3 mt-4 align-items-center">
        <Column>
            <div>
                <p class="m-0 font-16 color-black-100 font-weight-700">Announcement</p>
                <p class="m-0 color-grey-100 font-16">Post updates and important information to the customers in the loop.</p>
            </div>
        </Column>
        <Column class="text-end">
            <Button Clicked="CreateAnnouncement" class="bg-green-100 color-white-100 hover-color-white">
                Add Announcement
            </Button>
        </Column>
    </Row>

    <div class="activities-section mt-4">
        <div class="table-list">
            <Table Hoverable Responsive class="border-1-solid mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Title
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Status
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Actions
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @* @foreach (var item in activities)
                    {
                        bool isChecked = !item.IsPublished;

                        <TableRow>
                            <TableRowCell class="text-start p-3">@item.Owner.Email</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <label class="d-flex">
                                    <p class="m-0 w-50">@item.Owner.FirstName</p>
                                    <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.Owner.LastName</p>
                                </label>
                            </TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize m-d-none">@item.Owner.LastName</TableRowCell>
                            <TableRowCell class="text-start p-3">
                                <a href="/explore/@(string.IsNullOrEmpty(item.Handler) ? item.ActivityId.ToString() : item.Handler)" target="_blank">
                                    @item.Title
                                </a>
                            </TableRowCell>
                            <TableRowCell class="text-center p-3">
                                <span class="form-switch d-inline">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@isChecked" 
                                        @onchange="((e) => HandleCheckedChanged(e, item))">
                                </span>
                            </TableRowCell>
                        </TableRow>
                    } *@
                </TableBody>
            </Table>
        </div>
    </div>

    <Modal @ref="modalAction">
        <ModalContent>
            <ModalHeader Border="Border.Is0" class="py-2 px-4 border-0-solid justify-content-center border-bottom-1-solid border-color-grey-200 position-relative">
                <p class="font-24 my-2 font-weight-700 color-black-100">Create Announcement</p>
            </ModalHeader>
            <ModalBody>
                <Validations @ref="formValidation" Model="model" Mode="ValidationMode.Manual">
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Title</FieldLabel>
                            <FieldBody>
                                <TextEdit Size="Size.Small" Role="TextRole.Text" @bind-Text="model.Title">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Description</FieldLabel>
                            <FieldBody>
                                <MemoEdit Rows="5" @bind-Text="model.Description">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </MemoEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <label class="d-flex align-items-center mt-4 mb-2 cursor-pointer prevent-select" 
                        @onclick="() => model.HasButtonAction = !model.HasButtonAction">
                        @if(model.HasButtonAction)
                        {
                            <img style="width: 25px; height: auto;" class="me-2" src="images/Dashboard/rounded-check.png" alt="icon">
                        }
                        else 
                        {
                            <img style="width: 25px; height: auto;" class="me-2" src="images/Dashboard/rounded-uncheck.png" alt="icon">
                        }
                        <span class="font-16">Add a call to action button</span>
                    </label>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Button Label</FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="!model.HasButtonAction" Role="TextRole.Text" @bind-Text="model.ButtonLabel">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Link</FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="!model.HasButtonAction" Role="TextRole.Text" @bind-Text="model.Link">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>

                    <div class="d-flex justify-content-end align-items-center mt-4">
                        <Button Clicked="CloseModal" class="me-2 font-16 border-1 border-color-grey-200">
                            Back
                        </Button>
                        <Button Clicked="SaveDraft" class="me-2 font-16 border-1 border-color-grey-200">
                            Save Draft
                        </Button>
                        <Button Clicked="SavePublish" class="font-16 bg-orange-100 color-white-100 hover-color-white">
                            Save and Publish
                        </Button>
                    </div>
                </Validations>
            </ModalBody>
        </ModalContent>
    </Modal>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    string token = string.Empty;
    private Modal? modalAction;
    private AnnouncementModel model = new();
    private Validations? formValidation;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task CreateAnnouncement()
    {
        await modalAction?.Show();
    }

    private async Task CloseModal()
    {
        await modalAction?.Close(CloseReason.UserClosing);
    }

    private Task SaveDraft()
    {
        return SaveAnnouncement("draft");
    }

    private Task SavePublish()
    {
        return SaveAnnouncement("published");
    }

    private async Task SaveAnnouncement(string status)
    {
        await formValidation.ClearAll();
        var isFormValid = await formValidation.ValidateAll();

        if(isFormValid)
        {
            model.Status = status;
            
            var result = await adminApiHandler.CreateAnnouncement(new Framework.ApiCommand.ApiCore.AdminUser.Request.CreateAnnouncementArgs {
                ButtonLabel = model.ButtonLabel,
                Description = model.Description,
                Link = model.Link,
                Status = model.Status,
                Title = model.Title
            }, token);
            var haveError = !result.Succeeded || result.Result is null || !result.Result.IsSuccess;
            if(haveError)
            {
                await NotificationService.Error("An error occured. Please try again.", "Error");
            }
            else 
            {
                await NotificationService.Success("Announcement successfully created.", "Success");
                await CloseModal();
            }
        }
    }

    record AnnouncementModel
    {
        public int Id {get; set;}

        [Required]
        public string Title {get; set;}

        [Required]
        public string Description {get; set;}

        [Required]
        public string ButtonLabel {get; set;}

        [Required]
        public string Link {get; set;}

        public bool HasButtonAction {get; set;}
        public string Status {get; set;}
    }
}

@layout AdminLayout
@page "/admin/announcements"
@using System.Security.Claims;
@using System.ComponentModel.DataAnnotations;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject INotificationService NotificationService;

<PageTitle>Admin - Manage Announcements | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Announcements" Subject="Admin - Manage Announcements" Url="/admin/announcements" />

<section class="admin-dashboard-announcement-wrapper">

    <div class="d-flex flex-column flex-md-row justify-content-between mt-3">
        <p class="verification-title">Create Announcement</p>
    </div>
        <div class="d-flex flex-column flex-md-row justify-content-between custom-flex">
             <div class="mt-0 mt-md-0">
                <button class="create-button m-font-14" @onclick="CreateAnnouncement">Create Announcement</button>
            </div>
            <div class="searchbar-holder ml-md-auto mt-3 mt-md-0">
                <div class="searchBar">
                    <input type="search" id="searchBar" class="form-control search-input" placeholder="Search"
                       @bind-value="SearchText"
                       @oninput="OnInputChanged">
                </div>
            </div>
        </div>

    <div class="activities-section mt-4">
        <div class="table-list">
            <Table Hoverable Responsive class="mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Title
                        </TableHeaderCell>
                        <TableHeaderCell class="text-end color-white-100 p-3">
                            Status
                        </TableHeaderCell>
                        <TableHeaderCell class="text-end color-white-100 p-3">
                            Actions
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in Announcements)
                    {
                        <TableRow VerticalAlignment="VerticalAlignment.Middle">
                            <TableRowCell class="text-start p-3 text-capitalize">@item.Title</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <span class="@item.Status" >@item.Status</span>
                            </TableRowCell>
                            <TableRowCell class="text-start p-3">
                                <Button Clicked="() => EditAnnouncement(item)" class="border-1-solid border-color-grey-200 bg-white-200">
                                    <img src="images/announcements/edit-icon.png" alt="edit">
                                </Button>
                                <Button Clicked="() => ConfirmDelete(item.Id)" class="border-1-solid border-color-grey-200 bg-white-200">
                                    <img src="images/announcements/delete-icon.png" alt="delete">
                                </Button>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </div>
    </div>

    <Modal @ref="modalAction">
        <ModalContent>
            <ModalHeader Border="Border.Is0" class="py-2 px-4 border-0-solid justify-content-center border-bottom-1-solid border-color-grey-200 position-relative">
                <p class="font-24 my-2 font-weight-700 color-black-100">@(userAction == UserAction.Create ? "Create" : "Edit") Announcement</p>
            </ModalHeader>
            <ModalBody>
                <Validations @ref="formValidation" Model="model" Mode="ValidationMode.Manual">
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Title</FieldLabel>
                            <FieldBody>
                                <TextEdit Role="TextRole.Text" @bind-Text="model.Title">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Description</FieldLabel>
                            <FieldBody>
                                <MemoEdit Rows="5" @bind-Text="model.Description">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </MemoEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <label class="d-flex align-items-center mt-4 mb-2 cursor-pointer prevent-select" 
                        @onclick="() => model.HasButtonAction = !model.HasButtonAction">
                        @if(model.HasButtonAction)
                        {
                            <img style="width: 25px; height: auto;" class="me-2" src="images/Dashboard/rounded-check.png" alt="icon">
                        }
                        else 
                        {
                            <img style="width: 25px; height: auto;" class="me-2" src="images/Dashboard/rounded-uncheck.png" alt="icon">
                        }
                        <span class="font-16">Add a call to action button</span>
                    </label>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Button Label</FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="!model.HasButtonAction" Role="TextRole.Text" @bind-Text="model.ButtonLabel">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>
                    <Validation>
                        <Field class="mb-2">
                            <FieldLabel class="font-20">Link</FieldLabel>
                            <FieldBody>
                                <TextEdit Disabled="!model.HasButtonAction" Role="TextRole.Text" @bind-Text="model.Link">
                                    <Feedback>
                                        <ValidationError />
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>

                    <div class="d-flex justify-content-end align-items-center mt-4">
                        <Button Clicked="CloseModal" class="me-2 font-16 border-1 border-color-grey-200">
                            Back
                        </Button>
                        <Button Clicked="SaveDraft" class="me-2 font-16 border-1 border-color-grey-200">
                            Save Draft
                        </Button>
                        <Button Clicked="SavePublish" class="font-16 bg-orange-100 color-white-100 hover-color-white">
                            Save and Publish
                        </Button>
                    </div>
                </Validations>
            </ModalBody>
        </ModalContent>
    </Modal>

    <Modal @ref="modalConfirmation">
        <ModalContent>
            <ModalHeader Border="Border.Is0" class="py-2 px-4 border-0-solid justify-content-center border-bottom-1-solid border-color-grey-200 position-relative">
                <p class="font-18 m-0 font-weight-700">Notice</p>
                <button type="button" style="top: 22px; right: 20px;" class="btn-close position-absolute" 
                    @onclick="() => modalConfirmation.Close(CloseReason.UserClosing)"/>
            </ModalHeader>
            <ModalBody class="text-center">
                <img src="images/announcements/warning-circle.png" alt="warning">
                <p class="font-16 color-grey-100 my-4">
                    Are you sure you want to delete this announcement, 
                    taking into consideration any potential implications or changes it may entail? 
                </p>
                <Button Clicked="DeleteAnnouncement" class="font-16 bg-orange-100 color-white-100 hover-color-white rounded-pill">
                    Delete Anyway
                </Button>
            </ModalBody>
        </ModalContent>
    </Modal>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    string token = string.Empty;
    private Modal? modalAction;
    private AnnouncementModel model = new();
    private Validations? formValidation;
    private IEnumerable<AnnouncementModel> Announcements {get; set;} = Enumerable.Empty<AnnouncementModel>();
    private UserAction userAction = UserAction.View;
    private Modal? modalConfirmation;
    private int selectedToDelete;
    private string SearchText { get; set; } = "";

    private enum UserAction {
        View = 0,
        Create = 1,
        Edit = 2
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await LoadAnnnouncements();
    }

    private async Task LoadAnnnouncements()
    {
        var result = await adminApiHandler.GetAllAnnouncements(token);
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            Announcements = result.Result.Result.Select(a => new AnnouncementModel {
                ButtonLabel = a.ButtonLabel,
                Description = a.Description,
                HasButtonAction = !string.IsNullOrEmpty(a.ButtonLabel) && !string.IsNullOrEmpty(a.Link),
                Id = a.Id,
                Link = a.Link,
                Status = a.Status,
                Title = a.Title
            });
        }
    }

    private async Task ConfirmDelete(int id)
    {
        selectedToDelete = id;
        await modalConfirmation.Show();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task CreateAnnouncement()
    {
        userAction = UserAction.Create;
        await modalAction?.Show();
    }

    private async Task EditAnnouncement(AnnouncementModel announcement)
    {
        model.ButtonLabel = announcement.ButtonLabel;
        model.Id = announcement.Id;
        model.Description = announcement.Description;
        model.HasButtonAction = announcement.HasButtonAction;
        model.Link = announcement.Link;
        model.Status = announcement.Status;
        model.Title = announcement.Title;

        userAction = UserAction.Edit;
        await modalAction.Show();
    }

    private async Task CloseModal()
    {
        userAction = UserAction.View;
        await modalAction?.Close(CloseReason.UserClosing);
    }

    private Task SaveDraft()
    {
        if(userAction == UserAction.Create)
        {
            return SaveCreated("draft");
        }
        else
        {
            return SaveUpdated("draft");
        }
    }

    private Task SavePublish()
    {
        if(userAction == UserAction.Create)
        {
            return SaveCreated("published");
        }
        else 
        {
            return SaveUpdated("published");
        }
    }

    private async Task SaveUpdated(string status)
    {
        await formValidation.ClearAll();
        var isFormValid = await formValidation.ValidateAll();

        if(isFormValid)
        {
            model.Status = status;

            var result = await adminApiHandler.UpdateAnnouncement(new Framework.ApiCommand.ApiCore.AdminUser.Request.UpdateAnnouncementArgs {
                ButtonLabel = model.ButtonLabel,
                Description = model.Description,
                Link = model.Link,
                Status = model.Status,
                Title = model.Title,
                Id = model.Id
            }, token);
            var haveError = !result.Succeeded || result.Result is null || !result.Result.IsSuccess;
            if(haveError)
            {
                await NotificationService.Error("An error occured. Please try again.", "Error");
            }
            else 
            {
                await NotificationService.Success("Announcement successfully updated.", "Success");
                await CloseModal();

                userAction = UserAction.View;
                await LoadAnnnouncements();
            }
        }
    }

    private async Task SaveCreated(string status)
    {
        await formValidation.ClearAll();
        var isFormValid = await formValidation.ValidateAll();

        if(isFormValid)
        {
            model.Status = status;
            
            var result = await adminApiHandler.CreateAnnouncement(new Framework.ApiCommand.ApiCore.AdminUser.Request.CreateAnnouncementArgs {
                ButtonLabel = model.ButtonLabel,
                Description = model.Description,
                Link = model.Link,
                Status = model.Status,
                Title = model.Title
            }, token);
            var haveError = !result.Succeeded || result.Result is null || !result.Result.IsSuccess;
            if(haveError)
            {
                await NotificationService.Error("An error occured. Please try again.", "Error");
            }
            else 
            {
                await NotificationService.Success("Announcement successfully created.", "Success");
                await CloseModal();

                userAction = UserAction.View;
                await LoadAnnnouncements();
            }
        }
    }

    private async Task DeleteAnnouncement()
    {
        var deleteRes = await adminApiHandler.DeleteAnnouncement(new Framework.ApiCommand.ApiCore.AdminUser.Request.DeleteAnnouncementArgs {
            Id = selectedToDelete
        }, token);
        var haveError = !deleteRes.Succeeded || deleteRes.Result is null || !deleteRes.Result.IsSuccess;

        if(haveError)
        {
            await NotificationService.Error("An error occured. Please try again.", "Error");
        }
        else 
        {
            await NotificationService.Success("Announcement successfully deleted.", "Success");
            await modalConfirmation.Close(CloseReason.UserClosing);
            await LoadAnnnouncements();
        }
    }
    private async Task OnInputChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString();

        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            Announcements = Announcements
                .Where(item => item.Title.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            await LoadAnnnouncements();
        }
        StateHasChanged();
    }
    record AnnouncementModel
    {
        public int Id {get; set;}

        [Required]
        public string Title {get; set;}

        [Required]
        public string Description {get; set;}

        [Required]
        public string ButtonLabel {get; set;}

        [Required]
        public string Link {get; set;}

        public bool HasButtonAction {get; set;}
        public string Status {get; set;}
    }
}

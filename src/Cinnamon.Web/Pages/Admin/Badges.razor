@layout AdminLayout
@page "/admin/badges"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;

<PageTitle>Admin - Manage Badges | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Badges" Subject="Admin - Manage Badges" Url="/admin/badges" />

@if (customers != null)
{
    <div class="top-row">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-9">
            <div class="header">
                <p class="title">Manage Customer Badges</p>
            </div>
        </div>
        <div class="col-lg-3">
            <div class="input-group border rounded-pill p-1 search-section">
                <input type="text" placeholder="Search Email" id="19d13aa1-90c0-4232-a7bc-62a772baa223" autocomplete="new-password" @bind-value="searchValue" aria-describedby="button-addon3" class="form-control bg-none border-0">
                <div class="input-group-append border-0">
                    <button id="button-addon3" type="button" class="btn border-0" @onclick="Clear"><i class="fa fa-times" style="color:#8C8C8C"></i></button>
                    <button id="button-addon3" type="button" @onclick="Search" class="btn btn-link text-success" style="background-color:#ffa942;border-radius:50%"><i class="fa fa-search" style="color:white"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="users-section">
        <div class="table-list">
            <Table Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
            <TableHeader>
                <TableRow>
                    <TableHeaderCell>
                        Email
                    </TableHeaderCell>
                    <TableHeaderCell>
                        OG Badge
                    </TableHeaderCell>
                    <TableHeaderCell>
                        Official Partner Badge
                    </TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var item in customers)
                    {
                        <TableRow>
                            <TableRowCell class="name-body">@item.Email</TableRowCell>
                            <TableRowCell class="name-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@item.IsOG" @onchange="((e) => HandleOGChanged(e, item))">
                                </div>
                            </TableRowCell>
                            <TableRowCell class="name-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@item.IsOfficial" @onchange="((e) => HandleOFChanged(e, item))">
                                </div>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
            <Pagination Class="pagination-section" Style="margin-top: 50px">
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
            </Pagination>
        </div>
    </div>
}
@code {
    
    public ClaimsPrincipal AuthState { get; set; }
    public List<CustomerProfile> customers = new List<CustomerProfile>();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    public bool clickButton { get; set; }
    private string currentPage = "1";
    string token = string.Empty;
    public string searchValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllCustomers(1);
    }
    private async Task GetAllCustomers(int pageIndex)
    {
        var result = await accountApiHandler.GetAllCustomer(new Framework.ApiCommand.ApiCore.Account.Request.GetAllCustomersArgs
            {
                SearchValue = searchValue,
                CountPerPage = 20,
                PageIndex = pageIndex
            }, token);

        customers = result.Result.Result.Select(r => new CustomerProfile
            {
                Id = r.Id,
                Email = r.Email,
                LastName = r.LastName,
                FirstName = r.FirstName,
                FrontIdImagePath = r.FrontIdImagePath,
                BackIdImagePath = r.BackIdImagePath,
                IsVerified = r.IsVerified,
                IsVerifiedDate = r.IsVerifiedDate,
                IsChecked = r.IsVerified == 2,
                IsOG = r.IsOG,
                IsOGDate = r.IsOGDate,
                IsOfficial = r.IsOfficial,
                IsOfficialDate = r.IsOfficialDate,
            }).OrderBy(r => r.FirstName).ThenBy(r => r.LastName).ToList();

        Pagination = result.Result.Pagination;
    }
    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task HandleOGChanged(ChangeEventArgs e, CustomerProfile customer)
    {
        bool isChecked = (bool)e.Value;

        bool OGBadge = false;

        if (isChecked)
        {
            OGBadge = true;
        }
        else
        {
            OGBadge = false;
        }

        var result = await accountApiHandler.UpdateCustomerProfile(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
            {
                IsOG = OGBadge,
                IsOGDate = DateTime.UtcNow,
                CustomerId = customer.Id,
                IsOF = customer.IsOfficial,
                IsOFDate = customer.IsOfficialDate,
                VerifiedBadge = customer.IsVerified,
                VerifiedBadgeDate = customer.IsVerifiedDate
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
            await GetAllCustomers(Convert.ToInt32(currentPage));
        }
    }

    private async Task HandleOFChanged(ChangeEventArgs e, CustomerProfile customer)
    {
        bool isChecked = (bool)e.Value;

        bool OFBadge = false;

        if (isChecked)
        {
            OFBadge = true;
        }
        else
        {
            OFBadge = false;

        }
        var result = await accountApiHandler.UpdateCustomerProfile(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
            {
                IsOF = OFBadge,
                IsOFDate = DateTime.UtcNow,
                CustomerId = customer.Id,
                IsOG = customer.IsOG,
                IsOGDate = customer.IsOGDate,
                VerifiedBadge = customer.IsVerified,
                VerifiedBadgeDate = customer.IsVerifiedDate
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
            await GetAllCustomers(Convert.ToInt32(currentPage));
        }
    }
    public async Task Search()
    {
        await GetAllCustomers(1);
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        await GetAllCustomers(1);
    }
    private bool IsActive(string page)
        => currentPage == page;

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllCustomers(int.Parse(page));
    }
}

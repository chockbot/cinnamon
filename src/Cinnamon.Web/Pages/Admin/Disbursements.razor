@layout AdminLayout
@page "/admin/disbursements"
@using System.Security.Claims;
@using Framework.ApiCommand.ApiCore.DTO.Disbursement;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject IJSRuntime jsRuntime

<PageTitle>Admin - Disbursements | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Disbursements" Subject="Admin - Disbursements" Url="/admin/disbursements" />

<section class="admin-dashboard-disbursement-wrapper">
    <div class="top-row">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between mt-5">
        <p class="m-0 font-32 m-font-20 color-orange-100 font-weight-700">Disbursements</p>
        <div class="mt-2 mt-md-0">
        </div>
    </div>

    <div class="transactions-section mt-4">
        <div class="filters">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <h5 for="filter-by" class="m-font-16 mb-0">Filter by</h5>
                </div>
                <Select style="width: 300px; margin-bottom: 1rem;" TValue="Filters" 
                    name="fiter-by" id="filter-by" class="form-control m-font-12 m-width-100" @bind-SelectedValue="selectedValue">
                    <SelectItem Value="Filters.All">All</SelectItem>
                    <SelectItem Value="Filters.Email">Provider Email</SelectItem>
                    <SelectItem Value="Filters.Status">Status</SelectItem>
                </Select>
                <div class="filter-fields mt-3 mb-3">
                    @if(selectedValue == Filters.Email)
                    {
                        <TextEdit class="m-font-16 m-width-100" style="width: 300px;" Placeholder="Provider's email" Role="TextRole.Email" 
                            @bind-Text="selectedFilterValues.StringField" />
                    }
                    else if(selectedValue == Filters.Status)
                    {
                        <Select style="width: 300px;" TValue="string" 
                                class="form-control m-font-16 m-width-100" @bind-SelectedValue="selectedFilterValues.Status">
                            <SelectItem Value=@("")>All</SelectItem>
                            <SelectItem Value=@("initiated")>Pending</SelectItem>
                            <SelectItem Value=@("disbursed")>Disbursed</SelectItem>
                        </Select>
                    }
                </div>
                <div class="d-flex justify-content-between">
                    <Button class="btn-primary min-width-130 font-16 mb-3 m-width-100 m-font-14" Border="Border.Is0" Clicked="SubmitFilters"
                        Size="Size.Small" Type="ButtonType.Button" Loading="IsFetchingTransactions" Disabled="IsFetchingTransactions">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                            Please wait..
                        </LoadingTemplate>
                        <ChildContent>
                            Submit Filter
                        </ChildContent>
                    </Button>
                </div>
            </div>
        </div>
        <div class="table-list">
            <Table Hoverable class="border-1-solid mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Title
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Provider Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Amount
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Status
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in disbursements)
                    {
                        <TableRow>
                            <TableRowCell class="text-start p-3">@item.Label</TableRowCell>
                            <TableRowCell class="text-start p-3">@item.ProviderEmail</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                @item.ProviderFirstName @item.ProviderLastName
                            </TableRowCell>
                            <TableRowCell class="text-start p-3">
                                @item.Amount.ToString("#,##0.00")
                            </TableRowCell>
                            <TableRowCell class="text-start p-3">
                                @if(item.Status == "initiated")
                                {
                                    <p class="m-0 w-50">Pending</p>
                                }
                                else if (item.Status == "disbursed")
                                {
                                    <p class="m-0 w-50">Disbursed</p>
                                }
                                else if (item.Status == "pending")
                                {
                                    <p class="m-0 w-50">Processing</p>
                                }
                                else
                                {
                                    <p class="m-0 w-50">Unknown</p>
                                }
                            </TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <a href=@($"admin/disbursements/{item.Id}")>View Details</a>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </div>
    </div>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    string token = string.Empty;

    private Filters selectedValue = Filters.All;

    private SelectedFilterValues selectedFilterValues = new ();

    private bool IsFetchingTransactions {get; set;}

    private List<DisbursementsInformationDTO> disbursements = new();

    enum Filters {
        All = 0,
        Email = 2,
        Status = 4
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await LoadDisbursements();
    }

    private async Task LoadDisbursements()
    {
        var filterValue = selectedValue switch {
            Filters.All => string.Empty,
            Filters.Email => selectedFilterValues.StringField,
            Filters.Status => selectedFilterValues.Status,
            _ => string.Empty
        };
        var filterBy = selectedValue switch {
            Filters.All => string.Empty,
            Filters.Email => "email",
            Filters.Status => string.IsNullOrEmpty(filterValue) ? string.Empty : "status"
        };

        IsFetchingTransactions = true;

        var result = await adminApiHandler.GetDisbursements(new Framework.ApiCommand.ApiCore.AdminUser.Request.GetDisbursementArgs {
            FilterBy = filterBy,
            FilterValue = filterValue
        }, token);
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            disbursements = result.Result.Result.ToList();
        }

        IsFetchingTransactions = false;
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private Task SubmitFilters()
    {
        return LoadDisbursements();
    }

    public class SelectedFilterValues 
    {
        public string StringField {get; set;}
        public string Status {get; set;}
    }
}

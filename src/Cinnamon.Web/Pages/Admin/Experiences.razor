@layout AdminLayout
@page "/admin/experiences"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IActivityApiHandler activityApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject IJSRuntime jsRuntime
@using ClosedXML.Excel;

<PageTitle>Admin - Manage Experience | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Experience" Subject="Admin - Manage Experience" Url="/admin/experiences" />

<section class="admin-dashboard-activities-wrapper">
    
    <div class="d-flex  mt-3 custom-flex justify-content-between">
        <p class="verification-title">Experience Review Board</p>
        <a href="#" @onclick:preventDefault @onclick="ExportExcel" class="excel-export-text-button">
             <span class="excel-export-text-button desktop-view">Export Excel File</span>
            <img src="images/Dashboard Icon/excel-image-admin-new.svg" alt="Excel Icon" class="ml-2" />
            </a>
    </div>
            <div class="justify-content-between search-bar-parent mt-3">
                <div></div> <!--Empty div to keep search bar sa left-->
                <div class="searchbar-holder ml-md-auto mt-0 mt-md-0 mb-3">
                    <div class="searchBar">
                        <input type="search" id="searchBar" class="form-control search-input" placeholder="Search">
                    </div>
                </div>
            </div>


    <div class="activities-section mt-2">
        <div class="table-list">
            <Table Hoverable Responsive class="border-1-solid mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            First Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Last Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Experience Title
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                            Deactivate
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in activities)
                    {
                        bool isChecked = !item.IsPublished;

                        <TableRow>
                            <TableRowCell class="text-start p-3">@item.Owner.Email</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <label class="d-flex">
                                    <p class="m-0 w-50">@item.Owner.FirstName</p>
                                    <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.Owner.LastName</p>
                                </label>
                            </TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize m-d-none">@item.Owner.LastName</TableRowCell>
                            <TableRowCell class="text-start p-3">
                                <a href="/explore/@(string.IsNullOrEmpty(item.Handler) ? item.ActivityId.ToString() : item.Handler)" target="_blank">
                                    @item.Title
                                </a>
                            </TableRowCell>
                            <TableRowCell class="text-center p-3">
                                <span class="form-switch d-inline">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@isChecked" 
                                        @onchange="((e) => HandleCheckedChanged(e, item))">
                                </span>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        <div class="pagination-main">
<Pagination>
    <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
        <PaginationLink Style="border-radius: 50px; font-size: 13px;">
            <span aria-hidden="true">«</span>
        </PaginationLink>
    </PaginationItem>
@{
    var lastPage = Pagination.TotalPages.GetValueOrDefault(int.MaxValue);
    var startPage = Math.Max(1, Math.Min(int.Parse(currentPage) - 2, lastPage - 3));

    for (var i = startPage; i <= Math.Min(startPage + 3, lastPage); i++)
    {
        var pageNumberAsString = i.ToString();
        <div class="pagination-item">
            <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)" Style="border-radius: 50px; font-size: 13px;">
                <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="border-radius: 50px; font-size: 13px;">
                    @pageNumberAsString
                </PaginationLink>
            </PaginationItem>
        </div>
    }
}
    <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next" Style="border-radius: 50px; font-size: 13px;">
        <PaginationLink Style="border-radius: 50px; font-size: 13px;">
            <span aria-hidden="true">»</span>
        </PaginationLink>
    </PaginationItem>
</Pagination>
        </div>
        </div>
    </div>
</section>

@code 
{
    IJSObjectReference module;
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    private int CountPerPage { get; set; } = 10;
    public List<Activity> activities = new List<Activity>();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private const string PREVIOUS = "previous";
    private const string NEXT = "next";
    private string currentPage = "1";
    private int pageItems = 1;
    string token = string.Empty;
    public string searchValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;
        await GetAllActivities(int.Parse(currentPage));
        pageItems = activities.Count;
    

        await GetAllActivities(1);
    }

    private async Task GetAllActivities(int pageIndex)
    {
        var result = await activityApiHandler.GetAllActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllActivitiesArgs
            {
                IncludeActivityAddress = true,
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true,
                PageIndex = pageIndex,
                CountPerPage = CountPerPage,
                IncludeCustomer = true,
                IncludeStudents = true,
                SearchValue = searchValue,
                IsAdmin = true
            });

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            activities = result.Result.Result.Select(r => new Activity
                {
                    Guid = Guid.NewGuid(),
                    ActivityId = r.ActivityId,
                    ExperienceTypeId = r.ExperienceTypeId,
                    ExperienceType = r.ExperienceType,
                    ExperienceCategoryId = r.ExperienceCategoryId,
                    SubCategoryId = r.SubCategoryId,
                    ExperienceCategory = r.ExperienceCategory,
                    SubCategory = r.SubCategory,
                    Title = r.Title,
                    Description = r.Description,
                    Price = r.Price,
                    ScheduleIndicator = r.ScheduleIndicator,
                    Remarks = r.Remarks,
                    IsPublished = r.IsPublished,
                    Address1 = r.Address1,
                    Address2 = r.Address2,
                    District = r.District,
                    City = r.City,
                    CityName = r.CityName,
                    Subdivision = r.Subdivision,
                    Region = r.Region,
                    RegionName = r.RegionName,
                    Barangay = r.Barangay,
                    BarangayName = r.BarangayName,
                    PostalCode = r.PostalCode,
                    SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                    CustomerBringWithThem = r.CustomerBringWithThem,
                    AdditionalRequirements = r.AdditionalRequirements,
                    ActivityLevel = r.ActivityLevel,
                    SkillLevel = r.SkillLevel,
                    MinimumAge = r.MinimumAge,
                    CanAdultsJoin = r.CanAdultsJoin,
                    CreatedBy = r.CreatedBy,
                    Handler = r.Handler,
                    IsNew = r.IsNew,
                    OngoingStudents = r.OngoingStudents,
                    CompletedStudents = r.CompletedStudents,
                    IsDeactivated = r.IsDeactivated,
                    ActivitySchedules = r.ActivitySchedules.Select(e =>
                   {
                       return new ActivitySchedule
                       {
                           Id = e.Id,
                           Name = e.Name,
                           PerUnit1 = e.PerUnit1,
                           PerUnit2 = e.PerUnit2,
                           Price = e.Price,
                           PriceUnit1 = e.PriceUnit1,
                           PriceUnit2 = e.PriceUnit2,
                           UnitPrice = e.UnitPrice
                       };
                   }).ToList(),
                    Images = r.Images.Select(i =>
{
return new ActivityImage
{
Id = i.Id,
ImageSrc = i.ImageSrc,
Name = i.Name
};
}).ToList(),
                    Owner = new CustomerProfile
                    {
                        IsVerified = r.Owner.IsVerified,
Email = r.Owner.Email,
FirstName = r.Owner.FirstName,
LastName = r.Owner.LastName
                    }
                }).ToList();

            Pagination = result.Result.Pagination;
        }

        
    }



    private bool IsActive(string page)
        => currentPage == page;

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllActivities(int.Parse(page));
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task HandleCheckedChanged(ChangeEventArgs e, Activity activity)
    {
        bool isChecked = (bool)e.Value;

        var result = await activityApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateActivityArgs
            {
                IsPublished = !isChecked,
                ActivityId = activity.ActivityId,
                IsAdmin = true
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
        }
    }

    private bool IsPageNavigationDisabled(string navigation )
    {
        if (navigation.Equals(PREVIOUS))
        {
            return currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return currentPage.Equals(pageItems.ToString());
        }
        return false;
    }

private async Task Previous()
{
    var currentPageAsInt = int.Parse(currentPage);
    if (currentPageAsInt > 1)
    {
        currentPageAsInt -= 1;
        currentPage = currentPageAsInt.ToString();
        await GetAllActivities(currentPageAsInt); // Fetch the data for the previous page
    }
}


private async Task Next()
{
    var currentPageAsInt = int.Parse(currentPage);
    if (currentPageAsInt < Pagination.TotalPages.GetValueOrDefault(int.MaxValue))
    {
        currentPage = (currentPageAsInt + 1).ToString();
        await GetAllActivities(currentPageAsInt + 1); // Fetch the data for the next page
    }
}


    public async Task Search()
    {
        if (string.IsNullOrEmpty(searchValue))
        {
            await Clear();
        }
        else
        {
        await GetAllActivities(1);
        }
    }


    private async Task ExportExcel()
    {   
        await Task.Delay(1000);

        var originalCountPerPage = CountPerPage;

        CountPerPage = Int32.MaxValue;

        
    try
    {
        await GetAllActivities(1);

        CountPerPage = originalCountPerPage;
        using (var workbook = new XLWorkbook("wwwroot/Template/ExperienceList.xlsx"))
        {
            var worksheet = workbook.Worksheet(1);
            int startRow = 3;
            foreach (var item in activities)
            {
                worksheet.Cell(startRow, 1).Value = item.Owner.Email;
                worksheet.Cell(startRow, 2).Value = item.Owner.FirstName;
                worksheet.Cell(startRow, 3).Value = item.Owner.LastName;
                worksheet.Cell(startRow, 4).Value = item.Title;
                worksheet.Cell(startRow, 5).Value = item.IsPublished ? "No" : "Yes";
                startRow++;
            }
            using (var memoryStream = new MemoryStream())
            {
                workbook.SaveAs(memoryStream);
                memoryStream.Seek(0, SeekOrigin.Begin);

                var currentDate = DateTime.Now.ToString("yyyyMMddHHmmss");
                var fileName = $"ExperienceList_{currentDate}.xlsx";
                byte[] bytes = memoryStream.ToArray();

                var bytesBase64 = Convert.ToBase64String(bytes);

                await Task.Run(() => module.InvokeVoidAsync("saveAsFile", fileName, bytesBase64));
                CountPerPage = originalCountPerPage;
                StateHasChanged();
            }
        }
    }
    finally
    {
        CountPerPage = originalCountPerPage;
        await GetAllActivities(1);
        StateHasChanged();
    }
}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/exportToExcel.js");
        }
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        await GetAllActivities(1);
    }
}
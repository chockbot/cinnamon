@layout AdminLayout
@page "/admin/experiences"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IActivityApiHandler activityApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;

<PageTitle>Admin - Manage Experience | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Experience" Subject="Admin - Manage Experience" Url="/admin/experiences" />

<section class="admin-dashboard-activities-wrapper">
    <div class="top-row m-d-none">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between mt-5">
        <p class="m-0 font-32 m-font-20 color-orange-100 font-weight-700">Experience Review Board</p>
        <div class="mt-2 mt-md-0">
            <div class="input-group border rounded-pill p-1">
                <input type="text" placeholder="Location | Experience" id="19d13aa1-90c0-4232-a7bc-62a772baa223" 
                    autocomplete="new-password" @bind-value="searchValue" aria-describedby="button-addon3" 
                    class="form-control bg-none border-0" 
                    style="border-top-left-radius: 50rem !important; border-bottom-left-radius: 50rem !important;">
                <div class="input-group-append border-0">
                    <Button Type="ButtonType.Button" class="border-0" Clicked="Clear">
                        <i class="fa fa-times" style="color:#8C8C8C"></i>
                    </Button>
                    <Button Type="ButtonType.Button" Clicked="Search" 
                        class="bg-orange-100 rounded-pill">
                        <i class="fa fa-search" style="color:white"></i>
                    </Button>
                </div>
            </div>
        </div>
    </div>

    <div class="activities-section mt-4">
        <div class="table-list">
            <Table Hoverable Responsive class="border-1-solid mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start">
                            First Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start">
                            Last Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start">
                            Experience Title
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center">
                            Deactivate
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in activities)
                    {
                        bool isChecked = !item.IsPublished;

                        <TableRow>
                            <TableRowCell class="text-start p-3">@item.Owner.Email</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <label class="d-flex">
                                    <p class="m-0 w-50">@item.Owner.FirstName</p>
                                    <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.Owner.LastName</p>
                                </label>
                            </TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize m-d-none">@item.Owner.LastName</TableRowCell>
                            <TableRowCell class="text-start p-3">
                                <a href="/explore/@(string.IsNullOrEmpty(item.Handler) ? item.ActivityId.ToString() : item.Handler)" target="_blank">
                                    @item.Title
                                </a>
                            </TableRowCell>
                            <TableRowCell class="text-center p-3">
                                <span class="form-switch d-inline">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@isChecked" 
                                        @onchange="((e) => HandleCheckedChanged(e, item))">
                                </span>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
            <Pagination Class="pagination-section">
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
            </Pagination>
        </div>
    </div>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public List<Activity> activities = new List<Activity>();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private string currentPage = "1";
    string token = string.Empty;
    public string searchValue = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllActivities(1);
    }

    private async Task GetAllActivities(int pageIndex)
    {
        var result = await activityApiHandler.GetAllActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllActivitiesArgs
            {
                IncludeActivityAddress = true,
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true,
                PageIndex = pageIndex,
                CountPerPage = 10,
                IncludeCustomer = true,
                IncludeStudents = true,
                SearchValue = searchValue,
                IsAdmin = true
            });

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            activities = result.Result.Result.Select(r => new Activity
                {
                    Guid = Guid.NewGuid(),
                    ActivityId = r.ActivityId,
                    ExperienceTypeId = r.ExperienceTypeId,
                    ExperienceType = r.ExperienceType,
                    ExperienceCategoryId = r.ExperienceCategoryId,
                    SubCategoryId = r.SubCategoryId,
                    ExperienceCategory = r.ExperienceCategory,
                    SubCategory = r.SubCategory,
                    Title = r.Title,
                    Description = r.Description,
                    Price = r.Price,
                    ScheduleIndicator = r.ScheduleIndicator,
                    Remarks = r.Remarks,
                    IsPublished = r.IsPublished,
                    Address1 = r.Address1,
                    Address2 = r.Address2,
                    District = r.District,
                    City = r.City,
                    CityName = r.CityName,
                    Subdivision = r.Subdivision,
                    Region = r.Region,
                    RegionName = r.RegionName,
                    Barangay = r.Barangay,
                    BarangayName = r.BarangayName,
                    PostalCode = r.PostalCode,
                    SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                    CustomerBringWithThem = r.CustomerBringWithThem,
                    AdditionalRequirements = r.AdditionalRequirements,
                    ActivityLevel = r.ActivityLevel,
                    SkillLevel = r.SkillLevel,
                    MinimumAge = r.MinimumAge,
                    CanAdultsJoin = r.CanAdultsJoin,
                    CreatedBy = r.CreatedBy,
                    Handler = r.Handler,
                    IsNew = r.IsNew,
                    OngoingStudents = r.OngoingStudents,
                    CompletedStudents = r.CompletedStudents,
                    IsDeactivated = r.IsDeactivated,
                    ActivitySchedules = r.ActivitySchedules.Select(e =>
                   {
                       return new ActivitySchedule
                       {
                           Id = e.Id,
                           Name = e.Name,
                           PerUnit1 = e.PerUnit1,
                           PerUnit2 = e.PerUnit2,
                           Price = e.Price,
                           PriceUnit1 = e.PriceUnit1,
                           PriceUnit2 = e.PriceUnit2,
                           UnitPrice = e.UnitPrice
                       };
                   }).ToList(),
                    Images = r.Images.Select(i =>
{
return new ActivityImage
{
Id = i.Id,
ImageSrc = i.ImageSrc,
Name = i.Name
};
}).ToList(),
                    Owner = new CustomerProfile
                    {
                        IsVerified = r.Owner.IsVerified,
Email = r.Owner.Email,
FirstName = r.Owner.FirstName,
LastName = r.Owner.LastName
                    }
                }).ToList();

            Pagination = result.Result.Pagination;
        }

        
    }

    private bool IsActive(string page)
        => currentPage == page;

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllActivities(int.Parse(page));
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task HandleCheckedChanged(ChangeEventArgs e, Activity activity)
    {
        bool isChecked = (bool)e.Value;

        var result = await activityApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateActivityArgs
            {
                IsPublished = !isChecked,
                ActivityId = activity.ActivityId,
                IsAdmin = true
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
        }
    }

    public async Task Search()
    {
        await GetAllActivities(1);
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        await GetAllActivities(1);
    }
}

@layout AdminLayout
@page "/admin/inclusive-transactions"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject IJSRuntime jsRuntime

<PageTitle>Admin - Inclusive Transactions | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Inclusive Transactions" Subject="Admin - Inclusive Transactions" Url="/admin/inclusive-transactions" />

<section class="admin-dashboard-transactions-wrapper">

    <div class="d-flex  mt-3 custom-flex justify-content-between">
        <p class="verification-title">Inclusive Transactions</p>
        <a href="#" @onclick="ExportExcel" class="excel-export-text-button">
             <span class="excel-export-text-button desktop-view">Export Excel File</span>
            <img src="images/Dashboard Icon/excel-image-admin-new.svg" alt="Excel Icon" class="ml-2" />
            </a>
    </div>

    <div class="transactions-section mt-0">
        <div class="filters">
            <div>
                <div class="d-flex flex-column flex-md-row  mt-0 custom-flex">
                    <div class="d-flex flex-column flex-md-row  mt-3 custom-flex">
                        <Select TValue="Filters" 
                            name="fiter-by" id="filter-by" class="form-control m-font-12 m-width-100 w-100" @bind-SelectedValue="selectedValue">
                            <SelectItem Value="Filters.All">All</SelectItem>
                            <SelectItem Value="Filters.Name">Provider Name</SelectItem>
                            <SelectItem Value="Filters.Email">Provider Email</SelectItem>
                            <SelectItem Value="Filters.Date">Date Purchased</SelectItem>
                            <SelectItem Value="Filters.Status">Status</SelectItem>
                        </Select>
                     </div>
                    <div class="d-flex flex-column flex-md-row mb-3 mt-3 custom-flex">
                        @if(selectedValue == Filters.Name)
                        {
                            <TextEdit class="m-font-16 m-width-100" style="width: 300px;" Placeholder="Provider's first name or last name" Role="TextRole.Text" 
                                @bind-Text="selectedFilterValues.StringField" />
                        }
                        else if(selectedValue == Filters.Email)
                        {
                            <TextEdit class="m-font-16 m-width-100" style="width: 300px;" Placeholder="Provider's email" Role="TextRole.Email" 
                                @bind-Text="selectedFilterValues.StringField" />
                        }
                        else if(selectedValue == Filters.Status)
                        {
                            <Select style="width: 300px;" TValue="int" 
                                class="form-control m-font-16 m-width-100" @bind-SelectedValue="selectedFilterValues.Status">
                                    <SelectItem Value="0">Processing</SelectItem>
                                    <SelectItem Value="1">Paid</SelectItem>
                                    <SelectItem Value="2">Failed</SelectItem>
                                    <SelectItem Value="3">Refunded</SelectItem>
                                    <SelectItem Value="5">Disbursed</SelectItem>
                            </Select>
                        }
                        else if(selectedValue == Filters.Date)
                        {
                            <div style="width: 300px; gap: 10px;" class="m-width-100 d-flex justify-content-between">
                                <div class="mb-0">
                                    <DatePicker class="m-font-12" TValue="DateTime" Placeholder="From" Date="selectedFilterValues.DateFrom" 
                                        DateChanged="v => selectedFilterValues.DateFrom = v" />
                                </div>
                                <div>
                                    <DatePicker class="m-font-12" TValue="DateTime" Placeholder="To" Date="selectedFilterValues.DateTo" 
                                        DateChanged="v => selectedFilterValues.DateTo = v" />
                                </div>
                            </div>
                        }
                    </div>
                    <div class="d-flex justify-content-between">
                    <Button class="btn-primary min-width-130 font-20 mb-3 m-width-100 m-font-14" Border="Border.Is0" Clicked="SubmitFilters"
                        Size="Size.Small" Type="ButtonType.Button" Loading="IsFetchingTransactions" Disabled="IsFetchingTransactions">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                            Please wait..
                        </LoadingTemplate>
                        <ChildContent>
                            Submit
                        </ChildContent>
                    </Button>
                    </div>
                </div>
                <hr class="w-100" style="margin-top: 6px; margin-bottom: 12px;">
                <div class="justify-content-between search-bar-parent">
                     <div></div> <!--Empty div to keep search bar sa left-->
                    <div class="searchbar-holder ml-md-auto mt-0 mt-md-0 mb-3">
                        <div class="searchBar">
                            <form @onsubmit="Search">
                                <input type="search" id="searchBar" class="form-control search-input" placeholder="Search" 
                                autocomplete="new-password" @bind-value="searchValue" aria-describedby="button-addon3">
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-list">
            <Table Hoverable class="mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            First Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Last Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                            Total
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                        Convenience Fee
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                            Credit Amount
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                            Overall Total
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                            Status
                        </TableHeaderCell>
                        <TableHeaderCell class="text-end color-white-100 p-3">
                            Date Purchased
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                @if(transactions != null)
                {
                    <TableBody>
                        @foreach (var item in transactions)
                        {
                            <TableRow>
                                <TableRowCell class="text-start p-3">@item.Provider.Email</TableRowCell>
                                <TableRowCell class="text-start p-3 text-capitalize">
                                    <label class="d-flex">
                                        <p class="m-0 w-50">@item.Provider.FirstName</p>
                                        <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.Provider.LastName</p>
                                    </label>
                                </TableRowCell>
                                <TableRowCell class="text-start p-3 text-capitalize m-d-none">
                                    @item.Provider.LastName
                                </TableRowCell>
                                <TableRowCell class="text-center p-3">
                                    <label class="d-flex">
                                        <p class="m-0 w-50">@item.Total</p>
                                        <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.ConvinienceFee</p>
                                    </label>
                                </TableRowCell>
                                <TableRowCell class="text-center p-3 m-d-none">@item.ConvinienceFee</TableRowCell>
                                <TableRowCell class="text-center p-3">
                                    <label class="d-flex">
                                        <p class="m-0 w-50">@item.CreditAmount</p>
                                        <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.OverallTotal</p>
                                    </label>
                                </TableRowCell>
                                <TableRowCell class="text-center p-3 m-d-none">@item.OverallTotal</TableRowCell>
                                <TableRowCell class="text-center p-3">
                                    <label class="d-flex">
                                        @if(item.Status == 0)
                                        {
                                            <p class="m-0 w-50">Processing</p>
                                        }
                                        else if (item.Status == 1)
                                        {
                                            <p class="m-0 w-50">Payed</p>
                                        }
                                        else if (item.Status == 2)
                                        {
                                            <p class="m-0 w-50">Failed</p>
                                        }
                                        else if(item.Status == 3)
                                        {
                                            <p class="m-0 w-50">Refunded</p>
                                        }
                                        else if(item.Status == 5)
                                        {
                                            <p class="m-0 w-50">Disbursed</p>
                                        }
                                        else
                                        {
                                            <p class="m-0 w-50">Unknown</p>
                                        }
                                        <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.OverallTotal</p>
                                    </label>
                                </TableRowCell>
                                <TableRowCell class="text-end p-3 m-d-none">
                                    @item.PurchaseDate.ToString("MMM/dd/yyyy")
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                }
            </Table>
            <Pagination class="pagination-section mt-3">
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
            </Pagination>
        </div>
    </div>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public IEnumerable<InclusiveTransactionDto> transactions;
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private string currentPage = "1";
    string token = string.Empty;
    public string searchValue = string.Empty;

    private Filters selectedValue = Filters.All;

    private SelectedFilterValues selectedFilterValues = new ();

    private bool IsFetchingTransactions {get; set;}

    enum Filters {
        All = 0,
        Name = 1,
        Email = 2,
        Date = 3,
        Status = 4
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllTransactions(1);
    }

    private async Task GetAllTransactions(int pageIndex, bool isFiltered = false)
    {
        if(isFiltered)
        {
            
            IsFetchingTransactions = true;
        }
        var result = await adminApiHandler.GetAllInclusiveTransactions(new Framework.ApiCommand.ApiCore.AdminUser.Request.GetAllInclusiveTransactionArgs {
            Email = selectedValue == Filters.Email ? selectedFilterValues.StringField : null,
            Name = selectedValue == Filters.Name ? selectedFilterValues.StringField : null,
            Status = selectedValue == Filters.Status ? selectedFilterValues.Status : null,
            PurchaseDateFrom = selectedValue == Filters.Date ? selectedFilterValues.DateFrom.ToString("yyyyMMddHHmmss") : null,
            PurchaseDateTo = selectedValue == Filters.Date ? selectedFilterValues.DateTo.ToString("yyyyMMddHHmmss") : null
        }, token);

        if(isFiltered)
        {
            IsFetchingTransactions = false;
        }
    
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            transactions = result.Result.Result
            .Where(t => string.IsNullOrEmpty(searchValue)
                || (t.Provider.Email != null && t.Provider.Email.Contains(searchValue, StringComparison.OrdinalIgnoreCase))
                || (t.Provider.FirstName != null && t.Provider.FirstName.Contains(searchValue, StringComparison.OrdinalIgnoreCase))
                || (t.Provider.LastName != null && t.Provider.LastName.Contains(searchValue, StringComparison.OrdinalIgnoreCase))
                || (t.PurchaseOrderId.ToString().Contains(searchValue))
                || (t.Status.ToString().Contains(searchValue)))
                .Select(t => new InclusiveTransactionDto
                {
                    ConvinienceFee = t.ConvinienceFee,
                    CreditAmount = t.CreditAmount,
                    OverallTotal = t.OverallTotal,
                    PurchaseDate = t.PurchaseDate,
                    PurchaseOrderId = t.PurchaseOrderId,
                    Status = t.Status,
                    Total = t.Total,
                    UnitCount = t.UnitCount,
                    UnitPrice = t.UnitPrice,
                    Provider = new InclusiveTransactionDto.ProviderDto
                    {
                        Email = t.Provider.Email,
                        FirstName = t.Provider.FirstName,
                        LastName = t.Provider.LastName
                    }
                }).ToList();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrEmpty(searchValue))
        {
            await Clear();
        }
        else
        {
            await GetAllTransactions(1, false);
        }
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        await GetAllTransactions(1, false);
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private bool IsActive(string page)
        => currentPage == page;


    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllTransactions(int.Parse(page));
    }

    private Task SubmitFilters()
    {
        return GetAllTransactions(0, true);
    }

    private async Task ExportExcel()
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Utils.excelWriter.execute", transactions);
    }

    public class InclusiveTransactionDto
    {
        public int PurchaseOrderId {get; set;}
        public DateTime PurchaseDate {get; set;}
        public int UnitCount {get; set;}
        public decimal UnitPrice {get; set;}
        public decimal Total {get; set;}
        public decimal ConvinienceFee {get; set;}
        public decimal CreditAmount {get; set;}
        public decimal OverallTotal {get; set;}
        public int Status {get; set;}

        public ProviderDto Provider {get; set;} = new();

        public class ProviderDto 
        {
            public string FirstName {get; set;}
            public string LastName {get; set;}
            public string Email {get; set;}
        }
    }

    public class SelectedFilterValues 
    {
        public string StringField {get; set;}
        public int Status {get; set;}
        public DateTime DateFrom {get; set;} = DateTime.Now;
        public DateTime DateTo {get; set;} = DateTime.Now;
    }
}

@layout AdminLayout
@page "/admin/inclusive-transactions"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;
@inject IJSRuntime jsRuntime

<PageTitle>Admin - Inclusive Transactions | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Inclusive Transactions" Subject="Admin - Inclusive Transactions" Url="/admin/inclusive-transactions" />

<div class="top-row">
    <div class="dropdown">
        <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
            <div class="menu">
                <img src="images/menu.png">
            </div>
        </button>
        <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
            @if (AuthState != null)
            {
                @if (AuthState.Identity.IsAuthenticated)
                {
                    <li class="dropdown-item">
                        <Button Border="Border.Is0" Clicked="Logout">
                            Logout
                        </Button>
                    </li>
                }
            }
        </ul>
    </div>
</div>
<div class="header">
    <p class="title">Inclusive Transactions</p>
</div>
<div class="users-section">
    <div class="filters">
        <div>
            <h5 for="filter-by">Filter by</h5>
            <Select style="width: 300px; margin-bottom: 1rem;" TValue="Filters" 
                name="fiter-by" id="filter-by" class="form-control" @bind-SelectedValue="selectedValue">
                <SelectItem Value="Filters.All">All</SelectItem>
                <SelectItem Value="Filters.Name">Provider Name</SelectItem>
                <SelectItem Value="Filters.Email">Provider Email</SelectItem>
                <SelectItem Value="Filters.Date">Date Purchased</SelectItem>
                <SelectItem Value="Filters.Status">Status</SelectItem>
            </Select>
            <div class="filter-fields mt-3 mb-3">
                @if(selectedValue == Filters.Name)
                {
                    <TextEdit style="width: 300px;" Placeholder="Provider's first name or last name" Role="TextRole.Text" @bind-Text="selectedFilterValues.StringField" />
                }
                else if(selectedValue == Filters.Email)
                {
                    <TextEdit style="width: 300px;" Placeholder="Provider's email" Role="TextRole.Email" @bind-Text="selectedFilterValues.StringField" />
                }
                else if(selectedValue == Filters.Status)
                {
                    <Select style="width: 300px;" TValue="int" 
                            class="form-control" @bind-SelectedValue="selectedFilterValues.Status">
                        <SelectItem Value="0">Processing</SelectItem>
                        <SelectItem Value="1">Payed</SelectItem>
                        <SelectItem Value="2">Failed</SelectItem>
                        <SelectItem Value="3">Refunded</SelectItem>
                        <SelectItem Value="5">Disbursed</SelectItem>
                    </Select>
                }
                else if(selectedValue == Filters.Date)
                {
                    <div style="width: 300px;">
                        <div class="mb-3">
                            <label>from</label>
                            <DatePicker TValue="DateTime" Placeholder="date from" Date="selectedFilterValues.DateFrom" 
                                DateChanged="v => selectedFilterValues.DateFrom = v" />
                        </div>
                        <div>
                            <label>to</label>
                            <DatePicker TValue="DateTime" Placeholder="date to" Date="selectedFilterValues.DateTo" 
                                DateChanged="v => selectedFilterValues.DateTo = v" />
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between">
                <Button class="btn-primary min-width-130 font-20 mb-3" Border="Border.Is0" Clicked="SubmitFilters"
                    Size="Size.Small" Type="ButtonType.Button" Loading="IsFetchingTransactions" Disabled="IsFetchingTransactions">
                    <LoadingTemplate>
                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                        Please wait..
                    </LoadingTemplate>
                    <ChildContent>
                        Submit Filter
                    </ChildContent>
                </Button>
                <Button Clicked="ExportExcel" class="btn-primary min-width-130 font-20 mb-3" 
                    Border="Border.Is0" Size="Size.Small" Type="ButtonType.Button">
                    Export to Excel
                </Button>
            </div>
        </div>
    </div>
    <div class="table-list">
        <Table Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
            <TableHeader>
                <TableRow>
                    <TableHeaderCell class="text-start">
                        First Name
                    </TableHeaderCell>
                    <TableHeaderCell class="text-start">
                        Last Name
                    </TableHeaderCell>
                    <TableHeaderCell class="text-start">
                        Email
                    </TableHeaderCell>
                    <TableHeaderCell class="text-center">
                        Total
                    </TableHeaderCell>
                    <TableHeaderCell class="text-center">
                       Convenience Fee
                    </TableHeaderCell>
                    <TableHeaderCell class="text-center">
                        Credit Amount
                    </TableHeaderCell>
                    <TableHeaderCell class="text-center">
                        Overall Total
                    </TableHeaderCell>
                    <TableHeaderCell class="text-center">
                        Status
                    </TableHeaderCell>
                    <TableHeaderCell class="text-end">
                        Date Purchased
                    </TableHeaderCell>
                </TableRow>
            </TableHeader>
            @if(transactions != null)
            {
                <TableBody>
                    @foreach (var item in transactions)
                    {
                        <TableRow>
                            <TableRowCell class="name-body text-capitalize">@item.Provider.FirstName</TableRowCell>
                            <TableRowCell class="name-body text-capitalize">@item.Provider.LastName</TableRowCell>
                            <TableRowCell class="name-body">@item.Provider.Email</TableRowCell>
                            <TableRowCell class="name-body text-center">@item.Total</TableRowCell>
                            <TableRowCell class="name-body text-center">@item.ConvinienceFee</TableRowCell>
                            <TableRowCell class="name-body text-center">@item.CreditAmount</TableRowCell>
                            <TableRowCell class="name-body text-center">@item.OverallTotal</TableRowCell>
                            <TableRowCell class="name-body">
                                @if(item.Status == 0)
                                {
                                    <span>Processing</span>
                                }
                                else if (item.Status == 1)
                                {
                                    <span>Payed</span>
                                }
                                else if (item.Status == 2)
                                {
                                    <span>Failed</span>
                                }
                                else if(item.Status == 3)
                                {
                                    <span>Refunded</span>
                                }
                                else if(item.Status == 5)
                                {
                                    <span>Disbursed</span>
                                }
                                else
                                {
                                    <span>Unknown</span>
                                }
                            </TableRowCell>
                            <TableRowCell class="name-body text-end">@item.PurchaseDate.ToString("MMM/dd/yyyy")</TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            }
        </Table>
        <Pagination Class="pagination-section" Style="margin-top: 50px">
            @{
                for (var i = 1; i <= Pagination.TotalPages; i++)
                {
                    var pageNumberAsString = i.ToString();
                    <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                        <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                            @pageNumberAsString
                        </PaginationLink>
                    </PaginationItem>
                }
            }
        </Pagination>
    </div>
</div>


@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public IEnumerable<InclusiveTransactionDto> transactions;
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private string currentPage = "1";
    string token = string.Empty;

    private Filters selectedValue = Filters.All;

    private SelectedFilterValues selectedFilterValues = new ();

    private bool IsFetchingTransactions {get; set;}

    enum Filters {
        All = 0,
        Name = 1,
        Email = 2,
        Date = 3,
        Status = 4
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllTransactions(1);
    }

    private async Task GetAllTransactions(int pageIndex, bool isFiltered = false)
    {
        if(isFiltered)
        {
            IsFetchingTransactions = true;
        }
        var result = await adminApiHandler.GetAllInclusiveTransactions(new Framework.ApiCommand.ApiCore.AdminUser.Request.GetAllInclusiveTransactionArgs {
            Email = selectedValue == Filters.Email ? selectedFilterValues.StringField : null,
            Name = selectedValue == Filters.Name ? selectedFilterValues.StringField : null,
            Status = selectedValue == Filters.Status ? selectedFilterValues.Status : null,
            PurchaseDateFrom = selectedValue == Filters.Date ? selectedFilterValues.DateFrom.ToString("yyyyMMddHHmmss") : null,
            PurchaseDateTo = selectedValue == Filters.Date ? selectedFilterValues.DateTo.ToString("yyyyMMddHHmmss") : null
        }, token);

        if(isFiltered)
        {
            IsFetchingTransactions = false;
        }

        if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
                transactions = result.Result.Result.Select(t => new InclusiveTransactionDto {
                ConvinienceFee = t.ConvinienceFee,
                CreditAmount = t.CreditAmount,
                OverallTotal = t.OverallTotal,
                PurchaseDate = t.PurchaseDate,
                PurchaseOrderId = t.PurchaseOrderId,
                Status = t.Status,
                Total = t.Total,
                UnitCount = t.UnitCount,
                UnitPrice = t.UnitPrice,
                Provider = new InclusiveTransactionDto.ProviderDto {
                    Email = t.Provider.Email,
                    FirstName = t.Provider.FirstName,
                    LastName = t.Provider.LastName
                }
            });
        }
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private bool IsActive(string page)
        => currentPage == page;


    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllTransactions(int.Parse(page));
    }

    private Task SubmitFilters()
    {
        return GetAllTransactions(0, true);
    }

    private async Task ExportExcel()
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Utils.excelWriter.execute", transactions);
    }

    public class InclusiveTransactionDto
    {
        public int PurchaseOrderId {get; set;}
        public DateTime PurchaseDate {get; set;}
        public int UnitCount {get; set;}
        public decimal UnitPrice {get; set;}
        public decimal Total {get; set;}
        public decimal ConvinienceFee {get; set;}
        public decimal CreditAmount {get; set;}
        public decimal OverallTotal {get; set;}
        public int Status {get; set;}

        public ProviderDto Provider {get; set;} = new();

        public class ProviderDto 
        {
            public string FirstName {get; set;}
            public string LastName {get; set;}
            public string Email {get; set;}
        }
    }

    public class SelectedFilterValues 
    {
        public string StringField {get; set;}
        public int Status {get; set;}
        public DateTime DateFrom {get; set;} = DateTime.Now;
        public DateTime DateTo {get; set;} = DateTime.Now;
    }
}

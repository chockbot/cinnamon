@layout AdminLayout
@page "/admin/pricing"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAdminApiHandler adminApiHandler;

<PageTitle>Admin - Manage Users | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Users" Subject="Admin - Manage Users" Url="/admin/users" />

<section class="admin-dashboard-pricings-wrapper">


    <div class="d-flex flex-column flex-md-row justify-content-between mt-3 custom-flex">
        <p class="verification-title">Customer Pricing Board</p>
        <div class="mt-0 mt-md-0">
            <div class="searchbar-holder ml-md-auto mt-3 mt-md-0">
                <div class="searchBar">
                    <input type="search" id="searchBar" class="form-control search-input" placeholder="Search">
                </div>
            </div>
        </div>
    </div>

    <div class="pricings-section mt-4">
        <div class="table-list">
            <Table Hoverable Responsive class="border-1-solid mb-4 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            First Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Last Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Rate (%)
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                        Is Manual Payment
                        </TableHeaderCell>
                        <TableHeaderCell class="text-center color-white-100 p-3">
                        Inclusive Pricing
                        </TableHeaderCell>
                        <TableHeaderCell class="text-end color-white-100 p-3">
                            Action
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in customers)
                    {
                        <TableRow @key="item">
                            <TableRowCell class="text-start p-3">@item.Email</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">
                                <label class="d-flex">
                                    <p class="m-0 w-50">@item.FirstName</p>
                                    <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.LastName</p>
                                </label>
                            </TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize m-d-none">@item.LastName</TableRowCell>
                            <TableRowCell class="text-start p-3">
                                <input class='@($"form-control {item.Pricing.ExtraClass}")' type="number" min="0" 
                                        placeholder="Enter Amount" @bind-value="item.Pricing.Rate" />
                            </TableRowCell>
                            <TableRowCell class="text-center p-3">
                                <span class="form-switch d-inline">
                                    <input class="form-check-input" type="checkbox" checked="@item.Pricing.IsManualPayment" 
                                        @onchange="((e) => HandleManualPaymentChanged(e, item))">
                                </span>
                            </TableRowCell>
                            <TableRowCell class="text-center p-3">
                                <span class="form-switch d-inline">
                                    <input class="form-check-input" type="checkbox" checked="@item.Pricing.InclusivePricing" 
                                        @onchange="((e) => HandleInclusivePricingChanged(e, item))">
                                </span>
                            </TableRowCell>
                            <TableRowCell class="text-end p-3">
                                <Button Clicked="() => SubmitCustomerPricing(item)" Size="Size.Small" Type="ButtonType.Button" 
                                    Loading="item.Pricing.IsSubmitting" Disabled="item.Pricing.IsSubmitting"
                                    class="btn-primary min-width-130 font-20 m-font-12" Border="Border.Is0">
                                    <LoadingTemplate>
                                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                                        Saving Changes
                                    </LoadingTemplate>
                                    <ChildContent>
                                        Update
                                    </ChildContent>
                                </Button>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        <div class="pagination-main">
<Pagination>
    <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
        <PaginationLink Style="border-radius: 50px; font-size: 13px;">
            <span aria-hidden="true">«</span>
        </PaginationLink>
    </PaginationItem>
@{
    var lastPage = Pagination.TotalPages.GetValueOrDefault(int.MaxValue);
    var startPage = Math.Max(1, Math.Min(int.Parse(currentPage) - 2, lastPage - 3));

    for (var i = startPage; i <= Math.Min(startPage + 3, lastPage); i++)
    {
        var pageNumberAsString = i.ToString();
        <div class="pagination-item">
            <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)" Style="border-radius: 50px; font-size: 13px;">
                <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="border-radius: 50px; font-size: 13px;">
                    @pageNumberAsString
                </PaginationLink>
            </PaginationItem>
        </div>
    }
}
    <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next" Style="border-radius: 50px; font-size: 13px;">
        <PaginationLink Style="border-radius: 50px; font-size: 13px;">
            <span aria-hidden="true">»</span>
        </PaginationLink>
    </PaginationItem>
</Pagination>
        </div>
            <ViewImageModal @ref="viewImageModal"></ViewImageModal>
        </div>
    </div>
</section>

@code 
{
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public List<CustomerProfile> customers = new List<CustomerProfile>();
    protected ViewImageModal viewImageModal = new ViewImageModal();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private const string PREVIOUS = "previous";
    private const string NEXT = "next";
    private string currentPage = "1";
    private int pageItems = 1;
    string token = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;
        await GetAllCustomers(int.Parse(currentPage));
        pageItems = customers.Count;

        await GetAllCustomers(1);
    }

    private async Task GetAllCustomers(int pageIndex)
    {
        var result = await accountApiHandler.GetAllCustomer(new Framework.ApiCommand.ApiCore.Account.Request.GetAllCustomersArgs
            {
                CountPerPage = 20,
                PageIndex = pageIndex,
                IsOfficialPartner = true
            }, token);

        customers = result.Result.Result.Select(r => new CustomerProfile
            {
                Id = r.Id,
                Email = r.Email,
                LastName = r.LastName,
                FirstName = r.FirstName,
                FrontIdImagePath = r.FrontIdImagePath,
                BackIdImagePath = r.BackIdImagePath,
                IsVerified = r.IsVerified,
                IsVerifiedDate = r.IsVerifiedDate,
                IsChecked = r.IsVerified == 2,
                IsOG = r.IsOG,
                IsOGDate = r.IsOGDate,
                IsOfficial = r.IsOfficial,
                IsOfficialDate = r.IsOfficialDate,
                Pricing = new CustomerProfile.CustomerPricing {
                    Rate = r.CustomerPricing != null ? r.CustomerPricing.Rate : 0,
                    IsManualPayment = r.CustomerPricing != null ? r.CustomerPricing.IsManualPayment : false,
                    InclusivePricing = r.CustomerPricing != null ? r.CustomerPricing.InclusivePricing : false
                }
            }).OrderBy(r => r.FirstName).ThenBy(r => r.LastName).ToList();

        Pagination = result.Result.Pagination;
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private bool IsActive(string page)
        => currentPage == page;

    bool IsPageNavigationDisabled(string direction)
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (direction == NEXT)
        {
            return currentPageAsInt >= Pagination.TotalPages.GetValueOrDefault(int.MaxValue);
        }
        else if (direction == PREVIOUS)
        {
            return currentPageAsInt <= 1;
        }
        return false;
    }

    private void Previous()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt > 1 )
        {
            currentPage = (currentPageAsInt - 1).ToString();
        }
    }

    private void Next()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt < pageItems )
        {
            currentPage = (currentPageAsInt + 1).ToString();
        }
    }



    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllCustomers(int.Parse(page));
    }

    private async Task SubmitCustomerPricing(CustomerProfile item)
    {
        if(item.Pricing.Rate >= 0)
        {
            item.Pricing.IsSubmitting = true;

            var result = await adminApiHandler.CustomerPricing(new Framework.ApiCommand.ApiCore.AdminUser.Request.UpdateCustomerPricingArgs {
                CustomerId = item.Id,
                Rate = item.Pricing.Rate,
                IsManualPayment = item.Pricing.IsManualPayment,
                InclusivePricing = item.Pricing.InclusivePricing
            }, token);

            item.Pricing.IsSubmitting = false;
        }
    }

    private async Task HandleManualPaymentChanged(ChangeEventArgs e, CustomerProfile customer)
    {
        bool isChecked = (bool)e.Value;
        customer.Pricing.IsManualPayment = isChecked;
    }

    private async Task HandleInclusivePricingChanged(ChangeEventArgs e, CustomerProfile customer)
    {
        bool isChecked = (bool)e.Value;
        customer.Pricing.InclusivePricing = isChecked;
    }
}

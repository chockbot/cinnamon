@layout AdminLayout
@page "/admin/refunds"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models.Customer;
@using static Cinnamon.Web.Models.Customer.RequestRefundModel;
@inject IJSRuntime jsRuntime;

<PageTitle>Admin - Manage Requested Refund | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Requested Refund" Subject="Admin - Manage Requested Refund" Url="/admin/refunds" />

<div class="admin-dashboard-refund-wrapper">
    <div class="top-row m-d-none">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline mt-5">
        <p class="m-0 font-32 m-font-20 color-orange-100 font-weight-700">Refund Review Board</p>
        <label class="text-md-end mt-2 mt-md-0">
            <label class="me-3 cursor-pointer">
                <input class="form-check-input" type="radio" data-id="" name="refund-status" id="pending" @onchange='@(()=>CheckboxChanged(0))'>
                <span class="m-font-12">Pending</span>
            </label>
            <label class="cursor-pointer">
                <input class="form-check-input" type="radio" data-id="" name="refund-status" id="issued" @onchange='@(()=>CheckboxChanged(1))'>
                    <span class="m-font-12">Issued</span>
            </label>
        </label>
    </div>

    <div class="refunds-section mx-0 mt-4">
        <div class="table-list">
            <Table Hoverable Responsive class="border-1-solid mb-0 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                    <TableRow class="color-white-100">
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Name
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Reference #
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Experience
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Reason
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Amount Requested
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Amount Given
                        </TableHeaderCell>
                        <TableHeaderCell class="text-start color-white-100 p-3">
                            Issued
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in refundRequests)
                    {
                        <TableRow>
                            <TableRowCell class="text-start p-3">@item.Email</TableRowCell>
                            <TableRowCell class="text-start p-3 text-capitalize">@item.FirstName @item.LastName</TableRowCell>
                            <TableRowCell class="text-start p-3">@item.ReferenceNo</TableRowCell>
                            <TableRowCell class="text-start p-3">@item.ExperienceTitle</TableRowCell>
                            <TableRowCell class="text-start p-3">@item.Reason</TableRowCell>
                            <TableRowCell class="text-start p-3">@item.OverAllTotal</TableRowCell>
                            <TableRowCell class="text-start p-3">
                                @if (item.Status == 0)
                                {
                                    <input class='@($"form-control {item.ExtraClass}")' type="number" min="0" max="@item.OverAllTotal" 
                                        placeholder="Enter Amount" @bind-value="@item.RefundAmountGiven" @oninput="(e) => AmountChanged(e.Value, item)" />
                                }
                                else
                                {
                                    <span>@item.RefundAmountGiven</span>
                                }
                            </TableRowCell>
                            <TableRowCell class="text-start p-3">
                                @if (item.Status == 0)
                                {
                                    <span class="form-switch d-inline">
                                        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" 
                                            checked="@item.IsChecked" @onchange="((e) => HandleCheckedChanged(e, item))" 
                                            disabled='@(string.IsNullOrEmpty(item.ExtraClass) ? false : true)'>
                                    </span>
                                }
                                else
                                {
                                    <span>@GetStatus(item.Status)</span>
                                }
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
            <Pagination class="pagination-section mt-3">
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
            </Pagination>
        </div>
    </div>
</div>


@code {
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public List<Requested> refundRequests = new List<Requested>();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private string currentPage = "1";
    string token = string.Empty;
    private int refundStatus = 0;
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllRefundRequests(1, refundStatus);
    }

    private async Task GetAllRefundRequests(int pageIndex, int refundStatus)
    {
        var result = await accountApiHandler.GetRequestedRefunds(new Framework.ApiCommand.ApiCore.Account.Request.GetRequestedRefundsArgs
            {
                Status = refundStatus,
                CountPerPage = 10,
                PageIndex = pageIndex,
                IncludeCustomer = true,
                IncludePurchaseOrder = true,
                IsAdmin = true
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            refundRequests = result.Result.Result
            .Select(r => new Requested
            {
                Id                = r.Id,
                Email             = r.Email,
                ExperienceTitle   = r.ActivityTitle,
                FirstName         = r.FirstName,
                LastName          = r.LastName,
                OverAllTotal      = r.OverAllTotal,
                Reason            = r.Reason,
                ReferenceNo       = r.ReferenceNo,
                Status            = r.Status,
                IsChecked         = r.Status == 1,
                RefundAmountGiven = r.RefundAmountGiven
            }).ToList();
        }

        Pagination = result.Result.Pagination;
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task HandleCheckedChanged(ChangeEventArgs e, Requested refundRequest)
    {
        bool isChecked = (bool)e.Value;

        if (isChecked)
        {
            if(refundRequest.RefundAmountGiven > refundRequest.OverAllTotal)
            {
                refundRequest.ExtraClass = "is-invalid";
                return;
            }

            var result = await accountApiHandler.UpdateRefundRequest(new Framework.ApiCommand.ApiCore.Account.Request.UpdateRequestRefundArgs
            {
                    RefundAmountGiven = refundRequest.RefundAmountGiven,
                    RefundId = refundRequest.Id,
                    Status = 1
            }, token);

            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                StateHasChanged();
            }
        }
    }
   
    private bool IsActive(string page)
        => currentPage == page;

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllRefundRequests(int.Parse(page), refundStatus);
    }

    private async Task CheckboxChanged(int val)
    {
        refundStatus = val;
        await GetAllRefundRequests(1, refundStatus);
    }

    private string GetStatus(int status)
    {
        if (status == 0) return "Submitted";
        if (status == 1) return "Approved";
        if (status == 2) return "Disapproved";

        return string.Empty;
    }

    private Task AmountChanged(object value, Requested requestedItem)
    {
        if(decimal.TryParse(value.ToString(), out decimal amount))
        {
            if(amount > requestedItem.OverAllTotal)
            {
                requestedItem.ExtraClass = "is-invalid";
            }
            else 
            {
                requestedItem.ExtraClass = string.Empty;
            }
        }
        else 
        {
            requestedItem.ExtraClass = "is-invalid";
        }
        
        return Task.CompletedTask;
    }
}

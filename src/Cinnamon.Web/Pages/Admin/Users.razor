@layout AdminLayout
@page "/admin/users"
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;

<PageTitle>Admin - Manage Users | CinnamonPH</PageTitle>
<SeoMeta Title="Admin - Manage Users" Subject="Admin - Manage Users" Url="/admin/users" />

<section class="admin-dashboard-users-wrapper">
    <div class="top-row m-d-none">
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                <div class="menu">
                    <img src="images/menu.png">
                </div>
            </button>
            <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                @if (AuthState != null)
                {
                    @if (AuthState.Identity.IsAuthenticated)
                    {
                        <li class="dropdown-item">
                            <Button Border="Border.Is0" Clicked="Logout">
                                Logout
                            </Button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-baseline mt-5">
        <p class="m-0 font-32 m-font-20 color-orange-100 font-weight-700">User Verification Board</p>
        <label class="text-md-end mt-2 mt-md-0">
            <label class="me-3 cursor-pointer">
                <input class="form-check-input cursor-pointer" type="radio" data-id="" name="verification-status" id="with-pending" 
                    @onchange='@(()=>CheckboxChanged(true))'>
                <span class="m-font-12">Has Verification Request</span>
            </label>
            <label class="cursor-pointer">
                <input class="form-check-input cursor-pointer" type="radio" data-id="" name="verification-status" id="without-pending" 
                    @onchange='@(()=>CheckboxChanged(false))'>
                    <span class="m-font-12">No Verification Request</span>
            </label>
        </label>
    </div>

    <div class="users-section mx-0">
        <div class="table-list">
            <div class="overflow-auto">
                <Table Hoverable class="border-1-solid mb-0 font-20 m-font-12" VerticalAlignment="VerticalAlignment.Middle">
                    <TableHeader class="bg-black-100 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                        <TableRow class="color-white-100">
                            <TableHeaderCell class="text-start color-white-100 p-3">
                                Email
                            </TableHeaderCell>
                            <TableHeaderCell class="text-start color-white-100 p-3">
                                First Name
                            </TableHeaderCell>
                            <TableHeaderCell class="text-start color-white-100 p-3">
                                Last Name
                            </TableHeaderCell>
                            <TableHeaderCell class="color-white-100 text-center p-3">
                                Has Verification Request
                            </TableHeaderCell>
                            <TableHeaderCell class="color-white-100 text-center p-3">
                                ID Uploaded
                            </TableHeaderCell>
                            <TableHeaderCell class="color-white-100 text-center p-3">
                                Approve/Reject
                            </TableHeaderCell>
                            <TableHeaderCell class="color-white-100 text-center p-3">
                                Ban Account
                            </TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var item in customers)
                        {
                            <TableRow>
                                <TableRowCell class="text-start p-3">@item.Email</TableRowCell>
                                <TableRowCell class="text-capitalize text-start p-3">
                                    <label class="d-flex">
                                        <p class="m-0 w-50">@item.FirstName</p>
                                        <p class="m-0 w-50 d-block d-md-none border-left-1-solid">@item.LastName</p>
                                    </label>
                                </TableRowCell>
                                <TableRowCell class="text-capitalize text-start p-3 m-d-none">@item.LastName</TableRowCell>
                                <TableRowCell class="p-3 text-center">@item.HasVerificationRequest</TableRowCell>
                                <TableRowCell class="p-3 text-center">
                                    <button type="button" class="btn btn-primary border-0 m-font-12" 
                                        @onclick="(() => viewImageModal.ShowModal(item.BackIdImagePath, item.FrontIdImagePath))">Show ID</button>
                                </TableRowCell>
                                <TableRowCell class="p-3 text-center">
                                    <span class="form-switch d-inline">
                                        <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@item.IsChecked" 
                                            @onchange="((e) => HandleCheckedChanged(e, item))">
                                    </span>
                                </TableRowCell>
                                <TableRowCell class="p-3 text-center">
                                    <span class="form-switch d-inline">
                                        <input class="form-check-input" type="checkbox" checked="@item.IsAccountBan" 
                                            @onchange="((e) => OnBlockedChanged(e, item))">
                                    </span>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </div>
            <Pagination Class="pagination-section" Style="margin-top: 50px">
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive" Style="background-color: #ffa942; color: #ffffff;">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
            </Pagination>
            <ViewImageModal @ref="viewImageModal"></ViewImageModal>
        </div>
    </div>
</section>

@code {
    public bool clickButton { get; set; }
    private bool? hasVerificationRequest { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public List<CustomerProfile> customers = new List<CustomerProfile>();
    protected ViewImageModal viewImageModal = new ViewImageModal();
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private string currentPage = "1";
    string token = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        token = user.FindFirstValue("Token");
        AuthState = user;

        await GetAllCustomers(1);
    }

    private async Task GetAllCustomers(int pageIndex)
    {
        var result = await accountApiHandler.GetAllCustomer(new Framework.ApiCommand.ApiCore.Account.Request.GetAllCustomersArgs
            {
                CountPerPage = 20,
                PageIndex = pageIndex
            }, token);

        customers = result.Result.Result.Select(r => new CustomerProfile
            {
                Id = r.Id,
                Email = r.Email,
                LastName = r.LastName,
                FirstName = r.FirstName,
                FrontIdImagePath = r.FrontIdImagePath,
                BackIdImagePath = r.BackIdImagePath,
                IsVerified = r.IsVerified,
                IsVerifiedDate = r.IsVerifiedDate,
                IsChecked = r.IsVerified == 2,
                IsOG = r.IsOG,
                IsOGDate = r.IsOGDate,
                IsOfficial = r.IsOfficial,
                IsOfficialDate = r.IsOfficialDate,
                IsAccountBan = r.IsAccountBan

            }).OrderBy(r => r.FirstName).ThenBy(r => r.LastName).ToList();

        if (hasVerificationRequest.HasValue)
        {
            customers = customers.Where(c => c.HasVerificationRequest == (hasVerificationRequest.GetValueOrDefault() ? "Yes" : "No")).ToList();
        }

        Pagination = result.Result.Pagination;
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private void Logout()
    {
        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task HandleCheckedChanged(ChangeEventArgs e, CustomerProfile customer)
    {
        bool isChecked = (bool)e.Value;

        int verifiedBadge = 0;

        if (isChecked)
        {
            verifiedBadge = 2;
        }
        else
        {
            if (string.IsNullOrEmpty(customer.BackIdImagePath) && string.IsNullOrEmpty(customer.FrontIdImagePath))
            {
                verifiedBadge = 0;
            }
            else
            {
                verifiedBadge = 0;
            }
        }

        var result = await accountApiHandler.UpdateCustomerProfile(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
            {
                VerifiedBadge = verifiedBadge,
                VerifiedBadgeDate = DateTime.UtcNow,
                CustomerId = customer.Id,
                IsOG = customer.IsOG,
                IsOGDate = customer.IsOGDate,
                IsOF = customer.IsOfficial,
                IsOFDate = customer.IsOfficialDate
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
        }
    }

    private async Task OnBlockedChanged(ChangeEventArgs e, CustomerProfile account)
    {
        if(e.Value == null) return;

        account.IsAccountBan = (bool)e.Value;

        var result = await accountApiHandler.BlockAccount(new Framework.ApiCommand.ApiCore.Account.Request.BlockedAccountArgs {
            CustomerId = account.Id,
            IsBlock = account.IsAccountBan
        }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            StateHasChanged();
        }
    }

    private bool IsActive(string page)
        => currentPage == page;

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetAllCustomers(int.Parse(page));
    }

    private async Task CheckboxChanged(bool hasVerification)
    {
        hasVerificationRequest = hasVerification;
        await GetAllCustomers(1);
    }
}

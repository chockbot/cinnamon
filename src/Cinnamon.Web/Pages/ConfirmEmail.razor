@page "/confirm-email"
@layout LandingMainLayout

@using Microsoft.AspNetCore.WebUtilities;
@using Cinnamon.Core
@using Cinnamon.Web.Components
@using Cinnamon.Core.Module.CinnamonMakerService.Handler;
@inject NavigationManager NavigationManager
@inject NavigationManager navigationManager
@inject IVerifyEmail verifyEmailHandler;

<Onboarding></Onboarding>
<ModalFinishSignUp @ref="modal"></ModalFinishSignUp>
<ModalPassword @ref="modalPassword"></ModalPassword>

@code {

    ModalFinishSignUp modal { get; set; }

    ModalPassword modalPassword { get; set; }

    public List<WaitListModel> list = new List<WaitListModel>();

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        var uri = navigationManager.ToAbsoluteUri(navigationManager.Uri);
        var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
        var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);

        try
        {
            if (userSuccess && tokenSuccess)
            {
                // get waiting list if email already verified
                var waitingRes = await CoreDI.DataStore.WaitList.GetWaitListByGuid(userId);
                if(waitingRes == null)
                {
                    // invalid guid
                    NavigationManager.NavigateTo("/onboarding", forceLoad: true);
                    return;
                }
                
                // check if email already verified so that will not call verify email every request
                if(!waitingRes.IsVerified)
                {
                    // need to verified
                    var verifyRes = await verifyEmailHandler.ExecuteAsync(
                            new Core.Module.CinnamonMakerService.Interactors.VerifyEmail { Token = token, UserId = userId });
                    if(!verifyRes.Succeeded)
                    {
                        // invalid userid and token redirect to onboargin page
                        NavigationManager.NavigateTo("/onboarding");
                        return;
                    }

                    // proceed to populate customer information
                    await modal.OpenModal(waitingRes.Email);
                }
                else 
                {
                    // email already verified. Need to check if customer info already populated. 
                    // if not open modal information
                    var customerRes = await CoreDI.DataStore.Customers.GetCustomerByEmailAsync(waitingRes.Email);
                    if(customerRes == null)
                    {
                        await modal.OpenModal(waitingRes.Email);
                    }
                    else 
                    {
                        await modalPassword.OpenModal(waitingRes.Email);
                    }
                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }
    }
}


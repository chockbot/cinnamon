@layout DashboardLayout
@page "/contact"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container p-5 col-xl-block d-lg-block d-md-none d-sm-none d-none">
        <div class="row d-flex justify-content-center">
            <div class="col-lg-6 col-md-6 col-sm-6 col-6 contact-section">
                <label class="caption-bold">Didn’t find anything here?</label>
                <p class="caption-secondary">We’re here for you</p>
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSenakLuzzv2bTCy65a2WTy48E3wWAqs6B2reQVcSz3fkHOxkg/viewform" target="_blank">
                    <button type="button" class="btn btn-primary border-0" id="btnExploreMore">
                        Contact Us
                    </button>
                </a>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-6">
                <img class="contact-img" src="/images/Dashboard Icon/contact-us.png" />
            </div>
        </div>
    </div>
    <div class="container p-5 col-xl-none d-lg-none d-md-block d-sm-block d-block">
        <div class="row d-flex justify-content-center text-center">
            <div class="col-md-12 col-sm-12 col-12" style="padding-left:0px;">
                <img class="contact-img" src="/images/Dashboard Icon/contact-us.png" />
            </div>
            <div class="col-md-12 col-sm-12 col-12 contact-section text-center">
                <label class="caption-bold">Didn’t find anything here?</label>
                <p class="caption-secondary">We’re here for you</p>
                 <a href="https://docs.google.com/forms/d/e/1FAIpQLSenakLuzzv2bTCy65a2WTy48E3wWAqs6B2reQVcSz3fkHOxkg/viewform" target="_blank">
                    <button type="button" class="btn btn-primary border-0" id="btnExploreMore">
                        Contact Us
                    </button>
                </a>
            </div>

        </div>
    </div>
</body>
</html>


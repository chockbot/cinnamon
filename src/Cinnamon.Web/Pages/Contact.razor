@layout DashboardLayout
@page "/contact"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container p-5" style="position:relative">
        <div class="row d-flex justify-content-center">
            <div class="col-lg-6 col-md-6 col-sm-6 col-6 contact-section">
                <label class="caption-bold">Didn’t find anything here?</label>
                <p class="caption-secondary">We’re here for you</p>
                <button type="button" class="btn btn-primary border-0" id="btnExploreMore">
                    Contact Us
                </button>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6 col-6">
                <img class="contact-img" src="/images/Dashboard Icon/contact-us.png" />
            </div>
        </div>
    </div>
</body>
</html>


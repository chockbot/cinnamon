@layout CreationLayout
@page "/Creation"
@page "/Creation/{creationType}"
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components.Pages.Creation;
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Framework.Enums;

@inject IJSRuntime jsRuntime
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler;
@inject INotificationService NotificationService;
@attribute [Authorize]

<PageTitle>Create an Experience | CinnamonPH</PageTitle>
<SeoMeta Title="Create an Experience" Subject="Create an Experience" Url="/creation" />

@if (Model != null)
{
    <div class="xp-ote-page-wrapper">
        <Container>
            <div class="progress-bar-section">
                <p class="progress-details">
                    IN PROGRESS: Step @currentIndex of 7 <span id="loader" class=""></span>
                </p>
                <div class="progress">
                    <div class="progress-bar" role="progressbar" style="width: @(GetPerentCompletion)%;" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </Container>
       
         <Container>
            <div class="experience-heading-section d-flex justify-content-between">
            <p class="experience-heading d-none d-sm-block d-md-block d-lg-block d-xl-block">
                LET’S CREATE YOUR EXPERIENCE!
            </p>
            <div class="save-later-button-section">
                <div class="save-later-section d-none d-sm-block d-md-block d-lg-block d-xl-block">
                    <Button Border="Border.Is0" class="btn-primary" @onclick="() => SaveForLater()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                        </LoadingTemplate>
                        <ChildContent>
                            Save for Later
                        </ChildContent>
                    </Button>
                </div>
            </div>
        </div>

            <div class="experience-progress-wrapper d-xl-none d-lg-none d-md-none d-sm-none d-block">
            <div class="row">
                <div class="col-1 prev-button-section">
                    @if (currentIndex > 1)
                    {
                        <button class="carousel-control-prev" type="button" @onclick="() => OnBackClick()">
                            <img src="images/experience-creation/play-mobile.png" alt="check-icon" />
                        </button>
                    }
                </div>
                <div class="col-10 text-center">
                    @if (currentIndex == 1)
                    {
                        <label class="experience-progress-label">
                            Overview
                        </label>
                    }
                    else if (currentIndex == 2)
                    {
                        <label class="experience-progress-label">
                            Location
                        </label>
                    }
                    else if (currentIndex == 3)
                    {
                        <label class="experience-progress-label">
                            Pricing & Schedule
                        </label>
                    }
                    else if (currentIndex == 4)
                    {
                        <label class="experience-progress-label">
                            Requirements
                        </label>
                    }
                    else if (currentIndex == 5)
                    {
                        <label class="experience-progress-label">
                            Gallery
                        </label>
                    }
                    else if (currentIndex == 6 || currentIndex == 7)
                    {
                        <label class="experience-progress-label">
                            Publish
                        </label>
                    }
                </div>
                <div class="col-1 next-button-section">
                    @if (currentIndex < 7)
                    {
                        <button class="carousel-control-next" type="button" @onclick="() => OnNextClick()">
                            <img src="images/experience-creation/play-mobile.png" alt="check-icon" />
                        </button>
                    }
                </div>
            </div>
        </div>

            <div class="save-later-section-mobile d-xl-none d-lg-none d-md-none d-sm-none d-block">
            <Button Border="Border.Is0" class="btn-primary" @onclick="() => SaveForLater()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                <LoadingTemplate>
                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                </LoadingTemplate>
                <ChildContent>
                    Save for Later
                </ChildContent>
            </Button>
        </div>

            <div class="d-flex justify-content-between">
            <div class="d-none d-sm-block d-md-block d-lg-block d-xl-block">
                <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    <a class="nav-link @(currentIndex == 1 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(1)">
                        Overview
                        @if (currentIndex == 1)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                        else
                        {
                            if (isCreationOverviewComponentValid)
                            {
                                <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                            }
                            else
                            {
                                if (displayCreationOverviewComponentError)
                                {
                                    <img class="pull-right invalid-icon" src="images/not-icon.png" alt="check-icon" />
                                }
                            }
                        }
                    </a>
                    <a class="nav-link @(currentIndex == 2 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(2)">
                        Location
                        @if (currentIndex == 2)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                        else
                        {
                            if (isLocationComponentValid)
                            {
                                <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                            }
                            else
                            {
                                if (displayLocationComponentError)
                                {
                                    <img class="pull-right invalid-icon" src="images/not-icon.png" alt="check-icon" />
                                }
                            }
                        }
                    </a>
                    <a class="nav-link @(currentIndex == 3 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(3)">
                        Pricing & Schedule
                        @if (currentIndex == 3)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                        else
                        {
                            if (isPricingAndScheduleComponentValid)
                            {
                                <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                            }
                            else
                            {
                                if (displayPricingAndScheduleComponentError)
                                {
                                    <img class="pull-right invalid-icon" src="images/not-icon.png" alt="check-icon" />
                                }
                            }
                        }
                    </a>
                    <a class="nav-link @(currentIndex == 4 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(4)">
                        Requirements
                        @if (currentIndex == 4)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                        else
                        {
                            if (isOptionalDetailsComponentValid)
                            {
                                <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                            }
                        }
                    </a>
                    <a class="nav-link @(currentIndex == 5 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(5)">
                        Gallery
                        @if (currentIndex == 5)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                        else
                        {
                            if (isGalleryComponentValid)
                            {
                                <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                            }
                            else
                            {
                                if (displayGalleryComponentError)
                                {
                                    <img class="pull-right invalid-icon" src="images/not-icon.png" alt="check-icon" />
                                }
                            }
                        }
                    </a>
                    <a class="nav-link @(currentIndex == 7 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(7)">
                        Publish
                        @if (currentIndex == 7)
                        {
                            <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                        }
                    </a>
                </div>
                <div class="display-error" style="display:@(displayError ? "block" : "none")">
                    You must fill in the required fields to publish an activity
                </div>
                <div class="dashed-divider"></div>
                <div class="guide-section text-center">
                    <label class="guide-title @(currentIndex != 7 ? "d-block" : "d-none")">
                        How it will look like
                    </label>
                    <div class='@(currentIndex == 1 ? "d-block" : "d-none")'>
                        <div class="row">
                            <div class="creation-guide-step-1 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                <img src="images/experience-creation/creation-guide-step-1.svg" alt="check-icon" />
                            </div>
                        </div>
                    </div>
                    <div class='@(currentIndex == 2 ? "d-block" : "d-none")'>
                        <div class="row">
                            <div class="creation-guide-step-3 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                <img src="images/experience-creation/creation-guide-step-2.svg" alt="check-icon" />
                            </div>
                        </div>
                    </div>
                    <div class='@(currentIndex == 3 ? "d-block" : "d-none")'>
                        <div class="row">
                            <div class="creation-guide-step-4 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                <img src="images/experience-creation/creation-guide-step-3.svg" alt="check-icon" />
                            </div>
                        </div>
                    </div>
                    <div class='@(currentIndex == 4 ? "d-block" : "d-none")'>
                        <div class="row">
                            <div class="creation-guide-step-5 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                <img src="images/experience-creation/creation-guide-step-4.svg" alt="check-icon" />
                            </div>
                        </div>
                    </div>
                    <div class='@(currentIndex == 5 ? "d-block" : "d-none")'>
                        <div class="row">
                            <div class="creation-guide-step-6 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                <img src="images/experience-creation/creation-guide-step-5.svg" alt="check-icon" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="">
                <div class="tab-content-section">
                    <EditForm Model="Model.Activity" id="form-cretion">
                        <div class='tab @(currentIndex == 1 ? "show" : "")'>
                            <CreationOverview @ref="creationOverviewComponent" Model="Model"></CreationOverview>
                        </div>

                        <div class='tab @(currentIndex == 2 ? "show" : "")'>
                            <Location @ref="locationComponent" Model="Model" />
                        </div>

                        <div class='tab @(currentIndex == 3 ? "show" : "")'>
                            @if (ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
                            {
                                <PricingAndSchedule @ref="pricingAndScheduleComponent" Model="Model" />
                            }
                            else if (ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
                            {
                                <PricingAndScheduleAppointment @ref="pricingAndScheduleAppointmentComponent" Model="Model" />
                            }
                        </div>

                        <div class='tab @(currentIndex == 4 ? "show" : "")'>
                            <OptionalDetails @ref="optionalDetailsComponent" Model="Model" />
                        </div>

                        <div class='tab @(currentIndex == 5 ? "show" : "")'>
                            <Gallery @ref="galleryComponent" Model="Model" />
                        </div>

                        <div class='tab @(currentIndex == 6 ? "show" : "")'>
                            <ActivitySummary @ref="ActivitySummary" Activity="Model.Activity" />
                        </div>
                        <div class='tab @(currentIndex ==  7 ? "show" : "")'>
                            <LoadingIndicator @ref="loadingIndicator" FullScreen FadeIn>
                                <GeneralPublishPage @ref="GeneralPublishPage" Activity="Model.Activity" />
                            </LoadingIndicator>
                        </div>
                    </EditForm>
                </div>
                <div class="button-container">
                   
                        @if (currentIndex > 1)
                        {
                            <div class="">
                                <button type="button" class="btn-back" id="prevBtn" @onclick="() => OnBackClick()">Back</button>
                            </div>
                            <div class="">
                                @if(currentIndex == 7)
                                {
                                    <Button Border="Border.Is0" class="btn-primary" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn">
                                        <ChildContent>
                                            @(currentIndex == 7 ? "Publish" : "Next")
                                        </ChildContent>
                                    </Button>
                                }
                                else
                                {
                                    <Button Border="Border.Is0" class="btn-primary" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                                    <LoadingTemplate>
                                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                                    </LoadingTemplate>
                                    <ChildContent>
                                        @(currentIndex == 7 ? "Publish" : "Next")
                                    </ChildContent>
                                </Button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="col-lg-12 col-12">
                                <Button Border="Border.Is0" class="btn-primary" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                                    <LoadingTemplate>
                                        <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                                    </LoadingTemplate>
                                    <ChildContent>
                                        @(currentIndex == 7 ? "Publish" : "Next")
                                    </ChildContent>
                                </Button>
                            </div>
                        }
                </div>
            </div>
        </div>
        </Container>
    </div>
    <div class="modal fade remove-modal" tabindex="-1" role="dialog" id="experienceCreationGuideModal" style="z-index:99999;">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <label class="guide-title text-center">
                        How it will look like
                    </label>
                    <button type="button" class="btn-close" id="btnCloseExperienceCreationGuideModal" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="col-12-lg d-flex justify-content-center">
                        <div class="row" id="image-section">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowErrorMessage)
{
    <div class="alert alert-danger alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Error!</strong> @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ShowSuccessMessage)
{
    <div class="alert alert-success alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Success!</strong> You'll be redirected to the dashboard page.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@code
{
    private Models.ExperienceCreationModel Model;

    IJSObjectReference module;

    public bool ShowErrorMessage { get; set; }

    public bool ShowSuccessMessage { get; set; }

    private int currentIndex = 1;

    private CreationOverview creationOverviewComponent { get; set; }

    private Location locationComponent { get; set; }

    private PricingAndSchedule pricingAndScheduleComponent { get; set; }
    private PricingAndScheduleAppointment pricingAndScheduleAppointmentComponent { get; set; }

    private OptionalDetails optionalDetailsComponent { get; set; }

    private Gallery galleryComponent { get; set; }

    private ExperienceSetup experienceSetupComponent { get; set; }

    private bool isLoading = false;

    private DotNetObjectReference<Creation>? obj;

    private string errorMessage = "There was a problem publishing the experience creation. Please refresh the page and try again.";

    private ActivitySummary ActivitySummary { get; set; }

    private GeneralPublishPage GeneralPublishPage { get; set; }

    LoadingIndicator loadingIndicator;

    public bool isCreationOverviewComponentValid { get; set; }
    public bool isLocationComponentValid { get; set; }
    public bool isPricingAndScheduleComponentValid { get; set; }
    public bool isOptionalDetailsComponentValid { get; set; }
    public bool isGalleryComponentValid { get; set; }

    public bool displayCreationOverviewComponentError { get; set; }
    public bool displayLocationComponentError { get; set; }
    public bool displayPricingAndScheduleComponentError { get; set; }
    public bool displayOptionalDetailsComponentError { get; set; }
    public bool displayGalleryComponentError { get; set; }

    bool displayError = false;

    public const string NOTHING_PROVIDED = "--NOTHING PROVIDED--";

    [Parameter]
    public string CreationType { get; set; }

    public Framework.Enums.Enums.ExperienceCreationType ExperienceCreationType = new Enums.ExperienceCreationType();

    protected override async Task OnInitializedAsync()
    {
        // get user token
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (token == null)
        {
            // don't have current user login
            navigationManager.NavigateTo("explore");
            return;
        }

        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if ((!experienceTypes.Succeeded || experienceTypes.Result == null) || (experienceTypes.Succeeded && !experienceTypes.Result.IsSuccess))
        {
            // an error occured when getting experience types to api
            navigationManager.NavigateTo("explore");
            return;
        }

        // get experience categories
        var categories = await activityApiHandler.GetExperienceCategories();
        if ((!categories.Succeeded || categories.Result == null) || (categories.Succeeded && !categories.Result.IsSuccess))
        {
            // an error occured when getting experience categories to api
            navigationManager.NavigateTo("explore");
            return;
        }

        // get sub categories
        var subCategories = await activityApiHandler.GetSubCategories();
        if ((!subCategories.Succeeded || subCategories.Result == null) || (subCategories.Succeeded && !subCategories.Result.IsSuccess))
        {
            // an error occured when getting sub categories to api
            navigationManager.NavigateTo("explore");
            return;
        }

        // get regions
        var regions = await activityApiHandler.GetAllRegions();
        if ((!regions.Succeeded || regions.Result == null) || (regions.Succeeded && !regions.Result.IsSuccess))
        {
            // an error occured when getting sub categories to api
            navigationManager.NavigateTo("explore");
            return;
        }

        bool isSuccess = Enum.TryParse(CreationType, out ExperienceCreationType) && Enum.IsDefined(typeof(Framework.Enums.Enums.ExperienceCreationType), ExperienceCreationType);

        if (!isSuccess)
        {
            navigationManager.NavigateTo("explore");
            return;
        }

        Model = new Models.ExperienceCreationModel
            {
                Token = token,
                ExperienceTypes = experienceTypes.Result.Result.Select(e =>
                {
                    return new Models.Entities.ExperienceType
                    {
                        Id = e.Id,
                        Name = e.Name
                    };
                }),
                ExperienceCategories = categories.Result.Result.Select(c =>
                {
                    return new Models.Entities.ExperienceCategory
                    {
                        Category = c.Name,
                        IconPath = c.IconPath,
                        Id = c.Id
                    };
                }),
                SubCategories = subCategories.Result.Result.Select(s =>
                {
                    return new Models.Entities.SubCategory
                    {
                        CategoryId = s.CategoryId,
                        Id = s.Id,
                        Name = s.Name
                    };
                }),
                Regions = regions.Result.Result.Select(r =>
                {
                    return new Models.Entities.Region
                    {
                        Code = r.Code,
                        Name = r.Name,
                        RegionName = r.RegionName
                    };
                })
            };

        Model.Activity.ExperienceCreationType = ExperienceCreationType;

        obj = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/Creation.js");
            //await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/experience-image-helper.js");
        }
        await Task.Run(() => module.InvokeVoidAsync("confirmation"));
    }

    private async Task SaveForLater()
    {
        isLoading = true;

        Model.Activity.ActivitySchedules = ValidateSchedules(Model.Activity.ActivitySchedules);
        Model.Activity.AddOns = ValidateAddOns(Model.Activity.AddOns);

        var submit = await activityApiHandler.CreateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs
            {
                Title                   = ReplaceEmptyValue(Model.Activity.Title, NOTHING_PROVIDED),
                Description             = ReplaceEmptyValue(Model.Activity.Description, NOTHING_PROVIDED),
                ExperienceCategoryId    = Model.Activity.ExperienceCategoryId != 0 ? Model.Activity.ExperienceCategoryId : 2,
                SubCategoryId           = Model.Activity.SubCategoryId != 0 ? Model.Activity.SubCategoryId : 51,
                ActivityLevel           = "Beginner",
                AdditionalRequirements  = ReplaceEmptyValue(Model.Activity.AdditionalRequirements, NOTHING_PROVIDED),
                Address1                = ReplaceEmptyValue(Model.Activity.Address1, NOTHING_PROVIDED),
                Address2                = ReplaceEmptyValue(Model.Activity.Address2, NOTHING_PROVIDED),
                CanAdultsJoin           = Model.Activity.CanAdultsJoin,
                City                    = ReplaceEmptyValue(Model.Activity.City, ""),
                Subdivision             = ReplaceEmptyValue(Model.Activity.Subdivision, NOTHING_PROVIDED),
                Region                  = ReplaceEmptyValue(Model.Activity.Region, ""),
                Barangay                = ReplaceEmptyValue(Model.Activity.Barangay, ""),
                PostalCode              = ReplaceEmptyValue(Model.Activity.PostalCode, NOTHING_PROVIDED),
                CustomerBringWithThem   = ReplaceEmptyValue(Model.Activity.CustomerBringWithThem, NOTHING_PROVIDED),
                District                = ReplaceEmptyValue(Model.Activity.District, NOTHING_PROVIDED),
                ExperienceTypeId        = Model.Activity.ExperienceTypeId != 0 ? Model.Activity.ExperienceTypeId : 1,
                IsPublished             = Model.Activity.IsPublished,
                MinimumAge              = Model.Activity.MinimumAge,
                Price                   = ReplaceEmptyValue(Model.Activity.Price, NOTHING_PROVIDED),
                Remarks                 = ReplaceEmptyValue(Model.Activity.Remarks, NOTHING_PROVIDED),
                ScheduleIndicator       = ReplaceEmptyValue(Model.Activity.ScheduleIndicator, NOTHING_PROVIDED),
                SearchTags              = Model.Activity.SearchTags,
                SkillLevel              = "No experience",
                SpecificsYouWillProvide = ReplaceEmptyValue(Model.Activity.SpecificsYouWillProvide, NOTHING_PROVIDED),
                PinnedLocation          = ReplaceEmptyValue(Model.Activity.PinnedLocation, NOTHING_PROVIDED),
                Status                  = Enums.ActivityStatus.InProgress,
                ExperienceCreationType  = ExperienceCreationType,
                ClassPolicies           = ReplaceEmptyValue(Model.Activity.ClassPolicies, NOTHING_PROVIDED),
                VideoLink               = ReplaceEmptyValue(Model.Activity.ClassPolicies, NOTHING_PROVIDED),
                ActivitySchedules = Model.Activity.ActivitySchedules.Select(s =>
               {
                   var scheduleTimes = new List<Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.ActivityScheduleTime>();
                   if(s.ScheduleTimes is not null)
                   {
                        foreach (var item in s.ScheduleTimes)
                        {
                            if(item.ActivityScheduleTimes is not null)
                            {
                                    foreach (var scheduleTime in item.ActivityScheduleTimes)
                                    {
                                        scheduleTimes.Add(new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.ActivityScheduleTime
                                        {
                                            DayOfWeek = scheduleTime.DayOfWeek,
                                            StartTime = scheduleTime.StartTime,
                                            EndTime = scheduleTime.EndTime
                                        });
                                    }
                            }
                        }
                   }

                   return new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.Schedule
                   {
                       DateTime = s.DateTime,
                       Name = s.Name,
                       PerUnit1 = s.PerUnit1,
                       PerUnit2 = s.PerUnit2,
                       Price = s.Price,
                       PriceUnit1 = s.PriceUnit1,
                       PriceUnit2 = s.PriceUnit2,
                       UnitPrice = s.UnitPrice,
                       Order = s.Order,
                       IsActiveSchedule = s.IsActiveSchedule,
                       IsSetSession = s.IsSetSession,
                       SessionName = s.SessionName ?? "N/A",
                       HasExpiration = s.HasExpiration,
                       StartDate = s.StartDate ?? DateTime.MinValue,
                       ScheduleType = s.ScheduleType,
                       //ActivityScheduleTimes = s.ScheduleTimes != null ? scheduleTimes : new List<Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.ActivityScheduleTime>()
                   };
               }),
                AddOns = Model.Activity.AddOns.Select(a =>
                {
                    return new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.CreateAddOn
                    {
                        Name = a.Name ?? "N/A",
                        Price = a.Price,
                        UnitPrice = a.UnitPrice,
                        Order = a.Order,
                        Description = a.Description ?? "N/A"
                    };
                }),
            }, Model.Token);

        if ((!submit.Succeeded || submit.Result == null) || (submit.Succeeded && !submit.Result.IsSuccess))
        {
            errorMessage = submit.Result?.ErrorInfo?.Message ?? submit.Message;
            ShowErrorMessage = true;
            StateHasChanged();
            return;
        }

        // upload image without checking if there is an error so that can't re update another activity
        bool isSuccess = await jsRuntime.InvokeAsync<bool>("MyLib.Pages.activity.creation.initCreationInProgress", obj, submit.Result.Result.ActivityId);

        navigationManager.NavigateTo("/maker/dashboard");
        isLoading = false;

        return;
    }

    private async Task OnNextClick(int index = 0)
    {
        displayError = false;

        // for submit action
        if (index == 0 && currentIndex == 7)
        {
            await loadingIndicator.Show();
            if (!GeneralPublishPage.Validate())
            {
                await loadingIndicator.Hide();
                return;
            }

            isLoading = true;
            Model.Activity.ActivitySchedules = GetActivitySchedules(Model.Activity.ActivitySchedules);
            Model.Activity.AddOns = GetAddOns(Model.Activity.AddOns);

            var sortPrice = Model.Activity.ActivitySchedules.OrderBy(x => x.Price).ToList();

            Model.Activity.Price = sortPrice.Count > 1 ? String.Format("{0} {1} - {2}",
                                                                        sortPrice.ElementAtOrDefault(0).UnitPrice,
                                                                        sortPrice.ElementAtOrDefault(0).Price,
                                                                        sortPrice.ElementAtOrDefault(sortPrice.Count - 1).Price) : String.Format("{0} {1} / {2} {3} / {4} {5}",
                                                                        sortPrice.ElementAtOrDefault(0).UnitPrice,
                                                                        sortPrice.ElementAtOrDefault(0).Price.ToString(),
                                                                        sortPrice.ElementAtOrDefault(0).PerUnit1.ToString(),
                                                                        sortPrice.ElementAtOrDefault(0).PriceUnit1,
                                                                        sortPrice.ElementAtOrDefault(0).PerUnit2.ToString(),
                                                                        sortPrice.ElementAtOrDefault(0).PriceUnit2);

            var args = new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs
                {
                    ActivityLevel = "Beginner",
                    ActivitySchedules = Model.Activity.ActivitySchedules.Select(s =>
                    {
                        var scheduleTimes = new List<Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.ActivityScheduleTime>();
                        if (s.ScheduleTimes != null)
                        {
                            foreach (var item in s.ScheduleTimes)
                            {
                                foreach (var scheduleTime in item.ActivityScheduleTimes)
                                {
                                    scheduleTimes.Add(new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.ActivityScheduleTime
                                    {
                                        DayOfWeek = scheduleTime.DayOfWeek,
                                        StartTime = scheduleTime.StartTime,
                                        EndTime   = scheduleTime.EndTime,
                                        IsEnabled = item.IsEnabled
                                    });
                                }
                            }
                        }

                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.Schedule
                        {
                            DateTime              = s.DateTime ?? "N/A",
                            Name                  = Model.Activity.ScheduleType == Enums.ScheduleType.Calendly ? "Calendly Appointment" : s.Name ?? "N/A",
                            PerUnit1              = s.PerUnit1,
                            PerUnit2              = s.PerUnit2,
                            Price                 = s.Price,
                            PriceUnit1            = s.PriceUnit1,
                            PriceUnit2            = s.PriceUnit2,
                            UnitPrice             = s.UnitPrice,
                            Order                 = s.Order,
                            IsActiveSchedule      = s.IsActiveSchedule,
                            IsSetSession          = s.IsSetSession,
                            SessionName           = s.SessionName ?? "N/A",
                            HasExpiration         = s.HasExpiration,
                            StartDate             = s.StartDate ?? DateTime.MinValue,
                            ScheduleType          = Model.Activity.ScheduleType,
                            PriceType             = s.PriceType,
                            SchedulingUrl         = Model.Activity.SchedulingUrl ?? "#",
                            ActivityScheduleTimes = scheduleTimes
                        };
                    }),
                    AddOns = Model.Activity.AddOns.Select(a => {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateActivityArgs.CreateAddOn
                        {
                            Name        = a.Name ?? "N/A",
                            Price       = a.Price,
                            UnitPrice   = a.UnitPrice,
                            Order       = a.Order,
                            Description = a.Description ?? "N/A"
                        };
                    }),
                    AdditionalRequirements  = Model.Activity.AdditionalRequirements,
                    Address1                = Model.Activity.Address1,
                    Address2                = Model.Activity.Address2,
                    CanAdultsJoin           = Model.Activity.CanAdultsJoin,
                    Subdivision             = Model.Activity.Subdivision,
                    City                    = Model.Activity.City,
                    Region                  = Model.Activity.Region,
                    Barangay                = Model.Activity.Barangay,
                    PostalCode              = Model.Activity.PostalCode,
                    CustomerBringWithThem   = Model.Activity.CustomerBringWithThem,
                    Description             = Model.Activity.Description,
                    District                = Model.Activity.District,
                    ExperienceCategoryId    = Model.Activity.ExperienceCategoryId,
                    ExperienceTypeId        = Model.Activity.ExperienceTypeId,
                    IsPublished             = Model.Activity.IsPublished,
                    MinimumAge              = Model.Activity.MinimumAge,
                    Price                   = Model.Activity.Price,
                    Remarks                 = Model.Activity.Remarks,
                    ScheduleIndicator       = Model.Activity.ScheduleIndicator,
                    SearchTags              = Model.Activity.SearchTags,
                    SkillLevel              = "No experience",
                    SpecificsYouWillProvide = Model.Activity.SpecificsYouWillProvide,
                    SubCategoryId           = Model.Activity.SubCategoryId,
                    Title                   = Model.Activity.Title,
                    PinnedLocation          = Model.Activity.PinnedLocation,
                    Status                  = Enums.ActivityStatus.Submitted,
                    ExperienceCreationType  = ExperienceCreationType,
                    ClassPolicies           = Model.Activity.ClassPolicies,
                    VideoLink               = Model.Activity.VideoLink
                };

            var submit = await activityApiHandler.CreateActivity(args, Model.Token);

            if ((!submit.Succeeded || submit.Result == null) || (submit.Succeeded && !submit.Result.IsSuccess))
            {
                errorMessage = submit.Result?.ErrorInfo?.Message ?? submit.Message;
                ShowErrorMessage = true;
                await loadingIndicator.Hide();
                StateHasChanged();
                return;
            }

            // upload image without checking if there is an error so that can't re update another activity
            bool isSuccess = await galleryComponent.UploadImages(submit.Result.Result.ActivityId);
            isLoading = false;
            await loadingIndicator.Hide();

            await NotificationService.Success("Success! You created an activity", "Success!");

            await Task.Delay(1000);            

            navigationManager.NavigateTo("/maker/dashboard");

            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Creation");

            return;
        }

        if (index != 0)
        {
            switch (currentIndex)
            {
                case 1:
                    if (Model.HasError = !creationOverviewComponent.IsAllFieldsValidated())
                    {
                        await module.InvokeVoidAsync("scrollToRequiredField", ".creation-overview");
                        return;
                    };

                    isCreationOverviewComponentValid = true;

                    if ((index - currentIndex) > 1)
                    {
                        for (int i = currentIndex + 1; i < index; i++)
                        {
                            var result = ValidateFormFields(i);

                            if (result)
                            {
                                displayError = result;
                            }
                        }

                        if (!displayError)
                        {
                            currentIndex = index;
                        }
                    }
                    else
                    {
                        currentIndex = index;
                    }

                    break;
                case 2:
                    if (Model.HasError = !locationComponent.IsAllFieldsValidated())
                    {
                        await module.InvokeVoidAsync("scrollToRequiredField", ".location-section");
                        return;
                    };

                    isLocationComponentValid = true;

                    if ((index - currentIndex) > 1)
                    {
                        for (int i = currentIndex + 1; i < index; i++)
                        {
                            var result = ValidateFormFields(i);

                            if (result)
                            {
                                displayError = result;
                            }
                        }

                        if (!displayError)
                        {
                            currentIndex = index;
                        }
                    }
                    else
                    {
                        currentIndex = index;
                    }

                    break;
                case 3:
                    if (ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
                    {
                        if (Model.HasError = !pricingAndScheduleComponent.IsAllFieldsValidated())
                        {
                            await module.InvokeVoidAsync("scrollToRequiredField", ".pricing-schedule-section");
                            return;
                        };
                    }
                    else if (ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
                    {
                        if (Model.HasError = !pricingAndScheduleAppointmentComponent.IsAllFieldsValidated())
                        {
                            await module.InvokeVoidAsync("scrollToRequiredField", ".pricing-schedule-section");
                            return;
                        };
                    }

                    isPricingAndScheduleComponentValid = true;

                    if ((index - currentIndex) > 1)
                    {
                        for (int i = currentIndex + 1; i < index; i++)
                        {
                            var result = ValidateFormFields(i);

                            if (result)
                            {
                                displayError = result;
                            }
                        }

                        if (!displayError)
                        {
                            currentIndex = index;
                        }
                    }
                    else
                    {
                        currentIndex = index;
                    }

                    break;
                case 4:
                    isOptionalDetailsComponentValid = true;
                    currentIndex = index;
                    break;
                case 5:
                    if (Model.HasError = !galleryComponent.IsAllFieldsValidated())
                    {
                        await module.InvokeVoidAsync("scrollToRequiredField", ".gallery-section");
                        return;
                    };

                    isGalleryComponentValid = true;

                    if ((index - currentIndex) > 1)
                    {
                        for (int i = currentIndex + 1; i < index; i++)
                        {
                            var result = ValidateFormFields(i);

                            if (result)
                            {
                                displayError = result;
                            }
                        }

                        if (!displayError)
                        {
                            currentIndex = index;
                        }
                    }
                    else
                    {
                        currentIndex = index;
                    }

                    break;
                case 6:
                    currentIndex = index;
                    break;
            }

            await Task.Delay(100);
            await module.InvokeVoidAsync("onScrollUp");
            return;
        }
        else
        {
            if (currentIndex == 1)
            {
                if (Model.HasError = !creationOverviewComponent.IsAllFieldsValidated())
                {
                    await module.InvokeVoidAsync("scrollToRequiredField", ".creation-overview");
                    return;
                }
                else
                {
                    isCreationOverviewComponentValid = true;

                }
            }
            else if (currentIndex == 2)
            {
                if (Model.HasError = !locationComponent.IsAllFieldsValidated())
                {
                    await module.InvokeVoidAsync("scrollToRequiredField", ".location-section");
                    return;
                }
                else
                {
                    isLocationComponentValid = true;
                }
            }
            else if (currentIndex == 3)
            {
                if (ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
                {
                    if (Model.HasError = !pricingAndScheduleComponent.IsAllFieldsValidated())
                    {
                        await module.InvokeVoidAsync("scrollToRequiredField", ".pricing-schedule-section");
                        return;
                    }
                    else
                    {
                        isPricingAndScheduleComponentValid = true;
                    }
                }
                else if (ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
                {
                    if (Model.HasError = !pricingAndScheduleAppointmentComponent.IsAllFieldsValidated())
                    {
                        await module.InvokeVoidAsync("scrollToRequiredField", ".pricing-schedule-section");
                        return;
                    }
                    else
                    {
                        isPricingAndScheduleComponentValid = true;
                    }
                }
            }
            else if (currentIndex == 4)
            {
                isOptionalDetailsComponentValid = true;
            }
            else if (currentIndex == 5)
            {
                if (Model.HasError = !galleryComponent.IsAllFieldsValidated())
                {
                    await module.InvokeVoidAsync("scrollToRequiredField", ".gallery-section");
                    return;
                }
                else
                {
                    isGalleryComponentValid = true;
                }
            }

            currentIndex += 1;
        }
        await Task.Delay(100);
        await module.InvokeVoidAsync("onScrollUp");
    }

    private async Task OnBackClick(int index = 0)
    {
        if (currentIndex == 0) return;

        if (currentIndex == 1)
        {
            isCreationOverviewComponentValid = true;
        }
        else if (currentIndex == 2)
        {
            isLocationComponentValid = true;
        }
        else if (currentIndex == 3)
        {
            isPricingAndScheduleComponentValid = true;
        }
        else if (currentIndex == 4)
        {
            isOptionalDetailsComponentValid = true;
        }
        else if (currentIndex == 5)
        {
            isGalleryComponentValid = true;
        }
        currentIndex--;

        await Task.Delay(100);
        await module.InvokeVoidAsync("onScrollUp");
    }

    private double GetPerentCompletion
    {
        get
        {
            return Math.Round(currentIndex * 16.67);
        }
    }

    [JSInvokable]
    public void ShowError(string message)
    {
        errorMessage = message;
        ShowErrorMessage = true;
        StateHasChanged();
    }

    private IList<Models.Entities.ActivitySchedule> GetActivitySchedules(IList<Models.Entities.ActivitySchedule> activitySchedules)
    {
        var result = new List<Models.Entities.ActivitySchedule>();

        if (ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
        {
            bool isSingle = activitySchedules.Count == 1;
            foreach (var schedule in activitySchedules)
            {
                if (!(string.IsNullOrEmpty(schedule.Name) ||
                    string.IsNullOrEmpty(schedule.DateTime) ||
                    schedule.Price <= 0 ||
                    string.IsNullOrEmpty(schedule.UnitPrice) ||
                    schedule.PerUnit1 <= 0 ||
                    string.IsNullOrEmpty(schedule.PriceUnit1) ||
                    schedule.PerUnit2 <= 0 ||
                    string.IsNullOrEmpty(schedule.PriceUnit2)))
                {
                    result.Add(schedule);
                }
            }
        }
        else if (ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
        {
            foreach (var schedule in activitySchedules)
            {
                result.Add(schedule);
            }
        }

        return result;
    }

    private IList<Models.Entities.AddOn> GetAddOns(IList<Models.Entities.AddOn> addOns)
    {
        var result = new List<Models.Entities.AddOn>();

        if (ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
        {
            bool isSingle = addOns.Count == 1;
            foreach (var addOn in addOns.Where(a => !a.IsDeleted))
            {
                if (!(string.IsNullOrEmpty(addOn.Name) ||
                    addOn.Price <= 0 ||
                    string.IsNullOrEmpty(addOn.UnitPrice)))
                {
                    result.Add(addOn);
                }
            }
        }
        return result;
    }

    private string ReplaceEmptyValue(string value, string replacement)
    {
        return string.IsNullOrEmpty(value) ? replacement : value;
    }

    private IList<Models.Entities.ActivitySchedule> ValidateSchedules(IList<Models.Entities.ActivitySchedule> activitySchedules)
    {
        bool isSingle = activitySchedules.Count == 1;
        bool isValid = false;

        foreach (var schedule in activitySchedules)
        {
            if ((string.IsNullOrEmpty(schedule.Name) ||
                string.IsNullOrEmpty(schedule.DateTime) ||
                schedule.Price <= 0 ||
                string.IsNullOrEmpty(schedule.UnitPrice) ||
                schedule.PerUnit1 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit1) ||
                schedule.PerUnit2 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit2)) && (schedule.IsActiveSchedule || isSingle))
                isValid = false;

            if (!isValid)
            {
                schedule.Name = ReplaceEmptyValue(schedule.Name, NOTHING_PROVIDED);
                schedule.DateTime = ReplaceEmptyValue(schedule.DateTime, NOTHING_PROVIDED);
                schedule.UnitPrice = ReplaceEmptyValue(schedule.UnitPrice, NOTHING_PROVIDED);
                schedule.PriceUnit1 = ReplaceEmptyValue(schedule.PriceUnit1, NOTHING_PROVIDED);
                schedule.PriceUnit2 = ReplaceEmptyValue(schedule.PriceUnit2, NOTHING_PROVIDED);
            }

        }

        return activitySchedules;
    }

    private IList<Models.Entities.AddOn> ValidateAddOns(IList<Models.Entities.AddOn> addOns)
    {
        bool isSingle = addOns.Count == 1;
        bool isValid = false;

        foreach (var addOn in addOns.Where(a => !a.IsDeleted))
        {
            if  (string.IsNullOrEmpty(addOn.Name) ||
                addOn.Price <= 0 ||
                string.IsNullOrEmpty(addOn.UnitPrice))
                isValid = false;

            if (!isValid)
            {
                addOn.Name = ReplaceEmptyValue(addOn.Name, NOTHING_PROVIDED);
                addOn.UnitPrice = ReplaceEmptyValue(addOn.UnitPrice, NOTHING_PROVIDED);
            }

        }
        return addOns;
    }

    private bool ValidateFormFields(int index)
    {
        bool displayError = false;

        switch (index)
        {
            case 1:
                if (Model.HasError = !creationOverviewComponent.IsAllFieldsValidated())
                {
                    displayCreationOverviewComponentError = true;
                }
                else
                {
                    displayCreationOverviewComponentError = false;
                }

                displayError = displayCreationOverviewComponentError;

                break;
            case 2:
                if (Model.HasError = !locationComponent.IsAllFieldsValidated())
                {
                    displayLocationComponentError = true;
                }
                else
                {
                    displayLocationComponentError = false;
                }

                displayError = displayLocationComponentError;

                break;
            case 3:
                if (Model.HasError = !pricingAndScheduleComponent.IsAllFieldsValidated())
                {
                    displayPricingAndScheduleComponentError = true;
                }
                else
                {
                    displayPricingAndScheduleComponentError = false;
                }

                displayError = displayPricingAndScheduleComponentError;

                break;
            case 4:
                isOptionalDetailsComponentValid = true;
                break;
            case 5:
                if (Model.HasError = !galleryComponent.IsAllFieldsValidated())
                {
                    displayGalleryComponentError = true;
                }
                else
                {
                    displayGalleryComponentError = false;
                }

                displayError = displayGalleryComponentError;

                break;
            case 6:
                break;
        }

        return displayError;
    }

@page "/customer/profile"
@using Cinnamon.Core
@using Cinnamon.Core.Models;
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Modals;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using System.Security.Claims
@inject IModalService modal
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;

@if(Model != null)
{
    <section class="py-3 mt-5 profile-content">
        <Container>
            <Row>
                <Column class="profile-column-card" ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Card class="customer-profile-card" Border="Border.Is0" Padding="Padding.Is3">
                        <CardHeader Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0.FromTop">
                            <Figure Width="Width.Max100" Border="Border.RoundedCircle" Size="FigureSize.Is128x128" Margin="Margin.IsAuto.OnX.Is0.OnY" Display="Display.Block">
                                <CardImage Source=@ImageSource Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                            </Figure>
                            <div class="edit-icon">
                                @if (!Model.CustomerProfile.IsVerified)
                                {
                                    <Button Border="Border.Is0" Padding="Padding.Is0" Margin="Margin.Is0" Clicked="EditProfile"> 
                                        <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                                    </Button>
                                }
                            </div>
                        </CardHeader>
                        <CardBody Border="Border.Is0" Padding="Padding.Is1.OnY">
                            <CardTitle TextAlignment="TextAlignment.Center">
                                <p class="text-capitalize fw-bold m-0 mb-1 font-30">@Model.CustomerProfile.FirstName @Model.CustomerProfile.LastName</p>
                                @if(Model.CustomerProfile.IsVerified)
                                {
                                    <p class="text-color-8080 my-1 font-24">
                                        <Icon Name="IconName.ShieldAlt" IconStyle="IconStyle.Solid" />
                                        <span class="text-capitalize">verified user</span>
                                    </p>
                                }
                                <p class="text-color-8080 font-16 mb-1">Use the badge to prove your identify to others.</p>
                            </CardTitle>
                        </CardBody>
                        <CardFooter Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0">
                            @if(!Model.CustomerProfile.IsVerified)
                            {
                                <Button TextColor="TextColor.White" Width="Width.Is100" Size="Size.Small" @onclick="() => uploadIdModal.ShowModal()" 
                                    Color="Color.Primary" Border="Border.Is0.RoundedPill" Block class="font-18">Get the badge</Button>
                            }
                        </CardFooter>
                    </Card>
                </Column>
                <Column class="profile-details" ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Div Padding="Padding.Is5.OnX.OnDesktop" Margin="Margin.Is2.FromTop.OnMobile">
                        <Div>
                            <p class="m-0 font-30 fw-bold">Hi, I'm <span class="text-capitalize">@Model.CustomerProfile.FirstName</span></p>
                            <p class="m-0 text-color-8080 font-14">Joined in 2022</p>
                        </Div>
                        <Div Display="Display.Flex" Flex="Flex.AlignItems.Center.JustifyContent.Between">
                            <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                                <p class="my-3 fw-bold font-18">About you</p>
                                <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3" @onclick="OnEditAboutClick"> 
                                    <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                                </Button>
                            </Div>
                            @if(isEditAbout)
                            {
                                <Button Border="Border.Is0" TextColor="TextColor.White" Color="Color.Primary" @onclick="SaveAboutClick">Save</Button>
                            }
                        </Div>
                        @if(!isEditAbout)
                        {
                            <p class="m-0 text-color-8080 font-16">@Model.CustomerProfile.About</p>
                        }
                        else
                        {
                            <MemoEdit Border="Border.Rounded" @bind-Text="aboutLocalState" Rows="5" />
                        }
                    </Div>
                </Column>
            </Row>
        </Container>
    </section>

    <section class="mt-5 customer-profile-details">
        <Container>
            <Div Overflow="Overflow.Hidden" class="ongoing-experiences-container personal-tab-swiper" Display="Display.None.OnDesktop.Block.OnMobile">
                <div class="swiper-wrapper">
                    <div class='swiper-slide @(selectedTab == "experiences" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "experiences" ? "active" : "")'
                            @onclick='() => selectedTab = "experiences"'>
                            experiences
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "personal-info" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "personal-info" ? "active" : "")'
                            @onclick='() => selectedTab = "personal-info"'>
                            personal info
                        </div>
                    </div>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <div class='swiper-slide @(selectedTab == "maker-experience" ? "swiper-slide-active" : "")'>
                            <div class='tab-item @(selectedTab == "maker-experience" ? "active" : "")'
                                @onclick='() => selectedTab = "maker-experience"'>
                                created experiences
                            </div>
                        </div>
                    }
                </div>
            </Div>
            <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Name="experiences" TextTransform="TextTransform.Capitalize">experiences</Tab>
                    <Tab Name="personal-info" TextTransform="TextTransform.Capitalize">personal info</Tab>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <Tab Name="maker-experience" TextTransform="TextTransform.Capitalize">created experiences</Tab>
                    }
                </Items>
                <Content>
                    <TabPanel Name="experiences">
                        @*<Experiences Activities="OngoingActivities"/>*@
                    </TabPanel>
                    <TabPanel Name="personal-info">
                        <PersonalInfo @bind-Model="Model" OnEditIdClick="() => uploadIdModal.ShowModal()" />
                    </TabPanel>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <TabPanel Name="maker-experience">
                            <MakerExperiences @ref="makerExperiences" Activities="activities" />
                        </TabPanel>
                    }
                </Content>
            </Tabs>
        </Container>
    </section>
    <ModalUploadingProfile @ref="upload" Token="@Model.Token"></ModalUploadingProfile>
    <ModalUploadGovernmentId @ref="uploadIdModal" Token="@Model.Token"/>
}

@code 
{
    private IList<ActivityModel> activities = new List<ActivityModel>();

    private ModalUploadGovernmentId uploadIdModal;

    private MakerExperiences makerExperiences;

    private string selectedTab = "experiences";

    private string ImageSource { get; set; } = "images/Profile/user";

    private Models.Customer.Profile Model;

    protected ModalUploadingProfile upload { get; set; }

    private bool isEditAbout = false;

    private string aboutLocalState = string.Empty;

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }

        //Get Customer Information
        Model = new();
        var profile = result.Result.Result;

        // get family members information
        Model.FamilyMembers = new List<Models.Entities.FamilyMember>();
        var members = await accountApiHandler.GetFamilyMembers(token);
        if(members.Succeeded && members.Result != null && members.Succeeded)
        {
            Model.FamilyMembers = members.Result.Result.Select(m => {
                return new Models.Entities.FamilyMember {
                    BirthMonth = m.BirthMonth,
                    BirthYear = m.BirthYear,
                    Gender = m.Gender,
                    Name = m.Name,
                    Id = m.Id
                };
            }).ToList();
        }

        Model.Token = token;
        Model.CustomerProfile = new Models.Entities.CustomerProfile
            {
                About = profile.About,
                Birthdate = profile.Birthdate,
                Email = profile.Email,
                FirstName = profile.FirstName,
                LastName = profile.LastName,
                Id = profile.Id,
                IsMaker = profile.IsMaker,
                IsVerified = profile.IsVerified,
                ProfilePath = profile.ProfileImg,
            };

        ImageSource = Model.CustomerProfile.ProfilePath;

        //Get Maker Activities
        //activities = (await CoreDI.DataStore.Activities.GetActivityByCreatedId(Model.CustomerProfile.Id)).OrderBy(i => i.Id).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init", "Experience Details Page Loaded");
    }

    private async Task EditProfile()
    {
        //Display Modal Upload
        await upload.OpenModal();
    }

    private void OnEditAboutClick()
    {
        isEditAbout = !isEditAbout;
        if(isEditAbout)
        {
            aboutLocalState = Model.CustomerProfile.About;
        }
        else 
        {
            aboutLocalState = string.Empty;
        }
    }

    private async Task SaveAboutClick()
    {
        if(isEditAbout)
        {
            var result = await accountApiHandler.UpdateProfileDetails(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
            {
                About = aboutLocalState,
            }, Model.Token);

            if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                Model.CustomerProfile.About = string.IsNullOrEmpty(result.Result.Result.About) ? string.Empty : result.Result.Result.About;
            }
        }

        isEditAbout = false;
    }

    private IList<ActivityModel> OngoingActivities 
    {
        get 
        {
            return Model.Customer.OngoingActivities.Select(i => i.Activity).ToList();
        }    
    }
}

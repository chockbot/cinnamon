@page "/customer/profile"
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Modals;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IModalService modal
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IDashboardApiHandler dashboardApiHandler

<PageTitle>Your Profile | CinnamonPH</PageTitle>
<SeoMeta Title="Your Profile" Subject="Profile" Url="/customer/profile" />

@if(Model != null)
{
    <div id="alertContainer" class="alertContainer">
        <div id="alertMessage" class="alertMessage">Copied to clipboard!</div>
    </div>
    <section class="py-3 mt-5 profile-content">
        <Container>
            <Row>
                <Column class="profile-column-card" ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Card class="customer-profile-card" Border="Border.Is0" Padding="Padding.Is3">
                        <CardHeader Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0.FromTop">
                            <button class="btn btn-copy" @onclick="() => CopyToClipboard()">
                                <img src="images/copytoclipboard.png">
                            </button>
                            <Figure class="profile-pic">
                                <CardImage Source=@ImageSource Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                            </Figure>
                            <div class="edit-icon">
                                <Button @onclick="() => upload.ShowModal()">
                                    <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                                </Button>
                            </div>
                        </CardHeader>
                        <CardBody Border="Border.Is0" Padding="Padding.Is1.OnY">
                            @switch (Model.CustomerProfile.IsVerified)
                            {
                                case 0:
                                    <CardTitle TextAlignment="TextAlignment.Center">
                                       <p class="text-capitalize fw-bold m-0 mb-1 font-30">@Model.CustomerProfile.FirstName @Model.CustomerProfile.LastName</p>
                                       <p class="text-color-8080 font-16 mb-1">Use the badge to prove your identify to others.</p>
                                       <Button TextColor="TextColor.White" Width="Width.Is100" Size="Size.Small" @onclick="() => NavigateToGetVerified()"
                                           Color="Color.Primary" Border="Border.Is0.RoundedPill" Block class="font-18">
                                            Get Verified
                                       </Button>
                                    </CardTitle>
                                    break;
                                case 1:
                                    <CardTitle TextAlignment="TextAlignment.Center">
                                        <p class="text-capitalize fw-bold m-0 mb-1 font-30">@Model.CustomerProfile.FirstName @Model.CustomerProfile.LastName</p>
                                        <p class="text-color-8080 font-16 mb-1">@Resources.App.pendingVerification</p>

                                        <p class="text-color-8080 my-1 font-24">
                                            <img class="img-pending" src="images/PendingIcon.png" />
                                            @*<Icon Name="IconName.ShieldAlt" IconStyle="IconStyle.Solid" />*@
                                            <span class="span-pending">Pending Verification</span>
                                        </p>
                                        
                                    </CardTitle>
                                    break;
                                case 2:
                                    <CardTitle TextAlignment="TextAlignment.Center">
                                        <p class="text-capitalize fw-bold m-0 mb-1 font-30">@Model.CustomerProfile.FirstName @Model.CustomerProfile.LastName</p>
                                        <p class="text-color-8080 my-1 font-24">
                                            <img class="img-verified" src="images/Badges/VERIFIED.svg" />
                                            @*<Icon Name="IconName.ShieldAlt" IconStyle="IconStyle.Solid" />*@
                                            <span class="span-verified">Verified</span>
                                        </p>
                                    </CardTitle>
                                    break;
                                default:
                                    break;
                            }
                        </CardBody>
                        <CardFooter Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0">
                            @if (MakerOngoingStudent != 0)
                            {
                                <div class="ongoing-students">
                                    <p class="ongoing-students-label">Ongoing Enrollees</p>
                                    <p class="ongoing-students-number">@MakerOngoingStudent</p>
                                </div>
                            }
                            @if (MakerCompletedStudent != 0)
                            {
                                <div class="completed-students">
                                    <p class="completed-students-label">Completed Enrollees</p>
                                    <p class="completed-students-number">@MakerCompletedStudent</p>
                                </div>
                            }  
                        </CardFooter>
                    </Card>
                </Column>
                <Column class="profile-details" ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Div Padding="Padding.Is5.OnX.OnDesktop" Margin="Margin.Is2.FromTop.OnMobile">
                        <Div>
                            <p class="m-0 font-30 fw-bold">Hi, I'm <span class="text-capitalize">@Model.CustomerProfile.FirstName</span></p>
                            <p class="m-0 text-color-8080 font-14">Email: @Model.CustomerProfile.Email</p>
                            <p class="m-0 text-color-8080 font-14">Joined in @Model.CustomerProfile.DateJoined.Year</p>
                        </Div>
                        <Div Display="Display.Flex" Flex="Flex.AlignItems.Center.JustifyContent.Between">
                            <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                                <p class="my-3 fw-bold font-18">About you</p>
                                <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3" @onclick="OnEditAboutClick"> 
                                    <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                                </Button>
                            </Div>
                            @if(isEditAbout)
                            {
                                <Button Border="Border.Is0" TextColor="TextColor.White" Color="Color.Primary" @onclick="SaveAboutClick">Save</Button>
                            }
                        </Div>
                        @if(!isEditAbout)
                        {
                            <p class="m-0 text-color-8080 font-16">@Model.CustomerProfile.About</p>
                        }
                        else
                        {
                            <MemoEdit Border="Border.Rounded" @bind-Text="aboutLocalState" Rows="5" />
                        }
                        @if(Model.CustomerProfile.IsVerified != 0){
                        int cnt = 0;
                        <p class="my-3 fw-bold font-18">Badges</p>
                        <Div Display="Display.Flex" Flex="Flex.AlignContent.Center">
                            <Card class="badges-column">
                                <CardBody Flex="Flex.AlignContent.Center">
                                    @if (Model.CustomerProfile.IsVerified == 2)
                                    {
                                        cnt++;
                                        <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                                <div class="badge-name @displayText">
                                                    @if (cnt <= 3)
                                                    {
                                                        <p>Verified</p>
                                                    }
                                                    else
                                                    {
                                                        displayText = "d-none";
                                                    }
                                                </div>
                                        </Tooltip>
                                    }
                                    @if (Model.CustomerProfile.IsOG == true)
                                    {
                                        cnt++;
                                        <Tooltip Multiline=true Text="For being part of the alpha and beta testing." Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="images/Badges/OG.svg" />
                                                <div class="badge-name @displayText">
                                                    @if (cnt <= 3)
                                                    {
                                                        <p>OG</p>
                                                    }
                                                    else
                                                    {
                                                        displayText = "d-none";
                                                    }
                                                </div>
                                        </Tooltip>
                                    }
                                    @if (Model.CustomerProfile.IsOfficial == true)
                                    {
                                        cnt++;
                                        <Tooltip Multiline=true Text="Legitimate experience provider in the platform." Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                                <div class="badge-name @displayText">
                                                    @if (cnt <= 3)
                                                    {
                                                        <p>Official Partner</p>
                                                    }
                                                    else
                                                    {
                                                        displayText = "d-none";
                                                    }
                                                </div>
                                        </Tooltip>
                                    }
                                    @if (MakerCompletedStudent >= 10 && MakerCompletedStudent < 25)
                                    {
                                        cnt++;
                                        var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                        <Tooltip Multiline=true Text="@rare.Description" Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="@rare.ImgScr" />
                                            <div class="badge-name @displayText">
                                                @if (cnt <= 3)
                                                {
                                                    <p>@rare.Name</p>
                                                }
                                                else
                                                {
                                                    displayText = "d-none";
                                                }
                                            </div>
                                        </Tooltip>
                                    }
                                    @if (MakerCompletedStudent >= 25 && MakerCompletedStudent < 100)
                                    {
                                        cnt++;
                                        var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                        <Tooltip Multiline=true Text="@epic.Description" Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="@epic.ImgScr" />
                                            <div class="badge-name @displayText">
                                                @if (cnt <= 3)
                                                {
                                                    <p>@epic.Name</p>
                                                }
                                                else
                                                {
                                                    displayText = "d-none";
                                                }
                                            </div>
                                        </Tooltip>
                                    }
                                    @if (MakerCompletedStudent >= 100)
                                    {
                                        cnt++;
                                        var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                        <Tooltip Multiline=true Text="@legendary.Description" Flex="Flex.AlignContent">
                                            <img class="verified-logo" src="@legendary.ImgScr" />
                                            <div class="badge-name @displayText">
                                                @if (cnt <= 3)
                                                {
                                                    <p>@legendary.Name</p>
                                                }
                                                else
                                                {
                                                    displayText = "d-none";
                                                }
                                            </div>
                                        </Tooltip>
                                    }
                                </CardBody>
                            </Card>
                        </Div>
                        }
                    </Div>
                </Column>
            </Row>
        </Container>
    </section>

    <section class="mt-5 customer-profile-details">
        <Container>
            <Div Overflow="Overflow.Hidden" class="ongoing-experiences-container personal-tab-swiper" Display="Display.None.OnDesktop.Block.OnMobile">
                <div class="swiper-wrapper">
                    <div class='swiper-slide @(selectedTab == "experiences" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "experiences" ? "active" : "")'
                            @onclick='() => selectedTab = "experiences"'>
                            experiences
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "personal-info" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "personal-info" ? "active" : "")'
                            @onclick='() => selectedTab = "personal-info"'>
                            personal info
                        </div>
                    </div>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <div class='swiper-slide @(selectedTab == "maker-experience" ? "swiper-slide-active" : "")'>
                            <div class='tab-item @(selectedTab == "maker-experience" ? "active" : "")'
                                @onclick='() => selectedTab = "maker-experience"'>
                                created experiences
                            </div>
                        </div>
                    }
                    <div class='swiper-slide @(selectedTab == "request-for-refund" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "request-for-refund" ? "active" : "")'
                            @onclick='() => selectedTab = "request-for-refund"'>
                            request refund
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "cinnamon-credit" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "cinnamon-credit" ? "active" : "")'
                            @onclick='() => selectedTab = "cinnamon-credit"'>
                            cinnamon credits
                        </div>
                    </div>
                </div>
            </Div>
            <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Name="experiences" TextTransform="TextTransform.Capitalize">enrolled experiences</Tab>
                    <Tab Name="personal-info" TextTransform="TextTransform.Capitalize">personal info</Tab>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <Tab Name="maker-experience" TextTransform="TextTransform.Capitalize">created experiences</Tab>
                    }
                    <Tab Name="request-for-refund" TextTransform="TextTransform.Capitalize">request refund</Tab>
                    <Tab Name="cinnamon-credit" TextTransform="TextTransform.Capitalize">cinnamon credits</Tab>
                </Items>
                <Content>
                    <TabPanel Name="experiences">
                        <Experiences Activities="Model.EnrolledActivities" Profile="Model.CustomerProfile"/>
                    </TabPanel>
                    <TabPanel Name="personal-info">
                        <PersonalInfo @bind-Model="Model" OnEditIdClick="() => NavigateToUploadId()" />
                    </TabPanel>
                    @if(Model.CustomerProfile.IsMaker)
                    {
                        <TabPanel Name="maker-experience">
                            <MakerExperiences @ref="makerExperiences" Activities="Model.OwnedActivities" />
                        </TabPanel>
                    }
                    <TabPanel Name="request-for-refund">
                        <RequestRefund Profile="Model.CustomerProfile" Token="@Model.Token"/>
                    </TabPanel>
                    <TabPanel Name="cinnamon-credit">
                        <CinnamonCredits Token="@Model.Token" />
                    </TabPanel>
                </Content>
            </Tabs>
        </Container>
    </section>
    <ModalUploadingProfile @ref="upload" Token="@Model.Token"></ModalUploadingProfile>
}

@code 
{
    IJSObjectReference module;

    private MakerExperiences makerExperiences;

    private string selectedTab = "experiences";

    private string ImageSource { get; set; } = "images/Profile/user";

    private Models.Customer.Profile Model;

    protected ModalUploadingProfile upload;

    private bool isEditAbout = false;

    private string aboutLocalState = string.Empty;

    public int MakerOngoingStudent { get; set; }

    public int MakerCompletedStudent { get; set; }

    public List<Activity> activities = new List<Activity>();

    public List<BadgeList> badges = new List<BadgeList>();

    public string displayText = "d-flex";

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await FetchMakerBadges();
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var profile = result.Result.Result;

        // get owned activities
        var ownedActivities = new List<Activity>();
        var ownedActivitiesRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs {
            IncludeActivityAddress = true,
            IncludeActivityDescription = true,
            IncludeActivityImages = true,
            IncludeAtivitySchedules = true,
            IsActive = true,
            IncludeStudents = true,
            IncludeCustomer = true
        }, token);
        if(ownedActivitiesRes.Succeeded && ownedActivitiesRes.Result != null && ownedActivitiesRes.Result.IsSuccess)
        {
            ownedActivities = ownedActivitiesRes.Result.Result.Select(a => {
                // map only required fields
                return new Activity {
                    ActivityId = a.ActivityId,
                    District = a.District,
                    City = a.City,
                    CityName = a.CityName,
                    Region = a.Region,
                    RegionName = a.RegionName,
                    Barangay = a.Barangay,
                    BarangayName = a.BarangayName,
                    Address1 = a.Address1,
                    Address2 = a.Address2,
                    ExperienceTypeId = a.ExperienceTypeId,
                    Description = a.Description,
                    IsPublished = a.IsPublished,
                    Price = a.Price,
                    Title = a.Title,
                    IsSetSession = a.IsSetSession,
                    SessionName = a.SessionName,
                    IsNew = a.IsNew,
                    OngoingStudents = a.OngoingStudents,
                    CompletedStudents = a.CompletedStudents,
                    Images = a.Images.Select(i => {
                        return new ActivityImage {
                            Id = i.Id,
                            ImageSrc = i.ImageSrc,
                            Name = i.Name
                        };
                    }).ToList(),
                    Owner = new CustomerProfile
                    {
                        IsVerified = a.Owner.IsVerified
                    },
                    ActivitySchedules = a.ActivitySchedules.Select(e =>
                    {
                        return new ActivitySchedule
                        {
                            Id = e.Id,
                            Name = e.Name,
                            PerUnit1 = e.PerUnit1,
                            PerUnit2 = e.PerUnit2,
                            Price = e.Price,
                            PriceUnit1 = e.PriceUnit1,
                            PriceUnit2 = e.PriceUnit2,
                            UnitPrice = e.UnitPrice
                        };
                    }).ToList(),
                };
            }).ToList();
        }

        // get family members information
        var familyMembers = new List<Models.Entities.FamilyMember>();
        var members = await accountApiHandler.GetFamilyMembers(token);

        if(members.Succeeded && members.Result != null && members.Succeeded)
        {
            familyMembers = members.Result.Result.Select(m => {
                return new Models.Entities.FamilyMember {
                    BirthMonth = m.BirthMonth,
                    BirthYear = m.BirthYear,
                    Gender = m.Gender,
                    Name = m.Name,
                    Id = m.Id
                };
            }).ToList();
        }

        // get enrolled activities
        var enrolledActivities = new List<Activity>();
        var enrolledRes = await activityApiHandler.GetEnrolledActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetEnrolledActivitiesArgs {
            IncludeActivityAddress = true,
            IncludeActivityImages = true,
            IncludeAtivitySchedules = true,
            IncludeStudents = true
        }, token);
        if(enrolledRes.Succeeded && enrolledRes.Result != null && enrolledRes.Result.IsSuccess)
        {
            enrolledActivities = enrolledRes.Result.Result.Select(a => {
                // map only required fields
                return new Activity {
                    ActivityId = a.ActivityId,
                    District = a.District,
                    City = a.City,
                    Address1 = a.Address1,
                    Address2 = a.Address2,
                    ExperienceTypeId = a.ExperienceTypeId,
                    Description = a.Description,
                    IsPublished = a.IsPublished,
                    Price = a.Price,
                    Title = a.Title,
                    IsSetSession = a.IsSetSession,
                    SessionName = a.SessionName,
                        OngoingStudents = a.OngoingStudents,
                        CompletedStudents = a.CompletedStudents,
                    Images = a.Images.Select(i => {
                        return new ActivityImage {
                            Id = i.Id,
                            ImageSrc = i.ImageSrc,
                            Name = i.Name
                        };
                    }).ToList(),
                    ActivitySchedules = a.ActivitySchedules.Select(s =>
                    {
                        return new ActivitySchedule
                        {
                            Id = s.Id,
                        };
                    }).ToList(),
                    Owner = a.Owner != null ? new CustomerProfile
                    {
                        // map only required fields
                        Id = a.Owner.Id,
                        Handler = a.Owner.Handler,
                    } : null
                };
            }).ToList();
        }
        Model = new Models.Customer.Profile {
            Token = token,
            CustomerProfile = new Models.Entities.CustomerProfile
            {
                About = profile.About,
                Birthdate = profile.Birthdate,
                Email = profile.Email,
                FirstName = profile.FirstName,
                LastName = profile.LastName,
                Id = profile.Id,
                IsMaker = profile.IsMaker,
                IsVerified = profile.IsVerified,
                IsOG = profile.IsOG,
                IsOfficial = profile.IsOfficial,
                ProfilePath = profile.ProfileImg,
                DateJoined = profile.DateJoined
            },
            FamilyMembers = familyMembers,
            OwnedActivities = ownedActivities,
            EnrolledActivities = enrolledActivities,
        };

        ImageSource = Model.CustomerProfile.ProfilePath;

        //Get Ongoing and completed enrollees
        var ActivityList = await activityApiHandler.GetMakerActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetMakerActivitiesArgs
            {
                CustomerId = Model.CustomerProfile.Id,
                IncludeStudents = true,
                IsActive = true,
            });
        if (ActivityList.Succeeded && ActivityList.Result != null && ActivityList.Result.IsSuccess)
        {
            if (ActivityList.Result.Result.Count() > 0)
            {
                activities = ActivityList.Result.Result.Select(r =>
                {
                    return new Activity
                        {
                            Id = r.ActivityId,
                            OngoingStudents = r.OngoingStudents,
                            CompletedStudents = r.CompletedStudents,
                        };
                }).ToList();
            }
        }
        MakerOngoingStudent = activities.Sum(x => x.OngoingStudents);
        MakerCompletedStudent = activities.Sum(x => x.CompletedStudents);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init", "Experience Details Page Loaded");
    }

    private void OnEditAboutClick()
    {
        isEditAbout = !isEditAbout;
        if(isEditAbout)
        {
            aboutLocalState = Model.CustomerProfile.About;
        }
        else 
        {
            aboutLocalState = string.Empty;
        }
    }

    private async Task SaveAboutClick()
    {
        if(isEditAbout)
        {
            var result = await accountApiHandler.UpdateProfileDetails(new Framework.ApiCommand.ApiCore.Account.Request.UpdateProfileDetailsArgs
            {
                About = aboutLocalState,
                Datebirth = Model.CustomerProfile.Birthdate
            }, Model.Token);

            if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                Model.CustomerProfile.About = string.IsNullOrEmpty(result.Result.Result.About) ? string.Empty : result.Result.Result.About;
            }
        }

        isEditAbout = false;
    }

    private void NavigateToGetVerified()
    {
        if(Model.CustomerProfile.IsMaker)
        {
            NavigationManager.NavigateTo("/customer/user-verification");
        }
        else 
        {
            NavigationManager.NavigateTo("/uploadGovermentId/");
        }
    }

    private void NavigateToUploadId()
    {
        NavigationManager.NavigateTo("/uploadGovermentId/");
    }

    private async Task FetchMakerBadges()
    {
        //Get Badges
        var badgeList = await dashboardApiHandler.GetAllBadge();
        if (badgeList.Succeeded && badgeList.Result != null && badgeList.Result.IsSuccess)
        {
            badges = badgeList.Result.Result.Select(b =>
            {
                return new BadgeList
                    {
                        Id = b.Id,
                        Name = b.Name,
                        Description = b.Description,
                        NumberOfStudent = b.NumberOfStudent,
                        NumberOfCompleted = b.NumberOfCompleted,
                        NumberOfReviews = b.NumberOfReviews,
                        ImgScr = b.ImgScr
                    };
            }).ToList();
        }
    }
    private async Task CopyToClipboard()
    {
        await Task.Run(() => module.InvokeVoidAsync("copyToClipboard", NavigationManager.Uri));
    }
}





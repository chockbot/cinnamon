@*Created By: R. Namoro
  Last Update: 07/28/2023*@

@page "/Explore/{Identifier}"
@inject IJSRuntime jsRuntime
@using System.Security.Claims
@using Cinnamon.Web.Components
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components.Pages;
@using Newtonsoft.Json;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject NavigationManager NavigationManager
@inject IChatApiHandler chatApiHandler;
@using Microsoft.EntityFrameworkCore
@using Cinnamon.Framework.Helpers
@using Cinnamon.Web.Modules.Services
@using Cinnamon.Web.Components.Common;
@inject INotificationService NotificationService;

<PageTitle>@(activity == null ? "Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH" : $"Cinnamon Activity - {activity.Title} | CinnamonPH")</PageTitle>
    <SeoMeta Title="@(activity?.Title ?? string.Empty)"
         Description="@(activity?.Description ?? string.Empty)"
         Subject="@(activity?.Title ?? string.Empty)"
         Url='@($"/explore/{Identifier}")'
         Image="@(activity?.Images?[0]?.ImageSrc ?? string.Empty)"
         Keywords='new List<string>{activity?.ExperienceCategory ?? string.Empty}' />

@if (Model.Customer != null)
{
    @if(activity is not null && activity.Images.Count > 0)
    {
        <div class="position-relative detail-sm mb-2">
            <img class="w-100" src="@activity.Images.First().ImageSrc" alt="cover-photo">
            <div style="bottom: 20px; right: 20px;" @onclick="NavigateToGallery"
                class="prevent-select px-3 py-1 cursor-pointer position-absolute border-radius-10 color-black-100 font-14 bg-white-100">
                Gallery
            </div>
        </div>
    }
    <Container class="xp-details-wrapper">
        <div id="alertContainer" class="alertContainer">
            <div id="alertMessage" class="alertMessage">Copied to clipboard!</div>
        </div>
        <Div ElementId="#b-header-animate" class="activity-details-page-wrapper">
            <Animate Anchor="#b-header-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                <div>
                    @*Details Header Desktop*@
                    <div class="details-header mt-5">
                        @*Experience Title*@
                        <div class="d-flex activity-title">
                            <label class="fw-bold mb-3 col-lg-12 col-md-12 title-text"> @activity.Title </label>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            @*Experience Type*@
                            <div class="d-flex activity-experiencetype">
                                <label class="col-lg-12 col-md-12">
                                    @if (activity.ExperienceTypeId == 1)
                                    {
                                        <img class="img-thumbnail border-0" src="images/activity-summary/location.png" />
                                    }
                                    else
                                    {
                                        <img class="img-thumbnail border-0" src="images/activity-summary/laptop-icon.png" />
                                    }
                                    <span style="font-size: 14px;" class="bg-black-100 color-white-100 rounded-pill px-3 py-1">@experience.Name</span>
                                </label>
                            </div>
                            <label class="share-link">
                                <label class="active-badge">
                                    @if (CustomerModel.CustomerProfile != null)
                                    {
                                        activity.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == activity.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                        if (activity.IsFavorite != false)
                                        {
                                            <label class="active-badge">
                                                @if (activity.IsFavorite == true)
                                                {
                                                    <span class="favorite-text">Added To Favorites</span>
                                                }
                                                else
                                                {
                                                    <span class="favorite-text">Add To Favorites</span>
                                                }
                                                <button class="btn btn-copy" @onclick="() =>AddToFavorites(activity)">
                                                    <img src="@(activity.IsFavorite ? "images/favorites/heart-selected.png" : "images/favorites/heart-default.png")">
                                                </button>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="active-badge">
                                                <span class="favorite-text">Add To Favorites</span>
                                                <button class="btn btn-copy" @onclick="() =>CreateFavorite(activity)">
                                                    <img src="images/favorites/heart-default.png">
                                                </button>
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        <label class="active-badge">
                                            <span class="favorite-text">Add To Favorites</span>
                                            <button class="btn btn-copy" @onclick="() =>signinModal.Show()">
                                                <img src="images/favorites/heart-default.png">
                                            </button>
                                        </label>
                                    }
                                </label>
                                <label class="active-badge-share">
                                    <span class="favorite-text">Share this Activity</span>
                                    <button class="btn btn-copy" @onclick="() => CopyToClipboard()">
                                        <img src="images/copytoclipboard.png">
                                    </button>
                                </label>
                            </label>
                        </div>
                    </div>
                    @*Activity Images*@
                    <div class="activity-image-container text-center d-flex flex-column" style="border-radius:10px;">
                        <div class="images-gallery order-lg-last order-md-last order-sm-first d-flex gap-3">
                            
                            @if (activity.Images.Count < 5)
                            {
                                <div class="detail-md">
                                    <div class="gallery position-relative">
                                        <figure class="gallery__item gallery__item--1">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(0).ImageSrc" />
                                        </figure>
                                        <figure class="gallery__item gallery__item--2">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(1).ImageSrc" />
                                        </figure>
                                        <figure class="gallery__item gallery__item--3">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(2).ImageSrc" />
                                        </figure>
                                        <div style="bottom: 35px; left: 20px;" @onclick="NavigateToGallery"
                                            class="prevent-select px-4 py-2 cursor-pointer position-absolute border-radius-10 color-black-100 font-16 bg-white-100">
                                            Gallery
                                        </div>
                                    </div>
                                </div>
                            }
                            else 
                            {
                                <div class="grid-gallery detail-md shadow position-relative">
                                    <div class="grid-gallery-item grid-gallery-item-1">
                                        <figure>
                                            <img src="@activity.Images.ElementAt(0).ImageSrc" alt="cover-photo">
                                        </figure>
                                    </div>
                                    <div class="grid-gallery-item grid-gallery-item-2">
                                        <figure>
                                            <img src="@activity.Images.ElementAt(1).ImageSrc" alt="supporting-photo">
                                        </figure>
                                    </div>
                                    <div class="grid-gallery-item grid-gallery-item-3">
                                        <figure>
                                            <img src="@activity.Images.ElementAt(2).ImageSrc" alt="supporting-photo">
                                        </figure>
                                    </div>
                                    <div class="grid-gallery-item grid-gallery-item-4">
                                        <figure>
                                            <img src="@activity.Images.ElementAt(3).ImageSrc" alt="supporting-photo">
                                        </figure>
                                    </div>
                                    <div class="grid-gallery-item grid-gallery-item-5">
                                        <figure>
                                            <img src="@activity.Images.ElementAt(4).ImageSrc" alt="supporting-photo">
                                        </figure>
                                    </div>
                                    <div style="bottom: 20px; left: 20px;" @onclick="NavigateToGallery"
                                        class="prevent-select px-4 py-2 cursor-pointer position-absolute border-radius-10 color-black-100 font-16 bg-white-100">
                                        Gallery
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    @*Details Header Mobile*@
                    <div class="details-header-small">
                        @*Experience Title*@
                        <div class="d-flex activity-title-small">
                            <label class="fw-bold mb-3 col-12 title-text-small"> @activity.Title </label>
                        </div>
                        @*Experience Type*@
                        <div class="d-flex activity-experiencetype-small justify-content-between">
                            <label class="mb-3">
                                @if (activity.ExperienceTypeId == 1)
                                {
                                    <img class="img-thumbnail-small border-0" src="images/activity-summary/location.png" />
                                }
                                else
                                {
                                    <img class="img-thumbnail-small border-0" src="images/activity-summary/laptop-icon.png" />
                                }
                                <span class="experience-name-small ms-2">@experience.Name</span>
                            </label>
                            <label class="share-link-small">
                                <label class="active-badge">
                                    @if (CustomerModel.CustomerProfile != null)
                                    {
                                        activity.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == activity.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                        if (activity.IsFavorite != false)
                                        {
                                            <label class="favorite-small">
                                                <img style="width: 30px; height: auto;" @onclick="() =>AddToFavorites(activity)" src="@(activity.IsFavorite ? "images/favorites/heart-selected.png" : "images/favorites/heart-default.png")">
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="favorite-small">
                                                <img style="width: 30px; height: auto;" @onclick="() =>CreateFavorite(activity)" src="images/favorites/heart-default.png">
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        <label class="favorite-small">
                                            <img style="width: 30px; height: auto;" @onclick="() =>signinModal.Show()" src="images/favorites/heart-default.png">
                                        </label>
                                    }
                                </label>
                                <label class="copy-link-small ms-2">
                                    <img style="width: 30px; height: auto;" @onclick="() => CopyToClipboard()" src="images/copytoclipboard.png">
                                </label>
                            </label>
                        </div>
                        @*Ongoing Enrolees*@
                        <div class="d-block enrolles-container">
                            <label class="col-12 justify-content-start mb-1 ongoing-students-small">
                                @if (activity.OngoingStudents != 0)
                                {
                                    <label class="ongoing-badge-small mb-3">
                                        <span class="pulse-small"></span>
                                        <span class="active-text-small">Ongoing Enrollees</span>
                                        <span class="active-tag-label-small">@activity.OngoingStudents</span>
                                    </label>
                                }
                                @if (activity.CompletedStudents != 0)
                                {
                                    <label class="completed-badge-small mb-3">
                                        <span class="pulse-small-complete"></span>
                                        <span class="active-text-small">Completed Enrollees</span>
                                        <span class="active-tag-label-complete-small">@activity.CompletedStudents</span>
                                    </label>
                                }
                            </label>
                        </div>
                    </div>
                    @* customer details and enrollee count *@
                    @if(customerDetail is not null && customerDetail.IsMaker)
                    {
                        <Row class="mx-0">
                            <Column ColumnSize="ColumnSize.Is12.Is9.OnDesktop" class="m-bg-white-200">
                                <div class="d-flex">
                                    <div class="maker-pic">
                                        <img class="rounded-2 rounded-circle m-3" src="@customerDetail.ProfilePath" />
                                    </div>
                                    <div class="m-2 maker-profile-details">
                                        <span class="xp-by">Experience by</span>
                                        <span class="text-capitalize maker-name">@customerDetail.FirstName @customerDetail.LastName</span>
                                        <a class="view-profile" href="/maker/profile/@(activity.Owner != null && !string.IsNullOrEmpty(activity.Owner.Handler) ? activity.Owner.Handler : activity.CreatedBy.ToString() )" target="_blank">View Profile</a>
                                    </div>
                                    <div class="profile-badges">
                                        @if (customerDetail.IsVerified == 2)
                                        {
                                            <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Class="badges">
                                                <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                            </Tooltip>
                                        }
                                        @if (customerDetail.IsOG == true)
                                        {
                                            <Tooltip Multiline=true Text="For being part of the alpha and beta testing.">
                                                <img class="verified-logo" src="images/Badges/OG.svg" />
                                            </Tooltip>
                                            @*<img class="verified-logo" src="images/Badges/OG.svg" data-toggle="tooltip" data-placement="top" title="For being part of the alpha and beta testing." />*@
                                        }
                                        @if (customerDetail.IsOfficial == true)
                                        {
                                            <Tooltip Multiline=true Text="Legitimate experience provider in the platform.">
                                                <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                            </Tooltip>
                                            @*<img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" data-toggle="tooltip" data-placement="top" title="Legitimate experience provider in the platform." />*@
                                        }
                                        @if (MakerCompletedStudent >= 10)
                                        {
                                            var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@rare.Description">
                                                <img class="verified-logo" src="@rare.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@rare.ImgScr" data-toggle="tooltip" data-placement="top" title="@rare.Description" />*@
                                        }
                                        @if (MakerCompletedStudent >= 25)
                                        {
                                            var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@epic.Description">
                                                <img class="verified-logo" src="@epic.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@epic.ImgScr" data-toggle="tooltip" data-placement="top" title="@epic.Description" />*@
                                        }
                                        @if (MakerCompletedStudent >= 100)
                                        {
                                            var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@legendary.Description">
                                                <img class="verified-logo" src="@legendary.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@legendary.ImgScr" data-toggle="tooltip" data-placement="top" title="@legendary.Description" />*@
                                        }

                                    </div>
                                </div>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop" class="m-d-none">
                                <div class="d-flex flex-column h-100 justify-content-center">
                                    @if (activity is not null && activity.OngoingStudents > 0)
                                    {
                                        <div class="d-flex align-items-center justify-content-between active-badge mb-2">
                                            <div class="d-flex align-items-center">
                                                <span class="pulse mt-0"></span>
                                                <span class="ms-3 font-20 color-grey-100">Ongoing Enrollees</span>
                                            </div>
                                            <div>
                                                <span class="font-20 color-grey-100">@activity.OngoingStudents</span>
                                            </div>
                                        </div>
                                    }
                                    @if (activity is not null && activity.CompletedStudents > 0)
                                    {
                                        <div class="d-flex align-items-center justify-content-between active-badge">
                                            <div class="d-flex align-items-center">
                                                <span class="pulse-complete mt-0"></span>
                                                <span class="ms-3 font-20 color-grey-100">Completed Enrollees</span>
                                            </div>
                                            <div>
                                                <span class="font-20 color-grey-100">@activity.CompletedStudents</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </Column>
                        </Row>
                        <Divider />
                    }
                </div>
            </Animate>
        </Div>
        <Div>
            <Row HorizontalGutter="30">
                <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop.Is8.OnTablet">
                    @*Activity Details*@
                    <div class="description-label">
                        <p class="fw-bold mb-3 detail-label">About</p>
                        @if (String.IsNullOrEmpty(activity.Description))
                        {
                            <label class="fw-bold mb-3 detail-label m-font-16" style="font-size:1.4rem">@Resources.App.detailDescription1</label>
                            <p>
                                @activity.Description
                            </p>
                        }
                        else
                        {
                            <p class="activity-details-text">
                                @(
                                    (MarkupString)activity.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>")
                                    )
                            </p>
                        }
                        @*Display Video Link*@
                        @if(activity.VideoLink.Contains("youtu.be") || activity.VideoLink.Contains("youtube"))
                        {
                             <div class="cinnamon-video mt-3">
                                <iframe src="@ConvertToEmbedSrc(activity.VideoLink, VideoPlatform.YouTube)" class="video-link"></iframe>
                            </div>
                        }
                        else if(activity.VideoLink.Contains("vimeo"))
                        {
                             <div class="cinnamon-video mt-3">
                                <iframe src="@ConvertToEmbedSrc(activity.VideoLink, VideoPlatform.Vimeo)" class="video-link"></iframe>
                            </div>
                        }
                        else
                        {
                            <div></div>
                        }
                    </div>
                    
                    @*Experience Schedule*@
                    @if(activity is not null && activity.ExperienceCreationType != Framework.Enums.Enums.ExperienceCreationType.OneTimeEvents && !activity.IsComingSoon)
                    {
                        <div class="schedule-desktop">
                            <hr />
                            <label class="fw-bold mb-3 detail-label">Schedule of @(activity.ActivitySchedules.Count > 1 ? "activities" : "activity")</label>
                            @if (activity.ScheduleIndicator == "selection" || activity.ActivitySchedules.Count > 0)
                            {
                                var activeSchedule = activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).ToList();
                                if (activeSchedule.Count > 0)
                                {
                                    <div class="d-block mb-2">
                                        @for (int x = 0; x < activeSchedule.Count; x++)
                                        {
                                            var schedule = activeSchedule.ElementAt(x);
                                            @if (x <= 2)
                                            {
                                                <div class="schedule-detail w-100 rounded-5">
                                                    <div class="schedule-header d-flex" style="background-color: @(SelectedScheduleId != schedule.Id ? changeColor : "#F3F6FC");border-top-left-radius:10px;border-top-right-radius:10px">
                                                        <div class="schedule-title col-lg-10 clo-md-9 col-sm-9 col-xs-9 col-9 justify-content-start">
                                                            <p>@activeSchedule.ElementAt(x).Name</p>
                                                        </div>
                                                        <a class="form-check col-lg-2 col-md-3 justify-content-center" @onclick="() => SelectSchedule(schedule.Id)">
                                                            <input checked="@(SelectedScheduleId == schedule.Id)" class="form-check-input" 
                                                                value="@schedule.Id" type="radio" name="schedule" id="@schedule.Id">

                                                                @if(SelectedScheduleId == schedule.Id)
                                                                {
                                                                    <label class="form-check-label" for="@schedule.Id">
                                                                        Selected
                                                                    </label>
                                                                }
                                                                else
                                                                {
                                                                    <label class="form-check-label" for="@schedule.Id">
                                                                        Select
                                                                    </label>
                                                                }
                                                        </a>
                                                        <div class="col-sm-3 col-xs-3 col-3 justify-content-center schedule-price-header">
                                                            <p class="font-18">₱ @schedule.LongPrice</p>
                                                        </div>
                                                    </div>
                                                    <hr>
                                                    <div class="schedule-body">
                                                        <div class="col-lg-10 col-md-9 col-sm-12 PES-details">
                                                            @if(x == 0)
                                                            {
                                                                <div class="col-lg-12 col-md-12 col-sm-12 col-12 justify-content-end recommended-mobile">
                                                                    <p class="recommended">Highly Recommended!</p>
                                                                </div>
                                                            }
                                                            <div class="PE-details">
                                                                <div class="col-lg-6 col-md-6 col-sm-12 col-12 price-details">
                                                                    <div class="d-flex price-details-title">
                                                                        <img class="img-price" src="images/schedule-icons/price-icon.png"/>
                                                                        <p class="font-14">Price Details:</p>
                                                                    </div>
                                                                    <p class="font-16-d">₱ @activeSchedule.ElementAt(x).LongPrice / @activeSchedule.ElementAt(x).PerUnit1 @activeSchedule.ElementAt(x).PriceUnit1 / @activeSchedule.ElementAt(x).PerUnit2 @activeSchedule.ElementAt(x).PriceUnit2</p>
                                                                </div>
                                                                @if (schedule.IsSetSession == true && x <= 2)
                                                                {
                                                                    <div class="col-lg-6 col-md-6 col-sm-12 col-12 expiration-details">
                                                                        <div class="d-flex expiration-details-title">
                                                                            <img class="img-expiration" src="images/schedule-icons/expiration-icon.png" />
                                                                            <p class="font-14">Expiration:</p>
                                                                        </div>
                                                                        <p class="font-16-d">Consume in - @schedule.SessionName</p>
                                                                        <div class="cut-off-details">
                                                                            @switch (schedule.HasExpiration)
                                                                            {
                                                                                case 1:
                                                                                    DateTime frequency = ExpirationData.CalculateFrequency(schedule);
                                                                                    string ordinal = ExpirationData.GetOrdinal(frequency.Day);
                                                                                    <small class="form-text sub-details">
                                                                                        @ExpirationData.GetExpirationText(schedule.SessionName, frequency, ordinal)
                                                                                    </small>
                                                                                    break;
                                                                                case 2:
                                                                                    <small class="form-text sub-details">
                                                                                        Session/s must be consumed in @schedule.SessionName.ToLower(), starting from first attendance.
                                                                                    </small>
                                                                                    break;
                                                                                default:
                                                                                    break;
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="S-details col-lg-12 col-md-12 col-sm-12 col-12">
                                                                <div class="d-flex schedule-details-title">
                                                                    <img class="img-schedule" src="images/schedule-icons/calendar-icon.png" />
                                                                    <p class="font-14">Schedule:</p>
                                                                </div>
                                                                <p class="font-16-d">@activeSchedule.ElementAt(x).DateTime</p>
                                                                @if (x == 0)
                                                                {
                                                                    <div class="col-lg-12 col-md-12 col-sm-12 col-12 justify-content-end recommended-desktop">
                                                                        <p class="recommended">Highly Recommended!</p>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-2 col-md-3 col-sm-12 justify-content-center schedule-price">
                                                            <p class="font-18">₱ @activeSchedule.ElementAt(x).LongPrice</p>
                                                        </div>
                                                        <a class="col-sm-12 col-xs-12 col-12 justify-content-center form-check-mobile" @onclick="() => SelectSchedule(schedule.Id)">
                                                            <input checked="@(SelectedScheduleId == schedule.Id)" class="form-check-input"
                                                                value="@schedule.Id" type="radio" name="schedule-1" id="@schedule.Id-1">

                                                            @if (SelectedScheduleId == schedule.Id)
                                                            {
                                                                <label class="form-check-label" for="@schedule.Id-1">
                                                                    Selected
                                                                </label>
                                                            }
                                                            else
                                                            {
                                                                <label class="form-check-label" for="@schedule.Id-1">
                                                                    Select
                                                                </label>
                                                            }
                                                        </a>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                break;
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-row gap-3 mb-2 overflow-auto">
                                        <p>No schedule available yet, mark as favorite or come back soon for the next updated schedule!</p>
                                    </div>
                                }
                            }
                            @if (activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).Count() >= 4)
                            {
                                <div class="d-flex col-12-lg justify-content-lg-end col-md-12 justify-content-md-end col-12 justify-content-center">
                                    <button class="btn-show shadow-sm border-0 p-2 rounded" @onclick="()=>DetailsModalSched.Open()">
                                        See More Schedule
                                    </button>
                                </div>
                            }
                            <br/>
                            @if(activity.AddOns.Count != 0)
                            {
                                <label class="fw-bold mb-3 detail-label">@(activity.AddOns.Count > 1 ? "Add-ons" : "Add-on")</label>
                                @foreach (var addOn in activity.AddOns.OrderBy(a => a.Order).ToList())
                                {
                                    <div class="add-ons-section">
                                        <div class="prevent-select">
                                            <div class="addon-name">@addOn.Name</div>
                                            <div @onclick = "() =>SubtractAddOns(addOn)" class="addon-operation">
                                               -
                                            </div>
                                            <div class="addon-count">
                                                @addOn.AddOnCount
                                            </div>
                                            <div @onclick="() =>AddAddOns(addOn)" class="addon-operation">
                                                +
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }


    @* commented first for migration *@
    <DetailsSchedulesModal @ref="DetailsModalSched" OnChooseSelected="ModalSelectedChanged"
        ScheduleModel="activity.ActivitySchedules.Where(s => s.IsActiveSchedule).ToList()" ActivityModel="activity"></DetailsSchedulesModal>

    <MultipleReviewModal @ref="modRef" SelectedValue="SelectedValue" AverageRating="AverageRating" 
        CustomerProfiles="customerProfiles" ReviewCount="ReviewCount" MakerActivity="activity" Activities="MakerActivity"/>

    <ModalLogin @ref="signinModal" ReturnUrl="@signInReturnUrl" />
}
@code {
    IJSObjectReference module;
    IJSObjectReference moduleRating;
    private MultipleReviewModal modRef;
    private ModalLogin signinModal;
    [Parameter]
    public string Identifier { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    public Profile CustomerModel = new Profile();
    public DetailActivityModel Model = new DetailActivityModel();
    public Activity activity = new Activity();
    public List<Activity> activities = new List<Activity>();
    public List<Activity> MakerActivity = new List<Activity>();
    public CustomerProfile customerDetail = new CustomerProfile();
    public List<CustomerProfile> customerProfiles = new List<CustomerProfile>();
    public CustomerProfile reviweeProfile = new CustomerProfile();
    public List<ExperienceType> experienceTypes = new List<ExperienceType>();
    public ExperienceType experience = new ExperienceType();
    public List<Students> enrolledStudents = new List<Students>();
    public List<BadgeList> badges = new List<BadgeList>();
    public List<Reviews> activityReviews = new List<Reviews>();
    public List<Reviews> top3Reviews = new List<Reviews>();
    public List<ActivityScheduleTime> activityScheduleTimes = new List<ActivityScheduleTime>();
    private IAnimation selectedAnimation = Animations.FadeIn;
    private DetailsSchedulesModal DetailsModalSched { get; set; }
    public int SelectedValue { get; set; } = 0;
    public double AverageRating { get; set; } = 0;
    public int ReviewCount { get; set; } = 0;
    public int OngoingStudents { get; set; }
    public int CompletedStudents { get; set; }
    public int MakerOngoingStudennt { get; set; }
    public int MakerCompletedStudent { get; set; }
    private const string NOTHING_PROVIDED = "--NOTHING PROVIDED--";
    public string changeColor = "none";
    public bool IsChecked = false;

    private int SelectedScheduleId { get; set; } = 0;
    private int EnrolleeCount { get; set; } = 0;
    private bool isShowErrorMessage;
    private string signInReturnUrl = string.Empty;
    private bool isAuthenticated = false;
    private bool isOpenMobileCalculator = false;
    private DateTime SelectedDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if(user != null && user.Identity != null)
            {
                isAuthenticated = user.Identity.IsAuthenticated;
            }

            bool isIdentifierInt = int.TryParse(Identifier, out int intResult);
            //Get Activity by Id
            var ActivityListData = isIdentifierInt ? await activityApiHandler.GetActivity(intResult, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
                {
                    IncludeActivityAddress = true,
                    IncludeActivityDescription = true,
                    IncludeActivityImages = true,
                    IncludeAtivitySchedules = true,
                    IncludeCustomer = true
                }) :
                await activityApiHandler.GetActivityByHandler(Identifier.Trim(), new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
                    {
                        IncludeActivityAddress = true,
                        IncludeActivityDescription = true,
                        IncludeActivityImages = true,
                        IncludeAtivitySchedules = true,
                        IncludeCustomer = true
                    });

            if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
            {
                var result = ActivityListData.Result.Result;
                activity = new Activity
                    {
                        Id = result.ActivityId,
                        ActivityId = result.ActivityId,
                        ExperienceTypeId = result.ExperienceTypeId,
                        ExperienceCategoryId = result.ExperienceCategoryId,
                        SubCategoryId = result.SubCategoryId,
                        Title = result.Title,
                        Description = result.Description,
                        Price = result.Price,
                        ScheduleIndicator = result.ScheduleIndicator,
                        Remarks = result.Remarks,
                        IsPublished = result.IsPublished,
                        Address1 = result.Address1,
                        Address2 = result.Address2,
                        District = result.District,
                        City = result.City,
                        CityName = result.CityName,
                        Subdivision = result.Subdivision,
                        Barangay = result.Barangay,
                        BarangayName = result.BarangayName,
                        Region = result.Region,
                        RegionName = result.RegionName,
                        PostalCode = result.PostalCode,
                        SpecificsYouWillProvide = result.SpecificsYouWillProvide,
                        CustomerBringWithThem = result.CustomerBringWithThem,
                        AdditionalRequirements = result.AdditionalRequirements,
                        ActivityLevel = result.ActivityLevel,
                        SkillLevel = result.SkillLevel,
                        MinimumAge = result.MinimumAge,
                        CanAdultsJoin = result.CanAdultsJoin,
                        CreatedBy = result.CreatedBy,
                        MapDetails = result.MapDetails,
                        PinnedLocation = result.PinnedLocation,
                        ExperienceCreationType = result.ExperienceCreationType,
                        ActivitySchedules = result.ActivitySchedules.Select(e =>
                        {
                            return new ActivitySchedule
                            {
                                Id = e.Id,
                                Name = e.Name,
                                DateTime = e.DateTime,
                                PerUnit1 = e.PerUnit1,
                                PerUnit2 = e.PerUnit2,
                                Price = e.Price,
                                PriceUnit1 = e.PriceUnit1,
                                PriceUnit2 = e.PriceUnit2,
                                UnitPrice = e.UnitPrice,
                                IsActiveSchedule = e.IsActiveSchedule,
                                IsSetSession = e.IsSetSession,
                                SessionName = e.SessionName,
                                HasExpiration = e.HasExpiration,
                                StartDate = e.StartDate,
                                PriceType = e.PriceType
                            };
                        }).ToList(),
                        Images = result.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                        Owner = result.Owner != null ? new CustomerProfile
                        {
                            // map only required fields
                            Id = result.Owner.Id,
                            Handler = result.Owner.Handler
                        } : null
                    };
                MakerActivity.Add(activity);
            }

            // Get experience types
            var experienceType = await activityApiHandler.GetExperienceTypes();
            if (experienceType.Succeeded && experienceType.Result != null && experienceType.Result.IsSuccess)
            {
                experienceTypes = experienceType.Result.Result.Select(i =>
                {
                    return new ExperienceType
                        {
                            Id = i.Id,
                            Name = i.Name
                        };
                }).ToList();
            }

            //Get Experience Type
            experience = experienceTypes.Where(a => a.Id == activity.ExperienceTypeId).ElementAt(0);

            //Get Customer
            var customer = await accountApiHandler.GetCustomerById(activity.CreatedBy);
            if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
            {
                var args = customer.Result.Result;
                customerDetail = new CustomerProfile
                    {
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        ProfilePath = args.ProfileImg,
                        IsVerified = args.IsVerified,
                        IsOG = args.IsOG,
                        IsOfficial = args.IsOfficial
                    };
            }
            Model = new DetailActivityModel
                {
                    Activity = activity,
                    ExperienceTypes = experienceTypes,
                    Customer = customerDetail
                };

            //Get Ongoing and Completed Students
            var students = await ongoingApiHandler.GetEnrolledStudents(ActivityListData.Result.Result.ActivityId);
            if (students.Succeeded && students.Result != null && students.Result.IsSuccess)
            {
                enrolledStudents = students.Result.Result.Select(i =>
                {
                    return new Students
                        {
                            ActivityId = i.ActivityId,
                            Id = i.Id,
                            Name = i.Name,
                            NumberOfSessions = i.NumberOfSessions,
                            SessionsAttended = i.SessionsAttended,
                            ScheduleId = i.ScheduleId
                        };
                }).ToList();
            }
            CompletedStudents = enrolledStudents.Where(a => a.SessionsAttended >= a.NumberOfSessions).Count();
            OngoingStudents = enrolledStudents.Where(a => a.SessionsAttended < a.NumberOfSessions).Count();

            //Get Badges
            var badgeList = await dashboardApiHandler.GetAllBadge();
            if (badgeList.Succeeded && badgeList.Result != null && badgeList.Result.IsSuccess)
            {
                badges = badgeList.Result.Result.Select(b =>
                {
                    return new BadgeList
                        {
                            Id = b.Id,
                            Name = b.Name,
                            Description = b.Description,
                            NumberOfStudent = b.NumberOfStudent,
                            NumberOfCompleted = b.NumberOfCompleted,
                            NumberOfReviews = b.NumberOfReviews,
                            ImgScr = b.ImgScr
                        };
                }).ToList();
            }

            //Get Maker Activity
            var ActivityList = await activityApiHandler.GetMakerActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetMakerActivitiesArgs
                {
                    CustomerId = activity.CreatedBy,
                    IncludeStudents = true,
                    IsActive = true,
                });
            if (ActivityList.Succeeded && ActivityList.Result != null && ActivityList.Result.IsSuccess)
            {
                if (ActivityList.Result.Result.Count() > 0)
                {
                    activities = ActivityList.Result.Result.Select(r =>
                    {
                        return new Activity
                            {
                                Id = r.ActivityId,
                                OngoingStudents = r.OngoingStudents,
                                CompletedStudents = r.CompletedStudents,
                            };
                    }).ToList();
                }
            }
            MakerOngoingStudennt = activities.Sum(x => x.OngoingStudents);
            MakerCompletedStudent = activities.Sum(x => x.CompletedStudents);

            //Get Reviews of the Activity
            var reviewsResult = await ongoingApiHandler.GetReviewsByActivityId(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetReviewsByActivityIdArgs
                {
                    ActivityId = ActivityListData.Result.Result.ActivityId
                });
            if (reviewsResult.Succeeded && reviewsResult.Result != null && reviewsResult.Result.IsSuccess)
            {
                activityReviews = reviewsResult.Result.Result.Select(a =>
                {
                    return new Reviews
                        {
                            Id = a.Id,
                            CustomerId = a.CustomerId,
                            MakerId = a.MakerId,
                            ActivityId = a.ActivityId,
                            ScheduleId = a.ScheduleId,
                            StudentId = a.StudentId,
                            Review = a.Review,
                            Rating = a.Rating,
                            ReviewDate = a.ReviewDate
                        };
                }).OrderByDescending(a => a.ReviewDate).ToList();
            }
            if (activityReviews.Count != 0)
            {
                double SumOfRating = activityReviews.Sum(a => a.Rating);
                double numberOfRatee = activityReviews.Count;
                AverageRating = (double)SumOfRating / numberOfRatee;
                SelectedValue = (int)Math.Round(AverageRating);
                top3Reviews = activityReviews.Take(3).OrderByDescending(a => a.ReviewDate).ToList();
                ReviewCount = activityReviews.Count;
            }

            //Get Customer Details
            foreach (var item in activityReviews.GroupBy(a=> a.CustomerId).Select(s=> s.First()).ToList())
            {
                var profileResult = await accountApiHandler.GetCustomerById(item.CustomerId);
                if (profileResult.Succeeded && profileResult.Result != null && profileResult.Result.IsSuccess)
                {
                    var result = profileResult.Result.Result;
                    reviweeProfile = new CustomerProfile
                        {
                            Id = result.Id,
                            FirstName = result.FirstName,
                            LastName = result.LastName,
                            ProfilePath = result.ProfileImg
                        };
                    customerProfiles.Add(reviweeProfile);
                }
            }
        }
        catch (Exception e)
        {
            NavigationManager.NavigateTo("/page-not-found");
            throw e;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GetFavorites();
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            moduleRating = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/StarRating.js");
            await Task.Run(() => moduleRating.InvokeVoidAsync("generateStarRating", AverageRating));
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Details Page Loaded");
            await InitializeCarouselSwipe();
        }
        else
        {
            await GetFavorites();
            await InitializeCarouselSwipe();
            await Task.Run(() => moduleRating.InvokeVoidAsync("generateStarRating", AverageRating));
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.activityDetails.init");
    }
    private async Task InitializeCarouselSwipe()
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.activity.carouselSwipe.init");
    }
    private async Task CopyToClipboard()
    {
        await Task.Run(() => module.InvokeVoidAsync("copyToClipboard", NavigationManager.Uri));
    }
    private async Task GetFavorites()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };
            }
        }

        if (CustomerModel.CustomerProfile != null)
        {
            var customerFavorites = await activityApiHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs
                {
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
            if (customerFavorites.Succeeded && customerFavorites.Result != null && customerFavorites.Result.IsSuccess)
            {
                CustomerModel.Favorites = customerFavorites.Result.Result.Select(i =>
                {
                    return new Favorite
                        {
                            ActivityId = i.ActivityId,
                            CustomerId = i.CustomerId,
                            IsFavorite = true
                        };
                }).ToList();
            }
        }
    }

    private async Task AddToFavorites(Activity activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        if (activity.IsFavorite)
        {
            //Add to Favorites
            var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        else
        {
            //Delete to Favorites
            var createFavorite = await activityApiHandler.RemoveFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.RemoveFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        await GetFavorites();
    }

    private async Task CreateFavorite(Activity activity)
    {
        //Add to Favorites
        var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
            {
                ActivityId = activity.ActivityId,
                CustomerId = CustomerModel.CustomerProfile.Id
            }, CustomerModel.Token);
        await GetFavorites();

    }
    private void CheckboxChanged(bool val)
    {
    }

    private Task SubtractEnrollee()
    {
        if (EnrolleeCount > 0) EnrolleeCount--;
        else EnrolleeCount = 0;
        return Task.CompletedTask;
    }

    private Task AddEnrollee()
    {
        EnrolleeCount++;
        return Task.CompletedTask;
    }

    private decimal PricePerHead
    {
        get
        {
            var schedule = activity.ActivitySchedules.FirstOrDefault(s => s.Id == SelectedScheduleId);
            if (schedule == null) return 0;

            return schedule.Price;
        }
    }

    private decimal PriceSubTotal
    {
        get 
        {
            return PricePerHead * EnrolleeCount;
        }
    }


    private decimal ServiceFee 
    {
        get 
        {
            return 0;
        }
    }

    private decimal HandlingFee 
    {
        get 
        {
            if (PriceSubTotal <= 0) return 0;
            return 39m;
        }
    }

    private decimal TotalPayment 
    {
        get 
        {
            return PriceSubTotal + ServiceFee + HandlingFee;
        }
    }

    private async Task ProceedToPayment()
    {
        if(SelectedScheduleId > 0)
        {
            var paymentUrl = $"/Payment/{activity.ActivityId}/{SelectedScheduleId}/?enrollees={EnrolleeCount}";
            if(isAuthenticated)
            {
                NavigationManager.NavigateTo(paymentUrl);
            }
            else 
            {
                signInReturnUrl = paymentUrl;
                await signinModal.Show();
            }
        }
        else 
        {
            isShowErrorMessage = true;
        }
    }

    private string GetSelectedActivityName
    {
        get
        {
            var schedule = activity.ActivitySchedules.FirstOrDefault(s => s.Id == SelectedScheduleId);
            if(schedule != null)
            {
                return schedule.Name;
            }

            return "Please select activity schedule";            
        }
    }

    private Task ModalSelectedChanged(int selectedId)
    {
        SelectedScheduleId = selectedId;
        return Task.CompletedTask;
    }

    private async Task DateHasChanged(DateTime? dateTime)
    {
        var result = await activityApiHandler.GetActivityScheduleTimes(new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityScheduleTimesArgs
        {
            ActivityScheduleId = SelectedScheduleId,
            DayOfWeek = (int)dateTime.GetValueOrDefault().DayOfWeek,
            ScheduleDate = dateTime.GetValueOrDefault()
        });

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            activityScheduleTimes = result.Result.Result.Select(a => new ActivityScheduleTime
            {
                ActivityScheduleTimeId = a.ActivityScheduleTimeId,
                DayOfWeek = a.DayOfWeek,
                StartTime = a.StartTime,
                EndTime = a.EndTime,
                IsAvailable = a.IsAvailable
            }).ToList();
        }

        SelectedDate = dateTime.GetValueOrDefault();
    }

    private async Task SelectSchedule(int scheduleId)
    {
        SelectedScheduleId = scheduleId;     

        foreach (var item in activity.ActivitySchedules)
        {
            item.IsSelected = false;
        }

        activity.ActivitySchedules.FirstOrDefault(a => a.Id == scheduleId).IsSelected = true;
    }

    private async Task ToggleScheduleTime(long scheduleTimeId, bool isSelected)
    {
        foreach (var item in activityScheduleTimes)
        {
            item.IsSelected = false;
        }

        activityScheduleTimes.FirstOrDefault(a => a.ActivityScheduleTimeId == scheduleTimeId).IsSelected = isSelected;
    }

    private async Task BookSchedule(long scheduleTimeId)
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");

        if (isAuthenticated)
        {
            var result = await activityApiHandler.CreateOngoingActivitySchedule(new Framework.ApiCommand.ApiCore.Activity.Request.CreateOngoingActivityScheduleArgs
                {
                    ActivityScheduleTimeId = (int)scheduleTimeId,
                    PurchaseOrderId = 0,
                    ScheduleDate = SelectedDate,
                    IsCompleted = false,
                    CreatedBy = CustomerModel.CustomerProfile.Id
                }, token);

            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                NavigationManager.NavigateTo($"/Explore/{Identifier}", true);
            }
        }
        else
        {
            signInReturnUrl = $"/Explore/{Identifier}";
            await signinModal.Show();
        }
    }

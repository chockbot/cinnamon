    private decimal PricePerHead
    {
        get
        {
            var schedule = activity.ActivitySchedules.FirstOrDefault(s => s.Id == SelectedScheduleId);
            if (schedule == null) return 0;

            return schedule.Price;
        }
    }

    private decimal PriceSubTotal
    {
        get
        {
            return PricePerHead * EnrolleeCount;
        }
    }

    private decimal AddOnsTotal
    {
        get
        {
            var selectedAddOns = activity.AddOns.Where(addOn => addOn.AddOnCount != 0).ToList();

            if (selectedAddOns == null || selectedAddOns.Count == 0)
            {
                return 0;
            }

            decimal totalAddOnPrice = selectedAddOns.Sum(addOn => (addOn.Price * addOn.AddOnCount));
            return totalAddOnPrice;
        }
    }

    private decimal ServiceFee
    {
        get
        {
            if (IsInclusivePricing) return 0;
            return 0;
        }
    }

    private decimal HandlingFee
    {
        get
        {
            if (PriceSubTotal <= 0) return 0;
            if (IsInclusivePricing) return 0;
            return 39m;
        }
    }

    private decimal TotalPayment
    {
        get
        {
            return PriceSubTotal + AddOnsTotal + ServiceFee + HandlingFee;
        }
    }

    private int TotalStudents
    {
        get
        {
            return activity.OngoingStudents + activity.CompletedStudents;
        }
    }

    private async Task ProceedToPayment()
    {
        List<AddOn> selectedAddOns = activity.AddOns.Where(a => a.AddOnCount != 0).ToList();
        if (selectedAddOns.Count() != 0 || SelectedScheduleId > 0)
        {
            if(isAuthenticated)
            {
            
            var payloadData = new
            {
                AddOnsDetails = selectedAddOns.Select(a =>
                {
                    return new
                    {
                        AddOnId = a.Id,
                        AddOnCount = a.AddOnCount
                    };
                })
            };
            var serializedPayload = JsonConvert.SerializeObject(payloadData);
            if (selectedAddOns.Count() != 0)
            {
                NavigationManager.NavigateTo($"/Payment/{activity.ActivityId}/{SelectedScheduleId}/{serializedPayload}/?enrollees={EnrolleeCount}");
            }
            else
            {
                NavigationManager.NavigateTo($"/Payment/{activity.ActivityId}/{SelectedScheduleId}/?enrollees={EnrolleeCount}");
            }
            }
            else
            {
                signInReturnUrl = $"/Explore/{Identifier}/?enrollees={EnrolleeCount}&sid={SelectedScheduleId}";
                await signinModal.Show();
            }
        }
        else
        {
            isShowErrorMessage = true;
        }
        
    }


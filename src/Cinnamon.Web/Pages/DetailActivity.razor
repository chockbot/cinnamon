@page "/Explore/{Identifier}"
@inject IJSRuntime jsRuntime
@using Cinnamon.Web.Components
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components.Pages
@inject IActivityApiHandler activityApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>@(activity == null ? "Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH" : $"Cinnamon Activity - {activity.Title} | CinnamonPH")</PageTitle>
<SeoMeta Title="@(activity?.Title ?? string.Empty)" 
    Description="@(activity?.Description ?? string.Empty)"
    Subject="@(activity?.Title ?? string.Empty)"
    Url='@($"/explore/{Identifier}")'
    Image="@(activity?.Images?[0]?.ImageSrc ?? string.Empty)"
    Keywords='new List<string>{activity?.ExperienceCategory ?? string.Empty}' />

@if (Model.Customer != null){
<div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3">
        <div class="section-1 d-flex flex-column pb-4 border-bottom col-lg-10 justify-content-center col-md-10 justify-content-center col-sm-12 justify-content-center col-12 justify-content-center">
        <div class="activity-image-container text-center d-flex flex-column" style="border-radius:10px;">
            <div class="images-gallery order-lg-last order-md-last order-sm-first d-flex gap-3">
                <div class="detail-md">
                    <div class="gallery">
                        @if (activity.Images.Count > 0)
                        {
                            <figure class="gallery__item gallery__item--1">
                                <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(0).ImageSrc" />
                            </figure>
                            <figure class="gallery__item gallery__item--2">
                                <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(1).ImageSrc" />
                            </figure>
                            <figure class="gallery__item gallery__item--3">
                                <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(2).ImageSrc" />
                            </figure>
                        }
                    </div>
                </div>
                <div class="d-flex flex-row detail-sm mx-auto">
                    <Div ElementId="#b-animate">
                        <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                        <div id="carouselDetailGallery" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            @if (activity.Images.Count > 0)
                            {
                                InitializeCarouselSwipe();
                                <div class="carousel-item active">
                                    <img class="img-fluid shadsow rounded" src="@activity.Images.ElementAt(0).ImageSrc" />
                                </div>
                                <div class="carousel-item">
                                    <img class="img-fluid shadow rounded" src="@activity.Images.ElementAt(1).ImageSrc" />
                                </div>
                                <div class="carousel-item">
                                    <img class="img-fluid shadow rounded" src="@activity.Images.ElementAt(2).ImageSrc" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                        </Animate>
                    </Div>
                </div>
            </div>
            <div class="w-100 order-lg-first order-md-first order-sm-last">
                <div class="text-black">
                    <div class="d-flex gap-1 fs-6">
                        @*  <span class="review">
                        <span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" fill="currentColor" class="bi bi-star" viewBox="0 0 20 22">
                        <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                        </svg>
                        </span>4.99 · <u>150 reviews</u></span>*@
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <div class="d-flex activity-title">
                <label class="fw-bold mb-3 col-lg-8 col-md-8 col-sm-12 col-12 title-text"> @activity.Title </label>
                <label class="fw-bold mb-3 col-lg-4 col-md-4 col-4 ongoing-students">
                    @if(OngoingStudents != 0){
                         <label class="active-badge">
                            <span class="pulse"></span>
                            <span class="active-text">Ongoing Enrollees</span>
                            <span class="active-tag-label">@OngoingStudents</span>
                        </label>
                    }  
                </label> 
            </div>
            <div class="d-flex activity-experiencetype">
                <label class="col-lg-8 col-md-8 col-sm-12 mb-3 col-12 mb-3">
                    @if (activity.ExperienceTypeId == 1)
                    {
                        <img class="img-thumbnail border-0" src="images/activity-summary/location.png" />
                    }
                    else
                    {
                        <img class="img-thumbnail border-0" src="images/activity-summary/laptop-icon.png" />
                    }
                    <span class="experience-name">@experience.Name</span>
                </label>
                    <label class="fw-bold col-lg-4 col-md-4 completed-students">
                        <label class="active-badge">
                            @if(CompletedStudents != 0){
                                <span class="pulse-complete"></span>
                                <span class="active-text">Completed Enrollees</span>
                                <span class="active-tag-label-complete">@CompletedStudents</span>
                            }
                            
                        </label>
                    </label>
            </div>
            <label class="fw-bold mb-3 col-sm-12 col-12 ongoing-enrolles">
                @if (OngoingStudents != 0)
                {
                    <span class="pulse"></span>
                    <span class="active-text">Ongoing Enrollees</span>
                    <span class="active-tag-label">@OngoingStudents</span>
                }
            </label>
            <label class="fw-bold col-sm-12 col-12 completed-enrolles">
                @if (CompletedStudents != 0)
                {
                    <span class="pulse-complete"></span>
                    <span class="active-text">Completed Enrollees</span>
                    <span class="active-tag-label-complete">@CompletedStudents</span>
                }
            </label>
        </div>
    </div>

    <div class="description-container py-4 d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12">
        <div class="flex-fill col-lg-12 col-md-12 col-sm-12 col-12 order-sm-last order-md-first order-lg-first order-last d-flex flex-column">
            <div class="col-12 d-flex flex-lg-row flex-md-row flex-sm-column flex-column">
                <div class="pe-3 mt-lg-0 mt-md-0 mt-3 mt-sm-3 col-lg-8 col-md-8 col-sm-12 col-12 order-sm-last order-md-first order-lg-first order-last">
                    @if (String.IsNullOrEmpty(activity.Description))
                    {
                        <label class="fw-bold mb-2 detail-label" style="font-size:1.4rem">@Resources.App.detailDescription1</label>
                        <p>
                            @activity.Description
                        </p>
                    }

                    else
                    {
                        <p>
                            @(
                                (MarkupString)activity.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>")
                                )
                        </p>
                    }
                </div>
                @if (customerDetail != null && customerDetail.IsMaker == true)
                {
                    <div class="col-lg-4 col-md-4 col-sm-12 col-12 order-sm-first order-md-last order-lg-last order-first profile-container">
                        <div class="w-100 shadow rounded-3 d-flex" style="background:#F3F6FC">
                            <div class="maker-pic">
                            <img class="rounded-2 rounded-circle m-3" src="@customerDetail.ProfilePath"/>
                            </div>
                            <div class="m-2 maker-profile-details">
                                <span class="xp-by">Experience by</span>
                                <span class="text-capitalize maker-name">@customerDetail.FirstName @customerDetail.LastName</span>
                                <a class="view-profile" href="/maker/profile/@(activity.Owner != null && !string.IsNullOrEmpty(activity.Owner.Handler) ? activity.Owner.Handler : activity.CreatedBy.ToString() )">View Profile</a>
                            </div>
                            <div class="profile-badges">
                                @if (customerDetail.IsVerified == 2)
                                {
                                    <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Class="badges">
                                        <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                    </Tooltip>
                                }
                                @if (customerDetail.IsOG == true)
                                {
                                    <Tooltip Multiline=true Text="For being part of the alpha and beta testing.">
                                        <img class="verified-logo" src="images/Badges/OG.svg" />
                                    </Tooltip>
                                    @*<img class="verified-logo" src="images/Badges/OG.svg" data-toggle="tooltip" data-placement="top" title="For being part of the alpha and beta testing." />*@
                                }
                                @if (customerDetail.IsOfficial == true)
                                {
                                    <Tooltip Multiline=true Text="Legitimate experience provider in the platform.">
                                        <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                    </Tooltip>
                                    @*<img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" data-toggle="tooltip" data-placement="top" title="Legitimate experience provider in the platform." />*@
                                }
                                @if (MakerCompletedStudent >= 10 && MakerCompletedStudent < 25)
                                {
                                    var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                    <Tooltip Multiline=true Text="@rare.Description">
                                        <img class="verified-logo" src="@rare.ImgScr" />
                                    </Tooltip>
                                    @* <img class="verified-logo" src="@rare.ImgScr" data-toggle="tooltip" data-placement="top" title="@rare.Description" />*@
                                }
                                @if (MakerCompletedStudent >= 25 && MakerCompletedStudent < 100)
                                {
                                    var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                    <Tooltip Multiline=true Text="@epic.Description">
                                        <img class="verified-logo" src="@epic.ImgScr" />
                                    </Tooltip>
                                    @* <img class="verified-logo" src="@epic.ImgScr" data-toggle="tooltip" data-placement="top" title="@epic.Description" />*@
                                }
                                @if (MakerCompletedStudent >= 100)
                                {
                                    var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                    <Tooltip Multiline=true Text="@legendary.Description">
                                        <img class="verified-logo" src="@legendary.ImgScr" />
                                    </Tooltip>
                                    @* <img class="verified-logo" src="@legendary.ImgScr" data-toggle="tooltip" data-placement="top" title="@legendary.Description" />*@
                                }
                                
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-lg-4 col-md-4 col-sm-12 col-12 order-sm-first order-md-last order-lg-last order-first">
                        <div class="profile-container w-100 shadow rounded-3 d-flex" style="background:#F3F6FC">
                            <img class="rounded-2 rounded-circle m-3" src="/images/Profile/user.png" width="60" height="60" />
                            <div class="d-flex flex-column m-2">
                                <span>Sample Owner</span>
                                <span>Owner Name</span>
                                <label>View Profile</label>
                            </div>
                            <div class="d-flex flex-column justify-content-center align-items-start flex-grow-1">
                                <img class="px-3" src="images/details_profile_badge.png" />
                            </div>
                        </div>
                    </div>
                }
                <hr class="d-block d-sm-block d-md-none" />
            </div>
            @*Experience Schedule*@
            <hr />
            <div class="col-12">
                <label class="fw-bold mb-3 detail-label">Schedule of @(activity.ActivitySchedules.Count > 1 ? "activities" : "activity")</label>
                
                @if (activity.ScheduleIndicator == "selection" || activity.ActivitySchedules.Count > 0)
                {   
                   var activeSchedule = activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).Count();
                   if(activeSchedule > 0){
                   <div class="d-flex flex-row gap-3 mb-2 p-2 overflow-auto">
                        @for (int x = 0; x < activity.ActivitySchedules.Count; x++)
                        {
                            @if (x <= 3)
                            {
                                <div class="col-md-3 col-lg-3 col-sm-6 col-6">
                                    <CarouselItemSchedule ScheduleModel="@activity.ActivitySchedules.ElementAt(x)" ActivityModel="activity"></CarouselItemSchedule> 
                                </div>
                            }
                            else
                            {
                                break;
                            }
                        }
                   </div>
                   }
                   else
                   {
                       <div class="d-flex flex-row gap-3 mb-2 overflow-auto">
                            <p>No schedule available yet, mark as favorite or come back soon for the next updated schedule!</p>
                       </div>
                       
                   }
                }
                

                @if (activity.ActivitySchedules.Where(s=> s.IsActiveSchedule == true).Count() >= 4)
                {
                    <button class="btn-primary shadow-sm border-0 p-2 rounded" @onclick="()=>ModalSched.Open()">
                         Show more
                    </button>
                }
            </div>

            @*Map Details*@
            <hr />
            <div class="d-flex flex-column align-it3ems-start col-lg-6 col-md-6 col-sm-12 col-12">
                 <label class="fw-bold mb-3 detail-label">Where you’ll be</label>
            @if (string.IsNullOrEmpty(activity.MapDetails))
            {
            @if (activity.ExperienceTypeId == 1)
            {
                var address = !string.IsNullOrEmpty(activity.PinnedLocation) ? activity.PinnedLocation : activity.Address1 + "+" + activity.Subdivision + "+" + activity.BarangayName + "+" + activity.CityName + "+" + activity.RegionName;
                var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q=" + address;
                <iframe id="mapframe" frameborder="0" style="border:0" src="@map" allowfullscreen></iframe>
                <span class="mt-3">
                        @(activity.Address1 + ", " + activity.BarangayName + ", " + activity.CityName + ", " + activity.RegionName)
                </span>
            }
            else
            {
                 <span class="mt-3">
                    @experience.Name
                 </span>
            }
            }
            else
            {
            @if (!activity.MapDetails.Contains("Online"))
            {
                var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q=" + activity.MapDetails.Replace(" ", "+");
                <iframe id="mapframe" frameborder="0" style="border:0" src="@map" allowfullscreen></iframe>
            }
            <span class="mt-3">
            @activity.MapDetails
            </span>
            }
            </div>
            @if (!string.IsNullOrEmpty(activity.Description))
            {
                <hr />
                @if(!string.IsNullOrEmpty(activity.SpecificsYouWillProvide))
                {
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                        <label class="fw-bold mb-3 detail-label">What's included</label>
                        <p>
                            @((MarkupString)activity.SpecificsYouWillProvide)
                        </p>
                    </div>
                    <hr />
                }
                @if(!string.IsNullOrEmpty(activity.CustomerBringWithThem))
                {
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                        <label class="fw-bold mb-3 detail-label">What you should bring</label>
                        <p>@((MarkupString)activity.CustomerBringWithThem)</p>
                    </div>
                    <hr />
                }
                <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                    <label class="fw-bold mb-3 detail-label">Requirements</label>
                    <p>
                        Minimum Age: @activity.MinimumAge
                        <br>
                        Levels of Activity: @activity.ActivityLevel
                        <br>
                        Skill Level: @activity.SkillLevel
                    </p>
                </div>
                if (!string.IsNullOrEmpty(activity.AdditionalRequirements))
                {
                    <hr />
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                        <label class="fw-bold mb-3 detail-label">Additional Requirements</label>
                        <p>
                            @activity.AdditionalRequirements
                        </p>
                    </div>
                }
            }
            <hr />
            <div class="end-container d-flex flex-column">
                    <a href="/explore" style="text-decoration:none"><span class="landing-header color-primary fs-2">@Resources.App.appName</span></a>
                <span>
                        Not happy with the experience? <br /> <a href="https://docs.google.com/forms/d/e/1FAIpQLSenakLuzzv2bTCy65a2WTy48E3wWAqs6B2reQVcSz3fkHOxkg/viewform" target="_blank">Contact us</a> and we'll solve the problem for you.
                </span>
            </div>
        </div>
    </div>
</div>
@* commented first for migration *@
 <SchedulesModal @ref="ModalSched" ScheduleModel="activity.ActivitySchedules.ToList()" ActivityModel="activity"></SchedulesModal> 


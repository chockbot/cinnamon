@*Created By: R. Namoro
  Last Update: 07/28/2023*@

@page "/Explore/{Identifier}"
@inject IJSRuntime jsRuntime
@using System.Security.Claims
@using Cinnamon.Web.Components
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components.Pages;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore

<PageTitle>@(activity == null ? "Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH" : $"Cinnamon Activity - {activity.Title} | CinnamonPH")</PageTitle>
<SeoMeta Title="@(activity?.Title ?? string.Empty)"
         Description="@(activity?.Description ?? string.Empty)"
         Subject="@(activity?.Title ?? string.Empty)"
         Url='@($"/explore/{Identifier}")'
         Image="@(activity?.Images?[0]?.ImageSrc ?? string.Empty)"
         Keywords='new List<string>{activity?.ExperienceCategory ?? string.Empty}' />

@if (Model.Customer != null)
{
    <Container>
        <div id="alertContainer" class="alertContainer">
            <div id="alertMessage" class="alertMessage">Copied to clipboard!</div>
        </div>
        <Div ElementId="#b-header-animate" class="activity-details-page-wrapper">
            <Animate Anchor="#b-header-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                <div>
                    @*Details Header Desktop*@
                    <div class="details-header">
                        @*Experience Title*@
                        <div class="d-flex activity-title">
                            <label class="fw-bold mb-3 col-lg-12 col-md-12 title-text"> @activity.Title </label>
                        </div>
                        @*Experience Type*@
                        <div class="d-flex activity-experiencetype">
                            <label class="col-lg-12 col-md-12 mb-3 mb-3">
                                @if (activity.ExperienceTypeId == 1)
                                {
                                    <img class="img-thumbnail border-0" src="images/activity-summary/location.png" />
                                }
                                else
                                {
                                    <img class="img-thumbnail border-0" src="images/activity-summary/laptop-icon.png" />
                                }
                                <span class="experience-name">@experience.Name</span>
                            </label>
                        </div>
                        @*Ongoing Enrolees*@
                        <div class="d-flex">
                            <label class="col-lg-6 justify-content-lg-start col-md-8 justify-content-md-start mb-3 ongoing-students">
                                @if (OngoingStudents != 0)
                                {
                                    <label class="active-badge">
                                        <span class="pulse"></span>
                                        <span class="active-text">Ongoing Enrollees</span>
                                        <span class="active-tag-label">@OngoingStudents</span>
                                    </label>
                                }
                                @if (CompletedStudents != 0)
                                {
                                    <label class="active-badge">
                                        <span class="pulse-complete"></span>
                                        <span class="active-text">Completed Enrollees</span>
                                        <span class="active-tag-label-complete">@CompletedStudents</span>
                                    </label>
                                }
                            </label>
                            <label class="col-lg-6 justify-content-lg-end col-md-4 justify-content-md-end mb-3 share-link">
                                <label class="active-badge">
                                    @if (CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                    {
                                        activity.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == activity.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                        if (activity.IsFavorite != false)
                                        {
                                            <label class="active-badge">
                                                @if (activity.IsFavorite == true)
                                                {
                                                    <span class="favorite-text">Added To Favorites</span>
                                                }
                                                else
                                                {
                                                    <span class="favorite-text">Add To Favorites</span>
                                                }
                                                <button class="btn btn-copy" @onclick="() =>AddToFavorites(activity)">
                                                    <img src="@(activity.IsFavorite ? "images/favorites/heart-selected.png" : "images/favorites/heart-default.png")">
                                                </button>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="active-badge">
                                                <span class="favorite-text">Add To Favorites</span>
                                                <button class="btn btn-copy" @onclick="() =>CreateFavorite(activity)">
                                                    <img src="images/favorites/heart-default.png">
                                                </button>
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        <label class="active-badge">
                                            <span class="favorite-text">Add To Favorites</span>
                                            <button class="btn btn-copy" @onclick="() =>signinModal.Show()">
                                                <img src="images/favorites/heart-default.png">
                                            </button>
                                        </label>
                                    }
                                </label>
                                <label class="active-badge-share">
                                    <span class="favorite-text">Share this Activity</span>
                                    <button class="btn btn-copy" @onclick="() => CopyToClipboard()">
                                        <img src="images/copytoclipboard.png">
                                    </button>
                                </label>
                            </label>
                        </div>
                    </div>
                    @*Activity Images*@
                    <div class="activity-image-container text-center d-flex flex-column" style="border-radius:10px;">
                        <div class="images-gallery order-lg-last order-md-last order-sm-first d-flex gap-3">
                            <div class="detail-md">
                                <div class="gallery">
                                    @if (activity.Images.Count > 0)
                                    {
                                        <figure class="gallery__item gallery__item--1">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(0).ImageSrc" />
                                        </figure>
                                        <figure class="gallery__item gallery__item--2">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(1).ImageSrc" />
                                        </figure>
                                        <figure class="gallery__item gallery__item--3">
                                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(2).ImageSrc" />
                                        </figure>
                                    }
                                </div>
                            </div>
                            <div class="swiper swiper-details-mobile-images detail-sm">
                                <div class="swiper-wrapper">
                                    @if(activity.Images.Count > 0)
                                    {
                                        <div class="swiper-slide">
                                            <img class="img-fluid shadsow rounded" src="@activity.Images.ElementAt(0).ImageSrc" />
                                        </div>
                                        <div class="swiper-slide">
                                            <img class="img-fluid shadsow rounded" src="@activity.Images.ElementAt(1).ImageSrc" />
                                        </div>
                                        <div class="swiper-slide">
                                            <img class="img-fluid shadsow rounded" src="@activity.Images.ElementAt(2).ImageSrc" />
                                        </div>
                                    }
                                </div>
                                <div class="swiper-pagination"></div>
                            </div>
                        </div>
                    </div>
                    @*Details Header Mobile*@
                    <div class="details-header-small">
                        @*Experience Title*@
                        <div class="d-flex activity-title-small">
                            <label class="fw-bold mb-3 col-12 title-text-small"> @activity.Title </label>
                        </div>
                        @*Experience Type*@
                        <div class="d-flex activity-experiencetype-small">
                            <label class="col-6 justify-content-start mb-3 mb-3">
                                @if (activity.ExperienceTypeId == 1)
                                {
                                    <img class="img-thumbnail-small border-0" src="images/activity-summary/location.png" />
                                }
                                else
                                {
                                    <img class="img-thumbnail-small border-0" src="images/activity-summary/laptop-icon.png" />
                                }
                                <span class="experience-name-small">@experience.Name</span>
                            </label>
                            <label class="col-6 justify-content-end mb-3 share-link-small">
                                <label class="active-badge">
                                    @if (CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                    {
                                        activity.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == activity.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                        if (activity.IsFavorite != false)
                                        {
                                            <label class="favorite-small">
                                                <button class="btn btn-copy" @onclick="() =>AddToFavorites(activity)">
                                                    <img src="@(activity.IsFavorite ? "images/favorites/heart-selected.png" : "images/favorites/heart-default.png")">
                                                </button>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="favorite-small">
                                                <button class="btn btn-copy" @onclick="() =>CreateFavorite(activity)">
                                                    <img src="images/favorites/heart-default.png">
                                                </button>
                                            </label>
                                        }
                                    }
                                    else
                                    {
                                        <label class="favorite-small">
                                            <button class="btn btn-copy" @onclick="() =>signinModal.Show()">
                                                <img src="images/favorites/heart-default.png">
                                            </button>
                                        </label>
                                    }
                                </label>
                                <label class="copy-link-small">
                                    <button class="btn btn-copy" @onclick="() => CopyToClipboard()">
                                        <img src="images/copytoclipboard.png">
                                    </button>
                                </label>
                            </label>
                        </div>
                        @*Ongoing Enrolees*@
                        <div class="d-block enrolles-container">
                            <label class="col-12 justify-content-start mb-1 ongoing-students-small">
                                @if (OngoingStudents != 0)
                                {
                                    <label class="ongoing-badge-small">
                                        <span class="pulse-small"></span>
                                        <span class="active-text-small">Ongoing Enrollees</span>
                                        <span class="active-tag-label-small">@OngoingStudents</span>
                                    </label>
                                }
                                @if (CompletedStudents != 0)
                                {
                                    <label class="completed-badge-small">
                                        <span class="pulse-small-complete"></span>
                                        <span class="active-text-small">Completed Enrollees</span>
                                        <span class="active-tag-label-complete-small">@CompletedStudents</span>
                                    </label>
                                }
                            </label>
                        </div>
                    </div>
                </div>
            </Animate>
        </Div>
        <Div>
            <Row HorizontalGutter="30">
                <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop">
                    <div class="py-2">
                        @*Customer Details*@
                        @if (customerDetail != null && customerDetail.IsMaker == true)
                        {
                            <div class="col-8 d-flex flex-lg-row flex-md-row flex-sm-column flex-column profile-container w-100">
                                @*Customer Profile*@
                                <div class="d-flex">
                                    <div class="maker-pic">
                                        <img class="rounded-2 rounded-circle m-3" src="@customerDetail.ProfilePath" />
                                    </div>
                                    <div class="m-2 maker-profile-details">
                                        <span class="xp-by">Experience by</span>
                                        <span class="text-capitalize maker-name">@customerDetail.FirstName @customerDetail.LastName</span>
                                        <a class="view-profile" href="/maker/profile/@(activity.Owner != null && !string.IsNullOrEmpty(activity.Owner.Handler) ? activity.Owner.Handler : activity.CreatedBy.ToString() )" target="_blank">View Profile</a>
                                    </div>
                                    <div class="profile-badges">
                                        @if (customerDetail.IsVerified == 2)
                                        {
                                            <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Class="badges">
                                                <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                            </Tooltip>
                                        }
                                        @if (customerDetail.IsOG == true)
                                        {
                                            <Tooltip Multiline=true Text="For being part of the alpha and beta testing.">
                                                <img class="verified-logo" src="images/Badges/OG.svg" />
                                            </Tooltip>
                                            @*<img class="verified-logo" src="images/Badges/OG.svg" data-toggle="tooltip" data-placement="top" title="For being part of the alpha and beta testing." />*@
                                        }
                                        @if (customerDetail.IsOfficial == true)
                                        {
                                            <Tooltip Multiline=true Text="Legitimate experience provider in the platform.">
                                                <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                            </Tooltip>
                                            @*<img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" data-toggle="tooltip" data-placement="top" title="Legitimate experience provider in the platform." />*@
                                        }
                                        @if (MakerCompletedStudent >= 10)
                                        {
                                            var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@rare.Description">
                                                <img class="verified-logo" src="@rare.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@rare.ImgScr" data-toggle="tooltip" data-placement="top" title="@rare.Description" />*@
                                        }
                                        @if (MakerCompletedStudent >= 25)
                                        {
                                            var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@epic.Description">
                                                <img class="verified-logo" src="@epic.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@epic.ImgScr" data-toggle="tooltip" data-placement="top" title="@epic.Description" />*@
                                        }
                                        @if (MakerCompletedStudent >= 100)
                                        {
                                            var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                            <Tooltip Multiline=true Text="@legendary.Description">
                                                <img class="verified-logo" src="@legendary.ImgScr" />
                                            </Tooltip>
                                            @* <img class="verified-logo" src="@legendary.ImgScr" data-toggle="tooltip" data-placement="top" title="@legendary.Description" />*@
                                        }

                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-8 d-flex flex-lg-row flex-md-row flex-sm-column flex-column border-bottom profile-container">
                                <div class="profile-container d-flex" style="background:#F3F6FC">
                                    <img class="rounded-2 rounded-circle m-3" src="/images/Profile/user.png" width="60" height="60" />
                                    <div class="d-flex flex-column m-2">
                                        <span>Sample Owner</span>
                                        <span>Owner Name</span>
                                        <label>View Profile</label>
                                    </div>
                                    <div class="d-flex flex-column justify-content-center align-items-start flex-grow-1">
                                        <img class="px-3" src="images/details_profile_badge.png" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="my-0">

                    @*Activity Details*@
                    <div class="description-label">
                        @if (String.IsNullOrEmpty(activity.Description))
                        {
                            <label class="fw-bold mb-3 detail-label" style="font-size:1.4rem">@Resources.App.detailDescription1</label>
                            <p>
                                @activity.Description
                            </p>
                        }
                        else
                        {
                            <p class="activity-details-text">
                                @(
                                    (MarkupString)activity.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>")
                                    )
                            </p>
                        }
                    </div>

                    @*Experience Schedule Desktop*@
                    <div class="schedule-desktop">
                        <label class="fw-bold mb-3 detail-label">Schedule of @(activity.ActivitySchedules.Count > 1 ? "activities" : "activity")</label>
                        @if (activity.ScheduleIndicator == "selection" || activity.ActivitySchedules.Count > 0)
                        {
                            var activeSchedule = activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).ToList();
                            if (activeSchedule.Count > 0)
                            {
                                <div class="d-block mb-2">
                                    @for (int x = 0; x < activeSchedule.Count; x++)
                                    {
                                        var schedule = activeSchedule.ElementAt(x);
                                        @if (x <= 2)
                                        {
                                            <div class="schedule-detail w-100 rounded-5">
                                                <div class="schedule-header d-flex">
                                                    <div class="schedule-title col-lg-10 clo-md-9 col-sm-9 col-9 justify-content-start">
                                                        <p>@activeSchedule.ElementAt(x).Name</p>
                                                    </div>
                                                    <div class="form-check col-lg-2 col-md-3 col-sm-3 col-3 justify-content-center">
                                                        <input checked="@(SelectedScheduleId == schedule.Id)" class="form-check-input" 
                                                            value="@schedule.Id" type="radio" name="schedule" id="schedule" 
                                                            @onchange="() => SelectSchedule(schedule.Id)">
                                                        <label class="form-check-label" for="schedule">
                                                            Select
                                                        </label>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="schedule-body">
                                                    <div class="col-lg-10 col-md-9 col-sm-9 col-10 PES-details">
                                                        <div class="PE-details d-flex">
                                                            <div class="col-lg-6 col-md-6 col-sm-12 col-6 price-details">
                                                                <p class="font-14">Price Details:</p>
                                                                <p class="font-16-d">₱ @activeSchedule.ElementAt(x).LongPrice / @activeSchedule.ElementAt(x).PerUnit1 @activeSchedule.ElementAt(x).PriceUnit1 / @activeSchedule.ElementAt(x).PerUnit2 @activeSchedule.ElementAt(x).PriceUnit2</p>
                                                            </div>
                                                            @if (@activeSchedule.ElementAt(x).IsSetSession == true)
                                                            {
                                                                <div class="col-lg-6 col-md-6 col-sm-12 col-6 expiration details">
                                                                    <p class="font-14">Expiration:</p>
                                                                    <p class="font-16-d">Consume in - @activeSchedule.ElementAt(x).SessionName</p>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="S-details col-lg-12 col-md-12 col-sm-12 col-12">
                                                            <p class="font-14">Schedule:</p>
                                                            <p class="font-16-d">@activeSchedule.ElementAt(x).DateTime</p>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-2 col-md-3 col-sm-3 col-2 justify-content-center schedule-price">
                                                        <p class="font-18">₱ @activeSchedule.ElementAt(x).LongPrice</p>
                                                    </div>
                                                </div>
                                                <div class="calendar-section">
                                                    @if (activity.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.ExperienceViaAppointment && activeSchedule.ElementAt(x).IsSelected)
                                                    {
                                                        <div class="row">
                                                             <div class="col-lg-5">
                                                                <p class="font-14">Select Date & Time:</p>
                                                                <DatePicker TValue="DateTime?" Inline DateChanged="(e) => DateHasChanged(e)" />
                                                            </div>
                                                            <div class="col-lg-5">
                                                                <div class="row">
                                                                    @foreach (var scheduleTime in activityScheduleTimes)
                                                                    {
                                                                        <div class="col-lg-6">
                                                                            @if (scheduleTime.IsSelected)
                                                                            {
                                                                                <div class="row">
                                                                                    <div class="col-lg-6">
                                                                                        <button class="btn btn-cancel-schedule-time" @onclick="() => ToggleScheduleTime(scheduleTime.ActivityScheduleTimeId, false)">
                                                                                            Cancel
                                                                                        </button>
                                                                                    </div>
                                                                                    <div class="col-lg-6">
                                                                                        <button class="btn book-schedule-time" @onclick="() => BookSchedule(scheduleTime.ActivityScheduleTimeId)">
                                                                                            Book
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                            else
                                                                            {
                                                                                <button class="btn btn-schedule-time" @onclick="() => ToggleScheduleTime(scheduleTime.ActivityScheduleTimeId, true)" disabled="@(scheduleTime.IsAvailable ? false : true)">
                                                                                    @scheduleTime.StartTime
                                                                                </button>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            break;
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-row gap-3 mb-2 overflow-auto">
                                    <p>No schedule available yet, mark as favorite or come back soon for the next updated schedule!</p>
                                </div>
                            }
                        }
                        @if (activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).Count() >= 4)
                        {
                            <button class="btn-primary shadow-sm border-0 p-2 rounded" @onclick="()=>DetailsModalSched.Open()">
                                Show more
                            </button>
                        }
                    </div>

                    @*Experience Schedule Mobile*@
                    <div class="schedule-mobile">
                        <label class="fw-bold mb-3 detail-label">Schedule of @(activity.ActivitySchedules.Count > 1 ? "activities" : "activity")</label>
                        @if (activity.ScheduleIndicator == "selection" || activity.ActivitySchedules.Count > 0)
                        {
                            var activeSchedule = activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).ToList();
                            if (activeSchedule.Count > 0)
                            {
                                <div class="d-block mb-2">
                                    @for (int x = 0; x < activeSchedule.Count; x++)
                                    {
                                        var schedule = activeSchedule.ElementAt(x);
                                        @if (x <= 2)
                                        {
                                            <div class="schedule-detail w-100 rounded-5">
                                                <div class="schedule-header d-flex">
                                                    <div class="schedule-title col-9 justify-content-start">
                                                        <p>@activeSchedule.ElementAt(x).Name</p>
                                                    </div>
                                                    <div class="col-3 justify-content-center">
                                                        <p class="font-18">₱ @activeSchedule.ElementAt(x).LongPrice</p>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="schedule-body">
                                                    <div class="col-12 price-details">
                                                        <p class="font-14">Price Details:</p>
                                                        <p class="font-16-d">₱ @activeSchedule.ElementAt(x).LongPrice / @activeSchedule.ElementAt(x).PerUnit1 @activeSchedule.ElementAt(x).PriceUnit1 / @activeSchedule.ElementAt(x).PerUnit2 @activeSchedule.ElementAt(x).PriceUnit2</p>
                                                    </div>
                                                    @if (@activeSchedule.ElementAt(x).IsSetSession == true)
                                                    {
                                                        <div class="col-12 expiration-details">
                                                            <p class="font-14">Expiration:</p>
                                                            <p class="font-16-d">Consume in - @activeSchedule.ElementAt(x).SessionName</p>
                                                        </div>
                                                    }
                                                    <div class="col-12 schedule-details">
                                                        <p class="font-14">Schedule:</p>
                                                        <p class="font-16-d">@activeSchedule.ElementAt(x).DateTime</p>
                                                    </div>
                                                    <div class="col-12 form-check ">
                                                        <input value="@schedule.Id" class="form-check-input" @onchange="() => SelectedScheduleId = schedule.Id" 
                                                            type="radio" name="schedule" id="schedule">
                                                        <label class="form-check-label" for="schedule">
                                                            Select
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            break;
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-row gap-3 mb-2 overflow-auto">
                                    <p>No schedule available yet, mark as favorite or come back soon for the next updated schedule!</p>
                                </div>
                            }
                        }
                        @if (activity.ActivitySchedules.Where(s => s.IsActiveSchedule == true).Count() >= 4)
                        {
                            <button class="btn-primary shadow-sm border-0 p-2 rounded" @onclick="()=>DetailsModalSched.Open()">
                                Show more
                            </button>
                        }
                    </div>

                    @*Map Details*@
                    <hr />
                    <div class="map-text">
                        <p class="fw-bold mb-3 detail-label">Where you’ll be</p>
                        @if (string.IsNullOrEmpty(activity.MapDetails))
                        {
                            @if (activity.ExperienceTypeId == 1)
                            {
                                var address = !string.IsNullOrEmpty(activity.PinnedLocation) ? activity.PinnedLocation : activity.Address1 + "+" + activity.Subdivision + "+" + activity.BarangayName + "+" + activity.CityName + "+" + activity.RegionName;
                                var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q=" + address;
                                <iframe id="mapframe" frameborder="0" style="border:0" src="@map" allowfullscreen></iframe>
                                <span class="mt-3">
                                    @(activity.Address1 + ", " + activity.BarangayName + ", " + activity.CityName + ", " + activity.RegionName)
                                </span>
                            }
                            else
                            {
                                <span class="mt-3">
                                    @experience.Name
                                </span>
                            }
                        }
                        else
                        {
                            @if (!activity.MapDetails.Contains("Online"))
                            {

@page "/Explore/{Id:int}"
@using Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Data
@inject IJSRuntime jsRuntime
@inject DataStoreDbContext _detailActivity

<div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3">
    <div class="section-1 d-flex flex-column pb-4 border-bottom col-lg-10 col-md-10 col-sm-12 col-12">
        <div class="activity-image-container text-center d-flex flex-column" style="border-radius:10px;">
          <div class="images-gallery order-lg-last order-md-last order-sm-first d-flex gap-3">
            <div class="detail-lg">
                <div class="gallery">
                    <figure class="gallery__item gallery__item--1">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(1).ImageLocation" />
                    </figure>
                    <figure class="gallery__item gallery__item--2">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(0).ImageLocation" />
                    </figure>
                    <figure class="gallery__item gallery__item--3">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(2).ImageLocation" />
                    </figure>
                </div>
            </div>
             <div class="detail-md">
                <div class="gallery">
                    <figure class="gallery__item gallery__item--1">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(1).ImageLocation" />
                    </figure>
                    <figure class="gallery__item gallery__item--2">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(0).ImageLocation" />
                    </figure>
                    <figure class="gallery__item gallery__item--3">
                        <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(2).ImageLocation" />
                    </figure>
                </div>
            </div>
             <div class="d-flex flex-row detail-sm">
                  <div id="carouselDetailGallery" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <div class="col-sm-12">
                                    <img class="img-fluid shadsow rounded" style="width:100%" src="@_Images.ElementAt(1).ImageLocation" />
                                </div>
                            </div>
                            <div class="carousel-item">
                                <div class="col-sm-12">
                                    <img class="img-fluid w-100 shadow rounded" src="@_Images.ElementAt(0).ImageLocation" />
                                </div>

                            </div>
                            <div class="carousel-item">
                                <div class="col-sm-12">
                                    <img class="img-fluid w-100 shadow rounded" src="@_Images.ElementAt(2).ImageLocation" />
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
            </div>
          </div>
            <div class="w-100 order-lg-first order-md-first order-sm-last">
                <div class="text-black">
                    <div class="d-flex gap-1 fs-6">
                        <span class="review">4.99 · <u>150 reviews</u></span>
                        <span><u>@activityModel.Location</u></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between mt-3">
            <div class="activity-title">
                <h3 class="fw-bold">@activityModel.Title</h3>
            </div>
        </div>
    </div>
    <div class="description-container py-4 d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12">
        <div class="flex-fill col-lg-6 col-md-6 col-sm-12 col-12 order-sm-last order-md-first order-lg-first order-last d-flex flex-column">
            <div class="description-container">
                <p>
                    @((MarkupString)activityModel.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n","<br>"))
                </p>
            </div>
            <hr />
            <div class="col-12">
                <div class="">
                    <h5>Schedule of activities</h5>
                    @if (activityModel.ScheduleIndicator == "selection")
                    {
                        <div class="row mx-auto my-auto justify-content-center" id="activitydates-container">
                            <div id="recipeCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner p-3" role="listbox" style="width:85%;margin:0 auto;">
                                    @foreach(var sched in activityModel.Schedules.Split("\r\n\r\n"))
                                    {
                                        <div class="carousel-item active">
                                            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                            <CarouselItem Text="@sched"></CarouselItem>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <a class="carousel-control-prev bg-transparent w-aut" href="#recipeCarousel" role="button" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                </a>
                                <a class="carousel-control-next bg-transparent w-aut" href="#recipeCarousel" role="button" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                </a>
                            </div>
                        </div>
                    }
                    else{
                        <div class="px-4">
                            <span>
                                @((MarkupString)activityModel.Schedules.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>"))
                            </span
                        </div>
                    }
                </div>
            </div>
            <hr />
            <div class="d-flex flex-column align-items-start">
                <label class="fw-bold">Where you’ll be</label>
                <img class="w-100" style="margin-left:-15px;" src="images/map_picture.png" />
                <span>
                    @activityModel.MapDetails
                </span>
            </div>
            <hr />
            <div class="end-container d-flex flex-column">
                <span class="landing-header color-primary fs-2">@Resources.App.appName</span>
                <span>
                    Not happy with the experience? <br /> Contact us and we'll solve the problem for you.
                </span>
            </div>
        </div>
        <div class="flex-fill col-lg-6 col-md-6 col-sm-12 col-12 order-sm-first order-md-last order-lg-last order-first d-flex gap-4 flex-column align-items-lg-end align-items-md-end align-items-sm-center align-items-center mb-3">
            <div class="profile-container w-75 shadow rounded-3 d-flex" style="background:#F3F6FC">
                <img class="rounded-2 rounded-circle m-3" src="images/profile_picture.png" width="60" height="60" />
                <div class="d-flex flex-column m-2">
                    <span>Owner</span>
                    <span>David Watson</span>
                    <a href="#">View Profile</a>
                </div>
                <div class="d-flex flex-column justify-content-center align-items-end flex-grow-1">
                    <img class="px-3" src="images/check.svg" />
                </div>
            </div>
            <div class="w-75 shadow rounded-3 p-3 detail-lg">
                <SignUpCard TypeValue="UserType.Customer"></SignUpCard>
            </div>
            <div class="detail-sm">
                <div class="shadow border-3 border-top" style="position:fixed;bottom:0;left:0;width:100%;height:120px;background-color:white;padding:10px;z-index:9999">
                    <PrimaryButton ModalTarget="#sigupModal" Id="reserve-button" ModalBsToggle="modal" Text="Reserve" Width="100%"></PrimaryButton>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Footer-->
<Footer></Footer>

@code {
    [Parameter]
    public int Id { get; set; }
    public ActivityModel activityModel { get; set; }
    public List<ActivityImagesModels> _Images { get; set; }
    IJSObjectReference module;
    protected override async void OnInitialized()
    {
        activityModel = _detailActivity.Activities.Where(c => c.Id == Id).ToList().ElementAt(0);
        _Images = _detailActivity.ActivityImages.Where(c => c.ImageId == Id).ToList();
        module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/DetailActivity.js");

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
           await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Details Page Loaded");
        }
    }
}
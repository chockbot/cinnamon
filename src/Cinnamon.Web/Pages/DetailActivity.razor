        <div class="flex-fill w-50 d-flex gap-4 flex-column align-items-end my-5">
            <div class="w-75 shadow rounded-3 d-flex" style="background:#F3F6FC">
                <img class="rounded-2 rounded-circle m-3" src="images/profile_picture.png" width="60" height="60" />
                <div class="d-flex flex-column m-2">
                    <span>Owner</span>
                    <span>David Watson</span>

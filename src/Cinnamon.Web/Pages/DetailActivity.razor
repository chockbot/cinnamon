    private string ConvertToEmbedSrc(string videoLink, VideoPlatform platform)
    {
        switch (platform)
        {
            case VideoPlatform.Vimeo:
                return GetVimeoEmbedSrc(videoLink);
            case VideoPlatform.YouTube:
                return GetYouTubeEmbedSrc(videoLink);
            default:
                throw new ArgumentException("Invalid video platform.");
        }
    }

    private string GetVimeoEmbedSrc(string vimeoLink)
    {
        // Extract Vimeo video ID from the link
        string vimeoVideoId = vimeoLink.Substring(vimeoLink.LastIndexOf("/") + 1);

        // Construct Vimeo embed src code
        return $"https://player.vimeo.com/video/{vimeoVideoId}";
    }

    private string GetYouTubeEmbedSrc(string youtubeLink)
    {
        var uri = new Uri(youtubeLink);
        string youtubeVideoId = null;

        if (uri.Host.Equals("youtu.be", StringComparison.OrdinalIgnoreCase))
            youtubeVideoId = uri.Segments.Last();
        else if (uri.Host.Equals("www.youtube.com", StringComparison.OrdinalIgnoreCase) && uri.AbsolutePath.Equals("/watch", StringComparison.OrdinalIgnoreCase))
            youtubeVideoId = System.Web.HttpUtility.ParseQueryString(uri.Query)["v"];

        return youtubeVideoId != null ? $"https://www.youtube.com/embed/{youtubeVideoId}" : null;
    }
    private enum VideoPlatform
    {
        Vimeo,
        YouTube
    }

    private async Task MessageProvider(int providerId)
    {
        var messageProviderRes = await chatApiHandler.RequestMessage(new Framework.ApiCommand.ApiCore.ChatRoom.Request.RequestMessageArgs {
            ProviderId = providerId
        }, Token);
        if(!messageProviderRes.Succeeded || messageProviderRes.Result is null || !messageProviderRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again.", "Error");
            return;
        }

        var result = messageProviderRes.Result.Result;
        var url = $"/messages/?guid={result.Guid}&token={result.Token}";

        if(CustomerModel.CustomerProfile is null)
        {
            signInReturnUrl = url;
            await signinModal.Show();
        }
        else 
        {
            NavigationManager.NavigateTo(url);
        }
    }

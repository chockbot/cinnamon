@page "/Explore/{Id:int}"
@inject IJSRuntime jsRuntime
@using Cinnamon.Core.Models
@using Cinnamon.Web.Components
@using Cinnamon.Core
@using Cinnamon.Core.Enums
@using Cinnamon.Data

<div class="d-flex flex-column align-items-center mt-3 px-sm-3 px-3">
    <div class="section-1 d-flex flex-column pb-4 border-bottom col-lg-10 col-md-10 col-sm-12 col-12">
        <div class="activity-image-container text-center d-flex flex-column" style="border-radius:10px;">
          <div class="images-gallery order-lg-last order-md-last order-sm-first d-flex gap-3">
             <div class="detail-md">
                <div class="gallery">
                        @if (_Images.Count > 0)
                        {
                            <figure class="gallery__item gallery__item--1">
                                <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(1).ImageLocation" />
                            </figure>
                            <figure class="gallery__item gallery__item--2">
                                <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(0).ImageLocation" />
                            </figure>
                            <figure class="gallery__item gallery__item--3">
                                <img class="img-fluid shadow rounded gallery__img" src="@_Images.ElementAt(2).ImageLocation" />
                            </figure>
                        }
                    </div>
                </div>
                <div class="d-flex flex-row detail-sm mx-auto">
                    <div id="carouselDetailGallery" class="carousel slide" data-bs-ride="carousel" data-bs-interval="false">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselDetailGallery" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            @if (_Images.Count > 0)
                            {
                                <div class="carousel-item active">
                                    <img class="img-fluid shadsow rounded" src="@_Images.ElementAt(1).ImageLocation" />
                                </div>
                                <div class="carousel-item">
                                    <img class="img-fluid shadow rounded" src="@_Images.ElementAt(0).ImageLocation" />
                                </div>
                                <div class="carousel-item">
                                    <img class="img-fluid shadow rounded" src="@_Images.ElementAt(2).ImageLocation" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselDetailGallery" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="w-100 order-lg-first order-md-first order-sm-last">
                <div class="text-black">
                    <div class="d-flex gap-1 fs-6">
                        <span class="review">
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" fill="currentColor" class="bi bi-star" viewBox="0 0 20 22">
                                    <path d="M2.866 14.85c-.078.444.36.791.746.593l4.39-2.256 4.389 2.256c.386.198.824-.149.746-.592l-.83-4.73 3.522-3.356c.33-.314.16-.888-.282-.95l-4.898-.696L8.465.792a.513.513 0 0 0-.927 0L5.354 5.12l-4.898.696c-.441.062-.612.636-.283.95l3.523 3.356-.83 4.73zm4.905-2.767-3.686 1.894.694-3.957a.565.565 0 0 0-.163-.505L1.71 6.745l4.052-.576a.525.525 0 0 0 .393-.288L8 2.223l1.847 3.658a.525.525 0 0 0 .393.288l4.052.575-2.906 2.77a.565.565 0 0 0-.163.506l.694 3.957-3.686-1.894a.503.503 0 0 0-.461 0z"/>
                                </svg>
                            </span>4.99 · <u>150 reviews</u></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between mt-3">
            <div class="activity-title">
                <label class="fw-bold mb-3 col-md-12 col-12">@actModel.Title</label>
                <span class="col-md-12 col-12">
                    @if(actModel.ExperienceType.Id == 1)
                    {
                         <i class="fas fa-map-marker-alt mx-1" aria-hidden="true"></i>
                    }
                    else
                    {
                        <i class="fa fa-laptop mx-1" aria-hidden="true"></i>
                    }
                    
                    @actModel.ExperienceType.Name
                </span>
            </div>
        </div>
    </div>
    
    <div class="description-container py-4 d-flex flex-lg-row flex-md-row flex-sm-column flex-column col-lg-10 col-md-10 col-sm-12 col-12">
        <div class="flex-fill col-lg-12 col-md-12 col-sm-12 col-12 order-sm-last order-md-first order-lg-first order-last d-flex flex-column">
           <div class="col-12 d-flex flex-lg-row flex-md-row flex-sm-column flex-column">
                <div class="description-container pe-3 mt-lg-0 mt-md-0 mt-3 mt-sm-3 col-lg-8 col-md-8 col-sm-12 col-12 order-sm-last order-md-first order-lg-first order-last">
                @if (String.IsNullOrEmpty(actModel.Description))
                {
                    <h3>@Resources.App.detailDescription1</h3>
                    <p>
                        @actModel.DescriptionSectionModel.Description
                    </p>
                }
                else {
                    <p>
                        @(
                        (MarkupString)actModel.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>")
                        )
                    </p>
                }
            </div>
            @if(Customer != null)
            {
                <div class="col-lg-4 col-md-4 col-sm-12 col-12 order-sm-first order-md-last order-lg-last order-first">
                    <div class="profile-container w-100 shadow rounded-3 d-flex" style="background:#F3F6FC">
                    <img class="rounded-2 rounded-circle m-3" src="@Customer.ProfilePath" width="60" height="60" />
                    <div class="d-flex flex-column m-2">
                        <span>Owner</span>
                        <span>@Customer.FirstName @Customer.LastName</span>
                        <label>View Profile</label>
                    </div>
                    <div class="d-flex flex-column justify-content-center align-items-end flex-grow-1">
                        <img class="px-3" src="images/check.svg" />
                    </div>
                    </div>
                </div>
            }
            else{
                   <div class="col-lg-4 col-md-4 col-sm-12 col-12 order-sm-first order-md-last order-lg-last order-first">
                    <div class="profile-container w-100 shadow rounded-3 d-flex" style="background:#F3F6FC">
                    <img class="rounded-2 rounded-circle m-3" src="/images/Profile/user.png" width="60" height="60" />
                    <div class="d-flex flex-column m-2">
                        <span>Sample Owner</span>
                        <span>Owner Name</span>
                        <label>View Profile</label>
                    </div>
                    <div class="d-flex flex-column justify-content-center align-items-end flex-grow-1">
                        <img class="px-3" src="images/check.svg" />
                    </div>
                    </div>
                </div>
            }
                <hr class="d-block d-sm-block d-md-none"/>
        </div>
            <hr />
            <div class="col-12">
                <label class="fw-bold mb-3">Schedule of @(actModel.ScheduleList.Count > 1 ? "activities":"activity")</label>
                <div class="d-flex flex-row gap-2 mb-2">
                    @if (actModel.ScheduleIndicator == "selection" || actModel.ScheduleList.Count > 0)
                    {
                        @if(string.IsNullOrEmpty(actModel.Schedules))
                        {

                            @for (int x = 0; x < actModel.ScheduleList.Count; x++)
                            {
                                @if(x<=3)
                                {
                                    <div class="col-md-3">
                                        <CarouselItemSchedule ScheduleModel="@actModel.ScheduleList.ElementAt(x)"></CarouselItemSchedule>
                                    </div>
                                }
                                else{
                                    break;
                                }
                            }
                        }
                        else
                        {
                            if (actModel.Schedules.Split("\r\n\r\n").Length > 1)
                            {
                                @for (int x = 0; x < actModel.Schedules.Split("\r\n\r\n").Length; x++)
                                {
                                    <div class="carousel-item @(x==0 ? "active" : "")">
                                        <div class="@(actModel.Schedules.Split("\r\n\r\n").Length <= 2 ? "col-lg-6 col-md-6" : "col-lg-4 col-md-4") col-sm-12 col-12">
                                            <CarouselItem Text="@actModel.Schedules.Split("\r\n\r\n").ElementAt(x)"></CarouselItem>
                                        </div>
                                            <div class="@(actModel.Schedules.Split("\r\n\r\n").Length <= 2 ? "col-lg-6 col-md-6" : "col-lg-4 col-md-4") col-sm-12 col-12">
                                            @if (x + 1 >= actModel.Schedules.Split("\r\n\r\n").Length)
                                            {
                                                <CarouselItem Text="@actModel.Schedules.Split("\r\n\r\n").ElementAt(0)"></CarouselItem>
                                            }
                                            else
                                            {
                                                <CarouselItem Text="@actModel.Schedules.Split("\r\n\r\n").ElementAt(x+1)"></CarouselItem>
                                            }
                                        </div>
                                        @if (actModel.Schedules.Split("\r\n\r\n").Length > 2)
                                        {
                                            <div class="@(actModel.Schedules.Split("\r\n\r\n").Length <= 2 ? "col-lg-6 col-md-6" : "col-lg-4 col-md-4") col-sm-12 col-12">
                                                @if (x + 2 >= actModel.Schedules.Split("\r\n\r\n").Length)
                                                {
                                                    <CarouselItem Text="@actModel.Schedules.Split("\r\n\r\n").ElementAt(0)"></CarouselItem>
                                                }
                                                else
                                                {
                                                    <CarouselItem Text="@actModel.Schedules.Split("\r\n\r\n").ElementAt(x+2)"></CarouselItem>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else{
                                    <div class="carousel-item active">
                                    <div class="col-lg-2 col-md-2">
                                    </div>
                                        <div class="col-lg-8 col-md-8">
                                        <CarouselItem Text="@actModel.Schedules"></CarouselItem>
                                    </div>
                                        <div class="col-lg-2 col-md-2">
                                    </div>
                                </div>
                            }
                        }
                    }
                    else{
                        <div class="px-4">
                            <span>
                                @((MarkupString)actModel.Schedules.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>"))
                            </span>
                        </div>
                    }
                </div>
                @if (actModel.ScheduleList.Count > 4)
                {
                    <button class="btn-primary shadow-sm border-0 p-2 rounded" @onclick="()=>ModalSched.Open()">
                        Show more
                    </button>
                }
            </div>
            <hr />
            <div class="d-flex flex-column align-items-start col-lg-6 col-md-6 col-sm-12 col-12">
                <label class="fw-bold mb-3">Where you’ll be</label>
                @if(string.IsNullOrEmpty(actModel.MapDetails))
                {
                    @if(actModel.ExperienceType.Id == 1)
                    {
                     var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q="+actModel.Address.Address1+"+"+actModel.Address.Address2+"+"+actModel.Address.District+"+"+actModel.Address.City;
                        <iframe id="mapframe"
                          frameborder="0" style="border:0"
                          src="@map"
                          allowfullscreen>
                        </iframe>
                    <span class="mt-3">
                        @(actModel.Address.Address1+", "+actModel.Address.Address2+", "+actModel.Address.District+", "+actModel.Address.City)
                    </span>
                    }
                    else{
                        <span class="mt-3">
                            @actModel.ExperienceType.Name
                        </span>
                    }
                }
                else{
                    @if (!actModel.MapDetails.Contains("Online"))
                    {
                        var map = "https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q="+actModel.MapDetails.Replace(" ","+");
                        <iframe id="mapframe"
                          frameborder="0" style="border:0"
                          src="@map"
                          allowfullscreen>
                        </iframe>
                    }
                    <span class="mt-3">
                        @actModel.MapDetails
                    </span>
                }
          
            </div>
            @if (String.IsNullOrEmpty(actModel.Description))
            {
                <hr />
                <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                    <label class="fw-bold mb-3">What's included</label>
                    <p>
                        @actModel.DescriptionSectionModel.SpecificsYouWillProvide
                    </p>
                </div>
                <hr />
                <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                    <label class="fw-bold mb-3">What you should bring</label>
                    <p>
                        @actModel.DescriptionSectionModel.CustomerBringWithThem
                    </p>
                </div>
                <hr />
                <div class="col-lg-6 col-md-6 col-sm-12 col-12"style="overflow-wrap:break-word;">
                    <label class="fw-bold mb-3">Requirements</label>
                    <p>
                        Minimum Age: @actModel.DescriptionSectionModel.MinimumAge
                        <br>
                        Adults: @actModel.DescriptionSectionModel.CanAdultsJoin
                        <br>
                        Levels of Activity: @actModel.DescriptionSectionModel.ActivityLevel
                        <br>
                        Skill Level: @actModel.DescriptionSectionModel.SkillLevel
                    </p>
                </div>
                if(!string.IsNullOrEmpty(actModel.DescriptionSectionModel.AdditionalRequirements))
                {
                    <hr />
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" style="overflow-wrap:break-word;">
                        <label class="fw-bold mb-3">Additional Requirements</label>
                        <p>
                            @actModel.DescriptionSectionModel.AdditionalRequirements
                        </p>
                    </div>
                }
            }
            <hr />
            <div class="end-container d-flex flex-column">
                <span class="landing-header color-primary fs-2">@Resources.App.appName</span>
                <span>
                    Not happy with the experience? <br /> Contact us and we'll solve the problem for you.
                </span>
            </div>
        </div>
    </div>
</div>
<SchedulesModal @ref="ModalSched" ScheduleModel="actModel.ScheduleList.ToList()"></SchedulesModal>

<!--Beta Alert-->
@*<BetaAlert></BetaAlert>*@
@code {
    IJSObjectReference module;
    [Parameter]
    public int Id { get; set; }

    public List<ActivityModel> ActivityModel = new List<ActivityModel>();
    public List<ActivityImagesModels> _Images = new List<ActivityImagesModels>();
    public ActivityModel actModel = new ActivityModel();
    public DescriptionSectionModel DescriptionSection = new DescriptionSectionModel();
    public AddressModel Address = new AddressModel();
    private SchedulesModal ModalSched { get; set; }
    private CustomerModel Customer { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Experience Details Page Loaded");
        }
    }
    protected override async Task OnInitializedAsync()   
    {
        ActivityModel = Task.Run(() => CoreDI.DataStore.Activities.GetAllAsync()).Result;
        _Images =  Task.Run(()=>CoreDI.DataStore.ActivityImages.GetAllAsync()).Result.Where(c => c.ImageId == Id).ToList();
        actModel = ActivityModel.Where(c => c.Id == Id).ElementAt(0);
        Customer = await CoreDI.DataStore.Customers.GetCustomerById(actModel.CreatedBy);
    }
}
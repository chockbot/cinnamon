                <span>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore</span>
                </div>
                </div>*@
            </div>
            <div class="calendar-container d-flex flex-column mt-5">
                @*<label class="fw-bold">7 Nights in northamptonshire</label>
                <input type="text" name="datetimes" />*@
                <img class="w-100" src="images/calendar-pictures.png" />
            </div>
            <hr />
            <div class="d-flex flex-column align-items-start">
                <label class="fw-bold">Where you’ll be</label>
                <img class="w-100" style="margin-left:-15px;" src="images/map_picture.png" />
                @*           <span class="fw-bold">Northamptonshire, England, United Kingdom</span>

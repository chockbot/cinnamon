    private string GetPriceLabel(string price)
    {
        string result = "₱ 0.00";
        decimal fromAmount = 0;
        decimal toAmount = 0;
        try
        {
            var prices = price.Split("/").Where(s => !string.IsNullOrEmpty(s)).ToArray();
            if(prices.Length > 0)
            {
                var amountPrice = prices[0].Trim().Split("-").Where(s => !string.IsNullOrEmpty(s)).ToArray();
                if(amountPrice.Length > 0)
                {
                    var trimmed = amountPrice[0].Trim().Split("PHP").Where(s => !string.IsNullOrEmpty(s)).ToArray();
                    fromAmount = Convert.ToDecimal(trimmed[0].Trim());
                }
                if(amountPrice.Length > 1)
                {
                    toAmount = Convert.ToDecimal(amountPrice[1].Trim());
                }
            }
            if(toAmount > 0) result = $"₱ {string.Format("{0}", (long)fromAmount)} - {string.Format("{0}", (long)toAmount)}";
            else result = $"₱ {string.Format("{0}", (long)fromAmount)}";
            return result;
        }
        catch(Exception)
        {
            return result;
        }
    }


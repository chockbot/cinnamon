    protected override async Task OnInitializedAsync()
    {
        LoadRedirectUrls();

        //Search in Landing Page
        if (string.IsNullOrEmpty(landingSearch))
        {
            await Task.WhenAll(new Task[] {FetchPopularActivities(null), FetchActivities(false)});
        }
        else
        {
            searchValue = landingSearch;
            await Search();
        }
        //Search by Filter
        if (!string.IsNullOrEmpty(filterSearch))
        {
            int filter = int.Parse(filterSearch);
            await Filter(filter);
        }

        await LoadSigninUser();
        await GetFavorites();
        showOverlayPopularActivities = false;

        // get experience categories
        var experienceCategory = await activityApiHandler.GetExperienceCategories();
        if (experienceCategory.Succeeded && experienceCategory.Result != null && experienceCategory.Result.IsSuccess)
        {
            categories = experienceCategory.Result.Result.Select(i =>
            {
                return new ExperienceCategory
                    {
                        Id = i.Id,
                        Category = i.Name,
                        IconPath = i.IconPath
                    };
            }).ToList();
        }
        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if (experienceTypes.Succeeded && experienceTypes.Result != null && experienceTypes.Result.IsSuccess)
        {
            experiencesType = experienceTypes.Result.Result.Select(i =>
            {
                return new ExperienceType
                    {
                        Id = i.Id,
                        Name = i.Name
                    };
            }).ToList();
        }
        exptype = experiencesType.Where(a => a.Id == 2).ElementAt(0);
        Model = new ExploreModel
            {
                ExperienceCategories = categories,
                ExperienceTypes = experiencesType
            };

        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
            await LoadWelcomeDialog();
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", "#explore-category-scrollbar");
        await InitializeSwiper();

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        //Check if login via FB
        if (uri.AbsolutePath.Contains("facebook-login"))
        {
            if (IsNewUser == true)
            {
                isLoginFB = true;
                await signinModal.Show();
            }
            else
            {
                await fbUpdateModal.Show();
            }
        }
        else
        {
            var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
            var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);
            try
            {
                if (userSuccess && tokenSuccess)
                {
                    var verifyRes = await accountApiHandler.VerifyRegisteredEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyRegisteredEmailArgs
                        {
                            Token = token,
                            UserId = userId
                        });
                    if ((!verifyRes.Succeeded || verifyRes.Result == null) || (verifyRes.Succeeded && !verifyRes.Result.IsSuccess))
                    {
                        // invalid guid
                        return;
                    }

                    // try to register again to check if already have account details
                    var checkRegistered = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs
                        {
                            Email = verifyRes.Result.Result.Email,
                            ValidationRoute = AppConfig.BaseUrl + "/explore"
                        });
                    if (!checkRegistered.Succeeded || checkRegistered.Result == null)
                    {
                        // error
                        return;
                    }

                    if (checkRegistered.Succeeded && !checkRegistered.Result.IsSuccess)
                    {
                        if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED-VERIFIED")
                        {
                            if (CustomerModel.CustomerProfile != null)
                            {
                                Email        = CustomerModel.CustomerProfile.Email;
                                NewEmail     = verifyRes.Result.Result.Email;
                                Birthday     = CustomerModel.CustomerProfile.Birthdate;
                                //Show update password modal
                                updatePasswordModal.Show(Email, NewEmail);
                            }
                            else
                            {
                                 modalFinishSignUp.OpenModal(verifyRes.Result.Result.Email);
                            }
                        }
                        if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED")
                        {
                            await modalPassword.OpenModal(verifyRes.Result.Result.Email);
                        }
                    }
                }
            }
            catch (Exception e)
            {
                e.Message.ToString();
            }
        }

    }


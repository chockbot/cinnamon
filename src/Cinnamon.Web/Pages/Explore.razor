    private async Task FetchActivities(bool isFromScroll)
    {
        isLoading = true;

        var activityFeedRes = await activityApiHandler.ActivityFeed(new Framework.ApiCommand.ApiCore.Activity.Request.ActivityFeedArgs
        {
            CategoryId = experienceCategoryId,
            Search = searchValue,
            Skip = pageIndex,
            Take = itemsPerPage,
            ExperienceType = filters.EventType,
            ExperienceCategory = ExperienceCategory,
            StarReview = filters.StarReview
        });

        if (activityFeedRes.Succeeded && activityFeedRes.Result != null && activityFeedRes.Result.IsSuccess)
        {
            var feeds = mapper.Map<IEnumerable<ActivityFeed>>(activityFeedRes.Result.Result);
            if (feeds.Count() > 0)
            {
                if (isFromScroll)
                {
                    activityFeeds.AddRange(feeds);
                }
                else
                {
                    activityFeeds = feeds.ToList();
                }

                pageIndex = pageIndex + feeds.Count();
                itemsPerPage = 15;

                hasNoMoreRecords = false;
            }
            else
            {
                hasNoMoreRecords = true;

                if (!isFromScroll)
                    activityFeeds = new();
            }
        }

        isLoading = false;
    }

    private async Task FetchPopularActivities(int? categoryId)
    {
        showOverlayPopularActivities = true;

        popularFeeds.Clear();

        var activitiesRes = await activityApiHandler.PopularActivities(new Framework.ApiCommand.ApiCore.Activity.Request.PopularActivitiesArgs {
            CountPerPage = 20,
            PageIndex = 0,
            CategoryId = categoryId
        });
        if(activitiesRes.Succeeded && activitiesRes.Result is not null && activitiesRes.Result.IsSuccess)
        {
            var popular = mapper.Map<IEnumerable<ActivityFeed>>(activitiesRes.Result.Result);
            popularFeeds.AddRange(popular);
        }
        showOverlayPopularActivities = false;
    }
    

@*<FilterModal OnSelectedIdsChanged="OnFilterSelectedChanged"></FilterModal>*@
<ModalFinishSignUp @ref="modalFinishSignUp"></ModalFinishSignUp>
<ModalPassword @ref="modalPassword"></ModalPassword>
</html>
@code {
    public ExploreModel Model= new ExploreModel();
    public Profile CustomerModel= new Profile();
    public List<ExperienceCategory>      categories         = new List<ExperienceCategory>();
    public List<ExperienceType>          experienceTypes    = new List<ExperienceType>();
    public ExperienceType                experienceType     = new ExperienceType();
    public List<ActivityAddress>         addresses          = new List<ActivityAddress>();
    public ActivityAddress               address            = new ActivityAddress();
    public List<ActivityImage>           activityImages     = new List<ActivityImage>();
    public List<ActivityImage>           images             = new List<ActivityImage>();
    public CustomerProfile               customers          = new CustomerProfile();
    public List<Activity>                activities         = new List<Activity>();
    public string                        searchValue        = string.Empty;
    public string                        filterId           = string.Empty;
    public int                           cnt                = 0;
    private string                       value              { get; set; }
    public bool                          clickButton        { get; set; }
    public ClaimsPrincipal               AuthState          { get; set; }
    private ModalFinishSignUp            modalFinishSignUp  { get; set; }
    private ModalPassword                modalPassword      { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // get experience categories
        var experienceCategory = await activityApiHandler.GetExperienceCategories();
        if (experienceCategory.Succeeded && experienceCategory.Result != null && experienceCategory.Result.IsSuccess)
        {
            categories = experienceCategory.Result.Result.Select(i =>
            {
                return new ExperienceCategory
                    {
                        Id = i.Id,
                        Category = i.Name,
                        IconPath = i.IconPath
                    };
            }).ToList();
        }

        //get experience type
        var experiencetype = await activityApiHandler.GetExperienceTypes();
        if (experiencetype.Succeeded && experiencetype.Result != null && experiencetype.Result.IsSuccess)
        {
            experienceTypes = experiencetype.Result.Result.Select(i =>
            {
                return new ExperienceType
                    {
                        Id = i.Id,
                        Name = i.Name
                    };
            }).ToList();
        }
        
        // get experience addresses
        var address = await activityApiHandler.GetAddress();
         if (address.Succeeded && address.Result != null && address.Result.IsSuccess)
        {
            addresses = address.Result.Result.Select(a =>
            {
                return new ActivityAddress
                    {
                       ActivityId=a.ActivityId,
                       Address1 = a.Address1,
                       Address2 = a.Address2,
                       City = a.City,
                       District = a.District,
                       Id = a.Id
                    };
            }).ToList();
        }
        //get activity images
        var activityImage = await activityApiHandler.GetActivityImages();
        if (activityImage.Succeeded && activityImage.Result != null && activityImage.Result.IsSuccess)
        {
            activityImages = activityImage.Result.Result.Select(i =>
            {
                return new ActivityImage
                {
                    Id= i.Id,
                    ActivityId = i.ActivityId,
                    ImageSrc = i.ImageLocation,
                    Name   = i.ImageName
                };
            }).ToList();
        }
        Model = new ExploreModel
            {
                ExperienceCategories = categories,
                Address = addresses,
                ActivityImages = activityImages,
                ExperienceTypes = experienceTypes

            };

        AuthState = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = AuthState.FindFirstValue("Token");

        if (AuthState != null && AuthState.Identity.IsAuthenticated)
        {
            var email = AuthState.FindFirstValue(ClaimTypes.Email);
            //Get Customer by Email
            var customer = await accountApiHandler.GetCustomerByEmail(token, email);
            CustomerModel = new();
            if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
            {
                var args = customer.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                {
                    Birthdate = args.Birthdate,
                    Email = args.Email,
                    FirstName = args.FirstName,
                    LastName = args.LastName,
                    Id = args.Id,
                    IsMaker = args.IsMaker,
                    IsVerified = args.IsVerified,
                };
            }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
        }

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
        var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);

        try
        {
            if (userSuccess && tokenSuccess)
            {
                var waitingRes = await accountApiHandler.GetWaitListByGuid(token,userId);
                if(waitingRes == null)
                {
                    // invalid guid
                    NavigationManager.NavigateTo("/onboarding", forceLoad: true);
                    return;
                }
                // check if email already verified so that will not call verify email every request
                if(!waitingRes.Result.Result.IsVerified)
                {
                    // need to verified
                    var verifyRes = await accountApiHandler.VerifyRegisteredEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyRegisteredEmailArgs
                        {
                            Token  = CustomerModel.Token,
                            UserId = userId
                        });
                    if ((!verifyRes.Succeeded || verifyRes.Result == null) || (verifyRes.Succeeded && !verifyRes.Result.IsSuccess))
                    {
                        // invalid userid and token redirect to onboargin page
                        NavigationManager.NavigateTo("/onboarding");
                        return;
                    }
                    // proceed to populate customer information
                    await modalFinishSignUp.OpenModal(waitingRes.Result.Result.Email);
                }
                else 
                {
                    var customerRes = await accountApiHandler.GetCustomerByEmail(token, waitingRes.Result.Result.Email);
                    if(customerRes == null)
                    {
                        await modalFinishSignUp.OpenModal(waitingRes.Result.Result.Email);
                    }
                    else
                    {
                        await modalPassword.OpenModal(waitingRes.Result.Result.Email);
                    }
                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }
    }

    private async Task FetchActivities()
    {
        var ActivityListData = await activityApiHandler.GetAllActivities();
        if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
        {
            activities = ActivityListData.Result.Result.Select(r =>
            {
                return new Activity
                    {
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin
                    };
            }).ToList();
            Model = new ExploreModel
            {
                Activities = activities
            };
        }
    }
    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/maker/dashboard");
    }

    private void NavigateToAccount()
    {

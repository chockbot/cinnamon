@code {
    public List<ActivityModel> activity              = new List<ActivityModel>();
    public List<ActivityTypeModel> activityTypes     = new List<ActivityTypeModel>();
    public List<ActivityImagesModels> activityImages = new List<ActivityImagesModels>();
    public List<ActivityImagesModels> images         = new List<ActivityImagesModels>();
    public List<AddressModel> Address                = new List<AddressModel>();
    public List<UserListModel> UserList = new List<UserListModel>();
    public UserListModel UserModel                    = new UserListModel();
    public string searchValue                        = string.Empty;
    public string filterId                           = string.Empty;
    public int cnt                                   = 0;
    private string value { get; set; }
    public bool clickButton { get; set; }
    public AuthenticationState AuthState { get; set; }


    protected override async Task OnInitializedAsync()
    {
        activity        = (await CoreDI.DataStore.Activities.GetAllAsync()).Where(i => i.IsPublished).ToList();
        Address         = await CoreDI.DataStore.Addresses.GetAllAsync();
        activityImages  = await CoreDI.DataStore.ActivityImages.GetAllAsync();
        activityTypes   = await CoreDI.DataStore.ActivityTypes.GetAllAsync();

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if(AuthState != null)
        {
            UserList = await CoreDI.DataStore.User.GetAllAsync();
            UserModel = UserList?.FirstOrDefault(x => x.Email == AuthState.User.FindFirstValue(ClaimTypes.Email));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
        }
    }

    private void NavigateToFAQPage()
    {
        NavigationManager.NavigateTo("FAQ");
    }
    private void NavigateToPolicyPage()
    {
        NavigationManager.NavigateTo("policy");
    }
    private void NavigateToTermsPage()
    {
        NavigationManager.NavigateTo("terms");
    }
    private void NavigateToOnboardingPage()
    {
        NavigationManager.NavigateTo("Onboarding");
    }
      private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/maker/dashboard");
    }
    private void onClickMenu(){
        if(clickButton)
        {
            clickButton = false;
        }
        else{
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    public async Task Search()
    {
        activity       = await CoreDI.DataStore.Activities.GetAllAsync();
        if(searchValue!= string.Empty)
        {
            activity   = activity.Where(p => CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Location,
            searchValue, CompareOptions.IgnoreCase) >= 0 || CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Title,
            searchValue, CompareOptions.IgnoreCase) >= 0).ToList();
        }
        else
        {
            activity  = await CoreDI.DataStore.Activities.GetAllAsync();
            activity = activity.Where(i => i.IsPublished).ToList();
        }
    }
    public async Task Filter(int id, string type)
    {
        searchValue = type;
        activity    = await CoreDI.DataStore.Activities.GetAllAsync();
        activity    = activity.Where(p=> p.Id == id && p.IsPublished).ToList();

    }
    public async Task Clear()
    {
        searchValue = string.Empty;
        activity    = await CoreDI.DataStore.Activities.GetAllAsync();
        activity = activity.Where(p => p.IsPublished).ToList();
    }
}
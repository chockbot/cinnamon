<SeoMeta Url="/explore" Keywords="GetKeyWords()">
    <ExtraMeta>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
        <title>Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH</title>
    </ExtraMeta>
</SeoMeta>

<input type="password" name="password_fake" id="password_fake" value="" style="display:none;" />
    <!--Search-->
    <div class="top-row px-4">
        <!--App Name-->
        <div class="app-name col-lg-2 col-md-2">
            <a href="" class="app-name">@Resources.App.appName</a>
        </div>
        <!--Search Location and Experience-->
        <div class="col-lg-6 d-flex justify-content-end col-md-8 d-flex justify-content-center col-sm-10 d-flex flex-row justify-content-start col-11 d-flex flex-row justify-content-start">
            <div class="home-logo">
                <a class="button" href="#">
                    <img src="images/Home.png" class="img-icon-home">
                </a>
            </div>
            <form class="search-bar" @onsubmit=Search>
                <div class="input-group border rounded-pill p-1">
                    <input type="text" placeholder="Location | Experience" id="19d13aa1-90c0-4232-a7bc-62a772baa223" autocomplete="new-password" @bind-value="searchValue" aria-describedby="btn-search" class="form-control bg-none border-0" style="outline: none;box-shadow: none;">
                    <div class="input-group-append border-0">
                        <button id="btn-clear" type="button" class="btn border-0" @onclick="Clear"><i class="fa fa-times" style="color:#8C8C8C"></i></button>
                        <button id="btn-search" type="button" @onclick="Search" class="btn btn-link text-success"><i class="fa fa-search" style="color:white"></i></button>
                    </div>
                </div>
            </form>
        </div>
        <!--Menu-->
        <div class="col-lg-4 d-flex justify-content-end col-md-2 d-flex justify-content-end col-sm-2 d-flex justify-content-end col-1 d-flex justify-content-end dropdown-section">
            @if (CustomerModel.CustomerProfile != null && CustomerModel.CustomerProfile.IsMaker)
            {
                <div class="become">
                    <a @onclick="NavigateToDashboard" class="btn border-0">Go to Dashboard</a>
                </div>
            }
            else
            {
                <div class="become">
                    <a href="/Onboarding" class="btn border-0">Become an Activity Provider</a>
                </div>
            }
            @*Desktop*@
            <div class="dropdown">
                <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                    <div class="menu">
                        <img src="images/menu.png">
                        @if (CustomerModel.CustomerProfile != null)
                        {
                            @if (newMessagesCount != 0)
                            {
                                <span class="new-message-count-badge">
                                    @newMessagesCount
                                </span>
                            }
                        }
                    </div>
                </button>
                <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                    @if (AuthState != null)
                    {
                        @if (AuthState.Identity.IsAuthenticated)
                        {
                            if (CustomerModel.CustomerProfile != null && CustomerModel.CustomerProfile.IsMaker)
                            {
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToAttendance" Text="Check Attendance" />
                                </li>
                                <li class="dropdown-item messages-item">
                                    <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                    @if (hasNewMessages)
                                    {
                                        <span class="has-new-message-badge">
                                        </span>
                                    }
                                </li>
                            }
                            else
                            {
                                 <li class="dropdown-item messages-item">
                                    <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                    @if (hasNewMessages)
                                    {
                                        <span class="has-new-message-badge">
                                        </span>
                                    }
                                </li>
                            }
                            <li class="dropdown-item">
                                <NavButton OnClick="NavigateToAccount" Text="Account" />
                            </li>
                            <li class="dropdown-item">
                                <Button Border="Border.Is0" Clicked="Logout">
                                    Logout
                                </Button>
                            </li>
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                    Help
                                </Button>
                            </li>
                        }
                        else
                        {
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="() => signinModal.Show()">
                                    @Resources.App.Sign
                                </Button>
                            </li>
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                    Help
                                </Button>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="dropdown-item">
                            <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="() => signinModal.Show()">
                                @Resources.App.Sign
                            </Button>
                        </li>
                        <li class="dropdown-item">
                            <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                Help
                            </Button>
                        </li>
                    }
                </ul>
            </div>
            @*Mobile*@
            <div class="dropdown-mobile">
                <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                    <div class="menu">
                        <img src="images/menu.png">
                        @if (CustomerModel.CustomerProfile != null)
                        {
                            @if (newMessagesCount != 0)
                            {
                                <span class="new-message-count-badge">
                                    @newMessagesCount
                                </span>
                            }
                        }
                    </div>
                </button>
                <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                    @if (AuthState != null)
                    {
                        @if (AuthState.Identity.IsAuthenticated)
                        {
                            if (CustomerModel.CustomerProfile != null && CustomerModel.CustomerProfile.IsMaker)
                            {
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToAttendance" Text="Check Attendance" />
                                </li>
                                <li class="dropdown-item messages-item">
                                    <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                    @if (hasNewMessages)
                                    {
                                        <span class="has-new-message-badge">
                                        </span>
                                    }
                                </li>
                            }
                            else if (CustomerModel.CustomerProfile != null && !CustomerModel.CustomerProfile.IsMaker)
                            {
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToOnboarding" Text="Become an Activity Provider" />
                                </li>
                                <li class="dropdown-item messages-item">
                                    <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                    @if (hasNewMessages)
                                    {
                                        <span class="has-new-message-badge">
                                        </span>
                                    }
                                </li>
                            }
                            <li class="dropdown-item">
                                <NavButton OnClick="NavigateToAccount" Text="Account" />
                            </li>
                            <li class="dropdown-item">
                                <Button Border="Border.Is0" Clicked="Logout">
                                    Logout
                                </Button>
                            </li>
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                    Help
                                </Button>
                            </li>
                        }
                        else
                        {
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="() => signinModal.Show()">
                                    @Resources.App.Sign
                                </Button>
                            </li>
                            <li class="dropdown-item">
                                <NavButton OnClick="NavigateToOnboarding" Text="Become an Activity Provider" />
                            </li>
                            <li class="dropdown-item">
                                <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                    Help
                                </Button>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="dropdown-item">
                            <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="() => signinModal.Show()">
                                @Resources.App.Sign
                            </Button>
                        </li>
                        <li class="dropdown-item">
                            <Button Type="ButtonType.Button" Border="Border.Is0" Clicked="NavigateToHelp">
                                Help
                            </Button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <!--Section 1-->
    <div class="container">
        <div class="section-1 row">
            <div class="categories border-bottom">
                <div class="row d-flex justify-content-start">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 categories-container">
                        <div class="schedule-swiper">
                            <div class="swiper-wrapper text-center">
                                @foreach (var category in categories)
                                {
                                    <div class="swiper-slide category">
                                        <div>
                                            <a class="button carousel-list text-center" @onclick="@(() => Filter(category.Id, category.Category))">
                                                <img src=@category.IconPath class="img-icon text-center">
                                                <p class="card-title">@category.Category</p>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="swiper-scrollbar"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" style="@SetPlaceholderStyle(showOverlayPopularActivities)">
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            @if (string.IsNullOrEmpty(searchValue) && popularActivities.Count > 0)
            {
                <div class="activity-popular border-bottom" style="@SetActivitiesStyle(showOverlayPopularActivities)">
                    <div class="row d-flex justify-content-start">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <label class="heading">Most Popular</label>
                            <section class="popular-activities mt-4 overflow-hidden">
                                <div class="activities-schedule-section activity-swiper">
                                    <div class="swiper-wrapper">
                                        @foreach (var act in popularActivities)
                                        {
                                            <div @key="act" class="swiper-slide swiper-slide-popular">
                                                <Div ElementId="#b-animate">
                                                    <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                                                        <div class="card activities-card">
                                                            <div class="card-img img-fluid position-relative">
                                                                <a class="button" href="@DetailsUrl(act.Handler, (int)act.ExperienceCreationTypeId)" style="text-decoration:none;" target="_blank">
                                                                    <img src="@act.ImageSrc" alt="banner image" class="img-zoom-effect" />
                                                                </a>
                                                                @if (act.OngoingStudentCount > 0)
                                                                {
                                                                    <CustomTooltip MarginLeft="-100">
                                                                        <TextContent>
                                                                            <div class="rounded-pill ongoing-section">
                                                                                <div class="active-badge" style="text-align:center">
                                                                                    <span class="pulse"></span>
                                                                                    <span class="active-tag-label">@act.OngoingStudentCount</span>
                                                                                </div>
                                                                            </div>
                                                                        </TextContent>
                                                                        <TooltipContent>
                                                                            <span class="color-grey-100">
                                                                                Ongoing Enrollees
                                                                            </span>
                                                                        </TooltipContent>
                                                                    </CustomTooltip>
                                                                }
                                                                @if(CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                                                {
                                                                    act.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == act.Id && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                                                    if (act.IsFavorite)
                                                                    {
                                                                        <div class="favorite-section">
                                                                            <button type="button" class="favorite-icon-button border-0" @onclick="() => AddFavoritePopularAtivity(act)">
                                                                                <img src='@(act.IsFavorite ? "images/favorites/experience-heart-selected.svg" : "images/favorites/experience-heart-default.svg")' class="favorite-icon" />
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="favorite-section">
                                                                            <button type="button" class="favorite-icon-button border-0" @onclick="() => CreateFavoritePopularAtivity(act)">
                                                                                <img src="images/favorites/experience-heart-default.svg" class="favorite-icon" />
                                                                            </button>
                                                                        </div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <div class="favorite-section">
                                                                        <button type="button" class="favorite-icon-button border-0">
                                                                            <img src="@addToFavorites" class="favorite-icon" @onclick= "() =>signinModal.Show()" />
                                                                        </button>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div class="card-container">
                                                                <div class="row text-start star-pulse-section">
                                                                    <div class="col-12 col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 star-section">
                                                                        @if (act.ReviewCount > 0)
                                                                        {
                                                                            <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                                            <span class="average-rating">@act.Rating</span>
                                                                            <span class="number-of-reviews">(@act.ReviewCount)</span>
                                                                        }
                                                                        else if (act.IsNew)
                                                                        {
                                                                            <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                                            <span class="new-experience-label">New Experience</span>
                                                                        }
                                                                    </div>
                                                                    <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 pulse-section">
                                                                    </div>
                                                                </div>
                                                                <div class="row text-start">
                                                                    <div class="title-section">
                                                                        <div>
                                                                            <h4 class="card-title1 mb-0">@act.Title</h4>
                                                                            @if (@act.ExperienceTypeId == 1)
                                                                            {
                                                                                var address = !string.IsNullOrEmpty(act.CityName) ? act.CityName + ", "+ act.RegionName: act.PinnedLocation;
                                                                                <p class="card-title2 mb-0 in-person">@address</p>
                                                                            }
                                                                            else
                                                                            {
                                                                                <p class="card-title2 mb-0 online">@(act.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row price-badge-section">
                                                                    <div class="col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 price-section"><p class="card-title3 mb-0">@GetPriceLabel(act.Price)</p></div>
                                                                    <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 active-badge-section">
                                                                    </div>
                                                                </div>
                                                                @if(act.ExperienceCreationTypeId == 3)
                                                                {
                                                                    <div class="mt-2">
                                                                        <span class="bg-green-100 color-white-100 font-12 rounded-pill px-2 py-1">
                                                                            One time event
                                                                        </span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </Animate>
                                                </Div>
                                            </div>
                                        }
                                    </div>
                                    <div class="activity-swiper-scrollbar"></div>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!--Section 2-->
        <div class="section-2-lg row">
            <div class="row" style="@SetPlaceholderStyle(showOverlayPopularActivities)">
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                    <div class="card card-placeholder-popular" aria-hidden="true">
                        <rect width="100%" height="100%" fill="#868e96"></rect>
                        <div class="card-body">
                            <p class="card-text placeholder-glow">
                                <span class="placeholder col-12 placeholder-image"></span>
                                <span class="placeholder col-10"></span>
                                <span class="placeholder col-9"></span>
                                <span class="placeholder col-7"></span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row d-flex justify-content-start" style="@SetActivitiesStyle(showOverlayPopularActivities)">
                <div style="margin-bottom:20px;">
                    <div class="d-none d-sm-block d-md-block d-lg-block d-xl-block">
                        <label class="heading" style="@SetActivitiesStyle(showOverlayPopularActivities)">Keep exploring for more options</label>
                    </div>
                    <div class="d-block d-sm-none d-md-none d-lg-none d-xl-none">
                        <label class="heading">Explore More</label>
                    </div>
                </div>
                @if (activities.Count > 0)
                {
                    InitializeCarouselSwipe();
                }
                @foreach (var act in activities)
                {
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6 d-flex flex-column align-items-center card-activity-body explore-activity-item" style="margin-bottom:30px">
                        <Div ElementId="#b-animate">
                            <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                                <div class="card activities-card">
                                    @if (act.Images.Count > 0)
                                    {
                                        <div class="card-img img-fluid position-relative">
                                            <a class="button carousel-card text-center" href="@DetailsUrl(act.Handler, (int)act.ExperienceCreationType)" target="_blank">
                                                <img src=@act.Images.ElementAt(0).ImageSrc alt="banner image" class="img-zoom-effect">
                                            </a>
                                            @if (act.OngoingStudents > 0)
                                            {
                                                <CustomTooltip MarginLeft="-100">
                                                    <TextContent>
                                                        <div class="rounded-pill ongoing-section">
                                                            <div class="active-badge" style="text-align:center">
                                                                <span class="pulse"></span>
                                                                <span class="active-tag-label">@act.OngoingStudents</span>
                                                            </div>
                                                        </div>
                                                    </TextContent>
                                                    <TooltipContent>
                                                        <span class="color-grey-100">
                                                            Ongoing Enrollees
                                                        </span>
                                                    </TooltipContent>
                                                </CustomTooltip>
                                            }
                                            @if (CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                            {
                                                act.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == act.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                                if (act.IsFavorite)
                                                {
                                                    <div class="favorite-section">
                                                        <button type="button" class="favorite-icon-button border-0" @onclick="() => AddFavoriteActivity(act)">
                                                            <img src='@(act.IsFavorite ? "images/favorites/experience-heart-selected.svg" : "images/favorites/experience-heart-default.svg")' class="favorite-icon" />
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="favorite-section">

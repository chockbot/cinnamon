@page "/explore"
@page "/confirm-email"
@layout EmptyLayout
@using Microsoft.AspNetCore.WebUtilities;
@using Cinnamon.Core.Enums
@using Cinnamon.Core.Models
@using Cinnamon.Core.Module.CinnamonMakerService.Handler;
@using Cinnamon.Web.Components
@using Cinnamon.Data
@using Cinnamon.Core
@using System.Text
@using System.Linq;
@using System.Globalization
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler;
@inject IAccountApiHandler accountApiHandler;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@inject IVerifyEmail verifyEmailHandler;

<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!--Bootstrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
</head>
<body>
@if(Model != null)
{
     <!--Search-->
    <div class="top-row px-4">
        <!--App Name-->
        <div class="app-name col-lg-2 col-md-2">
            <a href="" class="app-name">@Resources.App.appName</a>
        </div>
        <!--Search Location and Experience-->
        <div class="col-lg-6 d-flex justify-content-end col-md-8 d-flex justify-content-center col-sm-11 d-flex flex-row justify-content-start col-11 d-flex flex-row justify-content-start">
            <div class="home-logo">
                <a class="button" href="#">
                    <img src="images/Home.png" class="img-icon">
                </a>
            </div>
            <div class="input-group border rounded-pill p-1">
                <input type="text" placeholder="Location | Experience" @bind-value="searchValue" aria-describedby="button-addon3" class="form-control bg-none border-0">
                <div class="input-group-append border-0">
                    <button id="button-addon3" type="button" class="btn border-0" @onclick="Clear"><i class="fa fa-times" style="color:#8C8C8C"></i></button>
                    <button id="button-addon3" type="button" @onclick="Search" class="btn btn-link text-success" style="background-color:#ffa942; border-radius:50%"><i class="fa fa-search" style="color:white"></i></button>
                </div>
            </div>
        </div>
        <!--Menu-->
        <div class="col-lg-4 d-flex justify-content-end col-md-2 d-flex justify-content-end col-sm-1 d-flex justify-content-end col-1 d-flex justify-content-end">
                <div class="become">
                     <a href="/Onboarding" class="btn border-0">@Resources.App.Become</a>
                </div>
                <div class="dropdown">
                <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                    <div class="menu">
                        <img src="images/menu.png">
@*                        <span class="menu-label">@Resources.App.menu</span>*@
                    </div>
                </button>
                <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">  
                    @if(AuthState != null)
                    {
                        @if(AuthState.User.Identity.IsAuthenticated)
                        {
                            if (CustomerModel.CustomerProfile != null && CustomerModel.CustomerProfile.IsMaker)
                            {
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                </li>
                            }
                            <li class="dropdown-item">
                                <NavButton OnClick="NavigateToAccount" Text="Account" />
                            </li>
                            <li class="dropdown-item">
                                <form class="form-inline" asp-area="Identity" action="Identity/Account/Logout" method="post">
                                    <button type="submit" class="btn border-0">
                                      Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else{
                            <li class="dropdown-item">
                                <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#loginModal">
                                     @Resources.App.Sign
                                </button>
                            </li>
                        }
                    }
                    else{
                        <li class="dropdown-item">
                            <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#sigupModal">
                                 @Resources.App.Sign
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <!--Section 1-->
    <div class="activity-sm">
                <div class="row d-flex justify-content-start">
                    <div class="col-sm-12 col-12">
                        <div id="carouselExampleControls1" class="carousel slide" data-ride="carousel" data-interval="0">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <div class="cards-wrapper">
                                    @foreach (var category in categories)
                                        {
                                            if (category.Id <= 5)
                                            {
                                                <a class="button carousel-list text-center" @onclick="@(() => Filter(category.Id, category.Category))">
                                                    <img src=@category.IconPath class="img-icon text-center">
                                                    <p class="card-title">@category.Category</p>
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                                <div class="carousel-item">
                                    <div class="cards-wrapper">
                                    @foreach (var category in categories)
                                            {
                                                if (category.Id > 5 && category.Id <= 10)
                                                {
                                                    <a class="button carousel-list text-center" @onclick="@(() => Filter(category.Id, category.Category))">
                                                        <img src=@category.IconPath class="img-icon text-center">
                                                        <p class="card-title">@category.Category</p>
                                                    </a>
                                                }
                                        }
                                    </div>
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls1" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls1" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden"></span>
                                </button>
                        </div>
                    </div>
                </div>
            </div>

    <div class="container">
        <div class="section-1 row">
            <div class="activity-lg">
                <div class="col-lg-10 p-4 d-flex justify-content-center">
                    <div class="cards-wrapper">
                            @foreach (var category in categories)
                        {
                            if(category.Id <= 10)
                            {
                                    <a class="button carousel-list text-center" @onclick="@(() => Filter(category.Id, category.Category))">
                                    <img src=@category.IconPath class="img-icon text-center">
                                    <p class="card-title">@category.Category</p>
                                </a>
                            }
                        }
                     </div>
                </div>
                <div class="col-lg-2">
                    <div class="filter">
                        <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#filterModal">
                            <img src="images/filter.png" alt="" class="card-img">
                        </button>
                    </div>
                </div>
            </div>

            <div class="activity-md">
                <div class="col-md-10 p-4">
                        <div id="carousel-md" class="carousel slide" data-ride="carousel" data-interval="0">
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <div class="cards-wrapper">
                                        @foreach (var category in categories)
                                        {
                                            if (category.Id <= 7)
                                            {
                                            <a class="button carousel-list text-center" @onclick="@(() => Filter(category.Id, category.Category))">
                                                    <img src=@category.IconPath class="img-icon text-center">
                                                    <p class="card-title">@category.Category</p>
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                                <button class="carousel-control-prev" type="button" data-bs-target="#carousel-md" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden"></span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carousel-md" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="filter">
                            <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#exampleModal">
                                <img src="images/filter.png" alt="" class="card-img">
                            </button>
                        </div>
                    </div>
            </div>

        </div>
    <!--Section 2-->
        <div class="section-2-lg">
            @if (activity == null)
            {
                <p><em>Loading...</em></p>
            }
            else{
                <InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReach="(e)=> FetchActivities()">
                    <div class="row d-flex justify-content-start">
                        @foreach (var act in activity)
                        {
                         cnt = 0; 
                         images = activityImages.Where(p=> p.ImageId == act.Id).ToList();
           
                         <div class="col-lg-3 col-sm-12 col-12 d-flex flex-column align-items-center">
                            <a class="button carousel-card text-center" href="/explore/@act.Id">
                            <div class="card">
                                <div id="carousel1-@act.Id" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="false">
                                    <div class="carousel-indicators">
                                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="false" aria-label="Slide 1"></button>
                                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                                    </div>
                                    <div class="carousel-inner1">
                                        @foreach(var item in images)
                                        {
                                            cnt++;
                                            if (item.ImageId == act.Id && cnt == 1)
                                            {
                                                <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                                <div class="carousel-item active">
                                                <img src=@item.ImageLocation alt="First slide" class="card-img">
                                                </div>
                                            }
                                            else if (item.ImageId == act.Id && cnt == 2)
                                            {
                                                <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                                <div class="carousel-item">
                                                <img src=@item.ImageLocation alt="Second slide" class="card-img">
                                                </div>
                                            }
                                            else if(item.ImageId == act.Id && cnt == 3)
                                            {
                                                 <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                                <div class="carousel-item">
                                                <img src=@item.ImageLocation alt="Third slide" class="card-img">
                                                </div>
                                            }
                                            else
                                            {
                                                break;
                                            }
                                        }
                                    </div>
                                        <button class="carousel-control-prev" type="button" data-bs-target="#carousel1-@act.Id" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carousel1-@act.Id" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden"></span>
                                    </button>
                                </div>  
                                <div class="card-body1 text-start">
                                    <span class="star-icon"><button type="button" class="btn-star"><i class="fa fa-star">&nbsp;New</i></button></span> 
                                    <h4 class="card-title1 mb-0" >@act.Title</h4>
                                    @if(act.ExperienceType.Id == 1)
                                    {
                                        if(String.IsNullOrEmpty(act.Location))
                                        {
                                            <p class="card-title2 mb-0">@act.Address.City</p>
                                        }
                                        else{
                                            <p class="card-title2 mb-0">@act.Location</p>
                                        }
                                    }
                                    else{
                                         <p class="card-title2 mb-0">@act.ExperienceType.Name</p>
                                    }
                                   @* <p class="card-title2 mb-0">@act.Location</p>*@
                                    <p class="card-title3">@act.Price</p>
                                </div>
                            </div>
                        </a>
                         </div>
                        }
                        <div class="col-lg-3 col-sm-12 col-12 d-flex flex-column align-items-center" id="observerTarget"></div>
                    </div>
                </InfiniteScroll>
            }
        </div>
    <!--Section 3-->
        <div class="section-3-md">
            <div class="row d-flex justify-content-start">
                @foreach (var act in activity.OrderBy(a => a.Id))
                {
                 cnt = 0;
                 images = activityImages.Where(p=> p.ImageId == act.Id).ToList();
                 <div class="col-md-6 d-flex flex-column align-items-center">
                 <a class="button carousel-card text-center" href="/explore/DetailActivity">
                    <div class="card">
                        <div id="carousel2-@act.Id" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="false">
                            <div class="carousel-indicators">
                                <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="false" aria-label="Slide 1"></button>
                                <button type="button" data-bs-target="#carouselExampleIndicaors" data-bs-slide-to="1" aria-label="Slide 2"></button>
                                <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                            </div>
                            <div class="carousel-inner1">
                                @foreach(var item in images)
                                {
                                    cnt++;
                                    if (item.ImageId == act.Id && cnt == 1)
                                    {
                                        <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                        <div class="carousel-item active">
                                        <img src=@item.ImageLocation alt="First slide" class="card-img">
                                        </div>
                                    }
                                    else if (item.ImageId == act.Id && cnt == 2)
                                    {
                                        <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                        <div class="carousel-item">
                                        <img src=@item.ImageLocation alt="Second slide" class="card-img">
                                        </div>
                                    }
                                    else if(item.ImageId == act.Id && cnt == 3)
                                    {
                                        <span class="wish-icon"><button type="button" class="btn border-0"><i class="fa fa-heart-o"></i></button></span>
                                        <div class="carousel-item">
                                        <img src=@item.ImageLocation alt="Third slide" class="card-img">
                                        </div>
                                    }
                                    else
                                    {
                                        break;
                                    }
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carousel2-@act.Id" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden"></span>
                            </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carousel2-@act.Id" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden"></span>
                            </button>
                        </div>  
                        <div class="card-body1 text-start">
                            <span class="star-icon"><button type="button" class="btn-star"><i class="fa fa-star">&nbsp;New</i></button></span> 
                            <h4 class="card-title1 mb-0" >@act.Title</h4>
                           @if(act.ExperienceType.Id == 1)
                            {
                                if(String.IsNullOrEmpty(act.Location))
                                {
                                    <p class="card-title2 mb-0">@act.Address.City</p>
                                }
                                else{
                                    <p class="card-title2 mb-0">@act.Location</p>
                                }
                            }
                            else{
                                 <p class="card-title2 mb-0">@act.ExperienceType.Name</p>
                            }
                            <p class="card-title3">@act.Price</p>
                        </div>
                    </div>
                </a>
            </div>
            }    
            </div>
        </div> 
    </div>
}
</body>

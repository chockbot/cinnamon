    private void onClickMenu()
    {
        if(clickButton)
        {
            clickButton = false;
        }
        else{
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    public async Task Search()
    {
        var activityList = await activityApiHandler.GetAllActivities();
        if (activityList.Succeeded && activityList.Result != null && activityList.Result.IsSuccess)
        {
            activities = activityList.Result.Result.Select(r =>
            {
                return new Activity
                    {
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin
                    };
            }).ToList();
            Model = new ExploreModel
                {
                    Activities = activities
                };
        }
        if(searchValue!= string.Empty)
        {
            activities = activities.Where(p => CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address1,
            searchValue, CompareOptions.IgnoreCase) >= 0 || CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Title,
            searchValue, CompareOptions.IgnoreCase) >= 0 || CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address2,
            searchValue, CompareOptions.IgnoreCase) >= 0).ToList();
        }
        else
        {
            activities = activities.Where(i => i.IsPublished).ToList();
        }
    }

    public async Task Filter(int id, string type)
    {
        searchValue = type;
        var activitiesRes = await activityApiHandler.GetActivitiesByCategories(id ,new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs
        {
            IncludeActivityAddress = true,
            IncludeActivityDescription = true,
            IncludeActivityImages = true
        });
        if (activitiesRes.Succeeded && activitiesRes.Result != null && activitiesRes.Result.IsSuccess)
        {
            activities = activitiesRes.Result.Result.Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        District = a.District,
                        City = a.City,
                        Address1 = a.Address1,
                        Address2 = a.Address2,
                        ExperienceTypeId = a.ExperienceTypeId,
                        Description = a.Description,
                        IsPublished = a.IsPublished,
                        Price = a.Price,
                        Title = a.Title
                    };
            }).ToList();
        }
        activities = activities.Where(p => p.ActivityId == id && p.IsPublished).ToList();
    }
    public async Task Clear()
    {
        searchValue = string.Empty;
        var activityList = await activityApiHandler.GetAllActivities();
        if (activityList.Succeeded && activityList.Result != null && activityList.Result.IsSuccess)
        {
            activities = activityList.Result.Result.Select(r =>
            {
                return new Activity
                    {
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin
                    };
            }).ToList();
            Model = new ExploreModel
                {
                    Activities = activities
                };
        }
        activities = activities.Where(p => p.IsPublished).ToList();
    }

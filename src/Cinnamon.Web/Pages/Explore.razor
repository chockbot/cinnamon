    public string StarReviewBtnClass(int star)
    {
        if(star == filters.StarReview)
        {
            return "selected d-flex align-items-center px-md-3 py-md-2 px-2 py-1 me-2 me-2 mb-2";
        }
        
        return "unselected d-flex align-items-center px-md-3 py-md-2 px-2 py-1 me-2 me-2 mb-2";
    }

    public async Task CustomFilters()
    {
        experienceCategoryId = null;
        pageIndex = 0;
        itemsPerPage = 20;

        await Task.WhenAll(new Task[] { FetchActivities(false)});
        await CloseFilter();
    }

    private class Filters 
    {
        public int? EventType {get; set;}
        public int? StarReview {get; set;}
    }

    public async Task ShowOTE(int ID)
    {
        ExperienceCategory = ID;
        pageIndex = 1;

        if (ExperienceCategory == 3)
        {
            showCategorySwiper = false;
            await Filter(null);
            await FetchActivities(true);
        }
        else
        {
            showCategorySwiper = true;
            await Filter(null);
            await FetchActivities(true);
        }

        await FetchActivities(false);
    }
}
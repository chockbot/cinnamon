<body>
     <!--Search-->
    <div class="top-row px-4">
        <!--App Name-->
        <div class="app-name col-lg-2 col-md-2">
            <a href="" class="app-name">@Resources.App.appName</a>
        </div>
        <!--Search Location and Experience-->
        <div class="col-lg-4 d-flex justify-content-end col-md-8 d-flex justify-content-center col-sm-11 d-flex flex-row justify-content-start col-11 d-flex flex-row justify-content-start">
            <div class="home-logo">
                <a class="button" href="#">
                    <img src="images/Home.png" class="img-icon">
                </a>
            </div>
            <div class="input-group border rounded-pill p-1">
                <input type="text" placeholder="Location | Experience" @bind-value="searchValue" aria-describedby="button-addon3" class="form-control bg-none border-0">
                <div class="input-group-append border-0">
                    <button id="button-addon3" type="button" class="btn border-0" @onclick="Clear"><i class="fa fa-times" style="color:#8C8C8C"></i></button>
                    <button id="button-addon3" type="button" @onclick="Search" class="btn btn-link text-success" style="background-color:#ffa942; border-radius:50%"><i class="fa fa-search" style="color:white"></i></button>
                </div>
            </div>
        </div>
        <!--Menu-->

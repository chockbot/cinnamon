<ModalLogin @ref="signinModal" />

<!--Filter-->
@*<FilterModal OnSelectedIdsChanged="OnFilterSelectedChanged"></FilterModal>*@
<ModalFinishSignUp @ref="modalFinishSignUp"></ModalFinishSignUp>
<ModalPassword @ref="modalPassword"></ModalPassword>
</html>
@code 
{
    private ModalLogin signinModal;
    public ExploreModel Model                   = new ExploreModel();
    public Profile CustomerModel                = new Profile();
    public ExperienceType exptype               = new ExperienceType();
    public List<ExperienceCategory> categories  = new List<ExperienceCategory>();
    public List<ExperienceType> experiencesType = new List<ExperienceType>();
    public List<Activity> activities            = new List<Activity>();
    public List<Activity> filteredActivities    = new List<Activity>();
    public string searchValue                   = string.Empty;
    public string filterId                      = string.Empty;
    public int cnt                              = 0;
    public int experienceCategoryId             = 0;

    private string value { get; set; }
    public bool clickButton { get; set; }
    public  ClaimsPrincipal AuthState { get; set; }
    private ModalFinishSignUp modalFinishSignUp { get; set; }
    private ModalPassword modalPassword { get; set; }
    private ModalLogin modalLogin { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await FetchActivities();
        // get experience categories
        var experienceCategory = await activityApiHandler.GetExperienceCategories();
        if (experienceCategory.Succeeded && experienceCategory.Result != null && experienceCategory.Result.IsSuccess)
        {
            categories = experienceCategory.Result.Result.Select(i =>
            {
                return new ExperienceCategory
                    {
                        Id = i.Id,
                        Category = i.Name,
                        IconPath = i.IconPath
                    };
            }).ToList();
        }
        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if (experienceTypes.Succeeded && experienceTypes.Result != null && experienceTypes.Result.IsSuccess)
        {
            experiencesType = experienceTypes.Result.Result.Select(i =>
            {
                return new ExperienceType
                    {
                        Id = i.Id,
                        Name = i.Name
                    };
            }).ToList();
        }
        exptype = experiencesType.Where(a => a.Id == 2).ElementAt(0);
        Model = new ExploreModel
            {
                ExperienceCategories = categories,
                ExperienceTypes = experiencesType
            };
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;
        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                {
                    Birthdate = args.Birthdate,
                    Email = args.Email,
                    FirstName = args.FirstName,
                    LastName = args.LastName,
                    Id = args.Id,
                    IsMaker = args.IsMaker,
                    IsVerified = args.IsVerified,
                };
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
        }

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
        var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);

        try
        {
            if (userSuccess && tokenSuccess)
            {
                var verifyRes = await accountApiHandler.VerifyRegisteredEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyRegisteredEmailArgs {
                    Token = token,
                    UserId = userId
                });
                if((!verifyRes.Succeeded || verifyRes.Result == null) || (verifyRes.Succeeded && !verifyRes.Result.IsSuccess))
                {
                    // invalid guid
                    return;
                }

                // try to register again to check if already have account details
                var checkRegistered = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs {
                    Email = verifyRes.Result.Result.Email,
                    ValidationRoute = AppConfig.BaseUrl + "/explore"
                });
                if(!checkRegistered.Succeeded || checkRegistered.Result == null)
                {
                    // error
                    return;
                }

                if(checkRegistered.Succeeded && !checkRegistered.Result.IsSuccess)
                {
                    if(checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED-VERIFIED")
                    {
                        modalFinishSignUp.OpenModal(verifyRes.Result.Result.Email);
                    }
                    if(checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED")
                    {
                        await modalPassword.OpenModal(verifyRes.Result.Result.Email);
                    }
                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }
    }

    private async Task FetchActivities()
    {
        var ActivityListData = await activityApiHandler.GetAllActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllActivitiesArgs
            {
                IncludeActivityAddress = true,
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true,
                IncludeExperienceTypes = true,
                IncludeExperienceCategories = true,
                IncludeSubCategories = true,
                IsActive = true
            });
        if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
        {
            activities = ActivityListData.Result.Result.Select(r =>
            {
                return new Activity
                    {
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceType = r.ExperienceType,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        ExperienceCategory = r.ExperienceCategory,
                        SubCategory = r.SubCategory,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        Subdivision = r.Subdivision,
                        Region = r.Region,
                        Barangay = r.Barangay,
                        PostalCode = r.PostalCode,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin,
                        CreatedBy = r.CreatedBy,
                        Handler = r.Handler,
                        IsNew = r.IsNew,
                        ActivitySchedules = r.ActivitySchedules.Select(e =>
                        {
                            return new ActivitySchedule
                            {
                                Id = e.Id,
                                Name = e.Name,
                                PerUnit1 = e.PerUnit1,
                                PerUnit2 = e.PerUnit2,
                                Price = e.Price,
                                PriceUnit1 = e.PriceUnit1,
                                PriceUnit2 = e.PriceUnit2,
                                UnitPrice = e.UnitPrice  
                            };
                        }).ToList(),
                        Images = r.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                    };
            }).ToList();
            Model = new ExploreModel
            {
                Activities = activities
            };
            activities = activities.Where(i => i.IsPublished).ToList();

            await FilterActivities();


        }
    }

    public async Task Search()
    {
        experienceCategoryId = 0;
        await FetchActivities();        
    }

    public async Task FilterActivities()
    {
        bool isInitialSearch = false;
        List<string> splitted = new List<string>();

        if (experienceCategoryId == 1)
        {
            activities = activities.Where(i => i.IsNew).ToList();
        }
        else
        {
            if (searchValue != string.Empty)
            {
                splitted = searchValue.Split(' ').Select(s => s.Trim()).Distinct().ToList();

                foreach (var keyword in splitted)
                {
                    if (!isInitialSearch)
                    {
                        isInitialSearch = true;

                        filteredActivities = activities.Where(p =>
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Title, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address1, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address2, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.District, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.City, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Subdivision, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Region, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Barangay, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.PostalCode, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.ExperienceType, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.ExperienceCategory, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.SubCategory, keyword, CompareOptions.IgnoreCase) >= 0
                                            ).ToList();
                    }
                    else
                    {
                        filteredActivities = filteredActivities.Where(p =>
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Title, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address1, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Address2, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.District, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.City, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Subdivision, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Region, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Barangay, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.PostalCode, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.ExperienceType, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.ExperienceCategory, keyword, CompareOptions.IgnoreCase) >= 0 ||
                                            CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.SubCategory, keyword, CompareOptions.IgnoreCase) >= 0
                                            ).ToList();
                    }
                }

                activities = filteredActivities;
            }
            else
            {
                activities = activities.Where(i => i.IsPublished).ToList();
            }

            if (experienceCategoryId != 0)
            {
                activities = activities.Where(i => i.ExperienceCategoryId == experienceCategoryId).ToList();
            }
        }
       
    }

    public async Task Filter(int id, string type)
    {
        experienceCategoryId = id;
        searchValue = type;

        await FetchActivities();
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        experienceCategoryId = 0;
        await FetchActivities();
    }


<ModalLogin @ref="signinModal" />

<!--Filter-->
@*<FilterModal OnSelectedIdsChanged="OnFilterSelectedChanged"></FilterModal>*@
<ModalFinishSignUp @ref="modalFinishSignUp"></ModalFinishSignUp>
<ModalPassword @ref="modalPassword"></ModalPassword>
</html>
@code
{
    private ModalLogin signinModal;
    public ExploreModel Model = new ExploreModel();
    public Profile CustomerModel = new Profile();
    public ExperienceType exptype = new ExperienceType();
    public List<ExperienceCategory> categories = new List<ExperienceCategory>();
    public List<ExperienceType> experiencesType = new List<ExperienceType>();
    public List<Activity> activities = new List<Activity>();
    public List<Activity> filteredActivities = new List<Activity>();
    public List<Activity> popularActivities = new List<Activity>();
    public string searchValue = string.Empty;
    public string filterId = string.Empty;
    public int cnt = 0;
    public int experienceCategoryId = 0;

    private string value { get; set; }
    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    private ModalFinishSignUp modalFinishSignUp { get; set; }
    private ModalPassword modalPassword { get; set; }
    private ModalLogin modalLogin { get; set; }

    private int pageIndex = 1;
    private bool isLoading = false;
    private bool showOverlay = false;
    private bool showOverlayPopularActivities = false;
    private bool hasNoMoreRecords = false;
    private int itemsPerPage = 20;

    private IAnimation selectedAnimation = Animations.FadeIn;

    protected override async Task OnInitializedAsync()
    {
        await FetchPopularActivities();
        await FetchActivities(false);
        // get experience categories
        var experienceCategory = await activityApiHandler.GetExperienceCategories();
        if (experienceCategory.Succeeded && experienceCategory.Result != null && experienceCategory.Result.IsSuccess)
        {
            categories = experienceCategory.Result.Result.Select(i =>
            {
                return new ExperienceCategory
                    {
                        Id = i.Id,
                        Category = i.Name,
                        IconPath = i.IconPath
                    };
            }).ToList();
        }
        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if (experienceTypes.Succeeded && experienceTypes.Result != null && experienceTypes.Result.IsSuccess)
        {
            experiencesType = experienceTypes.Result.Result.Select(i =>
            {
                return new ExperienceType
                    {
                        Id = i.Id,
                        Name = i.Name
                    };
            }).ToList();
        }
        exptype = experiencesType.Where(a => a.Id == 2).ElementAt(0);
        Model = new ExploreModel
            {
                ExperienceCategories = categories,
                ExperienceTypes = experiencesType
            };
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;
        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
        }


        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
        var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);

        try
        {
            if (userSuccess && tokenSuccess)
            {
                var verifyRes = await accountApiHandler.VerifyRegisteredEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyRegisteredEmailArgs
                    {
                        Token = token,
                        UserId = userId
                    });
                if ((!verifyRes.Succeeded || verifyRes.Result == null) || (verifyRes.Succeeded && !verifyRes.Result.IsSuccess))
                {
                    // invalid guid
                    return;
                }

                // try to register again to check if already have account details
                var checkRegistered = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs
                    {
                        Email = verifyRes.Result.Result.Email,
                        ValidationRoute = AppConfig.BaseUrl + "/explore"
                    });
                if (!checkRegistered.Succeeded || checkRegistered.Result == null)
                {
                    // error
                    return;
                }

                if (checkRegistered.Succeeded && !checkRegistered.Result.IsSuccess)
                {
                    if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED-VERIFIED")
                    {
                        modalFinishSignUp.OpenModal(verifyRes.Result.Result.Email);
                    }
                    if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED")
                    {
                        await modalPassword.OpenModal(verifyRes.Result.Result.Email);
                    }
                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }
    }


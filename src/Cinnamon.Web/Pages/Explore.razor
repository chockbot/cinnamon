@code {
    public List<ActivityModel> activity              = new List<ActivityModel>();
    public List<ActivityTypeModel> activityTypes     = new List<ActivityTypeModel>();
    public List<ActivityImagesModels> activityImages = new List<ActivityImagesModels>();
    public List<ActivityImagesModels> images         = new List<ActivityImagesModels>();
    public string searchValue                        = string.Empty;
    public string filterId                           = string.Empty;
    public int cnt                                   = 0;
    protected override async Task OnInitializedAsync()
    {
        activity        = await dataStore.GetAllActivityAsync();
        activityImages  = await dataStore.GetActivityImage();
        activityTypes   = await dataStore.GetAllActivityTypesAsync();
    }
    private void NavigateToFAQPage()
    {
        NavigationManager.NavigateTo("FAQ");
    }
    private void NavigateToPolicyPage()
    {
        NavigationManager.NavigateTo("policy");
    }
    private void NavigateToTermsPage()
    {
        NavigationManager.NavigateTo("terms");
    }
    public async Task Search()
    {
        activity       = await dataStore.GetAllActivityAsync();
        if(searchValue!= string.Empty)
        {
            activity   = activity.Where(p => CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Location,
            searchValue, CompareOptions.IgnoreCase) >= 0 || CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Title,
            searchValue, CompareOptions.IgnoreCase) >= 0).ToList();
        }
        else
        {
            activity  = await dataStore.GetAllActivityAsync();
        }
    }
    public async Task Filter(int id)
    {
        activity = await dataStore.GetAllActivityAsync();
        activity = activity.Where(p=> p.Id == id).ToList();
    }
}

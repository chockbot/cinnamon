    private async Task LoadSigninUser()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };

                await GetChatRoomsByUserId();

                if (hubConnection.State == HubConnectionState.Disconnected)
                {
                    try
                    {
                        await hubConnection.StartAsync();
                    }
                    catch (Exception ex)
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);

                        while (true)
                        {
                            try
                            {
                                await hubConnection.StartAsync();

                                break;
                            }
                            catch (ObjectDisposedException e)
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                            catch
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                        }
                    }
                }
            }
        }
    }


                @foreach (var act in activityFeeds)
                {
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-6 d-flex flex-column align-items-center card-activity-body explore-activity-item" style="margin-bottom:30px">
                        <Div ElementId="#b-animate">
                            <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                                <div class="card activities-card">
                                    <div class="card-img img-fluid position-relative">
                                        <a class="button carousel-card text-center" href="@DetailsUrl(act.Handler, (int)act.ExperienceCreationTypeId)" target="_blank">
                                            <img src=@act.SummaryDetails.ImageSrc alt="banner image" class="img-zoom-effect">
                                        </a>
                                        @if (act.ExperienceCreationTypeId == 1 && act.SummaryDetails.Ongoing > 0)
                                        {
                                            <CustomTooltip MarginLeft="-100">
                                                <TextContent>
                                                    <div class="ongoing-section">
                                                        <div class="active-badge" style="text-align:center">
                                                            <span class="pulse"></span>
                                                            <span class="active-tag-label">@act.SummaryDetails.Ongoing</span>
                                                        </div>
                                                    </div>
                                                </TextContent>
                                                <TooltipContent>
                                                    <span class="color-grey-100">
                                                        Ongoing Enrollees
                                                    </span>
                                                </TooltipContent>
                                            </CustomTooltip>
                                        }
                                        @if (CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                        {
                                            act.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == act.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                            if (act.IsFavorite)
                                            {
                                                <div class="favorite-section">
                                                    <button type="button" class="favorite-icon-button border-0" @onclick="() => AddFavoriteActivity(act)">
                                                        <img src='@(act.IsFavorite ? "images/favorites/experience-heart-selected.svg" : "images/favorites/experience-heart-default.svg")' class="favorite-icon" />
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="favorite-section">
                                                    <button type="button" class="favorite-icon-button border-0" @onclick="() =>CreateFavoriteAtivity(act)">
                                                        <img src="images/favorites/experience-heart-default.svg" class="favorite-icon" />
                                                    </button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="favorite-section">
                                                <button type="button" class="favorite-icon-button border-0">
                                                    <img src="@addToFavorites" class="favorite-icon" @onclick="() =>signinModal.Show()" />
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="card-container">
                                        <div class="row text-start star-pulse-section">
                                            <div class="col-12 col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 star-section">
                                                @if (act.SummaryDetails.TotalReviews > 0)
                                                {
                                                    <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                    <span class="average-rating">@act.SummaryDetails.ReviewAccumulated</span>
                                                    <span class="number-of-reviews">(@act.SummaryDetails.TotalReviews)</span>
                                                }
                                                else if (act.IsNew)
                                                {
                                                    <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                    <span class="new-experience-label">New Experience</span>
                                                }
                                                else if (act.ExperienceCreationTypeId == 3 && act.SummaryDetails.TotalParticipants > 0)
                                                {
                                                    int numberOfTickets = RoundDownToNearestMultiple(act.SummaryDetails.TotalParticipants);
                                                    <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                    <span class="number-of-reviews">@($"{(numberOfTickets < 10 ? numberOfTickets.ToString() : numberOfTickets + "+")} booked")</span>
                                                }
                                            </div>
                                            <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 pulse-section">
                                            </div>
                                        </div>
                                        <div class="row text-start">
                                            <div class="title-section">
                                                <div>
                                                    <Tooltip Multiline=true Text=@act.Title>
                                                        <h4 class="card-title1 mb-0">@act.Title</h4>
                                                    </Tooltip>
                                                    @if (@act.ExperienceTypeId == 1)
                                                    {
                                                        var address = string.IsNullOrEmpty(act.Address.PinnedLocation) ? act.Address.City + ", " + act.Address.Region : act.Address.PinnedLocation;
                                                        <p class="card-title2 mb-0 in-person text-capitalize">@address</p>
                                                    }
                                                    else
                                                    {
                                                        <p class="card-title2 mb-0 online">@(act.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row price-badge-section">
                                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 price-section"><p class="card-title3 mb-0">@GetPriceLabel(act.Price)</p></div>
                                        </div>
                                        @if(act.ExperienceCreationTypeId == 3)
                                        {
                                            <div class="mt-2">
                                                <span class="bg-green-100 color-white-100 font-12 rounded-pill px-2 py-1">
                                                    One time event
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </Animate>
                        </Div>
                    </div>
                }
                <div class="align-items-center" style="text-align:center;">
                    <button type="button" class="btn btn-primary border-0" id="btnExploreMore" @onclick="@(() => FetchActivities(true))">
                        @if (showOverlayPopularActivities)
                        {
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        }
                        else
                        {
                            <span>Explore More</span>
                        }
                    </button>
                    @if (hasNoMoreRecords)
                    {
                        <p>You're all caught up!</p>
                    }
                </div>
            </div>
        </div>
    </div>

<div id="observerTarget"></div>

<Modal id="explore-filter-modal" @ref="filterModal">
    <ModalContent Centered class="font-family-nunito">
        <ModalHeader Border="Border.Is0" class="font-24 color-black-100 font-weight-700 pb-0 m-font-16">Filter by</ModalHeader>
        <ModalBody class="color-black-100 pt-2">
            <div id="filter-by-type">
                <label class="font-20 m-font-14">Type</label>
                <div class="d-flex mt-3">
                    <Button Clicked="() => filters.EventType = null" class="border-1-solid border-color-grey-200 d-flex align-items-center px-md-3 py-md-2 px-2 py-1 me-2">
                        <img class="me-2 filter-type-img" 
                            src='@(filters.EventType == null ? "images/icons/small-selected.png" : "images/icons/unselected-small.png")' alt="icon">
                        <span class="font-16 m-font-14">All</span>
                    </Button>
                    <Button Clicked="() => filters.EventType = 2" class="border-1-solid border-color-grey-200 d-flex align-items-center px-md-3 py-md-2 px-2 py-1 me-2">
                        <img class="me-2 filter-type-img" 
                            src='@(filters.EventType == 2 ? "images/icons/small-selected.png" : "images/icons/unselected-small.png")' alt="icon">
                        <span class="font-16 m-font-14">Online</span>
                    </Button>
                    <Button Clicked="() => filters.EventType = 1" class="border-1-solid border-color-grey-200 d-flex align-items-center px-md-3 py-md-2 px-2 py-1 me-2">
                        <img class="me-2 filter-type-img" 
                            src='@(filters.EventType == 1 ? "images/icons/small-selected.png" : "images/icons/unselected-small.png")' alt="icon">
                        <span class="font-16 m-font-14">In-person</span>
                    </Button>
                </div>
            </div>
            <div id="filter-by-rating" class="mt-4">
                <label class="font-20 m-font-14">Rating</label>
                <div class="d-flex mt-3 flex-wrap">
                    <Button Clicked="() => filters.StarReview = 5" class="@StarReviewBtnClass(5)">
                        <img class="me-2 filter-type-img" src="images/icons/small-start.png" alt="icon">
                        <span class="font-16 text-capitalize m-font-14">5 stars</span>
                    </Button>
                    <Button Clicked="() => filters.StarReview = 4" class="@StarReviewBtnClass(4)">
                        <img class="me-2 filter-type-img" src="images/icons/small-start.png" alt="icon">
                        <span class="font-16 text-capitalize m-font-14">4 stars & up</span>
                    </Button>
                    <Button Clicked="() => filters.StarReview = 3" class="@StarReviewBtnClass(3)">
                        <img class="me-2 filter-type-img" src="images/icons/small-start.png" alt="icon">
                        <span class="font-16 text-capitalize m-font-14">3 stars & up</span>
                    </Button>
                    <Button Clicked="() => filters.StarReview = 2" class="@StarReviewBtnClass(2)">
                        <img class="me-2 filter-type-img" src="images/icons/small-start.png" alt="icon">
                        <span class="font-16 text-capitalize m-font-14">2 stars & up</span>
                    </Button>
                    <Button Clicked="() => filters.StarReview = 1" class="@StarReviewBtnClass(1)">
                        <img class="me-2 filter-type-img" src="images/icons/small-start.png" alt="icon">
                        <span class="font-16 text-capitalize m-font-14">1 stars & up</span>
                    </Button>
                </div>
            </div>
        </ModalBody>
        <ModalFooter>
            <Button Clicked="CloseFilter" Border="Border.Is1" class="font-16 font-weight-700 px-4 m-font-14">
                Cancel
            </Button>
            <Button Clicked="CustomFilters" class="font-16 bg-orange-100 color-white-100 font-weight-700 hover-color-white px-4 m-font-14">
                Apply
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<ModalLogin ReturnUrl="@redirectUrl" @ref="signinModal" IsFBLogin=isLoginFB />
<ModalFinishSignUp @ref="modalFinishSignUp"></ModalFinishSignUp>
<ModalPassword @ref="modalPassword"></ModalPassword>
<WelcomeModal @ref=WelcomeModalRef UserTriggered="OnSkipMaker" />
<ReviewModal @ref=ReviewModalRef/>
<ModalFBUpdate @ref="fbUpdateModal"></ModalFBUpdate>
<UpdatePasswordModal @ref=updatePasswordModal Token=@CustomerModel.Token Birthdate=@Birthday />

@code
{
    [Parameter]
    public string landingSearch { get; set; }
    [Parameter]
    public string filterSearch { get; set; }
    private WelcomeModal WelcomeModalRef { get; set; }
    private ReviewModal ReviewModalRef { get; set; }
    private ModalLogin signinModal;
    private ModalFBUpdate fbUpdateModal;
    private UpdatePasswordModal updatePasswordModal;

    public ExploreModel Model = new ExploreModel();
    public Profile CustomerModel = new Profile();
    public ExperienceType exptype = new ExperienceType();
    public List<ExperienceCategory> categories = new List<ExperienceCategory>();
    public List<ExperienceType> experiencesType = new List<ExperienceType>();
    private List<StudentAttendance> studentAttendances = new List<StudentAttendance>();
    public string searchValue = string.Empty;
    public int? experienceCategoryId = null;
    public string addToFavorites = "images/favorites/experience-heart-default.svg";

    public bool clickButton { get; set; }
    public ClaimsPrincipal AuthState { get; set; }
    private ModalFinishSignUp modalFinishSignUp { get; set; }
    private ModalPassword modalPassword { get; set; }

    private int pageIndex = 0;
    private int pageIndexPopularActivities = 1;
    private bool isLoading = false;
    private bool showOverlayPopularActivities = false;
    private bool hasNoMoreRecords = false;
    private bool hasNewMessages = false;
    private int itemsPerPage = 20;
    private int newMessagesCount = 0;
    [Inject] HubConnection hubConnection { get; set; }

    List<ChatRoom> chatRooms = new List<ChatRoom>();

    [Parameter]
    [SupplyParameterFromQuery]
    public bool? IsNewRegistered { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auth")]
    public string? QueryAuth {get; set;}

    [Parameter]
    [SupplyParameterFromQuery(Name = "redirect")]
    public string? QueryRedirect {get; set;}

    [Parameter]
    [SupplyParameterFromQuery]
    public bool? IsNewUser { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? CurrentEmail { get; set; }

    public string Email { get; set; } = string.Empty;

    public string NewEmail { get; set; } = string.Empty;

    public DateTime Birthday { get; set; } = DateTime.Now;

    private string redirectUrl {get; set;} = string.Empty;

    public bool isLoginFB { get; set; } = false;

    private List<ActivityFeed> activityFeeds = new();
    private List<ActivityFeed> popularFeeds = new();
    private Modal? filterModal;

    private Filters filters = new ();

    protected override async Task OnInitializedAsync()
    {
        LoadRedirectUrls();

        //Search in Landing Page
        if (string.IsNullOrEmpty(landingSearch))
        {
            await Task.WhenAll(new Task[] {FetchPopularActivities(null), FetchActivities(false)});
        }
        else
        {
            searchValue = landingSearch;
            await Search();
        }
        //Search by Filter
        if (!string.IsNullOrEmpty(filterSearch))
        {
            int filter = int.Parse(filterSearch);
            await Filter(filter);
        }

        await LoadSigninUser();
        await GetFavorites();
        showOverlayPopularActivities = false;

        // get experience categories
        var experienceCategory = await activityApiHandler.GetExperienceCategories();
        if (experienceCategory.Succeeded && experienceCategory.Result != null && experienceCategory.Result.IsSuccess)
        {
            categories = experienceCategory.Result.Result.Select(i =>
            {
                return new ExperienceCategory
                    {
                        Id = i.Id,
                        Category = i.Name,
                        IconPath = i.IconPath
                    };
            }).ToList();
        }
        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if (experienceTypes.Succeeded && experienceTypes.Result != null && experienceTypes.Result.IsSuccess)
        {
            experiencesType = experienceTypes.Result.Result.Select(i =>
            {
                return new ExperienceType
                    {
                        Id = i.Id,
                        Name = i.Name
                    };
            }).ToList();
        }
        exptype = experiencesType.Where(a => a.Id == 2).ElementAt(0);
        Model = new ExploreModel
            {
                ExperienceCategories = categories,
                ExperienceTypes = experiencesType
            };

        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Explore Page Loaded");
            await LoadWelcomeDialog();
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
        await InitializeSwiper();

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        //Check if login via FB
        if (uri.AbsolutePath.Contains("facebook-login"))
        {
            if (IsNewUser == true)
            {
                isLoginFB = true;
                await signinModal.Show();
            }
            else
            {
                await fbUpdateModal.Show();
            }
        }
        else
        {
            var userSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("userid", out var userId);
            var tokenSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var token);
            try
            {
                if (userSuccess && tokenSuccess)
                {
                    var verifyRes = await accountApiHandler.VerifyRegisteredEmail(new Framework.ApiCommand.ApiCore.Account.Request.VerifyRegisteredEmailArgs
                        {
                            Token = token,
                            UserId = userId
                        });
                    if ((!verifyRes.Succeeded || verifyRes.Result == null) || (verifyRes.Succeeded && !verifyRes.Result.IsSuccess))
                    {
                        // invalid guid
                        return;
                    }

                    // try to register again to check if already have account details
                    var checkRegistered = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs
                        {
                            Email = verifyRes.Result.Result.Email,
                            ValidationRoute = AppConfig.BaseUrl + "/explore"
                        });
                    if (!checkRegistered.Succeeded || checkRegistered.Result == null)
                    {
                        // error
                        return;
                    }

                    if (checkRegistered.Succeeded && !checkRegistered.Result.IsSuccess)
                    {
                        if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED-VERIFIED")
                        {
                            if (CustomerModel.CustomerProfile != null)
                            {
                                Email        = CustomerModel.CustomerProfile.Email;
                                NewEmail     = verifyRes.Result.Result.Email;
                                Birthday     = CustomerModel.CustomerProfile.Birthdate;
                                //Show update password modal
                                updatePasswordModal.Show(Email, NewEmail);
                            }
                            else
                            {
                                 modalFinishSignUp.OpenModal(verifyRes.Result.Result.Email);
                            }
                        }
                        if (checkRegistered.Result.ErrorInfo?.Code == "EMAIL-ALREADY-REGISTERED")
                        {
                            await modalPassword.OpenModal(verifyRes.Result.Result.Email);
                        }
                    }
                }
            }
            catch (Exception e)
            {
                e.Message.ToString();
            }
        }

    }

    private async Task SendChatStatus()
    {
        if (hubConnection is not null && CustomerModel.CustomerProfile is not null && IsConnected)
        {
            await hubConnection.SendAsync("SendChatStatus", CustomerModel.CustomerProfile.Id);
        }
    }

    private async Task LoadSigninUser()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                    {
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                    };

                await GetChatRoomsByUserId();

                if (hubConnection.State == HubConnectionState.Disconnected)
                {
                    try
                    {
                        await hubConnection.StartAsync();
                    }
                    catch (Exception ex)
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);

                        while (true)
                        {
                            try
                            {
                                await hubConnection.StartAsync();

                                break;
                            }
                            catch (ObjectDisposedException e)
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                            catch
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                        }
                    }
                }
            }
        }
    }

    private async Task LoadWelcomeDialog()
    {
        if (IsNewRegistered.HasValue && IsNewRegistered.Value && CustomerModel.CustomerProfile != null)
        {
            var customerId = CustomerModel.CustomerProfile.Id;
            var result = await jsRuntime.InvokeAsync<Models.ResponseModel>("MyLib.Utils.cookieManager.getCookie", $"wel_dia_{customerId}");
            if (string.IsNullOrEmpty(result.Message))
            {
                await WelcomeModalRef.Show();
            }
        }
    }

    private async Task GetFavorites()
    {
        if (CustomerModel.CustomerProfile != null)
        {
            var customerFavorites = await activityApiHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs
                {
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
            if (customerFavorites.Succeeded && customerFavorites.Result != null && customerFavorites.Result.IsSuccess)
            {
                CustomerModel.Favorites = customerFavorites.Result.Result.Select(i =>
                {
                    return new Favorite
                        {
                            ActivityId = i.ActivityId,
                            CustomerId = i.CustomerId,
                            IsFavorite = true
                        };
                }).ToList();
            }
        }
    }

    private async Task AddFavoritePopularAtivity(ActivityFeed activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        await AddToFavorites(activity.ActivityId, activity.IsFavorite);
    }

    private async Task AddFavoriteActivity(ActivityFeed activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        await AddToFavorites(activity.ActivityId, activity.IsFavorite);
    }

    private async Task AddToFavorites(int activityId, bool isFavorite)
    {
        if (isFavorite)
        {
            //Add to Favorites
            var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
                {
                    ActivityId = activityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        else
        {
            //Delete to Favorites
            var createFavorite = await activityApiHandler.RemoveFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.RemoveFavoriteArgs
                {
                    ActivityId = activityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        await GetFavorites();
    }

    private async Task CreateFavoritePopularAtivity(ActivityFeed activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        await CreateFavorite(activity.ActivityId);
    }

    private async Task CreateFavoriteAtivity(ActivityFeed activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        await CreateFavorite(activity.ActivityId);
    }

    private async Task CreateFavorite(int activityId)
    {
        //Add to Favorites
        var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
            {
                ActivityId = activityId,
                CustomerId = CustomerModel.CustomerProfile.Id
            }, CustomerModel.Token);
        await GetFavorites();

    }

    private async Task OnSkipMaker() 
    {
        if (IsNewRegistered.HasValue && IsNewRegistered.Value && CustomerModel.CustomerProfile != null)
        {
            var customerId = CustomerModel.CustomerProfile.Id;
            await jsRuntime.InvokeVoidAsync("MyLib.Utils.cookieManager.setCookie", $"wel_dia_{customerId}", "1");
        }
    }

    private async Task FetchActivities(bool isFromScroll)
    {
        isLoading = true;

        var activityFeedRes = await activityApiHandler.ActivityFeed(new Framework.ApiCommand.ApiCore.Activity.Request.ActivityFeedArgs
        {
            CategoryId = experienceCategoryId,
            Search = searchValue,
            Skip = pageIndex,
            Take = itemsPerPage,
            ExperienceType = filters.EventType,
            StarReview = filters.StarReview
        });

        if (activityFeedRes.Succeeded && activityFeedRes.Result != null && activityFeedRes.Result.IsSuccess)
        {
            var feeds = mapper.Map<IEnumerable<ActivityFeed>>(activityFeedRes.Result.Result);
            if (feeds.Count() > 0)
            {
                if (isFromScroll)
                {
                    activityFeeds.AddRange(feeds);
                }
                else
                {
                    activityFeeds = feeds.ToList();
                }

                pageIndex = pageIndex + feeds.Count();
                itemsPerPage = 8;

                hasNoMoreRecords = false;
            }
            else
            {
                hasNoMoreRecords = true;

                if (!isFromScroll)
                    activityFeeds = new();
            }
        }

        isLoading = false;
    }

    private async Task FetchPopularActivities(int? categoryId)
    {
        showOverlayPopularActivities = true;

        popularFeeds.Clear();

        var activitiesRes = await activityApiHandler.PopularActivities(new Framework.ApiCommand.ApiCore.Activity.Request.PopularActivitiesArgs {
            CountPerPage = 20,
            PageIndex = 0,
            CategoryId = categoryId
        });
        if(activitiesRes.Succeeded && activitiesRes.Result is not null && activitiesRes.Result.IsSuccess)
        {
            var popular = mapper.Map<IEnumerable<ActivityFeed>>(activitiesRes.Result.Result);
            popularFeeds.AddRange(popular);
        }
        showOverlayPopularActivities = false;
    }

    public async Task Search()
    {
        experienceCategoryId = null;
        pageIndex = 0;
        itemsPerPage = 20;
        await Task.WhenAll(new Task[] {FetchPopularActivities(null), FetchActivities(false)});
    }

    public async Task Filter(int id)
    {
        experienceCategoryId = id;
        pageIndex = 0;
        itemsPerPage = 20;

        await Task.WhenAll(new Task[] {FetchPopularActivities(id), FetchActivities(false)});
    }

    public async Task Clear()
    {
        searchValue = string.Empty;
        experienceCategoryId = null;
        pageIndex = 0;
        itemsPerPage = 20;
        await FetchActivities(false);
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/maker/dashboard");
    }

    private void NavigateToAccount()
    {
        NavigationManager.NavigateTo("/customer/profile");
    }

    private void NavigateToCreation()
    {
        NavigationManager.NavigateTo("/Creation");
    }

    private void NavigateToOnboarding()
    {
        NavigationManager.NavigateTo("/Onboarding");
    }

    private void NavigateToHelp()
    {
        NavigationManager.NavigateTo("/Help");
    }


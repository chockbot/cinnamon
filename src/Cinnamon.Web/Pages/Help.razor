@page "/help"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Components
<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container container-fluid">
        <div class="row d-flex justify-content-center">
            <div class="row justify-content-center">
                <label class="heading text-center">How can we help you?</label>
                <div class="btn-section border-bottom col-lg-12 d-lg-block d-md-none d-sm-none d-none">
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToFaq">
                        <img src="/images/Dashboard Icon/faq.png" />
                        <span class="btn-caption">Frequently Asked Questions</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToTerms">
                        <img src="/images/Dashboard Icon/terms.png" />
                        <span class="btn-caption">Terms & Conditions</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToPrivacy">
                        <img src="/images/Dashboard Icon/privacy.png" />
                        <span class="btn-caption">Privacy Policy</span>
                    </button>
                </div>
                <div class="btn-carousel-section border-bottom d-lg-none d-md-block d-sm-none d-none">
                    <div id="carouselExampleControlsSm" class="carousel slide" data-ride="carousel" data-interval="0">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToFaq">
                                    <img src="/images/Dashboard Icon/faq.png" />
                                    <span class="btn-caption">Frequently Asked Questions</span>
                                </button>                            
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToTerms">
                                    <img src="/images/Dashboard Icon/terms.png" />
                                    <span class="btn-caption">Terms & Conditions</span>
                                </button>
                            </div>
                            <div class="carousel-item">
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToPrivacy">
                                    <img src="/images/Dashboard Icon/privacy.png" />
                                    <span class="btn-caption">Privacy Policy</span>
                                </button>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControlsSm" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControlsSm" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden"></span>
                        </button>
                    </div>
                </div>
                <div class="btn-carousel-section border-bottom d-lg-none d-md-none d-sm-block d-block">
                    <div id="carouselExampleControls" class="carousel slide" data-ride="carousel" data-interval="0">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToFaq">
                                    <img src="/images/Dashboard Icon/faq.png" />
                                    <span class="btn-caption">Frequently Asked Questions</span>
                                </button>
                            </div>
                            <div class="carousel-item">
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToTerms">
                                    <img src="/images/Dashboard Icon/terms.png" />
                                    <span class="btn-caption">Terms & Conditions</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="NavigateToPrivacy">
                                    <img src="/images/Dashboard Icon/privacy.png" />
                                    <span class="btn-caption">Privacy Policy</span>
                                </button>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden"></span>
                        </button>
                    </div>
                </div>
                @if (isFaqDisplayed)
                {
                    <FAQ></FAQ>
                }
                @if (isTermsDisplayed)
                {
                    <Terms></Terms>
                }
                @if (isPrivacyDisplayed)
                {
                    <Policy></Policy>
                }
            </div>
            <Contact></Contact>
            <Footer></Footer>
        </div>

    </div>


</body>
</html>

@code {
    private bool isFaqDisplayed = false;
    private bool isTermsDisplayed = false;
    private bool isPrivacyDisplayed = false;

    protected override async Task OnInitializedAsync()
    {
        isFaqDisplayed = true;
    }

    private void NavigateToFaq()
    {
        isFaqDisplayed = true;
        isTermsDisplayed = false;
        isPrivacyDisplayed = false;
    }

    private void NavigateToTerms()
    {
        isFaqDisplayed = false;
        isTermsDisplayed = true;
        isPrivacyDisplayed = false;
    }

    private void NavigateToPrivacy()
    {
        isFaqDisplayed = false;
        isTermsDisplayed = false;
        isPrivacyDisplayed = true;
    }
}

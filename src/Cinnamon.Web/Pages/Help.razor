@code 
{
    private bool isFaqDisplayed = false;
    private bool isTermsDisplayed = false;
    private bool isPrivacyDisplayed = false;
	private bool isEventToCDisplayed = false;

	private DynamicContentForm eventPoliciesModel = new();
    private DynamicContentForm eventSellerModel = new();
    private DynamicContentForm eventBuyerModel = new();
    private DynamicContentForm privacyPoliciesModel = new();

	enum EventTab {
		Buyer = 0,
		Seller = 1
	}
	private EventTab eventTab = EventTab.Buyer;

    [Parameter]
    public string Section { get; set; }

    private string Title {get; set;} = "Frequently Asked Questions";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(Section))
        {
            Section = Section.Trim().ToLower();

            if (Section == "faq")
            {
                NavigateToFaq();
            }
            else if (Section == "terms")
            {
                NavigateToTerms();
            }
            else if (Section == "privacy")
            {
                NavigateToPrivacy();
            }
            else
            {
                NavigateToFaq();
            }
        }
        else
        {
            NavigateToFaq();
        }

		await Task.WhenAll(new Task[] 
            {
                LoadEventPolicies(), 
                LoadEventBuyerPolicies(), 
                LoadEventSellerPolicies(), 
                LoadPrivacyPolicies()
            }
        );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
        }
    }

    private void NavigateToFaq()
    {
        Title = "Frequently Asked Questions";
        isFaqDisplayed = true;
        isTermsDisplayed = false;
        isPrivacyDisplayed = false;
		isEventToCDisplayed = false;
    }

    private void NavigateToTerms()
    {
        Title = "Terms & Conditions";
        isFaqDisplayed = false;
        isTermsDisplayed = true;
        isPrivacyDisplayed = false;
		isEventToCDisplayed = false;
    }

    private void NavigateToPrivacy()
    {
        Title = "Privacy Policy";
        isFaqDisplayed = false;
        isTermsDisplayed = false;
        isPrivacyDisplayed = true;
		isEventToCDisplayed = false;
    }

	private void NavigateToEventTOC()
    {
        Title = "Transaction Agreement";
        isFaqDisplayed = false;
        isTermsDisplayed = false;
        isPrivacyDisplayed = false;
		isEventToCDisplayed = true;
    }

	private string BtnClass(EventTab tab)
	{
		string resultClass = "color-white-100 hover-color-white me-2 ";

		if(eventTab == tab)
		{
			return	resultClass += "bg-orange-100";
		}

		return resultClass += "bg-grey-200";
	}

	private async Task LoadEventPolicies()
    {
        var result = await systemApiHandler.GetEventPolicies();
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            eventPoliciesModel.Content = result.Result.Result.Content;
            eventPoliciesModel.Title = result.Result.Result.Title;
        }
    }

    private async Task LoadEventBuyerPolicies()
    {
        var result = await systemApiHandler.GetEventBuyerPolicies();
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            eventBuyerModel.Content = result.Result.Result.Content;
            eventBuyerModel.Title = result.Result.Result.Title;
        }
    }

    private async Task LoadEventSellerPolicies()
    {
        var result = await systemApiHandler.GetEventSellerPolicies();
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            eventSellerModel.Content = result.Result.Result.Content;
            eventSellerModel.Title = result.Result.Result.Title;
        }
    }

    private async Task LoadPrivacyPolicies()
    {
        var result = await systemApiHandler.GetPrivacyPolicies();
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            privacyPoliciesModel.Content = result.Result.Result.Content;
            privacyPoliciesModel.Title = result.Result.Result.Title;
        }
    }

	record DynamicContentForm 
    {
        public string Title {get; set;}
        public string Content {get; set;}
    }
}

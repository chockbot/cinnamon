				</div>
            }
			@if (isEventToCDisplayed)
            {
				<div class="container p-5">
					<p class="heading-secondary text-center">@eventPoliciesModel.Title</p>
					<p class="terms-caption text-center">Last updated January 22, 2024</p>

					<div class="policy-style mt-5">
						<p class="justify font-20 color-black-100">
						@((MarkupString)eventPoliciesModel.Content)
						</p>
						
						<div class="d-flex justify-content-center my-5">
							<Button Clicked="() => eventTab = EventTab.Buyer" class="@BtnClass(EventTab.Buyer)">
								Buyer
							</Button>
							<Button Clicked="() => eventTab = EventTab.Seller" class="@BtnClass(EventTab.Seller)">
								Seller
							</Button>
						</div>
						

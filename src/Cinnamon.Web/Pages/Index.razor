@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@inject ISystemApiHandler systemApiHandler;

<PageTitle>Welcome to Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH</PageTitle>
<SeoMeta />

<input type="password" name="password_fake" id="password_fake" value="" style="display:none;" />

<div class="image-1-mobile">
    <img src="images/landing-page-images/camera-mobile.png">
</div>
<div class="image-2-mobile">
    <img src="images/landing-page-images/laptop-mobile.png">
</div>
<div class="image-3-mobile">
    <img src="images/landing-page-images/ball-mobile.png">
</div>
<div class="image-4-mobile">
    <img src="images/landing-page-images/ticket-mobile.png">
</div>
<div class="circle-1-md">
    <img src="images/landing-page-images/circle-md.png">
</div>
<div class="circle-2-md">
    <img src="images/landing-page-images/circle-2-md.png">
</div>

@if (Announcements.Count() > 0)
{
    <div class="announcements" style="display:@IsDisplay">
        <div class="container">
            <button type="button" class="close-button" aria-label="Close" @onclick="() =>DisplayAnnouncement()">
                <span aria-hidden="true">&times;</span>
            </button>
            <div class="swiper announcement-swipper">
                <div class="swiper-wrapper">
                    @foreach (var item in Announcements)
                    {
                        <div class="swiper-slide">
                            <Row class="align-items-center">
                                <Column ColumnSize="ColumnSize.Is12.Is9.OnDesktop">
                                    <p class="font-24 m-font-14 font-weight-900 color-black-100">@item.Title</p>
                                    <p class="font-20 m-font-12 color-grey-100">
                                        @item.Description
                                    </p>
                                </Column>
                                @if (!string.IsNullOrEmpty(item.ButtonLabel) && !string.IsNullOrEmpty(item.Link))
                                {
                                    <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop" class="text-start text-md-end">
                                        <a href="@item.Link" class="d-inline-block cursor-pointer px-3 py-2 text-decoration-none font-16 m-font-10 font-weight-700 bg-orange-100 color-white-100 hover-color-white rounded-pill">
                                            @item.ButtonLabel
                                        </a>
                                    </Column>
                                }
                            </Row>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!--Section 1-->
<div class="wrapper hero_section col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12 col-12">
    <img class="blob_1" alt="blob_1" src="images/landing-page-images/circle.png">
    <img class="float_1" alt="float_1" src="images/landing-page-images/ball.png">
    <main>
        <p class="hero_title">Your family experience partner</p>
        <p class="hero_subtitle">Activities, learnings and events for you and your loved ones.</p>
    </main>
    <img class="float_2" alt="float_2" src="images/landing-page-images/camera.png">
    <img class="blob_2" alt="blob_2" src="images/landing-page-images/circle-2.png">
</div>

<!--Search Section-->
<div class="wrapper search_section">
    <img class="float_3" alt="float_3" src="images/landing-page-images/laptop.png">
    <form class="search-bar" @onsubmit=SearchToExplorePage>
        <div class="search_bar">
            <img class="search_icon" alt="search_icon" src="images/landing-page-images/search-icon.png" style="">
            <input class="search" type="text" id="19d13aa1-90c0-4232-a7bc-62a772baa223" autocomplete="new-password" placeholder="Search for an activity.." @oninput="OnChageInput" @bind-value="searchValue">
            <button class="explore_button" @onclick="() =>SearchToExplorePage()">
                @buttonLabel
            </button>
        </div>
    </form>
    <img class="float_4" alt="float_4" src="images/landing-page-images/ticket.png">
</div>

<!--Section Category-->
<div class="container">
    <div class="section-1 row">
        <div class="categories">
            <div class="row d-flex justify-content-start">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 categories-container">
                    <div class="schedule-swiper">
                        <div class="swiper-wrapper text-center">
                            @foreach (var category in categories)
                            {
                                @if (category.Category != "New")
                                {
                                    <div class="swiper-slide category">
                                        <div>
                                            <a class="button carousel-list text-center" id="category.Id" @onclick="@(() => SearchByFilter(category.Id))">
                                                <img src=@category.IconPath class="img-icon text-center">
                                                <p class="card-title">@category.Category</p>
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="swiper-scrollbar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Section 3-->
@if (activities.Count != 0)
{
    <div class="section-3 row">
        <div class="featured-activities col-12 justify-content-center">
            <div class="container">
                <div class="featured-header d-flex">
                    <p class="featured-text">Featured Activities</p>
                    <a class="see-more" href="/explore">See More</a>
                </div>
                <div class="row d-flex justify-content-start">
                    @foreach (var act in activities)
                    {
                        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-6 d-flex flex-column align-items-center card-activity-body explore-activity-item" style="margin-bottom:30px">
                            <Div ElementId="#b-animate">
                                <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
                                <div class="card activities-card">
                                    @if (act.Images.Count > 0)
                                        {
                                            <div class="card-img img-fluid position-relative">
                                                <a class="button carousel-card text-center" href="/explore/@(string.IsNullOrEmpty(act.Handler) ? act.ActivityId.ToString() : act.Handler)" target="_blank">
                                                    <img src=@act.Images.ElementAt(0).ImageSrc alt="banner image" class="img-zoom-effect">
                                                </a>
                                                @* <div class="creation-section">
                                    @if (act.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.GeneralExperience)
                                    {
                                    <img class="creation-type" src="images/Creation-type/GA.png" />
                                    }
                                    else if (act.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.OneTimeEvents)
                                    {
                                    <img class="creation-type" src="images/Creation-type/OTE.png" />
                                    }
                                    else if (act.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.ExperienceViaAppointment)
                                    {
                                    <img class="creation-type" src="images/Creation-type/AVA.png" />
                                    }
                                    else
                                    {
                                    <img class="creation-type" src="images/Creation-type/SUP.png" />
                                    }
                                    </div>*@

                                                @*@if (act.OngoingStudents > 0)
                                    {
                                    <CustomTooltip MarginLeft="-100">
                                    <TextContent>
                                    <div class="rounded-pill ongoing-section">
                                    <div class="active-badge" style="text-align:center">
                                    <span class="pulse"></span>
                                    <span class="active-tag-label">@act.OngoingStudents</span>
                                    </div>
                                    </div>
                                    </TextContent>
                                    <TooltipContent>
                                    <span class="color-grey-100">
                                    Ongoing Enrollees
                                    </span>
                                    </TooltipContent>
                                    </CustomTooltip>
                                    }*@
                                                @if (CustomerModel.CustomerProfile != null && CustomerModel.Favorites != null)
                                                {
                                                    act.IsFavorite = CustomerModel.Favorites.Any(a => a.ActivityId == act.ActivityId && a.CustomerId == CustomerModel.CustomerProfile.Id);
                                                    if (act.IsFavorite != false)
                                                    {
                                                        <div class="favorite-section">
                                                            <button type="button" class="favorite-icon-button border-0" @onclick="() =>AddToFavorites(act)">
                                                                <img src='@(act.IsFavorite ? "images/favorites/experience-heart-selected.svg" : "images/favorites/experience-heart-default.svg")' class="favorite-icon" />
                                                            </button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="favorite-section">
                                                            <button type="button" class="favorite-icon-button border-0" @onclick="() =>CreateFavorite(act)">
                                                                <img src="images/favorites/experience-heart-default.svg" class="favorite-icon" />
                                                            </button>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="favorite-section">
                                                        <button type="button" class="favorite-icon-button border-0">
                                                            <img src="@addToFavorites" class="favorite-icon" @onclick="() =>NavigateToExplorePage()" />
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="card-container">
                                            <div class="row text-start star-pulse-section">
                                                <div class="col-12 col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 star-section">
                                                    @if (act.NumberOfReviews > 0)
                                                    {
                                                        <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                        <span class="average-rating">@act.AverageRating</span>
                                                        <span class="number-of-reviews">(@act.NumberOfReviews)</span>
                                                    }
                                                    else if (act.IsNew)
                                                    {
                                                        <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                        <span class="new-experience-label">New Experience</span>
                                                    }
                                                    else if (act.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.OneTimeEvents && act.NumberOfTickets != 0)
                                                    {
                                                        int numberOfTickets = RoundDownToNearestMultiple(act.NumberOfTickets);
                                                        <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                        <span class="number-of-reviews">@($"{(numberOfTickets < 10 ? numberOfTickets.ToString() : numberOfTickets + "+")} booked")</span>
                                                    }
                                                    else if (act.ExperienceCreationType == Framework.Enums.Enums.ExperienceCreationType.GeneralExperience && act.OngoingStudents != 0)
                                                    {
                                                        int numberOfStudents = RoundDownToNearestMultiple(act.OngoingStudents);
                                                        <img src="images/expolore-rating-star.png" class="star-tag-badge" />
                                                        <span class="number-of-reviews">@($"{(numberOfStudents < 10 ? numberOfStudents.ToString() : numberOfStudents + "+")} booked")</span>
                                                    }
                                                </div>
                                                <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 pulse-section">
                                                </div>
                                            </div>
                                            <div class="row text-start">
                                                <div class="title-section">
                                                    <div>
                                                        <h4 class="card-title1 mb-0">@act.Title</h4>
                                                        @if (@act.ExperienceTypeId == 1)
                                                        {
                                                            <p class="card-title2 mb-0 in-person">@act.CityName, @act.RegionName</p>
                                                        }
                                                        else
                                                        {
                                                            <p class="card-title2 mb-0 online">@(act.ExperienceTypeId == 1 ? "In-Person" : "Online")</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row price-badge-section">
                                                <div class="col-xl-7 col-lg-8 col-md-8 col-sm-8 col-8 price-section"><p class="card-title3">@GetPriceLabel(act)</p></div>
                                                <div class="col-xl-5 col-lg-4 col-md-4 col-sm-4 col-4 active-badge-section">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </Animate>
                            </Div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}


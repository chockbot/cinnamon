<ModalLogin @ref="signinModal" />

@code {
    int year = DateTime.Now.Year;

    IJSObjectReference module;

    private ModalLogin signinModal;

    public ClaimsPrincipal AuthState { get; set; }

    public Profile CustomerModel = new Profile();

    public List<Activity> activities = new List<Activity>();

    public string addToFavorites = "images/favorites/experience-heart-default.svg";

    public string searchValue = string.Empty;

    public string buttonLabel = "Browse all";

    int SelectedValue = 5;

    protected override async Task OnInitializedAsync()
    {
        //get activities randomly
        await FetchActivities();
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args = result.Result.Result;
                CustomerModel.Token = token;
                CustomerModel.CustomerProfile = new CustomerProfile
                {
                    Birthdate = args.Birthdate,
                    Email = args.Email,
                    FirstName = args.FirstName,
                    LastName = args.LastName,
                    Id = args.Id,
                    IsMaker = args.IsMaker,
                    IsVerified = args.IsVerified,
                };
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Landing Page Loaded");
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.onboarding.init");
            await GetFavorites();
        }
        else
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.onboarding.init");
            await GetFavorites();
        }
    }

    private async Task FetchActivities()
    {
        var ActivityListData = await activityApiHandler.GetAllActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllActivitiesArgs
            {
                IncludeActivityAddress = true,
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true,
                IncludeExperienceTypes = true,
                IncludeExperienceCategories = true,
                IncludeSubCategories = true,
                IsActive = true,
                PageIndex = 1,
                CountPerPage = 4,
                IncludeCustomer = true,
                IncludeStudents = true,
                IsDeactivated = false,
                Status = Framework.Enums.Enums.ActivityStatus.Submitted,
                IncludeReviews = true
            });
        if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
        {
            if (ActivityListData.Result.Result.Count() > 0)
            {
                activities = ActivityListData.Result.Result.Select(r =>
                {
                    return new Activity{
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceType = r.ExperienceType,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        ExperienceCategory = r.ExperienceCategory,
                        SubCategory = r.SubCategory,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        CityName = r.CityName,
                        Subdivision = r.Subdivision,
                        Region = r.Region,
                        RegionName = r.RegionName,
                        Barangay = r.Barangay,
                        BarangayName = r.BarangayName,
                        PostalCode = r.PostalCode,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin,
                        CreatedBy = r.CreatedBy,
                        Handler = r.Handler,
                        IsNew = r.IsNew,
                        OngoingStudents = r.OngoingStudents,
                        CompletedStudents = r.CompletedStudents,
                        NumberOfReviews = r.NumberOfReviews,
                        AverageRating = r.AverageRating,
                        ActivitySchedules = r.ActivitySchedules.Select(e =>
                        {
                        return new ActivitySchedule{
                             Id = e.Id,
                             Name = e.Name,
                             PerUnit1 = e.PerUnit1,
                             PerUnit2 = e.PerUnit2,
                             Price = e.Price,
                             PriceUnit1 = e.PriceUnit1,
                             PriceUnit2 = e.PriceUnit2,
                             UnitPrice = e.UnitPrice
                        };
                        }).ToList(),
                        Images = r.Images.Select(i =>{
                        return new ActivityImage{
                             Id = i.Id,
                             ImageSrc = i.ImageSrc,
                             Name = i.Name
                        };
                        }).ToList(),
                        Owner = new CustomerProfile
                        {
                            IsVerified = r.Owner.IsVerified
                        }
                    };
                }).ToList();
            }
        }
    }

    private async Task GetFavorites()
    {
        if (CustomerModel.CustomerProfile != null)
        {
            var customerFavorites = await activityApiHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs
                {
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
            if (customerFavorites.Succeeded && customerFavorites.Result != null && customerFavorites.Result.IsSuccess)
            {
                CustomerModel.Favorites = customerFavorites.Result.Result.Select(i =>
                {
                    return new Favorite
                        {
                            ActivityId = i.ActivityId,
                            CustomerId = i.CustomerId,
                            IsFavorite = true
                        };
                }).ToList();
            }
        }
    }

    private async Task AddToFavorites(Activity activity)
    {
        activity.IsFavorite = !activity.IsFavorite;
        if (activity.IsFavorite)
        {
            //Add to Favorites
            var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        else
        {
            //Delete to Favorites
            var createFavorite = await activityApiHandler.RemoveFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.RemoveFavoriteArgs
                {
                    ActivityId = activity.ActivityId,
                    CustomerId = CustomerModel.CustomerProfile.Id
                }, CustomerModel.Token);
        }
        await GetFavorites();
    }

    private async Task CreateFavorite(Activity activity)
    {
        //Add to Favorites
        var createFavorite = await activityApiHandler.CreateFavorite(new Framework.ApiCommand.ApiCore.Favorite.Request.CreateFavoriteArgs
            {
                ActivityId = activity.ActivityId,
                CustomerId = CustomerModel.CustomerProfile.Id
            }, CustomerModel.Token);
        await GetFavorites();
    }

    private string GetPriceLabel(Activity activity)
    {
        var schedules = activity.ActivitySchedules.OrderBy(s => s.Price).ToList();
        if (schedules.Count > 1)
        {
            return $"₱ {(long)schedules[0].Price} - {(long)schedules[schedules.Count - 1].Price}";
        }
        if (schedules.Count == 1)
        {
            return $"₱ {(long)schedules[0].Price}";
        }
        return string.Empty;
    }

    private void NavigateToExplorePage()
    {
        NavigationManager.NavigateTo("/explore");
    }
    private void SearchToExplorePage()
    {
        if (string.IsNullOrEmpty(searchValue))
        {
            NavigationManager.NavigateTo("/explore");
        }
        else
        {
            NavigationManager.NavigateTo($"/explore/experiences/{searchValue}");
        }
    }

    private void NavigateToOnboardingPage()
    {
        NavigationManager.NavigateTo("/Onboarding");
    }
    private Task OnChageInput(ChangeEventArgs e)
    {
        string text = e.Value.ToString();
        if (string.IsNullOrEmpty(text))
        {
            buttonLabel = "Browse all";
        }
        else
        {
            buttonLabel = "Explore";
        }

        return Task.CompletedTask;
    }
}

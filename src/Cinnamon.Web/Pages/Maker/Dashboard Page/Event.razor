@if(profile.Id != 0)
{
    <div class="section-1">
        <div class="activity">
            <div class="activities-section">
                <div class="title">Activities</div>
                <Divider />
                <div class="activity-header">
                    <p class="header">Title</p>
                    <p class="header">Type</p>
                    <p class="header">Status</p>
                    <p class="header ms-3">Action</p>
                </div>
                <Divider />
                <div class="activity-table">
                    @foreach (var item in OTEActivities)
                    {
                        <div class="activity-details">
                            <div class="activity-title">
                                <p class="activity-text">@item.EventName</p>
                            </div>
                            @*Activity Type*@
                            @if (!string.IsNullOrEmpty(item.PinnedLocation))
                            {
                                <div class="activity-type-face">
                                    <p class="activity-face">Face to Face</p>
                                </div>
                            }
                            else
                            {
                                <div class="activity-type-online">
                                    <p class="activity-online">Online</p>
                                </div>
                            }
                            @*Schedule*@
                            <div class="activity-title">
                                <p class="activity-text">@item.ScheduleFrom.ToString("MMMM dd")-@item.ScheduleTo.ToString("MMMM dd, yyyy")</p>
                            </div>
                            @*Activity Status & Action*@
                            <div class="details-action ms-3 pe-2">
                                <button class="view-details" @onclick="@(() => NavigateToEventDetails(item.Handler, item.OteDateId))">View Details</button>
                            </div>
                        </div>
                        <Divider />
                    }
                </div>
            </div>
            <div class="mobile-other-section mt-3">
                <div class="profile-section">
                    <p class="manual-title">Profile</p>
                    <p class="manual-text">@profilePercentage Completed - <span><a class="link-profile" @onclick="NavigateToGetVerified">Click Here</a></span></p>
                    <div class="profile-pic">
                        <div class="d-flex justify-content-center">
                            <CircularProgress Id='@($"progress-{profile.FirstName}")' Size="90" PieColor="@color" Percentage="GetSessionPercentage()">
                                <img class="profile-img" src="@profile.ProfilePath" />
                            </CircularProgress>
                        </div>
                        <p class="profile-name">@profile.FirstName @profile.LastName</p>
                        <p class="manual-text">@profile.Email</p>
                    </div>
                    <div class="manual-option">
                        <button class="view-profile" @onclick="NavigateToProfile">View Profile</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="other-section">
            <div class="create-section">
                <p class="manual-title">Start a new event?</p>
                <div class="manual-option mt-3">
                    <button class="create-activity" @onclick="NavigateToCreate">Create New</button>
                </div>
            </div>
            <div class="attendance-section">
                <p class="manual-title">Schedule</p>
                <p class="manual-text">No Schedule for today.</p>
                <div class="manual-option">
                    <button class="check-attendance">Scan Tickets</button>
                </div>
            </div>
            <div class="profile-section">
                <p class="manual-title">Profile</p>
                <p class="manual-text">@profilePercentage Completed - <span><a class="link-profile" @onclick="NavigateToGetVerified">Click Here</a></span></p>
                <div class="profile-pic">
                    <div class="d-flex justify-content-center">
                        <CircularProgress Id='@($"progress-{profile.Id}")' Size="90" PieColor="@color" Percentage="GetSessionPercentage()">
                            <img class="profile-img" src="@profile.ProfilePath" />
                        </CircularProgress>
                    </div>
                    <p class="profile-name">@profile.FirstName @profile.LastName</p>
                    <p class="manual-text">@profile.Email</p>
                </div>
                <div class="manual-option">
                    <button class="view-profile" @onclick="NavigateToProfile">View Profile</button>
                </div>
            </div>
        </div>
    </div>
}
<br/>
@code {
    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public string overAllTotal { get; set; }

    [Parameter]
    public bool HasPayoutAccount { get; set; }

    public List<OteActivity> OTEActivities = new List<OteActivity>();

    private CustomerProfile profile = new CustomerProfile();

    private string color = "#FFA942";

    private string profilePercentage { get; set; } = "0%";

    protected override async Task OnInitializedAsync()
    {
        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
        if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer        = result.Result.Result;
        profile.Id          = customer.Id;
        profile.FirstName   = customer.FirstName;
        profile.LastName    = customer.LastName;
        profile.Handler     = customer.Handler;
        profile.ProfilePath = customer.ProfileImg;
        profile.IsVerified  = customer.IsVerified;
        profile.IsMaker     = customer.IsMaker;
        profile.Email       = customer.Email;
        profile.About       = customer.About;
        //GEt OTE Event
        await GetOTEActivities();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", "#explore-category-scrollbar");
        }
    }
    
    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/customer/profile");
    }
    private async Task GetOTEActivities()
    {
        //Get OTE Details
        var resultOTE = await activityApiHandler.GetOtePerDay(Token);
        if (resultOTE.Succeeded && resultOTE.Result != null && resultOTE.Result.IsSuccess)
        {
            OTEActivities = resultOTE.Result.Result.Select(a =>
            {
                return new OteActivity
                    {
                        Id               = a.ActivityId,
                        ExperienceTypeId = a.ExperienceTypeId,
                        EventName        = a.Title,
                        Description      = a.Description,
                        Handler          = a.Handler,
                        CityName         = a.CityName,
                        RegionName       = a.RegionName,
                        PinnedLocation   = a.PinnedLocation,
                        EventImage       = a.EventImage,
                        ScheduleFrom     = a.DateStart,
                        ScheduleTo       = a.DateEnd,
                        OteDateId        = a.DateId,
                        ForceDisable     = a.ForceDisable,
                    };
            }).Where(e => !e.ForceDisable).ToList();
        }
    }
    private void NavigateToEventDetails(string handler, int selectedId)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/events/{handler}/?date={selectedId}");
    }
    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo($"/experiences/ote");
    }
    private int GetSessionPercentage()
    {
        double checkItem = 0;
        double denominator = 4;
        if (profile.IsVerified == 2)
        {
            checkItem += 1;
        }
        if (!string.IsNullOrEmpty(profile.About))
        {
            checkItem += 1;
        }
        if (!string.IsNullOrEmpty(profile.ProfileImg))
        {
            checkItem += 1;
        }
        if (HasPayoutAccount)
        {
            checkItem += 1;
        }
        //Get Payout Details
        profilePercentage = $"{(int)((checkItem / denominator) * 100)}%";
        return (int)((checkItem / denominator) * 100);
    }
    private void NavigateToGetVerified()
    {
        NavigationManager.NavigateTo("/customer/user-verification/?redirect=redirect_account"); 
    }
}

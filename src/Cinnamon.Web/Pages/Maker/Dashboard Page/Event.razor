@if (profile.Id != 0)
{
    <div class="section-1">

        <div class="activity">
            <div class="calendar-events">
                <div class="title">Events</div>
                <Divider />
                <div class="@WrapperClass">
                    <div class="calendar-header d-flex align-items-center justify-content-between">
                        <div class="text-center font-20 font-weight-700 color-black-100 text-capitalize">@activeDate.ToString("MMMM yyyy")</div>
                        <div class="button-calendar">
                            <Button Clicked="PrevMonthClick">
                                <img class="img-navigation cursor-pointer" src="images/back-icon.png" alt="prev">
                            </Button>
                            <Button Clicked="NextMonthClick">
                                <img style="transform: rotate(180deg);" class="img-navigation cursor-pointer" src="images/back-icon.png" alt="next">
                            </Button>
                        </div>
                    </div>
                    <div class="calendar-grid-container">
                        <div class="grid-item header">sun</div>
                        <div class="grid-item header">mon</div>
                        <div class="grid-item header">tue</div>
                        <div class="grid-item header">wed</div>
                        <div class="grid-item header">thu</div>
                        <div class="grid-item header">fri</div>
                        <div class="grid-item header">sat</div>
                        @foreach (var item in calendarItems)
                        {
                            <div class="grid-item" @key="item">
                                @if (!item.Empty)
                                {
                                    <span class="@DayClass(item.Selected, item.Date)">
                                        @NumberString(item.Date.Day)
                                    </span>
                                    @if (item.Selected)
                                    {
                                        @foreach (var name in item.Title)
                                        {
                                            <Tooltip Text="@name.EventName">
                                                <button class="event-title" @onclick="@(() => SelectSchedule(name))">@name.EventName</button>
                                            </Tooltip>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="activities-section">
                <div class="title">Events</div>
                <Divider />
                <div class="activity-header">
                    <p class="header">Title</p>
                    <p class="header">Type</p>
                    <p class="header">Status</p>
                    <p class="header ms-3">Action</p>
                </div>
                <Divider />
                <div class="activity-table">
                    @foreach (var item in OTEActivities)
                    {
                        <div class="activity-details">
                            <div class="activity-title">
                                <p class="activity-text">@item.EventName</p>
                            </div>
                            @*Activity Type*@
                            @if (!string.IsNullOrEmpty(item.PinnedLocation))
                            {
                                <div class="activity-type-face">
                                    <p class="activity-face">Face to Face</p>
                                </div>
                            }
                            else
                            {
                                <div class="activity-type-online">
                                    <p class="activity-online">Online</p>
                                </div>
                            }
                            @*Schedule*@
                            <div class="activity-title">
                                <p class="activity-text">@item.ScheduleFrom.ToString("MMMM dd")-@item.ScheduleTo.ToString("MMMM dd, yyyy")</p>
                            </div>
                            @*Activity Status & Action*@
                            <div class="details-action ms-3 pe-2">
                                <button class="view-details" @onclick="@(() => NavigateToEventDetails(item.Handler, item.OteDateId))">View Details</button>
                            </div>
                        </div>
                        <Divider />
                    }
                </div>
            </div>
            <div class="mobile-other-section mt-3">
                <div class="profile-section">
                    <p class="manual-title">Profile</p>
                    <p class="manual-text">@profilePercentage Completed - <span><a class="link-profile" @onclick="NavigateToGetVerified">Click Here</a></span></p>
                    <div class="profile-pic">
                        <div class="d-flex justify-content-center">
                            <CircularProgress Id='@($"progress-{profile.FirstName}")' Size="90" PieColor="@color" Percentage="GetSessionPercentage()">
                                <img class="profile-img" src="@profile.ProfilePath" />
                            </CircularProgress>
                        </div>
                        <p class="profile-name">@profile.FirstName @profile.LastName</p>
                        <p class="manual-text">@profile.Email</p>
                    </div>
                    <div class="manual-option">
                        <button class="view-profile" @onclick="NavigateToProfile">View Profile</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="other-section desktop-other-switch">
            <div class="create-section">
                <p class="manual-title">Start a new event?</p>
                <div class="manual-option mt-3">
                    <button class="create-activity" @onclick="NavigateToCreate">Create New</button>
                </div>
            </div>
            <div class="attendance-section">
                <p class="manual-title">Schedule</p>
                <p class="manual-text">
                    @if (OTEActivities.Any(a => a.ScheduleTo.Date == DateTime.Now.Date))
                    {
                        var currentEvent = OTEActivities.Where(a => a.ScheduleTo.Date == DateTime.Now.Date).FirstOrDefault();
                        @currentEvent.EventName
                    }
                    else
                    {
                        @if (selectedEvent.Id != 0)
                        {
                            @selectedEvent.EventName
                        }
                        else
                        {
                            <text>No schedule for today.</text>
                        }
                    }
                </p>
                <div class="manual-option">
                    @if (OTEActivities.Any(a => a.ScheduleTo.Date == DateTime.Now.Date))
                    {
                        var currentEvent = OTEActivities.Where(a => a.ScheduleTo.Date == DateTime.Now.Date).FirstOrDefault();
                        <button class="check-attendance" @onclick="@(() => NavigateToScanTickets(currentEvent.Handler, currentEvent.OteDateId))">Scan Tickets</button>
                    }
                    else
                    {
                        @if (selectedEvent.Id != 0)
                        {
                            <button class="check-attendance" @onclick="@(() => NavigateToScanTickets(selectedEvent.Handler, selectedEvent.OteDateId))">Scan Tickets</button>
                        }
                        else
                        {
                            <button class="check-attendance" disabled>Scan Tickets</button>
                        }
                    }
                </div>
            </div>
            <div class="profile-section">
                <p class="manual-title">Profile</p>
                <p class="manual-text">@profilePercentage Completed - <span><a class="link-profile" @onclick="NavigateToGetVerified">Click Here</a></span></p>
                <div class="profile-pic">
                    <div class="d-flex justify-content-center">
                        <CircularProgress Id='@($"progress-{profile.Id}")' Size="90" PieColor="@color" Percentage="GetSessionPercentage()">
                            <img class="profile-img" src="@profile.ProfilePath" />
                        </CircularProgress>
                    </div>
                    <p class="profile-name">@profile.FirstName @profile.LastName</p>
                    <p class="manual-text">@profile.Email</p>
                </div>
                <div class="manual-option">
                    <button class="view-profile" @onclick="NavigateToProfile">View Profile</button>
                </div>
            </div>
        </div>

        <!-- For Mobile Swiper -->
        <div class="other-section mobile-switch">
            <div class="schedule-swiper">
                <div class="swiper-wrapper mobile-swiper">
                    <div class="swiper-slide">
                        <div class="create-section">
                            <p class="manual-title">Start a new event?</p>
                            <div class="manual-option mt-3">
                                <button class="create-activity" @onclick="NavigateToCreate">Create New</button>
                            </div>
                        </div>
                    </div>
                    <div class="swiper-slide">
                        <div class="attendance-section">
                            <p class="manual-title">Schedule</p>
                            <p class="manual-text">No Schedule for Today.</p>
                            <div class="manual-option">
                                <button class="check-attendance">Scan Tickets</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
}
<br/>
@code {
    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public string overAllTotal { get; set; }

    [Parameter]
    public bool HasPayoutAccount { get; set; }

    public List<OteActivity> OTEActivities = new List<OteActivity>();

    private CustomerProfile profile = new CustomerProfile();

    private string color = "#FFA942";

    private string profilePercentage { get; set; } = "0%";

    public DateTime CurrentDate { get; set; } = DateTime.Now;

    public IEnumerable<DateTime> SelectedDates { get; set; } = Enumerable.Empty<DateTime>();

    public bool ViewOnly { get; set; }

    public EventCallback<DateTime> OnSelectedDate { get; set; }

    public EventCallback<CalendarCurrentMonth> OnPreviousMonthChanged { get; set; }

    public EventCallback<CalendarCurrentMonth> OnNextMonthChanged { get; set; }

    public bool StrikeOutNotSelected { get; set; }

    public bool UnHighlightLoadedDates { get; set; }

    public bool Flat { get; set; }

    public bool StoreClickedItems { get; set; }

    private IList<CalendarItem> calendarItems = new List<CalendarItem>();

    private DateTime activeDate;

    private Dictionary<DateTime, CalendarItem> clickedItems = new();

    public OteActivity selectedEvent = new OteActivity();

    public int registrationCount { get; set; } = 0;

    public List<OteSchedule> ticketList = new List<OteSchedule>();

    protected override async Task OnInitializedAsync()
    {
        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
        if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer        = result.Result.Result;
        profile.Id          = customer.Id;
        profile.FirstName   = customer.FirstName;
        profile.LastName    = customer.LastName;
        profile.Handler     = customer.Handler;
        profile.ProfilePath = customer.ProfileImg;
        profile.IsVerified  = customer.IsVerified;
        profile.IsMaker     = customer.IsMaker;
        profile.Email       = customer.Email;
        profile.About       = customer.About;
        //Get OTE Event
        await GetOTEActivities();
        //Load Calendar
        activeDate = CurrentDate;
        LoadCalendarItems();

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper");
        }
    }

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/customer/profile");
    }
    private async Task GetOTEActivities()
    {
        //Get OTE Details
        var resultOTE = await activityApiHandler.GetOtePerDay(Token);
        if (resultOTE.Succeeded && resultOTE.Result != null && resultOTE.Result.IsSuccess)
        {
            OTEActivities = resultOTE.Result.Result.Select(a =>
            {
                return new OteActivity
                    {
                        Id               = a.ActivityId,
                        ExperienceTypeId = a.ExperienceTypeId,
                        EventName        = a.Title,
                        Description      = a.Description,
                        Handler          = a.Handler,
                        CityName         = a.CityName,
                        RegionName       = a.RegionName,
                        PinnedLocation   = a.PinnedLocation,
                        EventImage       = a.EventImage,
                        ScheduleFrom     = a.DateStart,
                        ScheduleTo       = a.DateEnd,
                        OteDateId        = a.DateId,
                        ForceDisable     = a.ForceDisable,
                    };
            }).Where(e => !e.ForceDisable).ToList();
            await SelectSchedule(OTEActivities[0]);
        }
    }
    private void NavigateToEventDetails(string handler, int selectedId)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/events/{handler}/?date={selectedId}");
    }
    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo($"/experiences/ote");
    }
    private int GetSessionPercentage()
    {
        double checkItem = 0;
        double denominator = 4;
        if (profile.IsVerified == 2)
        {
            checkItem += 1;
        }
        if (!string.IsNullOrEmpty(profile.About))
        {
            checkItem += 1;
        }
        if (!string.IsNullOrEmpty(profile.ProfileImg))
        {
            checkItem += 1;
        }
        if (HasPayoutAccount)
        {
            checkItem += 1;
        }
        //Get Payout Details
        profilePercentage = $"{(int)((checkItem / denominator) * 100)}%";
        return (int)((checkItem / denominator) * 100);
    }
    private void NavigateToGetVerified()
    {
        NavigationManager.NavigateTo("/customer/user-verification/?redirect=redirect_account"); 
    }
    public void LoadCalendarItems()
    {
        calendarItems.Clear();
        var now = activeDate;
        var startDate = new DateTime(now.Year, now.Month, 1);
        var endDate = startDate.AddMonths(1).AddDays(-1);
        var skipCount = (int)startDate.DayOfWeek;

        for (int i = 1; i < endDate.Day + (skipCount + 1); i++)
        {
            if (i <= skipCount)
            {
                calendarItems.Add(new CalendarItem
                    {
                        Empty = true
                    });
            }
            else
            {
                var currentDateTime = DateTime.UtcNow;
                var date = new DateTime(now.Year, now.Month, i - skipCount, now.TimeOfDay.Hours, now.TimeOfDay.Minutes, now.TimeOfDay.Seconds);
                var selected = OTEActivities.Any(a => a.ScheduleTo.Date == date.Date);
                var titles = OTEActivities.Where(a => a.ScheduleTo.Date == date.Date).ToList();
                calendarItems.Add(new CalendarItem
                    {
                        Empty = false,
                        Date = date,
                        Selected = selected,
                        Title = titles
                    });
            }
        }
    }

    private async Task NextMonthClick()
    {
        if (activeDate != DateTime.MaxValue)
        {
            var date = activeDate.AddMonths(1);
            activeDate = date;

            LoadCalendarItems();
            if (OnNextMonthChanged.HasDelegate)
            {
                await OnNextMonthChanged.InvokeAsync(new CalendarCurrentMonth
                    {
                        Month = date.Month,
                        Year = date.Year
                    });
            }
        }
    }

    private async Task PrevMonthClick()
    {
        if (activeDate.Date != DateTime.MinValue)
        {
            var date = activeDate.AddMonths(-1);
            activeDate = date;

            LoadCalendarItems();
            if (OnPreviousMonthChanged.HasDelegate)
            {
                await OnPreviousMonthChanged.InvokeAsync(new CalendarCurrentMonth
                    {
                        Month = date.Month,
                        Year = date.Year
                    });
            }
        }
    }
    private string DayClass(bool selected, DateTime? date = null)
    {
        string result = "day prevent-select";
        if (selected)
        {
            result += $" selected rounded-circle";
        }
        return result;
    }
    private string WrapperClass
    {
        get
        {
            string result = "calendar-wrapper";
            if (Flat) result += " flat";
            return result;
        }
    }
    private string NumberString(int number)
    {
        if (number.ToString().Length > 1) return number.ToString();
        return $"0{number}";
    }
    private class CalendarItem
    {
        public DateTime Date { get; set; }
        public bool Empty { get; set; }
        public bool Selected { get; set; }
        public List<OteActivity> Title { get; set; }
    }

    public class CalendarCurrentMonth
    {
        public int Month { get; set; }
        public int Year { get; set; }
    }
    public async Task SelectSchedule(OteActivity oteActivity)
    {
        selectedEvent = oteActivity;
        //Get Ticket Details
        var ticketResult = await dashboardApiHandler.GetTicketDetails(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetTicketDetailsArgs
            {
                ActivityId = selectedEvent.Id,
                DateId = selectedEvent.OteDateId
            }, Token);
        if (ticketResult.Succeeded && ticketResult.Result != null && ticketResult.Result.IsSuccess)
        {
            ticketList = ticketResult.Result.Result.Select(s => new OteSchedule
                {
                    ActivityId = s.ActivityId,
                    From = s.From,
                    OtePricing = new OtePricing
                    {
                        MaxSlots = s.OtePricingDTO.MaxSlots,
                        Sold = s.OtePricingDTO.Sold,
                    }
                }).ToList();
        }
        registrationCount = ticketList.Sum(s => s.OtePricing.Sold);
    }
    public void NavigateToScanTickets(string Handler, int OteDateId)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/events/{Handler}/verification/?date={OteDateId}");
    }
}

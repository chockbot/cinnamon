@layout DashboardLayout
@page "/maker/dashboard"
@using System.Security.Claims
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@attribute [Authorize]




<div class="header">
    <p class="title">Experiences</p>
    <button class="create-button">Create</button>
</div>


        @for (int i = 0; i < 3; i++)
{
   


<div class="experience-container">
    <div class="xp-content">
        <img class="xp-image" src="images/Activities/Guitar2.jpg">
    

    <div class="xp-context">
        <p class="xp-title">Bass Guitar Lesson for all!</p>
        <p class="xp-description">We can work on technique, reading, rhythm, scales, patterns and various genres, but we will not learn something that does not interest you. If your goal is to play a certain song and you don't want to.</p>
            <div class="xp-category">
                <img src="images/activity-summary/location.png">
                <span>Face to Face</span>
            </div>
    </div>

    </div>

    <hr>

    <div class="xp-actions">
        <div class="active">
                <span class="active-button"><img src="images/checked-circle.png" /></span>
            <span>Active</span>
        </div>

        <button class="update-button">Update</button>
    </div>

</div>

}

@code
{
    private DashboardModel Model;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer = result.Result.Result;

        // check if customer is maker
        if(!customer.IsMaker)
        {
            // account is not maker redirect to explore page
            NavigationManager.NavigateTo("explore");
            return;
        }

        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs {}, token);
        var activities = new List<Activity>();

        if(activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.OrderBy(a => a.ActivityId).Select(a => {
                // map only required fields
                return new Activity {
                    ActivityId = a.ActivityId,
                    IsPublished = a.IsPublished,
                    Title = a.Title
                };
            }).ToList();
        }

        Model = new DashboardModel {
            Activities = activities,
            ActiveActivityCount = activities.Where(a => a.IsPublished == true).Count(),
            Token = token
        };
    }

    private void ActiveCountChanged(int count)
    {
        Model.ActiveActivityCount-= count;
    }

    string selectedTab = "active";

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
}
@layout DashboardLayout
@page "/maker/dashboard"
@using System.Security.Claims
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Framework.Enums
@using Cinnamon.Web.Models.Ote
@using Microsoft.JSInterop
@using Cinnamon.Web.Components
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject ITransactionApiHandler transactionApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject IJSRuntime jsRuntime
@attribute [Authorize]

<PageTitle>Dashboard | CinnamonPH</PageTitle>
<SeoMeta Title="Dashboard" Subject="Dashboard" Url="/maker/dashboard" />

@if (Model != null)
{
    @if (IsNotVerified)
    {
        <div class="announcement">
            <img src="images/user-verification/warning.png" class="me-4" alt="icon">
            <p class="mb-0 me-3 w-100">
                <span>Account Verification!</span> <br>
                Your account is not yet verified. Please check your account for the complete process of setting it up.
            </p>
            <Button class="btn-primary width-150 m-margin-top-10"
            Border="Border.Is0" Clicked="NavigateToUserVerification">
                Get Started
            </Button>
        </div>
    }
    else
    {
        <div class="announcement">
            <img src="images/bulb.svg" class="me-4" alt="icon">
            <p class="m-0">
                <span>Announcement! </span>
                We would like to remind you to check the attendance of your students on the ATTENDANCE tab.
                This will help you keep track of your students progress and ensure that everyone is attending classes regularly.
            </p>
        </div>
    }

    @if (selectedTab == "general-activities" || selectedTab == "activity-via-appointment")
    {
        //Earnings, Tickets and Schedule
        <div class="dashboard-header">
            <div class="dashboard-wrapper">
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-flex">
                            <div class="col-8 d-block justify-content-start">
                                <p class="title">Total Sales</p>
                                <p class="amount">&#8369;@totalSales</p>
                            </div>
                            <div class="col-4 d-flex justify-content-end">
                                <img class="earning-icon" src="images/Dashboard/earnings-icon.png" />
                            </div>
                        </div>
                        <div class="col-12 d-flex">
                            <div class="col-8 d-flex justify-content-start">
                                <p class="description">Total sales from all activities</p>
                            </div>
                            <div class="col-4 d-flex justify-content-end">
                                <a class="earnings-link" href="/maker/dashboard/grosssale">View sales</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-flex">
                            <div class="col-8 d-block justify-content-start">
                                <p class="title">No. of Enrollees</p>
                                <p class="amount">@NoOfEnrollees</p>
                            </div>
                            <div class="col-4 d-flex justify-content-end">
                                <img class="enrollees-icon" src="images/Dashboard/event-icon.png" />
                            </div>
                        </div>
                        <div class="col-12 d-flex">
                            <div class="col-7 d-flex justify-content-start">
                                <p class="description">See Enrolled Students</p>
                            </div>
                            <div class="col-5 d-flex justify-content-end">
                                <a class="earnings-link" href="/maker/dashboard/managestudents">Manage Students</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                    <div class="experience-content">
                        <div class="col-12 d-flex">
                            <div class="col-10 d-block justify-content-start">
                                <p class="title">Schedule</p>
                                <p class="schedule-description">You have an ongoing experience. Check your attendance for today</p>
                            </div>
                            <div class="col-2 d-flex justify-content-end">
                                <img class="calendar-icon" src="images/Dashboard/schedule-icon.png" />
                            </div>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <a class="earnings-link" href="/maker/dashboard/attendance">Check Attendance</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

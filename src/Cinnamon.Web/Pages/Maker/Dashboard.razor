                                                            <img class="me-1" src='@(item.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                                                        </button>
                                                        <span>@(item.IsPublished ? "Active" : "Inactive")</span>
                                                    </div>
                                                    <div class="button-section">
                                                        <a button class="update-button bg-orange-100" href="maker/update-activity?activityId=@item.ActivityId">Update</a>

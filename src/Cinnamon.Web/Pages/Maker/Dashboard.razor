                            <div class="swiper-wrapper">
                                <div class='swiper-slide @(selectedTab == "general-activities" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "general-activities" ? "active" : "")'
                                     @onclick='() => selectedTab = "general-activities"'>
                                        general activities
                                    </div>
                                </div>
                                <div class='swiper-slide @(selectedTab == "one-time-events" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "one-time-events" ? "active" : "")'
                                     @onclick='() => selectedTab = "one-time-events"'>
                                        one time events
                                    </div>
                                </div>
                                <div class='swiper-slide @(selectedTab == "activity-via-appointment" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "activity-via-appointment" ? "active" : "")'
                                     @onclick='() => selectedTab = "activity-via-appointment"'>
                                        activity via appointment
                                    </div>
                                </div>
                            </div>
                        </Div>

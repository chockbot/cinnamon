@layout DashboardLayout
@page "/maker/dashboard"
@using System.Security.Claims
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using Cinnamon.Web.Components.Pages;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@attribute [Authorize]

<PageTitle>Dashboard | CinnamonPH</PageTitle>
<SeoMeta Title="Dashboard" Subject="Dashboard" Url="/maker/dashboard" />

@if (Model != null)
{
    @if(IsNotVerified)
    {
        <div class="announcement">
            <img src="images/user-verification/warning.png" class="me-4" alt="icon">
            <p class="mb-0 me-3 w-100">
                <span>Account Verification!</span> <br>
                Your account is not yet verified. Please check your account for the complete process of setting it up.
            </p>
            <Button class="btn-primary width-150 m-margin-top-10" 
                Border="Border.Is0" Clicked="NavigateToUserVerification">
                Get Started
            </Button>
        </div>
    }
    else 
    {
        <div class="announcement">
            <img src="images/bulb.svg" class="me-4" alt="icon">
            <p class="m-0">
                <span>Announcement! </span>
                We would like to remind you to check the attendance of your students on the ATTENDANCE tab. 
                This will help you keep track of your students progress and ensure that everyone is attending classes regularly. 
            </p>
        </div>
    }
    <div class="header">
        <p class="title">Experiences</p>
        <button class="create-button" @onclick="NavigateToCreation">Create New Experience</button>
    </div>
    @foreach (var item in activities)
    {
        if (item.IsPublished == true)
        {
            <div class="experience-container" style="box-shadow: 0px 4px 10px 0px #60996D;">
                <div class="xp-content">
                    <img class="xp-image" src="@item.Images.ElementAt(0).ImageSrc">
                    <div class="xp-context">
                        <p class="xp-title">@item.Title</p>
                        <p class="xp-description">@item.Description</p>
                        <div class="xp-category">
                            @if (item.ExperienceTypeId == 1)
                            {
                                <img src="images/activity-summary/location.png">
                                <span>Face to Face</span>
                            }
                            else
                            {
                                <img src="images/activity-summary/laptop-icon.png">
                                <span>Online</span>
                            }
                        </div>
                    </div>
                </div>
                <hr>
                <div class="xp-actions">
                    <div class="active">
                        <button class="check-button" type="button" @onclick="() => CheckUnCheckAllStudent(item)">
                            <img class="me-1" src='@(item.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                        </button>
                        <span>@(item.IsPublished ? "Active" : "Inactive")</span>
                    </div>
                    <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                </div>
            </div>
        }
        else
        {
            <div class="experience-container" style="box-shadow: 0px 4px 10px 0px #717171;">
                <div class="xp-content">
                    <img class="xp-image" src="@item.Images.ElementAt(0).ImageSrc">
                    <div class="xp-context">
                        <p class="xp-title">@item.Title</p>
                        <p class="xp-description">@item.Description</p>
                        <div class="xp-category">
                            @if (item.ExperienceTypeId == 1)
                            {
                                <img src="images/activity-summary/location.png">
                                <span>Face to Face</span>
                            }
                            else
                            {
                                <img src="images/activity-summary/laptop-icon.png">
                                <span>Online</span>
                            }
                        </div>
                    </div>
                </div>
                <hr>
                <div class="xp-actions">
                    <div class="active">
                        <button class="check-button" type="button" @onclick="() => CheckUnCheckAllStudent(item)">
                            <img class="me-1" src='@(item.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                        </button>
                        <span>@(item.IsPublished ? "Active" : "Inactive")</span>
                    </div>
                    <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                </div>
            </div>
        }

    }
}


@code
{
    private DashboardModel Model {get; set;} = new();

    public List<Activity> activities = new List<Activity>();

    public Activity activity = new Activity();

    private bool IsNotVerified {get; set;}

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

            var token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
            {
                // an error occured
                NavigationManager.NavigateTo("explore");
                return;
            }
            var customer = result.Result.Result;

            // check if customer is maker
            if (!customer.IsMaker)
            {
                // account is not maker redirect to explore page
                NavigationManager.NavigateTo("explore");
                return;
            }
            IsNotVerified = customer.IsVerified == 0;

            var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
                {
                    IncludeActivityImages = true,
                }, token);

            if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
            {
                activities = activityRes.Result.Result.OrderBy(a => a.ActivityId).Select(a =>
                {
                    // map only required fields
                    return new Activity
                        {
                            ActivityId = a.ActivityId,
                            IsPublished = a.IsPublished,
                            Title = a.Title,
                            Description = a.Description,
                            ExperienceTypeId = a.ExperienceTypeId,
                            Images = a.Images.Select(i =>
                            {
                                return new ActivityImage
                                {
                                    Id = i.Id,
                                    ImageSrc = i.ImageSrc,
                                    Name = i.Name
                                };
                            }).ToList(),
                        };
                }).ToList();
            }
            Model = new DashboardModel
                {
                    Activities = activities,
                    ActiveActivityCount = activities.Where(a => a.IsPublished == true).Count(),
                    Token = token
                };
        }
        catch (Exception e)
        {
            throw e;
        }
    }

    private void NavigateToCreation()
    {
        NavigationManager.NavigateTo("creation", true);
    }

    private void NavigateToUserVerification()
    {
        NavigationManager.NavigateTo("customer/user-verification");
    }

    private void CheckUnCheckAllStudent(Activity activity)
    {
        activity.IsPublished = !activity.IsPublished;
        var res =  activityApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateActivityArgs
            {
                IsPublished = activity.IsPublished,
                ActivityId = activity.ActivityId
            }, Model.Token);
    }
}
@page "/maker/dashboard"
@using Cinnamon.Core
@using Cinnamon.Core.Module.CustomerService.Handler;
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@inject NavigationManager NavigationManager
@inject ISignedCustomer signedCustomer;

<section class="mt-5 maker-dashboard">
    <div class="container">
        <Row>
            <Column>
                <h3 class="text-capitalize fw-bold">experiences</h3>
            </Column>
            <Column>
            </Column>
        </Row>
        <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
            <Items>
                <Tab Display="Display.Flex" Flex="Flex.AlignItems.Center" Name="active" TextTransform="TextTransform.Capitalize" TextColor="TextColor.Black50">
                    active
                    <Badge TextColor="TextColor.White" Border="Border.RoundedCircle" Color="Color.Primary">@activeActivityCount</Badge>
                </Tab>
                <Tab Name="attendance-monitoring" TextTransform="TextTransform.Capitalize">attendance monitoring</Tab>
                <Tab Name="chat-room" TextTransform="TextTransform.Capitalize">chat room</Tab>
            </Items>
            <Content>
                <TabPanel Name="active">
                    <ExperienceList OnPublishChanged="ActiveCountChanged" Activities="activities" />
                </TabPanel>
                <TabPanel Name="attendance-monitoring">
                    Content for attendance monitoring
                </TabPanel>
                <TabPanel Name="chat-room">
                    Content for chat-room
                </TabPanel>
            </Content>
        </Tabs>
    </div>
</section>

@code
{
    private IList<ActivityModel> activities = new List<ActivityModel>();
    private int activeActivityCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var currentCustomer = await signedCustomer.ExecuteAsync(new Core.Module.CustomerService.Interactors.CurrentLogin {});
        if(!currentCustomer.Succeeded)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
        }

        var customer = currentCustomer.Result.Customer;

        activities = (await CoreDI.DataStore.Activities.GetActivityByCreatedId(customer.Id)).OrderBy(i => i.Id).ToList();
        activeActivityCount = activities.Where(i => i.IsPublished).Count();
    }

    private void ActiveCountChanged(int count)
    {
        activeActivityCount-= count;
    }

    string selectedTab = "active";

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
}
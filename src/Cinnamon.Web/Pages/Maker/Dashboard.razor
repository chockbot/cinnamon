                                                            <p class="xp-description">@item.Description</p>
                                                            <div class="xp-category">
                                                                @if (item.ExperienceTypeId == 1)
                                                                {
                                                                    <img src="images/activity-summary/location.png">
                                                                    <span>Face to Face</span>
                                                                }
                                                                else
                                                                {
                                                                    <img src="images/activity-summary/laptop-icon.png">
                                                                    <span>Online</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

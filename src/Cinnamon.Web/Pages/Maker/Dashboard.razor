@page "/maker/dashboard"
@using Cinnamon.Core
@using System.Security.Claims
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@attribute [Authorize]

@if(Model != null)
{
    <section class="mt-5 maker-dashboard">
        <div class="container">
            <Row>
                <Column>
                    <h3 class="text-capitalize fw-bold">experiences</h3>
                </Column>
                <Column>
                </Column>
            </Row>
            <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Display="Display.Flex" Flex="Flex.AlignItems.Center" Name="active" TextTransform="TextTransform.Capitalize" TextColor="TextColor.Black50">
                        active
                        <Badge TextColor="TextColor.White" Border="Border.RoundedCircle" Color="Color.Primary">@Model.ActiveActivityCount</Badge>
                    </Tab>
                    <Tab Name="attendance-monitoring" TextTransform="TextTransform.Capitalize">attendance monitoring</Tab>
                    <Tab Name="chat-room" TextTransform="TextTransform.Capitalize">chat room</Tab>
                </Items>
                <Content>
                    <TabPanel Name="active">
                        <ExperienceList OnPublishChanged="ActiveCountChanged" Activities="Model.Activities" Token="@Model.Token" />
                    </TabPanel>
                    <TabPanel Name="attendance-monitoring">
                        Content for attendance monitoring
                    </TabPanel>
                    <TabPanel Name="chat-room">
                        Content for chat-room
                    </TabPanel>
                </Content>
            </Tabs>
        </div>
    </section>
}

@code
{
    private DashboardModel Model;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer = result.Result.Result;

        // check if customer is maker
        if(!customer.IsMaker)
        {
            // account is not maker redirect to explore page
            NavigationManager.NavigateTo("explore");
            return;
        }

        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs {}, token);
        var activities = new List<Activity>();

        if(activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.Select(a => {
                // map only required fields
                return new Activity {
                    ActivityId = a.ActivityId,
                    IsPublished = a.IsPublished,
                    Title = a.Title
                };
            }).ToList();
        }

        Model = new DashboardModel {
            Activities = activities,
            ActiveActivityCount = activities.Where(a => a.IsPublished == true).Count(),
            Token = token
        };
    }

    private void ActiveCountChanged(int count)
    {
        Model.ActiveActivityCount-= count;
    }

    string selectedTab = "active";

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
}
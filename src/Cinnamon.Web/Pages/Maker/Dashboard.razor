                                                    <img class="xp-image" src="@(item.Images.Count > 0 ? item.Images.ElementAt(0).ImageSrc : string.Empty)">
                                                    <div class="xp-context">
                                                        <p class="xp-title">@item.Title</p>
                                                        <p class="xp-description">@item.Description</p>
                                                        <div class="xp-category">
                                                            @if (item.ExperienceTypeId == 1)
                                                            {
                                                                <img src="images/activity-summary/location.png">
                                                                <span>Face to Face</span>
                                                            }
                                                            else
                                                            {
                                                                <img src="images/activity-summary/laptop-icon.png">
                                                                <span>Online</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="xp-actions">
                                                    <div class="active">
                                                        <img class="img-inprogress" src="images/Dashboard/Inprogress.png" alt="check-icon">
                                                        <span> In progress</span>
                                                    </div>
                                                    <div class="button-section">
                                                        <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                                                        @if (item.Status == Enums.ActivityStatus.InProgress)
                                                        {
                                                            <button class="delete-button" @onclick="() => DeleteActivity(item.ActivityId)">Delete</button>
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                    }
                                </TabPanel>
                            </Content>
                        </Tabs>
                    </Container>
                </section>
            </div>
        @*Profile and Faqs*@
        <div class="col-lg-5 col-md-12 col-sm-12 col-12 dashboard-profile">
            <div class="col-12 profile-wrapper d-flex">
                <div class="col-lg-2 col-md-2 col-sm-3 col-3 profile-pic">
                    <img class="rounded-2 rounded-circle m-3" src="@profile.ProfilePath" width="60" height="60" />
                </div>
                <div class="col-lg-10 col-md-10 col-sm-9 col-9 d-block">
                    <p class="user-name">Hi, @profile.FirstName @profile.LastName</p>
                    <div class="row d-flex col-12 justify-content-center progress-bar-section">
                        <div class="row journey-card-section">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-3">
                                <div class="journey-card verified-label">
                                    Verified
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-3">
                                <div class="journey-card rare-label">
                                    Rare
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-3">
                                <div class="journey-card epic-label">
                                    Epic
                                </div>
                                <div class="epic-arrow-down"></div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-3">
                                <div class="journey-card legendary-label">
                                    Legendary
                                </div>
                            </div>
                        </div>
                        <div class="progress col-12">
                            <div class="progress-bar" role="progressbar" style="width:@(GetPercentage())%" aria-valuenow="@(GetPercentage())%" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="faqs-wrapper">
                    <p class="faqs-title">Faqs</p>

                    <p><a class="link-question" @onclick="() => ToggleAnswer(1)">What' s gonna happen when someone enrolls?</a></p>
                    <div class="link-answer" style="display: @(selectedQuestion == 1 ? "block" : "none")">
                        <ol>
                            <li class="answers">Customers will be automatically added to your personal group chat. You can access the chat by going to the MESSAGES.</li>
                            <li class="answers">You can check their contact information on the confirmation email that we've sent to you.</li>
                            <li class="answers">The enrollees are now available in the ATTENDANCE section.</li>
                        </ol>
                    </div>

                    <p><a class="link-question" @onclick="() => ToggleAnswer(2)">How will I get paid from my activity?</a></p>
                    <div class="link-answer" style="display: @(selectedQuestion == 2 ? "block" : "none")">
                        <p class="answers">
                            To receive payment, a completed session is a per-requisite. In the ATTENDANCE section,
                            make sure that you are checking the attendance of your enrollees; once completed,
                            Cinnamon will automatically process a payout request per completed enrollee.
                            Processing may take 2-3 business days according to bank and e-wallet policies for clearing.
                        </p>
                    </div>
                    <p><a class="link-question" @onclick="() => ToggleAnswer(3)">I want to update the attendance of my enrollee, how can I change this?</a></p>
                    <div class="link-answer" style="display: @(selectedQuestion == 3 ? "block" : "none")">
                        <p class="answers">
                            In the MANAGE STUDENT section, choose the enrollee and select UPDATE. Adjust attendance as necessary.
                        </p>
                    </div>
                    <p><a class="link-question" @onclick="() => NavigateToHelp()">More information here.</a></p>
                </div>
        </div>
    </div>
}

@code
{
    private DashboardModel Model { get; set; } = new();

    public List<Activity> activities = new List<Activity>();

    public List<Activity> GeneralActivities = new List<Activity>();

    public List<Activity> OTEActivities = new List<Activity>();

    public List<Activity> AppointmentActvities = new List<Activity>();

    private List<GrossSales> priceData = new List<GrossSales>();

    public Activity activity = new Activity();

    private List<ExperienceCreationType> experienceCreationTypes = new List<ExperienceCreationType>();

    public CustomerProfile profile = new CustomerProfile();

    private double cnt = 0;

    string token = string.Empty;

    private bool IsNotVerified { get; set; }

    private int NoOfEnrollees = 0;

    private int NoOfCompleted = 0;

    private string selectedTab = "general-activities";

    private int selectedQuestion = 1;

    private decimal totalEarnings { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
            {
                // an error occured
                NavigationManager.NavigateTo("explore");
                return;
            }
            var customer = result.Result.Result;
            profile.Id = customer.Id;
            profile.FirstName = customer.FirstName;
            profile.LastName = customer.LastName;
            profile.Handler = customer.Handler;
            profile.ProfilePath = customer.ProfileImg;
            profile.IsVerified = customer.IsVerified;

            profile.FirstName = customer.FirstName;
            profile.LastName = customer.LastName;
            profile.Handler = customer.Handler;
            profile.ProfilePath = customer.ProfileImg;
            profile.IsVerified = customer.IsVerified;

            // check if customer is maker
            if (!customer.IsMaker)
            {
                // account is not maker redirect to explore page
                NavigationManager.NavigateTo("explore");
                return;
            }
            IsNotVerified = customer.IsVerified == 0;

            await GetOwnedActivities(token);

            Model = new DashboardModel
                {
                    Activities = activities,
                    ActiveActivityCount = activities.Where(a => a.IsPublished == true).Count(),
                    Token = token
                };

            //Get 1 Month Earnings 
            DateTime startDate = DateTime.Today.AddMonths(-1);
            var gross = await transactionApiHandler.GetGrossSalesByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetGrossSalesByProviderArgs
                {
                    Id = profile.Id,
                    DateFrom = startDate.ToString("yyyyMMddHHmmss")
                }, Model.Token);
            if (gross.Succeeded && gross.Result != null && gross.Result.IsSuccess)
            {
                priceData = gross.Result.Result.OrderBy(a => a.PurchaseDate).Select(e =>
                {
                    return new GrossSales
                        {
                            PurchaseDate = e.PurchaseDate.Date,
                            Total = e.Total
                        };
                }).ToList();
            }
            totalEarnings = priceData.Sum(a => a.Total);
        }
        catch (Exception e)
        {
            throw e;
        }
    }

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    private void CheckUnCheckAllStudent(Activity activity)
    {
        activity.IsPublished = !activity.IsPublished;
        var res = activityApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateActivityArgs
            {
                IsPublished = activity.IsPublished,
                ActivityId = activity.ActivityId,
                Status = Enums.ActivityStatus.Submitted
            }, Model.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init");
    }

    private async Task DeleteActivity(int activityId)
    {
        var res = await activityApiHandler.DeleteActivityById(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteActivityArgs
            {
                ActivityId = activityId
            }, Model.Token);

        if (res.Result.IsSuccess)
        {
            await GetOwnedActivities(token);
        }
    }

    private async Task GetOwnedActivities(string token)
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
            {
                IncludeActivityImages = true,
                IncludeStudents = true,
                IncludeAtivitySchedules = true
            }, token);

        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title,
                        Description = a.Description,
                        ExperienceTypeId = a.ExperienceTypeId,
                        ExperienceCreationType = a.ExperienceCreationType,
                        Handler = a.Handler,
                        Images = a.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                        Status = a.Status,
                        OngoingStudents = a.OngoingStudents,
                        CompletedStudents = a.CompletedStudents
                    };
            }).ToList();
        }
        GeneralActivities = activities.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience).ToList();
        OTEActivities = activities.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.OneTimeEvents).ToList();
        AppointmentActvities = activities.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment).ToList();
        NoOfEnrollees = activities.Sum(a => a.OngoingStudents);
        NoOfCompleted = activities.Sum(a => a.CompletedStudents);

        //Get Badges Percentage AND Date Obtained
        if (profile.IsVerified == 2)
        {
            cnt++;
        }
        if (NoOfCompleted >= 10)
        {
            cnt++;
            if (NoOfCompleted >= 25)
            {
                cnt++;
                if (NoOfCompleted >= 100)
                {
                    cnt++;
                }
            }
        }
    }

    private void NavigateToUserVerification()
    {
        NavigationManager.NavigateTo("customer/user-verification/?redirect=redirect_dashboard");
    }

    private void NavigateToOTECreation()
    {
        NavigationManager.NavigateTo("/experiences/ote");
    }

    private void NavigateToCreation()
    {
        NavigationManager.NavigateTo("/creation/" + Enums.ExperienceCreationType.GeneralExperience);
    }

    private void NavigateToAppointment()
    {
        NavigationManager.NavigateTo("/creation/" + Enums.ExperienceCreationType.ExperienceViaAppointment);
    }

    private void NavigateToGrossSale()
    {
        NavigationManager.NavigateTo("/maker/dashboard/grosssale");
    }

    private void ToggleAnswer(int questionNumber)
    {
        if (selectedQuestion == questionNumber)
        {
            selectedQuestion = 0; // Hide the answer if the same question is clicked again
        }
        else
        {
            selectedQuestion = questionNumber;
        }
    }

    private void NavigateToHelp()
    {
        NavigationManager.NavigateTo("/maker/dashboard/help");
    }

    public double GetPercentage()
    {
        return Math.Round(cnt / 4 * 100);
    }

}
@layout DashboardLayout
@page "/maker/dashboard"
@using System.Security.Claims
@using Cinnamon.Web.Components.Pages.Maker.Dashboard
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Framework.Enums
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;
@attribute [Authorize]

<PageTitle>Dashboard | CinnamonPH</PageTitle>
<SeoMeta Title="Dashboard" Subject="Dashboard" Url="/maker/dashboard" />

@if (Model != null)
{
    @if(IsNotVerified)
    {
        <div class="announcement">
            <img src="images/user-verification/warning.png" class="me-4" alt="icon">
            <p class="mb-0 me-3 w-100">
                <span>Account Verification!</span> <br>
                Your account is not yet verified. Please check your account for the complete process of setting it up.
            </p>
            <Button class="btn-primary width-150 m-margin-top-10" 
                Border="Border.Is0" Clicked="NavigateToUserVerification">
                Get Started
            </Button>
        </div>
    }
    else 
    {
        <div class="announcement">
            <img src="images/bulb.svg" class="me-4" alt="icon">
            <p class="m-0">
                <span>Announcement! </span>
                We would like to remind you to check the attendance of your students on the ATTENDANCE tab. 
                This will help you keep track of your students progress and ensure that everyone is attending classes regularly. 
            </p>
        </div>
    }
    //Earnings, Tickets and Schedule
    <div class="dashboard-header">
        <div class="dashboard-wrapper">
            <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                 <div class="experience-content">
                     <div class="col-12 d-flex">
                        <div class="col-8 d-block justify-content-start">
                            <p class="title">Total Earnings</p>
                            <p class="amount">1,200</p>
                         </div>
                        <div class="col-4 d-flex justify-content-end">
                            <img class="earning-icon" src="images/Dashboard/earnings-icon.png" />
                        </div>
                     </div>
                    <div class="col-12 d-flex">
                        <div class="col-8 d-flex justify-content-start">
                            <p class="description">Total earnings from all activities</p>
                        </div>
                        <div class="col-4 d-flex justify-content-end">
                            <a class="earnings-link" href="">View earnings</a>
                        </div>
                    </div>
                 </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box"> 
                <div class="experience-content">
                    <div class="col-12 d-flex">
                        <div class="col-8 d-block justify-content-start">
                            <p class="title">Event Ticket Sold</p>
                            <p class="amount">10</p>
                        </div>
                        <div class="col-4 d-flex justify-content-end">
                            <img class="earning-icon" src="images/Dashboard/event-icon.png" />
                        </div>
                    </div>
                    <div class="col-12 d-flex">
                        <div class="col-8 d-flex justify-content-start">
                            <p class="description">Manage your event</p>
                        </div>
                        <div class="col-4 d-flex justify-content-end">
                            <a class="earnings-link" href="">Go to Events</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 col-sm-12 col-12 experience-box">
                <div class="experience-content">
                    <div class="col-12 d-flex">
                        <div class="col-10 d-block justify-content-start">
                            <p class="title">Schedule</p>
                            <p class="schedule-description">The Juans Live at Cebu is today, verify tickets admissions now!</p>
                        </div>
                        <div class="col-2 d-flex justify-content-end">
                            <img class="earning-icon" src="images/Dashboard/schedule-icon.png" />
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <a class="earnings-link" href="">Verify event goers</a>
                    </div>
                </div>
            </div> 
        </div>
    </div>

    <div class="col-12 justify-content-center user-information">
        <div class="dashboard-wrapper">
            @*Types of Activity Tab*@
            <div class="col-lg-7 col-md-12 col-sm-12 col-12 dashboard-tab">
                <section class="mt-5 customer-profile-details">
                        <Div Overflow="Overflow.Hidden" class="ongoing-experiences-container personal-tab-swiper" Display="Display.None.OnDesktop.Block.OnMobile">
                            <div class="swiper-wrapper">
                                <div class='swiper-slide @(selectedTab == "general-activities" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "general-activities" ? "active" : "")'
                                     @onclick='() => selectedTab = "general-activities"'>
                                        general activities
                                    </div>
                                </div>
                                <div class='swiper-slide @(selectedTab == "one-time-events" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "one-time-events" ? "active" : "")'
                                     @onclick='() => selectedTab = "one-time-events"'>
                                        one time events
                                    </div>
                                </div>
                                <div class='swiper-slide @(selectedTab == "activity-via-appointment" ? "swiper-slide-active" : "")'>
                                    <div class='tab-item @(selectedTab == "activity-via-appointment" ? "active" : "")'
                                     @onclick='() => selectedTab = "activity-via-appointment"'>
                                        activity via appointment
                                    </div>
                                </div>
                            </div>
                        </Div>
                        <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                            <Items>
                                <Tab Name="general-activities" TextTransform="TextTransform.Capitalize">General Activities</Tab>
                                <Tab Name="one-time-events" TextTransform="TextTransform.Capitalize">One Time Events</Tab>
                                <Tab Name="activity-via-appointment" TextTransform="TextTransform.Capitalize">Activity via appointment</Tab>
                            </Items>
                            <Content>
                                <TabPanel Name="general-activities">
                                    <div class="header">
                                        @*<p class="title">Activities</p>*@
                                        <button class="create-button" @onclick="NavigateToCreation">Create New Activity</button>
                                    </div>
                                    @foreach (var item in activities)
                                    {
                                        if (item.IsPublished == true && item.Status == Enums.ActivityStatus.Submitted)
                                        {
                                            <div class="experience-container" style="box-shadow: 0px 4px 10px 0px #60996D;">
                                                <div class="xp-content">
                                                    <img class="xp-image" src="@(item.Images.Count > 0 ? item.Images.ElementAt(0).ImageSrc : string.Empty)">
                                                    <div class="xp-context">
                                                        <p class="xp-title">@item.Title</p>
                                                        <p class="xp-description">@item.Description</p>
                                                        <div class="xp-category">
                                                            @if (item.ExperienceTypeId == 1)
                                                            {
                                                                <img src="images/activity-summary/location.png">
                                                                <span>Face to Face</span>
                                                            }
                                                            else
                                                            {
                                                                <img src="images/activity-summary/laptop-icon.png">
                                                                <span>Online</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="xp-actions">
                                                    <div class="active">
                                                        <button class="check-button" type="button" @onclick="() => CheckUnCheckAllStudent(item)">
                                                            <img class="me-1" src='@(item.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                                                        </button>
                                                        <span>@(item.IsPublished ? "Active" : "Inactive")</span>
                                                    </div>
                                                    <div class="button-section">
                                                        <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                                                        @if (item.Status == Framework.Enums.Enums.ActivityStatus.InProgress)
                                                        {
                                                            <button class="delete-button" @onclick="() => DeleteActivity(item.ActivityId)">Delete</button>
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                        else if (item.IsPublished == false && item.Status == Enums.ActivityStatus.Submitted)
                                        {
                                            <div class="experience-container" style="box-shadow: 0px 4px 10px 0px #717171;">
                                                <div class="xp-content">
                                                    <img class="xp-image" src="@(item.Images.Count > 0 ? item.Images.ElementAt(0).ImageSrc : string.Empty)">
                                                    <div class="xp-context">
                                                        <p class="xp-title">@item.Title</p>
                                                        <p class="xp-description">@item.Description</p>
                                                        <div class="xp-category">
                                                            @if (item.ExperienceTypeId == 1)
                                                            {
                                                                <img src="images/activity-summary/location.png">
                                                                <span>Face to Face</span>
                                                            }
                                                            else
                                                            {
                                                                <img src="images/activity-summary/laptop-icon.png">
                                                                <span>Online</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="xp-actions">
                                                    <div class="active">
                                                        <button class="check-button" type="button" @onclick="() => CheckUnCheckAllStudent(item)">
                                                            <img class="me-1" src='@(item.IsPublished ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
                                                        </button>
                                                        <span>@(item.IsPublished ? "Active" : "Inactive")</span>
                                                    </div>
                                                    <div class="button-section">
                                                        <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                                                        @if (item.Status == Enums.ActivityStatus.InProgress)
                                                        {
                                                            <button class="delete-button" @onclick="() => DeleteActivity(item.ActivityId)">Delete</button>
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="experience-container" style="box-shadow: 0px 4px 10px 0px #B4A163;">
                                                <div class="xp-content">
                                                    <img class="xp-image" src="@(item.Images.Count > 0 ? item.Images.ElementAt(0).ImageSrc : string.Empty)">
                                                    <div class="xp-context">
                                                        <p class="xp-title">@item.Title</p>
                                                        <p class="xp-description">@item.Description</p>
                                                        <div class="xp-category">
                                                            @if (item.ExperienceTypeId == 1)
                                                            {
                                                                <img src="images/activity-summary/location.png">
                                                                <span>Face to Face</span>
                                                            }
                                                            else
                                                            {
                                                                <img src="images/activity-summary/laptop-icon.png">
                                                                <span>Online</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <hr>
                                                <div class="xp-actions">
                                                    <div class="active">
                                                        <img class="img-inprogress" src="images/Dashboard/Inprogress.png" alt="check-icon">
                                                        <span> In progress</span>
                                                    </div>
                                                    <div class="button-section">
                                                        <a button class="update-button" href="maker/update-activity?activityId=@item.ActivityId">Update</a>
                                                        @if (item.Status == Enums.ActivityStatus.InProgress)
                                                        {
                                                            <button class="delete-button" @onclick="() => DeleteActivity(item.ActivityId)">Delete</button>
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                    }
                                </TabPanel>
                                <TabPanel Name="one-time-events">
                                </TabPanel>
                                <TabPanel Name="activity-via-appointment">
                                </TabPanel>
                            </Content>
                        </Tabs>
                    </section>
            </div>
            @*Profile and Faqs*@
            <div class="col-lg-5 col-md-12 col-sm-12 col-12 dashboard-profile">
                <div class="col-12 profile-wrapper d-flex">
                    <div class="col-lg-2 col-md-2 col-sm-3 col-3 profile-pic">
                        <img class="rounded-2 rounded-circle m-3" src="@profile.ProfilePath" width="60" height="60" />
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-5 col-5 d-block">
                        <p class="user-name">@profile.FirstName @profile.LastName</p>
                        <a class="view-profile" href="/maker/profile/@(profile != null && !string.IsNullOrEmpty(profile.Handler) ? profile.Handler : activity.CreatedBy.ToString() )">View Profile</a>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-4 col-4 profile-badges">
                        <div class="d-flex">
                            <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Class="badges">
                                <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                            </Tooltip>
                            <p class="verified-text">Verified</p>
                        </div>
                    </div>
                </div>

                <div class="faqs-wrapper">
                    <p class="faqs-title">Faqs</p>
                    <p><a href="" class="link-questions">What’s gonna happen when someone enrolls?</a></p>
                    <p><a href="" class="link-questions">How will I get paid from my activity?</a></p>
                    <p><a href="" class="link-questions">What’s gonna happen when someone enrolls?</a></p>
                    <p><a href="" class="link-questions">How will I get paid from my activity?</a></p>
                    <p><a href="" class="link-questions">What’s gonna happen when someone enrolls?</a></p>
                    <p><a href="" class="link-questions">How will I get paid from my activity?</a></p>
                </div>
            </div>
        </div>
    </div> 
}

@code
{
    private DashboardModel Model { get; set; } = new();

    public List<Activity> activities = new List<Activity>();

    public Activity activity = new Activity();

    public CustomerProfile profile = new CustomerProfile();

    string token = string.Empty;

    private bool IsNotVerified {get; set;}

    private string selectedTab = "general-activities";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
            {
                // an error occured
                NavigationManager.NavigateTo("explore");
                return;
            }
            var customer = result.Result.Result;

            profile.FirstName = customer.FirstName;
            profile.LastName = customer.LastName;
            profile.Handler = customer.Handler;
            profile.ProfilePath = customer.ProfileImg;

            // check if customer is maker
            if (!customer.IsMaker)
            {
                // account is not maker redirect to explore page
                NavigationManager.NavigateTo("explore");
                return;
            }
            IsNotVerified = customer.IsVerified == 0;

            await GetOwnedActivities(token);

            Model = new DashboardModel
                {
                    Activities = activities,
                    ActiveActivityCount = activities.Where(a => a.IsPublished == true).Count(),
                    Token = token
                };
        }
        catch (Exception e)
        {
            throw e;
        }
    }

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    private void NavigateToCreation()
    {
        NavigationManager.NavigateTo("/maker/activity-selection");
    }

    private void CheckUnCheckAllStudent(Activity activity)
    {
        activity.IsPublished = !activity.IsPublished;
        var res = activityApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateActivityArgs
            {
                IsPublished = activity.IsPublished,
                ActivityId = activity.ActivityId,
                Status = Enums.ActivityStatus.Submitted
            }, Model.Token);
    }

    private async Task DeleteActivity(int activityId)
    {
        var res = await activityApiHandler.DeleteActivityById(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteActivityArgs
            {
                ActivityId = activityId
            }, Model.Token);

        if (res.Result.IsSuccess)
        {
            await GetOwnedActivities(token);
        }
    }

    private async Task GetOwnedActivities(string token)
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
            {
                IncludeActivityImages = true,
            }, token);

        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title,
                        Description = a.Description,
                        ExperienceTypeId = a.ExperienceTypeId,
                        Images = a.Images.Select(i =>
                        {
                                return new ActivityImage
                                {
                                    Id = i.Id,
                                    ImageSrc = i.ImageSrc,
                                    Name = i.Name
                                };
                            }).ToList(),
                        Status = a.Status
                    };
            }).ToList();
        }
    }

    private void NavigateToUserVerification()
    {
        NavigationManager.NavigateTo("customer/user-verification/?redirect=redirect_dashboard");
    }
}
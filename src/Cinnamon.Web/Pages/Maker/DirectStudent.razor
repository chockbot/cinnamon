@layout DashboardLayout
@page "/maker/dashboard/enrollee-masterlist/direct-student"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Models.Maker
@using System.Globalization
@using Cinnamon.Web.Components.Pages
@using Cinnamon.Web.Components
@using Cinnamon.Framework.Enums
@using System.ComponentModel.DataAnnotations;
@inject IJSRuntime JS;
@inject INotificationService NotificationService;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler

<div class="direct-students-wrapper">
    <div class="header">
        <div class="title-section">
            <button class="back-button" @onclick="@(() => NavigateToEnrolleeMasterlist())"><img src="images/Dashboard/back-icon.png"></button>
            <p class="back-text m-font-20">Add Direct Students</p>
        </div>
    </div>

    <p class="text-description">You can add students to your class who haven't enrolled on the platform yet, but have a record with you or students who are not enrolled on the platform and will be directly added by you (Activity Provider) for using the platform.</p>
    
    <div class="direct-students-container mt-4">
        @foreach (var student in students)
        {
            var isLastItem = student.Equals(students.Last());
            <Validations @ref="studentListFormValidation" Model="students" Mode="ValidationMode.Manual">
                <div class="accordion-item">
                    <div class="accordion-header" id="heading-@student.Id">
                        <button class="accordion-button @(isLastItem ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@student.Id" aria-expanded="@isLastItem.ToString().ToLower()" aria-controls="collapse-@student.Id">
                            @if (string.IsNullOrEmpty(student.Name))
                            {
                                string info = $"Student Information-" + student.Id;
                                @info
                            }
                            else
                            {
                                @student.Name
                            }
                        </button>
                    </div>
                    <div id="collapse-@student.Id" class="accordion-collapse collapse @(isLastItem ? "show" : "")" aria-labelledby="heading-@student.Id">
                        <div class="accordion-body">
                            <div class="col-12 d-flex justify-content-end">
                                <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" @onclick="() => DeleteClick(student)">
                                    <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                                </Button>
                            </div>
                            <div class="information-section">
                                <Validation>
                                    <div class="student-info">
                                        <p class="student-info-title m-font-18">Student Information</p>
                                        <p class="student-name m-font-14">Name</p>
                                        <TextEdit @bind-Text="student.Name" Placeholder="Ex: Juan Dela Cruz Jr." class="text-box m-font-12">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </TextEdit>
                                    </div>
                                </Validation>
                                <Row class="mt-3 flex-wrap" HorizontalGutter="10" VerticalGutter="10">
                                    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                                        <Validation Validator="ValidationRule.IsNotEmpty">
                                            <div class="student-gender">
                                                <p class="student-name m-font-14">Gender</p>
                                                <Select TValue="string" @bind-SelectedValue="student.Gender" Size="Size.Default" 
                                                    class="form-select border-10 text-capitalize color-black-100 font-15 m-font-12">
                                                    <ChildContent>
                                                        @foreach (var item in genders)
                                                        {
                                                            <SelectItem Value="@item">@item</SelectItem>
                                                        }
                                                    </ChildContent>
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </Select>
                                            </div>
                                        </Validation>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                                        <Validation Validator="ValidationRule.IsNotEmpty">
                                            <div class="student-birth-month">
                                                <p class="student-name m-font-14">Birth Month</p>
                                                <Select TValue="string" @bind-SelectedValue="student.BirthMonth" Size="Size.Default" 
                                                    class="form-select border-10 text-capitalize color-black-100 font-15 m-font-12">
                                                    <ChildContent>
                                                        @foreach (var item in months)
                                                        {
                                                            <SelectItem Value="@item">@item</SelectItem>
                                                        }
                                                    </ChildContent>
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </Select>
                                            </div>
                                        </Validation>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                                        <Validation Validator="ValidationRule.IsSelected">
                                            <div class="student-birth-year">
                                                <p class="student-name m-font-14">Year</p>
                                                <Select TValue="int" @bind-SelectedValue="student.BirthYear" Size="Size.Default" 
                                                    class="form-select border-10 text-capitalize color-black-100 font-15 m-font-12">
                                                    <ChildContent>
                                                        @foreach (var item in years)
                                                        {
                                                            <SelectItem Value="@item">@item</SelectItem>
                                                        }
                                                    </ChildContent>
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </Select>
                                            </div>
                                        </Validation>
                                    </Column>
                                </Row>
                            </div>
                            <div class="activity-section mt-4">
                                <p class="student-info-title m-font-18">Activity Information</p>
                                <div class="mt-3 class-section">
                                    <p class="student-name m-font-14">Class</p>
                                    <Select TValue="int" @bind-SelectedValue="student.ActivityId" Size="Size.Default" 
                                        class="form-select border-10 text-capitalize color-black-100 font-15 m-font-12" @onchange="OnFilterValueChanged">
                                        <SelectItem>Select Experience</SelectItem>
                                        @foreach (var item in activities)
                                        {
                                            <SelectItem Value="item.ActivityId">@item.Title</SelectItem>
                                        }
                                    </Select>
                                </div>
                                <Validation Validator="ValidationRule.IsSelected">
                                    <div class="mt-3 schedule-section">
                                        <p class="student-name m-font-14">Class/Schedule</p>
                                        <Select TValue="int" @bind-SelectedValue="student.ScheduleId" Size="Size.Default" 
                                            class="form-select border-10 text-capitalize color-black-100 font-15 m-font-12">
                                            <ChildContent>
                                                <SelectItem>Select Schedule</SelectItem>
                                                @foreach (var item in schedules)
                                                {
                                                    <SelectItem Value="@item.Id">@item.Name</SelectItem>
                                                }
                                            </ChildContent>
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </Select>
                                    </div>
                                </Validation>
                                <Validation>
                                    <div class="mt-3 mb-5 payment-section">
                                        <p class="student-name m-font-14">Payment</p>
                                        <NumericPicker @bind-Value="student.Payment" Placeholder="0" Decimals="0" ShowStepButtons="false" TValue="decimal?" Size="Size.Medium" 
                                            class="font-18 border-radius-10 m-font-12 m-border-radius-5 payment-input">
                                            <Feedback>
                                                <ValidationError />
                                            </Feedback>
                                        </NumericPicker>
                                    </div>
                                </Validation>
                            </div>
                        </div>
                    </div>
                </div>
            </Validations>
        }

        <div class="btn-action mt-4">
            <button class="btn-add" @onclick="AddMoreStudent">Add More</button>
            <button class="btn-save" @onclick="SaveStudents">Save</button>
        </div>
    </div>
</div>

<ConfirmDialog @ref="confirmDialogRef" AcceptLabel="Done" DeclineLabel="Cancel"
               OnConfirmationChanged="ConfirmSaveChanges">
    <HeaderContent>
        <p class="m-0">Confirm Adding Students</p>
    </HeaderContent>
    <BodyContent>
        <p class="m-0">Are you sure you want to add these students?(@students.Count())</p>
    </BodyContent>
</ConfirmDialog>

<ConfirmDialog @ref="confirmDeleteDialogRef" AcceptLabel="Yes" DeclineLabel="No"
               OnConfirmationChanged="ConfirmDeleteChanged">
    <HeaderContent>
        <p class="m-0">Confirm Action</p>
    </HeaderContent>
    <BodyContent>
        <p class="m-0">Are you sure you want to remove this student?</p>
    </BodyContent>
</ConfirmDialog>

@code 
{
    private string token = string.Empty;
    private int userID { get; set; }
    private IList<string> genders = new List<string>();
    private IList<int> years = new List<int>();
    private IList<string> months = new List<string>();
    private IList<Activity> activities = new List<Activity>();
    private IList<ActivitySchedule> scheduleList = new List<ActivitySchedule>();
    private IList<ActivitySchedule> schedules = new List<ActivitySchedule>();
    private Student studentToDelete = new();
    private Student student = new Student();
    private IList<Student> students = new List<Student>();
    private Validations? studentListFormValidation;
    private bool showErrors = false;
    private ConfirmDialog confirmDialogRef { get; set; }
    private ConfirmDialog confirmDeleteDialogRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // gender
            genders.Add("male");
            genders.Add("female");
            // minimum years
            var minYear = DateTime.Now.Year - 4;
            for (int i = 1900; i <= minYear; i++)
            {
                years.Add(i);
            }
            // months
            months.Add("january");
            months.Add("february");
            months.Add("march");
            months.Add("april");
            months.Add("may");
            months.Add("june");
            months.Add("july");
            months.Add("august");
            months.Add("september");
            months.Add("october");
            months.Add("november");
            months.Add("december");

            // Initialize with one default student
            students.Add(new Student { Id = students.Count + 1 });

            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
            {
                // an error occurred
                NavigationManager.NavigateTo("explore");
                return;
            }
            //Get User Id 
            userID = result.Result.Result.Id;
            // Get Activities
            await GetActivities();
        }
        catch (Exception ex)
        {
            ex.Message.ToString();
        }
    }
    private async Task GetActivities()
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
            {
                IncludeAtivitySchedules = true,
                IsActive = true
            }, token);
        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience).OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title
                    };
            }).ToList();
        }
        foreach (var activityResult in activityRes.Result.Result)
        {
            foreach (var activitySchedule in activityResult.ActivitySchedules)
            {
                scheduleList.Add(new ActivitySchedule
                    {
                        Id = activitySchedule.Id,
                        IsActiveSchedule = activitySchedule.IsActiveSchedule,
                        ActivityId = activityResult.ActivityId,
                        Name = activitySchedule.Name,
                        DateTime = activitySchedule.DateTime,
                        UnitPrice = activitySchedule.UnitPrice,
                        PerUnit1 = activitySchedule.PerUnit1,
                        PerUnit2 = activitySchedule.PerUnit2,
                        PriceUnit1 = activitySchedule.PriceUnit1,
                        PriceUnit2 = activitySchedule.PriceUnit2,
                        Price = activitySchedule.Price,
                        IsSetSession = activitySchedule.IsSetSession,
                        SessionName = activitySchedule.SessionName,
                        HasExpiration = activitySchedule.HasExpiration,
                        StartDate = activitySchedule.StartDate
                    });
            }
        }
    }

    private void OnFilterValueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            if (selectedValue != 0)
            {
                schedules = scheduleList.Where(a => a.ActivityId == selectedValue).ToList();
            }
            else
            {
                schedules = scheduleList; 
            }
        }
    }

    private void NavigateToEnrolleeMasterlist()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents/enrollee-masterlist");
    }

    private async Task AddMoreStudent()
    {
        if(studentListFormValidation is not null)
        {
            bool studentValid = await studentListFormValidation.ValidateAll();
            if (studentValid)
            {
                students.Add(new Student { Id = students.Count + 1 });
            }
        }

    }

    private async void SaveStudents()
    {
        bool isValid = await FieldValid();
        if (isValid)
        {
            await confirmDialogRef.Open();
        }
        else
        {
            await NotificationService.Error("Please fill out all the information to proceed.");
        }
    }

    private async Task ConfirmSaveChanges(bool value)
    {
        if (value)
        {
            var result = await dashboardApiHandler.CreateDirectStudents(new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs
            {
                CreateDirectStudents = students.Select(s =>
                {
                    var schedule = scheduleList.Where(a => a.Id == s.ScheduleId).FirstOrDefault();
                    return new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudent
                    {
                        CreateDirectStudentInfo = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentInfo
                        {
                            BirthMonth = s.BirthMonth,
                            BirthYear = s.BirthYear,
                            Gender = s.Gender,
                            Name = s.Name,
                            ProviderId = userID
                        },
                        CreateDirectStudentSession = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentSession
                        {
                            ActivityId = schedule.ActivityId,
                            Name = s.Name,
                            NumberOfSessions = schedule.PerUnit2,
                            SessionsAttended = 0,
                            Remarks = string.Empty,
                            StudentNo = "0",
                            ScheduleId = schedule.Id,
                            Status = "ACTIVE"
                        },
                        CreateDirectStudentPayment = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentPayment
                        {
                            Amount = s.Payment ?? 0
                        }
                    };
                })
            }, token);

            if (!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new ApplicationException(result.Message);
            }
            else
            {
                await NotificationService.Success("Success! You created new student", "Success");
                NavigationManager.NavigateTo("maker/dashboard/managestudents/enrollee-masterlist");
            }
        }
    }

    private ValidationMode FormMode
    {
        get
        {
            return showErrors ? ValidationMode.Auto : ValidationMode.Manual;
        }
    }
    private async Task DeleteClick(Student item)
    {
        studentToDelete = item;
        await confirmDeleteDialogRef.Open();
    }
    private async Task ConfirmDeleteChanged(bool value)
    {
        if (value)
        {
            if (students.Count == 1)
            {
                students.Remove(studentToDelete);
                students.Add(new Student { Id = students.Count + 1, ActivityId = 0 });
                await NotificationService.Success("You successfully deleted student!", "Success");
            }
            else
            {
                students.Remove(studentToDelete);
                await NotificationService.Success("You successfully deleted student!", "Success");
            }
            
        }
    }
    public async Task<bool> FieldValid()
    {
        if (studentListFormValidation is not null)
        {
            bool ticketListValid = await studentListFormValidation.ValidateAll();
            bool valid = ticketListValid;

            showErrors = true;
            StateHasChanged();
            await Task.Delay(300); // add delay to populate is-invalid class

            if (!valid)
            {
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".direct-students-wrapper .is-invalid");
            }

            return valid;
        }
        return false;
    }

    public class Student
    {

        public int Id { get; set; }

        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Gender is required")]
        public string Gender { get; set; } = "Male";

        [Required(ErrorMessage = "Birth Month is required")]
        public string BirthMonth { get; set; } = "January";

        [Range(1900, 2100, ErrorMessage = "Year must be between 1900 and 2100")]
        public int BirthYear { get; set; } = DateTime.UtcNow.Year;

        [Required(ErrorMessage = "Class is required")]
        public int ActivityId { get; set; }

        [Required(ErrorMessage = "Schedule is required")]
        public int ScheduleId { get; set; }

        [Required(ErrorMessage = "The payment field is required.")]
        [Range(1, int.MaxValue, ErrorMessage = "The payment field is required.")]
        public decimal? Payment { get; set; } = null;

        public bool Valid
        {
            get
            {
                return !string.IsNullOrEmpty(Name) &&
                       !string.IsNullOrEmpty(Gender) &&
                       !string.IsNullOrEmpty(BirthMonth) &&
                       ActivityId != 0 &&
                       ScheduleId != 0 &&
                       Payment != 0;
            }
        }

    }
}

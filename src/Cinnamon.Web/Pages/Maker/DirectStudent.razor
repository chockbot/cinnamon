@layout DashboardLayout
@page "/maker/dashboard/enrollee-masterlist/direct-student"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components
@using Cinnamon.Framework.Enums
@using Cinnamon.Framework.Helpers;
@using System.ComponentModel.DataAnnotations;
@inject IJSRuntime JS;
@inject INotificationService NotificationService;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject IDirectStudentApiHandler directStudentApiHandler;

<Container class="direct-students-wrapper pb-4">
    <div class="header mb-3">
        <div class="title-section align-items-center">
            <button class="back-button m-0 p-0" @onclick="GoToPrev">
                <img src="images/Dashboard/back-icon.png">
            </button>
            <p class="back-text font-20 m-font-18 font-weight-900 mb-0">Add Direct Students</p>
        </div>
    </div>

    <p class="text-description font-16 m-font-12 mb-4 mb-md-5">
        You can add students to your class who haven't enrolled on the platform yet, 
        but have a record with you or students who are not enrolled on the platform 
        and will be directly added by you (Activity Provider) for using the platform.
    </p>
    
    <Row>
        <Column class="student-info-grp" ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
            <Validations @ref="studentFormValidation" Model="selectedStudent" Mode="formValidationMode">
                <div class="color-black-100">
                    <div class="d-flex justify-content-between align-items-baseline">
                        <p class="font-20 m-font-18 font-weight-900 text-capitalize mb-3 mb-md-4">student information</p>
                        <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3 abs-delete" 
                            Clicked="() => confirmDeleteDialogRef.Open()">
                            <Icon Name="IconName.Delete" IconStyle="IconStyle.Solid" />
                        </Button>
                    </div>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Name</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <div class="input-group">
                                            <TextEdit @bind-Text="selectedStudent.Name" class="color-black-100 font-16 m-font-12" Size="Size.Small" 
                                                Placeholder="Juan Dela Cruz Jr." />
                                            <Button Clicked="() => modalStudentSearch.Show()" 
                                                class="bg-green-100 color-white-100 text-capitalize font-16 m-font-12">
                                                view student list
                                            </Button>
                                        </div>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Parent Email</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <TextEdit type="email" @bind-Text="selectedStudent.Email" class="color-black-100 font-16 m-font-12" Size="Size.Small" 
                                            Placeholder="Optional email" />
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <Row class="mb-4 mb-md-5" VerticalGutter="20">
                        <Column class="pe-auto pe-md-0" ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Gender</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <Select @bind-SelectedValue="selectedStudent.Gender" 
                                            class="form-select color-black-100 text-capitalize font-16 m-font-12" Size="Size.Small" TValue="string">
                                            <SelectItem Value='"male"'>male</SelectItem>
                                            <SelectItem Value='"female"'>female</SelectItem>
                                        </Select>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                        <Column class="pe-auto pe-md-0" ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Birth Month</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <Select @bind-SelectedValue="selectedStudent.BirthMonth" 
                                            class="form-select text-capitalize color-black-100 font-16 m-font-12" Size="Size.Small" TValue="string">
                                            <SelectItem Value='"january"'>january</SelectItem>
                                            <SelectItem Value='"february"'>february</SelectItem>
                                            <SelectItem Value='"march"'>march</SelectItem>
                                            <SelectItem Value='"april"'>april</SelectItem>
                                            <SelectItem Value='"may"'>may</SelectItem>
                                            <SelectItem Value='"june"'>june</SelectItem>
                                            <SelectItem Value='"july"'>july</SelectItem>
                                            <SelectItem Value='"august"'>august</SelectItem>
                                            <SelectItem Value='"september"'>september</SelectItem>
                                            <SelectItem Value='"october"'>october</SelectItem>
                                            <SelectItem Value='"november"'>november</SelectItem>
                                            <SelectItem Value='"december"'>december</SelectItem>
                                        </Select>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Year</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <Select @bind-SelectedValue="selectedStudent.BirthYear" 
                                            class="form-select text-capitalize color-black-100 font-16 m-font-12" Size="Size.Small" TValue="int">
                                            @foreach (var year in years)
                                            {
                                                <SelectItem Value="year">@year</SelectItem>    
                                            }
                                        </Select>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <p class="font-20 m-font-18 font-weight-900 text-capitalize mb-3 mb-md-4">activity information</p>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <Select @bind-SelectedValue="selectedStudent.ActivityId" 
                                            class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int"
                                            @onchange="OnFilterValueChanged" >
                                            <ChildContent>
                                                <SelectItem Value='0' selected Disabled>select experience</SelectItem>
                                                @foreach (var item in activities)
                                                {
                                                    <SelectItem Value="item.ActivityId">@item.Title</SelectItem>
                                                }
                                            </ChildContent>
                                        </Select>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class/Schedule</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <Select @bind-SelectedValue="selectedStudent.ScheduleId" @onchange="SelectedScheduleChanged" 
                                            class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int">
                                            <ChildContent>
                                                <SelectItem Value='0' selected Disabled>select schedule</SelectItem>
                                                @foreach (var item in schedules)
                                                {
                                                    <SelectItem Value="@item.Id">@item.Name</SelectItem>
                                                }
                                            </ChildContent>
                                        </Select>
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Payment</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <NumericPicker @bind-Value="selectedStudent.Payment" TValue="decimal?" ShowStepButtons="false" Decimals="0" 
                                            Placeholder="Amount" Size="Size.Small" class="color-black-100 font-16 m-font-12" Min="1" />
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <Row class="mb-3">
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Payment Date</FieldLabel>
                                <FieldBody>
                                    <Validation>
                                        <DateEdit @bind-Date="selectedStudent.PaymentDate" TValue="DateTime?" 
                                            Size="Size.Small" class="color-black-100 font-16 m-font-12"  />
                                    </Validation>
                                </FieldBody>
                            </Field>
                        </Column>
                    </Row>

                    <div class="btn-action mt-4">
                        <Button class="font-16 m-font-12 bg-white-200" Clicked="AddMoreStudent">Add More</Button>
                        <Button class="font-16 m-font-12 bg-orange-100 color-white-100 hover-color-white px-4" 
                            Clicked="SaveStudents">Save</Button>
                    </div>
                </div>
            </Validations>
        </Column>
        <Column class="selected-student-grp" ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
            @if(students.Count > 0)
            {
                <div class="list-grp-added-students-container">
                    <ListGroup @ref="listGrpStudents" class="added-student-list-grp" SelectedItemChanged="SelectedStudentChanged"
                        Mode="ListGroupMode.Selectable" Border="Border.Is0">
                        @foreach (var student in students)
                        {
                            <ListGroupItem class="font-16 m-font-12 text-capitalize" Name="@student.Key.ToString()">@student.Value.Name</ListGroupItem>   
                        }
                    </ListGroup>
                </div>
            }
        </Column>
    </Row>

    <Modal @ref="confirmPeriodModal" class="modal-purchase-confirmation"
        Closing="OnModalClosing">
        <ModalContent Centered>
            <ModalHeader class="py-2 px-4 border-0-solid justify-content-center border-bottom-1-solid border-color-grey-200 position-relative">
                <p class="font-16 m-0 font-weight-700">Select Period Date of Purchase</p>
                <button type="button" style="top: 20px; right: 20px;" class="btn-close position-absolute" @onclick="CancelConfirmationModal" />
            </ModalHeader>
            <ModalBody>
                <fieldset>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is12">
                            <Row>
                                <Column ColumnSize="ColumnSize.Is1">
                                    <input type="radio" @onchange='() => SelectPeriod("currentperiod")'
                                        checked='@(selectedStudent.PeriodConfirmation.SelectedPeriod == "currentperiod")' 
                                        value="currentperiod" name="select-confirmation" class="me-3 checkbox-round" />
                                </Column>
                                <Column ColumnSize="ColumnSize.Is11">
                                    <p class="font-16 color-black-100 mb-1">Purchase for <span class="text-uppercase font-weight-700">current</span> period.</p>
                                    <p class="font-14 color-grey-100">You only have <span class="color-red-100">@selectedStudent.PeriodConfirmation.DurationLeft</span> to use this.</p>
                                </Column>
                            </Row>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12">
                            <Row>
                                <Column ColumnSize="ColumnSize.Is1">
                                    <input type="radio" @onchange='() => SelectPeriod("nextperiod")' 
                                        checked='@(selectedStudent.PeriodConfirmation.SelectedPeriod == "nextperiod")'  
                                        value="nextperiod" name="select-confirmation" class="me-3 checkbox-round" />
                                </Column>
                                <Column ColumnSize="ColumnSize.Is11">
                                    <p class="font-16 color-black-100 mb-1">Purchase for <span class="text-uppercase font-weight-700">next</span> period.</p>
                                    <p class="font-14 color-grey-100">Next period will start on <span class="color-green-100">@selectedStudent.PeriodConfirmation.NextPeriod.AddDays(1).ToString("MMMM dd, yyyy")</span></p>
                                </Column>
                            </Row>
                        </Column>
                    </Row>
                    <Button Loading="selectedStudent.PeriodConfirmation.IsSubmitting" 
                        Disabled="selectedStudent.PeriodConfirmation.IsSubmitting || string.IsNullOrEmpty(selectedStudent.PeriodConfirmation.SelectedPeriod)" 
                        class="btn-primary w-100" Border="Border.Is0" Clicked="ConfirmProceedClick" >
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                        </LoadingTemplate>
                        <ChildContent>
                            Proceed
                        </ChildContent>
                    </Button>
                    @if(selectedStudent.PeriodConfirmation.IsShowError && !selectedStudent.PeriodConfirmation.IsApplied)
                    {
                        <p class="font-12 color-red-100 text-center mb-0 mt-2">Please select your confirmation above.</p>
                    }
                </fieldset>
            </ModalBody>
        </ModalContent>
    </Modal>

    <Modal @ref="modalStudentSearch">
        <ModalContent Centered>
            <ModalHeader class="justify-content-center">
                <p class="font-16 m-font-12 m-0 font-weight-700">Direct Student List</p>
                <button type="button" style="top: 27px; right: 25px;" class="btn-close position-absolute" 
                    @onclick="() => modalStudentSearch.Close(CloseReason.UserClosing)" />
            </ModalHeader>
            <ModalBody class="px-4">
                <p class="font-16 m-font-12 color-grey-400 text-center">Add students that you have already listed before.</p>
                <TextEdit TextChanged="SearchStudent" Placeholder="Search" Size="Size.Small" class="font-16 m-font-12"/>
                <div class="mt-3 search-items-container">
                    <ListGroup class="search-list-grp-container"
                        Mode="ListGroupMode.Selectable" @bind-SelectedItem="searchInfo.SelectedStudentId">
                        @foreach (var item in searchInfo.StudentInfos)
                        {
                            <ListGroupItem class="font-16 m-font-12" Name='@item.Id.ToString()'>@item.Name</ListGroupItem>   
                        }
                    </ListGroup>
                </div>
                <div class="text-end mt-3">
                    <Button class="bg-grey-300 font-16 m-font-12" 
                        Clicked="() => modalStudentSearch.Close(CloseReason.UserClosing)">
                        Cancel
                    </Button>
                    <Button Clicked="SelectSearchedStudent" 
                        class="bg-green-100 color-white-100 font-16 m-font-12">
                        Select
                    </Button>
                </div>
            </ModalBody>
        </ModalContent>
    </Modal>

    <ConfirmDialog @ref="confirmDialogRef" AcceptLabel="Done" DeclineLabel="Cancel"
               OnConfirmationChanged="ConfirmSaveChanges">
        <HeaderContent>
            <p class="m-0">Confirm Adding Students</p>
        </HeaderContent>
        <BodyContent>
            <p class="m-0">Are you sure you want to add these students?(@StudentCount)</p>
        </BodyContent>
    </ConfirmDialog>

    <ConfirmDialog @ref="confirmDeleteDialogRef" AcceptLabel="Yes" DeclineLabel="No"
                OnConfirmationChanged="ConfirmDeleteChanged">
        <HeaderContent>
            <p class="m-0">Confirm Action</p>
        </HeaderContent>
        <BodyContent>
            <p class="m-0">Are you sure you want to remove this student?</p>
        </BodyContent>
    </ConfirmDialog>
</Container>

@code 
{
    private string token = string.Empty;
    private IList<int> years = new List<int>();
    private IList<Activity> activities = new List<Activity>();
    private IList<ActivitySchedule> scheduleList = new List<ActivitySchedule>();
    private IList<ActivitySchedule> schedules = new List<ActivitySchedule>();
    private IDictionary<int, Student> students = new Dictionary<int, Student>();
    private Validations? studentFormValidation;
    private bool showErrors = false;
    private ConfirmDialog confirmDialogRef { get; set; }
    private ConfirmDialog confirmDeleteDialogRef { get; set; }

    private Modal? confirmPeriodModal;
    private Student selectedStudent = new();

    private Modal? modalStudentSearch;
    private SearchInfo searchInfo = new();
    private ValidationMode formValidationMode = ValidationMode.Manual;
    private ListGroup? listGrpStudents;

    protected override void OnInitialized()
    {
        // minimum years
        var maxYear = DateTime.Now.Year - 4;
        var minYear = DateTime.Now.Year - 100;
        for (int i = minYear; i <= maxYear; i++)
        {
            years.Add(i);
        }

        selectedStudent =  CreateDefaultStudent();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }
            
            // Get Activities
            await GetActivities();
        }
        catch (Exception ex)
        {
            ex.Message.ToString();
        }
    }

    private async Task GetActivities()
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
        {
            IncludeAtivitySchedules = true,
            IsActive = true
        }, token);

        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience).OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title
                    };
            }).ToList();
        }

        foreach (var activityResult in activityRes.Result.Result)
        {
            foreach (var activitySchedule in activityResult.ActivitySchedules)
            {
                scheduleList.Add(new ActivitySchedule
                {
                    Id = activitySchedule.Id,
                    IsActiveSchedule = activitySchedule.IsActiveSchedule,
                    ActivityId = activityResult.ActivityId,
                    Name = activitySchedule.Name,
                    DateTime = activitySchedule.DateTime,
                    UnitPrice = activitySchedule.UnitPrice,
                    PerUnit1 = activitySchedule.PerUnit1,
                    PerUnit2 = activitySchedule.PerUnit2,
                    PriceUnit1 = activitySchedule.PriceUnit1,
                    PriceUnit2 = activitySchedule.PriceUnit2,
                    Price = activitySchedule.Price,
                    IsSetSession = activitySchedule.IsSetSession,
                    SessionName = activitySchedule.SessionName,
                    HasExpiration = activitySchedule.HasExpiration,
                    StartDate = activitySchedule.StartDate
                });
            }
        }
    }

    private Task OnFilterValueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            if (selectedValue != 0)
            {
                selectedStudent.ActivityId = selectedValue;
                selectedStudent.ScheduleId = 0;
                schedules = scheduleList.Where(a => a.ActivityId == selectedValue).ToList();
            }
            else
            {
                schedules = scheduleList; 
            }
        }

        return Task.CompletedTask;
    }

    private async Task SelectedScheduleChanged(ChangeEventArgs e)
    {
        if(int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            var selectedSched = schedules.FirstOrDefault(s => s.Id == selectedValue);
            if(selectedSched is null)
            {
                await NotificationService.Error("An error occured. Please try again later.", "Error");
                return;
            }

            selectedStudent.ScheduleId = selectedValue;

            if(selectedSched.HasExpiration == 1)
            {
                if(selectedStudent.ScheduleId != selectedStudent.PrevScheduleId)
                {
                    selectedStudent.PrevScheduleId = selectedValue;
                    await PeriodCalculation(selectedSched.StartDate.Value, selectedSched.SessionName);
                    await confirmPeriodModal.Show();
                }
            }
        }
    }

    private async Task AddMoreStudent()
    {

        if(studentFormValidation is null) return;
        
        bool studentValid = await studentFormValidation.ValidateAll();

        if(!studentValid)
        {
            formValidationMode = ValidationMode.Auto;
            return;
        }

        if(!students.ContainsKey(selectedStudent.Id))
        {
            students.Add(selectedStudent.Id, selectedStudent);
            StateHasChanged();
        }

        selectedStudent = CreateDefaultStudent(selectedStudent.ActivityId, selectedStudent.ScheduleId);

        listGrpStudents?.SelectItem(string.Empty);
        await ResetFormValidation();
    }

    private async Task ResetFormValidation()
    {
        if(studentFormValidation is null) return;

        await studentFormValidation.ClearAll();
        formValidationMode = ValidationMode.Manual;
    }

    private Task PeriodCalculation(DateTime dateStart, string sessionName)
    {
        var datePeriod = DateNextPeriod.CreateRecurring(dateStart, sessionName);
        DateTime periodStart = datePeriod.PeriodStart;
        // to set the last time of the day
        DateTime periodEnd = datePeriod.PeriodEnd.AddDays(1).Date.AddSeconds(-1);

        DateTime nextPeriod = datePeriod.NextPeriod().PeriodStart;
        DateTime now = DateTime.Now;

        int daysLeft = (periodEnd - now).Days;
        int hours = (periodEnd - now).Hours;
        string durationLeft = daysLeft > 0 ? $"{daysLeft} days" : (hours > 0 ? "today" : "0 days");

        selectedStudent.PeriodConfirmation.DaysLeft = Math.Abs((now - periodEnd).Days);
        selectedStudent.PeriodConfirmation.DurationLeft = durationLeft;
        selectedStudent.PeriodConfirmation.NextPeriod = nextPeriod;
        selectedStudent.PeriodConfirmation.IsApplied = false;
        selectedStudent.PeriodConfirmation.IsShowError = false;

        return Task.CompletedTask;
    }

    private async Task SaveStudents()
    {
        bool isValid = await FieldValid();
        if (isValid)
        {
            await confirmDialogRef.Open();
        }
        else 
        {
            await NotificationService.Error("Please fill out all the information to proceed.");
        }
    }

    private async Task AddDirectStudents()
    {
        // add current selected to student in list if not existed
        if(!students.ContainsKey(selectedStudent.Id))
        {
            students.Add(selectedStudent.Id, selectedStudent);
        }

        var result = await dashboardApiHandler.CreateDirectStudents(new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs
        {
            CreateDirectStudents = students.Select(dic =>
            {
                var student = dic.Value;
                return new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudent
                {
                    CreateDirectStudentInfo = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentInfo
                    {
                        BirthMonth = student.BirthMonth,
                        BirthYear = student.BirthYear,
                        Gender = student.Gender,
                        Name = student.Name,
                        Id = student.DBId,
                        Email = student.Email
                    },
                    CreateDirectStudentSession = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentSession
                    {
                        ActivityId = student.ActivityId,
                        Name = student.Name,
                        Remarks = string.Empty,
                        ScheduleId = student.ScheduleId,
                        Status = "ACTIVE",
                        Period = student.PeriodConfirmation.SelectedPeriod
                    },
                    CreateDirectStudentPayment = new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateDirectStudentsArgs.CreateDirectStudentPayment
                    {
                        Amount = student.Payment ?? 0,
                        PaymentDate = student.PaymentDate ?? DateTime.MinValue
                    }
                };
            })
        }, token);

        if (!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again.", "Error");
        }
        else
        {
            await NotificationService.Success("Success! You created new student", "Success");
            NavigationManager.NavigateTo("maker/dashboard/managestudents/enrollee-masterlist");
        }
    }

    private Task ConfirmSaveChanges(bool value)
    {
        if (!value) return Task.CompletedTask;

        return AddDirectStudents();
    }

    private async Task ConfirmDeleteChanged(bool value)
    {
        if (!value) return;

        if(students.ContainsKey(selectedStudent.Id))
        {
            students.Remove(selectedStudent.Id);
        }

        if(students.Count == 0)
        {
            selectedStudent = CreateDefaultStudent();
        }
        else
        {
            selectedStudent = students.Last().Value;
            await listGrpStudents.SelectItem(selectedStudent.Id.ToString());
        }
        
        await NotificationService.Success("You successfully deleted student!", "Success");
    }

    public async Task<bool> FieldValid()
    {
        if (studentFormValidation is not null)
        {
            bool ticketListValid = await studentFormValidation.ValidateAll();
            bool valid = ticketListValid;

            showErrors = true;
            StateHasChanged();
            await Task.Delay(300); // add delay to populate is-invalid class

            if (!valid)
            {
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToView", ".direct-students-wrapper .is-invalid");
                formValidationMode = ValidationMode.Auto;
            }

            return valid;
        }
        return false;
    }

    private async Task GoToPrev()
    {
        await JS.InvokeVoidAsync("MyLib.Utils.navigation.back");
    }

    private Task CancelConfirmationModal()
    {
        // to reset selected schedule and empty selected period to trigger validate again
        selectedStudent.PeriodConfirmation.SelectedPeriod = string.Empty;
        selectedStudent.ScheduleId = 0;
        selectedStudent.PrevScheduleId = -1;

        return confirmPeriodModal.Close(CloseReason.UserClosing);
    }

    private Task SelectPeriod(string period)
    {
        if(period == "currentperiod" || period == "nextperiod")
        {
            selectedStudent.PeriodConfirmation.SelectedPeriod = period;
        }
        return Task.CompletedTask;
    }

    private Task ConfirmProceedClick()
    {
        if(string.IsNullOrEmpty(selectedStudent.PeriodConfirmation.SelectedPeriod))
        {
            selectedStudent.PeriodConfirmation.IsShowError = true;
            return Task.CompletedTask;
        }
        
        return confirmPeriodModal.Close(CloseReason.UserClosing);
    }

    private async Task SearchStudent(string value)
    {
        try
        {
            searchInfo.StudentInfos.Clear();

            var studentsRes = await directStudentApiHandler.DirectStudents(new Framework.ApiCommand.ApiCore.DirectStudent.Request.DirectStudentInfoArgs {
                CountPerPage = 15,
                PageIndex = 1,
                SearchValue = value
            }, token);

            if(studentsRes.Succeeded && studentsRes.Result is not null && studentsRes.Result.IsSuccess)
            {
                searchInfo.StudentInfos.AddRange(studentsRes.Result.Result.Select(s => new Student {
                    Id = s.Id,
                    Name = s.Name,
                    BirthMonth = s.BirthMonth,
                    BirthYear = s.BirthYear,
                    Gender = s.Gender
                }));
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again.", "Error");
        }
    }

    private Task SelectSearchedStudent()
    {
        if(!string.IsNullOrEmpty(searchInfo.SelectedStudentId) && int.TryParse(searchInfo.SelectedStudentId, out int studentId))
        {
            var student = searchInfo.StudentInfos.FirstOrDefault(s => s.Id == studentId);
            if(student is null) return modalStudentSearch.Close(CloseReason.UserClosing);

            selectedStudent.DBId = student.Id;
            selectedStudent.Name = student.Name;
            selectedStudent.BirthMonth = student.BirthMonth;
            selectedStudent.BirthYear = student.BirthYear;
            selectedStudent.Gender = student.Gender;
        }

        return modalStudentSearch.Close(CloseReason.UserClosing);
    }

    private Student CreateDefaultStudent(int activityId = 0, int scheduleId = 0)
    {
        int lastId = 1;

        if(students.Count > 0)
        {
            lastId = students.Last().Value.Id + 1;
        }

        var minYear = DateTime.Now.Year - 4;

        return new Student {
            Id = lastId,
            BirthYear = minYear - 18,
            Gender = "male",
            BirthMonth = "january",
            ActivityId = 0,
            ScheduleId = 0,
        };
    }

    private async Task SelectedStudentChanged(string value)
    {
        if(listGrpStudents is null) return;

        if(int.TryParse(value, out int key) && students.ContainsKey(key))
        {
            selectedStudent = students[key];
            int scheduleId = selectedStudent.ScheduleId;

            await OnFilterValueChanged(new ChangeEventArgs {Value = selectedStudent.ActivityId});
            
            selectedStudent.ScheduleId = scheduleId;
            await SelectedScheduleChanged(new ChangeEventArgs {Value = selectedStudent.ScheduleId});            
        }
    }

    private int StudentCount 
    {
        get 
        {
            int count = students.Count + 1;

            if(students.Count > 0 && students.Last().Value == selectedStudent)
            {
                count--;
            }

            return count;
        }
    }

    private class Student
    {
        public int DBId {get; set;}

        public int Id { get; set; }

        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; }

        [EmailAddress(ErrorMessage = "Provide valid email")]
        public string? Email {get; set;}

        [Required(ErrorMessage = "Gender is required")]
        public string Gender { get; set; } = "Male";

        [Required(ErrorMessage = "Birth Month is required")]
        public string BirthMonth { get; set; } = "January";

        [Range(1900, 2100, ErrorMessage = "Year must be between 1900 and 2100")]
        public int BirthYear { get; set; } = DateTime.UtcNow.Year;

        [Range(1, int.MaxValue, ErrorMessage = "Class is required")]
        public int ActivityId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Schedule is required")]
        public int ScheduleId { get; set; }

        [Required(ErrorMessage = "The payment field is required.")]
        [Range(1, int.MaxValue, ErrorMessage = "The payment field is required.")]
        public decimal? Payment { get; set; } = null;

        [Required(ErrorMessage = "Payment Date field is required")]
        public DateTime? PaymentDate {get; set;}

        public PeriodConfirmation PeriodConfirmation {get; set;} = new();

        public int PrevScheduleId {get; set;} = -1;
    }

    private Task OnModalClosing(ModalClosingEventArgs e)
    {
        e.Cancel = (e.CloseReason == CloseReason.FocusLostClosing || e.CloseReason == CloseReason.EscapeClosing);
        return Task.CompletedTask;
    }

    private class PeriodConfirmation 
    {
        public string Message { get; set; }
        public int DaysLeft { get; set; }
        public string DurationLeft { get; set; }
        public DateTime NextPeriod { get; set; }
        public bool IsApplied { get; set; }
        public bool IsShowError { get; set; }

        public string SelectedPeriod { get; set; }
        public bool IsSubmitting { get; set; }
    }

    private class SearchInfo 
    {
        public string SearchValue {get; set;}
        public List<Student> StudentInfos {get; set;} = new();

        public string SelectedStudentId {get; set;} 
    }
}
@layout EmptyLayout;
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@implements IAsyncDisposable


<div class="container">
    <div class="border-radius-10 p-4 m-3 m-bg-white-100 m-padding-0 mb-3">
        <Row VerticalGutter="20" HorizontalGutter="20">
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                <div class="bg-white-100 border-radius-10 p-3 cursor-pointer email-box" id="hoverDiv" @onclick="NavigateToRemider">
                    <div class="title-section text-box">
                        <p class="email-title">Reminder Email</p>
                    </div>
                    <div class="line-effect div-line mb-2"></div>
                    <div class="line-effect div-line-75 mb-3"></div>
                    @if (string.IsNullOrEmpty(remiderDetails.Body))
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-red me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">No message yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-green me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">Message already set</p>
                        </div>
                    }
                    <div class="update-email d-flex justify-content-end text-box">
                        <button class="update-button-email" @onclick=" NavigateToRemider">Edit Email</button>
                    </div>
                    <div class="effect hover1"></div>
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                <div class="bg-white-100 border-radius-10 p-3 cursor-pointer email-box" id="hoverDiv" @onclick="NavigateToFeedback">
                    <div class="title-section text-box">
                        <p class="email-title">Feedback Email</p>
                    </div>
                    <div class="line-effect div-line mb-2"></div>
                    <div class="line-effect div-line-75 mb-3"></div>
                    @if (string.IsNullOrEmpty(remiderDetails.Body))
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-red me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">No message yet</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center mb-2 text-box">
                            <div class="small-circle-green me-2">
                            </div>
                            <p class="font-16 color-grey-100 mb-0">Message already set</p>
                        </div>
                    }
                    <div class="update-email d-flex justify-content-end text-box">
                        <button class="update-button-email" @onclick=" NavigateToFeedback">Edit Email</button>
                    </div>
                    <div class="effect hover2"></div>
                </div>
            </Column>
        </Row>
    </div>
</div>

@code {
    [Parameter]
    public OteActivity OteActivity { get; set; }

    [Parameter]
    public string Token { get; set; }

    IJSObjectReference hoverEffectModule;

    private ScheduleNotification remiderDetails = new ScheduleNotification();

    private ScheduleNotification feedbackDetails = new ScheduleNotification();
    

    protected override async Task OnInitializedAsync()
    {
        var feedbackTemplateRes = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs
            {
                ActivityId = OteActivity.Id,
                TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteThankYou.ToString()
            }, Token);

        var reminderTemplateRes = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs
            {
                ActivityId = OteActivity.Id,
                TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteReminder.ToString()
            }, Token);
        await Task.WhenAll(feedbackTemplateRes, reminderTemplateRes);
        var feedbackResult = feedbackTemplateRes.Result;
        var reminderResult = reminderTemplateRes.Result;

        feedbackDetails = new ScheduleNotification
            {
                Body = string.Empty,
                Days = OteActivity.EmailFeedbackDays,
                Subject = string.Empty
            };

        remiderDetails = new ScheduleNotification
            {
                Body = string.Empty,
                Days = OteActivity.EmailReminderDays,
                Subject = string.Empty
            };
        if (feedbackResult.Succeeded && feedbackResult.Result is not null && feedbackResult.Result.IsSuccess)
        {
            feedbackDetails.Body = feedbackResult.Result.Result.Body;
            feedbackDetails.Subject = feedbackResult.Result.Result.Subject;
        }

        if (reminderResult.Succeeded && reminderResult.Result is not null && reminderResult.Result.IsSuccess)
        {
            remiderDetails.Body = reminderResult.Result.Result.Body;
            remiderDetails.Subject = reminderResult.Result.Result.Subject;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(2000);
            await jsRuntime.InvokeVoidAsync("MyLib.Utils.hoverEffect.addHoverEffect", "#hoverDiv");
        }
    }

    private void NavigateToRemider()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{2}");
    }
    private void NavigateToFeedback()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{3}");
    }
    public class ScheduleNotification
    {
        public int Days { get; set; } = 1;
        public string Subject { get; set; }
        public string Body { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        if (hoverEffectModule != null)
        {
            await hoverEffectModule.DisposeAsync();
        }
    }
}

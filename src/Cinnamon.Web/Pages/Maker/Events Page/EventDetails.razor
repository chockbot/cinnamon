@layout DashboardLayout
@page "/maker/dashboard/events/{Handler}"
@using AutoMapper;
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Framework.ValidationAttributes
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Framework.Enums
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Web.Components.Pages
@using ClosedXML.Excel;
@using System.IO;
@inject IActivityApiHandler activityApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IMapper mapper;
@inject IJSRuntime jsRuntime
@inject INotificationService NotificationService;
@attribute [Authorize]

<PageTitle>Event Details | CinnamonPH</PageTitle>
<SeoMeta Title="Event Details" Subject="Dashboard" Url='@($"/maker/dashboard/events/{Handler}")' />

@if (activity != null)
{
    <div class="event-details-wrapper">
        <div class="header">
            <div class="col-12 d-flex justify-content-start">
                <button class="back-button" @onclick="@(() => NavigateToMyEvents())"><img src="images/dashboard-back.png"></button>
                <p class="back-text">@activity.EventName</p>
            </div>
        </div>
        <div class="ticket-options">
            <div class="div-option-details">
                <img class="option-img" src="images/ote/registration.png" alt="cover-photo">
                <div class="option-name">
                    <p class="registration">Registration</p>
                    <p class="reg-status">Open</p>
                </div>
            </div>
            <div class="div-option-details" @onclick="@(() => GenerateLinkShowModal())">
                <img class="option-img" src="images/ote/capacity.png" alt="cover-photo">
                <div class="option-name">
                    <p class="registration">Share QR Scanner Link</p>
                </div>
            </div>
            <a class="verify-ticket" href="/maker/dashboard/events/@(activity.Handler)/verification/?date=@(dateId)">
                <div class="div-option-details">
                    <img class="option-img" src="images/ote/add.png" alt="cover-photo">
                    <div class="option-name">
                        <p class="registration">Scan Tickets</p>
                    </div>
                </div>
            </a>
        </div>
        @*Tabs*@
        <section class="customer-profile-details">
            <Div Overflow="Overflow.Hidden" class="ongoing-experiences-container personal-tab-swiper" Display="Display.None.OnDesktop.Block.OnMobile">
                <div class="swiper-wrapper">
                    <div class='swiper-slide @(selectedTab == "overview" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "overview" ? "active" : "")' @onclick='() => selectedTab = "overview"'>
                            overview
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "guest-list" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "guest-list" ? "active" : "")' @onclick='() => selectedTab = "guest-list"'>
                                guest list
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "tickets" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "tickets" ? "active" : "")' @onclick='() => selectedTab = "tickets"'>
                            tickets
                        </div>
                    </div>
                    <div class='swiper-slide @(selectedTab == "emails" ? "swiper-slide-active" : "")'>
                        <div class='tab-item @(selectedTab == "emails" ? "active" : "")' @onclick='() => selectedTab = "emails"'>
                            emails
                        </div>
                    </div>
                </div>
            </Div>
            <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Name="overview" TextTransform="TextTransform.Capitalize">overview</Tab>
                    <Tab Name="guest-list" TextTransform="TextTransform.Capitalize">guest list</Tab>
                    <Tab Name="tickets" TextTransform="TextTransform.Capitalize">tickets</Tab>
                    <Tab Name="emails" TextTransform="TextTransform.Capitalize">emails</Tab>
                </Items>
                <Content>
                    <TabPanel Name="overview">
                        <Overview Activity="activity" Tickets="ticketList"/>
                    </TabPanel>
                    <TabPanel Name="guest-list">
                        <GuestList activity="activity" Token=@Token dateId="dateId"></GuestList>
                        @*<Experiences Token="@Token" Activities="Model.EnrolledActivities" Profile="Model.CustomerProfile" />*@
                    </TabPanel>
                    <TabPanel Name="tickets">
                        <Tickets TicketList="ticketList"></Tickets>
                        @*<RequestRefund Profile="Model.CustomerProfile" Token="@Model.Token" />*@
                    </TabPanel>
                    <TabPanel Name="emails">
                        @*<CustomerFavorite profile="Model.CustomerProfile" />*@
                    </TabPanel>
                </Content>
            </Tabs>
        </section>
    </div>

    <Modal @ref="modalSharedLink">
        <ModalContent Centered>
            <ModalBody class="py-4">
                <TextEdit @bind-Text="eventSharedLink.GeneratedLink" />
                <div class="d-flex justify-content-center mt-3">
                    <Button Clicked="CloseModalSharedLink" class="me-3 text-capitalize border-1-solid border-color-grey-100">
                        close
                    </Button>
                    <Button Clicked="CopyToClipboard" class="text-capitalize bg-orange-100 color-white-100 hover-color-white">
                        copy link
                    </Button>
                </div>
            </ModalBody>
        </ModalContent>
    </Modal>

    <Modal @ref="modalSharelinkDisableEnable">
        <ModalContent Centered>
            <ModalHeader class="justify-content-center">
                <label>@(eventSharedLink.Enable ? "Disable" : "Enable") Event Access</label>
            </ModalHeader>
            <ModalBody class="py-4">
                <p class="text-center">
                    We will be @(eventSharedLink.Enable ? "disabling" : "enabling") your sharing access to QR scanner link. Are you sure you want to continue?
                </p>
                <div class="d-flex justify-content-end">
                    <Button Clicked="() => modalSharelinkDisableEnable.Close(CloseReason.UserClosing)" 
                            class="border-1 border-color-grey-100 color-grey-100 border-radius-10 me-2 px-3">
                        Cancel
                    </Button>
                    <Button Disabled="sharedLinkStatus.UpdatingStatus" Loading="sharedLinkStatus.UpdatingStatus" 
                        Clicked="EnableDisableSharedLink"
                        class="bg-green-100 color-white-100 border-radius-10 hover-color-white px-3">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                            Please Wait...
                        </LoadingTemplate>
                        <ChildContent>
                            Confirm
                        </ChildContent>
                    </Button>
                </div>
            </ModalBody>
        </ModalContent>
    </Modal>
}

@code 
{
    [Parameter]
    public string Handler { get; set; } = string.Empty;
    [Parameter, SupplyParameterFromQuery]
    public string? Date {get; set;}

    LoadingIndicator loadingIndicator;
    IJSObjectReference module;
    public List<OteTicket> oteCustomer = new List<OteTicket>();
    public List<OteTicket> FilteredCustomer = new();
    public List<OteSchedule> ticketList = new List<OteSchedule>();
    public List<OteTicket> ExportCustomer = new List<OteTicket>();
    private OteActivity? activity;
    public const string PREVIOUS   = "previous";
    public const string NEXT       = "next";
    public int pageItems           = 10;
    public string currentPage      = "1";
    public bool disableButtonRight = false;
    public bool disableButtonLeft  = false;
    public string Token            = string.Empty;
    public int TotalSlots          = 0;
    public int TotalSold           = 0;
    public int TotalAvailable      = 0;
    public int counterPage         = 10;
    public string SearchValue      = string.Empty;
    public int SearchBy = 0;
    public int selectedFilter;
    public bool IsDisplay = false;
    private string selectedTab = "overview";

    private SharedLink eventSharedLink = new();
    private SharedLinkStatus sharedLinkStatus = new();
    private Modal? modalSharedLink;
    private Modal? modalSharelinkDisableEnable;
    private bool generatingEventSharedLink = false;

    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    private int dateId = 0;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        Token = user.FindFirstValue("Token");

        var result = await activityApiHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs
            {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true,
            }, Handler);
        if (!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
        {
            throw new ApplicationException(result.Message);
        }
        var act = result.Result.Result;
        activity = mapper.Map<OteActivity>(act);
        
        if(!string.IsNullOrEmpty(Date) && int.TryParse(Date, out int parsedDate))
        {
            dateId = parsedDate;
        }

        //Get Ticket List
        await GetTicketList();
        //Get Customer List
        await GetCustomerList(1);

        await GenerateSharedLink();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/exportToExcel.js");
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init", "Experience Details Page Loaded");
    }
    private async Task GetTicketList()
    {
        var ticketResult = await dashboardApiHandler.GetTicketDetails(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetTicketDetailsArgs
            {
                ActivityId = activity.Id,
                DateId = dateId
            }, Token);
        if (ticketResult.Succeeded && ticketResult.Result != null && ticketResult.Result.IsSuccess)
        {
            ticketList = ticketResult.Result.Result.Select(s => new OteSchedule 
            {
                ActivityId  = s.ActivityId,
                From        = s.From,
                To          = s.To,
                Recurrences = s.Recurrences,
                OtePricing = new OtePricing
                {
                    Id          = s.OtePricingDTO.Id,
                    Name        = s.OtePricingDTO.Name,
                    MaxSlots    = s.OtePricingDTO.MaxSlots,
                    Description = s.OtePricingDTO.Description,
                    Sold        = s.OtePricingDTO.Sold,
                    Available   = s.OtePricingDTO.Available,
                    Price       = s.OtePricingDTO.Price
                }
            }).ToList();
        }
        TotalSlots     = ticketList.Sum(a => a.OtePricing.MaxSlots);
        TotalSold      = ticketList.Sum(s => s.OtePricing.Sold);
        TotalAvailable = ticketList.Sum(v => v.OtePricing.Available);
    }

    private async Task GetCustomerList(int pageIndex)
    {
        var result = await dashboardApiHandler.GetOTEByActivityId(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetOTEByActivityIdArgs
            {
                SearchValue  = SearchValue,
                SearchBy     = SearchBy,
                ActivityId   = activity.Id,
                CountPerPage = counterPage,
                PageIndex    = pageIndex,
                DateId = dateId
            }, Token);
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            oteCustomer = result.Result.Result.Select(e => new OteTicket
                {
                    Id         = e.Id,
                    ActivityId = e.ActivityId,
                    Title      = e.Title,
                    Amount     = e.Amount,
                    QRCode     = e.QRCode,
                    Status     = e.Status,
                    Customer = new CustomerProfile
                    {
                        FirstName = e.Customer.FirstName,
                        LastName = e.Customer.LastName,
                        Email = e.Customer.Email
                    }
                }).ToList();
            Pagination = result.Result.Pagination;
            FilteredCustomer = oteCustomer.OrderBy(s=> s.Id).ToList();
        }
    }

    private void NavigateToMyEvents()
    {
        NavigationManager.NavigateTo("/maker/dashboard/events");
    }

    private bool IsActive(string page)
       => currentPage == page;

    private bool IsPageNavigationDisabled(string navigation)
    {
        if (navigation.Equals(PREVIOUS))
        {
            return currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return currentPage.Equals(pageItems.ToString());
        }
        return false;
    }

    private async Task Previous()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt > 1)
        {
            currentPage = (currentPageAsInt - 1).ToString();
            await GetCustomerList(int.Parse(currentPage));
        }
    }

    private async Task Next()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt < Pagination.TotalPages)
        {
            currentPage = (currentPageAsInt + 1).ToString();
            await GetCustomerList(int.Parse(currentPage));
        }
    }

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetCustomerList(int.Parse(page));
    }

    private async Task ExportToExcel()
    {
        await loadingIndicator.Show();
        await Task.Delay(1000);
        //Get Customer List
        var result = await dashboardApiHandler.GetOTEByActivityId(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetOTEByActivityIdArgs
            {
                ActivityId = activity.Id,
                DateId = dateId
            }, Token);
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            ExportCustomer = result.Result.Result.Select(e => new OteTicket
                {
                    Id         = e.Id,
                    ActivityId = e.ActivityId,
                    Title      = e.Title,
                    Amount     = e.Amount,
                    QRCode     = e.QRCode,
                    Status     = e.Status,
                    Customer = new CustomerProfile
                    {
                        FirstName = e.Customer.FirstName,
                        LastName  = e.Customer.LastName,
                        Email     = e.Customer.Email
                    }
                }).OrderBy(a => a.Id).ToList();
        }
        using (var workbook = new XLWorkbook("wwwroot/Template/CustomerList.xlsx"))
        {
            var worksheet = workbook.Worksheet(1);
            int startRow = 3;
            foreach (var item in ExportCustomer)
            {
                worksheet.Cell(1, 6).Value = $"Date: {DateTime.Today.ToString("MMMM dd, yyyy")}";
                worksheet.Cell(startRow, 1).Value = item.Id;
                worksheet.Cell(startRow, 2).Value = $"{item.Customer.FirstName} {item.Customer.LastName}";
                worksheet.Cell(startRow, 3).Value = item.Customer.Email;
                worksheet.Cell(startRow, 4).Value = item.Title;
                worksheet.Cell(startRow, 5).Value = item.Amount;
                worksheet.Cell(startRow, 6).Value = item.Status;
                startRow++;
            }
            using (var memoryStream = new MemoryStream())
            {
                workbook.SaveAs(memoryStream);
                memoryStream.Seek(0, SeekOrigin.Begin);

                var currentDate = DateTime.Now.ToString("yyyyMMddHHmmss");
                var fileName = $"CustomerList_{currentDate}.xlsx";
                byte[] bytes = memoryStream.ToArray();

                var bytesBase64 = Convert.ToBase64String(bytes);

                // Download the saved memorystream file
                await Task.Run(() => module.InvokeVoidAsync("saveAsFile", fileName, bytesBase64));
            }
        }
        await loadingIndicator.Hide();

    }

    public async Task UpdateTicketStatus(OteTicket ticket)
    {
        ticket.Status = ticket.Status == "VERIFIED" ? "UNVERIFIED" : "VERIFIED";
        var updateRes = await dashboardApiHandler.UpdateOTETicket(new Framework.ApiCommand.ApiCore.Dashboard.Request.UpdateOTETicketArgs
            {
                Id = ticket.Id,
                Status = ticket.Status
            }, Token);

        //await GetCustomerList(1);
    }

    private string FormattedId(int id)
    {
        var idString = id.ToString();
        var template = "000000";
        var referenceId = idString.Length > template.Length ? idString : template.Substring(idString.Length) + idString;
        return referenceId;
    }
    private async Task OnFilterValueChanged(int entries)
    {
        counterPage = entries;
        await loadingIndicator.Show();
        await GetCustomerList(1);
        await loadingIndicator.Hide();
    }
    private async Task OnFilterByValueChange(int searchBy)
    {
        switch (searchBy)
        {
            case 0:
                SearchBy = 0;
                IsDisplay = false;
                break;
            case 1:
                SearchBy = 1;
                IsDisplay = true;
                break;
            case 2:
                SearchBy = 2;
                IsDisplay = true;
                break;
            case 3:
                SearchBy = 3;
                IsDisplay = true;
                break;
            default:
                break;
        }
    }

    private async void TextSearchChanged(string search)
    {
        SearchValue = search;
        await loadingIndicator.Show();
        await GetCustomerList(1);
        FilteredCustomer = oteCustomer.OrderBy(a => a.Id).ToList();
        await loadingIndicator.Hide();
    }

    private async Task GenerateSharedLink()
    {
        generatingEventSharedLink = true;
        var generateLinkRes = await activityApiHandler.GenerateEventSharedLink(new Framework.ApiCommand.ApiCore.Activity.Request.GenerateEventSharedLinkArgs {
            DateId = dateId,
            Handler = Handler
        }, Token);
        var result = generateLinkRes.Result.Result;
        generatingEventSharedLink = false;

        if(!generateLinkRes.Succeeded || generateLinkRes.Result is null || !generateLinkRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured when generating event shared link.", "Error");
            return;
        }

        eventSharedLink = new SharedLink {
            Enable = result.Enable,
            GeneratedLink = result.GeneratedLink,
            Guid = result.Guid,
            Token = result.Token,
            Loaded = true
        };

        sharedLinkStatus.Label = eventSharedLink.Enable switch {
            true => "Disable event access",
            _   => "Enable event access"
        };
    }

    private async Task UpdateSharedLinkStatus(bool enable)
    {
        var updateSharedLinkRes = await activityApiHandler.UpdateSharedLinkStatus(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateSharedLinkStatusArgs {
            Enable = enable,
            Guid = eventSharedLink.Guid,
            Token = eventSharedLink.Token
        }, Token);
        var result = updateSharedLinkRes.Result.Result;

        if(!updateSharedLinkRes.Succeeded || updateSharedLinkRes.Result is null || !updateSharedLinkRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured when generating event shared link.", "Error");
            return;
        }

        eventSharedLink.Enable = enable;
    }

    private async Task EnableDisableSharedLink()
    {
        sharedLinkStatus.UpdatingStatus = true;
        bool status = !eventSharedLink.Enable;
        if(!eventSharedLink.Loaded)
        {
            await GenerateSharedLink();
        }
        await UpdateSharedLinkStatus(status);
        sharedLinkStatus.UpdatingStatus = false;

        sharedLinkStatus.Label = eventSharedLink.Enable switch {
            true => "Disable event access",
            _   => "Enable event access"
        };

        await modalSharelinkDisableEnable.Close(CloseReason.None);
    }

    private async Task GenerateLinkShowModal()
    {
        await GenerateSharedLink();
        await modalSharedLink?.Show();
    }

    private async Task CloseModalSharedLink()
    {
        await modalSharedLink?.Close(CloseReason.UserClosing);
    }

    private async Task CopyToClipboard()
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Utils.clipboardCopy.copyToClipboard", eventSharedLink.GeneratedLink);
        await NotificationService.Info("Event scanner link copied to clipboard.", "Copied!");
    }

    private record SharedLink 
    {
        public bool Enable {get; set;} = false;
        public string GeneratedLink {get; set;}
        public string Guid {get; set;}
        public string Token {get; set;}
        public bool Loaded {get; set;}
    }

    private record SharedLinkStatus 
    {
        public bool UpdatingStatus {get; set;}
        public string Label {get; set;} = "Disable event access";
    }
    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
}

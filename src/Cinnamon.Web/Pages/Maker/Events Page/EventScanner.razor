@code 
{
    [Parameter]
    public string Handler {get; set;}

    private DotNetObjectReference<EventScanner>? objRef;
    private IJSObjectReference? scannerInstance;
    private bool validating = false;
    private ScanStatus scanStatus = ScanStatus.NotStarted;
    private string token = string.Empty;
    private EventDetail? eventDetail;

    enum ScanStatus {
        NotStarted = 0,
        Scanning = 1,
        Pause = 2,
        Resume = 3,
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if(!user.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/page-not-found");
            return;
        }
        token =  user.FindFirstValue("Token");

        var accountRes = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs {}, token);
        if(!accountRes.Succeeded || accountRes.Result is null || !accountRes.Result.IsSuccess)
        {
            NavigationManager.NavigateTo("/page-not-found");
            return;
        }
        var profile = accountRes.Result.Result;

        var result = await activityApiHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs {}, Handler);
        if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
        {
            NavigationManager.NavigateTo("/page-not-found");
            return;
        }
        var ote = result.Result.Result;

        if(ote.ProviderId != profile.Id)
        {
            NavigationManager.NavigateTo("/page-not-found");
            return;   
        }

        eventDetail = new EventDetail {
            Id = ote.Id,
            Title = ote.EventName
        };
    }

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            scannerInstance = await JS.InvokeAsync<IJSObjectReference>("MyLib.Pages.maker.oteVerification.createInstance", "video-container", objRef);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if(scannerInstance is not null)
            {
                await scannerInstance.DisposeAsync();
            }
            if(objRef is not null)
            {
                objRef.Dispose();
            }
        }
        catch(Exception){}
    }

    private async Task StartScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("startScan");
            scanStatus = ScanStatus.Scanning;
        }
    }

    private async Task StopScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("stopScan");
            scanStatus = ScanStatus.NotStarted;
        }
    }

    private async Task ResumeScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("resumeScan");
            scanStatus = ScanStatus.Resume;
        }
    }

    private async Task OnScanClick()
    {
        switch(scanStatus) {
            case ScanStatus.Scanning:
                await StopScan();
                break;
            case ScanStatus.Pause:
                await ResumeScan();
                break;
            case ScanStatus.Resume:
                await StopScan();
                break;
            default:
                await StartScan();
                break;
        };
    }

    [JSInvokable]
    public async Task VerifyQR(string qr)
    {
        scanStatus = ScanStatus.Pause;
        validating = true;
        StateHasChanged();

        Console.WriteLine(qr);
        await Task.Delay(3000);
        validating = false;
        StateHasChanged();
    }

    private string ScanButtonMessage 
    {
        get 
        {
            if(validating) return "validating QR";

            var message = scanStatus switch {
                ScanStatus.Scanning => "stop scan",
                ScanStatus.Pause => "resume scan",
                ScanStatus.Resume => "stop scan",
                _ => "scan qr code"
            };
            
            return message;
        }
    }

    record EventDetail 
    {
        public string Title {get; set;}
        public int Id {get; set;}
    }
}
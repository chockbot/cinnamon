                                    <div class="accordion-body p-0">
                                        <Table class="w-100 mb-0" Bordered>
                                        <TableBody>
                                            @foreach (var sched in item.Activities)
                                                {
                                                    <TableRow @key="sched" class="font-16 m-font-14" VerticalAlignment="VerticalAlignment.Middle">
                                                        <TableRowCell class="ps-3">
                                                            <div class="d-flex justify-content-between pe-3">
                                                                <span>
                                                                    @sched.ScheduleFrom.ToString("MMMM dd, yyyy")
                                                                </span>
                                                                <img @onclick="() => NavigateToEventDetails(sched.Handler, sched.OteDateId)"

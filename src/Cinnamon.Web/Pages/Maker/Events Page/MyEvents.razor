@using System.ComponentModel.DataAnnotations
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Framework.ValidationAttributes
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Framework.Enums
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@using Cinnamon.Web.Components.Pages;
@inject IActivityApiHandler activityApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IMapper mapper
@attribute [Authorize]

<PageTitle>Events | CinnamonPH</PageTitle>
<SeoMeta Title="Events" Subject="Dashboard" Url="/maker/dashboard/events" />

<div class="maker-events-wrapper pb-5">
    <div class="d-flex justify-content-between align-items-center my-5">
        <h3 class="my-event-title">My Events</h3>
        <label class="switch-light switch-candy" onclick="">
            <input type="checkbox" @onchange="CheckboxChanged">
            <span>
                <span>Upcoming</span>
                <span>Past</span>
                <a></a>
            </span>
        </label>
    </div>
    @if (!showCompleted)
    {
        <p class="font-20 color-black-100 font-weight-700">Today</p>
        <div class="events-section">
        <div class="event-wrapper">
            @if (isLoading == true)
            {
                for (int x = 0; x < 2; x++)
                {
                    <div class="event-details-content">
                        <div class="event-content d-flex">
                            <img class="event-image skeleton" />
                            <div class="event-details">
                                <p class="event-title skeleton">Title</p>
                                <p class="event-schedule skeleton">30 March 2023 | 10:00 AM</p>
                                <p class="event-location skeleton">Philippine Arena</p>
                                <button class="view-details skeleton">View Details</button>
                            </div>
                        </div>
                        <div class="ticket-details">
                            <p class="ticket-slots skeleton">Slots: 60</p>
                            <p class="ticket-sold skeleton">Sold: 20</p>
                            <p class="ticket-available skeleton">Available: 40</p>
                        </div>
                    </div>
                }
            }
            else
            {
                if (oteActivities.Where(e => e.ScheduleFrom.Date == DateTime.Now.Date).Count() != 0)
                {
                    @foreach (var item in oteActivities.Where(e => e.ScheduleFrom.Date == DateTime.Now.Date))
                    {
                        <div @key="item" class="event-details-content">
                            <div class="event-content d-flex">
                                <img class="event-image" src="@item.EventImage" />
                                <div class="event-details color-black-100">
                                    <p class="font-20 mb-1 m-font-16 font-weight-700">@item.EventName</p>
                                    <p class="font-16 m-font-14 mb-0">@item.ScheduleFrom.ToString("dd MMMM yyyy") | @item.ScheduleFrom.ToString("hh:mm tt")</p>
                                    <p class="font-16 m-font-14 mb-2">@GetEventLocation(item)</p>
                                    <button class="view-details m-font-12" @onclick="@(() => NavigateToEventDetails(item.Handler, item.OteDateId))">View Details</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="no-event">No event today.</p>
                }
                
            }
        </div>
    </div>

        <p class="font-20 color-black-100 font-weight-700 mt-5">Upcoming</p>
        <div class="mb-4 d-flex">
        <span class="d-inline-flex align-items-center cursor-pointer prevent-select me-3" @onclick="() => eventFilter = EventFilter.All">
            <img class="me-1 img-check" src='@(eventFilter == EventFilter.All ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
            <span class="font-16 color-black-100">
                All
            </span>
        </span>
        <span class="d-inline-flex align-items-center cursor-pointer prevent-select me-3" @onclick="() => eventFilter = EventFilter.ThisWeek">
            <img class="me-1 img-check" src='@(eventFilter == EventFilter.ThisWeek ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
            <span class="font-16 color-black-100">
                This Week
            </span>
        </span>
        <span class="d-inline-flex align-items-center cursor-pointer prevent-select" @onclick="() => eventFilter = EventFilter.ThisMonth">
            <img class="me-1 img-check" src='@(eventFilter == EventFilter.ThisMonth ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
            <span class="font-16 color-black-100">
                This Month
            </span>
        </span>
    </div>
        <div class="events-section">
        @if (isLoading == true)
        {
            for (int x = 0; x < 2; x++)
            {
                <div class="event-details-content">
                    <div class="event-content d-flex">
                        <img class="event-image skeleton" />
                        <div class="event-details">
                            <p class="event-title skeleton">Title</p>
                            <p class="event-schedule skeleton">30 March 2023 | 10:00 AM</p>
                            <p class="event-location skeleton">Philippine Arena</p>
                            <button class="view-details skeleton">View Details</button>
                        </div>
                    </div>
                    <div class="ticket-details">
                        <p class="ticket-slots skeleton">Slots: 60</p>
                        <p class="ticket-sold skeleton">Sold: 20</p>
                        <p class="ticket-available skeleton">Available: 40</p>
                    </div>
                </div>
            }
        }
        else
        {
            @if(FilteredWeekMonthOte.Count() != 0)
            {
                <div class="accordion" id="accordion-schedules">
                    @foreach (var item in FilteredWeekMonthOte)
                    {
                        <div class="accordion-item mb-3" @key="item">
                            <h2 class="accordion-header">
                                <button class='accordion-button text-capitalize font-20 m-font-16 font-weight-700 color-black-100 py-2 ps-3'
                                        type="button" data-bs-toggle="collapse"
                                        data-bs-target='@($"#collapse-{item.Id}")' aria-expanded="true" aria-controls='@($"collapse-{item.Id}")'>
                                    @item.Title

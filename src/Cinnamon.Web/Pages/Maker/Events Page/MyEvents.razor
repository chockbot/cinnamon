</div>
@code {
    private List<Activity> activities = new List<Activity>();
    private OteActivity? activity;
    private List<OteActivity> oteActivities = new List<OteActivity>();
    public CustomerProfile profile = new CustomerProfile();
    private string Token = string.Empty;
    private bool isLoading = true;
    private bool showCompleted = false;

    enum EventFilter {
        All = 0,
        ThisWeek = 1,
        ThisMonth = 2
    }
    private EventFilter eventFilter = EventFilter.All;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");

            //Get OTE Details
            var resultOTE = await activityApiHandler.GetOtePerDay(Token);
            if (resultOTE.Succeeded && resultOTE.Result != null && resultOTE.Result.IsSuccess)
            {
                oteActivities = resultOTE.Result.Result.Select(a =>
                {
                    return new OteActivity
                    {
                        Id               = a.ActivityId,
                        ExperienceTypeId = a.ExperienceTypeId,
                        EventName        = a.Title,
                        Description      = a.Description,
                        Handler          = a.Handler,
                        CityName         = a.CityName,
                        RegionName       = a.RegionName,
                        PinnedLocation   = a.PinnedLocation,
                        EventImage       = a.EventImage,
                        ScheduleFrom     = a.DateStart,
                        ScheduleTo       = a.DateEnd,
                        OteDateId        = a.DateId,
                        ForceDisable     = a.ForceDisable
                    };
                }).ToList();
            }
            isLoading = false;
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }

    private void NavigateToEventDetails(string handler, int selectedId)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/events/{handler}/?date={selectedId}");
    }

    private IEnumerable<GroupOte> FilteredWeekMonthOte
    {
        get 
        {   
            var week = DateTime.Now.Date.AddDays(7);
            var firstDayOfMonth = DateTime.Now.Date.FirstDayOfMonth();
            var lastDayOfMonth = DateTime.Now.Date.LastDayOfMonth();
            var currentDate = DateTime.Now.Date;

            var filteredResult = eventFilter switch
            {
                EventFilter.ThisWeek => oteActivities
                    .Where(e => !e.ForceDisable && (e.ScheduleFrom.Date >= DateTime.Now.Date && e.ScheduleFrom.Date <= week) && e.ScheduleFrom.Date != currentDate)
                    .GroupBy(e => e.Id)
                    .Select(e => new GroupOte {Activities = e, Title = e.FirstOrDefault()?.EventName ?? "", Id = e.Key }),
                EventFilter.ThisMonth => oteActivities
                    .Where(e => !e.ForceDisable && (e.ScheduleFrom.Date >= firstDayOfMonth && e.ScheduleTo.Date <= lastDayOfMonth) && e.ScheduleFrom.Date != currentDate)
                    .GroupBy(e => e.Id)
                    .Select(e => new GroupOte {Activities = e, Title = e.FirstOrDefault()?.EventName ?? "", Id = e.Key }),
                _ => oteActivities
                    .Where(e => !e.ForceDisable && e.ScheduleFrom.Date != currentDate)
                    .GroupBy(e => e.Id)
                    .Select(e => new GroupOte {Activities = e, Title = e.FirstOrDefault()?.EventName ?? "", Id = e.Key }),
            };

            return filteredResult;
        }
    }

    private IEnumerable<GroupOte> CompletedEvents
    {
        get 
        {
            return oteActivities
                    .Where(a => a.ForceDisable)
                    .GroupBy(e => e.Id)
                    .Select(e => new GroupOte {Activities = e, Title = e.FirstOrDefault()?.EventName ?? "", Id = e.Key});
        }    
    }

    private string GetEventLocation(OteActivity activity)
    {
        if(activity.ExperienceTypeId == 2) return "Online";
        if(!string.IsNullOrEmpty(activity.PinnedLocation)) return activity.PinnedLocation;
        return $"{activity.CityName} {activity.RegionName}"; 
    }

    record GroupOte 
    {
        public int Id {get; set;}
        public string Title {get; set;}
        public IEnumerable<OteActivity> Activities {get; set;}
    }
    private void CheckboxChanged(ChangeEventArgs e)
    {
        showCompleted = !showCompleted;
    }
}

                                                            </div>

                                                        </TableRowCell>
                                                        <TableRowCell class="ps-3 m-d-none">@sched.ScheduleFrom.ToString("hh:mm tt")</TableRowCell>
                                                        <TableRowCell class="ps-3 m-d-none">
                                                            @GetEventLocation(sched)
                                                        </TableRowCell>
                                                        <TableRowCell class="ps-3 m-d-none">
                                                            <Button Clicked="() => NavigateToEventDetails(sched.Handler, sched.OteDateId)" Type="ButtonType.Button"

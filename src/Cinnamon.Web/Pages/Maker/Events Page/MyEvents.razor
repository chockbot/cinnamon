@layout DashboardLayout
@page "/maker/dashboard/events"
@using AutoMapper;
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Framework.ValidationAttributes
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Framework.Enums
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@inject IActivityApiHandler activityApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IMapper mapper
@attribute [Authorize]

<PageTitle>Events | CinnamonPH</PageTitle>
<SeoMeta Title="Events" Subject="Dashboard" Url="/maker/dashboard/events" />


<div class="maker-events-wrapper pb-5">
    <div class="header">
        <p class="title">My Events</p>
    </div>

    <p class="font-20 color-black-100 font-weight-700">Today</p>
    <div class="events-section">
        <div class="event-wrapper">
            @if (isLoading == true)
            {
                for (int x = 0; x < 2; x++)
                {
                    <div class="event-details-content">
                        <div class="event-content d-flex">
                            <img class="event-image skeleton" />
                            <div class="event-details">
                                <p class="event-title skeleton">Title</p>
                                <p class="event-schedule skeleton">30 March 2023 | 10:00 AM</p>
                                <p class="event-location skeleton">Philippine Arena</p>
                                <button class="view-details skeleton">View Details</button>
                            </div>
                        </div>
                        <div class="ticket-details">
                            <p class="ticket-slots skeleton">Slots: 60</p>
                            <p class="ticket-sold skeleton">Sold: 20</p>
                            <p class="ticket-available skeleton">Available: 40</p>
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var item in oteActivities.Where(e => e.ScheduleFrom.Date == DateTime.Now.Date))
                {
                    <div @key="item" class="event-details-content">
                        <div class="event-content d-flex">
                            <img class="event-image" src="@item.EventImage" />
                            <div class="event-details">
                                <p class="event-title">@item.EventName</p>
                                <p class="event-schedule">@item.ScheduleFrom.ToString("dd MMMM yyyy") | @item.ScheduleFrom.ToString("hh:mm tt")</p>
                                @if(item.ExperienceTypeId == 2)
                                {
                                    <p class="event-location">
                                        Online
                                    </p>
                                }
                                else 
                                {
                                    @if (!string.IsNullOrEmpty(item.PinnedLocation))
                                    {
                                        <p class="event-location">
                                            @item.PinnedLocation
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="event-location">
                                            @item.CityName, @item.RegionName
                                        </p>
                                    }
                                }
                                <button class="view-details" @onclick="@(() => NavigateToEventDetails(item.Handler, item.OteDateId))">View Details</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <p class="font-20 color-black-100 font-weight-700 mt-5">Upcoming</p>
    <div class="mb-4 d-flex">
        <span class="d-inline-flex align-items-center cursor-pointer prevent-select me-3" @onclick="() => thisWeek = !thisWeek">
            <img class="me-1" src='@(thisWeek ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
            <span class="font-16 color-black-100">
                This Week
            </span>
        </span>
        <span class="d-inline-flex align-items-center cursor-pointer prevent-select" @onclick="() => thisWeek = !thisWeek">
            <img class="me-1" src='@(!thisWeek ? "images/Dashboard/rounded-check.png" : "images/Dashboard/rounded-uncheck.png")' alt="check-icon">
            <span class="font-16 color-black-100">
                This Month
            </span>
        </span>
    </div>
    <div class="events-section">
        <div class="event-wrapper">
            @if (isLoading == true)
            {
                for (int x = 0; x < 2; x++)
                {
                    <div class="event-details-content">
                        <div class="event-content d-flex">
                            <img class="event-image skeleton" />
                            <div class="event-details">
                                <p class="event-title skeleton">Title</p>
                                <p class="event-schedule skeleton">30 March 2023 | 10:00 AM</p>
                                <p class="event-location skeleton">Philippine Arena</p>
                                <button class="view-details skeleton">View Details</button>
                            </div>
                        </div>
                        <div class="ticket-details">
                            <p class="ticket-slots skeleton">Slots: 60</p>
                            <p class="ticket-sold skeleton">Sold: 20</p>
                            <p class="ticket-available skeleton">Available: 40</p>
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var item in FilteredWeekMonthOte)
                {
                    <div @key="item" class="event-details-content">
                        <div class="event-content d-flex">
                            <img class="event-image" src="@item.EventImage" />
                            <div class="event-details">
                                <p class="event-title">@item.EventName</p>
                                <p class="event-schedule">@item.ScheduleFrom.ToString("dd MMMM yyyy") | @item.ScheduleFrom.ToString("hh:mm tt")</p>
                                @if(item.ExperienceTypeId == 2)
                                {
                                    <p class="event-location">
                                        Online
                                    </p>
                                }
                                else 
                                {
                                    @if (!string.IsNullOrEmpty(item.PinnedLocation))
                                    {
                                        <p class="event-location">
                                            @item.PinnedLocation
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="event-location">
                                            @item.CityName, @item.RegionName
                                        </p>
                                    }
                                }
                                <button class="view-details" @onclick="@(() => NavigateToEventDetails(item.Handler, item.OteDateId))">View Details</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div> 
</div>
@code {
    private List<Activity> activities = new List<Activity>();
    private OteActivity? activity;
    private List<OteActivity> oteActivities = new List<OteActivity>();
    public CustomerProfile profile = new CustomerProfile();
    private string Token = string.Empty;
    private bool isLoading = true;
    private bool thisWeek = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");

            //Get OTE Details
            var resultOTE = await activityApiHandler.GetOtePerDay(Token);
            if (resultOTE.Succeeded && resultOTE.Result != null && resultOTE.Result.IsSuccess)
            {
                oteActivities = resultOTE.Result.Result.Select(a =>
                {
                    return new OteActivity
                    {
                        Id               = a.ActivityId,
                        ExperienceTypeId = a.ExperienceTypeId,
                        EventName        = a.Title,
                        Description      = a.Description,
                        Handler          = a.Handler,
                        CityName         = a.CityName,
                        RegionName       = a.RegionName,
                        PinnedLocation   = a.PinnedLocation,
                        EventImage       = a.EventImage,
                        ScheduleFrom     = a.DateStart,
                        ScheduleTo       = a.DateEnd,
                        OteDateId        = a.DateId
                    };
                }).ToList();
            }
            isLoading = false;
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }

    private void NavigateToEventDetails(string handler, int selectedId)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/events/{handler}/?date={selectedId}");
    }

    private IEnumerable<OteActivity> FilteredWeekMonthOte
    {
        get 
        {
            var result = Enumerable.Empty<OteActivity>();
            
            var week = DateTime.Now.Date.AddDays(7);
            if(thisWeek)
            {
                result = oteActivities.Where(e => e.ScheduleFrom.Date >= DateTime.Now.Date && e.ScheduleFrom.Date <= week);
            }
            else 
            {
                var firstDayOfMonth = DateTime.Now.Date.FirstDayOfMonth();
                var lastDayOfMonth = DateTime.Now.Date.LastDayOfMonth();

                result = oteActivities.Where(e => e.ScheduleFrom.Date >= firstDayOfMonth && e.ScheduleTo.Date <= lastDayOfMonth);
            }

            return result;
        }
    }
}

@page "/shared/event-scanner";
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IActivityApiHandler activityApiHandler;
@inject IJSRuntime JS;
@inject NavigationManager NavigationManager;
@inject INotificationService NotificationService;
@implements IAsyncDisposable;
@layout EmptyLayout;

<section class="wrapper-ote-ticket-verification">
    <Container>
        <label class="d-flex align-items-center mt-3 mb-2 mb-md-5">
            <label class="ms-3 font-32 color-orange-100 font-weight-700 m-font-20 text-decoration-none hover-color-primary">Verify Tickets</label>
        </label>
        @if(eventDetail is not null)
        {
            <h3 class="font-32 color-black-100 font-weight-900 m-font-24 m-text-center mb-1 mb-md-3 text-capitalize">@eventDetail.Title</h3>
        }
        <div class="scanner-log-container">
            <div class="scanner-container text-center">
                <div id="video-container" class="video-container border-1-dashed border-color-black-100">

                </div>
                @if(eventDetail is not null)
                {
                    <Button Disabled="validating" Clicked="OnScanClick" class="text-capitalize bg-orange-100 color-white-100 hover-color-white mt-3">
                        <span>@ScanButtonMessage</span>
                    </Button>
                }
            </div>
            <div class="log-container">
                <Table class="w-100 border-radius-10 border-color-black-100 border-1-solid">
                    <TableHeader class="bg-black-100 color-white-100 font-16">
                        <TableRow>
                            <TableRowCell>
                                #
                            </TableRowCell>
                            <TableRowCell>
                                Seat Plan
                            </TableRowCell>
                            <TableHeaderCell>
                            </TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody class="font-16 m-font-14 log-body">
                        @foreach (var item in verificationLogs.OrderByDescending(l => l.LogDate).Take(20))
                        {
                            <TableRow VerticalAlignment="VerticalAlignment.Middle">
                                <TableRowCell class="item-qr color-grey-100">
                                    @(item.TicketNumber > 0 ? FormattedId(item.TicketNumber) : "N/A")
                                </TableRowCell>
                                <TableRowCell class="item-qr color-grey-100">
                                    @item.TicketSeat
                                </TableRowCell>
                                <TableRowCell>
                                    <div class="item-message d-flex justify-content-end">
                                        <label class="text-end">
                                            <span class="@LogStyle(item.ErrorCode)">
                                                @item.Message
                                            </span>
                                        </label>
                                    </div>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </div>
        </div>
    </Container>
    <audio class="notification-successs"><source src="media/notifications/success.mp3" /></audio>
    <audio class="notification-error"><source src="media/notifications/error.mp3" /></audio>
</section>

@code 
{
    [Parameter, SupplyParameterFromQuery]
    public string Guid {get; set;}

    [Parameter, SupplyParameterFromQuery]
    public string Token {get; set;}

    private DotNetObjectReference<SharedEventScanner>? objRef;
    private IJSObjectReference? scannerInstance;
    private bool validating = false;
    private ScanStatus scanStatus = ScanStatus.NotStarted;
    private EventDetail? eventDetail;
    private IList<VerificationLog> verificationLogs = new List<VerificationLog>();

    enum ScanStatus {
        NotStarted = 0,
        Scanning = 1,
        Pause = 2,
        Resume = 3,
    }

    protected override async Task OnInitializedAsync()
    {
        var validateTokenRes = await activityApiHandler.ValidateSharedLink(new Framework.ApiCommand.ApiCore.Activity.Request.OteValidateSharedLinkArgs {
            Guid = Guid,
            Token = Token
        });
        if(!validateTokenRes.Succeeded || validateTokenRes.Result is null || !validateTokenRes.Result.IsSuccess)
        {
            NavigationManager.NavigateTo("/page-not-found");
            return;
        }
        var validated = validateTokenRes.Result.Result;

        eventDetail = new EventDetail {
            Id = validated.Id,
            Title = validated.Title
        };
    }

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            scannerInstance = await JS.InvokeAsync<IJSObjectReference>("MyLib.Pages.maker.oteVerification.createInstance", "video-container", objRef);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if(scannerInstance is not null)
            {
                await scannerInstance.DisposeAsync();
            }
            if(objRef is not null)
            {
                objRef.Dispose();
            }
        }
        catch(Exception){}
    }

    private async Task StartScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("startScan");
            scanStatus = ScanStatus.Scanning;
        }
    }

    private async Task StopScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("stopScan");
            scanStatus = ScanStatus.NotStarted;
        }
    }

    private async Task ResumeScan()
    {
        if(scannerInstance is not null)
        {
            await scannerInstance.InvokeVoidAsync("resumeScan");
            scanStatus = ScanStatus.Resume;
        }
    }

    private async Task OnScanClick()
    {
        switch(scanStatus) {
            case ScanStatus.Scanning:
                await StopScan();
                break;
            case ScanStatus.Pause:
                await ResumeScan();
                break;
            case ScanStatus.Resume:
                await StopScan();
                break;
            default:
                await StartScan();
                break;
        };
    }

    [JSInvokable]
    public async Task VerifyQR(string qr)
    {
        scanStatus = ScanStatus.Pause;
        validating = true;
        StateHasChanged();

        string defaultErrorMessage = "An error occured. Please contact support.";

        var verificationRes = await activityApiHandler.VerifySharedEventLink(new Framework.ApiCommand.ApiCore.Activity.Request.VerifySharedEventLinkArgs {
            Guid = Guid,
            Token = Token,
            QrCode = qr
        });
        if(!verificationRes.Succeeded || verificationRes.Result is null)
        {
            NotificationService.Error(defaultErrorMessage, "Error");
            await scannerInstance.InvokeVoidAsync("playErrorNotification");
        }

        if(verificationRes.Succeeded && !verificationRes.Result.IsSuccess)
        {
            verificationLogs.Add(new VerificationLog {
                ErrorCode = verificationRes.Result.ErrorInfo.Code,
                Message = verificationRes.Result.ErrorInfo.Message,
                QrCode = qr,
                LogDate = DateTime.Now,
                TicketSeat = "Not Applicable"
            });
            await scannerInstance.InvokeVoidAsync("playErrorNotification");
        }
        else 
        {
            verificationLogs.Add(new VerificationLog {
                ErrorCode = "success",
                Message = "Valid ticket",
                QrCode = qr,
                LogDate = DateTime.Now,
                TicketSeat = verificationRes.Result.Result.TicketSeat,
                TicketNumber = verificationRes.Result.Result.Id
            });
            await scannerInstance.InvokeVoidAsync("playSuccessNotification");
        }

        validating = false;
        StateHasChanged();
    }

    private string ScanButtonMessage 
    {
        get 
        {
            if(validating) return "validating QR";

            var message = scanStatus switch {
                ScanStatus.Scanning => "stop scan",
                ScanStatus.Pause => "resume scan",
                ScanStatus.Resume => "stop scan",
                _ => "scan qr code"
            };
            
            return message;
        }
    }

    private string LogStyle(string errorCode)
    {
        string style = "d-flex align-items-center";

        switch(errorCode)
        {
            case "invalid":
                style += " log-invalid";
                break;
            case "duplicate":
                style += " log-duplicate";
                break;
            case "success":
                style += " log-valid";
                break;
            default:
                style += " log-invalid";
                break;
        }

        return style;
    }

    private string FormattedId(int id)
    {
        var idString = id.ToString();
        var template = "000000";
        var referenceId = idString.Length > template.Length ? idString : template.Substring(idString.Length) + idString;
        return referenceId;
    }

    record EventDetail 
    {
        public string Title {get; set;}
        public int Id {get; set;}
    }

    record VerificationLog 
    {
        public string QrCode {get; set;}
        public string ErrorCode {get; set;}
        public string Message {get; set;}
        public DateTime LogDate {get; set;}
        public string TicketSeat {get; set;}
        public int TicketNumber {get; set;}
    }
}
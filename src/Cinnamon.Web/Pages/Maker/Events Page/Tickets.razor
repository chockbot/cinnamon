@layout EmptyLayout;
@using Cinnamon.Web.Models.Ote

<div class="ticket-options">
    <div class="event-buttons d-flex">
        <button class="btn-event">Event Capacity 300 &#9679; Wailist Off</button>
        <button class="btn-event">Manage Event</button>
    </div>
</div>
<div class="ticket-details-section">
    @foreach(var ticket in TicketList)
    {
        <div class="ticket-box">
            <div class="ticket-section-name">
                <p class="ticket-title">@ticket.OtePricing.Name</p>
            </div>
            <p class="ticket-price">
                @((ticket.OtePricing.Price == 0) ? "Free" : $"₱{ticket.OtePricing.Price:N0}")
            </p>
            <div class="approval-section">
                <p class="sold-value">Required Approval</p>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault-@ticket.OtePricing.Id">
                </div>
            </div>
            <Divider/>
            <div class="ticket-availability">
                @if(ticket.OtePricing.MaxSlots <= ticket.OtePricing.Sold)
                {
                    <div class="sold-ticket">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="11" viewBox="0 0 10 11" fill="none">
                            <circle cx="5" cy="5.5" r="5" fill="#AD0C0C" />
                        </svg>
                        <p class="sold-value">Sold Out</p>
                    </div>
                    <p class="sold-value">@ticket.OtePricing.Sold/@ticket.OtePricing.MaxSlots</p>
                }
                else
                {
                    <div class="sold-ticket">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="11" viewBox="0 0 10 11" fill="none">
                            <circle cx="5" cy="5.5" r="5" fill="#009220" />
                        </svg>
                        <p class="sold-value">Available</p>
                    </div>
                    <p class="sold-value">@ticket.OtePricing.Sold/@ticket.OtePricing.MaxSlots</p>
                }
            </div>
        </div>
    }
</div>
<Divider />
<div class="mt-3 border-radius-10 p-4 m-bg-white-100 m-padding-0 m-margin-top-30">
    <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
        Registration Emails
    </h3>
    <p class="sub-text">
        Customize the emails sent when a guest registers for the event and for when you approve or decline their registration.
    </p>

    <Row HorizontalGutter="10">
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box">
                <img class="mb-2" src="images/ote/tiny-clock.png" alt="clock">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Pending Approval / Waitlist</p>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box">
                <img class="mb-2" src="images/ote/tiny-check.png" alt="check">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Going</p>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box">
                <img class="mb-2" src="images/ote/tiny-close.png" alt="close">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Declined</p>
            </div>
        </Column>
    </Row>
</div>

@code {
    [Parameter]
    public IEnumerable<OteSchedule> TicketList { get; set; }
    private int? activeMenuId;
    private string ShowMenu(int ticketId)
    {
        return activeMenuId == ticketId ? "show" : "";
    }
}

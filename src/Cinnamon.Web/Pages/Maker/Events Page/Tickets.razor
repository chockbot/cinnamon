                <defs>
                    <clipPath id="clip0_1597_2089">
                        <rect width="20" height="20" fill="white" />
                    </clipPath>
                </defs>
            </svg>
            <p class="custom-text">Custom Questions</p>
        </div>
        <div class="provider-questions">
            @foreach (var question in providerQuestions)
            {
                <ol>
                    <li class="title-holder"> @question.Question</li>
                </ol>
                
            }
        </div>
        <div class="action-buttons">
            <Button Clicked="NavigateToQuestions" class="btn-question">
                <span class="ms">Add Registration Questions</span>
            </Button>
            <Button Clicked="NavigateToRegistration" class="btn-question">
                <span class="ms">Edit Registration Questions</span>
            </Button>
        </div>
        
    </div>
</div>



@code {
    [Parameter]
    public OteActivity OteActivity { get; set; }


    [Parameter]
    public string Token { get; set; }

    [Parameter]
    public IEnumerable<OteSchedule> TicketList { get; set; }

    private List<CustomQuestion> providerQuestions = new List<CustomQuestion>();

    private int? activeMenuId;
    private string pendingBody = string.Empty;
    private string acceptedBody = string.Empty;
    private string declinedBody = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        //Get Email
        var pendingTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs
            {
                ActivityId = OteActivity.Id,
                TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OtePending.ToString()
            }, Token);

        var acceptedTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs
            {
                ActivityId = OteActivity.Id,
                TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteConfirmed.ToString()
            }, Token);

        var declinedTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs
            {
                ActivityId = OteActivity.Id,
                TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteDeclined.ToString()
            }, Token);

        await Task.WhenAll(pendingTemplate, acceptedTemplate, declinedTemplate);
        var pendingResult = pendingTemplate.Result;
        var accpedtedResult = acceptedTemplate.Result;
        var declinedResult = declinedTemplate.Result;

        if (pendingResult.Succeeded && pendingResult.Result is not null && pendingResult.Result.IsSuccess)
        {
            pendingBody = pendingResult.Result.Result.Body;
        }

        if (accpedtedResult.Succeeded && accpedtedResult.Result is not null && accpedtedResult.Result.IsSuccess)
        {
            acceptedBody = accpedtedResult.Result.Result.Body;
        }

        if (declinedResult.Succeeded && declinedResult.Result is not null && declinedResult.Result.IsSuccess)
        {
            declinedBody = declinedResult.Result.Result.Body;
        }

        //Get provider questions
        var providerQuestionsRes = await activityApiHandler.ProviderQuestions(new Framework.ApiCommand.ApiCore.Activity.Request.ProviderQuestionsArgs
            {
                ActivityId = OteActivity.Id
            }, Token);
        if (providerQuestionsRes.Succeeded && providerQuestionsRes.Result is not null && providerQuestionsRes.Result.IsSuccess)
        {
            providerQuestions.AddRange(providerQuestionsRes.Result.Result.Select(q => new CustomQuestion
                {
                    FieldType = q.FieldType,
                    IsNew = false,
                    Question = q.FieldLabel,
                    Required = q.Required
                }));
        }
    }

    private string ShowMenu(int ticketId)
    {
        return activeMenuId == ticketId ? "show" : "";
    }
    private void NavigateToTickets()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{1}");
    }
    private void NavigateToQuestions()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{4}");
    }
    private void NavigateToCapacity()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{6}");
    }
    private void NavigateToEvents()
    {
        NavigationManager.NavigateTo("/maker/dashboard/events");
    }
    private void NavigateToPending()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{7}");
    }
    private void NavigateToAccepted()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{8}");
    }
    private void NavigateToDeclined()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{9}");
    }
    private void NavigateToRegistration()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{10}");
    }
    public class CustomQuestion
    {
        public string Question { get; set; }
        public bool Required { get; set; }
        public string FieldType { get; set; } = Cinnamon.Framework.Enums.FieldType.TextArea.ToString();
        public bool IsNew { get; set; } = false;
    }
    public class ScheduleNotification
    {
        public int Days { get; set; } = 1;
        public string Subject { get; set; }
        public string Body { get; set; }
    }

    private async Task PendingHoverMove(MouseEventArgs e)
    { 
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.moveEffect", e, "#pendingDiv");
    }
    private async Task PendingHoverLeave(MouseEventArgs e)
    {
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.hideEffect", "#pendingDiv");
    }
    private async Task GoingHoverMove(MouseEventArgs e)
    { 
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.moveEffect", e, "#goingDiv");
    }
    private async Task GoingHoverLeave(MouseEventArgs e)
    {
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.hideEffect", "#goingDiv");
    }
    private async Task DeclinedHoverMove(MouseEventArgs e)
    { 
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.moveEffect", e, "#declinedDiv");
    }
    private async Task DeclinedHoverLeave(MouseEventArgs e)
    {
        await JS.InvokeVoidAsync("MyLib.Utils.hoverEffect.hideEffect", "#declinedDiv");
    }

}

@layout EmptyLayout;
@using Cinnamon.Web.Models.Ote
@inject NavigationManager NavigationManager

<div class="ticket-options">
    <div class="event-buttons d-flex">
        <button class="btn-event" @onclick="NavigateToCapacity"><span class="fw-bold">Event Capacity</span>@((OteActivity.IsCapacity == true) ? $" {OteActivity.CapacityCount}" : "Off") &#x2022; Waitlist</button>
        <button class="btn-event" @onclick="NavigateToEvents">Manage Event</button>
    </div>
</div>
<div class="ticket-details-section">
    @foreach(var ticket in TicketList)
    {
        <div class="ticket-box cursor-pointer" @onclick="NavigateToTickets">
            <div class="ticket-section-name">
                <p class="ticket-title">@ticket.OtePricing.Name</p>
            </div>
            <p class="ticket-price">
                @((ticket.OtePricing.Price == 0) ? "Free" : $"₱{ticket.OtePricing.Price:N0}")
            </p>
            <div class="approval-section">
                <p class="sold-value">Required Approval</p>
                <div class="form-check form-switch">
                    <Switch Disabled="ticket.OtePricing.Price != 0" @bind-Checked="ticket.OtePricing.RequiredApproval" TValue="bool" class="form-check-input" ElementId="ticket.OtePricing.Id" />
                </div>
            </div>
            <Divider/>
            <div class="ticket-availability">
                @if(ticket.OtePricing.MaxSlots <= ticket.OtePricing.Sold)
                {
                    <div class="sold-ticket">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="11" viewBox="0 0 10 11" fill="none">
                            <circle cx="5" cy="5.5" r="5" fill="#AD0C0C" />
                        </svg>
                        <p class="sold-value">Sold Out</p>
                    </div>
                    <p class="sold-value">@ticket.OtePricing.Sold/@ticket.OtePricing.MaxSlots</p>
                }
                else
                {
                    <div class="sold-ticket">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="11" viewBox="0 0 10 11" fill="none">
                            <circle cx="5" cy="5.5" r="5" fill="#009220" />
                        </svg>
                        <p class="sold-value">Available</p>
                    </div>
                    <p class="sold-value">@ticket.OtePricing.Sold/@ticket.OtePricing.MaxSlots</p>
                }
            </div>
        </div>
    }
</div>
<Divider />
<div class="mt-3 border-radius-10 pt-3 m-bg-white-100 m-padding-0 m-margin-top-30">
    <h3 class="text-capitalize font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
        Registration Emails
    </h3>
    <p class="sub-text">
        Customize the emails sent when a guest registers for the event and for when you approve or decline their registration.
    </p>

    <Row HorizontalGutter="10">
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" @onclick="NavigateToPending">
                <img class="mb-2" src="images/ote/tiny-clock.png" alt="clock">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Pending Approval / Waitlist</p>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" @onclick="NavigateToAccepted">
                <img class="mb-2" src="images/ote/tiny-check.png" alt="check">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Going</p>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop.Is12.OnTablet">
            <div class="bg-white-100 border-radius-10 p-2 cursor-pointer email-box" @onclick="NavigateToDeclined">
                <img class="mb-2" src="images/ote/tiny-close.png" alt="close">
                <div class="div-line mb-1"></div>
                <div class="div-line-75 mb-2"></div>
                <p class="font-16 color-grey-100 mb-0">Declined</p>
            </div>
        </Column>
    </Row>
    <h3 class="text-capitalize mt-3  font-24 font-weight-700 color-black-100 d-flex align-items-center m-font-20">
        Registration Questions
    </h3>
    <p class="sub-text mb-4">
        We will ask guests the following questions when they register for the event.
    </p>

    <Row class="align-items-center mb-2">
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <label for="">Name</label>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <TextEdit Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center"
                          Size="Size.Small" Placeholder="Required" Disabled />
            </div>
        </Column>
    </Row>
    <Row class="align-items-center mb-2">
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <label for="">Email Address</label>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <TextEdit Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center"
                          Size="Size.Small" Placeholder="Required" Disabled />
            </div>
        </Column>
    </Row>
    <Row class="align-items-center mb-4">
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <label for="">Phone Number</label>
            </div>
        </Column>
        <Column ColumnSize="ColumnSize.Is12.Is3.OnDesktop">
            <div>
                <TextEdit Background="Background.White" Border="Border.RoundedPill" TextAlignment="TextAlignment.Center"
                          Size="Size.Small" Placeholder="Required" Disabled />
            </div>
        </Column>
    </Row>

    <div>
        <Button Clicked="NavigateToQuestions" class="color-green-100 bg-white-100 font-16 mb-3">
            + <span class="ms-2">Add Questions</span>
        </Button>
    </div>
</div>

@code {
    [Parameter]
    public OteActivity OteActivity { get; set; }

    [Parameter]
    public IEnumerable<OteSchedule> TicketList { get; set; }

    private int? activeMenuId;

    private string ShowMenu(int ticketId)
    {
        return activeMenuId == ticketId ? "show" : "";
    }
    private void NavigateToTickets()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{1}");
    }
    private void NavigateToQuestions()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{4}");
    }
    private void NavigateToCapacity()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{6}");
    }
    private void NavigateToEvents()
    {
        NavigationManager.NavigateTo("/maker/dashboard/events");
    }
    private void NavigateToPending()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{7}");
    }
    private void NavigateToAccepted()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{8}");
    }
    private void NavigateToDeclined()
    {
        NavigationManager.NavigateTo($"/experiences/ote/{OteActivity.Handler}/{9}");
    }
}

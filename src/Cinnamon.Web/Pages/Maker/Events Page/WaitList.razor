@layout EmptyLayout;
@using ClosedXML.Excel;
@using Newtonsoft.Json;
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@inject INotificationService NotificationService;
@inject IDashboardApiHandler dashboardApiHandler
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IJSRuntime jsRuntime

<div class="customer-list">
    <div class="ticket-table">
        <div class="table-list">
            @if (OteWaitlist == null || !OteWaitlist.Any())
            {
                <div class="sub-text">
                    No waitlist in this event!
                </div>
            }
            else
            {
                <LoadingIndicator @ref="loadingIndicator" FullScreen FadeIn>
                    <div class="excel-section">
                        <button class="btn-export" @onclick="ExportToExcel">
                            Export to Excel
                            <img class="excel-icon" src="images/xls-icon.svg" />
                        </button>
                    </div>
                    <Table Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                <TableHeader>
                    <TableRow>
                        <TableHeaderCell class="th-id">
                            Name
                        </TableHeaderCell>
                        <TableHeaderCell class="th-name">
                            Ticket
                        </TableHeaderCell>
                        <TableHeaderCell class="th-email">
                            Amount
                        </TableHeaderCell>
                        <TableHeaderCell class="th-status">
                            Action
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in OteWaitlist)
                        {
                            <TableRow @key="item">
                                <TableRowCell class="tr-name">
                                    <span>@item.CustomerName</span>
                                </TableRowCell>
                                <TableRowCell class="tr-name">
                                    <span>@item.TicketName</span>
                                </TableRowCell>
                                <TableRowCell class="tr-name">
                                    <span>@(item.TicketPrice <= 0 ? "FREE" : item.TicketPrice.ToString("#,##0.00"))</span>
                                </TableRowCell>
                                @switch (item.Status)
                                {
                                    case 1:
                                        <TableRowCell class="tr-name">
                                            <button class="btn-action" type="button" @onclick="() => UpdateTicketStatus(item)">
                                                Update
                                            </button>
                                        </TableRowCell>
                                        break;
                                    case 2:
                                        <TableRowCell class="approved-waitlist">
                                            <button class="btn-approved" type="button" @onclick="() => UpdateTicketStatus(item)">
                                                Approved
                                            </button>
                                        </TableRowCell>
                                        break;
                                    case 3:
                                        <TableRowCell class="declined-waitlist">
                                            <button class="btn-declined" type="button" @onclick="() => UpdateTicketStatus(item)">
                                                Declined
                                            </button>
                                        </TableRowCell>
                                        break;
                                    default:
                                        break;
                                }
                               
                            </TableRow>
                        }
                    </TableBody>
                </Table>
                </LoadingIndicator>
            }
        </div>
    </div>
</div>


@if (WaitlistDetails != null)
{
    <Offcanvas @ref="offcanvas" Closing="OffCanvasClosing" ShowBackdrop Placement="Placement.End">
    <OffcanvasHeader class="px-0 py-4 bg-white-100">
        <div class="px-3 d-flex justify-content-between position-relative w-100">
            <img src="images/ote/tiny-clock.svg" alt="clock">
            <button class="btn-close" style="right: 0;" @onclick="CloseOffCanvas" />
        </div>
    </OffcanvasHeader>
    <OffcanvasBody class="px-0 pt-0">
        <Divider class="m-0" />
        <div class="details">
            <p class="title">Waitlist Approval</p>
            @switch (WaitlistDetails.Status)
            {
                case 1:
                    <p class="waitlist-status">Waitlist</p>
                break;
                case 2:
                    <p class="waitlist-approved">Approved</p>
                break;
                case 3:
                    <p class="waitlist-declined">Declined</p>
                break;
                default:
                break;
            }
        </div>
        <div class="customer-details">
            <img class="profile-img" src="@WaitlistDetails.CustomerProfile" />
            <div class="profile-details">
                <p class="name">@WaitlistDetails.CustomerName</p>
                <p class="name">@WaitlistDetails.CustomerEmail</p>
            </div>
        </div>
        <div class="registration">
            <p class="name">Event Date</p>
            <p class="reg-time">@WaitlistDetails.EventDate.ToString("MMM dd, hh:mm tt")</p>
            <p class="name">Order Details:</p>
            <div class="details-box">
                    <div class="ticket-purchase-details">
                        <p class="name">Ticket</p>
                        <p class="name">Total</p>
                    </div>
                    <Divider />
                    @foreach (var tix in ticketList)
                    {
                        <div class="ticket-purchase-details">
                            <p class="name">@tix.Name x @tix.Count</p>
                            <p class="name">@(tix.Price == 0 ? "Free" : WaitlistDetails.TicketPrice)</p>
                        </div>
                    }
            </div>
            @if(WaitlistDetails.Registrations.Count() != 0)
            {
                foreach (var reg in WaitlistDetails.Registrations)
                {
                    @if(!string.IsNullOrEmpty(reg.Question))
                    {
                        <div class="registration-section mt-1">
                            <p class="name">@reg.Question</p>
                            <MemoEdit @bind-Text="reg.Answer" Rows="3" ReadOnly/>
                        </div>
                    }
                }
            }
            <div class="d-flex mt-2 justify-content-center gap-1">
                @if(WaitlistDetails.Status == 1)
                {
                    <Button class="ticket-approve" Disabled="approving" 
                        Loading="approving" Clicked="ApprovedWaitlist">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Please wait
                        </LoadingTemplate>
                        <ChildContent>
                            Approve
                        </ChildContent>
                    </Button>
                    <Button class="ticket-decline" Clicked="DeclineWaitlist">
                        Decline
                    </Button>
                }
            </div>
        </div>
        <div class="timeline-section">
            <p class="timeline-title">Timeline</p>
                @if (WaitlistDetails.Status == 1)
                {
                    <ul>
                        <li class="name">
                            <span>Registered (Pending Approval)</span>
                            <br/>
                            <span>@WaitlistDetails.CreatedOn.ToString("MMM dd, hh:mm tt")</span>
                        </li>
                    </ul>
                }
                else if (WaitlistDetails.Status == 2)
                {
                    <ul>
                        <li class="name">
                            <span>Registered (Pending Approval)</span>
                            <br/>
                            <span>@WaitlistDetails.CreatedOn.ToString("MMM dd, hh:mm tt")</span>
                        </li>
                        <li class="name mt-2">
                            <span>Registered Approved from @EventName</span>
                            <br />
                            <span>@WaitlistDetails.ChangedOn.ToString("MMM dd, hh:mm tt")</span>
                        </li>
                    </ul>
                }
                else
                {
                    <ul>
                        <li class="name">
                            <span>Registered (Pending Approval)</span>
                            <br />
                            <span>@WaitlistDetails.CreatedOn.ToString("MMM dd, hh:mm tt")</span>
                        </li>
                        <li class="name mt-2">
                            <span>Registered Declined from @EventName</span>
                            <br />
                            <span>@WaitlistDetails.ChangedOn.ToString("MMM dd, hh:mm tt")</span>
                        </li>
                    </ul>
                }

        </div>
    </OffcanvasBody>
    </Offcanvas>
}

@code 
{
        [Parameter]
        public IEnumerable<OteSchedule> OteTickets { get; set; }

        [Parameter]
        public string Token { get; set; }

        [Parameter]
        public int ProviderId { get; set; }

        [Parameter]
        public int ActivityId { get; set; }

        [Parameter]
        public string EventName { get; set; }

        [Parameter]
        public int DateId { get; set; }

    public List<OteTicket> ExportCustomer = new List<OteTicket>();

    public List<OteWaitlist> OteWaitlist = new List<OteWaitlist>();

    public OteWaitlist WaitlistDetails { get; set; }

    public List<TicketDetails> ticketList = new List<TicketDetails>();

    private Offcanvas? offcanvas;

    private bool approving = false;

    LoadingIndicator loadingIndicator;

    IJSObjectReference module;

    protected override async Task OnInitializedAsync()
    {
        await GetWaitlist();
        foreach (var item in OteWaitlist)
        {
            var deserializedPayload = JsonConvert.DeserializeObject<Payload>(item.Payload);
            if (deserializedPayload != null)
            {
                var ticketNames = new List<string>();
                foreach (var ticket in deserializedPayload.Tickets)
                {
                    // Get Ticket Details
                    item.EventDate = ticket.Date;
                    //Total Price
                    item.TicketPrice += ticket.Price;
                    ticketNames.Add(ticket.Name);
                }
                //Questions and Answer
                if(deserializedPayload.Questions.Count() != 0)
                {
                    item.Registrations.AddRange(deserializedPayload.Questions.Select(reg => new Models.Ote.OteWaitlist.Registration
                    {
                        Answer = reg.Answer,
                        Question = reg.Question
                    }));
                }
                item.TicketName = ticketNames.Count > 1 ? string.Join(", ", ticketNames) : ticketNames.FirstOrDefault();
            }
            else
            {
                Console.WriteLine($"Payload is null for item with ID: {item.Id}");
            }
        }
    } 


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/exportToExcel.js");
        }
    }
    public class Payload
    {
        public IEnumerable<TicketDetails> Tickets { get; set; }
        public IEnumerable<QuestionDetails> Questions { get; set; }
    }

    public class TicketDetails
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public double Price { get; set; }
        public int OteDateId { get; set; }
        public DateTime Date { get; set; }
        public int Count { get; set; }
    }

    public class QuestionDetails
    {
        public string Question { get; set; }
        public string Answer { get; set; }
    }

    private Task OnPendingWaitlistClick()
    {
        return ShowOffcanvas();
    }

    private Task OffCanvasClosing(OffcanvasClosingEventArgs e)
    {
        WaitlistDetails = new OteWaitlist();
        e.Cancel = !(e.CloseReason == CloseReason.UserClosing);
        return Task.CompletedTask;
    }

    private Task ShowOffcanvas()
    {
        return offcanvas?.Show();
    }

    private Task CloseOffCanvas()
    {
        WaitlistDetails = new OteWaitlist();
        return offcanvas.Close(CloseReason.UserClosing);
    }

    public async Task UpdateTicketStatus(OteWaitlist waitlist)
    {
        ticketList.Clear();
        WaitlistDetails = waitlist;
        //Deserialize Payload Ticket Details
        var deserializedPayload = JsonConvert.DeserializeObject<Payload>(waitlist.Payload);
        WaitlistDetails.EventDate = deserializedPayload.Tickets.FirstOrDefault().Date;
        if (deserializedPayload != null)
        {
            foreach (var ticket in deserializedPayload.Tickets)
            {
                ticketList.Add(ticket);
            }
        }
        //Get Customer Details
        var result = await accountApiHandler.GetCustomerById(waitlist.CustomerId);
        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            waitlist.CustomerProfile = result.Result.Result.ProfileImg;
            waitlist.CustomerEmail = result.Result.Result.Email;
        }
        await OnPendingWaitlistClick();
    }

    public async Task ApprovedWaitlist()
    {
        approving = true;

        var approveWaitlist = await activityApiHandler.ApprovedWaitList(new Framework.ApiCommand.ApiCore.Activity.Request.ApprovedWaitListArgs {
            WaitListId = WaitlistDetails.Id
        }, Token);

        approving = false;

        if (approveWaitlist.Succeeded && approveWaitlist.Result is not null && approveWaitlist.Result.IsSuccess)
        {
            await OnInitializedAsync();
            await CloseOffCanvas();
            await NotificationService.Success("Successfully approved waitlist.", "Success");
        }
    }

    public async Task DeclineWaitlist()
    {
        var approveWaitlist = await activityApiHandler.UpdateOteWaitlist(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteWaitlistArgs
            {
                Id            = WaitlistDetails.Id,
                ActivityId    = WaitlistDetails.ActivityId,
                ScheduleId    = WaitlistDetails.ScheduleId,
                CustomerId    = WaitlistDetails.CustomerId,
                CustomerName  = WaitlistDetails.CustomerName,
                CustomerEmail = WaitlistDetails.CustomerEmail,
                ProviderId    = WaitlistDetails.ProviderId,
                EventDate     = WaitlistDetails.EventDate,
                Status        = 3,
                Payload       = WaitlistDetails.Payload
            }, Token);
        if (approveWaitlist.Succeeded && approveWaitlist.Result is not null && approveWaitlist.Result.IsSuccess)
        {
            await OnInitializedAsync();
            await CloseOffCanvas();
            await NotificationService.Error("Successfully declined waitlist.", "Success");
        }
    }
    private async Task GetWaitlist()
    {
        var waitlists = await activityApiHandler.GetOteWaitlistByProvider(new Framework.ApiCommand.ApiCore.Activity.Request.GetOteWaitlistByProviderArgs
        {
            ProviderId = ProviderId,
            ActivityId = ActivityId,
            Status = new[] {1,2,3},
            OteDateId = DateId
        }, Token);
        if (waitlists.Succeeded && waitlists.Result is not null && waitlists.Result.IsSuccess)
        {
            OteWaitlist = waitlists.Result.Result.Select(e =>
            {
                // Deserialize Payload (assuming Payload is a JSON string)
                var payload = JsonConvert.DeserializeObject<Payload>(e.Payload);
                // Get Amount
                var ticketAmount = payload?.Tickets?.Sum(a => a.Price) ?? 0;

                return new OteWaitlist
                {
                    Id           = e.Id,
                    ActivityId   = e.ActivityId,
                    CustomerId   = e.CustomerId,
                    CustomerName = e.CustomerName,
                    Payload      = e.Payload,
                    ProviderId   = e.ProviderId,
                    ScheduleId   = e.ScheduleId,
                    Status       = e.Status,
                    ChangedOn    = e.ChangedOn,
                    CreatedOn    = e.CreatedOn,
                    TicketPrice  = ticketAmount
                };
            }).Where(a => a.Status != 2 && a.TicketPrice > 0)
            .OrderByDescending(a => a.CreatedOn).ToList();
        }
    }
    private async Task ExportToExcel()
    {
        await loadingIndicator.Show();
        await Task.Delay(1000);
        var waitlists = await activityApiHandler.GetOteWaitlistByProvider(new Framework.ApiCommand.ApiCore.Activity.Request.GetOteWaitlistByProviderArgs
            {
                ProviderId = ProviderId,
                ActivityId = ActivityId,
                Status = new[] { 1, 2, 3 },
                OteDateId = DateId
            }, Token);
        if (waitlists.Succeeded && waitlists.Result is not null && waitlists.Result.IsSuccess)
        {
            ExportCustomer = waitlists.Result.Result.Select(e =>
            {
                // Deserialize Payload (assuming Payload is a JSON string)
                var payload = JsonConvert.DeserializeObject<Payload>(e.Payload);

                // Get Registration from QuestionDetails
                var registration = string.Join(", ", payload?.Questions?.Select(q => $"{q.Question}: {q.Answer}") ?? new List<string>());

                // Get ticket count
                var ticketCount = payload?.Tickets?.Sum(a => a.Count) ?? 0;

                // Get Ticket Name
                var ticketName = string.Join(", ", payload?.Tickets?.Select(a => a.Name) ?? Enumerable.Empty<string>()) ?? "Unnamed Ticket";

                // Get Amount
                var ticketAmount = payload?.Tickets?.Sum(a => a.Price) ?? 0;

                // Get Date, ensure it's not null
                var ticketDate = payload?.Tickets?.FirstOrDefault()?.Date ?? DateTime.MinValue; // Use DateTime.MinValue as a default

                return new OteTicket
                    {
                        Id           = e.Id,
                        Title        = ticketName,
                        Amount       = Convert.ToDecimal(ticketAmount),
                        Status       = e.Status == 1 ? "Pending" : e.Status == 2 ? "Approved" : e.Status == 3 ? "Declined" : "Unknown", 
                        Payload      = e.Payload,
                        CustomerName = e.CustomerName,
                        Date         = Convert.ToDateTime(ticketDate),
                        Quantity     = ticketCount,
                        Registration = registration
                    };
            }).Where(s => s.Status != "Approved" && s.Amount > 0)
            .OrderBy(a => a.Id).ToList();
        }
        using (var workbook = new XLWorkbook("wwwroot/Template/WaitListTemplate.xlsx"))
        {
            var worksheet = workbook.Worksheet(1);
            int startRow = 3;
            foreach (var item in ExportCustomer)
            {
                worksheet.Cell(1, 1).Value = EventName;
                worksheet.Cell(1, 8).Value = $"Date: {DateTime.Today.ToString("MMMM dd, yyyy")}";
                worksheet.Cell(startRow, 1).Value = item.Id;
                worksheet.Cell(startRow, 2).Value = $"{item.CustomerName}";
                worksheet.Cell(startRow, 3).Value = $"{item.Date}";
                worksheet.Cell(startRow, 4).Value = $"{item.Title}";
                worksheet.Cell(startRow, 5).Value = $"{item.Quantity}";
                worksheet.Cell(startRow, 6).Value = $"{item.Amount}";
                worksheet.Cell(startRow, 7).Value = $"{item.Status}";
                worksheet.Cell(startRow, 8).Value = $"{item.Registration}";
                startRow++;
            }
            using (var memoryStream = new MemoryStream())
            {
                workbook.SaveAs(memoryStream);
                memoryStream.Seek(0, SeekOrigin.Begin);

                var currentDate = DateTime.Now.ToString("yyyyMMddHHmmss");
                var fileName = $"WaitList_{currentDate}.xlsx";
                byte[] bytes = memoryStream.ToArray();

                var bytesBase64 = Convert.ToBase64String(bytes);

                // Download the saved memorystream file
                await Task.Run(() => module.InvokeVoidAsync("saveAsFile", fileName, bytesBase64));
            }
        }
        await loadingIndicator.Hide();
    }
}

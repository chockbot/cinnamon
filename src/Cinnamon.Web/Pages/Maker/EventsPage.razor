@layout DashboardLayout
@page "/maker/dashboard/events"
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Framework.ValidationAttributes;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Framework.Enums
@inject IActivityApiHandler activityApiHandler;
@inject ITransactionApiHandler transactionApiHandler
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject NavigationManager NavigationManager;
@attribute [Authorize]
<PageTitle>Coupons | CinnamonPH</PageTitle>
<SeoMeta Title="Coupons" Subject="Dashboard" Url="/maker/dashboard/coupons" />


<div class="maker-events-wrapper">
    <div class="header">
        <p class="title">My Events</p>
    </div>
    <div class="section-content">
        @for (var i = 0; i < OTEActivities.Count; i += 2)
        {
            <div class="row event-row">
                <div class="col-5 event-wrapper">
                    <div class="event-content d-flex">
                        <img class="event-image" src="@(OTEActivities[i].Images.Count > 0 ? OTEActivities[i].Images.ElementAt(0).ImageSrc : string.Empty)" />
                        <div class="event-details">
                            <p class="event-title">@OTEActivities[i].Title</p>
                            <p class="event-schedule">20 May 2023 | 06:00PM</p>
                            <p class="event-location">Waterfront Hotel & Casino, Cebu City</p>
                            <button class="view-details">View Details</button>
                        </div>
                    </div>
                    <div class="ticket-details">
                        <p class="ticket-slots">Slots: 60</p>
                        <p class="ticket-sold">Sold: 20</p>
                        <p class="ticket-available">Available: 40</p>
                    </div>
                </div>
                @if (i + 1 < OTEActivities.Count)
                {
                    <div class="col-5 event-wrapper">
                        <div class="event-content d-flex">
                            <img class="event-image" src="@(OTEActivities[i + 1].Images.Count > 0 ? OTEActivities[i + 1].Images.ElementAt(0).ImageSrc : string.Empty)" />
                            <div class="event-details">
                                <p class="event-title">@OTEActivities[i + 1].Title</p>
                                <p class="event-schedule">20 May 2023 | 06:00PM</p>
                                <p class="event-location">Waterfront Hotel & Casino, Cebu City</p>
                                <button class="view-details">View Details</button>
                            </div>
                        </div>
                        <div class="ticket-details">
                            <p class="ticket-slots">Slots: 60</p>
                            <p class="ticket-sold">Sold: 20</p>
                            <p class="ticket-available">Available: 40</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
@code {
    public List<Activity> activities = new List<Activity>();
    public List<Activity> OTEActivities = new List<Activity>();
    private string Token = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");
            if (Token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }
            var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
                {
                    IncludeActivityImages = true,
                    IncludeStudents = true,
                    IncludeAtivitySchedules = true
                }, Token);

            if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
            {
                activities = activityRes.Result.Result.OrderBy(a => a.ActivityId).Select(a =>
                {
                    // map only required fields
                    return new Activity
                        {
                            ActivityId = a.ActivityId,
                            IsPublished = a.IsPublished,
                            Title = a.Title,
                            Description = a.Description,
                            ExperienceTypeId = a.ExperienceTypeId,
                            ExperienceCreationType = a.ExperienceCreationType,
                            Handler = a.Handler,
                            Images = a.Images.Select(i =>
                            {
                                    return new ActivityImage
                                    {
                                        Id = i.Id,
                                        ImageSrc = i.ImageSrc,
                                        Name = i.Name
                                    };
                                }).ToList(),
                            Status = a.Status,
                        };
                }).ToList();
            }
            OTEActivities = activities.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.OneTimeEvents).ToList();
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
}

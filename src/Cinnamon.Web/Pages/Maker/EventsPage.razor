@layout DashboardLayout
@page "/maker/dashboard/events"
@using System.Security.Claims
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Framework.ValidationAttributes;
@inject IActivityApiHandler activityApiHandler;
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject NavigationManager NavigationManager;
@attribute [Authorize]
<PageTitle>Coupons | CinnamonPH</PageTitle>
<SeoMeta Title="Coupons" Subject="Dashboard" Url="/maker/dashboard/coupons" />


<div class="maker-events-wrapper">
    <div class="header">
        <p class="title">My Events</p>
    </div>
    <div class="section-content">
        
    </div>
</div>
@code {
    private string Token = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");
            if (Token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }
        }
        catch (Exception ex)
        {
            throw ex;
        }
    }
}

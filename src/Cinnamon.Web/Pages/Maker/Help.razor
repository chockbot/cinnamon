@code {
	private bool isFaqDisplayed = false;
	private bool isTermsDisplayed = false;
	private bool isPrivacyDisplayed = false;

	protected override async Task OnInitializedAsync()
	{
		isFaqDisplayed = true;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await jsRuntime.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiperHelpPage", ".schedule-swiper");
		}
	}

	private void NavigateToFaq()
	{
		isFaqDisplayed = true;
		isTermsDisplayed = false;
		isPrivacyDisplayed = false;
	}

	private void NavigateToTerms()
	{
		isFaqDisplayed = false;
		isTermsDisplayed = true;
		isPrivacyDisplayed = false;
	}

	private void NavigateToPrivacy()
	{
		isFaqDisplayed = false;
		isTermsDisplayed = false;
		isPrivacyDisplayed = true;
	}
}

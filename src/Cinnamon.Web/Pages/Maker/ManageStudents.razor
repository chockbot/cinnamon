@layout DashboardLayout
@page "/maker/dashboard/managestudents"
@using System.Security.Claims
@using System.Globalization
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@using Blazorise.DataGrid

<section class="mt-5 maker-dashboard">
        <div class="container">
        <Row>
            <Column>
                <h3 class="text-capitalize fw-bold" style="color:#FFA942;">Manage Students</h3>
            </Column>
            <Column class="justify-content-end">
                <TextEdit Text="@customFilterValue" Placeholder="Search" TextChanged="@OnCustomFilterValueChanged" class="search-bar"></TextEdit>
            </Column>
            <Column class="justify-content-start">
                <Select TValue="string" class="dropdown-select" SelectedValue="@selectedFilter" SelectedValueChanged="@OnFilterValueChanged">
                    <SelectItem Value="@("*")">Select Experience</SelectItem>
                    @foreach(var item in subCategories)
                    {
                        <SelectItem Value="@(item.Name)">@item.Name</SelectItem>
                    }
                </Select>
            </Column>
        </Row>
        <DataGrid @ref="dataGrid" 
            TItem="SubCategory" 
            Data="@subCategories"
            @bind-SelectedRow="@selectedSubCategory"
            Responsive CustomFilter="@OnCustomFilter" 
            ShowPager 
            Editable="true"
            class="datagrid-data">
            <DataGridColumns>
                 <DataGridColumn Field="@nameof(SubCategory.Name)" Caption="Name" Sortable="false" />
                 <DataGridColumn Caption="Session Attended">
                     <DisplayTemplate>
                         <Progress>
                             <ProgressBar Color="Color.Success" Value=2 Max=10 />
                         </Progress>
                     </DisplayTemplate>
                 </DataGridColumn>
                 <DataGridColumn Field="@nameof(SubCategory.Name)" Caption="Experience"/>
                <DataGridColumn TItem="SubCategory" Field="Name" Caption="Remarks" Editable="true">
                    <DisplayTemplate>
                       @context.Name
                    </DisplayTemplate>
                <EditTemplate>
                         <TextEdit TValue="string"
                          Text="@((string)context.CellValue)"
                          TextChanged="@( v => {context.CellValue = v;context.UpdateCell( nameof( SubCategory.Name ), v);})" />
                </EditTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="SubCategory" Field="Id" Caption="Student No." Editable="true">
                    <DisplayTemplate>
                        @context.Id
                    </DisplayTemplate>
                 <EditTemplate>
                         <NumericEdit TValue="int"
                          Value="@((int)context.CellValue)"
                          ValueChanged="@( v => {context.CellValue = v;context.UpdateCell( nameof( SubCategory.Id ), v);})" />
                </EditTemplate>
                </DataGridColumn>
                <DataGridCommandColumn TItem="SubCategory" Caption="Student Details">
                    <EditCommandTemplate>
                        <Button Color="Color.Primary" Border="Border.Is0" Clicked="@context.Clicked">
                            Edit <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" />
                        </Button>
                    </EditCommandTemplate>
                    <NewCommandTemplate>
                    </NewCommandTemplate>
                    <DeleteCommandTemplate>
                    </DeleteCommandTemplate>
                </DataGridCommandColumn>
                <DataGridColumn Caption="Attendance">
                      <DisplayTemplate>
                         <Button Color="Color.Primary" Border="Border.Is0" Clicked="@Update">Update</Button>
                      </DisplayTemplate>                
                 </DataGridColumn>
            </DataGridColumns> 
        </DataGrid>
    </div>
</section>

@code {

    private Models.Customer.Profile Model; 

    public List<SubCategory> subCategories = new List<SubCategory>();

    private SubCategory selectedSubCategory;

    private string customFilterValue;

    private string selectedFilter;

    private string studentRemark = "Enter remarks here...";

    private float studentNo = 0;

    private bool isEditStudentNo = false;

    private bool isEditRemarks = false;

    public TextEdit textEdit;

    private DataGrid<SubCategory> dataGrid;

    protected override async Task OnInitializedAsync()
    {
        var sub = await activityApiHandler.GetSubCategories();
        if (sub.Succeeded && sub.Result != null && sub.Result.IsSuccess)
        {
            subCategories = sub.Result.Result.Select(s =>
            {
                return new SubCategory
                    {
                        Id = s.Id,
                        Name = s.Name,
                        CategoryId = s.CategoryId
                    };
            }).ToList();
        }
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer = result.Result.Result;

        // check if customer is maker
        if (!customer.IsMaker)
        {
            // account is not maker redirect to explore page
            NavigationManager.NavigateTo("explore");
            return;
        }
        Model = new Models.Customer.Profile
            {
                Token = token,
                CustomerProfile = new Models.Entities.CustomerProfile
                {
                    About = customer.About,
                    Birthdate = customer.Birthdate,
                    Email = customer.Email,
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    Id = customer.Id,
                    IsMaker = customer.IsMaker,
                    IsVerified = customer.IsVerified,
                    ProfilePath = customer.ProfileImg,
                },
            };
    }

    private Task OnCustomFilterValueChanged(string e)
    {
        customFilterValue = e;
        return dataGrid.Reload();
    }
    private async Task OnFilterValueChanged(string e)
    {
        selectedFilter = e;
        if (string.IsNullOrEmpty(selectedFilter) || selectedFilter == "Select Experience" || selectedFilter == "*")
        {
            var sub = await activityApiHandler.GetSubCategories();
            if (sub.Succeeded && sub.Result != null && sub.Result.IsSuccess)
            {
                subCategories = sub.Result.Result.Select(s =>
                {
                    return new SubCategory
                        {
                            Id = s.Id,
                            Name = s.Name,
                            CategoryId = s.CategoryId
                        };
                }).ToList();
            }
        }
        else
        {
            subCategories = subCategories.Where(p => CultureInfo.CurrentCulture.CompareInfo.IndexOf(p.Name,
            selectedFilter, CompareOptions.IgnoreCase) >= 0).ToList();
        }
        await dataGrid.Reload();
    }
    private bool OnCustomFilter(SubCategory model)
    {
        if (string.IsNullOrEmpty(customFilterValue))
            return true;
        return model.Name?.Contains(customFilterValue, StringComparison.OrdinalIgnoreCase) == true;
    }
    private async Task OnEditRemarksClick()
    {
        await textEdit.Focus();
    }
    public async Task Update()
    {
        
    }
}


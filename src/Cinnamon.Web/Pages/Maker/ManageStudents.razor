@layout DashboardLayout
@page "/maker/dashboard/managestudents"
@using Cinnamon.Web.Models.Dashboard
@using System.Security.Claims
@using System.Globalization
@using Cinnamon.Framework.Enums
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Models.Maker
@using Cinnamon.Web.Components.Pages
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject IDirectStudentApiHandler directStudentApiHandler;
@using Blazorise.DataGrid
@attribute [Authorize]

<PageTitle>Student Management | CinnamonPH</PageTitle>
<SeoMeta Title="Student Management" Subject="Student Management" Url="/maker/dashboard/managestudents" />

@if(Model != null)
{
<section class="mt-5 maker-dashboard">
    <div class="header">
        <h3 class="text-capitalize fw-bold header-title" style="color:#343D4C;">Manage Students</h3>
    </div>
    <div class="header-filters-section">
        <div class="header-filters">
                <Select TValue="int" class="dropdown-select-search" SelectedValue="@Model.searchBy" SelectedValueChanged="@((value) => OnSeachByValueChange(value))">
                    <SelectItem Value="0">Search By</SelectItem>
                    <SelectItem Value="1">Name</SelectItem>
                    <SelectItem Value="2">Ongoing</SelectItem>
                    <SelectItem Value="3">Completed</SelectItem>

                </Select>
                @if (Model.isDisplay == true)
                {
                    <TextEdit Placeholder="Search by Name" TextChanged="@TextSearchChanged" class="search-bar"></TextEdit>
                }
                <Select TValue="int" class="dropdown-select" SelectedValue="@Model.selectedFilter" SelectedValueChanged="@((value) => OnFilterValueChanged(value))">
                    <SelectItem Value="0">Select Experience</SelectItem>
                    @foreach (var item in Model.activities.OrderBy(a => a.Title))
                    {
                        <SelectItem Value="@(item.ActivityId)">@item.Title</SelectItem>
                    }
                </Select>
        </div>
        <div class="add-enrollee">
            <button class="btn-enrollee" @onclick="@(() => NavigateToEnrolleeMasterlist())">Direct Enrollee Masterlist</button>
        </div> 
    </div>
    <LoadingIndicator @ref=loadingIndicator>
        <div class="student-attendance-section">
                <div class="table-list">
                    <Table @ref="tableStudents" Shadow="Shadow.Default" Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell class="name-header">
                                <label class="sotring-column" @onclick="SortByName">
                                    Name
                                    <img src="images/Dashboard/sortingArrow.png" alt="sorting-arrow">
                                </label>
                            </TableHeaderCell>
                            <TableHeaderCell class="sessions-attended-header col-lg-2 col-md2">
                                <label class="sotring-column">
                                    Completion Date
                                </label>
                            </TableHeaderCell>
                            <TableHeaderCell class="sessions-attended-header col-lg-2 col-md2">
                                <label class="sotring-column">
                                    Sessions Attended
                                </label>
                            </TableHeaderCell>
                            <TableHeaderCell>
                                <label class="sotring-column" @onclick="SortByActivity">
                                    Experience
                                    <img src="images/Dashboard/sortingArrow.png" alt="sorting-arrow">
                                </label>
                            </TableHeaderCell>
                            <TableHeaderCell Class="student-no-header col-lg-2 col-md2">
                                <label class="sotring-column">
                                    Student No.
                                    <img src="images/Dashboard/sortingArrow.png" alt="sorting-arrow">
                                </label>
                            </TableHeaderCell>
                            <TableHeaderCell class="attendance-header col-lg-2 col-md2">
                                <label class="sotring-column">
                                    Attendance
                                </label>
                            </TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var item in Model.FilteredStudents)
                            {
                                <TableRow>
                                    <TableRowCell class="name-body">@item.Name</TableRowCell>
                                    <TableRowCell class="completion-date-body">
                                        <center>
                                            @if (item.SessionsAttended >= item.NumberOfSessions)
                                            {
                                                @item.LastAttendance.ToString("MMMM dd, yyyy")
                                            }
                                            else
                                            {
                                                if ((item.ExpirationDateEnd < DateTime.Now.Date && item.HasExpiration == 1) || (item.ExpirationDateEnd < DateTime.Now.Date && item.HasExpiration == 2) && item.ExpirationDateEnd != DateTime.MinValue)
                                                {
                                                    <p>@item.ExpirationDateEnd.AddDays(1).ToString("MMMM dd, yyyy") <span class="expired-session">Expired</span></p>
                                                }
                                                else
                                                {
                                                    string ongoing = "Ongoing";
                                                    @ongoing
                                                }
                                            }
                                        </center>
                                    </TableRowCell>
                                    <TableRowCell class="progress-body">
                                        <center>
                                            @if (item.SessionsAttended > item.NumberOfSessions)
                                            {
                                                <CircularProgress Id='@($"progress-{item.Id}")' Size="50" PieColor="red"
                                                      Percentage="GetSessionPercentage(item.NumberOfSessions, item.SessionsAttended)">
                                                    @($"{item.SessionsAttended}/{item.NumberOfSessions}")
                                                </CircularProgress>
                                            }
                                            else
                                            {
                                                <CircularProgress Id='@($"progress-{item.Id}")' Size="50" PieColor="#4bb749"
                                                      Percentage="GetSessionPercentage(item.NumberOfSessions, item.SessionsAttended)">
                                                    @($"{item.SessionsAttended}/{item.NumberOfSessions}")
                                                </CircularProgress>
                                            }
                                        </center>
                                    </TableRowCell>
                                    <TableRowCell class="experience-body">@item.Title</TableRowCell>
                                    <TableRowCell class="student-no">
                                        @item.StudentNo
                                        &nbsp;<Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3" Clicked="() => ShowModal(item)">
                                            <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" style="color:#343D4C99;line-height:20px" class="btn-edit" />
                                        </Button>
                                    </TableRowCell>
                                    <TableRowCell class="update">
                                        <Button Color="Color.Primary" Border="Border.Is0" Clicked="() => ViewAttendence(item)" class="btn-update">
                                            Update
                                        </Button>
                                    </TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    <Pagination Class="pagination-section" Style="margin-top: 20px;">
                        <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
                            <PaginationLink>
                                <span aria-hidden="true">«</span>
                            </PaginationLink>
                        </PaginationItem>
                        @{
                            for (var i = 1; i <= Pagination.TotalPages; i++)
                            {
                                var pageNumberAsString = i.ToString();
                                <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                                    <PaginationLink Page="@pageNumberAsString" Clicked="SetActive">
                                        @pageNumberAsString
                                    </PaginationLink>
                                </PaginationItem>
                            }
                        }
                        <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next">
                            <PaginationLink>
                                <span aria-hidden="true">»</span>
                            </PaginationLink>
                        </PaginationItem>
                    </Pagination>
                </div>
            </div>
    </LoadingIndicator>
</section>

    
<Modal @ref="modalRef">
    <ModalContent Centered Size="ModalSize.Small">
        <ModalHeader>
            <h6 class="col-11 modal-title text-center" style="font-weight:bold">Student Number</h6>
            <button type="button" class="btn-close" @onclick="() => HideModal()" />
        </ModalHeader>
        <ModalBody>
            <Label Visibility="Visibility.Invisible">@Model.Id</Label>
            <input type="number" class="form-control" placeholder="Enter Number" required max="999" min="0" maxlength="3" @bind="@Model.jerseyNumber" onkeypress="if(this.value.length > 2) return false;" />
            <Button Color="Color.Primary" TextColor="TextColor.White" Width="Width.Is100" Size="Size.Large" Border="Border.Is0" Type="ButtonType.Submit" Loading="isLoading" 
                Clicked="() => SaveChanges(Model.Id, Model.jerseyNumber, Model.StudentType)">
                <LoadingTemplate>
                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                    Saving
                </LoadingTemplate>
                <ChildContent>
                    Save
                </ChildContent>
            </Button>
            @*<Button Color="Color.Primary" Border="Border.Is0" Clicked="() =>SaveChanges(Id, jerseyNumber)" class="btn-save">Save Changes</Button>*@
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="modalRefViewSchedule">
    <ModalContent Centered Size="ModalSize.Large">
        <ModalHeader>
            <h6 class="col-11 modal-title text-center" style="font-weight:bold">Activity Schedules</h6>
            <button type="button" class="btn-close" @onclick="() => HideViewScheduleModal()" />
        </ModalHeader>
        <ModalBody>
            <Table Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                <TableHeader>
                    <TableRow>
                        <TableHeaderCell class="name-header">
                            Name
                        </TableHeaderCell>
                        <TableHeaderCell class="sessions-attended-header col-lg-2 col-md2">
                            Schedule
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Price
                        </TableHeaderCell>
                        <TableHeaderCell Class="student-no-header col-lg-2 col-md2">
                            Set Inactive/Active
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var schedule in activitySchedules)
                    {
                        <TableRow>
                            <TableRowCell class="name-body">@schedule.Name</TableRowCell>
                            <TableRowCell class="name-body">@schedule.DateTime</TableRowCell>
                            <TableRowCell class="name-body">@schedule.UnitPrice @Math.Truncate(schedule.Price) / @schedule.PerUnit1 @schedule.PriceUnit1 / @schedule.PerUnit2 @schedule.PriceUnit2</TableRowCell>
                            <TableRowCell class="name-body">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" checked="@(schedule.IsActiveSchedule == true)" @onchange="((e) => UpdateSchedule(e, schedule))">
                                </div>
                            </TableRowCell>

                        </TableRow>
                    }
                </TableBody>
            </Table>
        </ModalBody>
    </ModalContent>
</Modal>
}
@if (Model.showErrorMessage)
{
    <div class="alert alert-danger alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Error!</strong> @Model.errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.showSuccessMessage)
{
    <div class="alert alert-success alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
        <strong>Success!</strong> Student number updated!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@code 
{

    private ManageStudentsModel Model { get; set; } = new();
    LoadingIndicator loadingIndicator;
    public Modal modalRef;
    public Modal modalRefViewSchedule;
    public Table tableStudents;
    private List<ActivitySchedule> activitySchedules = new List<ActivitySchedule>();
    string token = string.Empty;
    private bool isLoading = false;
    public const string PREVIOUS = "previous";
    public const string NEXT = "next";
    public int UserId { get; set; }
    public int SearchBy { get; set; } = 0;
    public string SearchValue { get; set; } = string.Empty;
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
            {
                // an error occured
                NavigationManager.NavigateTo("explore");
                return;
            }
            else
            {
                UserId = result.Result.Result.Id;
            }
            if (!result.Result.Result.IsMaker)
            {
                // should not able to access the page
                NavigationManager.NavigateTo("explore");
                return;
            }

            await GetActivities();
            await GetStudents(1);
        }
        catch (Exception)
        {
            Model.showErrorMessage = true;
            Model.errorMessage = "An error occured. Please try again later.";
        }

    }

    public void ViewAttendence(ManageStudentsData data)
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents/" + data.Id +"/"+ data.StudentType);
    }

    private void ShowModal(ManageStudentsData data)
    {
        modalRef.Show();
        Int32.TryParse(data.StudentNo, out Model.jerseyNumber);
        Model.Id = data.Id;
        Model.StudentType = data.StudentType;
    }

    private Task HideModal()
    {
        return modalRef.Hide();
    }
    
    private Task HideViewScheduleModal()
    {
        return modalRefViewSchedule.Hide();
    }

    private async Task OnFilterValueChanged(int activityId)
    {
        Model.selectedFilter = activityId;
        if (Model.selectedFilter == 0)
        {
            SearchBy = 0;
            await GetStudents(1);
        }
        else
        {
            SearchBy = 4;
            await GetStudents(1);
        }
    }

    private async Task OnSeachByValueChange(int selectedId)
    {
        SearchBy = selectedId;
        switch (SearchBy)
        {
            case 0:
                Model.isDisplay = false;
                await GetStudents(1);
                break;
            case 1:
                Model.isDisplay = true;
                break;
            case 2:
                Model.isDisplay = false;
                await GetStudents(1);
                break;
            case 3:
                Model.isDisplay = false;
                await GetStudents(1);
                break;
            default:
                Model.isDisplay = true;
                break;
        }
    }

    private async Task TextSearchChanged(string search)
    {
        SearchValue = search;
        SearchBy = 1;
        await GetStudents(1);
    }

    private async void SaveChanges(int Id, int StudentNo, StudentType studentType)
    {
        await ShowLoading();

        var result = string.Format("{0:00}", StudentNo);

        if(studentType == StudentType.Cinnamon)
        {
            var update = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
            {
                Id = Id,
                StudentNo = result
            });

            if ((!update.Succeeded || update.Result == null) || (update.Succeeded && !update.Result.IsSuccess))
            {
                Model.errorMessage = update.Result?.ErrorInfo?.Message ?? update.Message;
                Model.showErrorMessage = true;
            }
        }

        if(studentType == StudentType.Manual)
        {
            var updateRes = await directStudentApiHandler.UpdateStudent(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs {
                DirectStudentSessions = new List<Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs.UpdateDirectStudentSession> {
                    new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs.UpdateDirectStudentSession {
                        Id = Id,
                        StudentNo = result
                    },
                }
            }, token);

            if (!updateRes.Succeeded || updateRes.Result == null || !updateRes.Result.IsSuccess)
            {
                Model.errorMessage = updateRes.Result?.ErrorInfo?.Message ?? updateRes.Message;
                Model.showErrorMessage = true;
            }
        }

        await HideModal();
        await HideLoading();

        await GetStudents(1);

        StateHasChanged();
    }

    private async Task GetStudents(int pageIndex)
    {
        //Get Enrolled Students
        var result = await dashboardApiHandler.GetEnrolledStudentsByProvider(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetEnrolledStudentsByProviderArgs
        {
            ProviderId   = UserId,
            CountPerPage = 20,
            PageIndex    = pageIndex,
            SearchBy     = SearchBy,
            SearchValue  = SearchValue,
            ActivityId   = Model.selectedFilter
        }, token);

        Model.manageStudents = result.Result.Result.Select(s =>
        {
            return new ManageStudentsData
            {
                Id                  = s.Id,
                ActivityId          = s.ActivityId,
                ScheduleId          = s.ScheduleId,
                Name                = s.Name,
                Title               = s.ActivityName,
                StudentNo           = s.StudentNo,
                Remarks             = s.Remarks,
                SessionsAttended    = s.SessionsAttended,
                NumberOfSessions    = s.NumberOfSessions,
                ExpirationDateStart = s.ExpirationStartDate,
                ExpirationDateEnd   = s.ExpirationEndDate,
                HasExpiration       = s.HasExpiration,
                LastAttendance      = s.LastAttendance,
                StudentType         = s.StudentType
            }; 
        }).ToList();

        Pagination = result.Result.Pagination;
        Model.FilteredStudents = Model.manageStudents;
    }

    private async Task GetActivities()
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
            {
                IncludeAtivitySchedules = true,
                IsActive = true
            }, token);
        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            Model.activities = activityRes.Result.Result.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience).OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title
                    };
            }).ToList();
        }
    }

    private void SortByName()
    {
        loadingIndicator.Show();
        if (!Model.IsSortNameAsc.HasValue || Model.IsSortNameAsc.Value)
        {
            Model.FilteredStudents = Model.manageStudents.OrderBy(s => s.Name).ThenBy(a => a.SessionsAttended >= a.NumberOfSessions).ThenBy(x => x.ExpirationDateStart).ToList();
            Model.IsSortNameAsc = false;
        }
        else
        {
            Model.FilteredStudents = Model.manageStudents.OrderByDescending(s => s.Name).ThenBy(a => a.SessionsAttended >= a.NumberOfSessions).ThenBy(x => x.ExpirationDateStart).ToList();
            Model.IsSortNameAsc = true;
        }
        loadingIndicator.Hide();
    }

    private void SortByActivity()
    {
        loadingIndicator.Show();
        if (!Model.IsSortExperienceAsc.HasValue || Model.IsSortExperienceAsc.Value)
        {
            Model.FilteredStudents = Model.manageStudents.OrderBy(s => s.Title).ThenBy(a => a.SessionsAttended >= a.NumberOfSessions).ThenBy(x => x.ExpirationDateStart).ToList();
            Model.IsSortExperienceAsc = false;
        }
        else
        {
            Model.FilteredStudents = Model.manageStudents.OrderByDescending(s => s.Title).ThenBy(a => a.SessionsAttended >= a.NumberOfSessions).ThenBy(x => x.ExpirationDateStart).ToList();
            Model.IsSortExperienceAsc = true;
        }
        loadingIndicator.Hide();
    }

    private int GetSessionPercentage(double numberSessions, double sessionsAttended)
    {
        return (int)((sessionsAttended / numberSessions) * 100);
    }

    public async Task UpdateSchedule(ChangeEventArgs e, ActivitySchedule schedule)
    {
        bool isChecked = (bool)e.Value;

        var result = await activityApiHandler.UpdateActivitySchedule(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateScheduleArgs
            {
                Id = schedule.Id,
                IsActiveSchedule = isChecked
            }, token);
    }

    private void ViewSchedule()
    {
        modalRefViewSchedule.Show();
    }

    public class GetStudent
    {
        public List<Students> item = new List<Students>();
    }

    public Task ShowLoading()
    {
        isLoading = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task HideLoading()
    {
        isLoading = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool IsActive(string page)
       => Model.currentPage == page;

    private bool IsPageNavigationDisabled(string navigation)
    {
        if (navigation.Equals(PREVIOUS))
        {
            return Model.currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return Model.currentPage.Equals(Model.pageItems.ToString());
        }
        return false;
    }

    private async Task Previous()
    {
        var currentPageAsInt = int.Parse(Model.currentPage);
        if (currentPageAsInt > 1)
        {
            Model.currentPage = (currentPageAsInt - 1).ToString();
            await GetStudents(int.Parse(Model.currentPage));
        }
    }

    private async Task Next()
    {
        var currentPageAsInt = int.Parse(Model.currentPage);
        if (currentPageAsInt < Model.pageItems)
        {
            Model.currentPage = (currentPageAsInt + 1).ToString();
            await GetStudents(int.Parse(Model.currentPage));
        }
    }

    private async Task SetActive(string page)
    {
        Model.currentPage = page;
        await GetStudents(int.Parse(page));
    }

    private void NavigateToEnrolleeMasterlist()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents/enrollee-masterlist");
    }
}


    <div class="instruction">
        <span class="instruction-image"><img src="images/circle.png"></span>
        <p class="word">represents attended sessions. Tap the desired date to change.</p>
    </div>










@* CALENDAR *@
<div class="wrap-content calendar">


    <div class="calendar-header">
       
        <h1 class="calendar-header-details">@monthName @year</h1>
            <div class="calendar-arrow">
                <button class="arrow-left" @onclick="() => { monthsAway--; CreateMonth(); }"><img src="images/calender icon left.png"></button>
                <button class="arrow-right" @onclick="() => { monthsAway++; CreateMonth(); }"><img src="images/calender icon right.png"></button>
            </div>
    </div>


    
    <hr />
    <hr />
    <hr />

    <section>

        @foreach (var days in CalendarDays)
        {
            <div class="calendar-days">
                <p>@days</p>
            </div>
        }


        @for (int i = 0; i < numDummyColumn; i++)
        {
            <div></div>
        }
        @for (int i = 1; i <= monthEnd.Day; i++)
        {
            @*var calendarItem =
            items.FirstOrDefault(n => n.Date == new DateTime(year, month, i));*@

            <div class="calendar-body">
                <p class="calendar-dates">@i</p>
               @* @if (calendarItem != null)
                {
                    <p>@calendarItem.Name</p>
                }*@
            </div>
        }
    </section>

</div>



@code {
    private Models.Customer.Profile Model;
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if ((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        var customer = result.Result.Result;

        // check if customer is maker
        if (!customer.IsMaker)
        {
            // account is not maker redirect to explore page
            NavigationManager.NavigateTo("explore");
            return;
        }
        Model = new Models.Customer.Profile
            {
                Token = token,
                CustomerProfile = new Models.Entities.CustomerProfile
                {
                    About = customer.About,
                    Birthdate = customer.Birthdate,
                    Email = customer.Email,
                    FirstName = customer.FirstName,
                    LastName = customer.LastName,
                    Id = customer.Id,
                    IsMaker = customer.IsMaker,
                    IsVerified = customer.IsVerified,
                    ProfilePath = customer.ProfileImg,
                },
            };
    }
}

@layout DashboardLayout
@page "/maker/dashboard/managestudents/{Id:int}/{Type}"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using System.Globalization;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Framework.Enums;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler;
@inject IDirectStudentApiHandler directStudentApiHandler;

<PageTitle>Manage Student Attendance | CinnamonPH</PageTitle>
<SeoMeta Title="Manage Student Attendance" Subject="Manage Student Attendance" />

@if(student!=null){
    <div class="header">
        <button class="back-button" @onclick="@(() => NavigateToManageStudent())"><img src="images/calender icon left.png"></button>
        <h3 class="text-capitalize fw-bold header-title" style="color:#FFA942;">Manage Students - Attendance </h3>
    </div>
    <div class="student-details-container">
        <div class="student-details">
            <div class="student-details-major">
                <p class="">Name : <span>@student.Name</span></p>
                <p class="">Parent : <span>@profile.FirstName @profile.LastName</span></p>
                <p class="">Present Days : <span class="days-present">@student.SessionsAttended</span></p>
            </div>
            <Div Margin="Margin.Is2.FromTop.OnMobile.FromTop.OnDesktop">
                <Div Display="Display.Flex" Flex="Flex.AlignItems.Center.JustifyContent.Between">
                    <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                        <p class="" style="color:#FFA942">Remarks</p>
                        <Button Border="Border.Is0" Padding="Padding.Is0" class="ms-3" @onclick="OnEditRemarksClick">
                            <Icon Name="IconName.Edit" IconStyle="IconStyle.Regular" style="color:white" />
                        </Button>
                    </Div>
                    @if (isEditRemarks)
                    {
                        <Button Border="Border.Is0" TextColor="TextColor.White" Color="Color.Primary" class="btn-save" @onclick="SaveAboutClick">Save</Button>
                    }
                </Div>
                @if (!isEditRemarks)
                {
                    <p class="text-remarks">@student.Remarks</p>
                }
                else
                {
                    <MemoEdit Border="Border.Rounded" @bind-Text="remarksLocalState" Rows="5" class="memo-edit" />
                }
            </Div>
        </div>
    </div>
    <div class="instruction">
        <span class="instruction-image"><img src="images/circle.png"></span>
        <p class="word">represents attended sessions. Tap the desired date to change.</p>
    </div>

    @* CALENDAR *@
    <LoadingIndicator @ref="loadingIndicator">
        <div class="wrap-content calendar">
            <div class="calendar-header">

                <h1 class="calendar-header-details">@monthName @year</h1>
                <div class="calendar-arrow">
                    <button class="arrow-left" @onclick="() => { monthsAway--; CreateMonth();}" disabled="@disableButtonLeft"><img src="images/calender icon left.png"></button>
                    <button class="arrow-right" @onclick="() => { monthsAway++; CreateMonth(); }" disabled="@disableButtonRight"><img src="images/calender icon right.png"></button>
                </div>
            </div>
            <hr />
            <hr />
            <section>
                @foreach (var days in CalendarDays)
                {
                    <div class="calendar-days">
                        <p>@days</p>
                    </div>
                }
                @for (int i = 0; i < numDummyColumn; i++)
                {
                    <div></div>
                }
                @for (int i = 1; i <= monthEnd.Day; i++)
                {
                    var calendarItem = studentAttendances.FirstOrDefault(n => n.Date == new DateTime(year, month, i));
                    passDates = new DateTime(year, monthEnd.Month, i);
                    DateTime currentDate = DateTime.Today;
                    @if (calendarItem != null)
                    {
                        <div class="calendar-body">
                            @if (calendarItem != null && calendarItem.IsPresent == true)
                            {
                                //Display
                                <button class="btn-date" @onclick="() => UpdateAttendance(calendarItem, Token, calendarItem.Date)">@i</button>
                            }
                            else if (calendarItem != null && calendarItem.IsPresent == false)
                            {
                            //Update
                                <button class="btn-date-absent" @onclick="() => UpdateAttendance(calendarItem, Token, calendarItem.Date)">@i</button>
                            }
                            else
                            {
                                //Create
                                if (passDates <= currentDate)
                                {
                                    DateTime selectedDate = passDates;
                                    <button class="btn-date-absent" @onclick="() => CreateAttendance(student, Token, selectedDate)">@i</button>
                                }
                                else
                                {
                                    <p class="calendar-dates">@i</p>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="calendar-body">
                            @if (passDates <= DateTime.Today)
                            {
                                DateTime selectedDate = passDates;
                                <button class="btn-date-absent" @onclick="() => CreateAttendance(student, Token, selectedDate)">@i</button>
                            }
                            else
                            {
                                <p class="calendar-dates">@i</p>
                            }
                        </div>
                    }

                }
            </section>
        </div>
    </LoadingIndicator>

    <Modal @ref="modalRef">
        <ModalContent Centered>
            <ModalHeader>
                <h6 class="col-11 modal-title text-center" style="font-weight:bold">Error</h6>
                <button type="button" class="btn-close" @onclick="() => HideModal()" />
            </ModalHeader>
            <ModalBody>
                <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                    <Card class="badges-column" Border="Border.Is0">
                        <CardBody Display="Display.Flex" class="card-body" Border="Border.Is0" Padding="Padding.Is0">
                            <img class="icon-home" src="images/Dashboard Icon/Remider.png">
                            <span><strong>Reminder:</strong> @ErrorMessage</span>
                        </CardBody>
                    </Card>
                </Div>
            <button class="btn-save" @onclick="() => HideModal()">
                Close
            </button>
            </ModalBody>
        </ModalContent>
    </Modal>
}
@code {
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public string Type { get; set; } = string.Empty;
    public Modal modalRef;
    private Students                student             = new Students();
    private List<StudentAttendance> studentAttendances  = new List<StudentAttendance>();
    private StudentAttendance       studentAttendance   = new StudentAttendance();
    private CustomerProfile         profile             = new CustomerProfile();
    private List<Schedule>          activitySchedules   = new List<Schedule>();
    public  Activity                activity            = new Activity();
    private bool                    isEditRemarks       = false;
    private string                  remarksLocalState   = string.Empty;
    public string                   monthName           = "";
    public DateTime                 monthEnd;
    public int                      monthsAway          = 0;
    public int                      numDummyColumn      = 0;
    public int                      year                = 2023;
    public int                      month               = 0;
    public string                   Token;
    public DateTime                 passDates           = new DateTime();
    public bool                     IsShowErrorMessage  { get; set; }
    public string                   ErrorMessage        { get; set; }
    public bool                     disableButtonRight  { get; set; } = false;
    public bool                     disableButtonLeft   { get; set; } = false;
    LoadingIndicator                loadingIndicator;
    public StudentType studentType { get; set; } = StudentType.Manual;

    @functions {
        string[] CalendarDays = { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        Token = token;
        if (token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }
        var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!profileResult.Succeeded || profileResult.Result == null) || (profileResult.Succeeded && !profileResult.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        if(!profileResult.Result.Result.IsMaker)
        {
            // should not able to access the page
            NavigationManager.NavigateTo("explore");
            return;
        }

        //Get Student Attendance Details
        switch (Type)
        {
            case "Cinnamon":
                var result = await ongoingApiHandler.GetOngoingActivityById(Id);
                if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
                {
                    student = new Students
                        {
                            Id                   = result.Result.Result.Id,
                            CustomerId           = result.Result.Result.CustomerId,
                            Name                 = result.Result.Result.Name,
                            Remarks              = result.Result.Result.Remarks,
                            ActivityId           = result.Result.Result.ActivityId,
                            ScheduleId           = result.Result.Result.ScheduleId,
                            NumberOfSessions     = result.Result.Result.NumberOfSessions,
                            SessionsAttended     = result.Result.Result.SessionsAttended,
                            NumberOfBacktracking = result.Result.Result.NumberOfBacktracking
                        };
                }
                //Get Parent Name
                var customer = await accountApiHandler.GetCustomerById(student.CustomerId);
                if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
                {
                    profile = new CustomerProfile
                        {
                            FirstName = customer.Result.Result.FirstName,
                            LastName = customer.Result.Result.LastName
                        };
                }
                break;
            case "Manual":
                var resultDirect = await directStudentApiHandler.DirectStudent(Id, token);
                if (resultDirect.Succeeded && resultDirect.Result != null && resultDirect.Result.IsSuccess)
                {
                    var studentToUpdate = resultDirect.Result.Result;
                    student = new Students
                        {
                            Id               = studentToUpdate.DirectStudentInfo.Id,
                            Gender           = studentToUpdate.DirectStudentInfo.Gender,
                            Name             = studentToUpdate.DirectStudentInfo.Name,
                            ActivityId       = studentToUpdate.DirectStudentSession.ActivityId,
                            ScheduleId       = studentToUpdate.DirectStudentSession.ScheduleId,
                            NumberOfSessions = studentToUpdate.DirectStudentSession.NumberOfSessions,
                            SessionsAttended = studentToUpdate.DirectStudentSession.SessionsAttended,
                            Remarks          = studentToUpdate.DirectStudentSession.Remarks

                        };
                }
                //Get Parent Name
                profile.FirstName = "Juan";
                profile.LastName = "Dela Cruz";
                break;
            default:
                break;
        }
        //Get Student Attendance
        await GetStudentAttendances();

        //Get Schedules
        await GetActivitySchedules();
    }

    public async Task CreateMonth()
    {
        if(monthsAway <= 2 && monthsAway >= -2)
        {
            if(monthsAway == 2)
            {
                disableButtonRight = true;
            }else if(monthsAway == -2){
                disableButtonLeft = true;
            }
            else{
                disableButtonRight = false;
                disableButtonLeft = false;
            }
            var tempDate = DateTime.Now.AddMonths(monthsAway);
            month = tempDate.Month;
            year = tempDate.Year;

            DateTime monthStart = new DateTime(year, month, 1);
            monthEnd = monthStart.AddMonths(1).AddDays(-1);
            monthName = monthStart.Month switch
            {
                1 => "January",
                2 => "February",
                3 => "March",
                4 => "April",
                5 => "May",
                6 => "June",
                7 => "July",
                8 => "August",
                9 => "September",
                10 => "October",
                11 => "November",
                12 => "December",
                _ => ""
            };
            numDummyColumn = (int)monthStart.DayOfWeek;
        } 
    }

    private void NavigateToManageStudent()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents");
    }

    private void OnEditRemarksClick()
    {
        isEditRemarks = !isEditRemarks;
        if (isEditRemarks)
        {
            remarksLocalState = student.Remarks;
        }
        else 
        {
            remarksLocalState = string.Empty;
        }
    }

    private async Task SaveAboutClick()
    {
        if (isEditRemarks)
        {
            switch (Type)
            {
                case "Cinnamon":
                    var result = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
                                 {
                                     Id = Id,
                                     Remarks = remarksLocalState,
                                 });

                    if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
                    {
                        student.Remarks = string.IsNullOrEmpty(result.Result.Result.Remarks) ? string.Empty : result.Result.Result.Remarks;
                    }
                    break;
                case "Manual":
                    var updateRes = await directStudentApiHandler.UpdateStudent(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs
                                {
                                    StudentId = Id,
                                    Remarks = remarksLocalState
                                 }, Token);

                    if (updateRes.Succeeded && updateRes.Result != null && updateRes.Result.IsSuccess)
                    {
                        student.Remarks = string.IsNullOrEmpty(updateRes.Result.Result.Remarks) ? string.Empty : updateRes.Result.Result.Remarks;
                    }
                    break;
                default:
                    break;
            }

        }
        isEditRemarks = false;
    }

    private async void UpdateAttendance(StudentAttendance studentAttendance, string token, DateTime presentDate)
    {
        try
        {
            await loadingIndicator.Show();
            studentAttendance.IsPresent = !studentAttendance.IsPresent;
            if (studentAttendance.IsPresent)
            {
                studentAttendance.SessionsAttended += 1;
                studentAttendance.NumberOfBackTracking -= 1;
            }
            else
            {
                studentAttendance.SessionsAttended -= 1;
                studentAttendance.NumberOfBackTracking += 1;
            }
            //Check if Cinnamon or Manual Student
            if(Type == "Manual")
            {
                List<StudentAttendance> studentAttendances = new List<StudentAttendance>();
                studentAttendances.Add(studentAttendance);
                var updatedDirect = await directStudentApiHandler.UpdateDirectStudentAttendance(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateDirectStudentAttendanceArgs
                {
                    Date = presentDate,
                    Students = studentAttendances.Select(s =>
                    {
                        return new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateDirectStudentAttendanceArgs.StudentDetails
                        {
                            StudentId  = s.StudentId,
                            ActivityId = s.ActivityId,
                            ScheduleId = s.ScheduleId,
                            IsPresent  = s.IsPresent
                        };
                    })
                }, token);
                if (updatedDirect.Succeeded && updatedDirect.Result != null && updatedDirect.Result.IsSuccess)
                {
                    //Update Session Attended and Backtracking
                    var updateRes = await directStudentApiHandler.UpdateStudent(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs
                    {
                        StudentId = studentAttendance.StudentId,
                        SessionsAttended = studentAttendance.SessionsAttended,
                    }, Token);
                    student.SessionsAttended = updateRes.Result.Result.SessionAttended;
                    //Get Schedule Details
                    var schedule = activitySchedules.Where(a => a.ScheduleId == student.ScheduleId).FirstOrDefault();
                }
            }
            else
            {
                var updated = await dashboardApiHandler.UpdateAttendance(new Framework.ApiCommand.ApiCore.Dashboard.Request.UpdateAttendanceArgs
                        {
                            Id = studentAttendance.Id,
                            Date = studentAttendance.Date,
                            IsPresent = studentAttendance.IsPresent
                        }, token);
                if (updated.Succeeded && updated.Result != null && updated.Result.IsSuccess)
                {
                    var result = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
                            {
                                Id = studentAttendance.StudentId,
                                SessionsAttended = studentAttendance.SessionsAttended,
                                NumberOfBacktracking = studentAttendance.NumberOfBackTracking
                            });
                }
                //Get Schedule Details
                var schedule = activitySchedules.Where(a => a.ScheduleId == studentAttendance.ScheduleId).FirstOrDefault();
                //Set Session Expiration
                if (schedule != null && schedule.IsSetSession == true && schedule.HasExpiration == 2)
                {
                    //Get student attendance
                    await GetStudentAttendances();
                    //Check if first attendance
                    switch (studentAttendances.Count)
                    {
                        case 0:
                            var result = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
                                    {
                                        Id = studentAttendance.StudentId,
                                        ExpirationStartDate = DateTime.MinValue,
                                        ExpirationEndDate = DateTime.MinValue
                                    });
                            break;
                        default:
                            //Get earliest attendance date
                            DateTime earliestDate = studentAttendances.Min(a => a.Date);
                            await ongoingApiHandler.AddActivityExpiration(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.AddActivityExpirationArgs
                                    {
                                        Id = studentAttendance.StudentId,
                                        ScheduleId = studentAttendance.ScheduleId,
                                        SessionName = schedule.SessionName,
                                        ExpirationStartDate = earliestDate,
                                        ExpirationEndDate = DateTime.UtcNow
                                    });
                            break;
                    }
                }
            }
            await OnInitializedAsync();
            StateHasChanged();
            await loadingIndicator.Hide();
        }
        catch (Exception ex)
        {
            IsShowErrorMessage = true;
            ErrorMessage = "An error occured. Please try again later.";
            await loadingIndicator.Hide();
        }
    }

    private async void CreateAttendance(Students student, string token, DateTime presentDate)
    {
        try
        {
            await loadingIndicator.Show();
            switch (Type)
            {
                case "Cinnamon":
                    if (student.NumberOfBacktracking != 0)
                    {
                        var create = await dashboardApiHandler.CreateStudentAttendance(new Framework.ApiCommand.ApiCore.Dashboard.Request.CreateStudentAttendanceArgs
                            {
                                AttendanceDate = presentDate,
                                IsPresent = true,
                                StudentId = student.Id,
                            }, token);
                        if (create.Succeeded && create.Result.IsSuccess)
                        {
                            //Update Session Attended and Backtracking
                            var result = await ongoingApiHandler.UpdateActivity(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.UpdateOngoingActivityArgs
                            {
                                Id = student.Id,
                                SessionsAttended = student.SessionsAttended + 1,
                                NumberOfBacktracking = student.NumberOfBacktracking - 1
                            });
                            student.SessionsAttended = result.Result.Result.SessionsAttended;
                            student.ExpirationDateStart = result.Result.Result.ExpirationStartDate;
                            //Get Schedule Details
                            var schedules = activitySchedules.Where(a => a.ScheduleId == student.ScheduleId).FirstOrDefault();
                            //Set Session Expiration
                            if (schedules != null && schedules.IsSetSession == true && schedules.HasExpiration == 2)
                        {
                            //Check if first attendance
                            if (student.SessionsAttended == 1 || (student.ExpirationDateStart > presentDate && student.ExpirationDateStart != DateTime.MinValue))
                            {
                                student.ExpirationDateStart = presentDate;
                                await ongoingApiHandler.AddActivityExpiration(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.AddActivityExpirationArgs
                                        {
                                            Id = student.Id,
                                            ScheduleId = student.ScheduleId,
                                            SessionName = schedules.SessionName,
                                            ExpirationStartDate = presentDate,
                                            ExpirationEndDate = student.ExpirationDateEnd
                                        });
                            }
                            await OnInitializedAsync();
                            StateHasChanged();
                            await loadingIndicator.Hide();
                        }
                        }
                        await OnInitializedAsync();
                        StateHasChanged();
                        await loadingIndicator.Hide();
                    }
                    else
                    {
                        IsShowErrorMessage = true;
                        ErrorMessage = "You can only adjust attendance up to half of the total offered sessions.";
                        await ShowModal();
                        await loadingIndicator.Hide();
                    }
                    break;
                case "Manual":
                    //Create Attendance
                    List<Students> studentAttendance = new List<Students>();
                    studentAttendance.Add(student);
                    var createDirect = await directStudentApiHandler.CreateDirectStudentAttendance(new Framework.ApiCommand.ApiCore.DirectStudent.Request.CreateDirectStudentAttendanceArgs{
                        CreateStudentAttendances = studentAttendance.Select(s =>
                        {
                            return new Framework.ApiCommand.ApiCore.DirectStudent.Request.CreateDirectStudentAttendanceArgs.CreateStudentAttendance
                            {
                                DirectStudentSessionId = s.Id,
                                Date                   = presentDate,
                                IsPresent              = true
                            };
                        })
                    }, token);
                    if(createDirect.Succeeded && createDirect.Result.IsSuccess)
                    {
                        //Update Session Attended and Backtracking
                        var updateRes = await directStudentApiHandler.UpdateStudent(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs
                        {
                            StudentId = Id,
                            SessionsAttended = student.SessionsAttended + 1,
                        }, Token);
                        student.SessionsAttended = updateRes.Result.Result.SessionAttended;
                        //Get Schedule Details
                        var schedule = activitySchedules.Where(a => a.ScheduleId == student.ScheduleId).FirstOrDefault();
                    }
                    await OnInitializedAsync();
                    StateHasChanged();
                    await loadingIndicator.Hide();
                    break;
                 default:
                    break;
            }
        }
        catch (Exception ex)
        {
            IsShowErrorMessage = true;
            ErrorMessage = "An error occured. Please try again later.";
            await loadingIndicator.Hide();
        }
    }

    public async Task GetStudentAttendances()
    {
        switch (Type)
        {
            case "Cinnamon":
            var attendance = await dashboardApiHandler.GetAllStudentAttendanceById(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetAllStudentAttendanceByIdArgs
            {
                StudentId = student.Id,
                ActivityId = student.ActivityId,
                ScheduleId = student.ScheduleId,
            }, Token);
            if (attendance.Succeeded && attendance.Result != null && attendance.Result.IsSuccess)
            {
                studentAttendances = attendance.Result.Result.Select(a =>
                {
                    return new StudentAttendance
                        {
                            Id = a.Id,
                            Date = a.Date,
                            IsPresent = a.IsPresent,
                            ActivityId = a.ActivityId,
                            NumberOfSessions = a.NumberOfSessions,
                            SessionsAttended = a.SessionsAttended,
                            ScheduleId = a.ScheduleId,
                            StudentId = a.StudentId,
                            NumberOfBackTracking = a.NumberOfBacktracking
                        };
                }).ToList();
                studentAttendances = studentAttendances.Where(s => s.IsPresent).ToList();
            }
            //Create Calendar Month
            await CreateMonth();
            break;
            case "Manual":
            var directAttendance = await directStudentApiHandler.GetDirectStudentById(new Framework.ApiCommand.ApiCore.DirectStudent.Request.GetDirectStudentByIdArgs
            {
                StudentId = student.Id,
                ActivityId = student.ActivityId,
                ScheduleId = student.ScheduleId,
            }, Token);
            if (directAttendance.Succeeded && directAttendance.Result != null && directAttendance.Result.IsSuccess)
            {
                studentAttendances = directAttendance.Result.Result.Select(a =>
                {
                    return new StudentAttendance
                    {
                        Id = a.Id,
                        Date = a.Date,
                        IsPresent = a.IsPresent,
                        ActivityId = a.ActivityId,
                        NumberOfSessions = a.NumberOfSessions,
                        SessionsAttended = a.SessionsAttended,
                        ScheduleId = a.ScheduleId,
                        StudentId = a.StudentId,
                        NumberOfBackTracking = a.NumberOfBacktracking
                    };
                }).ToList();
                //Create Calendar Month
                await CreateMonth();
            }
            break;
            default:
            break;
        }
    }

    public async Task GetActivitySchedules()
    {
        var schedules = await dashboardApiHandler.GetActivitySchedules(Token);
        if (!schedules.Succeeded || schedules.Result == null || !schedules.Result.IsSuccess)
        {
            IsShowErrorMessage = true;
            ErrorMessage = "An error occured. Can't find activity schedules. Please try again later.";
            return;
        }
        activitySchedules.AddRange(schedules.Result.Result.Select(s => {
            return new Schedule {
                            ActivityDescription = s.Description,
                            ActivityTitle = s.Title,
                            ActivityId = s.ActivityId,
                            IsSelected = false,
                            ScheduleDescription = s.ScheduleDescription,
                            ScheduleId = s.ScheduleId,
                            ScheduleTitle = s.ScheduleTitle,
                            IsActiveSchedule = s.IsActiveSchedule,
                            IsSetSession = s.IsSetSession,
                            SessionName = s.SessionName,
                            HasExpiration = s.HasExpiration,
                            StartDate  = s.StartDate
                        };
        }));
    }

    private Task HideModal()
    {
        return modalRef.Hide();
    }

    private Task ShowModal()
    {
        return modalRef.Show();
    }

    public class Schedule 
    {
        public int ActivityId {get; set;}
        public string ActivityTitle {get; set;}
        public string ActivityDescription {get; set;}
        public int ScheduleId {get; set;}
        public string ScheduleTitle {get; set;}
        public string ScheduleDescription {get; set;}
        public bool IsSelected {get; set;}
        public bool IsActiveSchedule { get; set;}
        public bool IsSetSession { get; set; }
        public string SessionName { get; set; }
        public int HasExpiration { get; set; }
        public DateTime? StartDate { get; set; }
    }
}

@layout DashboardLayout
@page "/maker/dashboard/managestudents/enrollee-masterlist"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using System.Globalization;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Framework.ApiCommand.ApiCore.DTO.DirectStudents;
@using Cinnamon.Framework.ApiCommand.ApiCore
@inject IDirectStudentApiHandler directStudentApiHandler;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject INotificationService NotificationService;
@attribute [Authorize]

<div class="mt-5 enrollee-materlist-wrapper">
    <div class="header">
        <div class="title-section">
            <button class="back-button" @onclick="@(() => NavigateToManageStudents())"><img src="images/Dashboard/back-icon.png"></button>
            <p class="back-text">Enrollee Masterlist (Direct Students)</p>
        </div>
        <div class="search-section">
            <button class="btn-add" @onclick="@(() => NavigateToAddDirectStudent())">Add Direct Students</button>
            <TextEdit Placeholder="Search" class="search-bar" TextChanged="@TextSearchChanged"></TextEdit>
        </div>
    </div>
    <div class="direct-student-section">
            <div class="table-list">
                <Table @ref="tableDirectStudents" Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                <TableHeader>
                    <TableRow>
                        <TableHeaderCell class="name-header">
                            <label class="sotring-column">
                                Name
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="age-header">
                            <label class="sotring-column">
                                Age
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="gender-header">
                            <label class="sotring-column">
                                Gender
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="action-header">
                            <label class="sotring-column">
                                Action
                            </label>
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in directStudents)
                        {
                            <TableRow>
                                <TableRowCell class="name-body">@item.Name</TableRowCell>
                                <TableRowCell class="age-body">@item.Age</TableRowCell>
                                <TableRowCell class="gender-body text-capitalize">@item.Gender</TableRowCell>
                                <TableRowCell class="update">
                                    <Button Clicked="() => NavigateToAddDirectStudentUpdate(item.Id)"
                                    Color="Color.Primary" Border="Border.Is0" class="btn-update">
                                        Update
                                    </Button>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
                <Pagination Class="pagination-section" Style="margin-top: 20px;">
                    <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
                        <PaginationLink>
                            <span aria-hidden="true">&laquo;</span>
                        </PaginationLink>
                    </PaginationItem>
                    @{
                        int pagesToShow = 6;
                        int startPage = Math.Max(1, (byte)Pagination.PageIndex - (pagesToShow / 2));
                        int endPage = Math.Min((byte)Pagination.TotalPages, startPage + pagesToShow - 1);

                        for (var i = startPage; i <= endPage; i++)
                        {
                            var pageNumberAsString = i.ToString();
                            <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                                <PaginationLink Page="@pageNumberAsString" Clicked="SetActive">
                                    @pageNumberAsString
                                </PaginationLink>
                            </PaginationItem>
                        }
                    }
                    <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next">
                        <PaginationLink>
                            <span aria-hidden="true">&raquo;</span>
                        </PaginationLink>
                    </PaginationItem>
                </Pagination>
            </div>
        </div>
</div>

@code 
{
    public Table tableDirectStudents;

    private string token = string.Empty;

    private CancellationTokenSource _cts = new CancellationTokenSource();

    private List<DirectStudentInfoDTO> directStudents = new();

    private List<DirectStudentInfoDTO> filteredStudents = new List<DirectStudentInfoDTO>();

    public string currentPage = "1";

    public string SearchValue { get; set; } = string.Empty;

    public const string PREVIOUS = "previous";

    public const string NEXT = "next";

    public int counterPage = 10;

    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }
            await LoadDirectStudents(1);
        }
        catch (Exception ex)
        {
            ex.Message.ToString();
        }

    }

    private async Task LoadDirectStudents(int pageIndex)
    {
        try
        {
            directStudents.Clear(); // Clear existing data
            var result = await directStudentApiHandler.DirectStudents(new Framework.ApiCommand.ApiCore.DirectStudent.Request.DirectStudentInfoArgs
                {
                    CountPerPage = counterPage,
                    PageIndex = pageIndex,
                    SearchValue = SearchValue
                }, token);

            if (result.Succeeded && result.Result is not null && result.Result.IsSuccess)
            {
                // Ensure unique records before adding
                var newStudents = result.Result.Result;
                foreach (var student in newStudents)
                {
                    if (!directStudents.Any(ds => ds.Id == student.Id))
                    {
                        directStudents.Add(student);
                    }
                }
                Pagination = result.Result.Pagination;
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task TextSearchChanged(string search)
    {
        SearchValue = search;
        _cts.Cancel(); // Cancel any ongoing requests
        _cts = new CancellationTokenSource();

        try
        {
            await LoadDirectStudents(1);
        }
        catch (OperationCanceledException)
        {
            // Handle request cancellation
        }
    }

    private bool IsActive(string page)
      => currentPage == page;

    private bool IsPageNavigationDisabled(string navigation)
    {
        if (navigation.Equals(PREVIOUS))
        {
            return currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return currentPage.Equals(counterPage.ToString());
        }
        return false;
    }

    private async Task Previous()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt > 1)
        {
            currentPage = (currentPageAsInt - 1).ToString();
            await LoadDirectStudents(int.Parse(currentPage));
        }
    }

    private async Task Next()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt < Pagination.TotalPages)
        {
            currentPage = (currentPageAsInt + 1).ToString();
            await LoadDirectStudents(int.Parse(currentPage));
        }
    }

    private async Task SetActive(string page)
    {
        currentPage = page;
        await LoadDirectStudents(int.Parse(page));
    }

    private void NavigateToManageStudents()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents");
    }

    private void NavigateToAddDirectStudent()
    {
        NavigationManager.NavigateTo("/maker/dashboard/enrollee-masterlist/direct-student");
    }

    private void NavigateToAddDirectStudentUpdate(int id)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/enrollee-masterlist/direct-student/{id}");
    }
}

@layout DashboardLayout
@page "/maker/dashboard/managestudents/enrollee-masterlist"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Maker;
@using System.Globalization;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Framework.ApiCommand.ApiCore.DTO.DirectStudents;
@inject IDirectStudentApiHandler directStudentApiHandler;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject INotificationService NotificationService;
@attribute [Authorize]

<div class="mt-5 enrollee-materlist-wrapper">
    <div class="header">
        <div class="title-section">
            <button class="back-button" @onclick="@(() => NavigateToManageStudents())"><img src="images/Dashboard/back-icon.png"></button>
            <p class="back-text">Enrollee Masterlist (Direct Students)</p>
        </div>
        <div class="search-section">
            <button class="btn-add" @onclick="@(() => NavigateToAddDirectStudent())">Add Direct Students</button>
            <TextEdit Placeholder="Search" class="search-bar"></TextEdit>
        </div>
    </div>
    <div class="direct-student-section">
        <div class="table-list">
            <Table @ref="tableDirectStudents" Shadow="Shadow.Default" Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                <TableHeader>
                    <TableRow>
                        <TableHeaderCell class="name-header">
                            <label class="sotring-column">
                                Name
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="age-header">
                            <label class="sotring-column">
                                Age
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="gender-header">
                            <label class="sotring-column">
                                Gender
                            </label>
                        </TableHeaderCell>
                        <TableHeaderCell class="action-header">
                            <label class="sotring-column">
                               Action
                            </label>
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in directStudents)
                    {
                        <TableRow>
                            <TableRowCell class="name-body">@item.Name</TableRowCell>
                            <TableRowCell class="age-body">@item.Age</TableRowCell>
                            <TableRowCell class="gender-body text-capitalize">@item.Gender</TableRowCell>
                            <TableRowCell class="update">
                                <Button Clicked="() => NavigateToAddDirectStudentUpdate(item.Id)" 
                                    Color="Color.Primary" Border="Border.Is0"class="btn-update">
                                    Update
                                </Button>
                            </TableRowCell>
                        </TableRow>   
                    }
                </TableBody>
            </Table>
        </div>
    </div>
</div>

@code 
{
    public Table tableDirectStudents;

    private string token = string.Empty;

    private List<DirectStudentInfoDTO> directStudents = new();

    private int currentPage = 1, countPerPage = 10;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            await LoadDirectStudents();
        }
        catch (Exception ex)
        {
            ex.Message.ToString();
        }

    }

    private async Task LoadDirectStudents()
    {
        try
        {
            var result = await directStudentApiHandler.DirectStudents(new Framework.ApiCommand.ApiCore.DirectStudent.Request.DirectStudentInfoArgs {
                CountPerPage = countPerPage,
                PageIndex = currentPage
            }, token);

            if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
            {
                directStudents.AddRange(result.Result.Result);
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private void NavigateToManageStudents()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents");
    }

    private void NavigateToAddDirectStudent()
    {
        NavigationManager.NavigateTo("/maker/dashboard/enrollee-masterlist/direct-student");
    }

    private void NavigateToAddDirectStudentUpdate(int id)
    {
        NavigationManager.NavigateTo($"/maker/dashboard/enrollee-masterlist/direct-student/{id}");
    }
}

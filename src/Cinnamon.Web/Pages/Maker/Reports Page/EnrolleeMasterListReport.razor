@page "/maker/dashboard/enrollee-masterlist"
@layout DashboardLayout
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Security.Claims
@using System.Globalization;
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using System.Security.Claims
@using Cinnamon.Web.Models.Entities;
@using ClosedXML.Excel;
@using System.IO;
@using Microsoft.AspNetCore.Mvc
@inject IJSRuntime JSRuntime
@inject IChatApiHandler chatApiHandler;
@inject IAccountApiHandler accountApiHandler
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject IJSRuntime jsRuntime


<section class="mt-5 enrollee-masterlist">
    <div class="header col-12 d-flex">
        <div class="export-file col-10 d-flex justify-content-start">
            <button class="back-button" @onclick="@(() => NavigateToManageReports())"><img src="images/dashboard-back.png"></button>
            <p class="back-text">Reports</p>
        </div>
        <div class="export-file col-2 d-flex justify-content-end">
            <button class="btn-export" @onclick="ExportToExcel">Download Excel File
            <img class="excel-icon" src="images/xls-icon.png" />
            </button>
        </div>
    </div>
    <div class="page-title">
        <h3 class="text-capitalize fw-bold header-title">Enrollee Master List</h3>
        <div class="col-12 d-flex">
            <h6 class="masterlist-text col-10 d-flex justify-content-start">List of enrollees that purchased your activities. This will help you see the enrollees of your activities.</h6>
            <div class="search-box col-2 d-flex justify-content-end">
                <TextEdit Placeholder="Search" TextChanged="@TextSearchChanged" class="search-bar"></TextEdit>
            </div>
        </div>
    </div>
    <div class="enrollees-section">
        <div class="table-list">
            <Table Resizable ResizeMode="TableResizeMode.Columns" Hoverable>
                <TableHeader>
                    <TableRow>
                        <TableHeaderCell>
                            Name
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Age
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Gender
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Session Attended
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Last Activity Purchased
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Email
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Student No.
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Remarks
                        </TableHeaderCell>
                        <TableHeaderCell>
                            Calendar of Attendance
                        </TableHeaderCell>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var item in FilteredEnrollees)
                    {
                        <TableRow>
                            <TableRowCell class="name-body">@item.Name</TableRowCell>
                            <TableRowCell class="name-body">@item.Age</TableRowCell>
                            <TableRowCell class="name-body text-capitalize">@item.Gender</TableRowCell>
                            <TableRowCell class="name-body" TextAlignment="TextAlignment.Center">@item.SessionsAttended/@item.NumberOfSessions</TableRowCell>
                            <TableRowCell class="name-body">@item.ActivityName</TableRowCell>
                            <TableRowCell class="name-body">@item.Email</TableRowCell>
                            <TableRowCell class="name-body" TextAlignment="TextAlignment.Center">@item.StudentNo</TableRowCell>
                            <TableRowCell class="name-body">@item.Remarks</TableRowCell>
                            <TableRowCell class="name-body" TextAlignment="TextAlignment.Center">
                                <button type="button" class="btn btn-primary border-0">Show Attendance</button>
                            </TableRowCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
            <Pagination Class="pagination-section" Style="margin-top: 20px;">
                <PaginationItem Disabled="@IsPageNavigationDisabled(PREVIOUS)" @onclick="Previous">
                    <PaginationLink>
                        <span aria-hidden="true">«</span>
                    </PaginationLink>
                </PaginationItem>
                @{
                    for (var i = 1; i <= Pagination.TotalPages; i++)
                    {
                        var pageNumberAsString = i.ToString();
                        <PaginationItem @key="pageNumberAsString" Active="@IsActive(pageNumberAsString)">
                            <PaginationLink Page="@pageNumberAsString" Clicked="SetActive">
                                @pageNumberAsString
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
                <PaginationItem Disabled="@IsPageNavigationDisabled(NEXT)" @onclick="Next">
                    <PaginationLink>
                        <span aria-hidden="true">»</span>
                    </PaginationLink>
                </PaginationItem>
            </Pagination>
        </div>
    </div>
</section>
@*Student Calendar*@
<Modal ShowBackdrop=true ScrollToTop=false @ref="modalRef">
    <ModalContent Size="ModalSize.ExtraLarge" Scrollable=false Overflow="Overflow.Visible" Position="Position.Absolute" Centered>
        <ModalHeader>
            <h6 class="col-11 modal-title text-center" style="font-weight:bold">View Attendance</h6>
            <button type="button" class="btn-close" @onclick="() => HideModal()" />
        </ModalHeader>
        <ModalBody MaxHeight="90">
            <div class="student-details-container">
                <div class="student-details">
                    @if (studentAttendances.Count != 0)
                    {
                        var sessionAttended = studentAttendances.Sum(a => a.SessionsAttended);
                        <div class="student-details-major">
                            <p class="">Name : <span>@studentAttendances[0].Name</span></p>
                            <p class="">Present Days : <span class="days-present">@sessionAttended</span></p>
                        </div>
                    }
                </div>
            </div>
            @* CALENDAR *@
            <div class="wrap-content calendar">
                <div class="calendar-header">

                    <h1 class="calendar-header-details">@monthName @year</h1>
                    <div class="calendar-arrow">
                        <button class="arrow-left" @onclick="() => { monthsAway--; CreateMonth(); }" disabled="@disableButtonLeft"><img src="images/calender icon left.png"></button>
                        <button class="arrow-right" @onclick="() => { monthsAway++; CreateMonth(); }" disabled="@disableButtonRight"><img src="images/calender icon right.png"></button>
                    </div>
                </div>
                <hr />
                <hr />
                <section>
                    @foreach (var days in CalendarDays)
                    {
                        <div class="calendar-days">
                            <p>@days</p>
                        </div>
                    }
                    @for (int i = 0; i < numDummyColumn; i++)
                    {
                        <div></div>
                    }
                    @for (int i = 1; i <= monthEnd.Day; i++)
                    {
                        var calendarItem = studentAttendances.FirstOrDefault(n => n.Date == new DateTime(year, month, i));
                        <div class="calendar-body">
                            @if (calendarItem != null && calendarItem.IsPresent == true)
                            {
                                //Display
                                <button class="btn-date">@i</button>
                            }
                            else if (calendarItem != null && calendarItem.IsPresent == false)
                            {
                                //Update
                                <button class="btn-date-absent">@i</button>
                            }
                            else
                            {
                                <p class="calendar-dates">@i</p>
                            }
                        </div>
                    }
                </section>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>

@code {
    IJSObjectReference module;
    public Modal modalRef;
    private CustomerProfile profile = new CustomerProfile();
    private List<Students> enrollees = new List<Students>();
    public List<Students> FilteredEnrollees { get; set; } = new();
    private List<Students> ExportEnrollees = new List<Students>();
    private List<StudentAttendance> studentAttendances = new List<StudentAttendance>();
    private string Token = string.Empty;
    private const string PREVIOUS = "previous";
    private const string NEXT = "next";
    private int pageItems = 10;
    private string currentPage = "1";
    public string monthName = "";
    public int monthsAway = 0;
    public int numDummyColumn = 0;
    public int year = 2023;
    public int month = 0;
    public DateTime passDates;
    public DateTime monthEnd;
    public bool disableButtonRight { get; set; } = false;
    public bool disableButtonLeft { get; set; } = false;
    public Cinnamon.Framework.ApiCommand.ApiCore.Pagination Pagination = new Framework.ApiCommand.ApiCore.Pagination();

    @functions {
        string[] CalendarDays = { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");
            if (user != null && user.Identity.IsAuthenticated)
            {
                var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
                if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
                {
                    var args = result.Result.Result;
                    profile = new CustomerProfile
                    {
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        IsVerified = args.IsVerified,
                        Birthdate = args.Birthdate,
                        Email = args.Email,
                        FirstName = args.FirstName,
                        LastName = args.LastName
                    };
                    await GetEnrolleMasterList(1);
                }
                else
                {
                    NavigationManager.NavigateTo("/explore");
                }
            }
        }
        catch (Exception e)
        {
            e.Message.ToString();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/exportToExcel.js");
        }
    }

    private async Task GetEnrolleMasterList(int pageIndex)
    {
        //Get Enrollee Master List
        var enrollee = await ongoingApiHandler.GetEnrolleeMasterList(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetEnrolleeMasterListArgs
            {
                ProviderId = profile.Id,
                CountPerPage = 10,
                PageIndex = pageIndex
            }, Token);
        enrollees = enrollee.Result.Result.Select(e => new Students
        {
            Id               = e.Id,
            CustomerId       = e.CustomerId,
            ActivityId       = e.ActivityId,
            ScheduleId       = e.ScheduleId,
            Name             = e.Name,
            SessionsAttended = e.SessionsAttended,
            NumberOfSessions = e.NumberOfSessions,
            Age              = e.Age,
            ActivityName     = e.ActivityName,
            Gender           = e.Gender,
            Email            = e.Email,
            Remarks          = e.Remarks,
            Status           = e.Status,
            StudentNo        = e.StudentNo
        }).ToList();
        Pagination = enrollee.Result.Pagination;
        FilteredEnrollees = enrollees.OrderBy(s => s.Name).ToList();
    }

    private void TextSearchChanged(string search)
    {
        FilteredEnrollees = enrollees.FindAll(s => s.Name.ToLower().Contains(search.ToLower())).OrderBy(e => e.Name).ToList();
    }

    private void NavigateToManageReports()
    {
        NavigationManager.NavigateTo("/maker/dashboard/reports");
    }

    private bool IsActive(string page)
       => currentPage == page;

    private bool IsPageNavigationDisabled(string navigation)
    {
        if (navigation.Equals(PREVIOUS))
        {
            return currentPage.Equals("1");
        }
        else if (navigation.Equals(NEXT))
        {
            return currentPage.Equals(pageItems.ToString());
        }
        return false;
    }

    private void Previous()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt > 1)
        {
            currentPage = (currentPageAsInt - 1).ToString();
        }
    }

    private void Next()
    {
        var currentPageAsInt = int.Parse(currentPage);
        if (currentPageAsInt < pageItems)
        {
            currentPage = (currentPageAsInt + 1).ToString();
        }
    }

    private async Task SetActive(string page)
    {
        currentPage = page;
        await GetEnrolleMasterList(int.Parse(page));
    }

    private async Task ExportToExcel()
    {
        //Get Enrollee Master List
        var result = await ongoingApiHandler.GetEnrolleeMasterList(new Framework.ApiCommand.ApiCore.OnGoingActivities.Request.GetEnrolleeMasterListArgs
            {
                ProviderId = profile.Id,
            }, Token);

        ExportEnrollees = result.Result.Result.Select(e => new Students
            {
                Id = e.Id,
                CustomerId = e.CustomerId,
                ActivityId = e.ActivityId,
                ScheduleId = e.ScheduleId,
                Name = e.Name,
                SessionsAttended = e.SessionsAttended,
                NumberOfSessions = e.NumberOfSessions,
                Age = e.Age,
                ActivityName = e.ActivityName,
                Gender = e.Gender,
                Email = e.Email,
                Remarks = e.Remarks,
                Status = e.Status,
                StudentNo = e.StudentNo
            }).ToList();
        using (var workbook = new XLWorkbook("wwwroot/Template/Masterlist.xlsx"))
        {
            // Access the first worksheet in the workbook (assuming it's the only one)
            var worksheet = workbook.Worksheet(1);

            // Define the starting row for your data (assuming headers are in the first row)
            int startRow = 6;

            // Loop through the ExportEnrollees list and populate the worksheet
            foreach (var student in ExportEnrollees)
            {
                worksheet.Cell(1, 8).Value = $"Date:{DateTime.Today.ToString("MMMM dd, yyyy")}";
                worksheet.Cell(startRow, 1).Value = student.Name;
                worksheet.Cell(startRow, 2).Value = student.Age;
                worksheet.Cell(startRow, 3).Value = student.Gender;
                worksheet.Cell(startRow, 4).Value = $"{student.SessionsAttended} / {student.NumberOfSessions}";
                worksheet.Cell(startRow, 5).Value = student.ActivityName;
                worksheet.Cell(startRow, 6).Value = student.Email;
                worksheet.Cell(startRow, 7).Value = student.StudentNo;
                worksheet.Cell(startRow, 8).Value = student.Remarks;
                startRow++;
            }
            // Create a MemoryStream to save the workbook
            using (var memoryStream = new MemoryStream())
            {
                workbook.SaveAs(memoryStream);
                memoryStream.Seek(0, SeekOrigin.Begin);

                // Specify the file name
                var currentDate = DateTime.Now.ToString("yyyyMMddHHmmss");
                var fileName = $"MasterList_{currentDate}.xlsx";
                byte[] bytes = memoryStream.ToArray();

                // Convert the bytes to base64
                var bytesBase64 = Convert.ToBase64String(bytes);
                // Download the saved memorystream file
                await Task.Run(() => module.InvokeVoidAsync("saveAsFile", fileName, bytesBase64));
            }
        }
    }

    public async Task OpenModal(Students student)
    {
        studentAttendances.Clear();

        var attendance = await dashboardApiHandler.GetAllStudentAttendanceById(new Framework.ApiCommand.ApiCore.Dashboard.Request.GetAllStudentAttendanceByIdArgs
            {
                StudentId = student.Id,
            }, Token);
        if (attendance.Succeeded && attendance.Result != null && attendance.Result.IsSuccess)
        {
            studentAttendances = attendance.Result.Result.Select(a =>
            {
                return new StudentAttendance
                    {
                        Id = a.Id,
                        Date = a.Date,
                        IsPresent = a.IsPresent,
                        ActivityId = a.ActivityId,
                        NumberOfSessions = a.NumberOfSessions,
                        SessionsAttended = a.SessionsAttended,
                        ScheduleId = a.ScheduleId,
                        StudentId = a.StudentId,
                        Name = a.Name,
                        HasReview = a.HasReview
                    };
            }).ToList();
        }
        await modalRef.Show();
    }

    private async Task HideModal()
    {
        await modalRef.Hide();
    }

    public async Task CreateMonth()
    {
        if (monthsAway <= 6 && monthsAway >= -1)
        {
            if (monthsAway == 6)
            {
                disableButtonRight = true;
            }
            else if (monthsAway == -1)
            {
                disableButtonLeft = true;
            }
            else
            {
                disableButtonRight = false;
                disableButtonLeft = false;
            }
            var tempDate = DateTime.Now.AddMonths(monthsAway);
            month = tempDate.Month;
            year = tempDate.Year;

            DateTime monthStart = new DateTime(year, month, 1);
            monthEnd = monthStart.AddMonths(1).AddDays(-1);
            monthName = monthStart.Month switch
            {
                1 => "January",
                2 => "February",
                3 => "March",
                4 => "April",
                5 => "May",
                6 => "June",
                7 => "July",
                8 => "August",
                9 => "September",
                10 => "October",
                11 => "November",
                12 => "December",
                _ => ""
            };
            numDummyColumn = (int)monthStart.DayOfWeek;
        }
    }
}

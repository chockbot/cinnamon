@page "/maker/dashboard/grosssale"
@layout DashboardLayout
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Security.Claims
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Microsoft.AspNetCore.SignalR.Client;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using System.Security.Claims;
@using Cinnamon.Web.Models.Entities;
@inject IChatApiHandler chatApiHandler;
@inject IAccountApiHandler accountApiHandler
@inject ITransactionApiHandler transactionApiHandler

<div class="container">
    <div class="header">
        <button class="back-button" @onclick="@(() => NavigateToManageReports())"><img src="images/dashboard-back.png"></button>
        <p class="back-text">Reports</p>
    </div>
    <div class="page-title">
        <div class="col-12 d-flex">
            <h3 class="text-capitalize fw-bold header-title col-6 d-flex justify-content-start">Gross Sales Reports </h3>
            <div class="btn-group col-6 d-flex justify-content-end">
                <button class="btn-today" @onclick="@(() => UpdateChatDataset("today"))">Today</button>
                <button @onclick="@(() => UpdateChatDataset("1week"))">1w</button>
                <button @onclick="@(() => UpdateChatDataset("2weeks"))">2w</button>
                <button @onclick="@(() => UpdateChatDataset("3weeks"))">3w</button>
                <button @onclick="@(() => UpdateChatDataset("1month"))">1m</button>
                <button @onclick="@(() => UpdateChatDataset("2months"))">2m</button>
                <button class="btn-months" @onclick="@(() => UpdateChatDataset("3months"))">3m</button>
            </div>
        </div>
        <h6 class="gross-sale-text">Track the sales of your activities. This helps you see your most profitable activities in Cinnamon.</h6>
    </div>
    <LineChart @ref="lineChart" TItem="GrossSales" Options="@lineChartOptions" />
    <div class="legend col-12 d-flex justify-content-start">

    </div>
</div>


@code {
    private List<GrossSales> priceData = new List<GrossSales>();
    private LineChart<GrossSales> lineChart;
    private List<string> backgroundColors = new() { ChartColor.FromRgba(255, 255, 255, 0.2f)};
    private List<string> borderColors = new() { ChartColor.FromRgba(255, 169, 66, 1)};
    private List<string> pointBorderColor = new List<string>() { ChartColor.FromRgba(75, 183, 73, 1)};
    private List<string> pointHoverBorderColor = new List<string>() { ChartColor.FromRgba(52, 61, 76, 1)};
    private CustomerProfile profile = new CustomerProfile();
    private bool isAlreadyInitialised;
    private string Token = string.Empty;
    LineChartOptions lineChartOptions = new()
    {
        Parsing = new ChartParsing
        {
            XAxisKey = "sector",
            YAxisKey = "count",
        },
    };
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            Token = user.FindFirstValue("Token");
            if (user != null && user.Identity.IsAuthenticated)
            {
                var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
                if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
                {
                    var args = result.Result.Result;
                    profile = new CustomerProfile
                     {
                         Id = args.Id,
                         IsMaker = args.IsMaker,
                         IsVerified = args.IsVerified,
                         Birthdate = args.Birthdate,
                         Email = args.Email,
                         FirstName = args.FirstName,
                         LastName = args.LastName
                     };
                }
                //Get gross sale by Activity Provider
                var gross = await transactionApiHandler.GetGrossSalesByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetGrossSalesByProviderArgs
                    {
                        Id = profile.Id,
                        DateFrom = DateTime.Today.ToString("yyyyMMddHHmmss")
                    }, Token);
                if (gross.Succeeded && gross.Result != null && gross.Result.IsSuccess)
                {
                    priceData = gross.Result.Result.Select(e =>
                    {
                        return new GrossSales
                            {
                                Total = e.Total,
                                PurchaseDate = e.PurchaseDate
                            };
                    }).ToList();
                }

                await lineChart.Clear();
                await lineChart.AddDataSet(GetLineChartDataset(priceData));
            }
        }
        catch(Exception e)
        {
            e.Message.ToString();
        }
    }
    private async Task UpdateChatDataset(string dateRange)
    {
        DateTime startDate;
        switch (dateRange)
        {
            case "today":
                startDate = DateTime.Today;
                break;
            case "1week":
                startDate = DateTime.Today.AddDays(-7);
                break;
            case "2weeks":
                startDate = DateTime.Today.AddDays(-14);
                break;
            case "3weeks":
                startDate = DateTime.Today.AddDays(-21);
                break;
            case "1month":
                startDate = DateTime.Today.AddMonths(-1);
                break;
            case "2months":
                startDate = DateTime.Today.AddMonths(-2);
                break;
            case "3months":
                startDate = DateTime.Today.AddMonths(-3);
                break;
            default:
                startDate = DateTime.Today.AddMonths(-1);
                break;
        }

        //Get gross sale by Activity Provider
        var gross = await transactionApiHandler.GetGrossSalesByProvider(new Framework.ApiCommand.ApiCore.Transaction.Request.GetGrossSalesByProviderArgs
            {
                Id = profile.Id,
                DateFrom = startDate.ToString("yyyyMMddHHmmss")
            }, Token);
        if (gross.Succeeded && gross.Result != null && gross.Result.IsSuccess)
        {
            priceData = gross.Result.Result.Select(e =>
            {
                return new GrossSales
                    {
                        Total = e.Total,
                        PurchaseDate = e.PurchaseDate
                    };
            }).ToList();
        }

        await lineChart.Clear();
        await lineChart.AddDataSet(GetLineChartDataset(priceData));
    }

    private LineChartDataset<GrossSales> GetLineChartDataset(List<GrossSales> dataset)
    {
        return new()
            {
                Label = "Gross Sale Chart",
                Data = dataset,
                BackgroundColor = backgroundColors[0], // line chart can only have one color
                BorderColor = borderColors[0],
                Fill = true,
                PointRadius = 5,
                BorderWidth = 1,
                PointBorderColor = backgroundColors[0],
                PointBackgroundColor = pointBorderColor[0],
                PointHoverBackgroundColor = pointHoverBorderColor[0],
                CubicInterpolationMode = "monotone",
            };
    }
    private void NavigateToManageReports()
    {
        NavigationManager.NavigateTo("/maker/dashboard/reports");
    }
}
@layout DashboardLayout
@page "/maker/dashboard/reports"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@inject IJSRuntime jsRuntime

<div class="content-creation col-lg-10 col-md-10 col-sm-12 col-12 mx-auto">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-12 label-container-section text-lg-center text-md-center text-sm-center">
            <label class="fw-bold title-description">
                REPORTS NOW AVAILABLE!
            </label>
        </div>
    </div>

    <div class="row mrow justify-content-center">
        <div class="col-lg-6 col-md-6 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <a href="/maker/dashboard/grosssale">
                <img src="images/Dashboard/Chart2.png" class="img-instruction">
            </a>
            <label class="fw-bold chart-title">Gross Sales Report</label>
            <label class="chart-description">Track the sales of your activities. This helps you see your most profitable activities in Cinnamon.</label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <a href="/maker/dashboard/recognized-report">
                <img src="images/Dashboard/Chart1.png" class="img-instruction">
            </a>
            <label class="fw-bold chart-title">Recognized Sales Report</label>
            <label class="chart-description">Track the actual recognized sales that has been transferred to your account. This will help you see how long it takes you to complete a session and how much each completion affects you.</label>
        </div>
    </div>

    <div class="row mrow justify-content-center">
        <div class="col-lg-6 col-md-6 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <a href="/maker/dashboard/enrollee-masterlist">
                <img src="images/Dashboard/Chart3.png" class="img-instruction">
            </a>
            <label class="fw-bold chart-title">Enrollee Master List</label>
            <label class="chart-description">List of enrollees that purchased your activities. This will help you see the enrollees of your activities.</label>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 mb-4 label-container-section text-lg-start text-md-start text-sm-center">
            <img src="images/Dashboard/Chart.png" class="img-instruction">
            <label class="fw-bold chart-title">Engagement Report</label>
            <label class="chart-description">Track the engagement of your activities Cinnamon. This will help you see if your offerings are being engaged by the customers.</label>
        </div>
    </div>
</div>
@code {

}

@page "/maker/update-activity";
@layout CreationLayout;
@using System.Security.Claims
@using Cinnamon.Framework.ApiCommand.ApiCore.Activity.Response;
@using Cinnamon.Framework.Common;
@using Microsoft.AspNetCore.WebUtilities;
@using Cinnamon.Web.Components.Pages.Maker.UpdateActivity;
@using Cinnamon.Web.Models;
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Components.Pages.Creation;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Components.Pages;
@using static Cinnamon.Framework.Enums.Enums;
@inject NavigationManager NavigationManager;
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject IActivityApiHandler activityApiHandler;
@inject IOngoingActivitiesHandler ongoingApiHandler
@inject IAccountApiHandler accountApiHandler;
@inject INotificationService NotificationService;
@using Cinnamon.Framework.Enums;

<PageTitle>Update Experience | CinnamonPH</PageTitle>
<SeoMeta Title="Update Experience" Subject="Update Experience" Url="/maker/update-activity" />

<div class="xp-ote-page-wrapper">
    @if(Model != null)
    {
        <input type="hidden" @bind="Model.Activity.ActivityId" id="activity-id" />
        <input type="hidden" value="@Model.Activity.ActivityStatus" id="activity-status" />
        
        <Container>
            <div class="progress-bar-section">
                <p class="progress-details">
                    IN PROGRESS: Step @currentIndex of 7 <span id="loader" class=""></span>
                </p>
                <div class="progress">
                    <div class="progress-bar" role="progressbar" style="width: @(GetPerentCompletion)%;" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>
        </Container>

        <Container>
            <div class="experience-heading-section  d-flex justify-content-between">
                <p class="experience-heading d-none d-sm-block d-md-block d-lg-block d-xl-block">
                    UPDATE YOUR EXPERIENCE!
                </p>
                <div class="save-later-button-section">
                    <div class="save-later-section d-none d-sm-block d-md-block d-lg-block d-xl-block">
                        @if (Model.Activity.Status == ActivityStatus.InProgress)
                        {
                            <Button Border="Border.Is0" class="btn-primary" @onclick="() => SaveForLater()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                                <LoadingTemplate>
                                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                                </LoadingTemplate>
                                <ChildContent>
                                    Save for Later
                                </ChildContent>
                            </Button>
                        }
                    </div>
                </div>
            </div>

            <div class="experience-progress-wrapper d-xl-none d-lg-none d-md-none d-sm-none d-block">
                <div class="row">
                    <div class="col-1 prev-button-section">
                        @if (currentIndex > 1)
                        {
                            <button class="carousel-control-prev" type="button" @onclick="() => OnBackClick()">
                                <img src="images/experience-creation/play-mobile.svg" alt="check-icon" />
                            </button>
                        }
                    </div>
                    <div class="col-10 text-center">
                        @if (currentIndex == 1)
                        {
                            <label class="experience-progress-label">
                                Overview
                            </label>
                        }
                        else if (currentIndex == 2)
                        {
                            <label class="experience-progress-label">
                                Location
                            </label>
                        }
                        else if (currentIndex == 3)
                        {
                            <label class="experience-progress-label">
                                Pricing & Schedule
                            </label>
                        }
                        else if (currentIndex == 4)
                        {
                            <label class="experience-progress-label">
                                Requirements
                            </label>
                        }
                        else if (currentIndex == 5)
                        {
                            <label class="experience-progress-label">
                                Gallery
                            </label>
                        }
                        else if (currentIndex == 6 || currentIndex == 7)
                        {
                            <label class="experience-progress-label">
                                Publish
                            </label>
                        }
                    </div>
                    <div class="col-1 next-button-section">
                        @if (currentIndex < 7)
                        {
                        <button class="carousel-control-next" type="button" @onclick="() => OnNextClick()">
                                <img src="images/experience-creation/play-mobile.svg" alt="check-icon" />
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="save-later-section-mobile d-xl-none d-lg-none d-md-none d-sm-none d-block">
                @if (Model.Activity.Status == ActivityStatus.InProgress)
                {
                    <Button Border="Border.Is0" class="btn-primary" @onclick="() => SaveForLater()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                        </LoadingTemplate>
                        <ChildContent>
                            Save for Later
                        </ChildContent>
                    </Button>
                }
            </div>

            <Row>
                <Column class="d-none d-md-block col-left" ColumnSize="ColumnSize.Is12.OnTablet.Is4.OnDesktop">
                    <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <a class="nav-link @(currentIndex == 1 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(1)">
                            Overview
                            @if (currentIndex == 1)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                            else
                            {
                                if (isCreationOverviewComponentValid)
                                {
                                    <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                                }
                            }
                        </a>
                        <a class="nav-link @(currentIndex == 2 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(2)">
                            Location
                            @if (currentIndex == 2)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                            else
                            {
                                if (isLocationComponentValid)
                                {
                                    <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                                }
                            }
                        </a>
                        <a class="nav-link @(currentIndex == 3 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(3)">
                            Pricing & Schedule
                            @if (currentIndex == 3)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                            else
                            {
                                if (isPricingAndScheduleComponentValid)
                                {
                                    <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                                }
                            }
                        </a>
                        <a class="nav-link @(currentIndex == 4 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(4)">
                            Requirements
                            @if (currentIndex == 4)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                            else
                            {
                                if (isOptionalDetailsComponentValid)
                                {
                                    <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                                }
                            }
                        </a>
                        <a class="nav-link @(currentIndex == 5 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(5)">
                            Gallery
                            @if (currentIndex == 5)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                            else
                            {
                                if (isGalleryComponentValid)
                                {
                                    <img class="pull-right" src="images/Dashboard/rounded-check.png" alt="check-icon" />
                                }
                            }
                        </a>
                        <a class="nav-link @(currentIndex == 7 ? "active" : "")" data-toggle="pill" role="tab" @onclick="() => OnNextClick(7)">
                            Publish
                            @if (currentIndex == 7)
                            {
                                <img class="pull-right" src="images/experience-creation/play-desktop.png" alt="check-icon" />
                            }
                        </a>
                    </div>
                    <div class="dashed-divider"></div>
                    <div class="guide-section text-center">
                        <label class="guide-title color-black-100 font-24 m-font-20 @(currentIndex != 6 ? "d-block" : "d-none")">
                            How it will look like
                        </label>
                        <div class='@(currentIndex == 1 ? "d-block" : "d-none")'>
                            <div class="row">
                                <div class="creation-guide-step-1 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                    <img src="images/experience-creation/creation-guide-step-1.svg" alt="check-icon" />
                                </div>
                            </div>
                        </div>
                        <div class='@(currentIndex == 2 ? "d-block" : "d-none")'>
                            <div class="row">
                                <div class="creation-guide-step-3 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                    <img src="images/experience-creation/creation-guide-step-2.svg" alt="check-icon" />
                                </div>
                            </div>
                        </div>
                        <div class='@(currentIndex == 3 ? "d-block" : "d-none")'>
                            <div class="row">
                                <div class="creation-guide-step-4 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                    <img src="images/experience-creation/creation-guide-step-3.svg" alt="check-icon" />
                                </div>
                            </div>
                        </div>
                        <div class='@(currentIndex == 4 ? "d-block" : "d-none")'>
                            <div class="row">
                                <div class="creation-guide-step-5 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                    <img src="images/experience-creation/creation-guide-step-4.svg" alt="check-icon" />
                                </div>
                            </div>
                        </div>
                        <div class='@(currentIndex == 5 ? "d-block" : "d-none")'>
                            <div class="row">
                                <div class="creation-guide-step-6 col-lg-12 d-none d-sm-block d-md-block d-lg-block d-xl-block">
                                    <img src="images/experience-creation/creation-guide-step-5.svg" alt="check-icon" />
                                </div>
                            </div>
                        </div>
                    </div>
                </Column>
                <Column class="col-right" ColumnSize="ColumnSize.Is12.OnTablet.Is8.OnDesktop">
                    <div class="">
                        <div class="tab-content-section">
                            <EditForm Model="Model.Activity" id="form-cretion">
                                <div class='tab @(currentIndex == 1 ? "show" : "")'>
                                    <CreationOverviewUpdate @ref="creationOverviewComponent" Model="Model"></CreationOverviewUpdate>
                                </div>

                                <div class='tab @(currentIndex == 2 ? "show" : "")'>
                                    <LocationUpdate @ref="locationComponent" Model="Model" />
                                </div>

                                <div class='tab @(currentIndex == 3 ? "show" : "")'>
                                    @if (Model.Activity.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience)
                                    {
                                        <PricingAndScheduleUpdate @ref="pricingAndScheduleComponent" Model="Model" />
                                    }
                                    else if (Model.Activity.ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
                                    {
                                        <PricingAndScheduleAppointmentUpdate @ref="pricingAndScheduleAppointmentComponent" Model="Model" />
                                    }
                                </div>

                                <div class='tab @(currentIndex == 4 ? "show" : "")'>
                                    <OptionalDetailsUpdate @ref="optionalDetailsComponent" Model="Model" />
                                </div>

                                <div class='tab @(currentIndex == 5 ? "show" : "")'>
                                    <GalleryUpdate @ref="galleryComponent" Model="Model" />
                                </div>

                                <div class='tab @(currentIndex == 6 ? "show" : "")'>
                                    <ActivitySummary @ref="ActivitySummary" Activity="Model.Activity" />
                                </div>
                                <div class='tab @(currentIndex ==  7 ? "show" : "")'>
                                    <LoadingIndicator @ref="loadingIndicator" FullScreen FadeIn>
                                        <GeneralPublishPage @ref="GeneralPublishPage" Activity="Model.Activity" />
                                    </LoadingIndicator>
                                </div>
                            </EditForm>
                        </div>
                        <div class="button-container">
                            @if (currentIndex > 1)
                                {
                                    <div class="">
                                        <button type="button" class="btn-back font-20 m-font-18" id="prevBtn" @onclick="() => OnBackClick()">Back</button>
                                    </div>
                                    <div class="">
                                        @if (currentIndex == 7)
                                        {
                                            <Button Border="Border.Is0" class="btn-primary font-20 m-font-18" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn">
                                                <ChildContent>
                                                    @(currentIndex == 7 ? "Publish" : "Next")
                                                </ChildContent>
                                            </Button>
                                        }
                                        else
                                        {
                                            <Button Border="Border.Is0" class="btn-primary font-20 m-font-18" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                                                <LoadingTemplate>
                                                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                                                </LoadingTemplate>
                                                <ChildContent>
                                                    @(currentIndex == 7 ? "Publish" : "Next")
                                                </ChildContent>
                                            </Button>
                                        }
                                    </div>
                                }
                            else
                                {
                                    <div class="col-lg-12 col-12">
                                        <Button Border="Border.Is0" class="btn-primary font-20 m-font-18" @onclick="() => OnNextClick()" Type="ButtonType.Button" id="nextBtn" Loading="isLoading" Disabled="isLoading">
                                            <LoadingTemplate>
                                                <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Publishing
                                            </LoadingTemplate>
                                            <ChildContent>
                                                @(currentIndex == 7 ? "Publish" : "Next")
                                            </ChildContent>
                                        </Button>
                                    </div>
                                }
                        </div>
                    </div>
                </Column>
            </Row>
        </Container>
    }
</div>

<div class="modal fade remove-modal" tabindex="-1" role="dialog" id="experienceCreationGuideModal" style="z-index:99999;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <label class="guide-title text-center color-black-100 font-24 m-font-20">
                    How it will look like
                </label>
                <button type="button" class="btn-close" id="btnCloseExperienceCreationGuideModal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="col-12-lg d-flex justify-content-center">
                    <div class="row" id="image-section">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if(showErrorMessage)
{
    <div class="alert alert-danger alert-dismissible fade-in show position-absolute top-0 end-0 m-2" role="alert" style="z-index:99999">
      <strong>Error!</strong> @errorMessage
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@code 
{
    private ExperienceUpdateModel Model;

    private ExperienceUpdate experienceUpdateComponent {get; set;}

    private ExperienceSetupUpdate experienceSetupUpdateComponent {get; set;}

    private int currentIndex = 1;

    private CreationOverviewUpdate creationOverviewComponent { get; set; }

    private LocationUpdate locationComponent { get; set; }

    private PricingAndScheduleUpdate pricingAndScheduleComponent { get; set; }
    private PricingAndScheduleAppointmentUpdate pricingAndScheduleAppointmentComponent { get; set; }

    private OptionalDetailsUpdate optionalDetailsComponent { get; set; }

    private GalleryUpdate galleryComponent { get; set; }

    private GeneralPublishPage GeneralPublishPage { get; set; }

    public List<Students> enrolledStudents = new List<Students>();

    LoadingIndicator loadingIndicator;

    private bool isLoading = false;

    private bool showErrorMessage = false;

    private string errorMessage = string.Empty;

    private DotNetObjectReference<UpdateActivity>? obj;

    private IJSObjectReference module;

    private double GetPerentCompletion
    {
        get {
            return Math.Round(currentIndex * 16.67);
        }
    }

    private ActivitySummary ActivitySummary {get; set;}

    public bool isCreationOverviewComponentValid { get; set; }
    public bool isLocationComponentValid { get; set; }
    public bool isPricingAndScheduleComponentValid { get; set; }
    public bool isOptionalDetailsComponentValid { get; set; }
    public bool isGalleryComponentValid { get; set; }

    public const string NOTHING_PROVIDED = "--NOTHING PROVIDED--";

    protected override async Task OnInitializedAsync()
    {
        // get user token
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
        if((!result.Succeeded || result.Result == null) || (result.Succeeded && !result.Result.IsSuccess))
        {
            // an error occured
            NavigationManager.NavigateTo("explore");
            return;
        }
        if(!result.Result.Result.IsMaker)
        {
            // should not able to access the page
            NavigationManager.NavigateTo("explore");
            return;
        }

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var res = QueryHelpers.ParseQuery(uri.Query).TryGetValue("activityId", out var id);

        // if cant find the activity id in the query string
        int activityId = 0;
        if(!res || !int.TryParse(id, out activityId))
        {
            NavigationManager.NavigateTo("/maker/dashboard");
            return;
        }

        var activityRes = await activityApiHandler.GetOwnedActivity(activityId, token, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs {
            IncludeActivityAddress = true,
            IncludeActivityDescription = true,
            IncludeActivityImages = true,
            IncludeActivitySearchTags = true,
            IncludeAtivitySchedules = true,
            IncludeAddOns = true
        });
        if((!activityRes.Succeeded || activityRes.Result == null) || (activityRes.Succeeded && !activityRes.Result.IsSuccess))
        {
            // navigate to maker dashboard, an error occured
            NavigationManager.NavigateTo("/maker/dashboard");
            return;
        }
        var activity = activityRes.Result.Result;

        activity = ReplaceActivityTemporaryValues(activity);

        // get experience types
        var experienceTypes = await activityApiHandler.GetExperienceTypes();
        if((!experienceTypes.Succeeded || experienceTypes.Result == null) || (experienceTypes.Succeeded && !experienceTypes.Result.IsSuccess))
        {
            // an error occured when getting experience types to api
            NavigationManager.NavigateTo("/maker/dashboard");
            return;
        }

        // get experience categories
        var categories = await activityApiHandler.GetExperienceCategories();
        if((!categories.Succeeded || categories.Result == null) || (categories.Succeeded && !categories.Result.IsSuccess))
        {
            // an error occured when getting experience categories to api
            NavigationManager.NavigateTo("/maker/dashboard");
            return;
        }

        // get sub categories
        var subCategories = await activityApiHandler.GetSubCategories();
        if((!subCategories.Succeeded || subCategories.Result == null) || (subCategories.Succeeded && !subCategories.Result.IsSuccess))
        {
            // an error occured when getting sub categories to api
            NavigationManager.NavigateTo("/maker/dashboard");
            return;
        }

        var regions = await activityApiHandler.GetAllRegions();
        if ((!regions.Succeeded || regions.Result == null) || (regions.Succeeded && !regions.Result.IsSuccess))
        {
            NavigationManager.NavigateTo("explore");
            return;
        }

        AppResult<GetAllCitiesResult> cities = new AppResult<GetAllCitiesResult>{};
        AppResult<GetAllBarangaysResult> barangays = new AppResult<GetAllBarangaysResult>();

        if (activity.ExperienceTypeId == 1 && !string.IsNullOrEmpty(activity.Region))
        {
            if (activity.Status == ActivityStatus.Submitted)
            {
                cities = await activityApiHandler.GetAllCitiesByRegionCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllCitiesArgs { RegionCode = activity.Region });
                if ((!cities.Succeeded || cities.Result == null) || (cities.Succeeded && !cities.Result.IsSuccess))
                {
                    NavigationManager.NavigateTo("explore");
                    return;
                }

                var city = cities.Result.Result.FirstOrDefault(c => c.Code == activity.City);

                barangays = await activityApiHandler.GetAllBarangaysByCityCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllBarangaysArgs { CityCode = activity.City, IsCity = city.IsCity, IsMunicipality = city.IsMunicipality });
                if ((!barangays.Succeeded || barangays.Result == null) || (barangays.Succeeded && !barangays.Result.IsSuccess))
                {
                    NavigationManager.NavigateTo("explore");
                    return;
                }
            }
            else
            {
                if (!string.IsNullOrEmpty(activity.Region))
                {
                    cities = await activityApiHandler.GetAllCitiesByRegionCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllCitiesArgs { RegionCode = activity.Region });
                    if ((!cities.Succeeded || cities.Result == null) || (cities.Succeeded && !cities.Result.IsSuccess))
                    {
                        NavigationManager.NavigateTo("explore");
                        return;
                    }
                }

                if (!string.IsNullOrEmpty(activity.City))
                {
                    var city = cities.Result.Result.FirstOrDefault(c => c.Code == activity.City);

                    barangays = await activityApiHandler.GetAllBarangaysByCityCode(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllBarangaysArgs { CityCode = activity.City, IsCity = city.IsCity, IsMunicipality = city.IsMunicipality });
                    if ((!barangays.Succeeded || barangays.Result == null) || (barangays.Succeeded && !barangays.Result.IsSuccess))
                    {
                        NavigationManager.NavigateTo("explore");
                        return;
                    }
                }
            }
        }
        //Get Ongoing and Completed Students
        var students = await ongoingApiHandler.GetEnrolledStudents(activityId);
        if (students.Succeeded && students.Result != null && students.Result.IsSuccess)
        {
            enrolledStudents = students.Result.Result.Select(i =>
            {
                return new Students
                    {
                        ActivityId = i.ActivityId,
                        Id = i.Id,
                        Name = i.Name,
                        NumberOfSessions = i.NumberOfSessions,
                        SessionsAttended = i.SessionsAttended,
                        ScheduleId = i.ScheduleId,
                        ExpirationDateEnd = i.ExpirationEndDate,
                        ExpirationDateStart = i.ExpirationStartDate
                    };
            }).ToList();
        }

        Model = new ExperienceUpdateModel {
            Activity = new Models.Entities.Activity {
                ActivityId    = activity.ActivityId,
                ActivityLevel = activity.ActivityLevel,
                ActivitySchedules = activity.ActivitySchedules.Select(s => {
                    return new Models.Entities.ActivitySchedule {
                        DateTime = s.DateTime,
                        Id = s.Id,
                        Name = s.Name,
                        PerUnit1 = s.PerUnit1,
                        PerUnit2 = s.PerUnit2,
                        Price = s.Price,
                        PriceUnit1 = s.PriceUnit1,
                        PriceUnit2 = s.PriceUnit2,
                        UnitPrice = s.UnitPrice,
                        TempId = s.Id,
                        Order = s.Order,
                        IsActiveSchedule = s.IsActiveSchedule,
                        IsSetSession = s.IsSetSession,
                        SessionName = s.SessionName,
                        HasExpiration = s.HasExpiration,
                        StartDate = s.StartDate,
                        PriceType = s.PriceType,
                        ScheduleType = s.ScheduleType,
                        SchedulingUrl = s.SchedulingUrl,
                        ActivityScheduleTimes = s.ActivityScheduleTimes.Select(act => new ActivityScheduleTime
                        {
                            ActivityScheduleId = act.ActivityScheduleId,
                            ActivityScheduleTimeId = act.ActivityScheduleTimeId,
                            DayOfWeek = act.DayOfWeek,
                            EndTime = act.EndTime,
                            StartTime = act.StartTime,
                            IsEnabled = act.IsEnabled
                        }).ToList()
                    };
                }).ToList(),
                AddOns = activity.AddOns.Select(s => {
                    return new Models.Entities.AddOn
                    {
                        Id          = s.Id,
                        Name        = s.Name,
                        Price       = s.Price,
                        UnitPrice   = s.UnitPrice,
                        Description = s.Description,
                        Order       = s.Order
                    };
                }).ToList(),
                ClassPolicies          = activity.ClassPolicies,
                AdditionalRequirements = activity.AdditionalRequirements,
                Address1               = activity.Address1,
                Address2               = activity.Address2,
                CanAdultsJoin          = activity.CanAdultsJoin,
                City                   = activity.City,
                CityName               = activity.CityName,
                Subdivision            = activity.Subdivision,
                Region                 = activity.Region,
                Barangay               = activity.Barangay,
                BarangayName           = activity.BarangayName,
                PostalCode             = activity.PostalCode,
                CustomerBringWithThem  = activity.CustomerBringWithThem,
                Description            = activity.Description,
                District               = activity.District,
                ExperienceCategoryId   = activity.ExperienceCategoryId,
                ExperienceTypeId       = activity.ExperienceTypeId,
                VideoLink              = activity.VideoLink,
                Images = activity.Images.Select(i => {
                    return new Models.Entities.ActivityImage {
                        ImageSrc = i.ImageSrc,
                        Name = i.Name,
                        Id = i.Id,
                        Order = i.Order
                    };
                }).ToList(),
                IsPublished             = activity.IsPublished,
                MinimumAge              = activity.MinimumAge,
                Price                   = activity.Price,
                Remarks                 = activity.Remarks,
                ScheduleIndicator       = activity.ScheduleIndicator,
                SearchTags              = activity.SearchTags.ToList(),
                SkillLevel              = activity.SkillLevel,
                SpecificsYouWillProvide = activity.SpecificsYouWillProvide,
                SubCategoryId           = activity.SubCategoryId,
                Title                   = activity.Title,
                PinnedLocation          = activity.PinnedLocation,
                Status                  = activity.Status,
                ExperienceCreationType  = activity.ExperienceCreationType
            },
            ExperienceTypes = experienceTypes.Result.Result.Select(e => {
                return new Models.Entities.ExperienceType {
                    Id = e.Id,
                    Name = e.Name
                };
            }),
            ExperienceCategories = categories.Result.Result.Select(c => {
                return new Models.Entities.ExperienceCategory {
                    Category = c.Name,
                    IconPath = c.IconPath,
                    Id = c.Id
                };
            }),
            SubCategories = subCategories.Result.Result.Select(s => {
                return new Models.Entities.SubCategory {
                    CategoryId = s.CategoryId,
                    Id = s.Id,
                    Name = s.Name
                };
            }),
            Regions = regions.Result.Result.Select(r =>
            {
                return new Models.Entities.Region
                {
                    Code = r.Code,
                    Name = r.Name,
                    RegionName = r.RegionName
                };
            }),
                Cities = activity.ExperienceTypeId == 1 ? cities.Result != null ? cities.Result.Result.Select(r => new Models.Entities.City
            {
                Code = r.Code,
                Name = r.Name,
                RegionCode = r.RegionCode,
                IsCity = r.IsCity,
                IsMunicipality = r.IsMunicipality
                }) : new List<Models.Entities.City>() : new List<Models.Entities.City>(),
            Barangays = activity.ExperienceTypeId == 1 ? barangays.Result != null ? barangays.Result.Result.Select(r => new Models.Entities.Barangay
            {
                Code = r.Code,
                Name = r.Name,
                CityCode = r.CityCode
                }) : new List<Models.Entities.Barangay>() : new List<Models.Entities.Barangay>(),
            EnrolledStudents = enrolledStudents,
            Token = token
        };

        if (Model.Activity.ExperienceCreationType == Enums.ExperienceCreationType.ExperienceViaAppointment)
        {
            List<ScheduleTime> scheduleTimes = new List<ScheduleTime>();

            foreach (var schedule in Model.Activity.ActivitySchedules)
            {
                scheduleTimes = new List<ScheduleTime>();

                for (int i = 0; i < 7; i++)
                {
                    var activityScheduleTimes = schedule.ActivityScheduleTimes.Where(a => a.DayOfWeek == i).ToList();

                    foreach (var item in activityScheduleTimes)
                    {
                        item.ModelStatus = ModelStatus.Updated;
                        item.IsNew = false;
                    }

                    scheduleTimes.Add(new ScheduleTime
                        {
                            ActivityScheduleId = schedule.Id,
                            DayOfWeek = i,
                            Sort = i,
                            IsEnabled = activityScheduleTimes.FirstOrDefault().IsEnabled,
                            ActivityScheduleTimes = activityScheduleTimes,
                        });
                }

                schedule.ScheduleTimes = scheduleTimes;
            }

            Model.Activity.ScheduleType = Model.Activity.ActivitySchedules.FirstOrDefault().ScheduleType;
            Model.Activity.SchedulingUrl = Model.Activity.ActivitySchedules.FirstOrDefault().SchedulingUrl;
        }

        obj = DotNetObjectReference.Create(this);
    }


        activity.AddOns                  = ReplaceTemporaryAddOns(activity.AddOns.ToList());
        activity.Title                   = ReplaceTemporaryValues(activity.Title);
        activity.Description             = ReplaceTemporaryValues(activity.Description);
        activity.AdditionalRequirements  = ReplaceTemporaryValues(activity.AdditionalRequirements);
        activity.Address1                = ReplaceTemporaryValues(activity.Address1);
        activity.Address2                = ReplaceTemporaryValues(activity.Address2);
        activity.City                    = ReplaceTemporaryValues(activity.City);
        activity.Subdivision             = ReplaceTemporaryValues(activity.Subdivision);
        activity.Region                  = ReplaceTemporaryValues(activity.Region);
        activity.Barangay                = ReplaceTemporaryValues(activity.Barangay);
        activity.PostalCode              = ReplaceTemporaryValues(activity.PostalCode);
        activity.CustomerBringWithThem   = ReplaceTemporaryValues(activity.CustomerBringWithThem);
        activity.District                = ReplaceTemporaryValues(activity.District);
        activity.Price                   = ReplaceTemporaryValues(activity.Price);
        activity.Remarks                 = ReplaceTemporaryValues(activity.Remarks);
        activity.ScheduleIndicator       = ReplaceTemporaryValues(activity.ScheduleIndicator);
        activity.SpecificsYouWillProvide = ReplaceTemporaryValues(activity.SpecificsYouWillProvide);
        activity.PinnedLocation          = ReplaceTemporaryValues(activity.PinnedLocation);
        activity.ClassPolicies           = ReplaceTemporaryValues(activity.ClassPolicies);
        activity.VideoLink               = ReplaceTemporaryValues(activity.VideoLink);

        return activity;
    }

    private IList<Cinnamon.Framework.ApiCommand.ApiCore.DTO.Activity.ActivityDTO.ActivitySchedule> ReplaceTemporarySchedules(IList<Cinnamon.Framework.ApiCommand.ApiCore.DTO.Activity.ActivityDTO.ActivitySchedule> activitySchedules)
    {
        bool isSingle = activitySchedules.Count == 1;
        bool isValid = false;

        foreach (var schedule in activitySchedules)
        {
            if ((string.IsNullOrEmpty(schedule.Name) ||
                string.IsNullOrEmpty(schedule.DateTime) ||
                schedule.Price <= 0 ||
                string.IsNullOrEmpty(schedule.UnitPrice) ||
                schedule.PerUnit1 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit1) ||
                schedule.PerUnit2 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit2)) && (schedule.IsActiveSchedule || isSingle))
                isValid = false;

            if (!isValid)
            {
                schedule.Name       = ReplaceTemporaryValues(schedule.Name);
                schedule.DateTime   = ReplaceTemporaryValues(schedule.DateTime);
                schedule.UnitPrice  = ReplaceTemporaryValues(schedule.UnitPrice);
                schedule.PriceUnit1 = ReplaceTemporaryValues(schedule.PriceUnit1);
                schedule.PriceUnit2 = ReplaceTemporaryValues(schedule.PriceUnit2);
            }

        }

        return activitySchedules;
    }

    private IList<Cinnamon.Framework.ApiCommand.ApiCore.DTO.Activity.ActivityDTO.AddOn> ReplaceTemporaryAddOns(IList<Cinnamon.Framework.ApiCommand.ApiCore.DTO.Activity.ActivityDTO.AddOn> addOns)
    {
        bool isSingle = addOns.Count == 1;
        bool isValid = false;

        foreach (var addOn in addOns)
        {
            if ((string.IsNullOrEmpty(addOn.Name) ||
                addOn.Price <= 0 ||
                string.IsNullOrEmpty(addOn.UnitPrice)))
                isValid = false;

            if (!isValid)
            {
                addOn.Name = ReplaceTemporaryValues(addOn.Name);
                addOn.UnitPrice = ReplaceTemporaryValues(addOn.UnitPrice);
            }

        }

        return addOns;
    }
    
    private string ReplaceTemporaryValues(string value)
    {
        return value == NOTHING_PROVIDED ? null : value;
    }

    private string ReplaceEmptyValue(string value, string replacement)
    {
        return string.IsNullOrEmpty(value) ? replacement : value;
    }

    private IList<Models.Entities.ActivitySchedule> ValidateSchedules(IList<Models.Entities.ActivitySchedule> activitySchedules)
    {
        var newSchedules = GetActivitySchedules(activitySchedules.Where(a => a.Id == 0).ToList());
        var listSchedule = new List<Models.Entities.ActivitySchedule>();
        listSchedule.AddRange(activitySchedules.Where(a => a.Id != 0).ToList());

        foreach (var item in newSchedules)
        {
            listSchedule.Add(item);
        }

        bool isSingle = listSchedule.Count == 1;
        bool isValid = false;

        foreach (var schedule in listSchedule)
        {
            if ((string.IsNullOrEmpty(schedule.Name) ||
                string.IsNullOrEmpty(schedule.DateTime) ||
                schedule.Price <= 0 ||
                string.IsNullOrEmpty(schedule.UnitPrice) ||
                schedule.PerUnit1 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit1) ||
                schedule.PerUnit2 <= 0 ||
                string.IsNullOrEmpty(schedule.PriceUnit2)) && (schedule.IsActiveSchedule || isSingle))
                isValid = false;

            if (!isValid)
            {
                schedule.Name = ReplaceEmptyValue(schedule.Name, NOTHING_PROVIDED);
                schedule.DateTime = ReplaceEmptyValue(schedule.DateTime, NOTHING_PROVIDED);
                schedule.UnitPrice = ReplaceEmptyValue(schedule.UnitPrice, NOTHING_PROVIDED);
                schedule.PriceUnit1 = ReplaceEmptyValue(schedule.PriceUnit1, NOTHING_PROVIDED);
                schedule.PriceUnit2 = ReplaceEmptyValue(schedule.PriceUnit2, NOTHING_PROVIDED);
            }

        }

        return listSchedule;
    }

    private IList<Models.Entities.AddOn> ValidateAddOns(IList<Models.Entities.AddOn> addOns)
    {
        var newAddOns = GetAddOns(addOns.Where(a => a.Id == 0).ToList());
        var listAddOn = new List<Models.Entities.AddOn>();
        listAddOn.AddRange(addOns.Where(a => a.Id != 0).ToList());

        foreach (var item in newAddOns)
        {
            listAddOn.Add(item);
        }

        bool isSingle = listAddOn.Count == 1;
        bool isValid = false;

        foreach (var addOn in listAddOn)
        {
            if ((string.IsNullOrEmpty(addOn.Name) ||
                addOn.Price <= 0 ||
                string.IsNullOrEmpty(addOn.UnitPrice)))
                isValid = false;

            if (!isValid)
            {
                addOn.Name = ReplaceEmptyValue(addOn.Name, NOTHING_PROVIDED);
                addOn.UnitPrice = ReplaceEmptyValue(addOn.UnitPrice, NOTHING_PROVIDED);
            }
        }
        return listAddOn;
    }
}
    }

    private async Task LoadStudent()
    {
        var result = await directStudentApiHandler.DirectStudent(StudentId, token);

        if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
        {
            await NotificationService.Error(result.Result?.ErrorInfo?.Message ?? result.Message, "Error");
            NavigateToEnrolleeMasterlist();
            return;
        }

        var studentToUpdate = result.Result.Result;
        student = new Student {
            BirthMonth = studentToUpdate.DirectStudentInfo.BirthMonth,
            BirthYear = studentToUpdate.DirectStudentInfo.BirthYear,
            Gender = studentToUpdate.DirectStudentInfo.Gender,
            Name = studentToUpdate.DirectStudentInfo.Name,
            Id = studentToUpdate.DirectStudentInfo.Id
        };
    }

    private async Task GoToPrev()
    {
        await JS.InvokeVoidAsync("MyLib.Utils.navigation.back");
    }

    private async Task LoadOngoingSessions()
    {
        var sessionsRes = await directStudentApiHandler.StudentSessions(new Framework.ApiCommand.ApiCore.DirectStudent.Request.StudentSessionsArgs {
            SessionStatus = "ongoing"
        }, StudentId, token);

        if(sessionsRes.Succeeded && sessionsRes.Result is not null && sessionsRes.Result.IsSuccess)
        {
            ongoingActivities.AddRange(sessionsRes.Result.Result.Select(s => new EnrolledActivity {
                ActivityId = s.ActivityId,
                ActivityName = activities[s.ActivityId]?.Title ?? string.Empty,
                Amount = s.DirectStudentPayment.Amount,
                ScheduleId = s.ScheduleId,
                Id = s.Id
            }));
        }
    }

    private async Task LoadCompletedSessions()
    {
        var sessionsRes = await directStudentApiHandler.StudentSessions(new Framework.ApiCommand.ApiCore.DirectStudent.Request.StudentSessionsArgs {
            SessionStatus = "completed"
        }, StudentId, token);

        if(sessionsRes.Succeeded && sessionsRes.Result is not null && sessionsRes.Result.IsSuccess)
        {
            completedActivities.AddRange(sessionsRes.Result.Result.Select(s => new EnrolledActivity {
                ActivityId = s.ActivityId,
                ActivityName = activities[s.ActivityId]?.Title ?? string.Empty,
                Amount = s.DirectStudentPayment.Amount,
                ScheduleId = s.ScheduleId,
                Id = s.Id
            }));
        }
    }

    private Task OnFilterValueChanged(ChangeEventArgs e, EnrolledActivity activity)
    {
        if (int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            if (selectedValue != 0)
            {
                activity.ActivityId = selectedValue;
                activity.ScheduleId = 0;
            }
        }

        return Task.CompletedTask;
    }

    private Task OnModalClosing(ModalClosingEventArgs e)
    {
        e.Cancel = (e.CloseReason == CloseReason.FocusLostClosing || e.CloseReason == CloseReason.EscapeClosing);
        return Task.CompletedTask;
    }

    private Task CancelConfirmationModal()
    {
        // to reset selected schedule and empty selected period to trigger validate again
        currentSelectedActivity.PeriodConfirmation.SelectedPeriod = string.Empty;
        currentSelectedActivity.ScheduleId = 0;
        currentSelectedActivity.PrevScheduleId = -1;

        return confirmPeriodModal.Close(CloseReason.UserClosing);
    }

    private Task SelectPeriod(string period)
    {
        if(period == "currentperiod" || period == "nextperiod")
        {
            currentSelectedActivity.PeriodConfirmation.SelectedPeriod = period;
        }
        return Task.CompletedTask;
    }

    private Task ConfirmProceedClick()
    {
        if(string.IsNullOrEmpty(currentSelectedActivity.PeriodConfirmation.SelectedPeriod))
        {
            currentSelectedActivity.PeriodConfirmation.IsShowError = true;
            return Task.CompletedTask;
        }
        
        return confirmPeriodModal.Close(CloseReason.UserClosing);
    }

    private async Task SelectedScheduleChanged(ChangeEventArgs e, EnrolledActivity activity)
    {
        if(int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            var selectedSched = GetActivitySchedules(activity.ActivityId).FirstOrDefault(s => s.Id == selectedValue);
            if(selectedSched is null)
            {
                await NotificationService.Error("An error occured. Please try again later.", "Error");
                return;
            }

            activity.ScheduleId = selectedValue;
            currentSelectedActivity = activity;

            if(selectedSched.HasExpiration == 1)
            {
                if(currentSelectedActivity.ScheduleId != currentSelectedActivity.PrevScheduleId)
                {
                    await PeriodCalculation(selectedSched.StartDate.Value, selectedSched.SessionName);
                    await confirmPeriodModal.Show();
                }
            }

            currentSelectedActivity.PrevScheduleId = selectedValue;
        }
    }

    private Task PeriodCalculation(DateTime dateStart, string sessionName)
    {
        var datePeriod = DateNextPeriod.CreateRecurring(dateStart, sessionName);
        DateTime periodStart = datePeriod.PeriodStart;
        // to set the last time of the day
        DateTime periodEnd = datePeriod.PeriodEnd.AddDays(1).Date.AddSeconds(-1);

        DateTime nextPeriod = datePeriod.NextPeriod().PeriodStart;
        DateTime now = DateTime.Now;

        int daysLeft = (periodEnd - now).Days;
        int hours = (periodEnd - now).Hours;
        string durationLeft = daysLeft > 0 ? $"{daysLeft} days" : (hours > 0 ? "today" : "0 days");

        currentSelectedActivity.PeriodConfirmation.DaysLeft = Math.Abs((now - periodEnd).Days);
        currentSelectedActivity.PeriodConfirmation.DurationLeft = durationLeft;
        currentSelectedActivity.PeriodConfirmation.NextPeriod = nextPeriod;
        currentSelectedActivity.PeriodConfirmation.IsApplied = false;
        currentSelectedActivity.PeriodConfirmation.IsShowError = false;

        return Task.CompletedTask;
    }

    private class Student
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Gender is required")]
        public string Gender { get; set; }

        [Required(ErrorMessage = "Birth Month is required")]
        public string BirthMonth { get; set; }

        [Range(1900, 2100, ErrorMessage = "Year must be between 1900 and 2100")]
        public int BirthYear { get; set; }
    }

    private class EnrolledActivity 
    {
        public int Id {get; set;}

        [Range(1, int.MaxValue, ErrorMessage = "Class is required")]
        public int ActivityId {get; set;}

        [Range(1, int.MaxValue, ErrorMessage = "Schedule is required")]
        public int ScheduleId {get; set;}

        [Range(1, int.MaxValue, ErrorMessage = "The payment field is required.")]
        public decimal Amount {get; set;}


        // extra fields
        public string ActivityName {get; set;}
        public PeriodConfirmation PeriodConfirmation {get; set;} = new();
        public int PrevScheduleId {get; set;} = -1;
    }

    private class PeriodConfirmation 
    {
        public string Message { get; set; }
        public int DaysLeft { get; set; }
        public string DurationLeft { get; set; }
        public DateTime NextPeriod { get; set; }
        public bool IsApplied { get; set; }
        public bool IsShowError { get; set; }

        public string SelectedPeriod { get; set; }
        public bool IsSubmitting { get; set; }
    }
}

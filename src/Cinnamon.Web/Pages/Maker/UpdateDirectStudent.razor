@layout DashboardLayout
@page "/maker/dashboard/enrollee-masterlist/direct-student/{StudentId:int}"
@using System.Security.Claims
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Models.Maker
@using System.Globalization
@using Cinnamon.Web.Components.Pages
@using Cinnamon.Framework.Enums
@using System.ComponentModel.DataAnnotations;
@inject IJSRuntime JS;
@inject INotificationService NotificationService;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IActivityApiHandler activityApiHandler
@inject IDashboardApiHandler dashboardApiHandler
@inject IDirectStudentApiHandler directStudentApiHandler;

<Container class="update-direct-students-wrapper">
    <div class="header mb-3">
        <div class="title-section align-items-center">
            <button class="back-button m-0 p-0" @onclick="GoToPrev">
                <img src="images/Dashboard/back-icon.png">
            </button>
            <p class="back-text font-20 m-font-18 font-weight-900 mb-0">Add Direct Students</p>
        </div>
    </div>

    <p class="text-description font-16 m-font-12 mb-4 mb-md-5">
        You can update students to your class who enrolled on the platform
    </p>

    <div class="mb-4">
        <p class="font-20 m-font-18 font-weight-900 text-capitalize mb-3 mb-md-4">student information</p>

        <Row class="flex-wrap">
            <Field class="field-name mb-3">
                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Name</FieldLabel>
                <FieldBody>
                    <TextEdit class="color-black-100 font-16 m-font-12" Size="Size.Default" Placeholder="Juan Dela Cruz Jr." />
                </FieldBody>
            </Field>

            <Field class="field-gender mb-3">
                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Gender</FieldLabel>
                <FieldBody>
                    <Select
                        class="form-select color-black-100 text-capitalize font-16 m-font-12" Size="Size.Small" TValue="string">
                        <SelectItem Value='"male"'>male</SelectItem>
                        <SelectItem Value='"female"'>female</SelectItem>
                    </Select>
                </FieldBody>
            </Field>

            <Field class="field-birthmonth mb-3">
                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Birth Month</FieldLabel>
                <FieldBody>
                    <Select class="form-select text-capitalize color-black-100 font-16 m-font-12" Size="Size.Small" TValue="string">
                        <SelectItem Value='"january"'>january</SelectItem>
                        <SelectItem Value='"february"'>february</SelectItem>
                        <SelectItem Value='"march"'>march</SelectItem>
                        <SelectItem Value='"april"'>april</SelectItem>
                        <SelectItem Value='"may"'>may</SelectItem>
                        <SelectItem Value='"june"'>june</SelectItem>
                        <SelectItem Value='"july"'>july</SelectItem>
                        <SelectItem Value='"august"'>august</SelectItem>
                        <SelectItem Value='"september"'>september</SelectItem>
                        <SelectItem Value='"october"'>october</SelectItem>
                        <SelectItem Value='"november"'>november</SelectItem>
                        <SelectItem Value='"december"'>december</SelectItem>
                    </Select>
                </FieldBody>
            </Field>

            <Field class="field-birthyear mb-3">
                <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Year</FieldLabel>
                <FieldBody>
                    <Select 
                        class="form-select text-capitalize color-black-100 font-16 m-font-12" Size="Size.Small" TValue="int">
                        <SelectItem Value="2001">2001</SelectItem>
                        <SelectItem Value="2001">2002</SelectItem>
                        <SelectItem Value="2001">2003</SelectItem>
                        <SelectItem Value="2001">2004</SelectItem>
                    </Select>
                </FieldBody>
            </Field>
        </Row>
    </div>

    <div class="mb-4">
        <p class="font-20 m-font-18 font-weight-900 text-capitalize mb-3 mb-md-4">current activities</p>

        <Row>
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                <div class="accordion" id="accordion-schedules">
                    @foreach (var item in accodionStudents)
                    {
                        <div class="accordion-item">
                            <div class="accordion-header" id="heading-@item.Id">
                                <button class="py-2 accordion-button bg-white-200 font-16 m-font-12" type="button" 
                                    data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id" 
                                    aria-expanded="true" aria-controls="collapse-@item.Id">
                                    @item.Name
                                </button>
                            </div>
                            <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id">
                                <div class="accordion-body">
                                    <p class="font-16 m-font-12 font-weight-900 text-capitalize my-3">activity information</p>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class</FieldLabel>
                                        <FieldBody>
                                            <Select
                                                class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int"
                                                >
                                                <ChildContent>
                                                    <SelectItem Value='0' selected Disabled>select experience</SelectItem>
                                                </ChildContent>
                                            </Select>
                                        </FieldBody>
                                    </Field>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class/Schedule</FieldLabel>
                                        <FieldBody>
                                            <Select
                                                class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int">
                                                <ChildContent>
                                                    <SelectItem Value='0' selected Disabled>select schedule</SelectItem>
                                                </ChildContent>
                                            </Select>
                                        </FieldBody>
                                    </Field>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Payment</FieldLabel>
                                        <FieldBody>
                                            <NumericPicker TValue="decimal?" ShowStepButtons="false" Decimals="0" 
                                                    Placeholder="Amount" Size="Size.Small" class="color-black-100 font-16 m-font-12" Min="1" />
                                        </FieldBody>
                                    </Field>
                                </div>
                            </div>
                        </div>   
                    }
                </div>
            </Column>
        </Row>
    </div>

    <div>
        <p class="font-20 m-font-18 font-weight-900 text-capitalize mb-3 mb-md-4">completed/expired activities</p>

        <Row>
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                <div class="accordion" id="accordion-schedules">
                    @foreach (var item in accodionStudents)
                    {
                        <div class="accordion-item">
                            <div class="accordion-header" id="heading-@item.Id">
                                <button class="py-2 accordion-button bg-white-200 font-16 m-font-12" type="button" 
                                    data-bs-toggle="collapse" data-bs-target="#collapse-@item.Id" 
                                    aria-expanded="true" aria-controls="collapse-@item.Id">
                                    @item.Name
                                </button>
                            </div>
                            <div id="collapse-@item.Id" class="accordion-collapse collapse" aria-labelledby="heading-@item.Id">
                                <div class="accordion-body">
                                    <p class="font-16 m-font-12 font-weight-900 text-capitalize my-3">activity information</p>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class</FieldLabel>
                                        <FieldBody>
                                            <Select
                                                class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int"
                                                >
                                                <ChildContent>
                                                    <SelectItem Value='0' selected Disabled>select experience</SelectItem>
                                                </ChildContent>
                                            </Select>
                                        </FieldBody>
                                    </Field>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Class/Schedule</FieldLabel>
                                        <FieldBody>
                                            <Select
                                                class="form-select text-capitalize font-16 m-font-12 color-black-100" Size="Size.Small" TValue="int">
                                                <ChildContent>
                                                    <SelectItem Value='0' selected Disabled>select schedule</SelectItem>
                                                </ChildContent>
                                            </Select>
                                        </FieldBody>
                                    </Field>

                                    <Field class="mb-3">
                                        <FieldLabel class="font-weight-700 mb-1 font-16 m-font-12">Payment</FieldLabel>
                                        <FieldBody>
                                            <NumericPicker TValue="decimal?" ShowStepButtons="false" Decimals="0" 
                                                    Placeholder="Amount" Size="Size.Small" class="color-black-100 font-16 m-font-12" Min="1" />
                                        </FieldBody>
                                    </Field>
                                </div>
                            </div>
                        </div>   
                    }
                </div>

                <div class="text-end mt-4">
                    <Button class="px-4 text-capitalize font-16 m-font-12 bg-orange-100 color-white-100 hover-color-white">
                        Save
                    </Button>
                </div>
            </Column>
        </Row>
    </div>
</Container>

@code 
{
    [Parameter]
    public int StudentId {get; set;}

    private string token = string.Empty;
    private IList<string> genders = new List<string>();
    private IList<int> years = new List<int>();
    private IList<string> months = new List<string>();
    private IList<Activity> activities = new List<Activity>();
    private IList<ActivitySchedule> scheduleList = new List<ActivitySchedule>();
    private IList<ActivitySchedule> schedules = new List<ActivitySchedule>();
    private Student student = new Student();
    private Validations? studentListFormValidation;

    private List<Student> accodionStudents {get; set;} = new();

    protected override void OnInitialized()
    {
        accodionStudents.Add(new Student {
            Id = 1,
            Name = "Student 1"
        });

        accodionStudents.Add(new Student {
            Id = 2,
            Name = "Student 2"
        });

        accodionStudents.Add(new Student {
            Id = 3,
            Name = "Student 3"
        });
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // gender
            genders.Add("male");
            genders.Add("female");
            // minimum years
            var minYear = DateTime.Now.Year - 4;
            for (int i = 1900; i <= minYear; i++)
            {
                years.Add(i);
            }
            // months
            months.Add("january");
            months.Add("february");
            months.Add("march");
            months.Add("april");
            months.Add("may");
            months.Add("june");
            months.Add("july");
            months.Add("august");
            months.Add("september");
            months.Add("october");
            months.Add("november");
            months.Add("december");

            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (token == null)
            {
                // don't have current user login
                NavigationManager.NavigateTo("explore");
                return;
            }

            // Get Activities
            await GetActivities();

            await LoadStudent();

            await LoadSchedules(student.ActivityId);
        }
        catch (Exception ex)
        {
            ex.Message.ToString();
        }
    }

    private async Task GetActivities()
    {
        var activityRes = await activityApiHandler.GetOwnedActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetOwnedActivitiesArgs
        {
            IncludeAtivitySchedules = true,
            IsActive = true
        }, token);

        if (activityRes.Succeeded && activityRes.Result != null && activityRes.Result.IsSuccess)
        {
            activities = activityRes.Result.Result.Where(a => a.ExperienceCreationType == Enums.ExperienceCreationType.GeneralExperience).OrderBy(a => a.ActivityId).Select(a =>
            {
                // map only required fields
                return new Activity
                    {
                        ActivityId = a.ActivityId,
                        IsPublished = a.IsPublished,
                        Title = a.Title
                    };
            }).ToList();
        }

        foreach (var activityResult in activityRes.Result.Result)
        {
            foreach (var activitySchedule in activityResult.ActivitySchedules)
            {
                scheduleList.Add(new ActivitySchedule
                {
                    Id = activitySchedule.Id,
                    IsActiveSchedule = activitySchedule.IsActiveSchedule,
                    ActivityId = activityResult.ActivityId,
                    Name = activitySchedule.Name,
                    DateTime = activitySchedule.DateTime,
                    UnitPrice = activitySchedule.UnitPrice,
                    PerUnit1 = activitySchedule.PerUnit1,
                    PerUnit2 = activitySchedule.PerUnit2,
                    PriceUnit1 = activitySchedule.PriceUnit1,
                    PriceUnit2 = activitySchedule.PriceUnit2,
                    Price = activitySchedule.Price,
                    IsSetSession = activitySchedule.IsSetSession,
                    SessionName = activitySchedule.SessionName,
                    HasExpiration = activitySchedule.HasExpiration,
                    StartDate = activitySchedule.StartDate
                });
            }
        }
    }

    private async Task OnFilterValueChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value.ToString(), out int selectedValue))
        {
            if (selectedValue > 0)
            {
                student.ActivityId = selectedValue;
                await LoadSchedules(selectedValue);
                student.ScheduleId = 0;
            }
        }
    }

    private Task LoadSchedules(int activityId)
    {
        if(activityId > 0)
        {
            schedules = scheduleList.Where(a => a.ActivityId == activityId).ToList();
        }
        return Task.CompletedTask;
    }

    private void NavigateToEnrolleeMasterlist()
    {
        NavigationManager.NavigateTo("/maker/dashboard/managestudents/enrollee-masterlist");
    }

    private async Task SaveStudents()
    {
        try
        {
            bool fieldsValid = await studentListFormValidation?.ValidateAll();
            if(!fieldsValid) return;

            var result = await directStudentApiHandler.UpdateStudent(new Framework.ApiCommand.ApiCore.DirectStudent.Request.UpdateStudentArgs {
                ActivityId = student.ActivityId,
                Amount = student.Payment ?? 0,
                BirthMonth = student.BirthMonth,
                BirthYear = student.BirthYear,
                Gender = student.Gender,
                Name = student.Name,
                ScheduleId = student.ScheduleId,
                StudentId = StudentId,
            }, token);

            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new Exception("An error occured");
            }

            await NotificationService.Success("Success! Student updated.", "Success");

            NavigateToEnrolleeMasterlist();
        }
        catch (Exception)
        {
            await NotificationService.Error("An error occured when updating direct student.", "Error");
        }
    }

    private async Task LoadStudent()
    {
        var result = await directStudentApiHandler.DirectStudent(StudentId, token);

        if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
        {
            await NotificationService.Error(result.Result?.ErrorInfo?.Message ?? result.Message, "Error");
            NavigateToEnrolleeMasterlist();
            return;
        }

        var studentToUpdate = result.Result.Result;
        student = new Student {
            BirthMonth = studentToUpdate.DirectStudentInfo.BirthMonth,
            BirthYear = studentToUpdate.DirectStudentInfo.BirthYear,
            Gender = studentToUpdate.DirectStudentInfo.Gender,
            Name = studentToUpdate.DirectStudentInfo.Name,
            Id = studentToUpdate.DirectStudentInfo.Id,
            ActivityId = studentToUpdate.DirectStudentSession.ActivityId,
            Payment = studentToUpdate.DirectStudentPayment.Amount,
            ScheduleId = studentToUpdate.DirectStudentSession.ScheduleId
        };
    }

    private async Task GoToPrev()
    {
        await JS.InvokeVoidAsync("MyLib.Utils.navigation.back");
    }

    public class Student
    {

        public int Id { get; set; }

        [Required(ErrorMessage = "Name is required")]
        public string Name { get; set; }

        [Required(ErrorMessage = "Gender is required")]
        public string Gender { get; set; }

        [Required(ErrorMessage = "Birth Month is required")]
        public string BirthMonth { get; set; }

        [Range(1900, 2100, ErrorMessage = "Year must be between 1900 and 2100")]
        public int BirthYear { get; set; }

        [Required(ErrorMessage = "Class is required")]
        public int ActivityId { get; set; }

        [Required(ErrorMessage = "Schedule is required")]
        public int ScheduleId { get; set; }

        [Required(ErrorMessage = "The payment field is required.")]
        [Range(1, int.MaxValue, ErrorMessage = "The payment field is required.")]
        public decimal? Payment { get; set; } = null;

        public bool Valid
        {
            get
            {
                return !string.IsNullOrEmpty(Name) &&
                       !string.IsNullOrEmpty(Gender) &&
                       !string.IsNullOrEmpty(BirthMonth) &&
                       ActivityId != 0 &&
                       ScheduleId != 0 &&
                       Payment != 0;
            }
        }

    }
}

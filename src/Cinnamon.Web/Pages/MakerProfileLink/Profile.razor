@page "/maker/profile/{Id}"
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Modals;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using System.Security.Claims
@inject IModalService modal
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler;
@inject IActivityApiHandler activityApiHandler;

@if (customerDetail != null)
{
    <section class="py-3 mt-5 profile-content">
        <Container>
            <Row>
                <Column class="profile-column-card" ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Card class="customer-profile-card" Border="Border.Is0" Padding="Padding.Is3">
                        <CardHeader Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0.FromTop">
                            <Figure Width="Width.Max100" Border="Border.RoundedCircle" Size="FigureSize.Is128x128" Margin="Margin.IsAuto.OnX.Is0.OnY" Display="Display.Block">
                                <CardImage Source=@ImageSource Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                            </Figure>
                        </CardHeader>
                        <CardBody Border="Border.Is0" Padding="Padding.Is3.OnY">
                            <CardTitle TextAlignment="TextAlignment.Center">
                                <p class="text-capitalize fw-bold m-0 mb-1 font-30">@customerDetail.FirstName @customerDetail.LastName</p>
                                @if (customerDetail.IsVerified)
                                {
                                    <p class="text-color-8080 my-1 font-24">
                                        <Icon Name="IconName.ShieldAlt" IconStyle="IconStyle.Solid" />
                                        <span class="text-capitalize">verified user</span>
                                    </p>
                                }
                                <p class="text-color-8080 font-16 mb-1">Use the badge to prove your identify to others.</p>
                            </CardTitle>
                        </CardBody>
                    </Card>
                </Column>
                <Column class="profile-details" ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                    <Div Padding="Padding.Is5.OnX.OnDesktop" Margin="Margin.Is2.FromTop.OnMobile">
                        <Div>
                            <p class="m-0 font-30 fw-bold">Hi, I'm <span class="text-capitalize">@customerDetail.FirstName</span></p>
                            <p class="m-0 text-color-8080 font-14">Joined in 2022</p>
                        </Div>
                        <Div Display="Display.Flex" Flex="Flex.AlignItems.Center.JustifyContent.Between">
                            <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                                <p class="my-3 fw-bold font-18">About you</p>
                            </Div>
                        </Div>
                        <p class="m-0 text-color-8080 font-16">@customerDetail.About</p>
                    </Div>
                </Column>
            </Row>
        </Container>
    </section>

    <section class="mt-5 customer-profile-details">
        <Container>
            <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Name="maker-experience" TextTransform="TextTransform.Capitalize">created experiences</Tab>
                </Items>
                <Content>
                    <TabPanel Name="maker-experience">
                         <OngoingExperience Activities="activities" /> 
                    </TabPanel>
                </Content>
            </Tabs>
        </Container>
    </section>
}

@code 
{
    [Parameter]
    public string Id { get; set; }

    public List<Activity> activities = new List<Activity>();

    private MakerExperiences makerExperiences;

    private string selectedTab = "maker-experience";

    private string ImageSource { get; set; } = "images/Profile/user";

    public CustomerProfile customerDetail = new CustomerProfile();

    //public CustomerModel Customer { get; set; }

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        //Get Customer By Id
        bool isIdUsed = int.TryParse(Id.Trim().ToString(), out int intId);
        var customer = isIdUsed ? await accountApiHandler.GetCustomerById(intId) : await accountApiHandler.GetMakerDetailByHandler(Id.Trim());
        if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
        {
            var args = customer.Result.Result;
            customerDetail = new CustomerProfile
                {
                    FirstName = args.FirstName,
                    LastName = args.LastName,
                    Id = args.Id,
                    IsMaker = args.IsMaker,
                    ProfilePath = args.ProfileImg,
                    IsVerified = args.IsVerified,
                    About = args.About,
                };
            ImageSource = customerDetail.ProfilePath;
        }
        //Get All Activities
        var ActivityListData = await activityApiHandler.GetAllActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetAllActivitiesArgs
            {
                IncludeActivityAddress = true,
                IncludeActivityDescription = true,
                IncludeActivityImages = true,
                IncludeAtivitySchedules = true
            });
        if (ActivityListData.Succeeded && ActivityListData.Result != null && ActivityListData.Result.IsSuccess)
        {
            activities = ActivityListData.Result.Result.Select(r =>
            {
                return new Activity
                    {
                        ActivityId = r.ActivityId,
                        ExperienceTypeId = r.ExperienceTypeId,
                        ExperienceCategoryId = r.ExperienceCategoryId,
                        SubCategoryId = r.SubCategoryId,
                        Title = r.Title,
                        Description = r.Description,
                        Price = r.Price,
                        ScheduleIndicator = r.ScheduleIndicator,
                        Remarks = r.Remarks,
                        IsPublished = r.IsPublished,
                        Address1 = r.Address1,
                        Address2 = r.Address2,
                        District = r.District,
                        City = r.City,
                        SpecificsYouWillProvide = r.SpecificsYouWillProvide,
                        CustomerBringWithThem = r.CustomerBringWithThem,
                        AdditionalRequirements = r.AdditionalRequirements,
                        ActivityLevel = r.ActivityLevel,
                        SkillLevel = r.SkillLevel,
                        MinimumAge = r.MinimumAge,
                        CanAdultsJoin = r.CanAdultsJoin,
                        CreatedBy = r.CreatedBy,
                        ActivitySchedules = r.ActivitySchedules.Select(e =>
                        {
                            return new ActivitySchedule
                            {
                                Id = e.Id,
                                Name = e.Name,
                                PerUnit1 = e.PerUnit1,
                                PerUnit2 = e.PerUnit2,
                                Price = e.Price,
                                PriceUnit1 = e.PriceUnit1,
                                PriceUnit2 = e.PriceUnit2,
                                UnitPrice = e.UnitPrice
                            };
                        }).ToList(),
                        Images = r.Images.Select(i =>
                        {
                            return new ActivityImage
                            {
                                Id = i.Id,
                                ImageSrc = i.ImageSrc,
                                Name = i.Name
                            };
                        }).ToList(),
                    };
            }).ToList();
        }
        //Get Maker Activities
        activities = activities.Where(p => p.CreatedBy == customerDetail.Id).ToList();
        //var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        //var currentCustomer = await signedCustomer.ExecuteAsync(new Core.Module.CustomerService.Interactors.CurrentLogin { User = user});
        
        //var currentCustomer = await CoreDI.DataStore.Customers.GetCustomerById(Id);
        ////Get Customer Information
        //Model = new();
        //Model.Customer = currentCustomer;
        //ImageSource   = Model.Customer.ProfilePath;

        //Get Customer Activities


        //Get Maker Activities
        //var customer = currentCustomer;
        //activities = (await CoreDI.DataStore.Activities.GetActivityByCreatedId(customer.Id)).OrderBy(i => i.Id).ToList();
      
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init", "Experience Details Page Loaded");
    }



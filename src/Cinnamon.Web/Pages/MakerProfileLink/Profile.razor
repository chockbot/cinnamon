@page "/maker/profile/{Id}"
@using Cinnamon.Web.Components.Pages.Customer.Profile
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Modals;
@using Cinnamon.Web.Models
@using Cinnamon.Web.Models.Customer
@using Cinnamon.Web.Models.Entities
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using System.Security.Claims
@using System.Text.RegularExpressions
@using Cinnamon.Web.Components.Pages;
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Threading.Tasks
@inject IModalService modal
@inject IJSRuntime jsRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IAccountApiHandler accountApiHandler
@inject IActivityApiHandler activityApiHandler
@inject IDashboardApiHandler dashboardApiHandler

<PageTitle>Activity Provider Profile - @MakerFullname | CinnamonPH</PageTitle>
<SeoMeta Subject="Activity Provider Profile" Title="Activity Provider Profile"
         Url='@($"/maker/profile/{Id}")' Description="@(customerDetail?.About ?? string.Empty)"
         Image="@(customerDetail?.ProfilePath ?? string.Empty)" />

@if (activities != null)
{
    <Div ElementId="#b-animate">
        <Animate Anchor="#b-animate" Auto Animation="Animations.FadeIn" DelayMilliseconds="500">
            <div id="alertContainer" class="alertContainer">
                <div id="alertMessage" class="alertMessage">Copied to clipboard!</div>
            </div>
            <section class="py-3 mt-5 profile-content">
                <Container>
                    <Row>
                        <Column class="profile-column-card" ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                            <Card class="customer-profile-card" Border="Border.Is0" Padding="Padding.Is3">
                                <CardHeader Border="Border.Is0" Background="Background.Transparent" Padding="Padding.Is0.FromTop">
                                    <button class="btn btn-copy" @onclick="() => CopyToClipboard()">
                                        <img src="images/copytoclipboard.png">
                                    </button>
                                    <Figure>
                                        <CardImage Source=@ImageSource Alt="Profile" Class="card-image-full" Border="Border.RoundedCircle.Is2.White"></CardImage>
                                    </Figure>
                                </CardHeader>
                                <CardBody Border="Border.Is0" Padding="Padding.Is3.OnY">
                                    <CardTitle TextAlignment="TextAlignment.Center">
                                        <p class="text-capitalize fw-bold m-0 mb-1 font-30">@customerDetail.FirstName @customerDetail.LastName</p>
                                        <p class="text-color-8080 font-16 mb-1">Use the badge to prove your identify to others.</p>
                                        @switch (customerDetail.IsVerified)
                                        {
                                            case 0:
                                                <p class="text-color-8080 my-1 font-24">
                                                    <img class="img-not" src="images/not-icon.png" />
                                                    <span class="span-not">Not Verified</span>
                                                </p>
                                                break;
                                            case 1:
                                                <p class="text-color-8080 my-1 font-24">
                                                    <img class="img-pending" src="images/PendingIcon.png" />
                                                    <span class="span-pending">Pending Verification</span>
                                                </p>
                                                break;
                                            case 2:
                                                <p class="text-color-8080 my-1 font-24">
                                                    <img class="img-verified" src="images/Badges/VERIFIED.svg" />
                                                    <span class="span-verified">Verified</span>
                                                </p>
                                                break;
                                            default:
                                                break;
                                        }
                                    </CardTitle>
                                </CardBody>
                            </Card>
                        </Column>
                        <Column class="profile-details" ColumnSize="ColumnSize.Is9.OnDesktop.Is6.OnTablet.Is12.OnMobile">
                            <Div Padding="Padding.Is5.OnX.OnDesktop" Margin="Margin.Is2.FromTop.OnMobile">
                                <Div>
                                    <p class="m-0 font-30 fw-bold">Hi, I'm <span class="text-capitalize">@customerDetail.FirstName</span></p>
                                    <p class="m-0 text-color-8080 font-14">Joined in @customerDetail.DateJoined.Year</p>
                                </Div>
                                <Div Display="Display.Flex" Flex="Flex.AlignItems.Center.JustifyContent.Between">
                                    <Div Display="Display.Flex" Flex="Flex.AlignItems.Center">
                                        <p class="my-3 fw-bold font-18">About you</p>
                                    </Div>
                                </Div>
                                <p class="m-0 text-color-8080 font-16">@customerDetail.About</p>
                                @*Activity Provider Badges*@
                                @if (customerDetail.IsVerified == 2)
                                {
                                    int cnt = 0;
                                    <p class="@displayBadge my-3 fw-bold font-18">Badges</p>
                                    <div class="@displayBadge justify-content-center">
                                        <Card class="badges-column">
                                            <CardBody Flex="Flex.AlignContent.Center">
                                                @if (customerDetail.IsVerified == 2)
                                                {
                                                    cnt++;
                                                    <Tooltip Multiline=true Text="For uploading and completing all identification requirements." Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="images/Badges/VERIFIED.svg" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>Verified</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (customerDetail.IsOG == true)
                                                {
                                                    cnt++;
                                                    <Tooltip Multiline=true Text="For being part of the alpha and beta testing." Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="images/Badges/OG.svg" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>OG</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (customerDetail.IsOfficial == true)
                                                {
                                                    cnt++;
                                                    <Tooltip Multiline=true Text="Legitimate experience provider in the platform." Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="images/Badges/OFFICIAL PARTNER.svg" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>Official Partner</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (MakerCompletedStudent >= 10 && MakerCompletedStudent < 25)
                                                {
                                                    cnt++;
                                                    var rare = badges.Where(r => r.Id == 1).FirstOrDefault();
                                                    <Tooltip Multiline=true Text="@rare.Description" Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="@rare.ImgScr" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>@rare.Name</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (MakerCompletedStudent >= 25 && MakerCompletedStudent < 100)
                                                {
                                                    cnt++;
                                                    var epic = badges.Where(r => r.Id == 2).FirstOrDefault();
                                                    <Tooltip Multiline=true Text="@epic.Description" Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="@epic.ImgScr" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>@epic.Name</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (MakerCompletedStudent >= 100)
                                                {
                                                    cnt++;
                                                    var legendary = badges.Where(r => r.Id == 3).FirstOrDefault();
                                                    <Tooltip Multiline=true Text="@legendary.Description" Flex="Flex.AlignContent">
                                                        <img class="verified-logo" src="@legendary.ImgScr" />
                                                        <div class="badge-name @displayText">
                                                            @if (cnt <= 3)
                                                            {
                                                                <p>@legendary.Name</p>
                                                            }
                                                            else
                                                            {
                                                                displayText = "d-none";
                                                            }
                                                        </div>
                                                    </Tooltip>
                                                }
                                                @if (cnt == 0)
                                                {
                                                    displayBadge = "d-none";
                                                }
                                            </CardBody>
                                        </Card>
                                    </div>
                                }
                                else
                                {
                                    displayBadge = "d-none";
                                }
                            </Div>
                        </Column>
                    </Row>
                </Container>
            </section>

            <section class="mt-5 customer-profile-details">
                <Container>
                    <Tabs Margin="Margin.Is3.FromTop" SelectedTab="@selectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                        <Items>
                            <Tab Name="maker-experience" TextTransform="TextTransform.Capitalize">created experiences</Tab>
                        </Items>
                        <Content>
                            <TabPanel Name="maker-experience">
                                <MakerExperiences Activities="activities" />
                            </TabPanel>
                        </Content>
                    </Tabs>
                </Container>
            </section>
        </Animate>
    </Div>
}


@code
{
    IJSObjectReference module;

    [Parameter]
    public string Id { get; set; }

    public List<Activity> activities = new List<Activity>();

    private MakerExperiences makerExperiences;

    private string selectedTab = "maker-experience";

    private string ImageSource { get; set; } = "images/Profile/user";

    public CustomerProfile customerDetail = new CustomerProfile();
    public List<BadgeList> badges = new List<BadgeList>();

    public int MakerId { get; set; }

    public string displayBadge = "d-flex";

    public string displayText = "d-flex";

    public int MakerOngoingStudent { get; set; }

    public int MakerCompletedStudent { get; set; }

    //public CustomerModel Customer { get; set; }

    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await FetchMakerBadges();
            //Get Customer By Id
            bool isIdUsed = int.TryParse(Id, out int intId);
            var customer = isIdUsed ? await accountApiHandler.GetCustomerById(intId) : await accountApiHandler.GetMakerDetailByHandler(Id.Trim());
            if (customer.Succeeded && customer.Result != null && customer.Result.IsSuccess)
            {
                var args = customer.Result.Result;
                customerDetail = new CustomerProfile
                    {
                        FirstName = args.FirstName,
                        LastName = args.LastName,
                        Id = args.Id,
                        IsMaker = args.IsMaker,
                        ProfilePath = args.ProfileImg,
                        IsVerified = args.IsVerified,
                        IsOG = args.IsOG,
                        IsOfficial = args.IsOfficial,
                        About = args.About,
                        DateJoined = args.DateJoined,
                        Email = args.Email
                    };
                ImageSource = customerDetail.ProfilePath;
            }
            else
            {
                NavigationManager.NavigateTo("/page-not-found");
            }
            //Get Maker Activity
            var ActivityList = await activityApiHandler.GetMakerActivities(new Framework.ApiCommand.ApiCore.Activity.Request.GetMakerActivitiesArgs
                {
                    CustomerId = customerDetail.Id,
                    IncludeActivityAddress = true,
                    IncludeActivityDescription = true,
                    IncludeActivityImages = true,
                    IncludeAtivitySchedules = true,
                    IsActive = true,
                    IncludeStudents = true,
                    IncludeCustomer = true
                });
            if (ActivityList.Succeeded && ActivityList.Result != null && ActivityList.Result.IsSuccess)
            {
                if (ActivityList.Result.Result.Count() > 0)
                {
                    activities = ActivityList.Result.Result.Select(a =>
                    {
                        return new Activity
                            {
                                ActivityId = a.ActivityId,
                                District = a.District,
                                City = a.City,
                                CityName = a.CityName,
                                Region = a.Region,
                                RegionName = a.RegionName,
                                Barangay = a.Barangay,
                                BarangayName = a.BarangayName,
                                Address1 = a.Address1,
                                Address2 = a.Address2,
                                ExperienceTypeId = a.ExperienceTypeId,
                                Description = a.Description,
                                IsPublished = a.IsPublished,
                                Price = a.Price,
                                Title = a.Title,
                                IsSetSession = a.IsSetSession,
                                SessionName = a.SessionName,
                                IsNew = a.IsNew,
                                OngoingStudents = a.OngoingStudents,
                                CompletedStudents = a.CompletedStudents,
                                Images = a.Images.Select(i =>
                    {
                                return new ActivityImage
                                {
                                    Id = i.Id,
                                    ImageSrc = i.ImageSrc,
                                    Name = i.Name
                                };
                            }).ToList(),
                                Owner = new CustomerProfile
                                {
                                    IsVerified = a.Owner.IsVerified
                                },
                                ActivitySchedules = a.ActivitySchedules.Select(e =>
                {
                            return new ActivitySchedule
                            {
                                Id = e.Id,
                                Name = e.Name,
                                PerUnit1 = e.PerUnit1,
                                PerUnit2 = e.PerUnit2,
                                Price = e.Price,
                                PriceUnit1 = e.PriceUnit1,
                                PriceUnit2 = e.PriceUnit2,
                                UnitPrice = e.UnitPrice
                            };
                        }).ToList(),
                            };
                    }).ToList();
                }
            }
            MakerOngoingStudent = activities.Sum(x => x.OngoingStudents);
            MakerCompletedStudent = activities.Sum(x => x.CompletedStudents);
        }
        catch (Exception e)
        {
            NavigationManager.NavigateTo("/page-not-found");
            throw e;
        }
    }

    private string MakerFullname
    {
        get
        {
            if (customerDetail == null) return string.Empty;

            return customerDetail.FirstName?.ToUpper() + " " + customerDetail.LastName?.ToUpper();
        }
    }
    private async Task FetchMakerBadges()
    {
        //Get Badges
        var badgeList = await dashboardApiHandler.GetAllBadge();
        if (badgeList.Succeeded && badgeList.Result != null && badgeList.Result.IsSuccess)
        {
            badges = badgeList.Result.Result.Select(b =>
            {
                return new BadgeList
                    {
                        Id = b.Id,
                        Name = b.Name,
                        Description = b.Description,
                        NumberOfStudent = b.NumberOfStudent,
                        NumberOfCompleted = b.NumberOfCompleted,
                        NumberOfReviews = b.NumberOfReviews,
                        ImgScr = b.ImgScr
                    };
            }).ToList();
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await jsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.profile.init", "Experience Details Page Loaded");
    }
    private async Task CopyToClipboard()
    {
        await Task.Run(() => module.InvokeVoidAsync("copyToClipboard", NavigationManager.Uri));
    }

}

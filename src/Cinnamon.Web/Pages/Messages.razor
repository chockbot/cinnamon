    private async Task Send()
    {
        var connectionIds = string.Empty;

        foreach (var item in chatMembers)
        {
            foreach (var connectionId in item.ConnectionIds)
            {
                connectionIds = connectionIds + "[~~~]" + connectionId;
            }
        }

        if (hubConnection is not null && !string.IsNullOrEmpty(messageInput.Trim()))
        {
            if (IsConnected)
            {
                await hubConnection.SendAsync("SendMessage", $"{selectedChatRoomId}|{currentUserConnectionId}|{currentUserId}|{currentUserLastName}|{currentUserFirstName}|{currentUserProfilePath}|{toUserId}|{messageInput}|{chatMateGroupName}|{(int)chatMateChatType}|{(int)chatHistoryType}|{chatMateChatName}|{connectionIds}");
            }
            else
            {
                await hubConnection.StartAsync();

                if (IsConnected)
                {
                    await hubConnection.SendAsync("SendMessage", $"{selectedChatRoomId}|{currentUserConnectionId}|{currentUserId}|{currentUserLastName}|{currentUserFirstName}|{currentUserProfilePath}|{toUserId}|{messageInput}|{chatMateGroupName}|{(int)chatMateChatType}|{(int)chatHistoryType}|{chatMateChatName}|{connectionIds}");
                }
            }
        }

        messageInput = string.Empty;
    }


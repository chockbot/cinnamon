    [JSInvokable]
    public async Task SendMessageAsync(string message)
    {
        messageInput = message;
        chatHistoryType = ChatHistoryType.Message;

        if (chatMateHasTemporaryChatRoomId)
        {
            var result = await chatApiHandler.CreateChatRoom(new Framework.ApiCommand.ApiCore.ChatRoom.Request.CreateChatRoomArgs
            {
                FromUserId = currentUserId,
                ToUserId = toUserId,
                ChatType = Framework.Enums.Enums.ChatType.PrivateMessage,
                GroupName = string.Empty,
                ChatName = string.Empty
            }, Token);

            var fromConnectionResult = await chatApiHandler.GetChatConnectionByCustomer(new Framework.ApiCommand.ApiCore.ChatConnection.Request.GetChatConnectionByCustomerArgs
                {
                    CustomerId = currentUserId
                }, Token);

            var toConnectionResult = await chatApiHandler.GetChatConnectionByCustomer(new Framework.ApiCommand.ApiCore.ChatConnection.Request.GetChatConnectionByCustomerArgs
                {
                    CustomerId = toUserId
                }, Token);

            if ((fromConnectionResult.Succeeded && fromConnectionResult.Result != null && fromConnectionResult.Result.IsSuccess) && (toConnectionResult.Succeeded && toConnectionResult.Result != null && toConnectionResult.Result.IsSuccess))
            {
                chatMembers = new List<ChatMember>();

                chatMembers.AddRange(new List<ChatMember>
                {
                    new ChatMember
                    {
                        FromUserId = currentUserId,
                        ConnectionIds = fromConnectionResult.Result.Result.Select(c => c.ConnectionId).ToList()
                    },
                    new ChatMember
                    {
                        FromUserId = toUserId,
                        ConnectionIds = toConnectionResult.Result.Result.Select(c => c.ConnectionId).ToList()
                    }
                });
            }

            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var newChatRoomId = result.Result.Result.ChatRoomId;

                chatRooms.FirstOrDefault(c => c.ChatRoomId == selectedChatRoomId).ChatRoomId = newChatRoomId;
                chatRooms.FirstOrDefault(c => c.ChatRoomId == newChatRoomId).HasTemporaryChatRoomId = false;

                selectedChatRoomId = newChatRoomId;



                await Send();
            }
        }
        else
        {
            await Send();
        }
    }


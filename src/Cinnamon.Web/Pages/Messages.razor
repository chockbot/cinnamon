@page "/messages/"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Microsoft.AspNetCore.SignalR.Client;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using System.Security.Claims;
@using Cinnamon.Web.Models.Entities;
@using System.Diagnostics;
@using static Cinnamon.Framework.Enums.Enums;
@inject IChatApiHandler chatApiHandler;
@inject IAccountApiHandler accountApiHandler;

@inject IJSRuntime jsRuntime;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Messages> logger

@implements IDisposable

<PageTitle>@Title | CinnamonPH</PageTitle>
<SeoMeta Title="@Title" Subject="@Title" Url="/Messages" />

<input type="password" name="password_fake" id="password_fake" value="" style="display:none;" />

<div class="modal fade remove-modal" tabindex="-1" role="dialog" id="leaveGroupModal" style="z-index:99999;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <label class="guide-title text-center">
                    Leave Group?
                </label>
                <button type="button" class="btn-close" id="leaveGroupModal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                You will stop receiving messages from this conversation and people will see that you left.
            </div>
            <div class="modal-footer">
                <button type="button" class="border-1 btn-cancel" data-dismiss="modal">Cancel</button>
                <button type="button" class="border-0 btn-confirm-leave">Leave Group</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="add-member-modal" style="z-index:99999;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <label class="guide-title text-center">
                   Add Members
                </label>
                <button type="button" class="btn-close" id="btn-close-add-member-modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="input-group border rounded-pill p-1">
                        <div id="add-members-input" contenteditable="true" role="textbox" spellcheck="true" tabindex="0" style="" data-lexical-editor="true" data-text="Search Members">
                        </div>
                        <div class="input-group-append border-0">
                            <button id="button-addon3" type="button" class="btn btn-link text-success" style="border-radius:50%"><i class="fa fa-search"></i></button>
                        </div>
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <table class="tbl-members">
                        @if (formerChatMembers.Count > 0)
                        {
                            @foreach (var item in FileteredFormerChatMembers)
                            {
                                <tr>
                                    <td style="width: 10%;">
                                        <img src="@item.FromProfilePath" class="chatroom-profile-picture" />
                                    </td>
                                    <td>
                                        @item.FromFirstName  @item.FromLastName
                                    </td>
                                    <td align="right">
                                        <input class="form-check-input chk-select-member" type="checkbox" @bind="item.IsSelected" @onclick="(() => ToggleChatMember(item))">
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>
                                   No members to add.
                                </td>
                            </tr>
                        }
                       
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                @{
                    var formerChatMembersCount = formerChatMembers.Count(f => f.IsSelected);
                    <button type="button" class="border-0 btn-add-member @(formerChatMembersCount == 0 ? "btn-add-member-disabled" : "btn-add-member-enabled")" @onclick="AddMemberToGroup" disabled="@(formerChatMembersCount == 0 ? true : false)">Add Members</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="messages-top-row px-4">
    <div class="app-name col-lg-3 col-md-2">
        <a href="/explore" class="app-name">@Resources.App.appName</a>
    </div>
</div>

<div class="messages-container row flex-nowrap">
    <div class="sidebar-messages left-sidebar messages-section d-xl-block d-lg-block d-md-block d-sm-block @messagesSectionDisplayStyle">
        <div class="message-title-section">
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-6">
                    <label class="message-title">
                        Messages
                    </label>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6 col-6 add-message-section">
                    @if (chatRooms.Count > 0 && chatMateChatType == ChatType.GroupChat && currentUserChatMemberType == ChatMemberType.ActivityProvider)
                    {
                        <img src="images/messages/add-message.svg" id="img-add-member" @onclick="(() => GetFormerChatMembersByChatRoomId(selectedChatRoomId))" />
                    }
                </div>
            </div>
        </div>
        <div class="search-section">
            @if (chatRooms.Count > 0)
            {
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="input-group border rounded-pill p-1">
                            <div id="chatroom-search-input" contenteditable="true" role="textbox" spellcheck="true" tabindex="0" style="" data-lexical-editor="true" data-text="Search Chatrooms">
                            </div>
                            <div class="input-group-append border-0">
                                <button id="button-addon3" type="button" class="btn btn-link text-success" style="border-radius:50%"><i class="fa fa-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="chatroom-section">
            @if (chatRooms.Count > 0)
            {
                foreach (var chatRoom in FilteredChatRooms)
                {
                    var fullName = $"{chatRoom.FromFirstName} {chatRoom.FromLastName}";
                    <div class="row @GetNewMessageStyle(chatRoom.HasNewMessage) @GetActiveStyle(selectedChatRoomId == chatRoom.ChatRoomId) chatroom-list-item" @onclick="(() => GetChatHistoryByChatRoomId(chatRoom.ChatRoomId, true, false))">
                        <input type="hidden" value="@chatRoom.DateCreated" id="date-created" />
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="last-update-date">
                                @chatRoom.DateCreated.ToString("hh:mm tt")
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-2 col-sm-2 col-2 chatroom-profile-picture-section">
                            @if (chatRoom.ChatType == Framework.Enums.Enums.ChatType.PrivateMessage)
                            {
                                <img src="@chatRoom.FromProfilePath" class="chatroom-profile-picture" />
                                @if (!string.IsNullOrEmpty(chatRoom.FromConnectionId))
                                {
                                    <span class="logged-in"></span>
                                }
                            }
                            else
                            {
                                <img src="@chatRoom.FromProfilePath" class="chatroom-profile-picture" />
                                @if (!string.IsNullOrEmpty(chatRoom.GroupName))
                                {
                                    <span class="logged-in"></span>
                                }
                            }
                            
                        </div>
                        <div class="col-lg-10 col-md-10 col-sm-10 col-10 chatroom-name-section">
                            <div class="chatroom-name text-capitalize">
                                @if (chatRoom.ChatType == Framework.Enums.Enums.ChatType.PrivateMessage)
                                {
                                    @fullName
                                }
                                else
                                {
                                    @chatRoom.ChatName
                                }
                            </div>
                            <div class="last-message">
                                @chatRoom.Message
                            </div>
                            @if (chatRoom.HasNewMessage)
                            {
                                <span class="has-new-message-badge">
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="center-messages chat-section d-xl-block d-lg-block d-md-block d-sm-block @chatSectionDisplayStyle">
        <div class="row" style="@SetPlaceholderStyle(isLoading)">
            <div class="chat-profile-section">
                <div class="row">
                    <div class="col-lg-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                        <div class="row">
                            <div class="col-lg-1 chatmate-profile-picture-section placeholder-glow">
                                <span class="placeholder col-9 chatmate-profile-picture"></span>
                            </div>
                            <div class="col-lg-10 placeholder-glow">
                                <div class="chat-profile-name">
                                    <span class="placeholder col-9"></span>
                                </div>
                                <div class="last-seen">
                                    <span class="placeholder col-9"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 chat-profile-info-icon-section d-xl-block d-lg-block d-md-block d-sm-block d-none placeholder-glow">
                        <span class="placeholder col-1"></span>
                    </div>
                    <div class="col-lg-12 d-block d-sm-none d-md-none d-lg-none d-xl-none placeholder-glow" style="padding: 0px;">
                        <table>
                            <tbody>
                                <tr>
                                    <td>
                                        <span class="placeholder col-9"></span>
                                    </td>
                                    <td>
                                        <span class="placeholder col-9"></span>
                                    </td>
                                    <td class="chat-profile-info-icon-section">
                                        <span class="placeholder col-1"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="conversation-section">
                <ul class="list-unstyled d-flex flex-column" id="chat-history-list">
                    <li class="d-flex flex-row justify-content-end">
                        <div class="self-message-placeholder">
                            <div class="card-body">
                                <p class="card-text placeholder-glow">
                                    <span class="placeholder col-12 placeholder-image"></span>
                                    <span class="placeholder col-10"></span>
                                    <span class="placeholder col-9"></span>
                                </p>
                            </div>
                        </div>
                    </li>
                    <li class="d-flex flex-row">
                        <div class="sender-message-placeholder">
                            <div class="card-body">
                                <p class="card-text placeholder-glow">
                                    <span class="placeholder col-12 placeholder-image"></span>
                                    <span class="placeholder col-10"></span>
                                    <span class="placeholder col-9"></span>
                                </p>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <div style="@SetMessagesStyle(isLoading)">
            @if (chatRooms.Count > 0)
            {
                <div class="chat-profile-section">
                    <div class="row">
                        <div class="col-lg-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                            <div class="d-flex">
                                @if (chatMateChatType == Framework.Enums.Enums.ChatType.PrivateMessage)
                                {
                                    <div class="chatmate-profile-picture-section me-3">
                                        <img src="@chatMateProfilePicture" class="chatmate-profile-picture" />
                                        @if (!string.IsNullOrEmpty(chatMateConnectionId))
                                        {
                                            <span class="logged-in"></span>
                                        }
                                    </div>
                                    <div class="">
                                        <div class="chat-profile-name">
                                            @chatMateFullName
                                        </div>
                                        <div class="last-seen">
                                            @if (!string.IsNullOrEmpty(chatMateConnectionId))
                                            {
                                                <span>Active Now</span>
                                            }
                                            else
                                            {
                                                <span id="last-seen-date" data-last-seen-date="@lastSeenDate.GetValueOrDefault()"></span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="chatmate-profile-picture-section">
                                        <img src="@chatMateProfilePicture" class="chatmate-profile-picture me-3" />
                                        @if (!string.IsNullOrEmpty(chatMateGroupName))
                                        {
                                            <span class="logged-in"></span>
                                        }
                                    </div>
                                    <div class="">
                                        <div class="chat-profile-name">
                                            @chatMateChatName
                                        </div>
                                        <div class="last-seen">
                                            @if (!string.IsNullOrEmpty(chatMateGroupName))
                                            {
                                                <span>Active Now</span>
                                            }
                                            else
                                            {
                                                <span id="last-seen-date" data-last-seen-date="@lastSeenDate.GetValueOrDefault()"></span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 chat-profile-info-icon-section d-xl-block d-lg-block d-md-block d-sm-block d-none">
                            @if (maker.FromUserId != currentUserId && chatMateChatType == ChatType.GroupChat)
                            {
                                var details = new ChatMember
                                {
                                    FromUserId = maker.FromUserId,
                                    FromFirstName = maker.FromFirstName,
                                    FromLastName = maker.FromLastName,
                                    FromProfilePath = maker.FromProfilePath
                                };

                                <span data-toggle="tooltip" title="Message Activity Provider" data-bs-toggle="tooltip" data-bs-placement="left">
                                    <img src="images/messages/personal-message.svg" class="personal-message-icon" @onclick="(() => CreatePrivateMessage(details))" />
                                </span>
                            }
                            <img src="images/messages/chat-profile-info.svg" />
                        </div>
                        <div class="col-lg-12 d-block d-sm-none d-md-none d-lg-none d-xl-none" style="padding: 0px;">
                            <table>
                                <tbody>
                                    <tr>
                                        <td>
                                            <button type="button" class="border-0 bg-transparent back-button" @onclick="DisplayChatRooms">
                                                <img src="images/messages/back-arrow.svg" class="back-to-chatroom" />
                                            </button>
                                        </td>
                                        <td>
                                            <div class="chat-profile-name text-center">
                                                @if (chatMateChatType == Framework.Enums.Enums.ChatType.PrivateMessage)
                                                {
                                                    @chatMateFullName
                                                }
                                                else
                                                {
                                                    @chatMateChatName
                                                }
                                            </div>
                                        </td>
                                        <td class="chat-profile-info-icon-section">
                                            @if (maker.FromUserId != currentUserId && chatMateChatType == ChatType.GroupChat)
                                            {
                                                var details = new ChatMember
                                                {
                                                    FromUserId = maker.FromUserId,
                                                    FromFirstName = maker.FromFirstName,
                                                    FromLastName = maker.FromLastName,
                                                    FromProfilePath = maker.FromProfilePath
                                                };

                                                <span data-toggle="tooltip" title="Message Activity Provider" data-bs-toggle="tooltip" data-bs-placement="left">
                                                    <img src="images/messages/personal-message.svg" class="personal-message-icon" @onclick="(() => CreatePrivateMessage(details))" />
                                                </span>
                                            }
                                            <img src="images/messages/chat-profile-info.svg" @onclick="DisplayChatProfile" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                @if (chatHistories.Count == 0)
                {
                    <div class="row justify-content-center no-message-section text-center">
                        <div class="col-lg-5">
                            <img src="images/messages/speech-bubble.svg" />
                            <div class="divider"></div>
                            <label class="no-conversation-title">
                                No Conversation Yet
                            </label>
                            <label class="no-conversation-sub-title">
                                You didn't make any conversation yet.
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="conversation-section">
                        <InfiniteScroll ObserverTargetId="observerTarget" ContainerTargetClass=".conversation-section" ObservableTargetReach="(e)=> GetChatHistoryByChatRoomId(selectedChatRoomId, false, true)">
                            <ul class="list-unstyled d-flex flex-column" id="chat-history-list">
                                <div id="observerTarget"></div>
                                @if (isLoading)
                                {
                                    <div class="loading-section d-flex flex-row justify-content-center">
                                        <div class="spinner-border">
                                        </div>
                                    </div>
                                }
                                @foreach (var chat in chatHistories)
                                {
                                    if (chat.ChatHistoryType == ChatHistoryType.Message)
                                    {
                                        if (lastMessageDateCreated.HasValue)
                                        {
                                            TimeSpan ts = chat.DateCreated - lastMessageDateCreated.GetValueOrDefault();

                                            if (ts.Days > 1)
                                            {
                                                <li class="d-flex flex-row justify-content-center list-item-days">
                                                    <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                                    <div class="chat-date-time">
                                                        @chat.DateCreated.ToString("MMMM dd, yyyy, hh:mm tt")
                                                    </div>
                                                </li>
                                            }
                                            else if (ts.Minutes > 2)
                                            {
                                                <li class="d-flex flex-row justify-content-center list-item-minutes">
                                                    <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                                    <div class="chat-date-time">
                                                        @chat.DateCreated.ToString("dddd, hh:mm tt")
                                                    </div>
                                                </li>
                                            }

                                            lastMessageDateCreated = chat.DateCreated;
                                        }
                                        else
                                        {

                                            lastMessageDateCreated = chat.DateCreated;

                                            <li class="d-flex flex-row justify-content-center list-item-days">
                                                <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                                <div class="chat-date-time">
                                                    @lastMessageDateCreated.GetValueOrDefault().ToString("MMMM dd, yyyy, hh:mm tt")
                                                </div>
                                            </li>
                                        }
                                        @if (chat.FromUserId == currentUserId)
                                        {
                                            <li class="d-flex flex-row justify-content-end">
                                                <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                                <span data-toggle="tooltip" title="" data-bs-toggle="tooltip" data-bs-placement="left">
                                                    <div class="self-message">
                                                        @chat.Message
                                                    </div>
                                                </span>
                                                <img src="@chat.FromProfilePath" class="chat-profile-picture">
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="d-flex flex-row">
                                                <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                                <img src="@chat.FromProfilePath" class="chat-profile-picture">
                                                <span data-toggle="tooltip" title="" data-bs-toggle="tooltip" data-bs-placement="right">
                                                    <div class="sender-name">
                                                        @chat.FromFirstName
                                                    </div>
                                                    <div class="sender-message">
                                                        @chat.Message
                                                    </div>
                                                </span>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="d-flex flex-row justify-content-center list-item-minutes">
                                            <div class="sender-name">
                                                @chat.Message
                                            </div>
                                        </li>
                                    }
                                }
                            </ul>

                        </InfiniteScroll>
                    </div>

                }
                <div class="typing-status-section">
                    @if (chatRooms.Count > 0)
                    {
                        <label>
                            @if (chatRooms.Any(c => c.ChatRoomId == selectedChatRoomId))
                            {
                                @chatRooms.FirstOrDefault(c => c.ChatRoomId == selectedChatRoomId).TypingStatus
                            }
                        </label>
                    }
                </div>
                <div class="send-message-section">
                    <table>
                        <tr>
                            <td class="attachment-section"><img src="images/messages/send-attachment.svg" /></td>
                            <td class="input-section">
                                <div class="input-group border p-1 rounded-pill-section">
                                    <div id="chat-message-input" contenteditable="true" role="textbox" spellcheck="true" tabindex="0" style="" data-lexical-editor="true" data-text="Aa">
                                    </div>
                                    <div class="input-group-append border-0">
                                        <img src="images/messages/send-emoji.svg" class="emoji-icon" />
                                    </div>
                                </div>
                          
                            </td>
                            <td class="send-section">
                                <img id="send-message" src="images/messages/send-message.svg" />
                            </td>
                        </tr>
                    </table>
                </div>
            }
            else
            {
                <div class="row justify-content-center no-message-section text-center">
                    <div class="col-lg-3">
                        <img src="images/messages/no-message.svg" />
                        <div class="divider"></div>
                        <label class="no-message-title">
                            No Message Yet
                        </label>
                        <div class="divider"></div>
                        <button id="btnFindFirstExperience" type="button" class="btn btn-primary border-0" @onclick=NavigateToExplore>Find your first experience</button>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="sidebar-messages profile-section d-xl-block d-lg-block d-md-block d-sm-block @profileSectionDisplayStyle">
        <div class="row" style="@SetPlaceholderStyle(isLoading)">
            <div class="row justify-content-center placeholder-glow">
                <div class="col-lg-12 text-center">
                    <span class="placeholder col-9 profile-section-picture"></span>
                    <div class="divider"></div>
                    <label class="profile-section-name">
                        <span class="placeholder col-9"></span>
                    </label>
                    <div class="divider"></div>
                    <span class="placeholder col-9"></span>
                    <div class="divider"></div>
                </div>
                <div class="col-lg-12 profile-members-section placeholder-glow">
                    <span class="placeholder col-1 chat-profile-picture"></span><span class="placeholder col-7"></span>
                    <div class="divider"></div>
                    <span class="placeholder col-1 chat-profile-picture"></span><span class="placeholder col-7"></span>
                </div>
            </div>
        </div>
        <div style="@SetMessagesStyle(isLoading)">
            @if (chatRooms.Count > 0)
            {
                <div class="col-lg-12 d-block d-sm-none d-md-none d-lg-none d-xl-none">
                    <div class="row">
                        <div class="col-lg-12 profile-back-button-section">
                            <button type="button" class="border-0 bg-transparent back-button" @onclick="DisplayConversations">
                                <img src="images/messages/back-arrow.svg" class="back-to-conversation" />
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-12 text-center">
                        @if (chatMateChatType == Framework.Enums.Enums.ChatType.PrivateMessage)
                        {
                            <img src="@chatMateProfilePicture" class="profile-section-picture" />
                            <div class="divider"></div>
                            <label class="profile-section-name">
                                @chatMateFullName
                            </label>
                            <div class="divider"></div>
                            <div class="d-xl-block d-lg-block d-md-block d-sm-block d-none">
                                <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(false)">View Profile</button>
                            </div>
                            <div class="d-block d-sm-none d-md-none d-lg-none d-xl-none">
                                <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(true)">View Profile</button>
                            </div>
                            <div class="divider"></div>
                        }
                        else
                        {
                            <img src="@chatMateProfilePicture" class="profile-section-picture" />
                            <div class="divider"></div>
                            <label class="profile-section-name">
                                @chatMateChatName
                            </label>
                            <div class="divider"></div>
                            <div class="d-xl-block d-lg-block d-md-block d-sm-block d-none">
                                <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(false)">View Profile</button>
                            </div>
                            <div class="d-block d-sm-none d-md-none d-lg-none d-xl-none">
                                <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(true)">View Profile</button>
                            </div>
                            <div class="divider"></div>
                        }
                    </div>
                    <div class="col-lg-12 profile-members-section">
                        <label class="attachment-name">
                            Chat members
                        </label>

                        <div class="row align-items-center">
                            @foreach (var item in chatMembers)
                            {
                                <div class="col-lg-2 col-md-2 col-sm-2 col-2 chat-member-picture-section">
                                    <img src="@item.FromProfilePath" class="chat-profile-picture" />
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6 col-6 chat-member-name-section text-capitalize">
                                    @item.FromFirstName @item.FromLastName
                                </div>

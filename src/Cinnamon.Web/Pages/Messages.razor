@page "/messages/"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Pages
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using Microsoft.AspNetCore.SignalR.Client;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using System.Security.Claims;
@using Cinnamon.Web.Models.Entities;
@inject IChatApiHandler chatApiHandler;
@inject IAccountApiHandler accountApiHandler;

@inject IJSRuntime jsRuntime;
@inject AuthenticationStateProvider AuthenticationStateProvider

@implements IDisposable

<PageTitle>@Title | CinnamonPH</PageTitle>
<SeoMeta Title="@Title" Subject="@Title" Url="/Messages" />

<input type="password" name="password_fake" id="password_fake" value="" style="display:none;" />

<div class="messages-container row">
    <div class="col-lg-2 col-md-2 col-sm-2 col-12 messages-section d-xl-block d-lg-block d-md-block d-sm-block @messagesSectionDisplayStyle">
        <div class="message-title-section">
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-6">
                    <label class="message-title">
                        Messages
                    </label>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6 col-6 add-message-section">
                    @if (chatRooms.Count > 0)
                    {
                        <img src="images/messages/add-message.png" />
                    }
                </div>
            </div>
        </div>
        <div class="search-section">
            @if (chatRooms.Count > 0)
            {
                <div class="row">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="input-group border rounded-pill p-1">
                            <input type="text" placeholder="Search" id="19d13aa1-90c0-4232-a7bc-62a772baa223" autocomplete="new-password" @bind-value="searchValue" class="form-control bg-none border-0">
                            <div class="input-group-append border-0">
                                <button id="button-addon3" type="button" class="btn btn-link text-success" style="border-radius:50%"><i class="fa fa-search"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="chatroom-section">
            @if (chatRooms.Count > 0)
            {
                foreach (var chatRoom in @chatRooms)
                {
                    var fullName = $"{chatRoom.FromFirstName} {chatRoom.FromLastName}";
                    <div class="row @GetNewMessageStyle(chatRoom.HasNewMessage) @GetActiveStyle(selectedChatRoomId == chatRoom.ChatRoomId) chatroom-list-item" @onclick="(() => GetChatHistoryByChatRoomId(chatRoom.ChatRoomId, true, false))">
                        <input type="hidden" value="@chatRoom.DateCreated" id="date-created" />
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="last-update-date">
                                @chatRoom.DateCreated.ToString("hh:mm tt")
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-2 col-sm-2 col-2 chatroom-profile-picture-section">
                            <img src="@chatRoom.FromProfilePath" class="chatroom-profile-picture" />
                            @if (!string.IsNullOrEmpty(chatRoom.FromConnectionId))
                            {
                                <span class="logged-in"></span>
                            }
                        </div>
                        <div class="col-lg-10 col-md-10 col-sm-10 col-10 chatroom-name-section">
                            <div class="chatroom-name">
                                @fullName
                            </div>
                            <div class="last-message">
                                @chatRoom.Message
                            </div>
                            @if (chatRoom.HasNewMessage)
                            {
                                <span class="has-new-message-badge">
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-lg-8 col-md-8 col-sm-8 col-12 chat-section d-xl-block d-lg-block d-md-block d-sm-block @chatSectionDisplayStyle">
        @if (chatRooms.Count > 0)
        {
            <div class="chat-profile-section">
                <div class="row">
                    <div class="col-lg-6 d-xl-block d-lg-block d-md-block d-sm-block d-none">
                        <div class="row">
                            <div class="col-lg-1 chatmate-profile-picture-section">
                                <img src="@chatMateProfilePicture" class="chatmate-profile-picture" />
                                @if (!string.IsNullOrEmpty(chatMateConnectionId))
                                {
                                    <span class="logged-in"></span>
                                }
                            </div>
                            <div class="col-lg-10">
                                <div class="chat-profile-name">
                                    @chatMateFullName
                                </div>
                                <div class="last-seen">
                                    @if (!string.IsNullOrEmpty(chatMateConnectionId))
                                    {
                                        <span>Active Now</span>
                                    }
                                    else
                                    {
                                        <span>Last seen @lastSeenDate.GetValueOrDefault().ToString("hh:mm tt")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 chat-profile-info-icon-section d-xl-block d-lg-block d-md-block d-sm-block d-none">
                        <img src="images/messages/chat-profile-info.png" />
                    </div>
                    <div class="col-lg-12 d-block d-sm-none d-md-none d-lg-none d-xl-none">
                        <div class="row">
                            <div class="col-lg-1 col-md-1 col-sm-1 col-1">
                                <img src="images/messages/back-arrow.png" @onclick="DisplayChatRooms" />
                            </div>
                             <div class="col-lg-10 col-md-10 col-sm-10 col-10 text-center">
                                <div class="chat-profile-name">
                                    @chatMateFullName
                                </div>
                            </div>
                            <div class="col-lg-1 col-md-1 col-sm-1 col-1 chat-profile-info-icon-section">
                                <img src="images/messages/chat-profile-info-mobile.png" @onclick="DisplayChatProfile" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="conversation-section">
                <InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReach="(e)=> GetChatHistoryByChatRoomId(selectedChatRoomId, false, true)">
                    <ul class="list-unstyled d-flex flex-column" id="chat-history-list">
                        <div id="observerTarget"></div>

                        @if (chatHistories.Count >= 30)
                        {
                        }
                        @if (isLoading)
                        {
                            <div class="loading-section d-flex flex-row justify-content-center">
                                <div class="spinner-border">
                                </div>
                            </div>
                        }
                        @foreach (var chat in chatHistories)
                        {

                            if (lastMessageDateCreated.HasValue)
                            {
                                TimeSpan ts = chat.DateCreated - lastMessageDateCreated.GetValueOrDefault();

                                if (ts.Days > 1)
                                {
                                    <li class="d-flex flex-row justify-content-center list-item-days">
                                        <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                        <div class="chat-date-time">
                                            @chat.DateCreated.ToString("MMMM dd, yyyy, hh:mm tt")
                                        </div>
                                    </li>
                                }
                                else if (ts.Minutes > 2)
                                {
                                    <li class="d-flex flex-row justify-content-center list-item-minutes">
                                        <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                        <div class="chat-date-time">
                                            @chat.DateCreated.ToString("dddd, hh:mm tt")
                                        </div>
                                    </li>
                                }

                                lastMessageDateCreated = chat.DateCreated;
                            }
                            else
                            {

                                lastMessageDateCreated = chat.DateCreated;

                                <li class="d-flex flex-row justify-content-center list-item-days">
                                    <input type="hidden" value="@chat.DateCreated" id="chat-history-date-created" />
                                    <div class="chat-date-time">
                                        @lastMessageDateCreated.GetValueOrDefault().ToString("MMMM dd, yyyy, hh:mm tt")
                                    </div>
                                </li>
                            }
                            @if (chat.FromUserId == currentUserId)
                            {
                                <li class="d-flex flex-row justify-content-end">
                                    <Tooltip Text="@chat.DateCreated.ToString("hh:mm tt")" Placement="TooltipPlacement.Left">
                                        <div class="self-message">
                                            @chat.Message
                                        </div>
                                    </Tooltip>
                                    <img src="@chat.FromProfilePath" class="chat-profile-picture">
                                </li>
                            }
                            else
                            {
                                <li class="d-flex flex-row">
                                    <img src="@chat.FromProfilePath" class="chat-profile-picture">
                                    <Tooltip Text="@chat.DateCreated.ToString("hh:mm tt")" Placement="TooltipPlacement.Right">
                                        <div class="sender-message">
                                            @chat.Message
                                        </div>
                                    </Tooltip>
                                </li>
                            }

                        }
                    </ul>

                </InfiniteScroll>
            </div>
            <div class="typing-status-section">
                @if (chatRooms.Count > 0)
                {
                    <label>
                        @if (chatRooms.Any(c => c.ChatRoomId == selectedChatRoomId))
                        {
                            @chatRooms.FirstOrDefault(c => c.ChatRoomId == selectedChatRoomId).TypingStatus
                        }
                    </label>
                }
            </div>
            <div class="send-message-section">
                <table>
                    <tr>
                        <td class="attachment-section"><img src="images/messages/send-attachment.png" /></td>
                        <td class="input-section">
                            <div class="input-group border p-1 rounded-pill-section">
                                <div id="chat-message-input" contenteditable="true" role="textbox" spellcheck="true" tabindex="0" style="" data-lexical-editor="true" data-text="Aa">
                                </div>
                                <div class="input-group-append border-0">
                                    <img src="images/messages/send-emoji.png" class="emoji-icon" />
                                </div>
                            </div>
                          
                        </td>
                        <td class="send-section">
                            <img id="send-message" src="images/messages/send-message.png" />
                        </td>
                    </tr>
                </table>
            </div>
        }
        else
        {
            <div class="row justify-content-center no-message-section text-center">
                <div class="col-lg-3">
                    <img src="images/messages/no-message.png" />
                    <div class="divider"></div>
                    <label class="no-message-title">
                        No Message Yet
                    </label>
                    <div class="divider"></div>
                    <button id="btnFindFirstExperience" type="button" class="btn btn-primary border-0" @onclick=NavigateToExplore>Find your first experience</button>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-2 col-md-2 col-sm-2 col-12 profile-section d-xl-block d-lg-block d-md-block d-sm-block @profileSectionDisplayStyle">
        @if (chatRooms.Count > 0)
        {
            <div class="col-lg-12 d-block d-sm-none d-md-none d-lg-none d-xl-none">
                <div class="row">
                    <div class="col-lg-12 profile-back-button-section">
                        <img src="images/messages/back-arrow.png" @onclick="DisplayConversations" />
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-12 text-center">
                    <img src="@chatMateProfilePicture" class="profile-section-picture" />
                    <div class="divider"></div>
                    <label class="profile-section-name">
                        @chatMateFullName
                    </label>
                    <div class="divider"></div>
                    <div class="d-xl-block d-lg-block d-md-block d-sm-block d-none">
                        <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(false)">View Profile</button>
                    </div>
                    <div class="d-block d-sm-none d-md-none d-lg-none d-xl-none">
                        <button id="btnViewProfile" type="button" class="btn border-0" @onclick="() => NavigateToProfile(true)">View Profile</button>
                    </div>
                    <div class="divider"></div>
                </div>
                <div class="col-lg-12 profile-attachment-section">
                    <label class="attachment-name">
                        Attachments
                    </label>
                </div>
           
            </div>
        }
    </div>
</div>

@code {
    private string messageInput = string.Empty;
    private string? searchValue;
    private string Title { get; set; } = "Messages";
    private string Token { get; set; }
    List<ChatRoom> chatRooms = new List<ChatRoom>();
    List<ChatHistory> chatHistories = new List<ChatHistory>();
    private int pageIndex = 1;
    private int countPerPage = 30;
    private int selectedChatRoomId = 0;
    private int toUserId = 0;
    private string currentUserConnectionId = string.Empty;
    private int currentUserId = 0;
    private string currentUserLastName = string.Empty;
    private string currentUserFirstName = string.Empty;
    private string currentUserProfilePath = string.Empty;
    private string chatMateFullName = string.Empty;
    private string chatMateProfilePicture = string.Empty;
    private string chatMateConnectionId = string.Empty;
    private string chatMateProfileLink = string.Empty;
    private DateTime? lastMessageDateCreated;
    private DateTime? lastSeenDate;
    private bool isLoading = false;
    [Inject] HubConnection hubConnection { get; set; }
    private string messagesSectionDisplayStyle = string.Empty;
    private string chatSectionDisplayStyle = string.Empty;
    private string profileSectionDisplayStyle = string.Empty;
    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;
    private DotNetObjectReference<Cinnamon.Web.Pages.Messages> objectRef;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var userToken = user.FindFirstValue("Token");

        if (userToken == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        hubConnection.On<string>("ReceiveMessage", (payload) =>
        {
            var splitted = payload.Split("|");
            if (Convert.ToInt32(splitted[0]) == selectedChatRoomId)
            {
                chatHistories.Add(new ChatHistory
                {
                    ChatRoomId       = Convert.ToInt32(splitted[0]),
                    DateCreated      = DateTime.Parse(splitted[1]),
                    FromConnectionId = splitted[2],
                    FromUserId       = Convert.ToInt32(splitted[3]),
                    FromFirstName    = splitted[4],
                    FromLastName     = splitted[5],
                    FromProfilePath  = splitted[6],
                    IsViewed         = bool.Parse(splitted[7]),
                    Message          = splitted[8],
                    ToConnectionId   = splitted[9],
                    ToUserId         = Convert.ToInt32(splitted[10]),
                    ToFirstName      = splitted[11],
                    ToLastName       = splitted[12],
                    ToProfilePath    = splitted[13]
                });

                chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).Message = splitted[8];
                chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).DateCreated = DateTime.Parse(splitted[1]);
            }
            else
            {
                if (chatRooms.Any(c => c.ChatRoomId == Convert.ToInt32(splitted[0])))
                {
                    chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).HasNewMessage = true;
                    chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).Message = splitted[8];
                    chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).DateCreated = DateTime.Parse(splitted[1]);
                }
                else
                {
                    chatRooms.Add(new ChatRoom
                    {
                        ChatRoomId       = Convert.ToInt32(splitted[0]),
                        DateCreated      = DateTime.Parse(splitted[1]),
                        FromConnectionId = splitted[2],
                        FromUserId       = Convert.ToInt32(splitted[3]),
                        FromFirstName    = splitted[4],
                        FromLastName     = splitted[5],
                        FromProfilePath  = splitted[6],
                        HasNewMessage    = true,
                        Message          = splitted[8],
                        ToConnectionId   = splitted[9],
                        ToUserId         = Convert.ToInt32(splitted[10]),
                        ToFirstName      = splitted[11],
                        ToLastName       = splitted[12],
                        ToProfilePath    = splitted[13]
                    });

                    DisplayChatRooms();
                }
            }

            chatRooms = chatRooms.OrderByDescending(c => c.DateCreated).ToList();

            InvokeAsync(() => StateHasChanged());
        });

        hubConnection.On<string>("UpdateChatStatus", (payload) =>
        {
            var splitted = payload.Split("|");

            if (chatRooms.Any(c => c.ChatRoomId == Convert.ToInt32(splitted[0])))
            {
                chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).FromConnectionId = splitted[1];
                chatMateConnectionId = splitted[1];
            }

            InvokeAsync(() => StateHasChanged());
        });

        hubConnection.On<string>("UpdateTypingStatusKeyDown", (payload) =>
        {
            var splitted = payload.Split("|");

            if (Convert.ToInt32(splitted[0]) == selectedChatRoomId)
            {
                chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).TypingStatus = $"{splitted[2]} {splitted[1]} is typing...";
            }

            InvokeAsync(() => StateHasChanged());
        });

        hubConnection.On<string>("UpdateTypingStatusKeyUp", (payload) =>
        {
            var splitted = payload.Split("|");

            if (Convert.ToInt32(splitted[0]) == selectedChatRoomId)
            {
                chatRooms.FirstOrDefault(c => c.ChatRoomId == Convert.ToInt32(splitted[0])).TypingStatus = string.Empty;
            }

            InvokeAsync(() => StateHasChanged());
        });

        if (!IsConnected)
        {
            await hubConnection.StartAsync();
        }

        await LoadSigninUser();

        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objectRef = DotNetObjectReference.Create(this);
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.messages.initMessages", objectRef, "#chat-message-input");
            await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.messages.handleDateFormat");
        }
        await jsRuntime.InvokeVoidAsync("MyLib.Pages.customer.messages.handleDateFormat");
    }

    private async Task Send()
    {
        if (hubConnection is not null && !string.IsNullOrEmpty(messageInput.Trim()))
        {
            await hubConnection.SendAsync("SendMessage", selectedChatRoomId, currentUserConnectionId, currentUserId, currentUserLastName, currentUserFirstName, currentUserProfilePath, toUserId, messageInput);
        }

        messageInput = string.Empty;
    }

    private async Task GetChatRoomsByUserId()
    {
        var result = await chatApiHandler.GetChatRoomsByUserId(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetChatRoomsByUserIdArgs
            {
                UserId = currentUserId
            }, Token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            chatRooms = result.Result.Result.Select(c => new ChatRoom
                {
                    ChatRoomId       = c.ChatRoomId,
                    FromUserId       = c.FromUserId,
                    DateCreated      = c.DateCreated,
                    FromFirstName    = c.FromFirstName,
                    FromLastName     = c.FromLastName,
                    Message          = c.Message,
                    ToFirstName      = c.ToFirstName,
                    ToLastName       = c.ToLastName,
                    ToUserId         = c.ToUserId,
                    FromProfilePath  = c.FromProfilePath,
                    ToProfilePath    = c.ToProfilePath,
                    FromConnectionId = c.FromConnectionId,
                    ToConnectionId   = c.ToConnectionId,
                    HasNewMessage    = c.HasNewMessage,
                    FromProfileLink  = c.FromProfileLink
                }).OrderByDescending(c => c.DateCreated).ToList();

            if (chatRooms.Any())
            {
                await GetChatHistoryByChatRoomId(chatRooms.FirstOrDefault().ChatRoomId, false, false);
                DisplayChatRooms();
            }
            else
            {
                DisplayConversations();
            }
        }
    }

    private void HandleInput(ChangeEventArgs e)
    {
        messageInput = e.Value.ToString();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrEmpty(messageInput))
        {
            await Send();
        }
        else
        {
            if (hubConnection is not null)
            {
                //await hubConnection.SendAsync("SendTypingStatusKeyDown", selectedChatRoomId, currentUserId, currentUserLastName, currentUserFirstName);
            }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (hubConnection is not null)
        {
            //await hubConnection.SendAsync("SendTypingStatusKeyUp", selectedChatRoomId, currentUserId);
        }
    }

    [JSInvokable]
    public async Task OnFocus()
    {
        var updateResult = await chatApiHandler.UpdateChatHistory(new Framework.ApiCommand.ApiCore.ChatHistory.Request.UpdateChatHistoryArgs
            {
                ChatRoomId = selectedChatRoomId,
                FromUserId = toUserId,
                ToUserId = currentUserId,
                IsViewed = true
            }, Token);
    }

    private async Task LoadSigninUser()
    {
        // get user login
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        Token = user.FindFirstValue("Token");

        if (user != null && user.Identity.IsAuthenticated)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                var args                = result.Result.Result;
                currentUserConnectionId = args.ConnectionId;
                currentUserId           = args.Id;
                currentUserFirstName    = args.FirstName;
                currentUserLastName     = args.LastName;
                currentUserProfilePath  = args.ProfileImg;
                await GetChatRoomsByUserId();
            }
        }
    }

    private void NavigateToExplore()
    {
        NavigationManager.NavigateTo("/Explore");
    }

    private void NavigateToProfile(bool isMobile)
    {
        if (isMobile)
        {
            NavigationManager.NavigateTo($"/maker/profile/{chatMateProfileLink}");
        }
        else
        {
            jsRuntime.InvokeAsync<string>("open", $"/maker/profile/{chatMateProfileLink}", "_blank");
        }
    }


    private async Task GetChatHistoryByChatRoomId(int chatRoomId, bool fromClick, bool fromScroll)
    {
        isLoading = true;

        if (chatRoomId != selectedChatRoomId || fromClick)
        {
            pageIndex = 1;
        }

        var result = await chatApiHandler.GetChatHistoryByChatRoomId(new Framework.ApiCommand.ApiCore.ChatHistory.Request.GetChatHistoryByChatRoomIdArgs
            {
                ChatRoomId = chatRoomId,
                CountPerPage = countPerPage,
                PageIndex = pageIndex
            }, Token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            var chatHistoryResult = result.Result.Result.Select(c => new ChatHistory
                {
                    ChatHistoryId    = c.ChatHistoryId,
                    ChatRoomId       = c.ChatRoomId,
                    DateCreated      = c.DateCreated,
                    FromConnectionId = c.FromConnectionId,
                    FromUserId       = c.FromUserId,
                    FromFirstName    = c.FromFirstName,
                    FromLastName     = c.FromLastName,
                    FromProfilePath  = c.FromProfilePath,
                    IsViewed         = c.IsViewed,
                    Message          = c.Message,
                    ToConnectionId   = c.ToConnectionId,
                    ToUserId         = c.ToUserId,
                    ToFirstName      = c.ToFirstName,
                    ToLastName       = c.ToLastName,
                    ToProfilePath    = c.ToProfilePath
                }).OrderBy(c => c.ChatHistoryId).ToList();

            if (fromScroll)
            {
                chatHistories.AddRange(chatHistoryResult);

                chatHistories = chatHistories.OrderBy(c => c.ChatHistoryId).ToList();
            }
            else
            {
                chatHistories = chatHistoryResult;
            }

            if (chatRoomId != 0)
            {
                var selectedChatRoom   = chatRooms.FirstOrDefault(c => c.ChatRoomId == chatRoomId);
                toUserId               = selectedChatRoom.FromUserId;
                chatMateFullName       = $"{selectedChatRoom.FromFirstName} {selectedChatRoom.FromLastName}";
                chatMateProfilePicture = selectedChatRoom.FromProfilePath;
                chatMateConnectionId   = selectedChatRoom.FromConnectionId;
                chatMateProfileLink    = selectedChatRoom.FromProfileLink;
                lastSeenDate           = selectedChatRoom.DateCreated;
                selectedChatRoomId     = chatRoomId;
                lastMessageDateCreated = null;

                chatRooms.FirstOrDefault(c => c.ChatRoomId == chatRoomId).HasNewMessage = false;

                DisplayConversations();
            }

            pageIndex = result.Result.Pagination.PageIndex.GetValueOrDefault() + 1;

            var updateResult = await chatApiHandler.UpdateChatHistory(new Framework.ApiCommand.ApiCore.ChatHistory.Request.UpdateChatHistoryArgs
                {
                    ChatRoomId = selectedChatRoomId,
                    FromUserId = toUserId,
                    ToUserId = currentUserId,
                    IsViewed = true
                }, Token);
        }
        isLoading = false;
    }

    private string GetNewMessageStyle(bool hasNewMessage)
    {
        if (hasNewMessage)
            return "chatroom-item-bold";

        return "chatroom-item";
    }

    private string GetActiveStyle(bool isEqual)
    {
        if (isEqual)
            return "chatroom-item-active";

        return "chatroom-item";
    }

    private void DisplayChatRooms()
    {
        messagesSectionDisplayStyle = "d-block";

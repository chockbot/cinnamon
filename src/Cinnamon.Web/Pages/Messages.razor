    private async Task LoadRequestMessage()
    {
        if(!string.IsNullOrEmpty(Tokenize) && !string.IsNullOrEmpty(Guid))
        {
            var getRequestMessageRes = await chatApiHandler.GetRequestMessage(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetRequestMessageArgs {
                Guid = Guid,
                Token = Tokenize
            }, Token);
            if(!getRequestMessageRes.Succeeded || getRequestMessageRes.Result is not null && getRequestMessageRes.Result.IsSuccess)
            {
                var payload = getRequestMessageRes.Result.Result;

                await CreatePrivateMessage(new ChatMember {
                    ChatMemberType = ChatMemberType.Customer,
                    CommonPrivateChatRoomId = 0,
                    FromFirstName = payload.FirstName,
                    FromLastName = payload.LastName,
                    FromProfilePath = payload.ImageSrc,
                    FromUserId = payload.ProviderId
                });
            }
        }
    }

    private IEnumerable<ChatRoom> FilteredChatRooms 
    {
        get 
        {
            if(chatRooms is null || chatRooms.Count == 0) return Enumerable.Empty<ChatRoom>();
            
            var trimmedSearch = searchValue.Trim().ToLower();
            return chatRooms.Where(c => 
                        c.FromFirstName.ToLower().Contains(trimmedSearch) || 
                        c.FromLastName.ToLower().Contains(trimmedSearch) ||
                        c.ChatName.ToLower().Contains(trimmedSearch));
        }
    }

    private IEnumerable<ChatMember> FileteredFormerChatMembers
    {
        get 
        {
            if(formerChatMembers is null || formerChatMembers.Count == 0) return Enumerable.Empty<ChatMember>();
            
            var trimmedSearch = addMemberSearchValue.Trim().ToLower();
            return formerChatMembers.Where(c => 
                        c.FromFirstName.ToLower().Contains(trimmedSearch) ||
                        c.FromLastName.ToLower().Contains(trimmedSearch) );
        }    
    }

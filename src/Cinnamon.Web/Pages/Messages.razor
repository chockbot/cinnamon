    private async Task CreatePrivateMessage(ChatMember chatMember)
    {
        var chatRoomId = 0;
        var toCustomerResult = await accountApiHandler.GetCustomerById(chatMember.FromUserId);
        var hasTemporaryChatRoomId = false;

        var commonPrivateChatRoomId = chatRooms.FirstOrDefault(c => c.FromUserId == chatMember.FromUserId && c.ChatType == ChatType.PrivateMessage)?.ChatRoomId;

        if (commonPrivateChatRoomId.HasValue)
        {
            chatRoomId = commonPrivateChatRoomId.GetValueOrDefault();
        }
        else
        {
            chatRoomId = (int)((DateTimeOffset)DateTime.UtcNow).ToUnixTimeSeconds();
            hasTemporaryChatRoomId = true;
        }

        if (!chatRooms.Any(c => c.ChatRoomId == chatRoomId))
        {
            chatRooms.Add(new ChatRoom
                {
                    ChatRoomId = chatRoomId,
                    DateCreated = DateTime.Now,
                    FromConnectionId = toCustomerResult.Result.Result.ConnectionId,
                    FromUserId = chatMember.FromUserId,
                    FromFirstName = chatMember.FromFirstName,
                    FromLastName = chatMember.FromLastName,
                    FromProfilePath = chatMember.FromProfilePath,
                    HasNewMessage = true,
                    Message = string.Empty,
                    ToConnectionId = currentUserConnectionId,
                    ToUserId = currentUserId,
                    ToFirstName = currentUserFirstName,
                    ToLastName = currentUserLastName,
                    ToProfilePath = currentUserProfilePath,
                    ChatType = Framework.Enums.Enums.ChatType.PrivateMessage,
                    HasTemporaryChatRoomId = hasTemporaryChatRoomId
                });
        }

        await GetChatHistoryByChatRoomId(chatRoomId, true, false);

        chatRooms = chatRooms.OrderByDescending(c => c.DateCreated).ToList();
    }

    private async Task AddMemberToGroup()
    {
        foreach (var chatMember in formerChatMembers.Where(f => f.IsSelected))
        {
            var createChatRoomResult = await chatApiHandler.CreateChatRoom(new Framework.ApiCommand.ApiCore.ChatRoom.Request.CreateChatRoomArgs
                {
                    FromUserId = chatMember.FromUserId,
                    ToUserId = currentUserId,
                    ChatType = Framework.Enums.Enums.ChatType.GroupChat,
                    GroupName = chatMateGroupName,
                    ChatName = chatMateChatName
                }, Token);

            if (createChatRoomResult.Succeeded && createChatRoomResult.Result.IsSuccess)
            {
                await hubConnection.SendAsync("AddToGroup", chatMateGroupName, chatMember.FromUserId);
                await hubConnection.SendAsync("AddFormerChatMemberToGroup", $"{chatMateGroupName}|{selectedChatRoomId}|{currentUserId}|{currentUserFirstName}|{currentUserLastName}|{currentUserProfilePath}|{chatMateChatName}|{chatMember.FromFirstName}|{chatMember.FromLastName}");
            }
        }
    }

    private async Task ToggleChatMember(ChatMember chatMember)
    {
        if (formerChatMembers.Any(f => f.FromUserId == chatMember.FromUserId))
        {
            formerChatMembers.FirstOrDefault(f => f.FromUserId == chatMember.FromUserId).IsSelected = !formerChatMembers.FirstOrDefault(f => f.FromUserId == chatMember.FromUserId).IsSelected;
        }
    }


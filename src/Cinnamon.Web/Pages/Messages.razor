    private async Task GetChatHistoryByChatRoomId(int chatRoomId, bool fromClick, bool fromScroll)
    {
        isLoading = true;

        if (chatRoomId != selectedChatRoomId || fromClick)
        {
            pageIndex = 1;
        }

        var result = await chatApiHandler.GetChatHistoryByChatRoomId(new Framework.ApiCommand.ApiCore.ChatHistory.Request.GetChatHistoryByChatRoomIdArgs
            {
                ChatRoomId = chatRoomId,
                CountPerPage = countPerPage,
                PageIndex = pageIndex,
                UserId = currentUserId
            }, Token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            var chatHistoryResult = result.Result.Result.Select(c => new ChatHistory
                {
                    ChatHistoryId    = c.ChatHistoryId,
                    ChatRoomId       = c.ChatRoomId,
                    DateCreated      = c.DateCreated,
                    FromConnectionId = c.FromConnectionId,
                    FromUserId       = c.FromUserId,
                    FromFirstName    = c.FromFirstName,
                    FromLastName     = c.FromLastName,
                    FromProfilePath  = c.FromProfilePath,
                    IsViewed         = c.IsViewed,
                    Message          = c.Message,
                    ToConnectionId   = c.ToConnectionId,
                    ToUserId         = c.ToUserId,
                    ToFirstName      = c.ToFirstName,
                    ToLastName       = c.ToLastName,
                    ToProfilePath    = c.ToProfilePath,
                    ChatHistoryType  = c.ChatHistoryType
                }).OrderBy(c => c.ChatHistoryId).ToList();

            if (fromScroll)
            {
                chatHistories.AddRange(chatHistoryResult);

                chatHistories = chatHistories.GroupBy(c => new
                {
                    c.ChatHistoryId,
                    c.ChatRoomId,
                    c.DateCreated,
                    c.FromConnectionId,
                    c.FromUserId,
                    c.FromFirstName,
                    c.FromLastName,
                    c.FromProfilePath,
                    c.IsViewed,
                    c.Message,
                    c.ToConnectionId,
                    c.ToUserId,
                    c.ToFirstName,
                    c.ToLastName,
                    c.ToProfilePath,
                    c.ChatHistoryType
                }).Select(c => new ChatHistory
                {
                    ChatHistoryId    = c.Key.ChatHistoryId,
                    ChatRoomId       = c.Key.ChatRoomId,
                    DateCreated      = c.Key.DateCreated,
                    FromConnectionId = c.Key.FromConnectionId,
                    FromUserId       = c.Key.FromUserId,
                    FromFirstName    = c.Key.FromFirstName,
                    FromLastName     = c.Key.FromLastName,
                    FromProfilePath  = c.Key.FromProfilePath,
                    IsViewed         = c.Key.IsViewed,
                    Message          = c.Key.Message,
                    ToConnectionId   = c.Key.ToConnectionId,
                    ToUserId         = c.Key.ToUserId,
                    ToFirstName      = c.Key.ToFirstName,
                    ToLastName       = c.Key.ToLastName,
                    ToProfilePath    = c.Key.ToProfilePath,
                    ChatHistoryType  = c.Key.ChatHistoryType
                }).OrderBy(c => c.ChatHistoryId).ToList();
            }
            else
            {
                chatHistories = chatHistoryResult;
            }

            if (chatRoomId != 0)
            {
                var selectedChatRoom           = chatRooms.FirstOrDefault(c => c.ChatRoomId == chatRoomId);
                toUserId                       = selectedChatRoom.FromUserId;
                chatMateFullName               = $"{selectedChatRoom.FromFirstName} {selectedChatRoom.FromLastName}";
                chatMateProfilePicture         = selectedChatRoom.FromProfilePath;
                chatMateConnectionId           = selectedChatRoom.FromConnectionId;
                chatMateProfileLink            = selectedChatRoom.FromProfileLink;
                chatMateGroupName              = selectedChatRoom.GroupName;
                chatMateChatName               = selectedChatRoom.ChatName;
                chatMateChatType               = selectedChatRoom.ChatType;
                lastSeenDate                   = selectedChatRoom.DateCreated;
                selectedChatRoomId             = chatRoomId;
                lastMessageDateCreated         = null;
                chatMateHasTemporaryChatRoomId = selectedChatRoom.HasTemporaryChatRoomId;

                if (chatMateChatType == Framework.Enums.Enums.ChatType.GroupChat)
                {
                    showLeaveGroup = true;
                }

                chatRooms.FirstOrDefault(c => c.ChatRoomId == chatRoomId).HasNewMessage = false;

                DisplayConversations();
            }

            pageIndex = result.Result.Pagination.PageIndex.GetValueOrDefault() + 1;

            var updateResult = await chatApiHandler.UpdateChatHistory(new Framework.ApiCommand.ApiCore.ChatHistory.Request.UpdateChatHistoryArgs
                {
                    ChatRoomId = selectedChatRoomId,
                    FromUserId = toUserId,
                    ToUserId = currentUserId,
                    IsViewed = true
                }, Token);

            await GetChatMembersByChatRoomId(chatRoomId);
        }
        isLoading = false;
    }

    private async Task GetChatMembersByChatRoomId(int chatRoomId)
    {
        var result = await chatApiHandler.GetChatMembersByChatRoomId(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetChatMembersByChatRoomIdArgs
        {
            ChatRoomId = chatRoomId,
            UserId = currentUserId,
            HasLeft = false
        }, Token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            chatMembers = result.Result.Result.Select(r => new ChatMember
            {
                FromFirstName = r.FromFirstName,
                FromLastName = r.FromLastName,
                FromProfilePath = r.FromProfilePath,
                FromUserId = r.FromUserId,
                ChatMemberType = r.ChatMemberType,
                FromProfileLink = r.FromProfileLink,
                CommonPrivateChatRoomId = r.CommonPrivateChatRoomId,
                ConnectionIds = r.ConnectionIds.ToList()
            }).ToList();

            if (chatMembers.Any())
            {
                if (chatMateChatType == ChatType.GroupChat)
                {
                    maker = chatMembers.FirstOrDefault(c => c.ChatMemberType == ChatMemberType.ActivityProvider);

                    if (maker != null)
                    {
                        chatMateProfileLink = maker?.FromProfileLink;
                        chatMateProfilePicture = maker?.FromProfilePath;

                        if(IsConnected)
                            await hubConnection.SendAsync("AddToGroup", chatMateGroupName, maker?.FromUserId);
                    }
                }

                if (chatMembers.Any(c => c.FromUserId == currentUserId))
                    currentUserChatMemberType = chatMembers.FirstOrDefault(c => c.FromUserId == currentUserId).ChatMemberType;
            }
        }
    }

    private async Task GetFormerChatMembersByChatRoomId(int chatRoomId)
    {
        var result = await chatApiHandler.GetChatMembersByChatRoomId(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetChatMembersByChatRoomIdArgs
            {
                ChatRoomId = chatRoomId,
                UserId = currentUserId,
                HasLeft = true
            }, Token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            formerChatMembers = result.Result.Result.GroupBy(c => new
            {
                c.FromFirstName,
                c.FromLastName,
                c.FromProfilePath,
                c.FromUserId,
                c.ChatMemberType,
                c.FromProfileLink,
                c.CommonPrivateChatRoomId
            }).Select(r => new ChatMember
            {
                FromFirstName           = r.Key.FromFirstName,
                FromLastName            = r.Key.FromLastName,
                FromProfilePath         = r.Key.FromProfilePath,
                FromUserId              = r.Key.FromUserId,
                ChatMemberType          = r.Key.ChatMemberType,
                FromProfileLink         = r.Key.FromProfileLink,
                CommonPrivateChatRoomId = r.Key.CommonPrivateChatRoomId
            }).ToList();

            formerChatMembers = formerChatMembers.Where(f => !chatMembers.Select(c => c.FromUserId).Contains(f.FromUserId)).ToList();
        }
    }


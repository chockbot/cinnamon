@page "/onboarding"
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@using Cinnamon.Web.Components
@using Cinnamon.Web.Components.Pages;
@using System.Globalization
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject IAccountApiHandler accountApiHandler;
@inject Cinnamon.Web.Config.Config config;
@layout EmptyLayout

<PageTitle>Welcome to Cinnamon Onboarding | CinnamonPH</PageTitle>
<SeoMeta Title="Welcome to Cinnamon Onboarding" Subject="Onboarding" Url="/onboarding" Keywords='new List<string>{"onboarding","new"}' />

<div class="top-row px-4">
    <!--App Name-->
    <div class="app-name col-lg-3 col-md-3">
        <a href="/explore" class="app-name">@Resources.App.appName</a>
    </div>
</div>

<Container class="onboarding-wrapper py-5">
    <div class="border-radius-40 box-shadow">
        <Row>
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" 
                class='@(currentPage != 0 ? "m-d-none" : "border-right-1-solid border-color-grey-100 m-border-0-solid")'>
                <div class="padding-20 position-relative m-padding-x-0">
                    <h3 class="font-32 font-weight-900 color-orange-100 mb-0 m-font-24">Welcome aboard!</h3>
                    <p class="font-20 font-weight-700 color-black-100 margin-bottom-50 m-font-16">Get ready to explore our platform's key features:</p>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is3.Is2.OnDesktop">
                            <img class="max-width-100 h-auto" src="images/onboarding/create-icon.png" alt="create-icon">
                        </Column>
                        <Column ColumnSize="ColumnSize.Is9.Is10.OnDesktop">
                            <p class="font-20 font-weight-700 color-black-100 mb-0 m-font-16">Create Multiple Activity</p>
                            <p class="font-16 color-grey-100 m-font-14">Effortlessly manage multiple activities or classes with custom schedules and resources.</p>
                        </Column>
                    </Row>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is3.Is2.OnDesktop">
                            <img class="max-width-100 h-auto" src="images/onboarding/mange-icon.png" alt="manage-icon">
                        </Column>
                        <Column ColumnSize="ColumnSize.Is9.Is10.OnDesktop">
                            <p class="font-20 font-weight-700 color-black-100 mb-0 m-font-16">Manage Attendance</p>
                            <p class="font-16 color-grey-100 m-font-14">Say goodbye to manual tracking, our system simplifies attendance management and generates comprehensive reports.</p>
                        </Column>
                    </Row>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is3.Is2.OnDesktop">
                            <img class="max-width-100 h-auto" src="images/onboarding/chat-icon.png" alt="chat-icon">
                        </Column>
                        <Column ColumnSize="ColumnSize.Is9.Is10.OnDesktop">
                            <p class="font-20 font-weight-700 color-black-100 mb-0 m-font-16">Chat</p>
                            <p class="font-16 color-grey-100 m-font-14">Stay connected in real-time with participants, instructors, and organizers for seamless communication.</p>
                        </Column>
                    </Row>
                    <Row>
                        <Column ColumnSize="ColumnSize.Is3.Is2.OnDesktop">
                            <img class="max-width-100 h-auto" src="images/onboarding/reports-icon.png" alt="report-icon">
                        </Column>
                        <Column ColumnSize="ColumnSize.Is9.Is10.OnDesktop">
                            <p class="font-20 font-weight-700 color-black-100 mb-0 m-font-16">Reports</p>
                            <p class="font-16 color-grey-100 m-font-14">Gain valuable insights with automated report generation, making data-driven decisions a breeze.</p>
                        </Column>
                    </Row>
                    <p class="mx-auto width-70-p font-16 color-orange-100 font-weight-700 text-center m-width-100 m-font-14">Let's make your experience remarkable and empower your community together!</p>
                    <div class="mt-5 z-index-20 position-relative hide-desktop">
                        <Button Clicked="() => currentPage++" Type="ButtonType.Button" Border="Border.Is0.RoundedPill" 
                            class="w-100 font-16 bg-orange-100 color-white-100 hover-color-white">
                            Next
                        </Button>
                    </div>
                    <img class="pattern-img z-index-10" src="images/onboarding/pattern.png" alt="pattern">
                </div>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class='@(currentPage != 1 ? "m-d-none" : "")'>
                @if(IsAuthenticated)
                {
                    <div class="d-flex align-items-center position-relative text-center padding-70 h-100 m-padding-x-0">
                        <div>
                            <img src="images/onboarding/cinnamon-icon.png" alt="cinnamon-icon">
                            <p class="color-black-100 font-20 font-weight-700 mt-4">Let’s start your journey as an Activity Provider</p>
                            <Button Clicked="NavigateToCreation" Type="ButtonType.Link" Border="Border.Is0.RoundedPill" 
                                class="w-100 font-16 bg-orange-100 color-white-100 hover-color-white mt-3">
                                Create an Activity
                            </Button>
                            <img class="star-img floating-1" src="images/onboarding/star.png" alt="start">
                            <img class="computer-img floating-2" src="images/onboarding/computer.png" alt="computer">
                            <img class="ball-img floating-3" src="images/onboarding/ball.png" alt="ball">
                        </div>
                    </div>
                }
                else 
                {
                    @if(!isEmailSubmitted)
                    {
                        <div class="position-relative text-center padding-70 h-100 m-padding-x-0">
                            <img src="images/onboarding/cinnamon-icon.png" alt="cinnamon-icon">
                            <p class="color-black-100 font-20 font-weight-700 mt-4">Create your <span class="color-orange-100">FREE</span> Cinnamon account!</p>
                            <div>
                                <Validations @ref="emailValidations" Model="formEmailValidator" Mode="ValidationMode.Manual">
                                    <Validation>
                                        <Field class="text-start">
                                            <FieldLabel class="font-16 color-black-100 font-weight-700">Email</FieldLabel>
                                            <FieldBody>
                                                <TextEdit class="border-radius-15 border-shadow-100 border-1-solid border-color-grey-300" 
                                                        Placeholder="Enter your email address" Role="TextRole.Email" @bind-Text="formEmailValidator.Email">
                                                    <Feedback>
                                                        <ValidationError />
                                                    </Feedback>
                                                </TextEdit>
                                            </FieldBody>
                                        </Field>
                                    </Validation>
                                    <div class="mt-3">
                                        <Button Clicked="SubmitEmail" Type="ButtonType.Button" Border="Border.Is0.RoundedPill" 
                                            class="w-100 font-16 bg-orange-100 color-white-100 hover-color-white" 
                                            Disabled="formEmailValidator.IsSubmitting" Loading="formEmailValidator.IsSubmitting">
                                            <LoadingTemplate>
                                                <i id="email-spinner-loading" class="fa fa-spinner fa-spin"></i> Please Wait
                                            </LoadingTemplate>
                                            <ChildContent>
                                                Continue
                                            </ChildContent>
                                        </Button>
                                        @if(!string.IsNullOrEmpty(formEmailValidator.ErrorMessage))
                                        {
                                            <p class="font-14 text-danger">@formEmailValidator.ErrorMessage</p>
                                        }
                                    </div>
                                </Validations>
                                <div class="d-flex align-items-center justify-content-between">
                                    <Divider style="width: 45%;" />
                                    <span class="font-12 color-grey-400">OR</span>
                                    <Divider style="width: 45%;" />
                                </div>
                                <div>
                                    <Button Clicked="GoogleSignInClick" Type="ButtonType.Link" 
                                        class="border-radius-15 border-1-solid border-color-grey-300 border-shadow-100 w-100 p-2">
                                        <label class="d-flex align-content-center justify-content-center cursor-pointer">
                                            <img class="me-2" src="images/onboarding/google-outline.png" alt="google-icon">
                                            <span class="font-16 color-grey-100">Continue with Google</span>
                                        </label>
                                    </Button>
                                </div>
                                @* <div class="mt-3">
                                    <Button Clicked="FacebookSignInClick" Type="ButtonType.Link" 
                                        class="border-radius-15 border-1-solid border-color-grey-300 border-shadow-100 w-100 p-2">
                                        <label class="d-flex align-content-center justify-content-center cursor-pointer">
                                            <img class="me-2" src="images/onboarding/facebook-outline.png" alt="google-icon">
                                            <span class="font-16 color-grey-100">Continue with Facebook</span>
                                        </label>
                                    </Button>
                                </div> *@
                                <p class="margin-top-50 font-14 color-grey-400 text-center">
                                    Already have an account? 
                                    <span @onclick="() => modalLogin.Show()" class="color-green-100 cursor-pointer">Log In</span>
                                </p>
                            </div>
                            <img class="star-img floating-1" src="images/onboarding/star.png" alt="start">
                            <img class="computer-img floating-2" src="images/onboarding/computer.png" alt="computer">
                            <img class="ball-img floating-3" src="images/onboarding/ball.png" alt="ball">
                        </div>
                    }
                    else 
                    {
                        <div class="d-flex align-items-center position-relative text-center padding-70 h-100 m-padding-x-0">
                            <div>
                                <img src="images/onboarding/cinnamon-icon.png" alt="cinnamon-icon">
                                <p class="color-black-100 font-20 font-weight-700 mt-4">Verification Email</p>
                                <p class="font-16 color-black-100">We've sent an email to your inbox. Please check and click verify.
                                    <br>
                                    Haven't received a verification email? <span class="color-orange-100">Resend</span>
                                </p>
                                <img class="star-img floating-1" src="images/onboarding/star.png" alt="start">
                                <img class="computer-img floating-2" src="images/onboarding/computer.png" alt="computer">
                                <img class="ball-img floating-3" src="images/onboarding/ball.png" alt="ball">
                            </div>
                        </div>
                    }
                }
            </Column>
        </Row>
    </div>
</Container>

<ModalLogin @ref="modalLogin" />

@code
{
    private EmailValidator formEmailValidator = new();
    private Validations? emailValidations;
    private int currentPage = 0;
    private bool isEmailSubmitted = false;
    private ModalLogin? modalLogin;

    private bool IsAuthenticated {get; set;}

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if(user != null && user.Identity != null)
        {
            var token = user.FindFirstValue("Token");
            if(user.Identity.IsAuthenticated && !string.IsNullOrEmpty(token))
            {
                IsAuthenticated = true;
            }
        }
    }

    private Task NavigateToCreation()
    {
        NavigationManager.NavigateTo("/maker/activity-selection");
        return Task.CompletedTask;
    }

    private async Task SubmitEmail()
    {
        try
        {
            if(emailValidations != null && await emailValidations.ValidateAll())
            {
                formEmailValidator.IsSubmitting = true;

                var registerWaitlist = await accountApiHandler.RegisterWaitlist(new Framework.ApiCommand.ApiCore.Account.Request.RegisterWaitlistArgs {
                    Email = formEmailValidator.Email,
                    ValidationRoute = config.BaseUrl + "/explore",
                    IsGuest = false
                });

                formEmailValidator.IsSubmitting = false;

                if(!registerWaitlist.Succeeded || registerWaitlist.Result == null)
                {
                    formEmailValidator.ErrorMessage = "An error occured. Please try again later.";
                    return;
                }

                if(registerWaitlist.Succeeded && !registerWaitlist.Result.IsSuccess)
                {
                    switch(registerWaitlist.Result.ErrorInfo?.Code)
                    {
                        case "EMAIL-ALREADY-REGISTERED":
                            formEmailValidator.ErrorMessage = "The provided email address is already registered. Please log in to your account instead.";
                            return;
                        case "EMAIL-ALREADY-REGISTERED-NOT-VERIFIED":
                        case "EMAIL-ALREADY-REGISTERED-VERIFIED":
                            isEmailSubmitted = true;
                            return;
                        default:
                            formEmailValidator.ErrorMessage = "An error occured. Please try again later.";
                            return;
                    }
                }

                isEmailSubmitted = true;
            }   
        }
        catch(Exception ex)
        {
            formEmailValidator.ErrorMessage = "An error occured. Please try again later.";
        }
    }

    private void GoogleSignInClick()
    {
        NavigationManager.NavigateTo("/api/account/GoogleSignIn/", true);
    }

    private void FacebookSignInClick()
    {
        NavigationManager.NavigateTo("/api/account/FacebookSignIn/", true);
    }

    class EmailValidator 
    {
        [Required(ErrorMessage = "The email address field is mandatory.")]
        [EmailAddress(ErrorMessage = "A valid email address is required.")]
        public string Email { get; set; }

        public bool IsSubmitting { get; set; }
        public string ErrorMessage { get; set; } = string.Empty;
    }
}

@layout LandingMainLayout
@page "/onboarding"
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime
@using Cinnamon.Core.Enums
@using Cinnamon.Web.Components
@using System.Globalization
<PageTitle>@Resources.App.appName</PageTitle>

<!--Section 1-->
<div class="section-1 row-lg">
    <div class="onboarding-image-container col-lg-12 col-md-12 col-sm-12 col-xs-12 col-12 order-lg-last order-md-last order-first order-sm-first">
        <div class="onboarding-lg">
            <img id="onboarding-page-image" src="images/onboarding_image1.png" />
        </div>
    </div>

    <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 col-12 order-lg-last order-md-last order-first order-sm-first">
        <span class="onboarding-header">@Resources.App.onboardingHeader</span>
        <span class="onboarding-subheader">@Resources.App.onboardingSubHeader</span>
        <div class="btn-cinnamon btn-cinnamon-section1">
            <PrimaryButton OnClick="NavigateToExplorePage" Width="fit-content" Text=@Resources.App.tryCinnamon/>
        </div>
    </div>
</div>
<!--Section 2-->
<div class="section-2 row-lg">
    <span class="onboarding-header">@Resources.App.stepsToBecome</span>
    <div class="landing-text landing-lg">
        <div class="col-12 onboarding-cards row mx-auto">
            <div class="col-lg-3 col-md-3 overview-card">
                <OnboardingCard ImageSource1="images/onboarding-icon-1.png"
                            Title1="Step 1"
                            Subtitle1="Onboarding"
                            Description1="Follow our step by step guide on how you can maximize Cinnamon" />
            </div>
            <div class="col-lg-3 col-md-3 overview-card">
                <OnboardingCard ImageSource1="images/onboarding-icon-2.png"
                            Title1="Step 2"
                            Subtitle1="Create"
                            Description1="Follow our step by step guide on how you can maximize Cinnamon" />
            </div>
            <div class="col-lg-3 col-md-3 overview-card">
                <OnboardingCard ImageSource1="images/onboarding-icon-3.png"
                            Title1="Step 3"
                            Subtitle1="Setup "
                            Description1="Setup your personal experience page by uploading photos or short videos. " />
            </div>
            <div class="col-lg-3 col-md-3 overview-card">
                <OnboardingCard ImageSource1="images/onboarding-icon-4.png"
                            Title1="Step 4"
                            Subtitle1="Go all out"
                            Description1="Share the best experience to your market! Be a Legendary Cinnamon Maker and earn a special badge!" />
             </div>
        </div>
    </div>
</div>

<ModalSignUp TypeValue="@UserType.Maker"></ModalSignUp>
<!--Beta Alert-->
<BetaAlert></BetaAlert>
<Footer></Footer>

@code{

    IJSObjectReference module;

    private void NavigateToExplorePage()
    {
        NavigationManager.NavigateTo("explore");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
       if(firstRender)
       {
           await jsRuntime.InvokeVoidAsync("MyLib.Track", "Landing Page Loaded");
       }
    }
}



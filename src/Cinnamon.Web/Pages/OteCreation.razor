@page "/experiences/ote"
@page "/experiences/ote/{handler}"
@using System.Security.Claims;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components.Pages.OteActivity;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Framework.Extensions.DateTimeExtension;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService;
@inject IPageProgressService ProgressService;
@inject IActivityApiHandler activityApiHandler;
@inject IAccountApiHandler accountApiHandler;
@inject IJSRuntime JS;
@attribute [Authorize]

<PageTitle>Create an One time event | CinnamonPH</PageTitle>
<SeoMeta Title="Create an one time event" Subject="Create an one time event" Url="/creation/ote" />

<div class="xp-ote-page-wrapper">
    <Container>
        <div class="progress-bar-section mt-4">
            <p class="progress-details">
                IN PROGRESS: Step @(currentIndex + 1) of @numberOfPage <span id="loader"></span>
            </p>
            <div class="progress">
                <div class="progress-bar" role="progressbar" style="width: @(GetPerentCompletion)%;" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </Container>
    <div class="mobile-navigation bg-white-200 py-2 my-4 m-d-block">
        <Container>
            <Row class="align-items-center">
                <Column ColumnSize="ColumnSize.Is2" class="text-start">
                    <div>
                        <img @onclick="MovePrev" class="image-rotate" src="images/experience-creation/play-mobile.png" alt="">
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is8" class="text-center">
                    <label class="font-24 color-black-100 text-capitalize">@sidebarItems[currentIndex].Label</label>
                </Column>
                <Column ColumnSize="ColumnSize.Is2" class="text-end">
                    <div>
                        <img @onclick="MoveNext" src="images/experience-creation/play-mobile.png" alt="">
                    </div>
                </Column>
            </Row>
        </Container>
    </div>
    <Container class="pb-5">
        <div class="d-flex justify-content-start mt-5 mb-5 m-d-none">
            <h3 class="text-uppercase font-32 color-black-100 font-weight-700">let's create your event!</h3>
        </div>
        <Row>
            @if (currentIndex == 0 && oteEvent is not null)
            {
                <Column ColumnSize="ColumnSize.Is12.OnTablet.Is4.OnDesktop" class="col-left" Flex="Flex.AlignContent.Center.OnMobile.OnTablet.AlignContent.Center">
                    <label for="@oteEvent.coverPhoto.FileId" class="cursor-pointer w-100">
                        <InputFile id="@oteEvent.coverPhoto.FileId" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="oteEvent.LoadCoverPhotoFile" />
                        <div class='@(oteEvent.coverPhoto.Display ? "d-none" : "")'>
                            <div class='empty-image-container bg-white-100'>
                                <div class="text-center">
                                    <img src="images/ote/gallery-icon.png" alt="gallery-icon">
                                    <p class="mb-0 mt-1 font-16 color-grey-100 prevent-select">JPEG or PNG only</p>
                                </div>
                            </div>
                            <div class="delete-section d-flex justify-content-between">
                                <p class="delete-text">Upload Cover Photo</p>
                            </div>
                        </div>
                        <Row class="cover-photo-image-container justify-content-center" HorizontalGutter="30">
                            <div class='@(oteEvent.coverPhoto.Display ? "col-12 mb-4 text-center" : "d-none")' id="@oteEvent.coverPhoto.ContainerId">
                                <input type="hidden" id="@oteEvent.coverPhoto.InputDataId" name="@oteEvent.coverPhoto.InputDataId" class="generated-input-data" />
                                <img id="@oteEvent.coverPhoto.ImageSrcId" class="cover-image" src="@oteEvent.coverPhoto.ImageSrc" alt="supporting-photo">
                                <div class="delete-section d-flex justify-content-between">
                                    <p class="delete-text">Upload Cover Photo</p>
                                    <img class="mt-2 cursor-pointer delete-icon" @onclick="oteEvent.DeleteCoverPhoto" src="images/ote/trashcan-icon-white.png" alt="delete">
                                </div>
                            </div>
                        </Row>
                    </label>
                </Column>
            }
            else
            {
                <Column ColumnSize="ColumnSize.Is12.OnTablet.Is4.OnDesktop" class="col-left m-d-none side-ber-items">
                    <OteSidebarNavigation SidebarItems="sidebarItems" />
                    @*<Divider style="background-color: initial; border: 1px dashed;" class="my-5" />
                    <div>
                        @if (sidebarImages.Count > currentIndex)
                        {
                            <h3 class="text-center font-24 color-black-300 font-weight-700">How it will looks like</h3>
                            <img class="mx-auto d-block width-70-p mt-3 h-auto" src="@sidebarImages[currentIndex]" alt="preview">
                        }
                    </div>*@
                </Column>
            }
            <Column ColumnSize="ColumnSize.Is12.OnTablet.Is8.OnDesktop" class="component-section-wrapper col-right">
                <div class='@(currentIndex == 0 ? "d-block" : "d-none")'>
                    <OteEvent @ref="oteEvent" OnNextClick="NextClick" ModelState="eventModel" OnCoverPhotoDisplayChanged="OnCoverPhotoDisplayChanged" />
                </div>

                <div class='@(currentIndex == 1 ? "d-block" : "d-none")'>
                    <OtePricing @ref="otePricing" OnNextClick="NextClick" Token="@token"
                                OnPrevClick="MovePrev" Summary="onlineEventSummary" ModelState="pricingModel" />
                </div>
                <div class='@(currentIndex == 2 ? "d-block" : "d-none")'>
                    <OteSchedule @ref="oteSchedule" OnNextClick="NextClick" Token="@token"
                                 OnPrevClick="MovePrev" ModelState="scheduleModel" />
                </div>
                <div class='@(DisplayOnlineEventSection ? "d-block" : "d-none")'>
                    <OteOnlineEvent @ref="oteOnline" OnNextClick="NextClick" StateModel="onlineModel" OnPrevClick="MovePrev" Token="@token" />
                </div>

                <div class='@(DisplayPublishSection ? "d-block" : "d-none")'>
                    <OtePublish @ref="otePublish" OnNextClick="NextClick" OnPrevClick="MovePrev" Summary="summary" Token="@token" />
                </div>
            </Column>
        </Row>
    </Container>
</div>

@code
{
    [Parameter]
    public string Handler { get; set; }

    private int currentIndex = 0;
    private OteEvent? oteEvent;
    private OteLocation? oteLocation;
    private OtePricing? otePricing;
    private OteSchedule? oteSchedule;
    private OtePublish? otePublish;
    private OteOnlineEvent? oteOnline;
    private IList<OteSidebarNavigation.Item> sidebarItems = new List<OteSidebarNavigation.Item>();
    private IList<string> sidebarImages = new List<string>();
    private IList<ComponentItem<IOteComponent>> components = new List<ComponentItem<IOteComponent>>();
    private OtePublish.ComponentSummary? summary = default;
    private int numberOfPage = 4;
    private OtePricing.ComponentSummary? onlineEventSummary = default;

    private string token = string.Empty;
    private int accountId = 0;
    private int oteId = 0;
    private int summaryIndex = 0;
    private int ticketSold { get; set; } = 0;

    enum EventType {
        None = 0,
        InPerson = 1,
        Online = 2
    }
    private EventType eventType = EventType.None;

    private OteEvent.FormModel eventModel = new();
    private OtePricing.Pricing pricingModel = new();
    private OteSchedule.Schedule scheduleModel = new();
    private OteOnlineEvent.ModelState onlineModel = new();

    protected override void OnInitialized()
    {
        LoadSidebarItems();
        LoadImages();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // get user token
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (!user.Identity.IsAuthenticated || string.IsNullOrEmpty(token))
            {
                // don't have current user login
                throw new ApplicationException("Invalid request");
            }

            var accountRes = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (!accountRes.Succeeded || accountRes.Result is null || !accountRes.Result.IsSuccess)
            {
                throw new ApplicationException("Invalid request");
            }
            accountId = accountRes.Result.Result.Id;

            await LoadCategories();

            LoadComponents();


            if(!string.IsNullOrEmpty(Handler))
            {
                await LoadComponentState();
            }
        }
        catch (System.Exception ex)
        {
            NavigationManager.NavigateTo("explore");
        }
    }

    private double GetPerentCompletion
    {
        get
        {
            return Math.Round((currentIndex + 1) * 20.0);
        }
    }

    private void LoadSidebarItems()
    {
        sidebarItems.Clear();

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "event",
                IsActive = true,
                OnClick = NavigateToEvent
            });

        sidebarItems.Add(new OteSidebarNavigation.Item {
            Label = "tickets",
            IsActive = false,
            OnClick = NavigateToPricings
        });

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "schedule",
                IsActive = false,
                OnClick = NavigateToSchedule
            });

        if(eventType == EventType.Online)
        {
            numberOfPage = 5;
            sidebarItems.Add(new OteSidebarNavigation.Item {
                Label = "online event page",
                IsActive = false,
                OnClick = NavigateToOnlineEvents
            });
        }

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "publish",
                IsActive = false,
                OnClick = NavigateToPublish
            });
    }

    private async Task NavigateToEvent(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 0)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(0);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToPricings(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 1)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(2);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToSchedule(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 2)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(2);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToOnlineEvents(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 3)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(3);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToPublish(OteSidebarNavigation.Item _)
    {
        int publishIndex = eventType == EventType.Online ? 4 : 3;
        if (currentIndex != publishIndex)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(publishIndex);
                summary = GetSummary();
                StateHasChanged();
            }
        }
    }

    private void SetActiveItem(int index)
    {
        foreach (var i in sidebarItems)
        {
            i.IsActive = false;
        }
        currentIndex = index;
        sidebarItems[currentIndex].IsActive = true;
    }

    private void SetValidItem(int index, bool valid)
    {
        sidebarItems[index].IsValid = valid;
    }

    private void LoadImages()
    {
        sidebarImages.Clear();
        sidebarImages.Add("images/ote/event-preview.svg");
        sidebarImages.Add("images/ote/location-preview.svg");
        sidebarImages.Add("images/ote/pricing-preview.svg");
        if (eventType == EventType.Online)
        {
            sidebarImages.Add("images/ote/online-preview.svg");
        }
        sidebarImages.Add("images/ote/gallery-preview.svg");
    }

    private void LoadComponents()
    {
        components.Clear();
        components.Add(new ComponentItem<IOteComponent>
            {
                Component = oteEvent,
                Name = "event",
                HasNext = true,
                HasPrevious = false
            });

        components.Add(new ComponentItem<IOteComponent>
            {
                Component = otePricing,
                Name = "pricing",
                HasNext = true,
                HasPrevious = true
            });
        components.Add(new ComponentItem<IOteComponent>
            {
                Component = oteSchedule,
                Name = "schedule",
                HasNext = true,
                HasPrevious = true
            });
        if (eventType == EventType.Online)
        {
            components.Add(new ComponentItem<IOteComponent>
                {
                    Component = oteOnline,
                    Name = "online event",
                    HasNext = true,
                    HasPrevious = true
                });
        }

        components.Add(new ComponentItem<IOteComponent>
            {
                Component = otePublish,
                Name = "publish",
                HasNext = false,
                HasPrevious = true
            });
    }

    private async Task<Tuple<bool, ComponentItem<IOteComponent>?>> CurrentFieldValid()
    {
        var component = components[currentIndex];
        if (component.Component is not null)
        {
            bool valid = await component.Component.FieldValid();
            return Tuple.Create<bool, ComponentItem<IOteComponent>?>(valid, component);
        }
        return Tuple.Create<bool, ComponentItem<IOteComponent>?>(false, null);
    }

    private async Task NextClick()
    {
        var (valid, field) = await CurrentFieldValid();
        SetValidItem(currentIndex, valid);

        if (valid && field is not null)
        {
            if (field.HasNext)
            {
                int locationIndex = 0;
                if (locationIndex == currentIndex)
                {
                    eventType = oteEvent?.GetData().ExperienceType switch
                    {
                        1 => EventType.InPerson,
                        2 => EventType.Online,
                        _ => EventType.None
                    };
                    LoadComponents();
                    LoadSidebarItems();
                }

                // if in gallery section update summary object
                int galleryIndex = components.Count - 2;
                if (galleryIndex == currentIndex)
                {
                    summary = GetSummary();
                }

                // if in schedule section update onlinemodel object
                int scheduleIndex = 2;
                if (eventType == EventType.Online && currentIndex == scheduleIndex)
                {
                    onlineModel.PricingData = otePricing?.GetData();
                    onlineModel.LocationData = oteLocation?.GetData();
                }

                SetActiveItem(++currentIndex);
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToTop");
            }
            else
            {
                if (oteId == 0)
                {
                    await PublishOte();
                }
                else
                {
                    await UpdateOte();
                }
            }
            LoadImages();
            StateHasChanged();
        }
    }

    private async Task PublishOte()
    {
        try
        {
            summary = GetSummary();
            var eventData = summary.EventData;
            var schedule = summary.ScheduleData;
            var pricing = summary.PricingData;
            var publishData = summary.PublishData;
            var onlineData = string.IsNullOrEmpty(summary.OnlineData.TicketInfos[0].Title) ? null : summary.OnlineData;

            await ProgressService.Go(null, opts => { opts.Color = Color.Warning; });

            var publishOte = await activityApiHandler.CreateOte(new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs
                {
                    Activity = new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OteActivity
                    {
                        BarangayCode             = eventData.BarangayCode,
                        BarangayName             = eventData.BarangayName,
                        CityName                 = eventData.CityName,
                        CityNumber               = eventData.CityCode,
                        Description              = eventData.Description,
                        EventName                = eventData.Name,
                        ExperienceCreationTypeId = 3,
                        CategoryId               = eventData.Category,
                        ExperienceTypeId         = eventData.ExperienceType,
                        HouseNo                  = eventData.HouseNo,
                        IsPublished              = eventData.IsPublish,
                        PinnedLocation           = eventData.PinnedLocation,
                        PostalCode               = eventData.PostalCode,
                        Recurrence               = schedule.Recurrences,
                        RegionCode               = eventData.RegionCode,
                        RegionName               = eventData.RegionName,
                        ScheduleFrom             = schedule.DateFrom,
                        ScheduleTo               = schedule.DateTo,
                        IsComingSoon             = eventData.ComingSoon,
                        DurationEnd              = schedule.DurationEnd,
                        DurationEvery            = schedule.DurationEvery,
                        DurationStart            = schedule.DurationStart,
                        MonthDay                 = schedule.MonthDay,
                        MonthRepeat              = schedule.MonthRepeat,
                        MonthSelection           = schedule.MonthSelection,
                        OnDayDate                = schedule.OnDayDate,
                        WeekString               = schedule.WeekString,
                        EventDurationCount       = schedule.EventDurationCount,
                        EventDurationTimeUnit    = schedule.EventDurationTimeUnit,
                        EventTicketLimit         = pricing.EventTicketLimit,
                        IsOpen                   = pricing.IsOpen
                    },
                    Pricings = pricing.ItemPrices.Select(p =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OtePricing
                        {
                            Description = p.Description ?? string.Empty,
                            IsAbsorbFees = p.AbsorbFees,
                            MaxSlots = p.MaxSlots ?? 0,
                            Price = p.Price ?? 0m,
                            Name = p.Name
                        };
                    }),
                    DateOverrides = schedule.DateOverrides.Select(d =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.DateOverride
                        {
                            Date = d.Date,
                            TimeEnd = d.TimeEnd,
                            TimeStart = d.TimeStart
                        };
                    }),
                    OnlineEvents = onlineData is not null ? onlineData.TicketInfos.Select(a =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OteOnlineEvent
                        {
                            Title = a.Title,
                            Description = a.Description,
                            VideoLink = a.VideoLink,
                            TicketRestriction = a.TicketRestriction,
                        };
                    }) : null
                }, token);

            await ProgressService.Go(-1);

            if (!publishOte.Succeeded || publishOte.Result is null || !publishOte.Result.IsSuccess)
            {
                throw new ApplicationException(publishOte.Message);
            }

            if (oteEvent is not null)
            {
                var uploadRes = await oteEvent.UploadImages(publishOte.Result.Result.ActivityId);
            }

            await NotificationService.Success("Success! You created an activity", "Success");

            await Task.Delay(1000);

            await JS.InvokeVoidAsync("MyLib.Track", "OTE Creation");
            NavigationManager.NavigateTo("/maker/dashboard");
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured when publishing OTE.", "Error");
        }
    }

    private async Task UpdateOte()
    {
        try
        {
            summary = GetSummary();
            var eventData   = summary.EventData;
            var schedule    = summary.ScheduleData;
            var pricing     = summary.PricingData;
            var publishData = summary.PublishData;
            var onlineEvent = summary.OnlineData;
            await ProgressService.Go(null, opts => { opts.Color = Color.Warning; });

            var updateRes = await activityApiHandler.UpdateOte(new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteArgs {
                Activity = new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteArgs.OteUpdateActivity {
                    BarangayCode          = eventData.BarangayCode,
                    BarangayName          = eventData.BarangayName,
                    CategoryId            = eventData.Category,
                    CityName              = eventData.CityName,
                    CityNumber            = eventData.CityCode,
                    Description           = eventData.Description,
                    EventName             = eventData.Name,
                    ExperienceTypeId      = eventData.ExperienceType,
                    HouseNo               = eventData.HouseNo,
                    Id                    = oteId,
                    IsPublished           = eventData.IsPublish,
                    PinnedLocation        = eventData.PinnedLocation,
                    PostalCode            = eventData.PostalCode,
                    IsComingSoon          = eventData.ComingSoon,
                    RegionCode            = eventData.RegionCode,
                    RegionName            = eventData.RegionName,
                    ScheduleFrom          = schedule.DateFrom,
                    ScheduleTo            = schedule.DateTo,
                    Recurrence            = schedule.Recurrences,
                    DurationEnd           = schedule.DurationEnd,
                    DurationEvery         = schedule.DurationEvery,
                    DurationStart         = schedule.DurationStart,
                    MonthDay              = schedule.MonthDay,
                    MonthRepeat           = schedule.MonthRepeat,
                    MonthSelection        = schedule.MonthSelection,
                    OnDayDate             = schedule.OnDayDate,
                    WeekString            = schedule.WeekString,
                    EventDurationCount    = schedule.EventDurationCount,
                    EventDurationTimeUnit = schedule.EventDurationTimeUnit,
                    EventTicketLimit      = pricing.EventTicketLimit,
                    IsOpen                = pricing.IsOpen
                },
                Pricings = pricing.ItemPrices.Select(p => {
                    return new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteArgs.OteUpdatePricing {
                        Description  = p.Description ?? string.Empty,
                        Id           = p.Id,
                        IsAbsorbFees = p.AbsorbFees,
                        MaxSlots     = p.MaxSlots ?? 0,
                        Price        = p.Price ?? 0m,
                        Name         = p.Name
                    };
                }),
                DateOverrides = schedule.DateOverrides.Select(d =>  {
                    return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.DateOverride {
                        Date      = d.Date,
                        TimeEnd   = d.TimeEnd,
                        TimeStart = d.TimeStart
                    };
                }),
                OnlineEvents = oteEvent.GetData().ExperienceType == 2 ? onlineEvent.TicketInfos.Select(s => {
                    return new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteArgs.OteUpdateOnlineEvent {
                        Id                        = s.Id,
                        Title                     = s.Title,
                        Description               = s.Description,
                        VideoLink                 = s.VideoLink,
                        TicketRestriction         = s.TicketRestriction,
                    };
                }) : null,
                OteReschedules = schedule.BookedDates is not null ? schedule.BookedDates.Select(s => new Framework.ApiCommand.ApiCore.Activity.Request.UpdateOteArgs.OteUpdateReschedule {
                    NewDate = s.NewDate,
                    OldDate = s.Date,
                    Id = s.Id
                }) : null
            }, token);

            await ProgressService.Go(-1);

            if (!updateRes.Succeeded || updateRes.Result is null || !updateRes.Result.IsSuccess)
            {
                throw new ApplicationException(updateRes.Message);
            }

            if (oteEvent is not null)
            {
                var uploadRes = await oteEvent.UploadImages(oteId);
            }

            await NotificationService.Success("Success! You updated an activity", "Success");

            await Task.Delay(1000);

            NavigationManager.NavigateTo("/maker/dashboard");
        }
        catch (System.Exception ex)
        {
            await NotificationService.Error("An error occured when publishing OTE.", "Error");
        }
    }

    private async Task LoadComponentState()
    {
        var oteRes = await activityApiHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs
            {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true,
                IncludeOnlineEvent = true
            }, Handler);

        if (!oteRes.Succeeded || oteRes.Result is null || !oteRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }

        var scheduleBookedRes = await activityApiHandler.OteBookedCount(new Framework.ApiCommand.ApiCore.Activity.Request.OteBookedCountArgs {
            ActivityId = oteRes.Result.Result.Id
        }, token);
        if(!scheduleBookedRes.Succeeded || scheduleBookedRes.Result is null || !scheduleBookedRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }
        var firstScheduleDate = scheduleBookedRes.Result.Result.FirstSchedule.Date;
        var from = firstScheduleDate.FirstDayOfMonth().ToString("yyyyMMdd");
        var to = firstScheduleDate.LastDayOfMonth().ToString("yyyyMMdd");

        var scheduleDatesRes = await activityApiHandler.OteScheduleDates(new Framework.ApiCommand.ApiCore.Activity.Request.OteScheduleDatesArgs {
            ActivityId = oteRes.Result.Result.Id,
            From = from,
            To = to
        }, token);
        if(!scheduleDatesRes.Succeeded || scheduleDatesRes.Result is null || !scheduleDatesRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }

        if (oteRes.Result.Result.ProviderId != accountId)
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }
        var ote = oteRes.Result.Result;

        // set event details
        oteId                        = ote.Id;
        eventModel.SelectedCategory  = ote.CategoryId;
        eventModel.Description       = ote.Description;
        eventModel.EventName         = ote.EventName;
        await oteEvent?.SetState(new OteEvent.ModelData
        {
            BarangayCode   = ote.BarangayCode,
            BarangayName   = ote.BarangayName,
            CityCode       = ote.CityNumber,
            CityName       = ote.CityName,
            HouseNo        = ote.HouseNo, 
            PinnedLocation = ote.PinnedLocation,
            PostalCode     = ote.PostalCode,
            RegionCode     = ote.RegionCode,
            RegionName     = ote.RegionName,
            IsPublish      = ote.IsPublished,
            ComingSoon     = ote.IsComingSoon,
            ExperienceType = ote.ExperienceTypeId,
            images = ote.Images.Select(i =>
                {
                    return new OteEvent.ImageItem
                    {
                        Id = i.Id,
                        ImageSrc = i.ImageSrc,
                        Order = i.Order
                    };
                }).ToList()
        });

        // set ote schedules state and parameters
        //Pricing
        var options                   = ote.OteSchedule.ExtraOptions.Split("|");
        pricingModel.EventTicketLimit = ote.OteSchedule.EventTicketLimit;
        pricingModel.IsLimit          = ote.OteSchedule.EventTicketLimit != 0 ? 2 : 1;
        pricingModel.IsOpen           = ote.OteSchedule.IsOpen;
        await otePricing?.SetState(new OtePricing.ModelData {
            ItemPrices            = ote.OteSchedule.OteSchedulePricingGroups.Select(p => {
                 int totalTicketsSold = ote.Pricings
                .Where(pricing => pricing.OteSchedulePricingGroupId == p.Id).Sum(pricing => pricing.TicketSold);
                return new OtePricing.ModelData.ItemPrice {
                    AbsorbFees = p.IsAbsorbFees,
                    Description = p.Description,
                    Id = p.Id,
                    MaxSlots = p.MaxSlots,
                    Price = p.Price,
                    Name = p.Name,
                    TicketSold = totalTicketsSold
                };
            }).ToList(),
        });

        //Schedule
        await oteSchedule?.SetState(new OteSchedule.ModelData
            {
                Recurrences = ote.Recurrences,
                WeekString = ote.OteSchedule.SelectedDays,
                BookedDates = scheduleDatesRes.Result.Result.Select(s => new OteSchedule.ModelData.BookedDate
                {
                    Date = s.Date,
                    Id = s.Id,
                    NewDate = s.Date
                }).ToList()
            });
        scheduleModel.EventDurationTimeStart = ote.ScheduleFrom.TimeOfDay;
        scheduleModel.DateFrom               = ote.ScheduleFrom;
        scheduleModel.DateTo                 = ote.ScheduleTo;
        scheduleModel.TimeFrom               = scheduleModel.DateFrom.TimeOfDay;
        scheduleModel.TimeTo                 = scheduleModel.DateTo.TimeOfDay;
        scheduleModel.DurationEnd            = (ote.OteSchedule.RecurrenceDateEnd == DateTime.MinValue) ? DateTime.Now : ote.OteSchedule.RecurrenceDateEnd;
        scheduleModel.DurationStart          = (ote.OteSchedule.RecurrenceDateStart == DateTime.MinValue) ? DateTime.Now : ote.OteSchedule.RecurrenceDateStart;
        scheduleModel.DurationEvery          = ote.OteSchedule.RepeatEvery;
        scheduleModel.MonthDay               = options.Length >= 4 ? options[3] : "sunday";
        scheduleModel.MonthRepeat            = options.Length >= 3 ? options[2] : "first";
        scheduleModel.MonthSelection         = options.Length >= 1 && int.TryParse(options[0], out int monthNum) ? monthNum : 1;
        scheduleModel.OnDayDate              = options.Length >= 2 && int.TryParse(options[1], out int dayNum) ? dayNum  : 1;
        scheduleModel.EventDurationCount     = ote.OteSchedule.EventDurationCount;
        scheduleModel.EventDurationTimeUnit  = ote.OteSchedule.EventDurationTimeUnit;

        if(ote.ExperienceTypeId == 2)
        {
            eventType = EventType.Online;
            onlineModel.PricingData = otePricing?.GetData();
            onlineModel.LocationData = oteLocation?.GetData();

            if(ote.OnlineEvent is not null)
            {
                oteOnline?.SetState(new OteOnlineEvent.ModelData {
                        TicketInfos = ote.OnlineEvent.Select(a => {
                        return new OteOnlineEvent.ModelData.TicketInfo {
                            Id                        = a.Id,
                            Title                     = a.Title,
                            Description               = a.Description,
                            VideoLink                 = a.Videolink,
                            TicketRestriction         = a.TicketRestriction,
                        };
                    }).ToList()
                });
            }

            numberOfPage = ote.ExperienceTypeId == 2 ? 5 : 4;
        }

        //oteGallery?.SetState(ote.Images.Select(i => {
        //    return new OteGallery.ImageItem {
        //        Id = i.Id,
        //        ImageSrc = i.ImageSrc,
        //        Order = i.Order
        //    };
        //}).ToList());

        //await oteSummary?.SetState(scheduleDatesRes.Result.Result.Select(
        //    d => new OteSummary.BookedDate {
        //        Date = d.Date,
        //        Id = d.Id,
        //        NewDate = d.Date
        //    }),
        //    oteRes.Result.Result.Id
        //);

        await otePublish?.SetState(scheduleDatesRes.Result.Result.Select(
            d => new OtePublish.BookedDate {
                Date = d.Date,
                Id = d.Id,
                NewDate = d.Date
            }),
            oteRes.Result.Result.Id,
            true
        );

        LoadSidebarItems();
        LoadImages();
        LoadComponents();
        StateHasChanged();
    }

    private OtePublish.ComponentSummary GetSummary()
    {
        return new OtePublish.ComponentSummary
            {
                EventData    = oteEvent.GetData(),
                ScheduleData = oteSchedule.GetData(),
                PricingData  = otePricing.GetData(),
                PublishData  = otePublish.GetData(),
                OnlineData   = oteOnline.GetData()
            };
    }

    private OtePricing.ComponentSummary GetOnlineSummary()
    {
        return new OtePricing.ComponentSummary
            {
                OnlineData = oteOnline.GetData()
            };
    }

    private async Task MoveNext()
    {
        var (valid, field) = await CurrentFieldValid();
        if(valid && field.HasNext && currentIndex < sidebarItems.Count -1)
        {
            SetActiveItem(++currentIndex);
            if(currentIndex == 4)
            {
                summary = GetSummary();
            }
        }
    }

    private async Task MovePrev()
    {
        //var (valid, field) = await CurrentFieldValid();
        if(currentIndex > 0)
        {
            if (currentIndex == 3)
            {
                onlineEventSummary = GetOnlineSummary();
            }
            SetActiveItem(--currentIndex);
            await JS.InvokeVoidAsync("MyLib.Utils.scrollToTop");
        }
    }

    private async Task LoadCategories()
    {
        var categoryRes = await activityApiHandler.GetExperienceCategories();
        if(categoryRes.Succeeded && categoryRes.Result is not null && categoryRes.Result.IsSuccess)
        {
            var categories = categoryRes.Result.Result.Where(c => c.Name.ToLower() != "new");
            foreach(var item in categories)
            {
                eventModel.categoryItems.Add(new OteEvent.CategoryItem {
                    Id = item.Id,
                    Name = item.Name,
                    Selected = false
                });
            }
        }
    }

    private bool DisplayOnlineEventSection 
    {
        get {
            return eventType == EventType.Online && currentIndex == 3;
        }
    }


    private bool DisplayPublishSection 
    {
        get 
        {
            return currentIndex == (eventType == EventType.Online ?  4 : 3);
        }
    }

    private Task OnCoverPhotoDisplayChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private class ComponentItem<T> where T : IOteComponent 
    {
        public T? Component { get; set; }
        public string Name { get; set; } = string.Empty;
        public bool HasPrevious { get; set; }
        public bool HasNext { get; set; }
    }

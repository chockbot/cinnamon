    private async Task LoadComponentState()
    {
        var oteRes = await activityApiHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs
            {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true,
                IncludeOnlineEvent = true
            }, Handler);

        if (!oteRes.Succeeded || oteRes.Result is null || !oteRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }

        var feedbackTemplateRes = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs {
            ActivityId = oteRes.Result.Result.Id,
            TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteThankYou.ToString()
        }, token);

        var reminderTemplateRes = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs {
            ActivityId = oteRes.Result.Result.Id,
            TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteReminder.ToString()
        }, token);

        var pendingTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs {
            ActivityId = oteRes.Result.Result.Id,
            TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OtePending.ToString()
        }, token);

        var acceptedTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs {
            ActivityId = oteRes.Result.Result.Id,
            TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteConfirmed.ToString()
        }, token);

        var declinedTemplate = activityApiHandler.GetEmailTemplate(new Framework.ApiCommand.ApiCore.Activity.Request.GetEmailTemplateArgs {
            ActivityId = oteRes.Result.Result.Id,
            TemplateType = Cinnamon.Framework.Enums.EmailTemplateType.OteDeclined.ToString()
        }, token);

        string pendingBody = string.Empty;
        string acceptedBody = string.Empty;
        string declinedBody = string.Empty;

        await Task.WhenAll(feedbackTemplateRes, reminderTemplateRes, pendingTemplate, acceptedTemplate, declinedTemplate);
        var feedbackResult = feedbackTemplateRes.Result;
        var reminderResult = reminderTemplateRes.Result;
        var pendingResult = pendingTemplate.Result;
        var accpedtedResult = acceptedTemplate.Result;
        var declinedResult = declinedTemplate.Result;

        var feedback = new OtePublish.ScheduleNotification {
            Body = string.Empty,
            Days = oteRes.Result.Result.OteSchedule.EmailFeedbackDays,
            Subject = string.Empty
        };

        var reminder = new OtePublish.ScheduleNotification {
            Body = string.Empty,
            Days = oteRes.Result.Result.OteSchedule.EmailReminderDays,
            Subject = string.Empty
        };

        if(feedbackResult.Succeeded && feedbackResult.Result is not null && feedbackResult.Result.IsSuccess)
        {
            feedback.Body = feedbackResult.Result.Result.Body;
            feedback.Subject = feedbackResult.Result.Result.Subject;
        }

        if(reminderResult.Succeeded && reminderResult.Result is not null && reminderResult.Result.IsSuccess)
        {
            reminder.Body = reminderResult.Result.Result.Body;
            reminder.Subject = reminderResult.Result.Result.Subject;
        }

        if(pendingResult.Succeeded && pendingResult.Result is not null && pendingResult.Result.IsSuccess)
        {
            pendingBody = pendingResult.Result.Result.Body;
        }

        if(accpedtedResult.Succeeded && accpedtedResult.Result is not null && accpedtedResult.Result.IsSuccess)
        {
            acceptedBody = accpedtedResult.Result.Result.Body;
        }

        if(declinedResult.Succeeded && declinedResult.Result is not null && declinedResult.Result.IsSuccess)
        {
            declinedBody = declinedResult.Result.Result.Body;
        }

        var providerQuestions = new List<OtePricing.CustomQuestion>();

        var providerQuestionsRes = await activityApiHandler.ProviderQuestions(new Framework.ApiCommand.ApiCore.Activity.Request.ProviderQuestionsArgs {
            ActivityId = oteRes.Result.Result.Id
        }, token);
        if(providerQuestionsRes.Succeeded && providerQuestionsRes.Result is not null && providerQuestionsRes.Result.IsSuccess)
        {
            providerQuestions.AddRange(providerQuestionsRes.Result.Result.Select(q => new OtePricing.CustomQuestion {
                FieldType = q.FieldType,
                IsNew = false,
                Question = q.FieldLabel,
                Required = q.Required,
                Id = q.Id
            }));
        }

        var scheduleBookedRes = await activityApiHandler.OteBookedCount(new Framework.ApiCommand.ApiCore.Activity.Request.OteBookedCountArgs {
            ActivityId = oteRes.Result.Result.Id
        }, token);
        if(!scheduleBookedRes.Succeeded || scheduleBookedRes.Result is null || !scheduleBookedRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }
        var firstScheduleDate = scheduleBookedRes.Result.Result.FirstSchedule.Date;
        var from = firstScheduleDate.FirstDayOfMonth().ToString("yyyyMMdd");
        var to = firstScheduleDate.LastDayOfMonth().ToString("yyyyMMdd");

        var scheduleDatesRes = await activityApiHandler.OteScheduleDates(new Framework.ApiCommand.ApiCore.Activity.Request.OteScheduleDatesArgs {
            ActivityId = oteRes.Result.Result.Id,
            From = from,
            To = to
        }, token);
        if(!scheduleDatesRes.Succeeded || scheduleDatesRes.Result is null || !scheduleDatesRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
            return;
        }

        if (oteRes.Result.Result.ProviderId != accountId)
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }
        var ote = oteRes.Result.Result;

        // set event details
        oteId                        = ote.Id;
        eventModel.SelectedCategory  = ote.CategoryId;
        eventModel.Description       = ote.Description;
        eventModel.EventName         = ote.EventName;
        eventModel.imageItems        = ote.Images.Select(a =>
        {
            return new OteEvent.ImageItem
                {
                    Id = a.Id,
                    ImageSrc = a.ImageSrc,
                    Order = a.Order
                };
        }).ToList();


        await oteEvent?.SetState(new OteEvent.ModelData
        {
            BarangayCode   = ote.BarangayCode,
            BarangayName   = ote.BarangayName,
            CityCode       = ote.CityNumber,
            CityName       = ote.CityName,
            HouseNo        = ote.HouseNo, 
            PinnedLocation = ote.PinnedLocation,
            PostalCode     = ote.PostalCode,
            RegionCode     = ote.RegionCode,
            RegionName     = ote.RegionName,
            IsPublish      = ote.IsPublished,
            ComingSoon     = ote.IsComingSoon,
            ExperienceType = ote.ExperienceTypeId,
            images         = ote.Images.Select(a =>
            {
                return new OteEvent.ImageItem
                {
                    Id = a.Id,
                    ImageSrc = a.ImageSrc,
                    Order = a.Order
                };
            }).ToList()
        });

        // set ote schedules state and parameters
        //Pricing
        var options                   = ote.OteSchedule.ExtraOptions.Split("|");
        pricingModel.EventTicketLimit = ote.OteSchedule.EventTicketLimit;
        pricingModel.IsLimit          = ote.OteSchedule.EventTicketLimit != 0 ? 2 : 1;
        pricingModel.IsOpen           = ote.OteSchedule.IsOpen;
        pricingModel.IsCapacity       = ote.OteSchedule.IsCapacity;
        pricingModel.CapacityCount    = ote.OteSchedule.CapacityCount;

        await otePricing?.SetState(new OtePricing.ModelData {
            ItemPrices            = ote.OteSchedule.OteSchedulePricingGroups.Select(p => {
                 int totalTicketsSold = ote.Pricings
                .Where(pricing => pricing.OteSchedulePricingGroupId == p.Id).Sum(pricing => pricing.TicketSold);
                return new OtePricing.ModelData.ItemPrice {
                    AbsorbFees       = p.IsAbsorbFees,
                    Description      = p.Description,
                    Id               = p.Id,
                    MaxSlots         = p.MaxSlots,
                    Price            = p.Price,
                    Name             = p.Name,
                    TicketSold       = totalTicketsSold,
                    IsUnlimited      = p.IsUnlimited,
                    RequiredApproval = p.RequiredApproval,
                    IsFree           = p.Price == 0 ? true : false
                };
            }).ToList(),
            CustomAcceptedBody = acceptedBody,
            CustomDeclinedBody = declinedBody,
            CustomPendingBody = pendingBody,
            UpdatedQuestions = providerQuestions
        });

        //Schedule
        await oteSchedule?.SetState(new OteSchedule.ModelData
            {
                Recurrences = ote.Recurrences,
                WeekString = ote.OteSchedule.SelectedDays,
                BookedDates = scheduleDatesRes.Result.Result.Select(s => new OteSchedule.ModelData.BookedDate
                {
                    Date = s.Date,
                    Id = s.Id,
                    NewDate = s.Date
                }).ToList()
            });
        scheduleModel.EventDurationTimeStart = ote.ScheduleFrom.TimeOfDay;
        scheduleModel.DateFrom               = ote.ScheduleFrom;
        scheduleModel.DateTo                 = ote.ScheduleTo;
        scheduleModel.TimeFrom               = scheduleModel.DateFrom.TimeOfDay;
        scheduleModel.TimeTo                 = scheduleModel.DateTo.TimeOfDay;
        scheduleModel.DurationEnd            = (ote.OteSchedule.RecurrenceDateEnd == DateTime.MinValue) ? DateTime.Now : ote.OteSchedule.RecurrenceDateEnd;
        scheduleModel.DurationStart          = (ote.OteSchedule.RecurrenceDateStart == DateTime.MinValue) ? DateTime.Now : ote.OteSchedule.RecurrenceDateStart;
        scheduleModel.DurationEvery          = ote.OteSchedule.RepeatEvery;
        scheduleModel.MonthDay               = options.Length >= 4 ? options[3] : "sunday";
        scheduleModel.MonthRepeat            = options.Length >= 3 ? options[2] : "first";
        scheduleModel.MonthSelection         = options.Length >= 1 && int.TryParse(options[0], out int monthNum) ? monthNum : 1;
        scheduleModel.OnDayDate              = options.Length >= 2 && int.TryParse(options[1], out int dayNum) ? dayNum  : 1;
        scheduleModel.EventDurationCount     = ote.OteSchedule.EventDurationCount;
        scheduleModel.EventDurationTimeUnit  = ote.OteSchedule.EventDurationTimeUnit;

        if(ote.ExperienceTypeId == 2)
        {
            eventType = EventType.Online;
            onlineModel.PricingData = otePricing?.GetData();
            onlineModel.LocationData = oteLocation?.GetData();

            if(ote.OnlineEvent is not null)
            {
                oteOnline?.SetState(new OteOnlineEvent.ModelData {
                        TicketInfos = ote.OnlineEvent.Select(a => {
                        return new OteOnlineEvent.ModelData.TicketInfo {
                            Id                        = a.Id,
                            Title                     = a.Title,
                            Description               = a.Description,
                            VideoLink                 = a.Videolink,
                            TicketRestriction         = a.TicketRestriction,
                        };
                    }).ToList()
                });
            }

            numberOfPage = ote.ExperienceTypeId == 2 ? 5 : 4;
        }
        else
        {
            eventType = EventType.InPerson;
        }

        await otePublish?.SetState(scheduleDatesRes.Result.Result.Select(
            d => new OtePublish.BookedDate {
                Date = d.Date,
                Id = d.Id,
                NewDate = d.Date
            }),
            oteRes.Result.Result.Id,
            true,
            feedback,
            reminder
        );

        LoadSidebarItems();
        LoadImages();
        LoadComponents();
        StateHasChanged();
    }


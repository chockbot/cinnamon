                                        <div class="image-section">
                                            <LoadingIndicator @ref="loadingIndicator">
                                                <input type="hidden" id="@oteEvent.coverPhoto.InputDataId" name="@oteEvent.coverPhoto.InputDataId" class="generated-input-data" />
                                                <a @onclick="() => ShowModal()">
                                                    <img id="@oteEvent.coverPhoto.ImageSrcId" class="cover-image" src="@oteEvent.coverPhoto.ImageSrc" alt="cover-photo">
                                                </a>
                                            </LoadingIndicator>
                                            <button class="btn-upload" @onclick="() => ShowModal()"><svg xmlns=" http: //www.w3.org/2000/svg" viewBox="0 0 16 16"><path fill="currentColor" fill-rule="evenodd" d="M8 .25h-.042c-1.369 0-2.454 0-3.32.088-.888.09-1.629.28-2.277.713a4.8 4.8 0 0 0-1.31 1.31c-.434.648-.623 1.39-.713 2.277C.25 5.504.25 6.589.25 7.958v.084c0 1.369 0 2.454.088 3.32.09.888.28 1.629.713 2.277.346.519.791.964 1.31 1.31.648.434 1.39.623 2.277.713.866.088 1.951.088 3.32.088h.084c1.369 0 2.454 0 3.32-.088.888-.09 1.629-.28 2.277-.712a4.8 4.8 0 0 0 1.31-1.311c.434-.648.623-1.39.713-2.277.088-.866.088-1.951.088-3.32v-.084c0-1.369 0-2.454-.088-3.32-.09-.888-.28-1.629-.712-2.277a4.8 4.8 0 0 0-1.311-1.31c-.648-.434-1.39-.623-2.277-.713C10.496.25 9.411.25 8.042.25zm2.32 8.535c.156-.21.735-.868 1.486-.4.478.295.88.694 1.31 1.12.164.164.28.35.359.549.234.6.112 1.323-.138 1.918a2.59 2.59 0 0 1-1.583 1.479c-.318.104-.652.149-.984.149h-5.9c-.587 0-1.106-.14-1.532-.403-.267-.165-.314-.545-.116-.791q.494-.617.986-1.242c.628-.797 1.051-1.029 1.522-.826.19.084.382.21.579.343.525.357 1.255.847 2.216.315.658-.369 1.04-1 1.372-1.551l.006-.01.07-.115a7 7 0 0 1 .347-.535M3.8 5.55c0-.965.784-1.75 1.75-1.75.964 0 1.748.785 1.748 1.75S6.514 7.3 5.55 7.3 3.8 6.515 3.8 5.55"></path></svg></button>
                                        </div>
                                        <div class="delete-section d-flex justify-content-between">
                                            <p class="delete-text">Upload Cover Photo</p>
                                            <img class="mt-2 cursor-pointer delete-icon" @onclick="oteEvent.DeleteCoverPhoto" src="images/ote/trashcan-icon-white.png" alt="delete">
                                        </div>
                                    </div>
                                </Row>
                            </label>
                        
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnTablet.Is4.OnDesktop" class='@(currentIndex != 0 && oteEvent is not null ? "d-block col-left m-d-none" : "d-none col-left m-d-none")'>
                        <OteSidebarNavigation SidebarItems="sidebarItems" />
                        @*<Divider style="background-color: initial; border: 1px dashed;" class="my-5" />
                        <div>
                        @if (sidebarImages.Count > currentIndex)
                        {
                        <h3 class="text-center font-24 color-black-300 font-weight-700">How it will looks like</h3>
                        <img class="mx-auto d-block width-70-p mt-3 h-auto" src="@sidebarImages[currentIndex]" alt="preview">
                        }
                        </div>*@
                    </Column>

                    <Column ColumnSize="ColumnSize.Is12.OnTablet.Is8.OnDesktop" class="component-section-wrapper col-right">
                        <div class='@(currentIndex == 0 ? "d-block" : "d-none")'>
                            <OteEvent @ref="oteEvent" OnNextClick="NextClick" ModelState="eventModel" 
                                OnCoverPhotoDisplayChanged="OnCoverPhotoDisplayChanged"
                                OnSelectTemplateClick="OnSelectTemplateClick" />
                        </div>

                        <div class='@(currentIndex == 1 ? "d-block" : "d-none")'>
                            <OtePricing @ref="otePricing" OnNextClick="NextClick" Token="@token"
                                        OnPrevClick="MovePrev" Summary="onlineEventSummary" ModelState="pricingModel" />
                        </div>
                        <div class='@(currentIndex == 2 ? "d-block" : "d-none")'>
                            <OteSchedule @ref="oteSchedule" OnNextClick="NextClick" Token="@token"
                                        OnPrevClick="MovePrev" ModelState="scheduleModel" />
                        </div>
                        <div class='@(DisplayOnlineEventSection ? "d-block" : "d-none")'>
                            <OteOnlineEvent @ref="oteOnline" OnNextClick="NextClick" StateModel="onlineModel" OnPrevClick="MovePrev" Token="@token" />
                        </div>

                        <div class='@(DisplayPublishSection ? "d-block" : "d-none")'>
                            <OtePublish @ref="otePublish" OnNextClick="NextClick" OnPrevClick="MovePrev" Summary="summary" Token="@token" />
                        </div>
                    </Column>
                </Row>
            </Container>
        </div>
        
        @if(isSelectSeatPlan)
        {
            <Row class="creation-seatplan-wrapper">
                <Column ColumnSize="ColumnSize.Is9.OnDesktop">
                    <Container>
                        <div class="seat-plan-content pt-3">
                            @if(!string.IsNullOrEmpty(seatPlanPayload))
                            {
                                <Cinnamon.Web.Components.Common.SeatPlan.Container ViewOnly="true" Payload="@seatPlanPayload" />
                            }
                            else
                            {
                                <div class="seat-plan">
                                    <p>Seat plan not available</p>
                                </div>
                            }
                        </div>
                    </Container>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop">
                    <div class="seat-plan-sidebar">
                        <div class="position-relative h-100">
                            <div class="p-3 text-center">
                                <h4 class="m-0 color-black-100 font-18 font-weight-700">Select Template</h4>        
                            </div>

                            <ListGroup style="border-radius: 0px;" Mode="ListGroupMode.Selectable" SelectedItemChanged="SelectedItemChanged">
                                @foreach (var template in templates)
                                {
                                    <ListGroupItem Name="@template.Id.ToString()" class="p-3">@template.Name</ListGroupItem>
                                }
                            </ListGroup>

                            <div class="seat-plan-footer">
                                <div class="p-3">
                                    <p class="m-0">
                                        <span class="color-black-100">Your place isn’t in the list?</span>
                                        <br>
                                        <a href="mailto:admin@cinnamon.ph">Contact us</a> 
                                        <span class="color-grey-100">for support in creating a customize template for your event place.</span>
                                    </p>
                                </div>
                                <Divider />
                                <div class="p-3">
                                    <Button Clicked="SaveSelectedTemplate" Loading="savingSelectedTemplate" Disabled="savingSelectedTemplate"
                                        class="bg-orange-100 color-white-100" Border="Border.Is0">
                                        <ChildContent>
                                            Save
                                        </ChildContent>
                                        <LoadingTemplate>
                                            <i id="email-spinner-loading" class="fa fa-spinner fa-spin"></i> Please Wait
                                        </LoadingTemplate>
                                    </Button>
                                    <Button Clicked="CancelSelectedTemplate" Disabled="savingSelectedTemplate"
                                        class="bg-grey-300 color-grey-100" Border="Border.Is0">
                                        Cancel
                                    </Button>
                                </div>
                            </div>
                        </div>
                    </div>
                </Column>
            </Row>
        }
        
    </div>
</LoadingIndicator>

<Modal @ref="modalRef">
    <ModalContent Class="header-modal" Size="ModalSize.Large" Style="border-radius:1rem;" Centered>
        <ModalHeader>
            <div class="col-11 d-flex modal-header-section">
                <p class="modal-title text-center">Choose Image</p>
            </div>
            <button type="button" class="btn-close" @onclick="() => HideModal()"></button>
        </ModalHeader>
        <ModalBody>
            <label for="@oteEvent.coverPhoto.FileId" class="cursor-pointer w-100">
                <InputFile id="@oteEvent.coverPhoto.FileId" accept=".png,.jpg,.jpeg" name="photo-upload" class="d-none" OnChange="oteEvent.LoadCoverPhotoFile" />
                <div class="tap-here">
                    <p class="click">Click here to upload.</p>
                    <p class="choose">Or choose an image below. The ideal aspect is ration is 4:5.</p>
                </div>
            </label>
            <div class="suggested-images">
                <p class="category-name m-d-none">@ImageTitle</p>
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-12 col-12 m-d-none categories">
                        <p class="image-category" @onclick="() => LoadFiles(1)">Abstract</p>
                        <p class="image-category" @onclick="() => LoadFiles(4)">Game</p>
                        <p class="image-category" @onclick="() => LoadFiles(2)">Music</p>
                        <p class="image-category" @onclick="() => LoadFiles(3)">Technology</p>
                        
                    </div>
                    <div class="categories-swipper col-12">
                        <div class="row d-flex justify-content-start">
                            <div class="col-sm-12 col-12 categories-container">
                                <div class="schedule-swiper">
                                    <div class="swiper-wrapper text-center">
                                        <div class="swiper-slide category">
                                            <div>
                                                <a class="button carousel-list text-center" id="1" @onclick="() => LoadFiles(1)">
                                                    <p class="image-category">Abstract</p>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="swiper-slide category">
                                            <div>
                                                <a class="button carousel-list text-center" id="2" @onclick="() => LoadFiles(2)">
                                                    <p class="image-category">Game</p>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="swiper-slide category">
                                            <div>
                                                <a class="button carousel-list text-center" id="3" @onclick="() => LoadFiles(3)">
                                                    <p class="image-category">Music</p>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="swiper-slide category">
                                            <div>
                                                <a class="button carousel-list text-center" id="4" @onclick="() => LoadFiles(4)">
                                                    <p class="image-category">Technology</p>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="swiper-scrollbar"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-9 col-sm-12 col-12 photo-preview">
                        @foreach (var item in MaterialList)
                        {
                            <img src="@item.ThumbnailLink" alt="banner image" class="cover-image-item" @onclick="() => LoadCoverPhoto(item)" />
                        }
                    </div>
                </div>
            </div>
        </ModalBody>
    </ModalContent>
</Modal>

@code
{
    [Parameter]
    public string Handler { get; set; }

    [Parameter]
    public int Tab { get; set; }

    private int currentIndex = 0;
    private OteEvent? oteEvent;
    private OteLocation? oteLocation;
    private OtePricing? otePricing;
    private OteSchedule? oteSchedule;
    private OtePublish? otePublish;
    private OteOnlineEvent? oteOnline;
    private IList<OteSidebarNavigation.Item> sidebarItems = new List<OteSidebarNavigation.Item>();
    private IList<string> sidebarImages = new List<string>();
    private IList<ComponentItem<IOteComponent>> components = new List<ComponentItem<IOteComponent>>();
    private OtePublish.ComponentSummary? summary = default;
    private int numberOfPage = 4;
    private OtePricing.ComponentSummary? onlineEventSummary = default;
    public Modal modalRef = new();

    public string searchValue = string.Empty;
    public List<File> MaterialList = new List<File>();
    public List<File> LoadList = new List<File>();
    public List<File> SearchList = new List<File>();
    private string nextPageToken = null;
    private bool allFilesLoaded = false;
    public string FolderID { get; set; } = "1Grg39ZXLAIqnPSRjuQrkZQrS3T3Yr8uU";
    public string ImageTitle { get; set; } = "Abstract";
    public Random random = new Random();


    //File
    public string FileId { get; set; }
    public byte[] FileContent { get; set; }
    public string FileType { get; set; }
    public string FileName { get; set; }
    public string Base64EncodedFile { get; set; }
    private LoadingIndicator? loadingIndicator;
    private LoadingIndicator? updateLoadingIndicator;

    private string token = string.Empty;
    private int accountId = 0;
    private int oteId = 0;
    private int summaryIndex = 0;
    private int ticketSold { get; set; } = 0;

    enum EventType {
        None = 0,
        InPerson = 1,
        Online = 2
    }
    private EventType eventType = EventType.None;

    private OteEvent.FormModel eventModel = new();
    private OtePricing.Pricing pricingModel = new();
    private OteSchedule.Schedule scheduleModel = new();
    private OteOnlineEvent.ModelState onlineModel = new();
    
    private bool isSelectSeatPlan = false;
    private List<Cinnamon.Framework.ApiCommand.ApiCore.DTO.SeatPlan.SeatPlanTemplateDTO> templates = new();
    private string seatPlanPayload = string.Empty;
    private int selectedTemplateId = 0;
    private bool savingSelectedTemplate = false;

    protected override void OnInitialized()
    {
        LoadSidebarItems();
        LoadImages();

        oteEvent = new OteEvent
        {
            coverPhoto = new OteEvent.ImageItem
            {
                ContainerId = "cover-photo-container",
                Display     = false,
                FileSize    = 0,
                ImageSrcId  = "cover-photo-image-src",
                InputDataId = "cover-photo-input-data",
                FileId      = "cover-photo-input-file",
                Order       = 0
            }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // get user token
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if (!user.Identity.IsAuthenticated || string.IsNullOrEmpty(token))
            {
                // don't have current user login
                throw new ApplicationException("Invalid request");
            }

            var accountRes = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (!accountRes.Succeeded || accountRes.Result is null || !accountRes.Result.IsSuccess)
            {
                throw new ApplicationException("Invalid request");
            }
            accountId = accountRes.Result.Result.Id;

            if (!string.IsNullOrEmpty(Handler))
            {
                await updateLoadingIndicator.Show();
                await Task.Delay(500);
                await LoadComponentState();
                switch (Tab)
                {
                    case 1:
                        currentIndex = 1;
                        break;
                    case 2:
                        summary = GetSummary();
                        if (eventType == EventType.InPerson)
                        {
                            currentIndex = 3;
                            otePublish?.OnSelectedScheduledEmail(0);
                        }
                        else
                        {
                            currentIndex = 4;
                            otePublish?.OnSelectedScheduledEmail(0);
                        }
                        break;
                    case 3:
                        summary = GetSummary();
                        if (eventType == EventType.InPerson)
                        {
                            currentIndex = 3;
                            otePublish?.OnSelectedScheduledEmail(1);
                        }
                        else
                        {
                            currentIndex = 4;
                            otePublish?.OnSelectedScheduledEmail(1);
                        }
                        break;
                    case 4:
                        currentIndex = 1;
                        otePricing?.modalCustomQuestion.Show();
                        break;
                    case 5:
                        currentIndex = 1;
                        otePricing?.registrationModal.Show();
                        break;
                    case 6:
                        currentIndex = 1;
                        otePricing?.capacityModal.Show();
                        break;
                    case 7:
                        currentIndex = 1;
                        otePricing?.OnPendingEmailTemplateClick();
                        break;
                    case 8:
                        currentIndex = 1;
                        otePricing?.OnAcceptedTemplateClick();
                        break;
                    case 9:
                        currentIndex = 1;
                        otePricing?.OnDeclinedTemplateClick();
                        break;
                    case 10:
                        currentIndex = 1;
                        otePricing.IsEditRegistration = true;
                        break;
                    default:
                        break;
                }
                await updateLoadingIndicator.Hide();
            }

            await LoadSeatPlanTemplates();

            await LoadCategories();

            LoadComponents();
        }
        catch (System.Exception ex)
        {
            NavigationManager.NavigateTo("explore");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFiles(1);
            if (string.IsNullOrEmpty(Handler))
            {
                await SetDefaultCoverPhoto();
            }
        }
        await JS.InvokeVoidAsync("MyLib.Pages.maker.attendance.initSwiper", ".schedule-swiper", ".swiper-scrollbar");
        await InitializeSwiper();
    }
    private async Task InitializeSwiper()
    {
        await JS.InvokeVoidAsync("MyLib.Pages.activity.explore.initSwiper", ".activity-swiper", ".activity-swiper-scrollbar");
    }
    private double GetPerentCompletion
    {
        get
        {
            double multiple = numberOfPage == 4 ? 25 : (numberOfPage == 5 ? 20 : 0);
            return Math.Round((currentIndex + 1) * multiple);
        }
    }

    private void LoadSidebarItems()
    {
        sidebarItems.Clear();

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "event",
                IsActive = true,
                OnClick = NavigateToEvent
            });

        sidebarItems.Add(new OteSidebarNavigation.Item {
            Label = "tickets",
            IsActive = false,
            OnClick = NavigateToPricings
        });

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "schedule",
                IsActive = false,
                OnClick = NavigateToSchedule
            });

        if(eventType == EventType.Online)
        {
            numberOfPage = 5;
            sidebarItems.Add(new OteSidebarNavigation.Item {
                Label = "online event page",
                IsActive = false,
                OnClick = NavigateToOnlineEvents
            });
        }

        sidebarItems.Add(new OteSidebarNavigation.Item
            {
                Label = "publish",
                IsActive = false,
                OnClick = NavigateToPublish
            });
    }

    private async Task NavigateToEvent(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 0)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(0);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToPricings(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 1)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(1);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToSchedule(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 2)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(2);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToOnlineEvents(OteSidebarNavigation.Item _)
    {
        if (currentIndex != 3)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(3);
                StateHasChanged();
            }
        }
    }

    private async Task NavigateToPublish(OteSidebarNavigation.Item _)
    {
        int publishIndex = eventType == EventType.Online ? 4 : 3;
        if (currentIndex != publishIndex)
        {
            var (valid, _) = await CurrentFieldValid();
            SetValidItem(currentIndex, valid);
            if (valid)
            {
                SetActiveItem(publishIndex);
                summary = GetSummary();
                StateHasChanged();
            }
        }
    }

    private void SetActiveItem(int index)
    {
        foreach (var i in sidebarItems)
        {
            i.IsActive = false;
        }
        currentIndex = index;
        sidebarItems[currentIndex].IsActive = true;
    }

    private void SetValidItem(int index, bool valid)
    {
        sidebarItems[index].IsValid = valid;
    }

    private void LoadImages()
    {
        sidebarImages.Clear();
        sidebarImages.Add("images/ote/event-preview.svg");
        sidebarImages.Add("images/ote/location-preview.svg");
        sidebarImages.Add("images/ote/pricing-preview.svg");
        if (eventType == EventType.Online)
        {
            sidebarImages.Add("images/ote/online-preview.svg");
        }
        sidebarImages.Add("images/ote/gallery-preview.svg");
    }

    private void LoadComponents()
    {
        components.Clear();
        components.Add(new ComponentItem<IOteComponent>
            {
                Component = oteEvent,
                Name = "event",
                HasNext = true,
                HasPrevious = false
            });

        components.Add(new ComponentItem<IOteComponent>
            {
                Component = otePricing,
                Name = "pricing",
                HasNext = true,
                HasPrevious = true
            });
        components.Add(new ComponentItem<IOteComponent>
            {
                Component = oteSchedule,
                Name = "schedule",
                HasNext = true,
                HasPrevious = true
            });
        if (eventType == EventType.Online)
        {
            components.Add(new ComponentItem<IOteComponent>
                {
                    Component = oteOnline,
                    Name = "online event",
                    HasNext = true,
                    HasPrevious = true
                });
        }

        components.Add(new ComponentItem<IOteComponent>
            {
                Component = otePublish,
                Name = "publish",
                HasNext = false,
                HasPrevious = true
            });
    }

    private async Task<Tuple<bool, ComponentItem<IOteComponent>?>> CurrentFieldValid()
    {
        var component = components[currentIndex];
        if (component.Component is not null)
        {
            bool valid = await component.Component.FieldValid();
            return Tuple.Create<bool, ComponentItem<IOteComponent>?>(valid, component);
        }
        return Tuple.Create<bool, ComponentItem<IOteComponent>?>(false, null);
    }

    private async Task NextClick()
    {
        var (valid, field) = await CurrentFieldValid();
        SetValidItem(currentIndex, valid);

        if (valid && field is not null)
        {
            if (field.HasNext)
            {
                int locationIndex = 0;
                if (locationIndex == currentIndex)
                {
                    eventType = oteEvent?.GetData().ExperienceType switch
                    {
                        1 => EventType.InPerson,
                        2 => EventType.Online,
                        _ => EventType.None
                    };
                    numberOfPage = eventType == EventType.Online ? 5 : 4;
                    LoadComponents();
                    LoadSidebarItems();
                }

                // if in gallery section update summary object
                int galleryIndex = components.Count - 2;
                if (galleryIndex == currentIndex)
                {
                    summary = GetSummary();
                }

                // if in schedule section update onlinemodel object
                int scheduleIndex = 2;
                if (eventType == EventType.Online && currentIndex == scheduleIndex)
                {
                    onlineModel.PricingData = otePricing?.GetData();
                    onlineModel.LocationData = oteLocation?.GetData();
                }

                SetActiveItem(++currentIndex);
                await JS.InvokeVoidAsync("MyLib.Utils.scrollToTop");
            }
            else
            {
                if (oteId == 0)
                {
                    await PublishOte();
                }
                else
                {
                    await UpdateOte();
                }
            }
            LoadImages();
            StateHasChanged();
        }
    }

    private async Task PublishOte()
    {
        try
        {
            summary = GetSummary();
            var eventData = summary.EventData;
            var schedule = summary.ScheduleData;
            var pricing = summary.PricingData;
            var publishData = summary.PublishData;
            var onlineData = string.IsNullOrEmpty(summary.OnlineData.TicketInfos[0].Title) ? null : summary.OnlineData;

            await ProgressService.Go(null, opts => { opts.Color = Color.Warning; });

            var publishOte = await activityApiHandler.CreateOte(new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs
                {
                    Activity = new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OteActivity
                    {
                        BarangayCode             = eventData.BarangayCode,
                        BarangayName             = eventData.BarangayName,
                        CityName                 = eventData.CityName,
                        CityNumber               = eventData.CityCode,
                        Description              = eventData.Description,
                        EventName                = eventData.Name,
                        ExperienceCreationTypeId = 3,
                        CategoryId               = eventData.Category,
                        ExperienceTypeId         = eventData.ExperienceType,
                        HouseNo                  = eventData.HouseNo,
                        IsPublished              = eventData.IsPublish,
                        PinnedLocation           = eventData.PinnedLocation,
                        PostalCode               = eventData.PostalCode,
                        Recurrence               = schedule.Recurrences,
                        RegionCode               = eventData.RegionCode,
                        RegionName               = eventData.RegionName,
                        ScheduleFrom             = schedule.DateFrom,
                        ScheduleTo               = schedule.DateTo,
                        IsComingSoon             = eventData.ComingSoon,
                        DurationEnd              = schedule.DurationEnd,
                        DurationEvery            = schedule.DurationEvery,
                        DurationStart            = schedule.DurationStart,
                        MonthDay                 = schedule.MonthDay,
                        MonthRepeat              = schedule.MonthRepeat,
                        MonthSelection           = schedule.MonthSelection,
                        OnDayDate                = schedule.OnDayDate,
                        WeekString               = schedule.WeekString,
                        EventDurationCount       = schedule.EventDurationCount,
                        EventDurationTimeUnit    = schedule.EventDurationTimeUnit,
                        EventTicketLimit         = pricing.EventTicketLimit,
                        IsOpen                   = pricing.IsOpen,
                        IsCapacity               = pricing.IsCapacity,
                        CapacityCount            = pricing.CapacityCount,
                        EmailFeedbackDays        = publishData.EmailFeedback.Days,
                        EmailReminderDays        = publishData.EmailReminder.Days,
                        FeedbackBody             = publishData.EmailFeedback.Body,
                        FeedbackSubject          = publishData.EmailFeedback.Subject,
                        ReminderBody             = publishData.EmailReminder.Body,
                        ReminderSubject          = publishData.EmailReminder.Subject,
                        CustomAcceptedBody       = pricing.CustomAcceptedBody,
                        CustomDeclinedBody       = pricing.CustomDeclinedBody,
                        CustomPendingBody        = pricing.CustomPendingBody,
                        ReserveSeat             = selectedTemplateId > 0,
                        SeatPlanTemplateId      = selectedTemplateId
                    },
                    Pricings = pricing.ItemPrices.Select(p =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OtePricing
                        {
                            Description = p.Description ?? string.Empty,
                            IsAbsorbFees = p.AbsorbFees,
                            MaxSlots = p.MaxSlots ?? 0,
                            Price = p.Price ?? 0m,
                            Name = p.Name,
                            IsUnlimited = p.IsUnlimited,
                            RequiredApproval = p.RequiredApproval,
                            ReserveSeatUuid = p.ReserveSeatUuid
                        };
                    }),
                    DateOverrides = schedule.DateOverrides.Select(d =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.DateOverride
                        {
                            Date = d.Date,
                            TimeEnd = d.TimeEnd,
                            TimeStart = d.TimeStart
                        };
                    }),
                    OnlineEvents = onlineData is not null ? onlineData.TicketInfos.Select(a =>
                    {
                        return new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.OteOnlineEvent
                        {
                            Title = a.Title,
                            Description = a.Description,
                            VideoLink = a.VideoLink,
                            TicketRestriction = a.TicketRestriction,
                        };
                    }) : null,
                    Questions = pricing.NewQuestions.Select(q => new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteArgs.CustomQuestion {
                        FieldType = q.FieldType,
                        Question = q.Question,
                        Required = q.Required
                    })
                }, token);

            await ProgressService.Go(-1);

            if (!publishOte.Succeeded || publishOte.Result is null || !publishOte.Result.IsSuccess)
            {
                throw new ApplicationException(publishOte.Message);
            }

            if (oteEvent is not null)
            {
                var uploadRes = await oteEvent.UploadImages(publishOte.Result.Result.ActivityId);
            }

            await NotificationService.Success("Success! You created an activity", "Success");

            await Task.Delay(1000);

            await JS.InvokeVoidAsync("MyLib.Track", "OTE Creation");
            NavigationManager.NavigateTo("/maker/dashboard");
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured when publishing OTE.", "Error");
        }
    }


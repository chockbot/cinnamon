    private async Task LoadFiles(string folderId, string imageTitle)
    {
        ImageTitle = imageTitle;
        LoadList.Clear();
        var result = await googleDriveService.ListFilesInFolder(folderId, nextPageToken);
        LoadList.AddRange(result.FileList);
        MaterialList = LoadList.ToList();
        nextPageToken = result.Token;

        // Check if there are no more files to load
        if (string.IsNullOrEmpty(nextPageToken))
        {
            allFilesLoaded = true;
        }
    }
    private async Task LoadCoverPhoto(File item)
    {
        await loadingIndicator.Show();
        // Fetch file content from Google Drive
        FileContent = await googleDriveService.GetFileContent(item.Id);

        // Determine file type
        var fileInfo = await googleDriveService.GetFileInfo(item.Id);
        FileType = fileInfo.Type;
        FileName = fileInfo.Name;

        // If you need to display the file content directly, you can convert it to Base64
        Base64EncodedFile = Convert.ToBase64String(FileContent);

        //delete old images
        var oldCoverImage = eventModel.imageItems.Where(i => i.Order == 0);
        foreach (var img in oldCoverImage)
        {
            oteEvent.deletedIds.Add(img.Id);
        }

        //Preview
        await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewBase64Image", $"#{oteEvent.coverPhoto.ImageSrcId}", $"#{oteEvent.coverPhoto.InputDataId}", Base64EncodedFile, FileType);
        oteEvent.coverPhoto.Display = true;
        await HideModal();
        await loadingIndicator.Hide();
    }

    private async Task SetDefaultCoverPhoto()
    {
        //Get Random Image in MaterialList
        List<File> list = new List<File>();
        list = MaterialList.ToList();
        int randomIndex = random.Next(list.Count);
        File randomItem = list[randomIndex];
        await LoadDefaultCoverPhoto(randomItem);
    }

    private async Task LoadDefaultCoverPhoto(File item)
    {
        try
        {
            // Fetch file content from Google Drive
            FileContent = await googleDriveService.GetFileContent(item.Id);

            // Determine file type
            var fileInfo = await googleDriveService.GetFileInfo(item.Id);
            FileType = fileInfo.Type;
            FileName = fileInfo.Name;

            // If you need to display the file content directly, you can convert it to Base64
            Base64EncodedFile = Convert.ToBase64String(FileContent);

            //Preview
            await JS.InvokeVoidAsync("MyLib.Pages.activity.creation.previewBase64Image", $"#{oteEvent.coverPhoto.ImageSrcId}", $"#{oteEvent.coverPhoto.InputDataId}", Base64EncodedFile, FileType);
            oteEvent.coverPhoto.Display = true;
            StateHasChanged();
        }
        catch (System.Exception)
        {
            // handler error when trying to invoke the client srcript but the page was redirected to another
        }
    }

    private async Task LoadSeatPlanTemplates()
    {
        var templatesRes = await seatPlanApiHandler.GetTemplates(new Framework.ApiCommand.ApiCore.SeatPlan.Request.GetTemplatesArgs {

        }, token);

        if(templatesRes.Succeeded && templatesRes.Result is not null && templatesRes.Result.IsSuccess)
        {
            templates = templatesRes.Result.Result.ToList();
        }
    }

    private async Task SelectedItemChanged(string value)
    {
        seatPlanPayload = string.Empty;
        StateHasChanged();

        if (int.TryParse(value, out int templateId))
        {
            selectedTemplateId = templateId;
            await LoadSeatPlanTemplate(templateId);
        }
    }

    private async Task LoadSeatPlanTemplate(int templateId)
    {
        var templateRes = await seatPlanApiHandler.GetTemplate(templateId, token);
        if(templateRes.Succeeded && templateRes.Result is not null && templateRes.Result.IsSuccess)
        {
            var template = templateRes.Result.Result;
            seatPlanPayload = template.Payload;

            StateHasChanged();
        }
    }

    private async Task SaveSelectedTemplate()
    {
        if (string.IsNullOrEmpty(seatPlanPayload))
        {
            return;
        }

        savingSelectedTemplate = true;
        StateHasChanged();

        eventModel.TemplateSelected.Id = selectedTemplateId;
        eventModel.TemplateSelected.Payload = seatPlanPayload;
        eventModel.TemplateSelected.ImageSrc = templates.FirstOrDefault(t => t.Id == selectedTemplateId)?.ImageSrc;

        isSelectSeatPlan = false;

        await otePricing.CreateDefaultTickets(seatPlanPayload);

        savingSelectedTemplate = false;

        StateHasChanged();
    }

    private Task CancelSelectedTemplate()
    {
        seatPlanPayload = string.Empty;
        selectedTemplateId = 0;

        isSelectSeatPlan = false;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnSelectTemplateClick()
    {
        isSelectSeatPlan = !isSelectSeatPlan;
        return Task.CompletedTask;
    }

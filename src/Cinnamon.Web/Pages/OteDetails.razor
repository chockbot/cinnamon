    private async Task LoadWaitlist()
    {
        //0-NO STATUS 1-PENDING 2-APPROVED 3-DECLINED
        var waitlists = await activityHandler.GetOteWaitlistByProvider(new Framework.ApiCommand.ApiCore.Activity.Request.GetOteWaitlistByProviderArgs
        {
            ProviderId = provider.Id,
            ActivityId = activity.Id,
            Status = new[] {1}
        }, token);
        if (waitlists.Succeeded && waitlists.Result is not null && waitlists.Result.IsSuccess)
        {
            IsOnWaitlist = waitlists.Result.Result.Any(a => a.CustomerId == ProfileId);
            var oteWaitlistDTOs = waitlists.Result.Result.Where(a => a.CustomerId == ProfileId);
            foreach (var item in oteWaitlistDTOs)
            {
                WaitlistIds.Add(item.Id);
            }
        }
    }
    private async Task RemoveFromWaitlist()
    {
        bool allSucceeded = true;
        foreach (var waitlistId in WaitlistIds)
        {
            var removeWaitlist = await activityHandler.DeleteOteWaitlist(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteOteWaitlistArgs
                {
                    Id = waitlistId
                }, token);

            if (!(removeWaitlist.Succeeded && removeWaitlist.Result is not null && removeWaitlist.Result.IsSuccess))
            {
                allSucceeded = false;
            }
        }
        if (allSucceeded)
        {
            //Add Email
            WaitlistIds.Clear();
            await LoadWaitlist();
            await NotificationService.Success("You're removed from the waitlist.", "Success");
        }
        else
        {
            await NotificationService.Error("Failed to remove one or more items from waitlist.", "Error");
        }
    }


    private async Task JoinWaitlist()
    {
        //0 NO STATUS 1 PENDING 2 APPROVED 3 DECLINED
        if (!activity.IsEventSoldOut)
        {
            //Get Selected Ticket
            if (selectedTickets.Count <= 0)
            {
                await NotificationService.Error("Select a ticket to proceed.", "Oops!");
                return;
            }
            var payloadData = selectedTickets.Select(s => new TicketDetails
                {
                    Id = s.Value.Id,
                    Count = s.Value.Count,
                    Date = selectedDate
                });
            if (currentLogin is null)
            {
                string oteDetailsUrl = $"/explore/ote/{Handler}";
                await loginModal.Show();
                signInReturnUrl = oteDetailsUrl;
                return;
            }
            var serializedPayload = JsonConvert.SerializeObject(payloadData);
            //Add to Waitlist
            var waitlist = await activityHandler.CreateOteWaitlist(new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteWaitlistArgs
                {
                    ActivityId   = activity.Id,
                    ScheduleId   = SelectedScheduleId,
                    CustomerId   = ProfileId,
                    CustomerName = ProfileName,
                    ProviderId   = provider.Id,
                    Status       = 1,
                    Payload      = serializedPayload
            },token);
            if (waitlist.Succeeded && waitlist.Result is not null && waitlist.Result.IsSuccess)
            {

                //Add Email
                await NotificationService.Success("Successfully added to waitlist.", "Success");
                await LoadWaitlist();
            }
        }
        else 
        {
            await NotificationService.Error("This event is sold out!", "Sold Out");
        }
    }


@page "/explore/ote/{Handler}"
@using System.Security.Claims;
@using Cinnamon.Web.Components.Pages;
@using AutoMapper;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models.Ote;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Common;
@inject INotificationService NotificationService;
@inject IActivityApiHandler activityHandler;
@inject IAccountApiHandler accountApiHandler;
@inject NavigationManager NavigationManager;
@inject IMapper mapper;
@inject IJSRuntime JS;
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(activity?.EventName ?? "Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH") | CinnamonPH</PageTitle>
<SeoMeta Title="@(activity?.EventName ?? string.Empty)"
         Description="@(activity?.Description ?? string.Empty)"
         Subject="@(activity?.EventName ?? string.Empty)"
         Url='@SeoUrl'
         Image="@SeoImage"
         Keywords='new List<string>{"events","one time events", "cinnamon event"}' />

@if(activity is not null)
{
    <Container class="ote-details-wrapper pt-5">
        <section class="px-1">
            <h3 class="font-36 font-weight-700 mb-3 color-black-100 text-capitalize m-font-24">@activity.EventName</h3>
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    @if(activity.ExperienceTypeId == 1)
                    {
                        <img class="xp-type-img me-2" src="images/activity-summary/location.png" alt="in-person" />
                        <label class="font-14 font-weight-700 color-white-100 rounded-pill bg-black-100 prevent-select px-3 py-1">In-Person</label>
                    }
                    else 
                    {
                        <img class="xp-type-img me-2" src="images/activity-summary/laptop-icon.png" alt="online" />
                        <label class="font-14 font-weight-700 color-white-100 rounded-pill bg-black-100 prevent-select px-3 py-1">Online</label>
                    }
                </div>
                <div class="d-flex">
                    <div class="me-4 prevent-select" @onclick="OnFavoriteClick">
                        <label class="m-d-none cursor-pointer me-1 font-20 color-grey-100 font-weight-400 text-decoration-underline">Add to Favorites</label>
                        <img style="width: 25px;" class="cursor-pointer h-auto" src='@(isActivityFavorite ?  "images/ote/favorite.png" : "images/ote/heart-default.png")' alt="favorite">
                    </div>
                    <div class="cursor-pointer prevent-select" @onclick="CopyToClipboard">
                        <label class="m-d-none cursor-pointer me-1 font-20 color-grey-100 font-weight-400 text-decoration-underline">Share this Activity</label>
                        <img style="width: 20px;" class="cursor-pointer h-auto" src="images/ote/copy-link.png" alt="share">
                    </div>
                </div>
            </div>
        </section>

        <section class="mt-3">
            <div class="d-block m-d-none">
                @if(activity.Images.Count() >= 5)
                {
                    <div class="grid-gallery detail-md shadow position-relative">
                        <div class="grid-gallery-item grid-gallery-item-1">
                            <figure>
                                <img src="@activity.Images.ElementAt(0).ImageSrc" alt="cover-photo">
                            </figure>
                        </div>
                        <div class="grid-gallery-item grid-gallery-item-2">
                            <figure>
                                <img src="@activity.Images.ElementAt(1).ImageSrc" alt="supporting-photo">
                            </figure>
                        </div>
                        <div class="grid-gallery-item grid-gallery-item-3">
                            <figure>
                                <img src="@activity.Images.ElementAt(2).ImageSrc" alt="supporting-photo">
                            </figure>
                        </div>
                        <div class="grid-gallery-item grid-gallery-item-4">
                            <figure>
                                <img src="@activity.Images.ElementAt(3).ImageSrc" alt="supporting-photo">
                            </figure>
                        </div>
                        <div class="grid-gallery-item grid-gallery-item-5">
                            <figure>
                                <img src="@activity.Images.ElementAt(4).ImageSrc" alt="supporting-photo">
                            </figure>
                        </div>
                        <a style="bottom: 20px; left: 20px;" 
                            class="hover-color-black-100 prevent-select text-capitalize position-absolute 
                                text-decoration-none d-inline-block bg-white-100 font-16 font-weight-700 color-black-100 border-radius-5 py-1 px-3" 
                            href='@($"/explore/ote/{Handler}/gallery")'>Gallery</a>
                    </div>
                }
                else 
                {
                    <div class="gallery position-relative">
                        <figure class="gallery__item gallery__item--1">
                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(0).ImageSrc" alt="image" />
                        </figure>
                        <figure class="gallery__item gallery__item--2">
                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(1).ImageSrc" alt="image" />
                        </figure>
                        <figure class="gallery__item gallery__item--3">
                            <img class="img-fluid shadow rounded gallery__img" src="@activity.Images.ElementAt(2).ImageSrc" alt="image" />
                        </figure>
                        <a style="bottom: 35px; left: 20px;" 
                            class="hover-color-black-100 prevent-select text-capitalize position-absolute 
                                text-decoration-none d-inline-block bg-white-100 font-16 font-weight-700 color-black-100 border-radius-5 py-1 px-3" 
                            href='@($"/explore/ote/{Handler}/gallery")'>Gallery</a>
                    </div>
                }
            </div>
            <div class="d-none m-d-block position-relative mb-3">
                <img class="w-100 h-auto" src="@activity.Images.FirstOrDefault()?.ImageSrc" alt="cover-image">
                <a style="right: 1rem; bottom: 1rem;" 
                    class="hover-color-black-100 prevent-select text-capitalize position-absolute 
                        text-decoration-none d-inline-block bg-white-100 font-16 font-weight-700 color-black-100 border-radius-5 py-1 px-3" 
                    href='@($"/explore/ote/{Handler}/gallery")'>Gallery</a>
            </div>
        </section>
        <Row>
            <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop">
                @if(provider is not null)
                {
                    <section>
                        <div class="d-inline-flex">
                            <div class="d-flex align-items-center me-2 me-md-5">
                                <img class="provider-avatar rounded-circle" src="@provider.ProfilePath" alt="avatar">
                                <div class="ms-3">
                                    <label class="font-16 font-weight-400 color-grey-100 m-font-14">Experience by</label>
                                    <p class="text-capitalize font-16 font-weight-700 color-black-100 mb-0 m-font-14">@provider.FirstName @provider.LastName</p>
                                </div>
                            </div>
                            <div class="d-inline-flex align-items-center">
                                @if(provider.IsVerified == 2)
                                {
                                    <Tooltip Multiline=true Text="For uploading and completing all identification requirements.">
                                        <img class="me-1 provider-badge cursor-pointer" src="images/Badges/new/verified.svg" alt="badge" />
                                    </Tooltip>
                                }
                                @if(provider.IsOG)
                                {
                                    <Tooltip Multiline=true Text="For being part of the alpha and beta testing.">
                                        <img class="me-1 provider-badge cursor-pointer" src="images/Badges/new/og.svg" />
                                    </Tooltip>
                                }
                                @if(provider.IsOfficial)
                                {
                                    <Tooltip Multiline=true Text="Legitimate experience provider in the platform.">
                                        <img class="me-1 provider-badge cursor-pointer" src="images/Badges/new/official.svg" alt="badge" />
                                    </Tooltip>
                                }
                            </div>
                        </div>
                        <Divider />
                    </section>
                }

                <section id="ote-description">
                    <h3 class="font-24 font-weight-700 color-black-100 mb-0 m-font-20">About </h3>
                    <p class="text-justify font-18 color-grey-100 mt-2 mt-md-4 m-font-16">@activity.Description</p>
                </section>

                @if(!activity.IsComingSoon)
                {
                    <section class="xp-ote-container mt-4 mb-5">
                        <h3 class="font-24 font-weight-700 color-black-100 m-font-20">Date & Time</h3>
                        <div class="flex-column flex-md-row select-calendar-container p-4 bg-black-100 position-relative mt-4 border-radius-20 d-flex justify-content-between" style="z-index: 99;">
                            <SelectCalendar CurrentDate="activity.ScheduleFrom" SelectedDates="new List<DateTime>{activity.ScheduleFrom}" ViewOnly />
                            <Button id="ote-btn-check-avail" class="mt-3 mt-md-0 font-16 font-weight-700 color-white-100 bg-green-100 hover-color-white border-radius-20">Check Availability</Button>
                        </div>
                        <div class="mt-4 border-radius-10 border-1-solid border-color-grey-200 overflow-hidden">
                            <div class="p-3">
                                <p class="font-20 font-weight-700 color-black-100 mb-3 text-capitalize">@activity.EventName</p>
                                <Row VerticalGutter="20">
                                    <Column ColumnSize="ColumnSize.Is6">
                                        <div class="d-flex align-items-center">
                                            <img class="me-3" src="images/ote/clock-repeat.png" alt="clock">
                                            <label class="font-16 color-black-100">3 Hours</label>
                                        </div>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is6">
                                        <div class="d-flex align-items-center">
                                            <img class="me-3" src="images/ote/clock.png" alt="clock">
                                            <label class="font-16 color-black-100">@activity.ScheduleFrom.ToString("hh:mm tt")</label>
                                        </div>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is12">
                                        <div class="d-flex align-items-center">
                                            <img class="me-3" src="images/ote/location.png" alt="clock">
                                            @if(activity.ExperienceTypeId == 1)
                                            {
                                                <label class="font-16 color-black-100">@activity.HouseNo, @activity.BarangayName, @activity.CityName, @activity.RegionName</label>
                                            }
                                            else 
                                            {
                                                <label class="font-16 color-black-100">Online</label>
                                            }
                                        </div>
                                    </Column>
                                </Row>
                            </div>
                            <div class="border-top-1-solid border-color-grey-200 p-3">
                                @foreach (var item in activity.Pricings)
                                {
                                    <Row @key="item" class="align-items-center mb-4">
                                        <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop" Padding="Padding.Is1.FromBottom">
                                            <p class="font-20 font-weight-700 color-black-100 mb-0">@item.Name</p>
                                            <p class="mb-0 color-green-100 font-20 font-weight-700 mt-2 d-flex align-items-center">
                                                <span>
                                                    ₱ @item.Price.ToString("#,##0")
                                                </span>
                                                @if(item.MaxSlots <= item.TicketSold)
                                                {
                                                    <span class="ms-2 text-uppercase bg-red-200 font-10 color-white-100 border-radius-10 py-1 px-2">
                                                        sold out
                                                    </span>
                                                }
                                                @* display count left *@
                                                @if(item.MaxSlots > item.TicketSold && (item.MaxSlots - item.TicketSold) <= 10)
                                                {
                                                    <span class="ms-2 text-uppercase bg-orange-100 font-10 color-white-100 border-radius-10 py-1 px-2">
                                                        Only @(item.MaxSlots - item.TicketSold) ticket/s left
                                                    </span>
                                                }
                                            </p>
                                            <p class="font-16 text-justify color-grey-100 mt-2 mb-1">@item.Description</p>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                                            <div data-disabled="@(item.MaxSlots <= item.TicketSold)" class="d-flex border-1-solid item-counter-container text-center border-radius-5 overflow-hidden">
                                                <span @onclick="() => RemoveSelectedTicket(item)" class="p-1 border-right-1-solid counter-item prevent-select">
                                                    <span class="item-action">-</span>
                                                </span>
                                                <span class="p-1 border-right-1-solid counter-item">
                                                    @(selectedTickets.ContainsKey(item.Id) ? selectedTickets[item.Id].Count : 0)
                                                </span>
                                                <span @onclick="() => AddSelectedTicket(item)" class="p-1 counter-item prevent-select">
                                                    <span class="item-action">+</span>
                                                </span>
                                            </div>
                                        </Column> 
                                    </Row>
                                }
                            </div>
                        </div>
                    </section>

                    <section id="important-information">
                        <p class="font-weight-700 font-24 color-black-100 text-capitalize m-font-20">Important Information</p>
                        <p class="font-18 fw-bold color-black-100 m-font-16">What will happen after I purchase?</p>
                        <ol class="color-grey-100 font-18 m-font-16">
                            <li>You will be added to a chat group with the activity provider to clarify /answer any of your questions. Go to the MENU and select MESSAGES to access chat.</li>
                            <li>You can also be contacted by the activity provider, please make sure that your email and mobile number are correct.</li>
                            <li>You can also contact your activity provider by using the email and mobile number that can be found in the payment confirmation email.</li>
                            <li>Cinnamon secures your payment and will be credited to the activity provider/tutor once their session/s with you is complete.</li>
                        </ol>
                    </section>

                    <section id="map-details" class="mt-5">
                        <p class="font-24 font-weight-700 color-black-100 m-font-20 mb-1 mb-md-3">Venue</p>
                        @if(activity.ExperienceTypeId == 1)
                        {
                            <p class="mb-1 font-20 font-weight-400 color-black-100 m-font-16">@activity.HouseNo, @activity.BarangayName, @activity.CityName, @activity.RegionName</p>
                            <iframe height="373" id="mapframe" frameborder="0" style="border:0" class="w-100" src="@MapSource" allowfullscreen></iframe>
                        }
                        else 
                        {
                            <p class="mb-1 font-20 font-weight-400 color-black-100 m-font-16">Online</p>
                        }
                    </section>

                    @if(!string.IsNullOrEmpty(SetPlanImage))
                    {
                        <section id="set-plan" class="mt-4">
                            <p class="font-24 font-weight-700 color-black-100">Seat Plan</p>
                            <img style="width: 330px; height: auto;" src="@SetPlanImage" alt="seatplan">
                        </section>
                    }
                }

                @if(activity.IsComingSoon)
                {
                    <div class="my-5">
                        <img class="max-width-100 h-auto" src="images/coming-soon.png" alt="coming soon">    
                    </div>
                }
            </Column>
            <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                @if(!activity.IsComingSoon)
                {
                    <div class="calculator-wrapper-container border-radius-10 bg-orange-100 pt-2 border-color-grey-200 border-1-solid position-sticky">
                        <div class="bg-white-100 px-3 py-4 border-radius-10">
                            <p class="font-20 font-weight-700 color-black-200">₱ @TotalPayment.ToString("#,##0.00")</p>
                            <div class="overflow-hidden border-radius-5 border-1-solid border-color-grey-200 mb-3">
                                <div class="p-2 border-bottom-1-solid border-color-grey-200 color-grey-100">
                                    @SelectedTicketName
                                </div>
                                <div class="p-2 color-grey-100">
                                    @OverallTicketCount @(OverallTicketCount > 1 ? "Tickets" : "Ticket")
                                </div>
                            </div>
                            @foreach (var item in selectedTickets)
                            {
                                <Row class="color-grey-100 font-16 mt-2">
                                    <Column ColumnSize="ColumnSize.Is7">
                                        <p class="m-0">₱ @item.Value.Price.ToString("#,##0") x @item.Value.Count  @(item.Value.Count > 1 ? "Tickets" : "Ticket")</p>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is5">
                                        <p class="text-end m-0">₱ @((item.Value.Price * item.Value.Count).ToString("#,##0.00"))</p>
                                    </Column>
                                </Row>
                            }
                            @if(!IsInclusivePricing)
                            {
                                <Row class="color-grey-100 font-16 mt-2">
                                    <Column ColumnSize="ColumnSize.Is7">
                                        <p class="m-0">Service  fee - <span class="">0%</span></p>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is5">
                                        <p class="text-end m-0">₱ @ServiceFee.ToString("#,##0,00")</p>
                                    </Column>
                                </Row>
                                <Row class="color-grey-100 font-16 mt-2">
                                    <Column ColumnSize="ColumnSize.Is7">
                                        <p class="m-0">Handling  fee</p>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is5">
                                        <p class="text-end m-0">₱ @HandlingFee.ToString("#,##0.00")</p>
                                    </Column>
                                </Row>
                            }
                            <Divider class="m-0 mt-2" />
                            <Row class="font-16 mt-2 font-weight-700 color-black-100">
                                <Column ColumnSize="ColumnSize.Is7">
                                    <p class="m-0">Total Payment</p>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is5">
                                    <p class="text-end m-0">₱ @TotalPayment.ToString("#,##0.00")</p>
                                </Column>
                            </Row>
                            <p class="text-center font-12 color-grey-100 my-4">You won't be charged yet</p>
                            <div>
                                <Button Clicked="ProceedToPayment" Type="ButtonType.Button" class="btn-primary font-20 w-100 border-radius-10"
                                    Border="Border.Is0">
                                    Proceed
                                </Button>
                            </div>
                        </div>
                    </div>
                }
                
                @if(activity.IsComingSoon)
                {
                    <div class="coming-soon-announcement border-radius-20 px-3 py-3 border-1-solid border-color-black-100">
                        <p class="font-20 font-weight-700 mb-2">Announcement</p>
                        <p class="mb-0 color-grey-100 font-18">
                            Tickets will be sold and purchased on this page soon. Please come back again in a few weeks.
                        </p>
                    </div>
                }
            </Column>
        </Row>
    </Container>
    <section>
        <Divider />
        <Container>
            <a href="/explore" style="text-decoration:none"><span class="landing-header color-primary fs-2">@Resources.App.appName</span></a>
            <p class="font-18 color-grey-100">
                Not happy with the experience?
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSenakLuzzv2bTCy65a2WTy48E3wWAqs6B2reQVcSz3fkHOxkg/viewform" target="_blank">
                    Contact us
                </a> 
                and we'll solve the problem for you.
            </p>
        </Container>
    </section>

    @if(!activity.IsComingSoon)
    {
        <div class='@(isOpenMobileCalculator ? "mobile-calculator-wrapper" : "mobile-calculator-wrapper deactive" )'>
            <div class="calculator-backdrop" @onclick="() => isOpenMobileCalculator = !isOpenMobileCalculator"></div>
            <div class="mobile-calculator-wrapper-container border-radius-10 border-color-grey-200 border-1-solid
                position-fixed left-0 right-0 bg-white-100">
                <div>
                    <div class="calculator-inner-content px-3 pt-4">
                        <div class="border-1-solid border-radius-5 border-color-black-100 mb-3">
                            <div class="p-2 color-grey-100 font-16 d-flex border-bottom-1-solid border-color-black-100 d-flex justify-content-between align-items-center">
                                <p class="m-0">@SelectedTicketName</p>
                                @* <Button class="p-1 font-10 bg-orange-100 color-white-100">Change</Button> *@
                            </div>
                            <div class="prevent-select color-grey-100 font-16">
                                <div class="w-100 p-2">@OverallTicketCount @(OverallTicketCount > 1 ? "Tickets" : "Ticket")</div>
                            </div>
                        </div>
                        @foreach (var item in selectedTickets)
                        {
                            <Row class="color-grey-100 font-16 mt-2">
                                <Column ColumnSize="ColumnSize.Is7">
                                    <p class="m-0">₱ @item.Value.Price.ToString("#,##0") x @item.Value.Count @(item.Value.Count > 1 ? "Tickets" : "Ticket")</p>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is5">
                                    <p class="text-end m-0">₱ @((item.Value.Price * item.Value.Count).ToString("#,##0.00"))</p>
                                </Column>
                            </Row>   
                        }
                        @if(!IsInclusivePricing)
                        {
                            <Row class="color-grey-100 font-16 mt-2">
                                <Column ColumnSize="ColumnSize.Is7">
                                    <p class="m-0">Service  fee - <span class="">0%</span></p>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is5">
                                    <p class="text-end m-0">₱ @ServiceFee.ToString("#,##0,00")</p>
                                </Column>
                            </Row>
                            <Row class="color-grey-100 font-16 mt-2">
                                <Column ColumnSize="ColumnSize.Is7">
                                    <p class="m-0">Handling  fee</p>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is5">
                                    <p class="text-end m-0">₱ @HandlingFee.ToString("#,##0.00")</p>
                                </Column>
                            </Row>
                        }
                        <Row class="font-16 mt-2 font-weight-700 color-black-100 mb-4">
                            <Column ColumnSize="ColumnSize.Is7">
                                <p class="m-0">Total Payment</p>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is5">
                                <p class="text-end m-0">₱ @TotalPayment.ToString("#,##0.00")</p>
                            </Column>
                        </Row>
                    </div>
                    <Divider class="calculator-footer-divider m-0" />
                    <div class="p-3 d-flex justify-content-between align-items-center">
                        <Button Type="ButtonType.Button" Clicked="ProceedToPayment"
                            class="btn-primary font-14 width-120 border-radius-10"
                            Border="Border.Is0">
                            Proceed
                        </Button>
                        <div class="d-flex align-items-center">
                            <div class="prevent-select text-end" style="width: 160px;" @onclick="() => isOpenMobileCalculator = !isOpenMobileCalculator">
                                <span class="font-20 font-weight-700 color-black-100">₱ @TotalPayment.ToString("#,##0.00")</span>
                                @if(isOpenMobileCalculator)
                                {
                                    <img class="ms-2" src="images/icons/orange-arrow-up.png" alt="icon">
                                }
                                else 
                                {
                                    <img class="ms-2" src="images/icons/orange-arrow-down.png" alt="icon">
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<ModalLogin @ref="loginModal" ReturnUrl="@signInReturnUrl" />

@code
{
    [Parameter]
    public string Handler {get; set;} = string.Empty;

    private OteActivity? activity;
    private CustomerProfile? provider;
    private IJSObjectReference jsClipboard;
    private bool isActivityFavorite {get; set;}
    private CustomerProfile? currentLogin {get; set;}
    private string token {get; set;} = string.Empty;
    private string signInReturnUrl = string.Empty;
    private ModalLogin? loginModal;
    private bool IsInclusivePricing {get; set;}
    private bool isOpenMobileCalculator {get; set;}
    private IDictionary<int, TicketInfo> selectedTickets = new Dictionary<int, TicketInfo>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            jsClipboard = await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadOteDetails();
            await LoadProvider();
            await LoadIsInclusiveOte();
            await LoadProfile();
            await LoadFavorite();
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadProfile()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if(user is not null && user.Identity.IsAuthenticated)
        {
            token = user.FindFirstValue("Token");
            if(!string.IsNullOrEmpty(token))
            {
                var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
                if(profileResult.Succeeded || profileResult.Result is not null && profileResult.Result.IsSuccess)
                {
                    currentLogin = mapper.Map<Models.Entities.CustomerProfile>(profileResult.Result.Result);
                }
            }
        }
    }

    private async Task LoadIsInclusiveOte()
    {
        if(provider is null) return;

        var inclusiveRes = await activityHandler.OwnerPricingInclusive(provider.Id);
        if(inclusiveRes.Succeeded && inclusiveRes.Result is not null && inclusiveRes.Result.IsSuccess)
        {
            IsInclusivePricing = inclusiveRes.Result.Result.IsInclusivePricing;
        }
    }

    private async Task LoadFavorite()
    {
        if(currentLogin is not null && activity is not null)
        {
            var customerFavorites = await activityHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs {
                CustomerId = currentLogin.Id
            }, token);
            if(customerFavorites.Succeeded && customerFavorites.Result is not null && customerFavorites.Result.IsSuccess)
            {
                isActivityFavorite = customerFavorites.Result.Result.Any(a => a.ActivityId == activity.Id);
            }
        }
    }

    private async Task LoadOteDetails()
    {
        try
        {
            var result = await activityHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true
            }, Handler);
            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new ApplicationException(result.Message);
            }
            var act = result.Result.Result;

            if(!act.IsPublished)
            {
                NavigationManager.NavigateTo("not-found");
                return;
            }

            activity = mapper.Map<OteActivity>(act);

            activity.Pricings = activity.Pricings.OrderBy(t => t.Id).ToList();
            
            // select first ticket id
            if(activity.Pricings.Count() > 0)
            {
                AddSelectedTicket(activity.Pricings.First());
            }
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadProvider()
    {
        try
        {
            if(activity is null) return;

            var result = await accountApiHandler.GetCustomerById(activity.ProviderId);
            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new ApplicationException(result.Message);
            }

            provider = mapper.Map<CustomerProfile>(result.Result.Result);
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }


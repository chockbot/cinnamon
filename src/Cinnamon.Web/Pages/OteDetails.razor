    private Task AddSelectedTicket(OtePricing pricing, int limitTicket)
    {
        if (pricing.IsUnlimited || activity.IsEventSoldOut)
        {
            if (activity.IsEventSoldOut && !pricing.IsUnlimited)
            {
                if (capacityLimit <= 0)
                {
                    return Task.CompletedTask;
                }
            }
            if (selectedTickets.ContainsKey(pricing.Id))
            {
                if (selectedTickets[pricing.Id].Count >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                if (selectedTickets.Sum(a => a.Value.Count) >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                selectedTickets[pricing.Id].Count++;
            }
            else
            {
                if (limitTicket == 0 && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                else if (selectedTickets.Sum(a => a.Value.Count) >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                else
                {
                    selectedTickets.Add(pricing.Id, new TicketInfo
                        {
                            Count            = 1,
                            Id               = pricing.Id,
                            Price            = pricing.Price,
                            Name             = pricing.Name,
                            RequiredApproval = pricing.RequiredApproval,
                            IsUnlimited      = pricing.IsUnlimited
                        });
                }

            }
            return Task.CompletedTask;
        }
        else
        {
            if (pricing.TicketSold >= pricing.MaxSlots)
            {
                return Task.CompletedTask;
            }
            if (selectedTickets.ContainsKey(pricing.Id))
            {
                if (selectedTickets[pricing.Id].Count >= (pricing.MaxSlots - pricing.TicketSold))
                {
                    return Task.CompletedTask;
                }
                if (selectedTickets[pricing.Id].Count >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                if (selectedTickets.Sum(a => a.Value.Count) >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                selectedTickets[pricing.Id].Count++;
            }
            else
            {
                if (limitTicket == 0 && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                else if (selectedTickets.Sum(a => a.Value.Count) >= limitTicket && IsLimit && currentLogin is not null)
                {
                    return Task.CompletedTask;
                }
                else
                {
                    selectedTickets.Add(pricing.Id, new TicketInfo
                        {
                            Count            = 1,
                            Id               = pricing.Id,
                            Price            = pricing.Price,
                            Name             = pricing.Name,
                            RequiredApproval = pricing.RequiredApproval,
                            IsUnlimited      = pricing.IsUnlimited
                        });
                }

            }
            return Task.CompletedTask;
        }
    }

    private Task RemoveSelectedTicket(OtePricing pricing)
    {
        if (pricing.IsUnlimited)
        {
            if (selectedTickets.ContainsKey(pricing.Id) && selectedTickets[pricing.Id].Count > 0)
            {
                selectedTickets[pricing.Id].Count--;
                if (selectedTickets[pricing.Id].Count == 0) selectedTickets.Remove(pricing.Id);
            }
            return Task.CompletedTask;
        }
        else
        {
            if (activity.IsEventSoldOut)
            {
                if (capacityLimit <= 0)
                {
                    return Task.CompletedTask;
                }
            }
            else
            {
                if (pricing.TicketSold >= pricing.MaxSlots)
                {
                    return Task.CompletedTask;
                }
            }
            if (selectedTickets.ContainsKey(pricing.Id) && selectedTickets[pricing.Id].Count > 0)
            {
                selectedTickets[pricing.Id].Count--;
                if (selectedTickets[pricing.Id].Count == 0) selectedTickets.Remove(pricing.Id);
            }
            return Task.CompletedTask;
        }

    }


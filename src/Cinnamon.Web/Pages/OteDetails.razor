@page "/explore/ote/{Handler}"
@using System.Security.Claims;
@using Cinnamon.Web.Components.Pages;
@using AutoMapper;
@using Newtonsoft.Json;
@using Cinnamon.Web.Modules.ApiAccess.Handlers; 
@using Cinnamon.Web.Models.Ote;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Web.Utils;
@using System.ComponentModel.DataAnnotations;
@using Humanizer;
@inject INotificationService NotificationService;
@inject IActivityApiHandler activityHandler;
@inject IAccountApiHandler accountApiHandler;
@inject ITransactionApiHandler transactionApiHandler;
@inject NavigationManager NavigationManager;
@inject IMapper mapper;
@inject IJSRuntime JS;
@inject IChatApiHandler chatApiHandler;
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@(activity?.EventName ?? "Cinnamon Activities, learnings and events for you and your loved ones | CinnamonPH") | CinnamonPH</PageTitle>
<SeoMeta Title="@(activity?.EventName ?? string.Empty)"
        Description="@(activity?.Description ?? string.Empty)"
        Subject="@(activity?.EventName ?? string.Empty)"
        Url='@SeoUrl'
        Image="@SeoImage"
        Keywords='new List<string>{"events","one time events", "cinnamon event"}' />

@if(activity is not null)
{
    <div class="container details-page-section">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-5 col-sm-12 col-12">
                <div class="cover-photo">
                    <img class="cover-photo-img" src="@CoverImage" alt="cover-photo">
                </div>
                <div class="d-flex align-items-center mt-3 me-2 me-md-5">
                    <img class="provider-avatar rounded-circle" src="@provider.ProfilePath" alt="avatar">
                    <div class="ms-3">
                        <label class="font-16 font-weight-400 color-grey-100 m-font-14">Experience by</label>
                        <p class="text-capitalize font-16 font-weight-700 color-black-100 mb-0 m-font-14">@provider.FirstName @provider.LastName</p>
                    </div>
                </div>
                <div class="provider-details d-flex mt-2">
                    <div class="review-section">
                        <img src="images/star-tag-small.png" class="star-icon">
                        <span class="details-text">@activity.Sold booked</span>
                    </div>
                    @if (provider.IsVerified == 2)
                    {
                        <div class="verified-section">
                            <img src="images/verified-badge.png" class="verified-icon">
                            <span class="details-text">Verified Profile</span>
                        </div>
                    }
                </div>
                <div class="mt-2">
                    <Button Clicked="() => MessageProvider(provider.Id)" class="message-me-button">
                        <span>Message Me</span>
                    </Button>
                </div>
            </div>
            <div class="col-xl-8 col-lg-8 col-md-7 col-sm-12 col-12">
                @*Event Name*@
                <h3 class="event-title">@activity.EventName</h3>

                @*Share Event*@
                <div class="d-flex">
                    <div class="me-4 prevent-select" @onclick="OnFavoriteClick">
                        <label class="m-d-none cursor-pointer me-1 font-20 color-grey-100 font-weight-400 text-decoration-underline">Add to Favorites</label>
                        <img style="width: 25px;" class="cursor-pointer h-auto" src='@(isActivityFavorite ?  "images/ote/favorite.png" : "images/ote/heart-default.png")' alt="favorite">
                    </div>
                    <div class="cursor-pointer prevent-select" @onclick="CopyToClipboard">
                        <label class="m-d-none cursor-pointer me-1 font-20 color-grey-100 font-weight-400 text-decoration-underline">Share this Activity</label>
                        <img style="width: 20px;" class="cursor-pointer h-auto" src="images/ote/copy-link.png" alt="share">
                    </div>
                </div>

                @*Event Description*@
                <section id="ote-description">
                    <p class="event-description">
                        @((MarkupString)activity.Description.Replace(Environment.NewLine, "<br />").Replace("\r\n\r\n", "<br>"))
                    </p>
                </section>

                @*Event Schedule*@
                @if (!activity.IsComingSoon)
                {
                    <h3 class="event-schedule">Date & Time</h3>
                    <div class="schedule-section">
                        <div class="schedule-header">
                            <p class="schedule-header-title">Select date and tickets</p>
                            <div class="calendar-section">
                                <SelectCalendar CurrentDate="SelectedDates.FirstOrDefault()" SelectedDates="SelectedDates"ViewOnly StrikeOutNotSelected OnSelectedDate="OnSelectedDateChanged" />
                                <Button Clicked="ViewAvailableDates" id="ote-btn-check-avail" class="check-availability-button">Check Availability</Button>
                            </div>
                        </div>
                        <div class="schedule-body">
                            <Row VerticalGutter="30">
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop.Is12.OnTablet.Is6.OnWidescreen">
                                    <div class="d-flex align-items-center event-schedule-time">
                                        <img class="me-2" src="images/ote/clock-repeat.png" alt="clock">
                                        <label class="ote-schedule me-1">Duration:</label>
                                        <label class="ote-schedule-details">
                                            @EventDurationString
                                        </label>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop.Is12.OnTablet.Is6.OnWidescreen">
                                    <div class="d-flex align-items-center event-schedule-time">
                                        <img class="me-2" src="images/ote/clock.png" alt="clock">
                                        <label class="ote-schedule me-1">Time Start:</label>
                                        <label class="ote-schedule-details">@selectedDateStart.ToString("hh:mm tt")</label>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12">
                                    <div class="d-flex align-items-center event-schedule-place">
                                    <img class="me-2" src="images/ote/location.png" alt="clock">
                                    <label class="ote-schedule me-1">Location:</label>
                                        @if (activity.ExperienceTypeId == 1)
                                        {
                                            string address = string.IsNullOrEmpty(activity.PinnedLocation) ? $"{activity.HouseNo + ", " + activity.BarangayName + ", " + activity.CityName + ", " + activity.RegionName}" : activity.PinnedLocation;
                                            <label class="ote-schedule-details">@address</label>
                                        }
                                        else
                                        {
                                        <label class="ote-schedule-details">Online</label>
                                        }
                                    </div>
                                </Column>
                            </Row>
                            <div class="event-ticket-section">
                                <div class="ticket-details-header">
                                    <p class="prices-title">Tickets</p>
                                    <p class="prices-title">Price</p>
                                    <p class="prices-title">Status</p>
                                    <p class="prices-title text-center">Quantity</p>
                                </div>
                                @foreach (var item in AvailablePriceList)
                                {
                                    if (ticketCount != 0 && IsLimit)
                                    {
                                        if (ticketCount == activity.EventTicketLimit)
                                        {
                                            stringMaxTicket = $"Max {ticketCount} {(ticketCount == 1 ? "ticket" : "tickets")} per customer.";
                                        }
                                        else
                                        {
                                            stringMaxTicket = $"You can only purchase {ticketCount} {(ticketCount == 1 ? "ticket" : "tickets")}.";
                                        }

                                    }
                                    else
                                    {
                                        stringMaxTicket = $"You've already reached the maximum limit for ticket purchases.";
                                    }
                                    <div class="ticket-details">
                                        <p class="ticket-name">@item.Name</p>
                                        <p class="align-items-center">
                                            <span class="ticket-name">
                                                ₱ @item.Price.ToString("#,##0")
                                            </span>
                                        </p>
                                        <p class="align-items-center">
                                            @if(!item.IsUnlimited){
                                                @if (item.MaxSlots <= item.TicketSold)
                                                {
                                                    <span class="ticket-sold-out">
                                                        sold out
                                                    </span>
                                                }
                                                @* display count left *@
                                                @if (item.MaxSlots > item.TicketSold && (item.MaxSlots - item.TicketSold) <= 10)
                                                {
                                                    <span class="tickets-left">
                                                        Only @(item.MaxSlots - item.TicketSold) ticket/s left
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="ticket-unli">
                                                    unlimited
                                                </span>
                                            }
                                            
                                        </p>
                                        <div data-disabled="@(item.MaxSlots <= item.TicketSold && !item.IsUnlimited)" class="d-flex border-1-solid item-counter-container text-center border-radius-5 overflow-hidden">
                                            <span @onclick="() => RemoveSelectedTicket(item)" class="p-2 border-right-1-solid counter-item prevent-select" style="background-color:#F3F6FC;">
                                                <span class="item-action">-</span>
                                            </span>
                                            <span class="p-2 border-right-1-solid counter-item">
                                                @(selectedTickets.ContainsKey(item.Id) ? selectedTickets[item.Id].Count : 0)
                                            </span>
                                            <span @onclick="() => AddSelectedTicket(item, ticketCount)" class="p-2 counter-item prevent-select" style="background-color:#F3F6FC;">
                                                @if (activity.EventTicketLimit != 0 && currentLogin is not null)
                                                {
                                                    <Tooltip Text="@stringMaxTicket"Multiline>
                                                        <span class="item-action p-2">+</span>
                                                    </Tooltip>
                                                }
                                                else
                                                {
                                                    <span class="item-action p-2">+</span>
                                                }
                                            </span>
                                        </div>
                                    </div>
                                    <Divider />
                                }
                            </div>
                        </div>
                        <div class="schedule-footer">
                            <button class="btn-buy-ticket" @onclick="() => ProceedToPayment()">Buy Ticket</button>
                        </div>
                    </div>

                    @*Important Information*@
                    <section id="important-information" class="mt-3">
                            <p class="event-schedule">Important Information</p>
                            <p class="font-18 fw-bold color-black-100 m-font-16">What will happen after I purchase?</p>
                            <ol class="color-grey-100 font-18 m-font-16">
                                <li class="mb-3">A purchase confirmation email including your e-ticket will be sent to your email.</li>
                                <li class="mb-3">You can access the event you purchased/joined by going to your Account from the menu.</li>
                            </ol>
                        </section>

                    <Divider />

                    @*Event Location*@
                    <section id="map-details" class="mt-3">
                        <p class="event-schedule">Venue</p>
                        @if (activity.ExperienceTypeId == 1)
                        {
                            string address = string.IsNullOrEmpty(activity.PinnedLocation) ? $"{activity.HouseNo + ", " + activity.BarangayName + ", " + activity.CityName + ", " + activity.RegionName}" : activity.PinnedLocation;
                            <p class="address">@address</p>
                            <iframe height="373" id="mapframe" frameborder="0" class="w-100" src="@MapSource" allowfullscreen></iframe>
                        }
                        else
                        {
                            <p class="mb-1 font-20 font-weight-400 color-black-100 m-font-16">Online</p>
                        }
                    </section>

                    @*Event Seat Plan*@
                    @if (!string.IsNullOrEmpty(SetPlanImage))
                    {
                        <div id="set-plan" class="mt-4 seat-plan-section">
                            <p class="event-schedule">Seat Plan</p>
                            <img class="img-seat-plan" src="@SetPlanImage" @onclick="() => imageViewer.ShowModal()" alt="seatplan">
                        </div>
                    }

                }

                @if (activity.IsComingSoon)
                {
                    <div class="my-5">
                        <img class="max-width-100 h-auto" src="images/coming-soon.png" alt="coming soon">
                    </div>
                }
            </div>
        </div>
        
    </div>
    <Footer></Footer>
}

<ModalLogin @ref="loginModal" ReturnUrl="@signInReturnUrl" />
<ImageViewer @ref="imageViewer" Image="@SetPlanImage" />
<ConfirmDialog @ref="confirmDialogRef" AcceptLabel="Yes" DeclineLabel="No"
           OnConfirmationChanged="ConfirmDeleteChanged">
    <HeaderContent>
        <p class="m-0">Leave Waitlist</p>
    </HeaderContent>
    <BodyContent>
        <p class="m-0">Are you sure you want to leave the waitlist?</p>
    </BodyContent>
</ConfirmDialog>

<Modal @ref="modalQuestions">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <div>
                <p class="font-20 font-weight-700 color-black-100 mb-0 text-center">Waitlist Registration</p>
                <p class="font-16 color-grey-100 mt-1 text-center">Please Fill up some questions to complete your registration</p>
            </div>
        </ModalHeader>
        <ModalBody class="px-4">
            <Validations @ref="phoneValidation" Mode="ValidationMode.Manual" Model="personalForm">
                <Validation>
                    <Field class="mb-3">
                        <FieldLabel class="color-black-100 mb-0">Phone Number</FieldLabel>
                        <FieldBody>
                            <TextEdit @bind-Text="personalForm.Phone">
                                <ValidationError />
                            </TextEdit>
                        </FieldBody>
                    </Field>
                </Validation>
            </Validations>
            <Validations @ref="questionValidation" Mode="ValidationMode.Manual" Model="activityQuestions">
                @foreach (var question in activityQuestions)
                {
                    if(question.Required)
                    {
                        <Validation>
                            <Field class="mb-3">
                                <FieldLabel class="color-black-100 mb-0">@question.Question</FieldLabel>
                                <FieldBody>
                                    <MemoEdit @bind-Text="question.Answer" Rows="3" Placeholder="Place your answer here.." >
                                        <ValidationError />
                                    </MemoEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    }
                    else 
                    {
                        <Field class="mb-3">
                            <FieldLabel class="color-black-100 mb-0">@question.Question</FieldLabel>
                            <FieldBody>
                                <MemoEdit @bind-Text="question.Answer" Rows="3" Placeholder="Place your answer here.." />
                            </FieldBody>
                        </Field>
                    }
                }
            </Validations>
        </ModalBody>
        <ModalFooter>
            <div class="button-footer">
                <Button class="bg-white-200 color-grey-100 me-2" 
                    Clicked="() => modalQuestions.Close(CloseReason.UserClosing)">
                    Cancel
                </Button>
                <Button class="bg-orange-100 color-white-100" Clicked="SubmitAnswerQuestions">
                    Submit
                </Button>
            </div>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="modalPurchaseWithConfirmation">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center">
            <div>
                <p class="font-20 font-weight-700 color-black-100 mb-0 text-center">Registration Pending</p>
            </div>
        </ModalHeader>

        <ModalBody class="px-4">
            <p class="font-16 font-weight-700 color-black-100 mb-0">
                You have been added to the waiting list. 
                We will send you an email if your registration is accepted by the event organizer.
            </p>
        </ModalBody>

        <ModalFooter class="justify-content-center">
            <Button class="bg-white-200 color-grey-100" 
                Clicked="() => modalPurchaseWithConfirmation.Close(CloseReason.UserClosing)">
                Close
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="modalPurchaseWithoutConfirmation">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center">
            <div>
                <p class="font-20 font-weight-700 color-black-100 mb-0 text-center">Registration Success</p>
            </div>
        </ModalHeader>

        <ModalBody class="px-4">
            <p class="font-16 font-weight-700 color-black-100 mb-0">
                You have successfully registered for the event. 
                We have sent you an email containing your tickets and additional event details. 
                Please check your inbox for further information. 
                If you do not see the email, make sure to check your spam or junk folder. We look forward to seeing you at the event!
            </p>
        </ModalBody>

        <ModalFooter class="justify-content-center">
            <Button class="bg-white-200 color-grey-100" 
                Clicked="() => modalPurchaseWithoutConfirmation.Close(CloseReason.UserClosing)">
                Close
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code
{
    [Parameter]
    public string Handler {get; set;} = string.Empty;
    private OteActivity? activity;
    private CustomerProfile? provider;
    private IJSObjectReference jsClipboard;
    private bool isActivityFavorite {get; set;}
    private CustomerProfile? currentLogin {get; set;}
    private string token {get; set;} = string.Empty;
    private string signInReturnUrl = string.Empty;
    private ModalLogin? loginModal;
    private ImageViewer imageViewer;
    private ConfirmDialog confirmDialogRef { get; set; }
    private bool IsInclusivePricing {get; set;}
    private bool isOpenMobileCalculator {get; set;}
    private bool isShowPreview = false;
    private string selectedImage = string.Empty;
    private IDictionary<int, TicketInfo> selectedTickets = new Dictionary<int, TicketInfo>();
    private TimeSpan Duration { get; set; }
    private IEnumerable<OtePricing> AvailablePriceList {get; set;} = Enumerable.Empty<OtePricing>();
    private DateTime selectedDate;
    public string ProfileHandler { get; set; }
    public int ProfileId { get; set; }
    public string ProfileName { get; set; }
    public string ProfileEmail { get; set; }
    public bool showFullAbout = false;
    private DateTime selectedDateStart;
    private int SelectedScheduleId { get; set; }
    private IEnumerable<TicketItem> otesItems { get; set; }
    private List<int> WaitlistIds = new List<int>();
    private int ticketCount { get; set; }
    private string stringMaxTicket { get; set; }
    private bool IsLimit { get; set; }
    private bool IsOnWaitlist { get; set; }
    private int capacityLimit { get; set; }

    private List<ActivityQuestion> activityQuestions = new();
    private Modal? modalQuestions;
    private Validations? questionValidation;
    private Validations? phoneValidation;
    private PersonalValidation personalForm = new();
    private Modal? modalPurchaseWithConfirmation;
    private Modal? modalPurchaseWithoutConfirmation;
    bool submitting = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await JS.InvokeVoidAsync("MyLib.Track", "OTE Details Page");
            jsClipboard = await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadOteDetails();
            await LoadProvider();
            await LoadIsInclusiveOte();
            await LoadProfile();
            await LoadFavorite();
            await LoadActivityQuestions();

            if (activity.IsCapacity)
            {
                await LoadWaitlist();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadProfile()
    {
        ticketCount = 0;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if(user is not null && user.Identity.IsAuthenticated)
        {
            token = user.FindFirstValue("Token");
            if(!string.IsNullOrEmpty(token))
            {
                var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
                if(profileResult.Succeeded || profileResult.Result is not null && profileResult.Result.IsSuccess)
                {
                    currentLogin = mapper.Map<Models.Entities.CustomerProfile>(profileResult.Result.Result);
                    ProfileHandler = profileResult.Result.Result.Handler;
                    ProfileId = profileResult.Result.Result.Id;
                    ProfileName = $"{profileResult.Result.Result.FirstName} {profileResult.Result.Result.LastName}";
                    ProfileEmail = profileResult.Result.Result.Email;
                }
                //Get the number of ticket purchased in this event
                var ticketPurchase = await activityHandler.CustomerOte(token);
                if (ticketPurchase.Succeeded && ticketPurchase.Result is not null && ticketPurchase.Result.IsSuccess)
                {
                    otesItems = ticketPurchase.Result.Result.Where(a => a.ActivityId == activity.Id).Select(t =>
                    {
                        return new TicketItem
                        {
                            EventName = t.EventTitle,
                            PurchaseOrderId = t.PurchaseOrderId
                        };
                    });
                    foreach (var item in otesItems)
                    {
                        var count = await transactionApiHandler.GetOtePurchaseOrder(item.PurchaseOrderId, token);
                        if (count.Succeeded && count.Result is not null && count.Result.IsSuccess)
                        {
                            ticketCount += count.Result.Result.Tickets.Count();
                        }
                    }
                    ticketCount = activity.EventTicketLimit > 0 ? activity.EventTicketLimit - ticketCount : 0;
                } 
            }
        }
    }

    private async Task LoadIsInclusiveOte()
    {
        if(provider is null) return;

        var inclusiveRes = await activityHandler.OwnerPricingInclusive(provider.Id);
        if(inclusiveRes.Succeeded && inclusiveRes.Result is not null && inclusiveRes.Result.IsSuccess)
        {
            IsInclusivePricing = inclusiveRes.Result.Result.IsInclusivePricing;
        }
    }

    private async Task LoadFavorite()
    {
        if(currentLogin is not null && activity is not null)
        {
            var customerFavorites = await activityHandler.GetFavoritesByCustomer(new Framework.ApiCommand.ApiCore.Favorite.Request.GetFavoritesByCustomerArgs {
                CustomerId = currentLogin.Id
            }, token);
            if(customerFavorites.Succeeded && customerFavorites.Result is not null && customerFavorites.Result.IsSuccess)
            {
                isActivityFavorite = customerFavorites.Result.Result.Any(a => a.ActivityId == activity.Id);
            }
        }
    }

    private async Task LoadOteDetails()
    {
        try
        {
            var result = await activityHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true,
                IncludeOnlineEvent = true
            }, Handler);
            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                NavigationManager.NavigateTo("page-not-found");
                return;
            }
            var act = result.Result.Result;

            if(!act.IsPublished || act.ForceDisable)
            {
                NavigationManager.NavigateTo("page-not-found");
                return;
            }

            activity = mapper.Map<OteActivity>(act);
            activity.Pricings         = activity.Pricings.OrderBy(t => t.Id).ToList();
            activity.OteDates         = activity.OteDates.OrderBy(d => d.Date);
            activity.Sold             = activity.Pricings.Sum(a => a.TicketSold);
            activity.EventTicketLimit = act.OteSchedule.EventTicketLimit;
            activity.IsOpen           = act.OteSchedule.IsOpen;
            activity.IsCapacity       = act.OteSchedule.IsCapacity;
            activity.CapacityCount    = act.OteSchedule.CapacityCount;
            activity.IsEventSoldOut   = activity.Pricings.Sum(a => a.MaxSlots) <= activity.Sold ? true : false;
            selectedDate = SelectedDates.Where(a => a.Date >= DateTime.UtcNow).FirstOrDefault();

            if (activity.IsEventSoldOut)
            {

            }
            //selectedDate = SelectedDates.FirstOrDefault();

            ViewAvailableDates();

            // select first ticket id
            /* if(activity.Pricings.Count() > 0)
                {
                AddSelectedTicket(activity.Pricings.First());
            } */
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadProvider()
    {
        try
        {
            if(activity is null) return;

            var result = await accountApiHandler.GetCustomerById(activity.ProviderId);
            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new ApplicationException(result.Message);
            }

            provider = mapper.Map<CustomerProfile>(result.Result.Result);
        }
        catch (System.Exception)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private string SeoUrl
    {
        get
        {
            return $"/explore/ote/{Handler}";
        }
    }

    private string SeoImage 
    {
        get
        {
            if(activity is not null && activity.Images.Count() > 0) return activity.Images.First().ImageSrc;
            else return string.Empty;
        }
    }

    private string MapSource
    {
        get
        {
            string address = string.Empty;
            if(activity is not null)
            {
                if(!string.IsNullOrEmpty(activity.PinnedLocation))
                {
                    address = activity.PinnedLocation;
                }
                else 
                {
                    address = $"{activity.HouseNo}+{activity.BarangayName}+{activity.CityName}+{activity.RegionName}";
                }
            }
            return $"https://www.google.com/maps/embed/v1/place?key=AIzaSyCbu3ZjWDneNd-_hIWPANGy7Wr5YjIltkg&q={address}";
        }
    }

    private string SetPlanImage
    {
        get 
        {
            string imageSrc = string.Empty;
            if(activity is not null)
            {
                var image = activity.Images.FirstOrDefault(i => i.Order == 100);
                if(image is not null)
                {
                    imageSrc = image.ImageSrc;
                }
            }

            return imageSrc;
        }
    }
    private string CoverImage
    {
        get
        {
            string imageSrc = string.Empty;
            if (activity is not null)
            {
                var image = activity.Images.FirstOrDefault(i => i.Order == 0);
                if (image is not null)
                {
                    imageSrc = image.ImageSrc;
                }
            }

            return imageSrc;
        }
    }

    private decimal PriceSubTotal
    {
        get
        {

    private async Task LoadActivityQuestions()
    {
        var activityQuestionsRes = await activityHandler.ActivityQuestions(new Framework.ApiCommand.ApiCore.Activity.Request.ActivityQuestionsArgs {
            ActivityId = activity.Id
        });
        if(!activityQuestionsRes.Succeeded || activityQuestionsRes.Result is null || !activityQuestionsRes.Result.IsSuccess)
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }

        activityQuestions.AddRange(activityQuestionsRes.Result.Result.Select(q => new ActivityQuestion {
            FieldType = q.FieldType,
            Id = q.Id,
            Question = q.FieldLabel,
            Required = q.Required
        }));
    }

    private async Task SubmitAnswerQuestions()
    {
        var validForms = await questionValidation.ValidateAll();
        if(!validForms) return;

        await modalQuestions?.Close(CloseReason.UserClosing);

        if ((activity.IsCapacity) && (activity.CapacityCount <= activity.Sold))
        {
             await ProceedToJoinWaitlist();
        }
        else 
        {
            await ProceedToFreePurchase();
        }
    }

    private async Task LoadTopBooked()
    {
        var result = await activityHandler.TopBookedCustomers(new Framework.ApiCommand.ApiCore.Activity.Request.TopBookedCustomersArgs {
            ActivityId = activity.Id,
            BookedDate = selectedDate.ToString("yyyyMMddhhmmss")
        });
        if(result.Succeeded && result.Result is not null && result.Result.IsSuccess)
        {
            topBookedCustomers = result.Result.Result;
        }
    }

    private string CustomerName(CoreDto.Customer.BasicProfileDTO profile)
    {
        return $"{Capitalize(profile.FirstName)} {Capitalize(profile.LastName)}";
    }

    private string Capitalize(string value)
    {
        if(string.IsNullOrEmpty(value)) return string.Empty;

        var result = value
                        .Split(" ")
                        .Where(s => !string.IsNullOrEmpty(s.Trim()))
                        .Select(s => {
                            string firsrChar = s.Substring(0,1);
                            return $"{firsrChar.ToUpper()}{s.Substring(1)}";
                        });
        
        return String.Join(" ", result);
    }


    private async Task ProceedToPayment()
    {
        if(selectedTickets.Count <= 0)
        {
            await NotificationService.Error("Select a ticket to proceed.", "Oops!");
            return;
        }

        bool havePaidAndFreeTicket = selectedTickets.Any(t => t.Value.Price == 0) && selectedTickets.Any(t => t.Value.Price != 0);
        if(havePaidAndFreeTicket)
        {
            await NotificationService.Error("Combining free and paid tickets is not permitted.", "Invalid");
            return;
        }

        bool haveApprovalTicket = selectedTickets.Any(t => t.Value.Price == 0 && t.Value.RequiredApproval);

        bool isFreeWithoutApproval = selectedTickets.Any(t => t.Value.Price == 0 && !t.Value.RequiredApproval);

        if(haveApprovalTicket)
        {
            await modalQuestions?.Show();
        }
        else if(isFreeWithoutApproval)
        {
            await ProceedToFreePurchase();
        }
        else 
        {
            await ProceedToPaymentOption();
        }
    }

    private async Task ProceedToPaymentOption()
    {
        string queryValue = string.Empty;
        foreach(var item in selectedTickets)
        {
            queryValue += $"{item.Value.Id}-{item.Value.Count}-{selectedDate.ToString("dd MMMM yyyy")}-{selectedDate.ToString("hh:mm tt").ToUpper()}-{ticketCount},";
        }

        string paymentUrl = $"/payment/ote/{Handler}/?ticket={queryValue}";
        if(currentLogin is null)
        {
            string oteDetailsUrl = $"/explore/ote/{Handler}";
            await loginModal.Show();
            signInReturnUrl = oteDetailsUrl;
            return;
        }

        NavigationManager.NavigateTo(paymentUrl);
    }

    private async Task ProceedToFreePurchase()
    {
        try
        {
            if (currentLogin is null)
            {
                string oteDetailsUrl = $"/explore/ote/{Handler}";
                await loginModal.Show();
                signInReturnUrl = oteDetailsUrl;
                return;
            }

            submitting = true;
            StateHasChanged();

            var submitFreePurchase = await transactionApiHandler.SubmitOtePurchaseOrder(new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs {
                ActivityId = activity.Id,
                CardInformation = null,
                CouponCode = string.Empty,
                IsCreditsApplied = false,
                PaymentMethod = "GCASH", // default to ewallet even without any payment method selected
                PaymentChannel = "EWALLET",
                Tickets = selectedTickets.Select(t => new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.OTeTicket {
                    Count = t.Value.Count,
                    Id = t.Value.Id
                }),
                Questions = activityQuestions.Select(q => new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.ActivityQuestion {
                    Answer = q.Answer,
                    Id = q.Id,
                    Question = q.Question
                })
            }, token);

            submitting = false;

            if(!submitFreePurchase.Succeeded || submitFreePurchase.Result is null || !submitFreePurchase.Result.IsSuccess)
            {
                await NotificationService.Error(submitFreePurchase.Result?.ErrorInfo?.Message ?? submitFreePurchase.Message, "Error");
                return;
            }

            await ClearAnswers();

            var haveApprovalTicket = selectedTickets.Any(t => t.Value.Price == 0 && t.Value.RequiredApproval);

            if(haveApprovalTicket)
            {
                await modalPurchaseWithConfirmation?.Show();
            }
            else 
            {
                await modalPurchaseWithoutConfirmation?.Show();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Contact Cinnamon support.", "Error");
        }
    }


@page "/purchase/order"
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities;
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Models
@using Cinnamon.Web.Components.Pages;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ITransactionApiHandler transactionApiHandler;
@inject IActivityApiHandler activityApiHandler;
@inject IJSRuntime jsRuntime;

<PageTitle>Payment Successful | CinnamonPH</PageTitle>
<SeoMeta Title="Payment Successful" Subject="Payment Successful" Url="/purchase/order" />

@if(Model != null)
{
    <section class="container order-banner">
        <h1 class="order-banner-h1 text-center">
            Thank you for choosing
            <br class="d-none m-d-block">
            <span class="text-capitalize cinnamon-banner-text">cinnamon</span>
        </h1>
        <div class="order-details font-16 color-grey-100">
            <div class="text-center">
                <h3 class="text-capitalize font-24 font-weight-700 my-4 color-black-100">payment confirmed!</h3>
            </div>
            <Divider class="m-0" />
            <div class="ps-4">
                <p class="text-capitalize my-3">Date: @DateTime.Now.ToString("MM/dd/yyyy")</p>
            </div>
            <Divider class="m-0" />
            <div class="ps-4">
                <p class="text-capitalize mb-0 mt-3 font-20 font-weight-700 color-black-100">@Model.PurchaseOrder.ActivityName</p>
                <p class="text-capitalize mb-0 mt-2">@Model.SelectedSchedule.Name</p>
                <p class="text-capitalize mb-0 mt-2">@Model.SelectedSchedule.DateTime</p>
                <p class="text-capitalize mt-2 mb-3">
                    @Model.SelectedSchedule.UnitPrice @((long)Model.SelectedSchedule.Price) / @Model.SelectedSchedule.PerUnit1 @Model.SelectedSchedule.PriceUnit1 / @Model.SelectedSchedule.PerUnit2 @Model.SelectedSchedule.PriceUnit2
                </p>
            </div>
            <Divider class="m-0" />
            <div class="px-4">
                <p class="text-capitalize mb-0 mt-3 font-20 font-weight-700 color-black-100">Purchase Details</p>
                <table class="w-100">
                    <tbody>
                        <tr>
                            <td>
                                <p class="text-capitalize mb-0 mt-2">No. of Enrolees:</p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mb-0 mt-2">@Model.PurchaseOrder.EnrolleeCount</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p class="text-capitalize mb-0 mt-2">Payment Method: </p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mb-0 mt-2">
                                    <span class="text-uppercase text-decoration-underline">@Model.PurchaseOrder.PaymentMethod</span>
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p class="text-capitalize mb-0 mt-2">Amount: </p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mb-0 mt-2">@Model.PurchaseOrder.Total.ToString("#,##0.00")</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p class="text-capitalize mb-0 mt-2">Payment Provider Fee: </p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mb-0 mt-2">@Model.PurchaseOrder.PaymentProviderFee.ToString("#,##0.00")</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p class="text-capitalize mb-0 mt-2">Service Fee: </p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mb-0 mt-2">@Model.PurchaseOrder.ServiceFee.ToString("#,##0.00")</p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p class="text-capitalize mt-2 mb-3 font-weight-700 color-primary">Total Purchase: </p>
                            </td>
                            <td class="text-end">
                                <p class="text-capitalize mt-2 mb-3 font-weight-700 color-primary">
                                    PHP @((Model.PurchaseOrder.Total + Model.PurchaseOrder.ConvinienceFee).ToString("#,##0.00"))
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="text-center mt-5 mb-5">
            <PrimaryButton Width="fit-content" Text="Back to Home Page" OnClick='() => NavigationManager.NavigateTo("/explore")' />
        </div> 
    </section>
}

@code
{
    private PurchaseOrderModel Model {get; set;}

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var purchaseSuccess = QueryHelpers.ParseQuery(uri.Query).TryGetValue("purchaseid", out var purchaseIdString);

        if(!purchaseSuccess)
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }

        if(!int.TryParse(purchaseIdString, out int purchasedId))
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }

        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        if(token == null)
        {
            // don't have current user login
            NavigationManager.NavigateTo("explore");
            return;
        }

        // purchase order details
        var purchaseRes = await transactionApiHandler.GetPurchaseOrder(purchasedId, token);
        if((!purchaseRes.Succeeded || purchaseRes.Result == null) || (purchaseRes.Succeeded && !purchaseRes.Result.IsSuccess))
        {
            // error occured when getting purchase order id
            NavigationManager.NavigateTo("explore");
            return;
        }
        var purchaseOrder = purchaseRes.Result.Result;

        // get related activity and schedules
        var activityRes = await activityApiHandler.GetActivity(purchaseOrder.ActivityId, new Framework.ApiCommand.ApiCore.Activity.Request.GetActivityArgs {
            IncludeAtivitySchedules = true
        });
        if((!activityRes.Succeeded || activityRes.Result == null) || (activityRes.Succeeded && !activityRes.Result.IsSuccess))
        {
            // error occured when getting activity
            NavigationManager.NavigateTo("explore");
            return;
        }

        var schedule = activityRes.Result.Result.ActivitySchedules.FirstOrDefault(s => s.Id == purchaseOrder.ScheduleId);
        if(schedule == null)
        {
            // can't find schedule associated to activity
            NavigationManager.NavigateTo("explore");
            return;
        }

        Model = new PurchaseOrderModel {
            PurchaseOrder = new Models.Entities.PurchaseOrder {
                ActivityId = purchaseOrder.ActivityId,
                ConvinienceFee = purchaseOrder.ConvinienceFee,
                Coupon = purchaseOrder.Coupon,
                CouponAmount = purchaseOrder.CouponAmount,
                CustomerId = purchaseOrder.CustomerId,
                Id = purchaseOrder.Id,
                OverallTotal = purchaseOrder.OverallTotal,
                ScheduleId = purchaseOrder.ScheduleId,
                Total = purchaseOrder.Total,
                ActivityName = activityRes.Result.Result.Title,
                EnrolleeCount = purchaseOrder.EnrolleeCount,
                PaymentMethod = purchaseOrder.PaymentMethod,
                ServiceFee = purchaseOrder.ServiceFee,
                PaymentProviderFee = purchaseOrder.PaymentProviderFee
            },
            SelectedSchedule = new Models.Entities.ActivitySchedule {
                DateTime = schedule.DateTime,
                Id = schedule.Id,
                Name = schedule.Name,
                PerUnit1 = schedule.PerUnit1,
                PerUnit2 = schedule.PerUnit2,
                Price = schedule.Price,
                PriceUnit1 = schedule.PriceUnit1,
                PriceUnit2 = schedule.PriceUnit2,
                UnitPrice = schedule.UnitPrice
            },
            Token = token
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await jsRuntime.InvokeVoidAsync("MyLib.Track", "Payment Confirmation Page Loaded");
        }
    }
}
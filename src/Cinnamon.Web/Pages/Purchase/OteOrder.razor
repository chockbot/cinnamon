@page "/purchase/order/ote/{OrderId:int}"
@using System.Security.Claims;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject ITransactionApiHandler transactionApiHandler;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject INotificationService NotificationService;
@inject NavigationManager NavigationManager;

@if(purchaseOrder is not null)
{
    <div class="purchase-ote-summary-wrapper py-5">
        <Container>
            <Row HorizontalGutter="50" VerticalGutter="30">
                <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
                    <div class="border-1-solid border-color-grey-100 border-radius-10 m-border-0-solid">
                        <div class="px-0 px-md-4 py-3">
                            <h3 class="mb-0 font-weight-700 color-black-100 text-center">Payment Confirmed</h3>
                        </div>
                        <Divider class="m-0" />
                        <div class="px-0 px-md-4 py-3">
                            <p class="mb-0 color-grey-100 font-16">Date: @purchaseOrder.PurchasedDate.ToString("MMMM, dd yyyy")</p>
                        </div>
                        <Divider class="m-0" />
                        <div class="px-0 px-md-4 py-3">
                            <h4 class="mb-2 font-20 font-weight-700 color-black-100 text-capitalize">@purchaseOrder.EventName</h4>
                            <p class="mb-2 font-16 color-grey-100">@purchaseOrder.EventLocation</p>
                            <p class="mb-0 font-16 color-grey-100">@purchaseOrder.EventDate.ToString("dd MMMM yyyy | hh:mm tt")</p>
                        </div>
                        <Divider class="m-0" />
                        <div class="px-0 px-md-4 py-3">
                            <h4 class="mb-3 font-20 font-weight-700 color-black-100">Purchase Details</h4>
                            <p class="mb-2 font-16 color-grey-100">Tickets:</p>
                            @foreach (var item in GetTicketSummary)
                            {
                                <div class="mb-2 font-16 color-grey-100 d-flex justify-content-between">
                                    <p class="mb-0">@item.Name  X @item.Count</p>
                                    <p class="mb-0">P @((item.Count * item.Price).ToString("#,##0.00"))</p>
                                </div>   
                            }
                        </div>
                        <div class="px-0 px-md-4 py-3 font-16 color-grey-100">
                            <div class="mb-2 d-flex justify-content-between">
                                <p class="mb-0">Payment Method:</p>
                                <p class="mb-0">@purchaseOrder.PaymentMethod</p>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <p class="mb-0">Amount:</p>
                                <p class="mb-0">P @purchaseOrder.SubTotal.ToString("#,##0.00")</p>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <p class="mb-0">Service Fee: </p>
                                <p class="mb-0">P @purchaseOrder.ServiceFee.ToString("#,##0.00")</p>
                            </div>
                            <div class="mb-2 d-flex justify-content-between">
                                <p class="mb-0">Handling Fee: </p>
                                <p class="mb-0">P @purchaseOrder.HandlingFee.ToString("#,##0.00")</p>
                            </div>
                            <div class="mb-2 d-flex justify-content-between font-16 font-weight-700 color-orange-100">
                                <p class="mb-0">Total Purchase:</p>
                                <p class="mb-0">PHP @purchaseOrder.TotalPurchase.ToString("#,##0.00")</p>
                            </div>
                        </div>
                    </div>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
                    <div>
                        <div class="d-flex align-items-center">
                            <p class="mb-0 font-20 font-weight-700 color-black-100 me-4">Your ticket is here!</p>
                            <Button class="color-white-100 bg-orange-100 border-radius-5 px-4 hover-color-white">
                                View
                            </Button>
                        </div>
                        <div class="mt-3 border-1-solid border-color-black-100 border-radius-5 overflow-hidden">
                            <Table class="w-100">
                                <TableHeader class="bg-grey-100 color-white-100 font-14 font-weight-700">
                                    <TableRow>
                                        <TableHeaderCell class="p-2 text-center">QR Code</TableHeaderCell>
                                        <TableHeaderCell class="p-2">Ticket</TableHeaderCell>
                                        <TableHeaderCell class="p-2 m-d-none">Amount</TableHeaderCell>
                                        <TableHeaderCell class="p-2 m-d-none">Fees</TableHeaderCell>
                                        <TableHeaderCell class="p-2">Subtotal</TableHeaderCell>
                                    </TableRow>
                                </TableHeader>
                                <TableBody class="font-14 color-black-100">
                                    @foreach (var item in purchaseOrder.Tickets)
                                    {
                                        <TableRow>
                                            <TableRowCell class="p-2 text-center" VerticalAlignment="VerticalAlignment.Middle">
                                                <img style="width: 32px; height: auto;" src="@item.ImageData" alt="qrcode">
                                            </TableRowCell>
                                            <TableRowCell class="p-2" VerticalAlignment="VerticalAlignment.Middle">@item.Name</TableRowCell>
                                            <TableRowCell class="p-2 m-d-none" VerticalAlignment="VerticalAlignment.Middle">P @item.Price.ToString("#,##0.00")</TableRowCell>
                                            <TableRowCell class="p-2 m-d-none" VerticalAlignment="VerticalAlignment.Middle">
                                                P @((purchaseOrder.ServiceFee + purchaseOrder.HandlingFee).ToString("#,##0.00"))
                                            </TableRowCell>
                                            <TableRowCell class="p-2" VerticalAlignment="VerticalAlignment.Middle">
                                                P @((purchaseOrder.ServiceFee + purchaseOrder.HandlingFee + item.Price).ToString("#,##0.00"))
                                            </TableRowCell>
                                        </TableRow>
                                    }
                                </TableBody>
                            </Table>
                        </div>
                        <div class="text-center">
                            <p class="font-14 color-grey-100 my-3">Should you require assistance in cancellation or change in order, Kindly email us in support@cinnamon.ph</p>
                            <Button class="color-white-100 rounded-pill bg-orange-100 px-4 hover-color-white mt-3">
                                Back to Home
                            </Button>
                        </div>
                    </div>
                </Column>
            </Row>
        </Container>
    </div>
}

@code 
{
    [Parameter]
    public int OrderId {get; set;}

    private string token;
    private Framework.ApiCommand.ApiCore.DTO.PurchaseOrder.OtePurchaseOrderDTO? purchaseOrder;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if(string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/explore");
                return;
            }

            await LoadPurchaseOrderDetails();
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadPurchaseOrderDetails()
    {
        var orderSummaryRes = await transactionApiHandler.GetOtePurchaseOrder(OrderId, token);
        if(!orderSummaryRes.Succeeded || orderSummaryRes.Result is null || !orderSummaryRes.Result.IsSuccess)
        {
            NavigationManager.NavigateTo("/not-found");
            return;
        }

        purchaseOrder = orderSummaryRes.Result.Result;
    }

    private IEnumerable<TicketSummary> GetTicketSummary
    {
        get
        {
            var tickets = new Dictionary<int, TicketSummary>();
            
            if(purchaseOrder is not null)
            {
                foreach(var item in purchaseOrder.Tickets)
                {
                    if(tickets.ContainsKey(item.Id))
                    {
                        tickets[item.Id].Count++;
                    }
                    else 
                    {
                        tickets.Add(item.Id, new TicketSummary {
                            Count = 1,
                            Id = item.Id,
                            Name = item.Name,
                            Price = item.Price
                        });
                    }
                }
            }

            return tickets.Select(t => t.Value);           
        }    
    }

    private class TicketSummary 
    {
        public int Id {get; set;}
        public string Name {get; set;}
        public decimal Price {get; set;}
        public int Count {get; set;}
    }
}
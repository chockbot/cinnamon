    private string CustomerName(CoreDto.Customer.BasicProfileDTO profile)
    {
        return $"{Capitalize(profile.FirstName)} {Capitalize(profile.LastName)}";
    }
    private string Capitalize(string value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        var result = value
                        .Split(" ")
                        .Where(s => !string.IsNullOrEmpty(s.Trim()))
                        .Select(s =>
                        {
                            string firsrChar = s.Substring(0, 1);
                            return $"{firsrChar.ToUpper()}{s.Substring(1)}";
                        });

        return String.Join(" ", result);
    }
    private async Task MessageProvider(int providerId)
    {
        var messageProviderRes = await chatApiHandler.RequestMessage(new Framework.ApiCommand.ApiCore.ChatRoom.Request.RequestMessageArgs
            {
                ProviderId = providerId
            }, token);
        if (!messageProviderRes.Succeeded || messageProviderRes.Result is null || !messageProviderRes.Result.IsSuccess)
        {
            await NotificationService.Error("An error occured. Please try again.", "Error");
            return;
        }

        var result = messageProviderRes.Result.Result;
        var url = $"/messages/?guid={result.Guid}&token={result.Token}";

        if (currentLogin is null)
        {
            signInReturnUrl = url;
            await loginModal.Show();
        }
        else
        {
            NavigationManager.NavigateTo(url);
        }
    }
    private void NavigateToReservation()
    {
        string paymentUrl = $"/reservation/{Handler}/?date={selectedDate}&token={token}";
        NavigationManager.NavigateTo(paymentUrl);
    }
    private async Task ProceedToPayment()
    {
        isLoading = true;
        StateHasChanged();

        await Task.Delay(2000);

        submitting = true;

        if (currentLogin is null)
        {
            string oteDetailsUrl = $"/explore/ote/reserved/{Handler}";
            signInReturnUrl = oteDetailsUrl;

            loginModal.Show();
            return;
        }
        string paymentUrl = $"/reservation/{Handler}/?date={selectedDate}&token={token}";

        await Task.Delay(2000);

        isLoading = false;
        StateHasChanged();
        NavigationManager.NavigateTo(paymentUrl);
        
        submitting = false;
    }
}

    private int ServiceFeePercent 
    {
        get
        {
            if(string.IsNullOrEmpty(SelectedPaymentCode)) return 0;
            if(SelectedPaymentCode == "CARD") return 5;
            else return 3;
        }
    }

    private decimal GetSubTotal 
    {
        get
        {
            return selectedTickets.Sum(t => t.Value.Price * t.Value.Count);
        }
    }

    private decimal GetConvinienceFee
    {
        get
        {
            decimal result = 0;

            if(string.IsNullOrEmpty(SelectedPaymentCode)) return 0;

            if (selectedTickets.Count > 0 && !IsInclusivePricing)
            {
                result = GetSubTotal * ((decimal)ServiceFeePercent / 100); //.05m;
            }

            return result;
        }
    }

    private decimal GetServiceFee 
    {
        get
        {
            if(selectedTickets.Sum(t => t.Value.Price) == 0) return 0;

            if(selectedTickets.Count > 0 && !IsInclusivePricing) return 15;

            return 0;
        }
    }

    private decimal GetAppliedCoupon
    {
        get
        {
            decimal result = 0;

            if(Coupon.IsCouponApplied && Coupon.IsValid)
            {
                // fixed amount
                if(Coupon.DiscountType == 1)
                {
                    result = Coupon.Amount;
                }
                // percentage
                else if(Coupon.DiscountType == 0)
                {
                    decimal percentage = Coupon.Amount / 100;
                    decimal subTotal = 0;
                    if(IsInclusivePricing)
                    {
                        subTotal = GetSubTotal;
                    }
                    else 
                    {
                        subTotal = GetSubTotal + GetConvinienceFee;
                    }
                    result = subTotal * percentage;
                }
            }

            return result;
        }
    }

    private decimal GetTotalCredit
    {
        get
        {
            decimal result = 0;

            return result;
        }
    }

    private decimal GetTotalPrice
    {
        get
        {
            decimal result = 0;

            if (ticketCount > 0)
            {
                decimal discount = 0;
                result = ((GetSubTotal + GetConvinienceFee + GetServiceFee) - GetAppliedCoupon) - GetTotalCredit;
                result = result < 0 ? 0 : result;
            }

            return result;
        }
    }

    private Task AddTicket(int ticketId)
    {
        if(selectedTicketId != ticketId)
        {
            ticketCount = 1;
            selectedTicketId = ticketId;
        }
        else 
        {
            ticketCount ++;
        }
        return Task.CompletedTask;
    }

    private async Task ValidateCouponCode()
    {
        Coupon.ErrorDescription = string.Empty;
        Coupon.ErrorTitle = string.Empty;

        if(ticketCount == 0)
        {
            Coupon.IsCouponApplied = true;
            Coupon.IsValid = false;
            Coupon.ErrorTitle = "Wrong Application of Code";
            Coupon.ErrorDescription = "Please make sure you have selected an ticket first";

            RemoveCouponError();
            return;
        }

        if(!string.IsNullOrEmpty(Coupon.CouponCode) && ticketCount > 0)
        {
            Coupon.IsValidating = true;

            decimal subTotal = GetSubTotal;
            decimal paymentProviderFee = GetConvinienceFee;
            decimal serviceFee = GetServiceFee;
            decimal total = subTotal + paymentProviderFee + serviceFee;

            var validateRes = await activityHandler.ValidateCouponCode(new Framework.ApiCommand.ApiCore.Activity.Request.ValidateCouponCodeArgs {
                ActivityId = activity.Id,
                Amount = total,
                CouponCode = Coupon.CouponCode
            }, token);

            if(!validateRes.Succeeded || validateRes.Result == null)
            {
                Coupon.IsCouponApplied = true;
                Coupon.IsValid = false;
                Coupon.ErrorTitle = "External Error Occured";
                Coupon.ErrorDescription = "An error occured when trying to validate coupon code";

                RemoveCouponError();
            }
            else if (validateRes.Succeeded && validateRes.Result != null && !validateRes.Result.IsSuccess)
            {
                Coupon.IsCouponApplied = true;
                Coupon.IsValid = false;
                Coupon.ErrorTitle = validateRes.Result.ErrorInfo.Message;
                Coupon.ErrorDescription = validateRes.Result.ErrorInfo.Description;

                RemoveCouponError();
            }
            else 
            {
                var result = validateRes.Result.Result;

                Coupon.IsCouponApplied = true;
                Coupon.IsValid = true;
                Coupon.Amount = result.Amount;
                Coupon.DiscountType = result.DiscountType;
                Coupon.MaximumSpend = result.MaximumSpend;
            }

            Coupon.IsValidating = false;
        }
    }

    private async Task RemoveCouponError()
    {
        await Task.Delay(3000);
        ClearCouponDetails();
        StateHasChanged();
    }

    private void ClearCouponDetails()
    {
        Coupon.IsCouponApplied = false;
        Coupon.IsValid = false;
        Coupon.Amount = 0;
        Coupon.DiscountType = -1;
        Coupon.MaximumSpend = 0;
        Coupon.CouponCode = string.Empty;
    }

    private Task RemoveAppliedCoupon()
    {
        ClearCouponDetails();
        return Task.CompletedTask;
    }

    private async Task SelectCardPayment()
    {
        if (await paymentValidation.ValidateAll())
        {
            cardModal.Close(CloseReason.UserClosing);
            SelectedPaymentCode = "CARD";
        }
    }



    private Task RemoveSelectedTicket(OtePricing pricing)
    {
        if(pricing.TicketSold >= pricing.MaxSlots)
        {
            return Task.CompletedTask;
        }

        if(selectedTickets.ContainsKey(pricing.Id) && selectedTickets[pricing.Id].Count > 0)
        {
            selectedTickets[pricing.Id].Count--;
            if(selectedTickets[pricing.Id].Count == 0) selectedTickets.Remove(pricing.Id);
        }
        return Task.CompletedTask;
    }

    private async Task ProceedToPayment()
    {
        if(string.IsNullOrEmpty(SelectedPaymentCode))
        {
            await NotificationService.Error("Please select payment method.", "Payment Method");
            return;
        }
        if(selectedTickets.Count == 0)
        {
            await NotificationService.Error("Please select ticket to purchase.", "Ticket");
            return;
        }

        //Add to payment queue
        var selectedSeats = selectedTickets.SelectMany(t => t.Value.SeatUUID.Split(',').Zip(t.Value.SeatNumber.Split(','), (uuid, name) => new
        {
            SeatUUID = uuid,
            SeatNumber = name
        }))
        .ToList();

        // Initialize the list for unavailable seats
        var unavailableSeatsList = new List<string>();
        AvailableSeats.Clear();

        foreach (var ticket in selectedSeats)
        {
            var isUserInQueue = await QueueServices.IsUserInQueueAsync(paymentQueueName, ticket.SeatUUID);
            if (isUserInQueue)
            {
                // Add to the unavailable seats list
                unavailableSeatsList.Add(ticket.SeatNumber);
                //Remove seat in selectedTickets
                var ticketToRemove = selectedTickets.FirstOrDefault(a => a.Value.SeatUUID.Contains(ticket.SeatUUID));
                var ticketSeatUUID = ticketToRemove.Value?.SeatUUID.Split(",");
                if (ticketSeatUUID.Length > 1)
                {
                    // Decrease the ticket count
                    ticketToRemove.Value.Count -= 1;
                    // Remove Seatnumner
                    var seatList = ticketToRemove.Value.SeatNumber.Split(",").ToList();
                    seatList.Remove(ticket.SeatNumber);
                    ticketToRemove.Value.SeatNumber = string.Join(",",seatList);


                    // Remove SeatUUID
                    var seatUUIDList = ticketToRemove.Value.SeatUUID.Split(",").ToList();
                    seatUUIDList.Remove(ticket.SeatUUID); // Ensure UUID is removed
                    ticketToRemove.Value.SeatUUID = string.Join(",", seatUUIDList);
                }
                else
                {
                    selectedTickets.Remove(ticketToRemove.Key);
                }
            }
            else
            {
                AvailableSeats.Add(ticket.SeatUUID);
            }
        }

        unavailableSeats = string.Join(", ", unavailableSeatsList);

        if (!string.IsNullOrEmpty(unavailableSeats))
        {
            await modalUnAvailable.Show();
            return;
        }
        else
        {
            //Save selected ticket to the local storage
            await localStorage.SetItem(RESERVEDSEAT_ID, AvailableSeats);
            // Queue the available seats if any
            foreach (var seatUUID in AvailableSeats)
            {
                await QueueServices.EnqueueUserInPaymentAsync(paymentQueueName, seatUUID);
            }
            await SubmitTransaction();
        }
    }

    private async Task SubmitTransaction()
    {
        try
        {
            submitting = true;

            StateHasChanged();

            var submit = await transactionApiHandler.SubmitOtePurchaseOrder(new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs {
                ActivityId = activity.Id,
                CardInformation = SelectedPaymentCode == "CARD" ? new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.OteCardDetails {
                    AccountHolder = cardPaymentModel.CardHolder ?? string.Empty,
                    CardNumber = cardPaymentModel.CardNumber ?? string.Empty,
                    CVV = cardPaymentModel.CVV ?? string.Empty,
                    ExpireMonthYear = cardPaymentModel.Expiration ?? string.Empty
                } : null,
                CouponCode = Coupon.IsCouponApplied && Coupon.IsValid ? Coupon.CouponCode : string.Empty,
                IsCreditsApplied = false,
                PaymentChannel = SelectedPaymentCode,
                PaymentMethod = SelectedPaymentCode == "CARD" ? "CARD" : "EWALLET",
                Tickets = selectedTickets.Select(t => {
                    return new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.OTeTicket {
                        Count = t.Value.Count,
                        Id = t.Value.Id,
                        SeatNumber = t.Value.SeatNumber
                    };
                }),
                Guid = Guid,
                Token = Token
            }, token);

            if ((!submit.Succeeded || submit.Result == null) || (submit.Succeeded && !submit.Result.IsSuccess))
            {
                submitting = false;
                await NotificationService.Error(submit.Result?.ErrorInfo?.Message ?? submit.Message, "Error");
            }
            else
            {
                //Update seat payload occupied selected seat
                foreach (var ticket in selectedTickets)
                {
                    Seats = ticket.Value.SeatUUID.Split(",").ToList();
                    foreach (var seat in Seats)
                    {
                        var updateSeatPlan = await seatplanApiHandler.UpdateSeatStatus(new Framework.ApiCommand.ApiCore.SeatPlan.Request.UpdateSeatStatusArgs
                            {
                                ActivityId = activity.Id,
                                EventDate  = SelectedDate,
                                CategoryId = ticket.Value.CategotyUUID,
                                RowId      = ticket.Value.RowUUID,
                                SeatId     = seat,
                                Occupied   = true
                            }, token);
                        if (!updateSeatPlan.Succeeded || updateSeatPlan.Result is null || !updateSeatPlan.Result.IsSuccess)
                        {
                            await NotificationService.Error("An error occured. Please contact support.", "Error");
                        }
                    }
                }
                submitting = false;
                await localStorage.RemoveItem(TRACKER_ID);
                if (submit.Result.Result.Action == 1)
                {
                    NavigationManager.NavigateTo(submit.Result.Result.Url);
                }
                else if(submit.Result.Result.Action == 0)
                {
                    NavigationManager.NavigateTo(submit.Result.Result.Url);
                }
                else
                {
                    NavigationManager.NavigateTo($"/purchase/order/reserved/?purchaseid={submit.Result.Result.Id}");
                }
            }
        }
        catch (System.Exception ex)
        {
            await NotificationService.Error("An error occured. Contact Cinnamon support.", "Error");
        }
    }

    private bool DisableProceed
    {
        get
        {
            if(activity is null) return true;

            if(selectedTickets.Count > 0)
            {
                return false;
            }

            return true;
        }
    }

@layout EmptyLayout
@page "/payment/ote/reserved/{Handler}"
@using AutoMapper;
@using System.Security.Claims;
@using System.ComponentModel.DataAnnotations;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Models.Ote;
@using Cinnamon.Web.Models;
@using Cinnamon.Web.Utils;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Modules.Services
@using Microsoft.AspNetCore.SignalR.Client;
@inject QueueServices QueueServices
@inject IAccountApiHandler accountApiHandler;
@inject NavigationManager NavigationManager;
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject INotificationService NotificationService;
@inject IActivityApiHandler activityHandler;
@inject ITransactionApiHandler transactionApiHandler;
@inject ISeatPlanApiHandler seatplanApiHandler;
@inject IMapper mapper;
@inject ILocalStorage localStorage;
@inject Cinnamon.Framework.Providers.IJsonSerializationProvider jsonSerializationProvider

<PageTitle>Checkout Payment | CinnamonPH</PageTitle>
<SeoMeta Title="Checkout Payment" Subject="Checkout Payment">
    <ExtraMeta>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    </ExtraMeta>
</SeoMeta>

@if(activity is not null && !string.IsNullOrEmpty(token))
{
    <div class="top-row desktop">
        <!--App Name-->
        <div class="app-name">
            <a href="/explore" class="app-name">@Resources.App.appName</a>
        </div>
        <!--Timer-->
        <div class="timer-section">
            <p class="ticket-text">Tickets Reserved in Cart for</p>
            <p class="timer-value">@RemainingTime</p>
        </div>
        <div class="secured-section">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
                <path d="M15.0055 8.53979C14.7668 8.30113 14.4772 8.18189 14.1361 8.18189H13.7273V5.72721C13.7273 4.15905 13.1649 2.81258 12.0399 1.68758C10.9149 0.562525 9.56857 0 8.00019 0C6.43185 0 5.08525 0.562525 3.96038 1.68753C2.83533 2.81258 2.27298 4.15901 2.27298 5.72721V8.18189H1.86395C1.52316 8.18189 1.23332 8.30113 0.994661 8.53979C0.756003 8.77827 0.636719 9.0681 0.636719 9.40921V16.7728C0.636719 17.1136 0.756048 17.4035 0.994661 17.6422C1.23332 17.8806 1.52316 18 1.86395 18H14.1364C14.4775 18 14.7671 17.8808 15.0059 17.6422C15.2443 17.4035 15.3638 17.1136 15.3638 16.7728V9.40908C15.364 9.06824 15.2443 8.77845 15.0055 8.53979ZM11.2728 8.18189H4.72753V5.72721C4.72753 4.82384 5.04719 4.05248 5.68637 3.41339C6.32564 2.77421 7.09687 2.45468 8.00032 2.45468C8.90386 2.45468 9.67491 2.77416 10.3142 3.41339C10.9532 4.05244 11.2728 4.82384 11.2728 5.72721V8.18189Z" fill="#343D4C" />
            </svg>
            <p class="secure-text">Secure Checkout</p>
        </div>
    </div>
    <div class="top-row mobile">
        <div class="row-holder">
            <!--App Name-->
            <div class="app-name">
                <a href="/explore" class="app-name">@Resources.App.appName</a>
            </div>
            <div class="secured-section">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
                    <path d="M15.0055 8.53979C14.7668 8.30113 14.4772 8.18189 14.1361 8.18189H13.7273V5.72721C13.7273 4.15905 13.1649 2.81258 12.0399 1.68758C10.9149 0.562525 9.56857 0 8.00019 0C6.43185 0 5.08525 0.562525 3.96038 1.68753C2.83533 2.81258 2.27298 4.15901 2.27298 5.72721V8.18189H1.86395C1.52316 8.18189 1.23332 8.30113 0.994661 8.53979C0.756003 8.77827 0.636719 9.0681 0.636719 9.40921V16.7728C0.636719 17.1136 0.756048 17.4035 0.994661 17.6422C1.23332 17.8806 1.52316 18 1.86395 18H14.1364C14.4775 18 14.7671 17.8808 15.0059 17.6422C15.2443 17.4035 15.3638 17.1136 15.3638 16.7728V9.40908C15.364 9.06824 15.2443 8.77845 15.0055 8.53979ZM11.2728 8.18189H4.72753V5.72721C4.72753 4.82384 5.04719 4.05248 5.68637 3.41339C6.32564 2.77421 7.09687 2.45468 8.00032 2.45468C8.90386 2.45468 9.67491 2.77416 10.3142 3.41339C10.9532 4.05244 11.2728 4.82384 11.2728 5.72721V8.18189Z" fill="#343D4C" />
                </svg>
                <p class="secure-text">Secure Checkout</p>
            </div>
        </div>
        <!--Timer-->
        <div class="timer-section">
            <p class="ticket-text">Tickets Reserved in Cart for</p>
            <p class="timer-value">@RemainingTime</p>
        </div>
    </div>
    <div class="xp-ote-payment-wrapper pb-5">
        <Container>
            <div class="d-flex align-items-center mt-3">
                <button class="button-back">
                    <img class="cursor-pointer me-3" src="/images/payment/back-icon.png" alt="icon" @onclick="NavigateToTicketReservation" />
                </button>
                <h4 class="fw-bold px-3 mb-0 color-grey-100 font-24 text-capitalize m-font-18">Confirm experience</h4>
            </div>
            <Row>
                <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop" class="left-order">
                    <section class="mt-5 item-pricings">
                        <div class="selected-ticket-table">
                            <div class="ticket-header">
                                <p class="header-name">Tickets</p>
                                <p class="header-name">Price</p>
                                <p class="header-name">Quantity</p>
                                <p class="header-name">Seat Number</p>
                            </div>
                            @foreach (var item in selectedTickets)
                            {
                                <div class="ticket-column">
                                    <p class="header-name">@item.Value.Name</p>
                                    <p class="header-name">@item.Value.Price</p>
                                    <p class="header-name"> @item.Value.Count</p>
                                    <p class="header-name">@item.Value.SeatNumber</p>
                                </div>
                            }
                        </div>
                    </section>
                    <section class="mt-5">
                        <h5 class="font-20 m-font-18 font-weight-700 color-black-100 mb-0">Important Information</h5>
                        <p class="text-center mt-4">
                            <span class="color-grey-100">
                                The cinnamon platform guarantees:
                            </span> 
                        </p>
                        <Row class="mt-5 m-margin-top-20">
                            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                                <div class="d-flex w-100 h-100 align-items-center">
                                    <img class="mx-auto" src="images/payment/new-security-guranted.png" alt="icon">
                                </div>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" class="m-margin-top-20">
                                <p class="font-16 color-grey-100">The cinnamon platform guarantees: </p>
                                <ul class="font-16 color-grey-100 ">
                                    <li>
                                        <p class="mb-0">Money-back guarantee if you're not satisfied.</p>
                                    </li>
                                    <li>
                                        <p class="mb-0">Anti-scam protection.</p>
                                    </li>
                                    <li>
                                        <p class="mb-0">Secure payment.</p>
                                    </li>
                                    <li>
                                        <p class="mb-0">Accidental support (for outdoor activities).<span class="text-danger">*</span></p> 
                                        <p class="font-12 mb-0"><span class="text-danger">*</span> To follow function</p>
                                    </li>
                                </ul>
                            </Column>
                        </Row>
                        <p class="font-16 color-black-100">What will happen after I purchase?</p>
                        <ol class="font-16 color-grey-100" style="padding-left: 1rem;">
                            <li class="mb-3">A purchase confirmation email including your e-ticket will be sent to your email.</li>
                            <li class="mb-3">You can access the event you purchased/joined by going to your Account from the menu.</li>
                        </ol>
                    </section>
                    <section>
                        <Divider class="my-4" />
                        <p class="font-20 color-black-100 font-weight-700">Pay with</p>
                        <div class="payment-card mb-4">
                            <label class="font-16 color-black-100 mb-1 m-font-12">Cards</label>
                            <label @onclick='() => cardModal.Show()' class="cursor-pointer d-flex justify-content-between border-1-solid border-color-grey-200 px-3 py-2 border-radius-15 overflow-hidden">
                                <div class="d-flex align-items-center">
                                    <span class="me-3 me-md-4">
                                        <span class='@(SelectedPaymentCode == "CARD" ? "cursor-pointer checkbox-round span-radio selected" : "cursor-pointer checkbox-round span-radio")' />
                                    </span>
                                    <span class="me-2 me-md-4">
                                        <img src="images/ote/visa.png" alt="visa-card">
                                    </span>
                                    <span class="me-2 me-md-4">
                                        <img src="images/ote/master-card.png" alt="master-card">
                                    </span>
                                    <span class="me-2 me-md-4">
                                        <img src="images/ote/jcb.png" alt="jcb-card">
                                    </span>
                                    <span class="me-2 me-md-4">
                                        <img src="images/ote/american-express.png" alt="american-express-card">
                                    </span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="font-16 color-black-100 me-4 cursor-pointer m-font-12">Credit or Debit Card</span>
                                    <img src="images/payment/credit-card-arrow.svg" alt="arrow">
                                </div>
                            </label>
                        </div>
                        <div class="payment-ewallets">
                            <label class="font-16 color-black-100 mb-1 m-font-12">E-wallets</label>
                            <div class="d-flex justify-content-between border-1-solid border-color-grey-200 px-3 py-2 border-radius-15 overflow-hidden">
                                <RadioGroup Name="ewallets" TValue="string" @bind-CheckedValue="SelectedPaymentCode">
                                    <ul class="list-inline d-flex flex-column mb-0">
                                        <li class="list-inline-item mb-3">
                                            <label for="gcash-ewallet" class="d-flex align-items-center cursor-pointer">
                                                <div class="me-3 me-md-4">
                                                    <Radio id="gcash-ewallet" Checked='SelectedPaymentCode == "GCASH"' class="cursor-pointer checkbox-round" Value='@("GCASH")' />
                                                </div>
                                                <div class="me-2 me-md-4 ewallet-item-img">
                                                    <img src="images/payment/gcash.svg" alt="gcash">
                                                </div>
                                                <div class="me-2 me-md-4">
                                                    <span class="text-capitalize font-16 color-black-100">gcash</span>
                                                    <p class="mb-0 font-10 color-grey-100">
                                                        Payment should be completed within 30 mins. Accessible 24/7 and may entail additional fees.
                                                    </p>
                                                </div>
                                            </label>
                                        </li>
                                        <li class="list-inline-item mb-3">
                                            <label for="grabpay-ewallet" class="d-flex align-items-center cursor-pointer">
                                                <div class="me-3 me-md-4">
                                                    <Radio id="grabpay-ewallet" Checked='SelectedPaymentCode == "GRABPAY"' class="cursor-pointer checkbox-round" Value='@("GRABPAY")' />
                                                </div>
                                                <div class="me-2 me-md-4 ewallet-item-img">
                                                    <img src="images/payment/grabpay.svg" alt="grabpay">
                                                </div>
                                                <div class="me-2 me-md-4">
                                                    <span class="text-capitalize font-16 color-black-100">grab pay</span>
                                                    <p class="mb-0 font-10 color-grey-100">
                                                        Payment should be completed within 30 mins. Accessible 24/7 and may entail additional fees.
                                                    </p>
                                                </div>
                                            </label>
                                        </li>
                                        <li class="list-inline-item mb-3">
                                            <label for="shopee-pay-ewallet" class="d-flex align-items-center cursor-pointer">
                                                <div class="me-3 me-md-4">
                                                    <Radio id="shopee-pay-ewallet" Checked='SelectedPaymentCode == "SHOPEEPAY"' class="cursor-pointer checkbox-round" Value='@("SHOPEEPAY")' />
                                                </div>
                                                <div class="me-2 me-md-4 ewallet-item-img">
                                                    <img src="images/payment/shoppepay.svg" alt="shopee-pay">
                                                </div>
                                                <div class="me-2 me-md-4">
                                                    <span class="text-capitalize font-16 color-black-100">Shopee Pay</span>
                                                    <p class="mb-0 font-10 color-grey-100">
                                                        Payment should be completed within 30 mins. Accessible 24/7 and may entail additional fees.
                                                    </p>
                                                </div>
                                            </label>
                                        </li>
                                        <li class="list-inline-item">
                                            <label for="maya-ewallet" class="d-flex align-items-center cursor-pointer">
                                                <div class="me-3 me-md-4">
                                                    <Radio id="maya-ewallet" Checked='SelectedPaymentCode == "PAYMAYA"' class="cursor-pointer checkbox-round" Value='@("PAYMAYA")' />
                                                </div>
                                                <div class="me-2 me-md-4 ewallet-item-img">
                                                    <img src="images/payment/maya.svg" alt="maya">
                                                </div>
                                                <div class="me-2 me-md-4">
                                                    <span class="text-capitalize font-16 color-black-100">maya</span>
                                                    <p class="mb-0 font-10 color-grey-100">
                                                        Payment should be completed within 30 mins. Accessible 24/7 and may entail additional fees.
                                                    </p>
                                                </div>
                                            </label>
                                        </li>
                                    </ul>
                                </RadioGroup>
                            </div>
                        </div>
                    </section>
                    <p class="font-12 color-grey-100 mt-3">By selecting the button below, I agree to the Cinnamon Maker’s requirements and activity policies, Cinnamon's Rebooking and Refund Policy, I agree to pay the total amount shown.</p>
                    <Button Loading="submitting" Disabled="DisableProceed || submitting || someoneAlreadyBooked" Clicked="ProceedToPayment"
                        class="btn-primary border-radius-10 m-d-none" Border="Border.Is0" >
                        <LoadingTemplate>
                            <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Please wait
                        </LoadingTemplate>
                        <ChildContent>
                            Confirm and Pay
                        </ChildContent>
                    </Button>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop" class="right-order">
                    <div class="booking-total-container sticky-top mb-3" style="top:80px;">
                        <Card class="border-radius-20 overflow-hidden">
                            <CardBody>
                                <div class="d-flex" style="font-size:1.125rem">
                                    <div class="activity-img me-3">
                                        <img src="@GetActivityFirstImage" alt="Activity Image">
                                    </div>
                                    <div>
                                        <p class="font-16 font-weight-700 color-black-100 mb-1 line-h-1-1">@activity.EventName</p>
                                        <p class="font-14 color-grey-100 mb-1 line-h-1-1">@ActivityLocation</p>
                                        @if (!string.IsNullOrEmpty(selectedDate))
                                        {
                                            <p class="font-14 color-grey-100 mb-1 line-h-1-1">
                                                @selectedDate
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="font-14 color-grey-100 mb-1 line-h-1-1">
                                                @activity.ScheduleFrom.ToString("dd MMMM yyyy") | @activity.ScheduleFrom.ToString("hh:mm tt").ToUpper()
                                            </p>
                                        }
                                    </div>
                                </div>
                                <Divider />
                                <div class="price-details">
                                    <span class="font-16 font-weight-700 color-black-100">Price Details</span>
                                    @if(selectedTickets.Count > 0)
                                    {
                                        @foreach (var item in selectedTickets)
                                        {
                                            <div class="d-flex justify-content-between py-1 price-per-head">
                                                <div>
                                                    @item.Value.Price.ToString("#,##0") x @item.Value.Count @(item.Value.Count > 1 ? "Tickets" : "Ticket")
                                                </div>
                                                <div>
                                                    PHP @((item.Value.Price * item.Value.Count).ToString("#,##0.00"))
                                                </div>
                                            </div>   
                                        }
                                    }
                                    else 
                                    {
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div>
                                                0 x 0 Ticket
                                            </div>
                                            <div>
                                                PHP 0.00
                                            </div>
                                        </div>   
                                    }
                                    @if(!IsInclusivePricing)
                                    {
                                        <div class="d-flex justify-content-between py-1 price-per-head">
                                            <div>
                                                Service Fee <span class="">@(ServiceFeePercent != 0 ? ServiceFeePercent + "%" : "")</span>
                                            </div>
                                            <div>
                                                @(string.IsNullOrEmpty(SelectedPaymentCode) ? "Depends on payment method" : "PHP " + GetConvinienceFee.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                    }
                                    @if(!IsInclusivePricing)
                                    {
                                        <div class="d-flex justify-content-between py-1 price-per-head service-fee">
                                            <div class="d-flex align-items-center">
                                                <CustomTooltip MarginLeft="0">
                                                    <TextContent>
                                                        <span class="rounded-circle service-fee-info">i</span>
                                                    </TextContent>
                                                    <TooltipContent>
                                                        <span class="color-grey-100">
                                                            This helps Cinnamon run its services and protects your payment in case the experience provider does 
                                                            something illegal or against our policy. They won't get paid until after the sessions or work have been done.
                                                        </span>
                                                    </TooltipContent>
                                                </CustomTooltip> 
                                                <span class="ms-1">Handling Fee</span>
                                            </div>
                                            <div>
                                                PHP @(GetServiceFee.ToString("#,##0.00"))
                                            </div>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between py-1 price-per-head">
                                        <div class="d-flex position-relative">
                                            <div class="position-relative" style="width: 150px;">
                                                <TextEdit class='@(Coupon.IsCouponApplied && !Coupon.IsValid ? "is-invalid" : "")' 
                                                    style='@(Coupon.IsCouponApplied ? "background-color: #F3F6FC; padding-right: 25px" : "background-color: #F3F6FC;")' 
                                                    required Placeholder="Add coupon" Size="Size.ExtraSmall" @bind-Text="Coupon.CouponCode" />
                                                @if(Coupon.IsCouponApplied && Coupon.IsValid)
                                                {
                                                    <img @onclick="RemoveAppliedCoupon" class="remove-coupon-icon" src="images/payment/close.png" alt="remove">
                                                }
                                            </div>
                                            <Button Type="ButtonType.Button" Clicked="ValidateCouponCode"
                                                class="btn-primary font-12" Border="Border.Is0" Loading="Coupon.IsValidating" Disabled="Coupon.IsValidating"
                                                style="border-radius: 0; padding-top: 3px; padding-bottom: 3px; margin-left: 3px;">
                                                <LoadingTemplate>
                                                    <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i>
                                                </LoadingTemplate>
                                                <ChildContent>
                                                    Apply
                                                </ChildContent>
                                            </Button>
                                            @if(Coupon.IsCouponApplied && !Coupon.IsValid)
                                            {
                                                <div class="coupon-error-message font-12">
                                                    <b style="color: #AD0C0C;">@Coupon.ErrorTitle</b>
                                                    <br>
                                                    <span class="color-grey-100">
                                                        @Coupon.ErrorDescription
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <span style='@(GetAppliedCoupon > 0 ? "color: #AD0C0C" : "")'>
                                                @(GetAppliedCoupon > 0 ? "-" : "") PHP @(GetAppliedCoupon.ToString("#,##0.00"))
                                            </span>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 price-per-head">
                                        <div class="apply-credits">
                                            <span>Apply credits</span>
                                        </div>
                                        <div>
                                            PHP @(GetTotalCredit.ToString("#,##0.00"))
                                        </div>
                                    </div>
                                    <Divider />
                                    <div class="d-flex justify-content-between py-1 total-payments">
                                        <div>
                                            TOTAL PAYMENT
                                        </div>
                                        <div>
                                        PHP @(GetTotalPrice.ToString("#,##0.00"))
                                        </div>
                                    </div>
                                </div>
                            </CardBody>
                        </Card>
                    </div>
                </Column>
            </Row>
        </Container>

        <div class='mobile-calculator-wrapper'>
            <div class="mobile-calculator-wrapper-container border-radius-10 mobile-footer-shadow
                position-fixed left-0 right-0 bg-white-100">
                <div>
                    <div class="p-3 d-flex justify-content-between align-items-center">
                        <Button Type="ButtonType.Button" Clicked="ProceedToPayment" Disabled="DisableProceed || submitting" Loading="submitting"
                            class="btn-primary font-14 border-radius-10 px-4"
                            Border="Border.Is0">
                            <LoadingTemplate>
                                <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Please wait
                            </LoadingTemplate>
                            <ChildContent>
                                Confirm and Pay
                            </ChildContent>
                        </Button>
                        <div class="d-flex align-items-center">
                            <div class="prevent-select text-end" style="width: 160px;">
                                <span class="font-20 font-weight-700 color-black-100 total-price" tabindex="-1">₱ @(GetTotalPrice.ToString("#,##0.00"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <Modal @ref="cardModal">
            <ModalContent Centered>
                <ModalHeader Border="Border.Is0" class="d-flex justify-content-between align-items-center">
                    <p class="modal-title">Add Card Details</p>
                    <button type="button" class="btn-close " @onclick="() => cardModal.Hide()" />
                </ModalHeader>
                <ModalBody Padding="Padding.Is0.FromTop">
                    <Divider Margin="Margin.Is0.FromTop.Is2.FromBottom" />
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <img class="me-3" src="images/payment/visa-card.svg" alt="icon">
                            <img src="images/payment/master-card.svg" alt="icon">
                        </div>
                        <img src="images/payment/security-guranteed.png" alt="icon">
                    </div>
                    <div class="mt-2">
                        <Validations @ref="paymentValidation" Model="cardPaymentModel" Mode="ValidationMode.Manual">
                            <Validation>
                                <Field class="mb-3">
                                    <FieldLabel class="font-16 color-grey-100">Card Number</FieldLabel>
                                    <TextEdit @bind-Text="cardPaymentModel.CardNumber">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                            <Validation>
                                <Field class="mb-3">
                                    <FieldLabel class="font-16 color-grey-100">Name on Card</FieldLabel>
                                    <TextEdit @bind-Text="cardPaymentModel.CardHolder">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </Field>
                            </Validation>
                            <div class="row">
                                <div class="col">
                                    <Validation>
                                        <Field class="mb-3">
                                            <FieldLabel class="font-16 color-grey-100">Expiration</FieldLabel>
                                            <TextEdit @bind-Text="cardPaymentModel.Expiration" Placeholder="Ex. 03/28">
                                                <Feedback>
                                                    <ValidationError />
                                                </Feedback>
                                            </TextEdit>
                                        </Field>
                                    </Validation>
                                </div>
                                <div class="col">
                                    <Validation>
                                    <Field class="mb-3">
                                        <FieldLabel class="font-16 color-grey-100">CVV</FieldLabel>
                                        @if (cardPaymentModel.IsRevealPassword)
                                            {
                                                <TextEdit Role="TextRole.Text" Placeholder="Ex.123" @bind-Text="cardPaymentModel.CVV">

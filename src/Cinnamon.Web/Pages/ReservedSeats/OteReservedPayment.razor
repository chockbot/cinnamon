    private async Task StartConnection()
    {
        try
        {
            if(hubConnection.State == HubConnectionState.Disconnected)
            {
                await hubConnection.StartAsync();
                var status = hubConnection.State;
            }
        }
        catch (System.Exception)
        {
            await Task.Delay(500);
            StartConnection();
        }
    }

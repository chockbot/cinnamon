    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadOteDetails();
            await LoadProvideDetails();
            await LoadSelectedTickets();
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            token = user.FindFirstValue("Token");
            if(string.IsNullOrEmpty(token))
            {
                NavigationManager.NavigateTo("/explore");
                return;
            }
            else
            {
                //Create payment queue
                paymentQueueName = $"{Handler}-payment-queue";
                await QueueServices.EnsureQueueExistsAsync(paymentQueueName);
                //Load Profile
                await LoadProfile();
                //Check if user is in queue
                string activeQueueName = $"{Handler}-active-queue";
                //Remove all user in active queue w/ negative time
                await QueueServices.RemoveExpiredUsersFromActiveQueueAsync(activeQueueName);
                //Check user if is in the active-queue
                var activeQueueUserInfo = await QueueServices.GetUserInActiveQueueAsync(activeQueueName, currentLogin.Handler);
                if (activeQueueUserInfo.HasValue)
                {
                    var (insertionTime, remainingTime) = activeQueueUserInfo.Value;
                    if (remainingTime >= TimeSpan.Zero)
                    {
                        // Return the remaining processing time to the user
                        _isProcessing = true;
                        RemainingTime = remainingTime;
                        await MonitorQueue(currentLogin.Handler, RemainingTime);
                        StateHasChanged();
                    }
                    else
                    {
                        await OnTimeout();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task MonitorQueue(string userId, TimeSpan time)
    {
        try
        {
            while (true)
            {
                // Fetch the user's reserved queue info
                var reservedQueueInfo = await QueueServices.GetReservedQueueUserInfoAsync(
                    $"{Handler}-reserved-queue",
                    $"{Handler}-active-queue",
                    userId
                );
                // Check if the user is in the active queue
                if (reservedQueueInfo.numberAhead == -1) // Assume -1 indicates the user is in the active queue
                {
                    _isProcessing = true;
                    StartCountdownTimer(time);
                    StateHasChanged();
                    break; // Exit the loop once the user is in the active queue
                }
                else
                {
                    _isProcessing = false;
                    StateHasChanged();
                }

                // Wait for 10 seconds before checking again
                await Task.Delay(10000);
            }
        }
        catch (Exception ex)
        {
            // Log the exception for debugging (if needed) and show an error notification
            Console.WriteLine($"Error in MonitorQueue: {ex.Message}");
            await NotificationService.Error("An error occurred while monitoring the queue. Please try again later.", "Error");
        }
    }

    private async void StartCountdownTimer(TimeSpan span)
    {
        // Set the countdown timer to 10 minutes
        RemainingTime = span;
        _countdownTimer = new Timer(TimerCallback, null, 0, 1000); // Update every second
    }

    private void TimerCallback(object state)
    {
        if (RemainingTime.TotalSeconds > 0)
        {
            RemainingTime = RemainingTime.Subtract(TimeSpan.FromSeconds(1));
            InvokeAsync(StateHasChanged); // Notify Blazor to update the UI
        }
        else
        {
            // Time's up
            _countdownTimer.Dispose();
            OnTimeout();
        }
    }

    public async Task OnTimeout()
    {
        // Handle user timeout logic
        _isProcessing = false;
        NavigateToOteReserved();
    }

    private async Task LoadProfile()
    {
        if (!string.IsNullOrEmpty(Token))
        {
            var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (profileResult.Succeeded && profileResult.Result is not null && profileResult.Result.IsSuccess)
            {
                userId = profileResult.Result.Result.Id;
                currentLogin = mapper.Map<CustomerProfile>(profileResult.Result.Result);
            }
        }
    }

    private async Task LoadOteDetails()
    {
        try
        {
            var result = await activityHandler.FindOteByHandler(new Framework.ApiCommand.ApiCore.Activity.Request.OteActivityArgs {
                IncludeAddress = true,
                IncludeDescription = true,
                IncludePricing = true,
                IncludeSchedule = true,
                IncludeImages = true
            }, Handler);
            if(!result.Succeeded || result.Result is null || !result.Result.IsSuccess)
            {
                throw new ApplicationException(result.Message);
            }
            var act = result.Result.Result;

            if(!act.IsPublished)
            {
                NavigationManager.NavigateTo("not-found");
                return;
            }

            activity = mapper.Map<OteActivity>(act);
            activity.Pricings = activity.Pricings.OrderBy(t => t.Id);
            activity.EventTicketLimit = act.OteSchedule.EventTicketLimit;
            IsLimit = act.OteSchedule.EventTicketLimit != 0 ? true : false;
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Please try again later.", "Error");
        }
    }

    private async Task LoadSelectedTickets()
    {
        var trackerDetails = await transactionApiHandler.GetRequestPayment(new Framework.ApiCommand.ApiCore.Transaction.Request.GetRequestPaymentArgs {
            Guid = Guid,
            Token = Token
        }, token);
        if(!trackerDetails.Succeeded || trackerDetails.Result is null || !trackerDetails.Result.IsSuccess)
        {
            NavigationManager.NavigateTo($"/explore/ote/{Handler}");
            return;
        }
        var tracker = trackerDetails.Result.Result;

        if(tracker.Used)
        {
            NavigationManager.NavigateTo("/not-found");
            return;
        }

        // invalid selected activity
        if(activity.Id != tracker.ActivityId)
        {
            NavigationManager.NavigateTo($"/explore/ote/{Handler}");
            return;
        }
        //set selected date
        selectedDate = $"{tracker.SelectedDate.ToString("MMMM dd, yyyy")} | {tracker.SelectedDate.ToString("hh:mm tt").ToUpper()}";
        SelectedDate = tracker.SelectedDate;


        var defaultDatePricing = activity.OteDates.FirstOrDefault(d => d.Date.Date == tracker.SelectedDate.Date);
        if(defaultDatePricing is null)
        {
            NavigationManager.NavigateTo($"/explore/ote/{Handler}");
            return;
        }

        // load selected tickets if any
        AvailableTickets = activity.Pricings.Where(p => p.OteDateId == defaultDatePricing.Id);

        foreach (var ticket in tracker.SelectedTickets)
        {
            for(int i = 0; i < ticket.TicketCount; i++)
            {
                var sTicket = AvailableTickets.FirstOrDefault(t => t.Id == ticket.TicketId);
                var otePricing = new OtePricing {
                    Description      = sTicket.Description,
                    Id               = sTicket.Id,
                    IsAbsorbFees     = sTicket.IsAbsorbFees,
                    MaxSlots         = sTicket.MaxSlots,
                    Name             = sTicket.Name,
                    OteScheduleId    = sTicket.OteScheduleId,
                    Price            = sTicket.Price,
                    TicketSold       = sTicket.TicketSold,
                    RequiredApproval = sTicket.RequiredApproval,
                    IsUnlimited      = sTicket.IsUnlimited,
                    SeatNumber       = ticket.SeatNumber,
                    CategoryUUID     = ticket.CategoryUUID,
                    SeatUUID         = ticket.SeatUUID,
                    RowUUID          = ticket.RowUUID
                };
                await AddSelectedTicket(otePricing);
            }
        }
    }

    private Task AddSelectedTicket(OtePricing pricing)
    {
        if(selectedTickets.ContainsKey(pricing.Id))
        {
            selectedTickets[pricing.Id].Count++;
        }
        else 
        {
            selectedTickets.Add(pricing.Id, new TicketInfo
            {
                Count            = 1,
                Id               = pricing.Id,
                Name             = pricing.Name,
                Price            = pricing.Price,
                SeatNumber       = pricing.SeatNumber,
                RequiredApproval = pricing.RequiredApproval,
                CategotyUUID     = pricing.CategoryUUID,
                RowUUID          = pricing.RowUUID,
                SeatUUID         = pricing.SeatUUID
            });
        }
        return Task.CompletedTask;
    }


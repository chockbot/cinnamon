    private class PredefinedQuestion
    {
        public string NameQuestion { get; set; } = "##Name";
        public string EmailQuestion { get; set; } = "##Email";
        public string PhoneQuestion { get; set; } = "##Phone";

        [Required(ErrorMessage = "This field is required")]
        public string NameAnswer { get; set; } = string.Empty;

        [Required(ErrorMessage = "This field is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string EmailAnswer { get; set; } = string.Empty;

        [Required(ErrorMessage = "This field is required")]
        [RegularExpression(@"^(\+63|0)[0-9]{10}$", ErrorMessage = "Invalid mobile number")]
        public string PhoneAnswer { get; set; } = string.Empty;

        public bool HaveNameQuestion { get; set; }
        public bool HaveEmailQuestion { get; set; }
        public bool HavePhoneQuestion { get; set; }

        public bool RequiredNameQuestion { get; set; }
        public bool RequiredEmailQuestion { get; set; }
        public bool RequiredPhoneQuestion { get; set; }
    }

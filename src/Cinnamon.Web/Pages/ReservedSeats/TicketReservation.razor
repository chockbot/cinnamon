    private void HandleSeatSelection(Category.SelectedSeat selectedSeat)
    {
        var selectedTicket = activity.Pricings.FirstOrDefault(a => a.ReserveSeatUuid == selectedSeat.CategoryUUID);
        var ticketToUpdate = selectedTickets.FirstOrDefault(t => t.Value.Id == selectedTicket?.Id);
        //Remove Ticket
        if (ticketToUpdate.Value?.SeatUUID.Split(",").Contains(selectedSeat.Seat.Uuid) == true)
        {
            if (ticketToUpdate.Value.Count > 1)
            {
                // Decrease the ticket count
                ticketToUpdate.Value.Count -= 1;

                // Update the seat information by removing the specific seat
                var seatList = ticketToUpdate.Value.Seat.Split(",").ToList();
                seatList.Remove($"{selectedSeat.RowNumber}-{selectedSeat.Seat.SeatNumber}"); // Ensure correct format
                ticketToUpdate.Value.Seat = string.Join(",", seatList);

                var seatUUIDList = ticketToUpdate.Value.SeatUUID.Split(",").ToList();
                seatUUIDList.Remove(selectedSeat.Seat.Uuid); // Ensure UUID is removed
                ticketToUpdate.Value.SeatUUID = string.Join(",", seatUUIDList);
            }
            else
            {
                // Remove the ticket entirely if only one seat remains
                selectedTickets.Remove(ticketToUpdate.Key);
            }
        }
        else
        {
            // Add or update the ticket with the new seat
            if (ticketToUpdate.Value != null)
            {
                ticketToUpdate.Value.Count += 1;
                ticketToUpdate.Value.Seat += $",{selectedSeat.RowNumber}-{selectedSeat.Seat.SeatNumber}";
                ticketToUpdate.Value.SeatUUID += $",{selectedSeat.Seat.Uuid}";
            }
            else
            {
                selectedTickets.Add(selectedTicket.Id, new TicketReservation.TicketInfo
                {
                    Id               = selectedTicket.Id,
                    Count            = 1,
                    Name             = selectedTicket.Name,
                    Price            = selectedTicket.Price,
                    RequiredApproval = selectedTicket.RequiredApproval,
                    IsUnlimited      = selectedTicket.IsUnlimited,
                    Seat             = $"{selectedSeat.RowNumber}-{selectedSeat.Seat.SeatNumber}",
                    CategoryUUID     = selectedSeat.CategoryUUID,
                    RowUUID          = selectedSeat.RowUUID,
                    SeatUUID         = selectedSeat.Seat.Uuid
                });
            }
        }
    }
    private decimal GetAppliedCoupon
    {
        get
        {
            decimal result = 0;

            if (Coupon.IsCouponApplied && Coupon.IsValid)
            {
                // fixed amount
                if (Coupon.DiscountType == 1)
                {
                    result = Coupon.Amount;
                }
                // percentage
                else if (Coupon.DiscountType == 0)
                {
                    decimal percentage = Coupon.Amount / 100;
                    decimal subTotal = 0;
                    if (IsInclusivePricing)
                    {
                        subTotal = GetSubTotal;
                    }
                    else
                    {
                        subTotal = GetSubTotal;
                    }
                    result = subTotal * percentage;
                }
            }

            return result;
        }
    }
    private decimal GetSubTotal
    {
        get
        {
            return selectedTickets.Sum(t => t.Value.Price * t.Value.Count);
        }
    }

    private Task ProceedToPayment()
    {
        isLoading = true;
        StateHasChanged();
        if (currentLogin is null)
        {
            string oteDetailsUrl = $"/explore/ote/{Handler}";
            signInReturnUrl = oteDetailsUrl;

            isLoading = false;
            StateHasChanged();

            return loginModal.Show();
        }

        if (selectedTickets.Count <= 0)
        {
            return NotificationService.Error("Select a ticket to proceed.", "Oops!");

            isLoading = false;
            StateHasChanged();
        }

        if (IsLimit)
        {
            if (ticketCount < selectedTickets.Sum(a => a.Value.Count) && ticketCount != 0)
            {
                string message = ticketCount == activity.Schedule.EventTicketLimit
                    ? $"Max {ticketCount} {(ticketCount == 1 ? "ticket" : "tickets")} per customer."
                    : $"You can only purchase {ticketCount} {(ticketCount == 1 ? "ticket" : "tickets")}.";

                return NotificationService.Error(message, "Opps!");
            }
            else if (ticketCount == 0)
            {
                return NotificationService.Error("You've already reached the maximum limit for ticket purchases.", "Opps!");
            }
        }

        bool havePaidAndFreeTicket = selectedTickets.Any(t => t.Value.IsFree) && selectedTickets.Any(t => !t.Value.IsFree);
        if(havePaidAndFreeTicket)
        {
            return NotificationService.Error("Combining free and paid tickets is not permitted.", "Invalid");

            isLoading = false;
            StateHasChanged();
        }

        bool freeWithApproval = selectedTickets.Any(t => t.Value.IsFree && t.Value.RequiredApproval);
        bool isFreeWithoutApproval = selectedTickets.Any(t => t.Value.IsFree && !t.Value.RequiredApproval);

        if(freeWithApproval && isFreeWithoutApproval)
        {
            return NotificationService.Error("Combining free tickets with and without approval is not permitted.", "Invalid");

            isLoading = false;
            StateHasChanged();
        }

        bool paidWithApproval = selectedTickets.Any(t => !t.Value.IsFree && t.Value.RequiredApproval);
        bool isPaidWithoutApproval = selectedTickets.Any(t => !t.Value.IsFree && !t.Value.RequiredApproval);

        if(paidWithApproval && isPaidWithoutApproval)
        {
            return NotificationService.Error("Combining paid tickets with and without approval is not permitted.", "Invalid");

            isLoading = false;
            StateHasChanged();
        }

        bool haveQuestions = activityQuestions.Count > 0;

        if (haveQuestions) return modalQuestions?.Show();

        if (isFreeWithoutApproval || freeWithApproval) return ProceedToFreePurchase();

        if(paidWithApproval) return ProceedToJoinWaitlist();


        isLoading = false;
        StateHasChanged();

        return ProceedToPaymentOption();
    }

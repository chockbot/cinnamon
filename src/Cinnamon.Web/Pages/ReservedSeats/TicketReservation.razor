    private async Task ProceedToJoinWaitlist()
    {
        var questions = GetQuestions();

        var payload = new
        {
            Tickets = selectedTickets.Select(t => new
            {
                Id = t.Value.Id,
                Count = t.Value.Count,
                Date = SelectedDate,
                Price = t.Value.Price,
                Name = t.Value.Name,
            }),
            Questions = questions.Select(q => new
            {
                Id = q.Id,
                Question = string.Empty,
                Answer = string.Empty
            })
        };

        var serializedPayload = JsonConvert.SerializeObject(payload);

        submitting = true;
        StateHasChanged();

        //Add to Waitlist
        var oteDate = activity.OteDates.FirstOrDefault(d => d.Date.Date == SelectedDate.Date);
        var waitlist = await activityHandler.CreateOteWaitlist(new Framework.ApiCommand.ApiCore.Activity.Request.CreateOteWaitlistArgs
        {
            ActivityId   = activity.Id,
            ScheduleId   = oteDate.OteScheduleId,
            CustomerId   = currentLogin.Id,
            CustomerName = $"{currentLogin.FirstName} {currentLogin.LastName}",
            ProviderId   = provider.Id,
            Status       = 1,
            Type         = "Paid",
            Payload      = serializedPayload
        },token);

        if (waitlist.Succeeded && waitlist.Result is not null && waitlist.Result.IsSuccess)
        {
            //Add Email
            await NotificationService.Success("Successfully added to waitlist.", "Success");
            if (activity.Schedule.IsCapacity)
            {
                await LoadWaitlist();
            }
        }

        submitting = false;
        StateHasChanged();
    }


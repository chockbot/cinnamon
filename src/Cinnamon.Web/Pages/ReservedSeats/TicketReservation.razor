@layout EmptyLayout
@page "/reservation/{Handler}"
@using AutoMapper
@using Newtonsoft.Json;
@using System.Threading
@using System.Globalization;
@using System.Security.Claims;
@using Cinnamon.Web.Utils;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@using Cinnamon.Web.Models.Ote
@using Cinnamon.Web.Components;
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Components.Pages;
@using Cinnamon.Web.Components.Common;
@using Cinnamon.Web.Components.Common.SeatPlan;
@using Cinnamon.Web.Modules.Services
@using System.ComponentModel.DataAnnotations;
@using CoreDto = Cinnamon.Framework.ApiCommand.ApiCore.DTO;
@inject IMapper mapper
@inject IJSRuntime JSRuntime
@inject QueueServices QueueServices
@inject NavigationManager NavigationManager
@inject IActivityApiHandler activityHandler
@inject IAccountApiHandler accountApiHandler
@inject ITransactionApiHandler transactionApiHandler;
@inject ISeatPlanApiHandler seatplanApiHandler;
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthenticationStateProvider;
@inject Cinnamon.Framework.Providers.IJsonSerializationProvider jsonSerializationProvider
@inject ILocalStorage localStorage;
@implements IAsyncDisposable;

@if (activity is not null)
{
    @if (_isProcessing)
    {
        <div class="top-row desktop">
            <!--App Name-->
            <div class="app-name">
                <a href="/explore" class="app-name">@Resources.App.appName</a>
            </div>
            <!--Timer-->
            <div class="timer-section">
                <p class="ticket-text">Tickets Reserved in Cart for</p>
                <p class="timer-value">@RemainingTime</p>
            </div>
            <div class="secured-section">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
                    <path d="M15.0055 8.53979C14.7668 8.30113 14.4772 8.18189 14.1361 8.18189H13.7273V5.72721C13.7273 4.15905 13.1649 2.81258 12.0399 1.68758C10.9149 0.562525 9.56857 0 8.00019 0C6.43185 0 5.08525 0.562525 3.96038 1.68753C2.83533 2.81258 2.27298 4.15901 2.27298 5.72721V8.18189H1.86395C1.52316 8.18189 1.23332 8.30113 0.994661 8.53979C0.756003 8.77827 0.636719 9.0681 0.636719 9.40921V16.7728C0.636719 17.1136 0.756048 17.4035 0.994661 17.6422C1.23332 17.8806 1.52316 18 1.86395 18H14.1364C14.4775 18 14.7671 17.8808 15.0059 17.6422C15.2443 17.4035 15.3638 17.1136 15.3638 16.7728V9.40908C15.364 9.06824 15.2443 8.77845 15.0055 8.53979ZM11.2728 8.18189H4.72753V5.72721C4.72753 4.82384 5.04719 4.05248 5.68637 3.41339C6.32564 2.77421 7.09687 2.45468 8.00032 2.45468C8.90386 2.45468 9.67491 2.77416 10.3142 3.41339C10.9532 4.05244 11.2728 4.82384 11.2728 5.72721V8.18189Z" fill="#343D4C" />
                </svg>
                <p class="secure-text">Secure Checkout</p>
            </div>
        </div>
        <div class="top-row mobile">
            <div class="row-holder">
                <!--App Name-->
                <div class="app-name">
                    <a href="/explore" class="app-name">@Resources.App.appName</a>
                </div>
                <div class="secured-section">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="18" viewBox="0 0 16 18" fill="none">
                        <path d="M15.0055 8.53979C14.7668 8.30113 14.4772 8.18189 14.1361 8.18189H13.7273V5.72721C13.7273 4.15905 13.1649 2.81258 12.0399 1.68758C10.9149 0.562525 9.56857 0 8.00019 0C6.43185 0 5.08525 0.562525 3.96038 1.68753C2.83533 2.81258 2.27298 4.15901 2.27298 5.72721V8.18189H1.86395C1.52316 8.18189 1.23332 8.30113 0.994661 8.53979C0.756003 8.77827 0.636719 9.0681 0.636719 9.40921V16.7728C0.636719 17.1136 0.756048 17.4035 0.994661 17.6422C1.23332 17.8806 1.52316 18 1.86395 18H14.1364C14.4775 18 14.7671 17.8808 15.0059 17.6422C15.2443 17.4035 15.3638 17.1136 15.3638 16.7728V9.40908C15.364 9.06824 15.2443 8.77845 15.0055 8.53979ZM11.2728 8.18189H4.72753V5.72721C4.72753 4.82384 5.04719 4.05248 5.68637 3.41339C6.32564 2.77421 7.09687 2.45468 8.00032 2.45468C8.90386 2.45468 9.67491 2.77416 10.3142 3.41339C10.9532 4.05244 11.2728 4.82384 11.2728 5.72721V8.18189Z" fill="#343D4C" />
                    </svg>
                    <p class="secure-text">Secure Checkout</p>
                </div>
            </div>
            <!--Timer-->
            <div class="timer-section">
                <p class="ticket-text">Tickets Reserved in Cart for</p>
                <p class="timer-value">@RemainingTime</p>
            </div>
        </div>
        <div class="container reservation-page-section">
            <div class="row">
                <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12 ticket-column">
                    @*Event & Ticket Details*@
                    <div class="event-details-section">
                        <p class="event-name">@activity.EventName</p>
                        <p class="selected-date">Date: @SelectedDate.ToString("MMMM dd, yyyy")</p>
                        <p class="time-start">Time Start: @SelectedDate.ToString("hh:mm tt") </p>
                        @if (activity.ExperienceTypeId == 1)
                        {
                            string address = string.IsNullOrEmpty(activity.PinnedLocation) ? $"{activity.HouseNo + ", " + activity.BarangayName + ", " + activity.CityName + ", " + activity.RegionName}" : activity.PinnedLocation;
                            <p class="event-location">@address</p>
                        }
                        else
                        {
                            <p class="event-location">Online</p>
                        }
                    </div>
                    @*Event Ticekts*@
                    @if (IsOnWaitlist)
                    {
                        @*Body*@
                        <div class="waitlist-section">
                            <div class="ticket-waitlist">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <g clip-path="url(#clip0_473_881)">
                                        <path d="M10.0007 0.833374C8.18766 0.833374 6.41538 1.37099 4.90793 2.37824C3.40048 3.38548 2.22556 4.81712 1.53176 6.49211C0.837956 8.1671 0.656426 10.0102 1.01012 11.7884C1.36382 13.5665 2.23686 15.1999 3.51884 16.4819C4.80082 17.7638 6.43417 18.6369 8.21233 18.9906C9.99049 19.3443 11.8336 19.1627 13.5086 18.4689C15.1836 17.7751 16.6152 16.6002 17.6225 15.0928C18.6297 13.5853 19.1673 11.813 19.1673 10C19.1645 7.56977 18.1978 5.23986 16.4793 3.5214C14.7608 1.80293 12.4309 0.836241 10.0007 0.833374ZM13.0898 13.0892C12.9335 13.2454 12.7216 13.3332 12.5007 13.3332C12.2797 13.3332 12.0678 13.2454 11.9115 13.0892L9.41149 10.5892C9.2552 10.433 9.16737 10.221 9.16732 10V5.00004C9.16732 4.77903 9.25512 4.56707 9.4114 4.41079C9.56768 4.2545 9.77964 4.16671 10.0007 4.16671C10.2217 4.16671 10.4336 4.2545 10.5899 4.41079C10.7462 4.56707 10.834 4.77903 10.834 5.00004V9.65504L13.0898 11.9109C13.246 12.0671 13.3338 12.2791 13.3338 12.5C13.3338 12.721 13.246 12.9329 13.0898 13.0892Z" fill="#343D4C" />
                                    </g>
                                    <defs>
                                        <clipPath id="clip0_473_881">
                                            <rect width="20" height="20" fill="white" />
                                        </clipPath>
                                    </defs>
                                </svg>
                                <p class="close-text">You're on the Waitlist</p>
                            </div>
                            <p class="waitlist-sub-text">A confirmation email has been sent to <span><a class="user-email">@currentLogin.Email</a></span>. We will let you know if you are admitted.</p>
                            <p class="waitlist-sub-leave">If you can no longer join,  <span><a class="user-leave" @onclick="() => confirmDialogRef.Open()">you can leave the waitlist</a></span>.</p>
                        </div>
                    }

                    @if(IsApprovedWaitlist)
                    {
                        @*Body*@
                        <div class="waitlist-section">
                            <div class="ticket-waitlist">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <g clip-path="url(#clip0_578_514)">
                                        <path d="M10.0007 19.6666C15.3394 19.6666 19.6673 15.3387 19.6673 9.99992C19.6673 4.66117 15.3394 0.333252 10.0007 0.333252C4.6619 0.333252 0.333984 4.66117 0.333984 9.99992C0.333984 15.3387 4.6619 19.6666 10.0007 19.6666Z" fill="#4BB749" />
                                        <path d="M8.08762 14.0234L5.82095 11.8094C5.77193 11.7617 5.73295 11.7047 5.70634 11.6417C5.67973 11.5787 5.66602 11.5111 5.66602 11.4427C5.66602 11.3743 5.67973 11.3066 5.70634 11.2437C5.73295 11.1807 5.77193 11.1237 5.82095 11.076L6.57262 10.3427C6.67342 10.245 6.80827 10.1904 6.94862 10.1904C7.08897 10.1904 7.22382 10.245 7.32462 10.3427L8.67395 11.6617L12.4583 5.90836C12.5364 5.79226 12.6565 5.71108 12.7934 5.68196C12.9302 5.65285 13.073 5.6781 13.1916 5.75236L14.0863 6.31436C14.1447 6.35029 14.1953 6.39759 14.2352 6.45345C14.275 6.50932 14.3032 6.57261 14.318 6.63957C14.3329 6.70653 14.3342 6.7758 14.3218 6.84328C14.3095 6.91075 14.2837 6.97505 14.246 7.03236L9.76495 13.847C9.67516 13.9804 9.55722 14.0925 9.41943 14.1754C9.28164 14.2583 9.12736 14.3099 8.96745 14.3267C8.80754 14.3435 8.64588 14.3251 8.49387 14.2727C8.34186 14.2203 8.20319 14.1352 8.08762 14.0234Z" fill="#F3F6FC" />
                                    </g>
                                    <defs>
                                        <clipPath id="clip0_578_514">
                                            <rect width="20" height="20" fill="white" />
                                        </clipPath>
                                    </defs>
                                </svg>
                                <p class="close-text">Your request has been approved</p>
                            </div>
                            <p class="waitlist-sub-text">An approval email has been sent to <span><a class="user-email">@currentLogin.Email</a></span>. Check your email to proceed purchasing your tickets.</p>
                        </div>
                    }

                    @*Not on waitlist*@
                    @if(activity.Schedule.IsOpen && !IsApprovedWaitlist || !IsOnWaitlist)
                    {
                        <div class="ticket-event-section">
                            <p class="ticket-section">Select seat for your tickets</p>
                            <div class="ticket-box">
                                <Cinnamon.Web.Components.Common.SeatPlan.Container Payload="@selectedPayload" OnSeatSelected="HandleSeatSelection" ViewOnly="viewOnly"/>
                            </div>
                    

                            <div class="ticket-options">
                                <div class="ticket-names">
                                    @foreach (var item in AvailablePriceList)
                                    {
                                        <div class="ticket-info" style="cursor: pointer;" @onclick="() => HandleClick(FormatId(item.Name))">
                                            <div class="ticket-color" style="width: 20px;height: 20px;background-color:@item.TicketColor;border-radius: 50%;"></div>
                                            <div class="ticket-name">@item.Name</div>
                                        </div>
                                    }
                                </div>

                                @if (selectedTickets.Count != 0)
                                {
                                    @if (activity.Schedule.IsCapacity && activity.IsEventSoldOut && selectedTickets.Count <= capacityLimit && !selectedTickets.First().Value.IsUnlimited)
                                    {
                                        <button class="btn-confirm" @onclick=JoinWaitlist disabled="@isLoading">
                                            @if (isLoading)
                                            {
                                                <div class="spinner-border spinner-border-sm" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>Join Waitlist</span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-confirm" @onclick=ProceedToPayment disabled="@isLoading">
                                            @if (isLoading)
                                            {
                                                <div class="spinner-border spinner-border-sm" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>Confirm Seats</span>
                                            }
                                        </button>
                                    }
                                }
                                else
                                {
                                    <button class="btn-confirm" @onclick=ProceedToPayment disabled="@isLoading">
                                        @if (isLoading)
                                        {
                                            <div class="spinner-border spinner-border-sm" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span>Confirm Seats</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    }


                    @if(!activity.Schedule.IsOpen){
                        <div class="waitlist-section">
                            <div class="ticket-close">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M12 23c6.075 0 11-4.925 11-11S18.075 1 12 1 1 5.925 1 12s4.925 11 11 11M7 10a2 2 0 1 0 0 4h10a2 2 0 1 0 0-4z"></path></svg>
                                <p class="close-text">Ticket Sales Closed</p>
                            </div>
                            <p class="close-sub-text">This event is not currently selling tickets. You may contact the host to receive updates.</p>
                        </div>
                    }
                    
                    @*Event Seat Plan*@
                    @if (!string.IsNullOrEmpty(SetPlanImage))
                    {
                        <div id="set-plan" class="mt-4 seat-plan-section">
                            <p class="event-seat-plan">Seat Plan</p>
                            <img class="img-seat-plan" src="@SetPlanImage" @onclick="() => imageViewer.ShowModal()" alt="seatplan">
                        </div>
                    }
                </div>
                @*Calculator*@
                <div class="col-xl-4 col-lg-4 col-md-5 col-sm-12 col-12 calculator-column">
                    <div class="booking-total-container">
                        <div class="payment-summary-section">
                            <p class="header">Payment Summary</p>
                            <Divider />
                            @*Tickets*@
                            <div class="selected-ticket-name">
                                @if (selectedTickets.Count > 0)
                                {
                                    @foreach (var item in selectedTickets)
                                    {
                                        <div class="selected-tickets-section">
                                            <p class="ticket-name">
                                                @item.Value.Name <span class="ticket-name-price">@($"(x{item.Value.Count})")</span>
                                            </p>
                                            <p class="ticket-total-price">
                                                &#8369; @((item.Value.Price * item.Value.Count).ToString("#,##0.00"))
                                            </p>
                                        </div>
                                    }
                                }
                            </div>
                            @*Service Fee*@
                            <div class="selected-tickets-section">
                                <p class="ticket-name">Service fee</p>
                                <p class="ticket-total-price">
                                    @(string.IsNullOrEmpty(SelectedPaymentCode) ? "Depends on payment method" : "&#8369; " + GetConvinienceFee.ToString("#,##0.00"))
                                </p>
                            </div>
                            @*Handling Fee*@
                            @if (!IsInclusivePricing)
                            {
                                <div class="selected-tickets-section">
                                    <div class="d-flex gap-1">
                                        <p class="ticket-name">Handling fee (2%)</p>
                                        <CustomTooltip MarginLeft="0">
                                            <TextContent>
                                                <span class="rounded-circle service-fee-info">i</span>
                                            </TextContent>
                                            <TooltipContent>
                                                <span class="color-grey-100">
                                                    This helps Cinnamon run its services and protects your payment in case the experience provider does
                                                    something illegal or against our policy. They won't get paid until after the sessions or work have been done.
                                                </span>
                                            </TooltipContent>
                                        </CustomTooltip>
                                    </div>
                                    <p class="ticket-total-price">
                                        &#8369; @(GetServiceFee.ToString("#,##0.00"))
                                    </p>
                                </div>
                            }
                            @*Apply Credits*@
                            <div class="selected-tickets-section">
                                <p class="apply-credits">Apply credits</p>
                                <p class="ticket-total-price">&#8369; @(GetTotalCredit.ToString("#,##0.00"))</p>
                            </div>
                            <Divider />
                            @*Total Payment*@
                            <div class="selected-tickets-section">
                                <p class="total-header">Total Payment</p>
                                <p class="total-header">&#8369; @(GetTotalPrice.ToString("#,##0.00"))</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <Footer></Footer>
        <div class='mobile-calculator-wrapper'>
            <div class="mobile-calculator-wrapper-container border-radius-10 mobile-footer-shadow
                position-fixed left-0 right-0 bg-white-100">
                <div>
                    <div class="p-3 d-flex justify-content-between align-items-center">
                        <Button Type="ButtonType.Button" Clicked="ProceedToPayment" Disabled="DisableProceed || submitting" Loading="submitting"
                                class="btn-primary font-14 border-radius-10 px-4"
                        Border="Border.Is0">
                            <LoadingTemplate>
                                <i id="spinner-loading-upload" class="fa fa-spinner fa-spin"></i> Please wait
                            </LoadingTemplate>
                            <ChildContent>
                                <span class="btn-confirm-text">Confirm seats</span>
                            </ChildContent>
                        </Button>
                        <div class="d-flex align-items-center">
                            <div class="prevent-select text-end" style="width: 160px;">
                                <span class="font-20 font-weight-700 color-black-100 total-price" tabindex="-1">₱ @(GetTotalPrice.ToString("#,##0.00"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container queuing-page-section">
            <div class="modal-queue">
                    <div class="header-queue">
                        <img class="img-queue-logo" src="/images/ote/cinnamon-logo.svg" alt="img-queue-logo" />
                        <img class="img-queue" src="images/ote/queue.svg" alt="img-queue" />
                    </div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width:@(CalculateProgress())%" aria-valuenow="@(CalculateProgress())%" aria-valuemin="0" aria-valuemax="100">@(CalculateProgress())%</div>
                     </div>
                    <div class="note-text">
                        <p class="user-overloaded">Unfortunately, our system is currently overloaded with requests, preventing us from adding you to the queue at this time.</p>
                        <br />
                        <p class="user-overloaded">Queue Id: @queueInfo.QueueId</p>
                        <br />
                        <p class="user-overloaded">You can close this page without losing your place in line.</p>
                    </div>
                    <div class="queuing-info">
                        <div class="info-box">
                            <p class="user-overloaded">Expected time of arrival for tickets sales:</p>
                            <p class="queing-value">@queueInfo.ExpectedTimeArrival.ToString("hh:mm tt")</p>
                        </div>
                        <div class="info-box">
                            <p class="user-overloaded">Estimated wait time is:</p>
                            <p class="queing-value">@queueInfo.EstimatedWaitingTime minutes</p>
                        </div>
                        <div class="info-box">
                            <p class="user-overloaded">Number of users in line ahead of you:</p>
                            <p class="queing-value">@queueInfo.UsersAhead</p>
                        </div>
                        <div class="info-box">
                            <p class="user-overloaded">Status last updated:</p>
                            <p class="queing-value">@queueInfo.LastUpdated.ToString("hh:mm:ss tt")</p>
                        </div> 
                    </div>
                </div>
        </div>
    }
<Modal @ref="modalRef">
        <ModalContent Centered>
            <ModalBody>
                <div class="queue-up d-flex">
                    <img class="img-logo" src="images/ote/ticket-queue.svg" />
                    <div class="queue-up-text">
                        <p class="logo">Cinnamon.ph</p>
                        <p>You're up! It's your turn to buy tickets. </p>
                    </div
                </div>
                <Progress>
                    <ProgressBar Color="Color.Success" Value="100" />
                </Progress>
                <p class="congratulations-text">Congratulations! You're almost there. Please proceed to the next step to finalize your order and secure your tickets.</p>
                <button class="btn-continue" @onclick="HideModal">Continue</button>
            </ModalBody>
        </ModalContent>
    </Modal>
<Modal @ref="modalQuestions">
    <ModalContent Centered class="border-radius-15">
        <ModalHeader class="justify-content-center pb-0">
            <div>
                <p class="font-20 font-weight-700 color-black-100 mb-0 text-center">Registration</p>
                <p class="font-16 color-grey-100 mt-1 text-center">Please fill up some questions to complete your registration</p>
            </div>
        </ModalHeader>
        <ModalBody class="px-4">
            <Validations @ref="predefinedQuestionValidation" Mode="ValidationMode.Manual" Model="predefinedQuestion">
                @if (predefinedQuestion.HaveNameQuestion)
                {
                    @if (predefinedQuestion.RequiredNameQuestion)
                    {
                        <Validation>
                            <Field class="mb-3">
                                <FieldLabel class="color-black-100 mb-0"><span class="asterisk-symbol">&lowast;</span>Name</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Text="predefinedQuestion.NameAnswer" Placeholder="Your Name">
                                        <ValidationError />
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    }
                    else
                    {
                        <Field class="mb-3">
                            <FieldLabel class="color-black-100 mb-0">Name</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="predefinedQuestion.NameAnswer" Placeholder="Your Name" />
                            </FieldBody>
                        </Field>
                    }
                }

                @if (predefinedQuestion.HaveEmailQuestion)
                {
                    @if (predefinedQuestion.RequiredEmailQuestion)
                    {
                        <Validation>
                            <Field class="mb-3">
                                <FieldLabel class="color-black-100 mb-0"><span class="asterisk-symbol">&lowast;</span>Email</FieldLabel>
                                <FieldBody>
                                    <TextEdit Role="TextRole.Email" @bind-Text="predefinedQuestion.EmailAnswer" Placeholder="Your Email">
                                        <ValidationError />
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    }
                    else
                    {
                        <Field class="mb-3">
                            <FieldLabel class="color-black-100 mb-0">Email</FieldLabel>
                            <FieldBody>
                                <TextEdit Role="TextRole.Email" @bind-Text="predefinedQuestion.EmailAnswer" Placeholder="Your Email" />
                            </FieldBody>
                        </Field>
                    }
                }

                @if (predefinedQuestion.HavePhoneQuestion)
                {
                    @if (predefinedQuestion.RequiredPhoneQuestion || string.IsNullOrEmpty(predefinedQuestion.PhoneAnswer))
                    {
                        <Validation>
                            <Field class="mb-3">
                                <FieldLabel class="color-black-100 mb-0"><span class="asterisk-symbol">&lowast;</span>Contact Number</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Text="predefinedQuestion.PhoneAnswer" Placeholder="Your Contact Number">
                                        <ValidationError />
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    }
                    else
                    {
                        <Field class="mb-3">
                            <FieldLabel class="color-black-100 mb-0">Contact Number</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="predefinedQuestion.PhoneAnswer" Placeholder="Your Contact Number" />
                            </FieldBody>
                        </Field>
                    }
                }
            </Validations>
            <Validations @ref="questionValidation" Mode="ValidationMode.Manual" Model="filteredQuestions">
                @foreach (var question in filteredQuestions)
                {
                    if (question.Required)
                    {
                        <Validation>
                            <Field class="mb-3">

    private async Task LoadProfile()
    {
        ticketCount = 0;
        if (!string.IsNullOrEmpty(Token))
        {
            var profileResult = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, Token);
            if (profileResult.Succeeded || profileResult.Result is not null && profileResult.Result.IsSuccess)
            {
                currentLogin = mapper.Map<Models.Entities.CustomerProfile>(profileResult.Result.Result);
            }
            //Get the number of ticket purchased in this event
            var ticketPurchase = await activityHandler.CustomerOte(token);
            if (ticketPurchase.Succeeded && ticketPurchase.Result is not null && ticketPurchase.Result.IsSuccess)
            {
                otesItems = ticketPurchase.Result.Result.Where(a => a.ActivityId == activity.Id).Select(t =>
                {
                    return new TicketItem
                        {
                            EventName = t.EventTitle,
                            PurchaseOrderId = t.PurchaseOrderId
                        };
                });
                foreach (var item in otesItems)
                {
                    var count = await transactionApiHandler.GetOtePurchaseOrder(item.PurchaseOrderId, token);
                    if (count.Succeeded && count.Result is not null && count.Result.IsSuccess)
                    {
                        ticketCount += count.Result.Result.Tickets.Count();
                    }
                }
                ticketCount = activity.Schedule.EventTicketLimit > 0 ? activity.Schedule.EventTicketLimit - ticketCount : 0;
            }
        }
    }

    private bool HavePredefinedQuestion(string question)
    {
        var predefinedQuestion = activityQuestions.FirstOrDefault(q => q.Question == question);
        return predefinedQuestion is not null;
    }

    private bool RequiredPredeinedQuestion(string question)
    {
        var predefinedQuestion = activityQuestions.FirstOrDefault(q => q.Question == question);
        return predefinedQuestion is not null && predefinedQuestion.Required;
    }

    private Task LoadPredefinedQuestions()
    {
        predefinedQuestion.HaveNameQuestion = HavePredefinedQuestion(predefinedQuestion.NameQuestion);
        predefinedQuestion.HaveEmailQuestion = HavePredefinedQuestion(predefinedQuestion.EmailQuestion);
        predefinedQuestion.HavePhoneQuestion = HavePredefinedQuestion(predefinedQuestion.PhoneQuestion);

        predefinedQuestion.RequiredNameQuestion = RequiredPredeinedQuestion(predefinedQuestion.NameQuestion);
        predefinedQuestion.RequiredEmailQuestion = RequiredPredeinedQuestion(predefinedQuestion.EmailQuestion);
        predefinedQuestion.RequiredPhoneQuestion = RequiredPredeinedQuestion(predefinedQuestion.PhoneQuestion);

        return Task.CompletedTask;
    }

    private IEnumerable<ActivityQuestion> GetQuestions()
    {
        var questions = new List<ActivityQuestion>();

        if (predefinedQuestion.HaveNameQuestion)
        {
            questions.Add(new ActivityQuestion
                {
                    Id = 0,
                    Answer = predefinedQuestion.NameAnswer,
                    Question = "Name",
                });
        }

        if (predefinedQuestion.HaveEmailQuestion)
        {
            questions.Add(new ActivityQuestion
                {
                    Id = 0,
                    Answer = predefinedQuestion.EmailAnswer,
                    Question = "Email",
                });
        }

        if (predefinedQuestion.HavePhoneQuestion)
        {
            questions.Add(new ActivityQuestion
                {
                    Id = 0,
                    Answer = predefinedQuestion.PhoneAnswer,
                    Question = "Phone",
                });
        }

        questions.AddRange(filteredQuestions.Select(q => new ActivityQuestion
            {
                Id = q.Id,
                Answer = q.Answer,
                Question = q.Question,
                Required = q.Required
            }));

        return questions;
    }


    private async Task LoadWaitlist()
    {
        //0-NO STATUS 1-PENDING 2-APPROVED 3-DECLINED
        //Get pending and approved
        var waitlist = await activityHandler.GetOteWaitlistByProvider(new Framework.ApiCommand.ApiCore.Activity.Request.GetOteWaitlistByProviderArgs
            {
                ProviderId = provider.Id,
                ActivityId = activity.Id,
                Status = new[] { 1, 2 }
            }, token);
        if (waitlist.Succeeded && waitlist.Result is not null && waitlist.Result.IsSuccess)
        {
            oteWaitlists = waitlist.Result.Result.Select(s =>
            {
                return new OteWaitlist
                {
                    Id         = s.Id,
                    Status     = s.Status,
                    CustomerId = s.CustomerId,
                    Payload    = s.Payload,
                    Type       = s.Type
                };
            }).ToList();
        }

        //Pending Waitlist
        IsOnWaitlist = oteWaitlists.Any(a => a.CustomerId == currentLogin.Id && a.Status == 1);
        var oteWaitlistDTOs = oteWaitlists.Where(a => a.CustomerId == currentLogin.Id && a.Status == 1);
        foreach (var item in oteWaitlistDTOs)
        {
            WaitlistIds.Add(item.Id);
        }
        //Approved Waitlist
        IsApprovedWaitlist = oteWaitlists.Any(a => a.CustomerId == currentLogin.Id && a.Status == 2);
        var oteApprovedWaitlistDTOs = oteWaitlists.Where(a => a.CustomerId == currentLogin.Id && a.Status == 2);
        foreach (var item in oteApprovedWaitlistDTOs)
        {
            ApprovedWaitlistIds.Add(item.Id);
        }

        //Check capacity limit
        if (activity.IsEventSoldOut)
        {
            capacityLimit = activity.Schedule.CapacityCount - oteWaitlists.Count;
        }
    }
    private async Task RemoveFromWaitlist()
    {
        bool allSucceeded = true;
        foreach (var waitlistId in WaitlistIds)
        {
            var removeWaitlist = await activityHandler.DeleteOteWaitlist(new Framework.ApiCommand.ApiCore.Activity.Request.DeleteOteWaitlistArgs
                {
                    Id = waitlistId
                }, token);

            if (!(removeWaitlist.Succeeded && removeWaitlist.Result is not null && removeWaitlist.Result.IsSuccess))
            {
                allSucceeded = false;
            }
        }
        if (allSucceeded)
        {
            //Add Email
            WaitlistIds.Clear();
            await LoadWaitlist();
            await NotificationService.Success("You're removed from the waitlist.", "Success");
        }
        else
        {
            await NotificationService.Error("Failed to remove one or more items from waitlist.", "Error");
        }
    }

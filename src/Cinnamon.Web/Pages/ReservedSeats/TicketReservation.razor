    private async Task SubmitAnswerQuestions()
    {
        var validForms = await questionValidation?.ValidateAll();
        var validPredefined = await predefinedQuestionValidation?.ValidateAll();
        if (!validForms || !validPredefined) return;

        await questionValidation.ClearAll();
        await predefinedQuestionValidation.ClearAll();

        await modalQuestions?.Close(CloseReason.UserClosing);

        bool proceedToWaitList = activity.Schedule.IsCapacity && activity.IsEventSoldOut && selectedTickets.Count <= capacityLimit && !selectedTickets.First().Value.IsUnlimited;

        bool freeWithApproval = selectedTickets.Any(t => t.Value.IsFree && t.Value.RequiredApproval);

        bool isFreeWithoutApproval = selectedTickets.Any(t => t.Value.IsFree && !t.Value.RequiredApproval);

        bool paidWithApproval = selectedTickets.Any(t => !t.Value.IsFree && t.Value.RequiredApproval);

        if(proceedToWaitList || paidWithApproval)
        {
            await ProceedToJoinWaitlist();
            return;
        }

        if (isFreeWithoutApproval || freeWithApproval)
        {
            await ProceedToFreePurchase();
            return;
        }

        await ProceedToPaymentOption();
    }

    private async Task<PaymentTracker> CreatePaymentTracker(string guid = "", string webToken = "")
    {
        var question = GetQuestions();

        var requestPaymentRes = await transactionApiHandler.PaymentRequest(new Framework.ApiCommand.ApiCore.Transaction.Request.PaymentRequestArgs
            {
                ActivityId = activity.Id,
                Guid = guid,
                Token = webToken,
                SelectedDate = SelectedDate,
                SelectedTickets = selectedTickets.Select(t => new Framework.ApiCommand.ApiCore.Transaction.Request.PaymentRequestArgs.RequestPaymentTicket
                {
                    TicketCount = t.Value.Count,
                    TicketId = t.Value.Id
                }),
                Questions = question.Select(q => new Framework.ApiCommand.ApiCore.Transaction.Request.PaymentRequestArgs.ProviderQuestion
                {
                    Answer = q.Answer,
                    Question = q.Question,
                    Id = q.Id
                })
            }, token);
        if (!requestPaymentRes.Succeeded || requestPaymentRes.Result is null || !requestPaymentRes.Result.IsSuccess)
        {
            return null;
        }
        var requestedToken = requestPaymentRes.Result.Result;

        return new PaymentTracker
            {
                Guid = requestedToken.Guid,
                Token = requestedToken.Token
            };
    }

    private async Task ProceedToPaymentOption()
    {
        submitting = true;
        StateHasChanged();

        string guid = string.Empty, webToken = string.Empty;

        var getTracker = await localStorage.GetItem<PaymentTracker>(TRACKER_ID);
        if (getTracker is not null)
        {
            guid = getTracker.Guid;
            webToken = getTracker.Token;
        }

        var createTracker = await CreatePaymentTracker(guid, webToken);
        if (createTracker is null)
        {
            await NotificationService.Error("An error occured. Please contact support.", "Error");
            return;
        }

        await TrackPaymentRequest(createTracker);

        submitting = false;
        StateHasChanged();

        string paymentUrl = $"/payment/ote/reserved/{Handler}/?guid={createTracker.Guid}&token={createTracker.Token}";

        NavigationManager.NavigateTo(paymentUrl);
    }

    private async Task ProceedToFreePurchase()
    {
        try
        {
            submitting = true;
            StateHasChanged();

            var createTracker = await CreatePaymentTracker();
            if (createTracker is null)
            {
                await NotificationService.Error("An error occured. Please contact support.", "Error");
                return;
            }

            var questions = GetQuestions();

            var submitFreePurchase = await transactionApiHandler.SubmitOtePurchaseOrder(new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs
                {
                    ActivityId = activity.Id,
                    CardInformation = null,
                    CouponCode = string.Empty,
                    IsCreditsApplied = false,
                    PaymentMethod = "GCASH", // default to ewallet even without any payment method selected
                    PaymentChannel = "EWALLET",
                    Tickets = selectedTickets.Select(t => new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.OTeTicket
                    {
                        Count = t.Value.Count,
                        Id = t.Value.Id
                    }),
                    Questions = questions.Select(q => new Framework.ApiCommand.ApiCore.Transaction.Request.SubmitOtePurchaseOrderArgs.ActivityQuestion
                    {
                        Answer = q.Answer,
                        Id = q.Id,
                        Question = q.Question
                    }),
                    Guid = createTracker.Guid,
                    Token = createTracker.Token
                }, token);

            submitting = false;

            if (!submitFreePurchase.Succeeded || submitFreePurchase.Result is null || !submitFreePurchase.Result.IsSuccess)
            {
                await NotificationService.Error(submitFreePurchase.Result?.ErrorInfo?.Message ?? submitFreePurchase.Message, "Error");
                return;
            }

            await ClearAnswers();

            var haveApprovalTicket = selectedTickets.Any(t => t.Value.Price == 0 && t.Value.RequiredApproval);

            if (haveApprovalTicket)
            {
                await modalPurchaseWithConfirmation?.Show();
            }
            else
            {
                await modalPurchaseWithoutConfirmation?.Show();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("An error occured. Contact Cinnamon support.", "Error");
        }
    }

     private Task ClearAnswers()
    {  
        predefinedQuestion.NameAnswer = string.Empty;
        predefinedQuestion.EmailAnswer = string.Empty;
        predefinedQuestion.PhoneAnswer = string.Empty;

        foreach (var item in activityQuestions)
        {
            item.Answer = string.Empty;
        }
        return Task.CompletedTask;
    }

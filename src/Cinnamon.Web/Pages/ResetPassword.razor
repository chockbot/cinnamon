@page "/verify-reset-password"
@using Cinnamon.Web.Models.Account;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject NavigationManager NavigationManager;
@inject IAccountApiHandler accountApiHandler;
@inject IJSRuntime jsRuntime

<div class="container">
    <div class="">
        <div class="title">
            <p id="external-login-title">Confirm New Password</p>
        </div>
        <Validations Mode="ValidationMode.Manual" @ref="Model.FormValidation" Model="Model.Model">
            <p class="sub-info">Please enter your new password, check it carefully.</p>
            <Validation>
                    <Field>
                        <FieldLabel>New Password</FieldLabel>
                        <div class="password-content">
                            <TextEdit KeyDown="OnNewPasswordTextSubmit" @ref="Model.TextNewPassword" 
                                Role="Model.IsRevealNewPassword ? TextRole.Text : TextRole.Password" 
                                Placeholder="Password" @bind-Text="Model.Model.NewPassword" class="input-password">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                            <span class="fa fa-fw fa-eye field-icon toggle-password" 
                                @onclick="() => Model.IsRevealNewPassword = !Model.IsRevealNewPassword"></span>
                        </div>
                    </Field>
            </Validation>
            <Validation>
                <Field>
                    <FieldLabel>Confirm New Password</FieldLabel>
                    <div class="password-content">
                        <TextEdit KeyDown="OnConfirmPasswordTextSubmit" @ref="Model.TextConfirmPassword" 
                            Role="Model.IsRevealConfirmPassword ? TextRole.Text : TextRole.Password" 
                            Placeholder="Confirm Password" @bind-Text="Model.Model.ConfirmPassword" class="input-password">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                        <span class="fa fa-fw fa-eye field-icon toggle-password" 
                            @onclick="() => Model.IsRevealConfirmPassword = !Model.IsRevealConfirmPassword"></span>
                    </div>
                </Field>
            </Validation>
            <div>
                <Button Clicked="SubmitResetChangePassword" Shadow="Shadow.Small" class="btn-primary"
                        Disabled="Model.IsSubmittingResetPassword" 
                        Loading="Model.IsSubmittingResetPassword">
                    <LoadingTemplate>
                        <i class="fa fa-spinner fa-spin"></i> Please Wait
                    </LoadingTemplate>
                    <ChildContent>
                        Confirm
                    </ChildContent>
                </Button>
                <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="Model.IsShowErrorMessage">
                    <AlertDescription>@Model.Message</AlertDescription>
                </Alert>
                <Alert Color="Color.Success" Margin="Margin.Is3.FromTop" Visible="Model.IsShowSuccessMessage">
                    <AlertDescription>@Model.Message</AlertDescription>
                </Alert>
            </div>
        </Validations>
    </div>
</div>

@code
{
    private ResetPasswordModel Model { get; set; } = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? UserId { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(UserId))
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }
    }

    private async Task SubmitResetChangePassword()
    {
        try
        {
            if (await Model.FormValidation.ValidateAll())
            {
                Model.IsSubmittingResetPassword = true;

                var result = await accountApiHandler.VerifyResetPassword(new Framework.ApiCommand.ApiCore.Account.Request.VerifyResetPasswordArgs {
                    Guid = UserId ?? string.Empty,
                    NewPassword = Model.Model.NewPassword,
                    Token = Token ?? string.Empty
                });
                Model.IsSubmittingResetPassword = false;

                if (!result.Succeeded || result.Result == null || !result.Result.IsSuccess)
                {
                    var errorMessage = result.Result?.ErrorInfo?.Message ?? result.Message;
                    if(errorMessage.Equals("Invalid token provided.",StringComparison.CurrentCultureIgnoreCase))
                    {
                        Model.Message = "Verification url already expired or already in used.";
                    }
                    else
                    {
                        Model.Message = "An error occured. Please try again later";
                    }
                    Model.IsShowErrorMessage = true;
                }
                else
                {
                    Model.Message = "Successfuly update your password. Will automatically redirect to explore page after 3 seconds.";
                    Model.IsShowSuccessMessage = true;
                    StateHasChanged();

                    await Task.Delay(3000);
                    NavigationManager.NavigateTo("/explore");
                }
            }
        }
        catch
        {
            Model.Message = "An error occured. Please try again later";
            Model.IsShowErrorMessage = true;
        }
    }

    private Task OnNewPasswordTextSubmit(KeyboardEventArgs e)
    {
        if(e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            if(string.IsNullOrEmpty(Model.Model.ConfirmPassword))
            {
                Model.TextConfirmPassword.Focus();
            }
            else 
            {
                return SubmitResetChangePassword();
            }
        }

        return Task.CompletedTask;
    }

    private Task OnConfirmPasswordTextSubmit(KeyboardEventArgs e)
    {
        if(e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            return SubmitResetChangePassword();
        }

        return Task.CompletedTask;
    }
}
@page "/reset-password"
@using Cinnamon.Web.Models.Account;
@using Cinnamon.Web.Modules.ApiAccess.Handlers;
@inject NavigationManager NavigationManager;
@inject IAccountApiHandler accountApiHandler;
@inject IJSRuntime jsRuntime

<div class="container">
    <div class="">
        <div class="title">
            <p id="external-login-title">Confirm New Password</p>
        </div>
        <Validations Mode="ValidationMode.Manual" @ref="Model.FormValidation" Model="Model.Model">
@*            <Validation>
                <Field>
                    <FieldLabel>Email Address</FieldLabel>
                    <TextEdit Disabled Role="TextRole.Email" Placeholder="your email" @bind-Text="Model.Model.Email">
                        <Feedback>
                            <ValidationError />
                        </Feedback>
                    </TextEdit>  
                </Field>
            </Validation>*@

            <p class="sub-info">Please enter your new password, check it carefully.</p>
         
            <Validation>
                    <Field>
                    <FieldLabel>New Password</FieldLabel>

                       <div class="password-content">
                        <TextEdit Role="TextRole.Password" Placeholder="Password" @bind-Text="Model.Model.Password" class="input-password">
                        <Feedback>
                            <ValidationError />
                        </Feedback>
                    </TextEdit>
                        <span class="fa fa-fw fa-eye field-icon toggle-password"></span>
                       </div>
                </Field>
            </Validation>


            <Validation>
                <Field>
                    <FieldLabel>Confirm New Password</FieldLabel>

                    <div class="password-content">
                        <TextEdit Role="TextRole.Password" Placeholder="Confirm Password" @bind-Text="Model.Model.Password" class="input-password">
                            <Feedback>
                                <ValidationError />
                            </Feedback>
                        </TextEdit>
                        <span class="fa fa-fw fa-eye field-icon toggle-password"></span>
                    </div>
                </Field>
            </Validation>


            <div>
            <Button Clicked="SubmitRegiter" Shadow="Shadow.Small" class="btn-primary"
                    Disabled="Model.IsSubmitting" Loading="Model.IsSubmitting">
                <LoadingTemplate>
                    <i class="fa fa-spinner fa-spin"></i> Please Wait
                </LoadingTemplate>
                <ChildContent>
                    Confirm
                </ChildContent>
            </Button>
            <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop" Visible="Model.IsShowErrorMessage">
                <AlertDescription>@Model.ErrorMessage</AlertDescription>
            </Alert>
            </div>
        </Validations>
    </div>
</div>

@code
{
    private ExternalRegisterModel Model { get; set; } = new();

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public string? Uid { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Uid))
        {
            NavigationManager.NavigateTo("/explore");
            return;
        }

        try
        {
            var result = await accountApiHandler.GetExternalLoginDetail(Token, Uid);
            if (!result.Succeeded || result.Result == null || !result.Result.IsSuccess)
            {
                NavigationManager.NavigateTo("/explore");
                return;
            }

            Model.Model.Email = result.Result.Result.Email;
            Model.Model.FirstName = result.Result.Result.FirstName;
            Model.Model.LastName = result.Result.Result.LastName;
        }
        catch
        {
            Model.ErrorMessage = "An error occured. Please try again later";
            Model.IsShowErrorMessage = true;
        }
    }

    private async Task SubmitRegiter()
    {
        try
        {
            if (await Model.FormValidation.ValidateAll())
            {
                Model.IsSubmitting = true;

                var result = await jsRuntime.InvokeAsync<Models.JsResultModel>
                        ("MyLib.Pages.customer.externalRegister.init",
                            new
                            {
                                firstname = Model.Model.FirstName,
                                lastname = Model.Model.LastName,
                                email = Model.Model.Email,
                                birthdate = Model.Model.Birthdate,
                                password = Model.Model.Password,
                                token = Token,
                                guid = Uid
                            });

                Model.IsSubmitting = false;

                if (!result.Success)
                {
                    Model.ErrorMessage = result.Message;
                    Model.IsShowErrorMessage = true;
                    return;
                }

                NavigationManager.NavigateTo("/explore", true);
            }
        }
        catch
        {
            Model.ErrorMessage = "An error occured. Please try again later";
            Model.IsShowErrorMessage = true;
        }
    }
}
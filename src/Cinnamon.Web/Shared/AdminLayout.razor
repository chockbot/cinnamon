@using Cinnamon.Web.Models.Layout;
@using System.Security.Claims;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager navigationManager
@inherits LayoutComponentBase


<Layout Sider class="dashboard-layout">
    <input type='checkbox' id='toggle' @bind="IsShowSidebar" />
    <LayoutSider @onclick="() => IsShowSidebar = !IsShowSidebar" class="min-vh-100">
        <LayoutSiderContent>
            @if (Model.IsAuthenticated)
            {
                <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                    <li class="nav-item">
                        <div class="nav-link item-link sidebar-header">
                            <label for='toggle' class='close'><img src="images/Dashboard Icon/close.png" class="close-icon"></label>
                            <a href="Explore" class="d-flex align-items-center  text-white text-decoration-none">
                                <span class="app-name" id="angelo">@Resources.App.appName</span>
                            </a>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link" @onclick="NavigateToUsers">
                            <img class="icon-home" src="images/Dashboard Icon/users-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Users</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link" @onclick="NavigateToExperiences">
                            <img class="icon-home" src="images/Dashboard Icon/experience-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Experiences</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToRefunds">
                            <img class="icon-home" src="images/Dashboard Icon/refund-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Refunds</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToBadges">
                            <img class="icon-home" src="images/Dashboard Icon/badges-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Badges</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToPricing">
                            <img class="icon-home" src="images/Dashboard Icon/pricing-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Pricing</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToInclusiveTransaction">
                            <img class="icon-home" src="images/Dashboard Icon/transactions-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Transactions</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToCoupons">
                            <img class="icon-home" src="images/Dashboard Icon/coupons-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Coupons</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToDisbursements">
                            <img class="icon-home" src="images/Dashboard Icon/disbursements-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Disbursements</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToAnnouncements">
                            <img class="icon-home" src="images/Dashboard Icon/announcements-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Announcements</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToDynamicContents">
                            <img class="icon-home" src="images/Dashboard Icon/dynamic-policies-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Dynamic Policies</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link" @onclick="NavigateToSeatPlan">
                            <img class="icon-home" src="images/Dashboard Icon/dynamic-policies-admin-new.svg"> <span class="ms-1 d-sm-inline nav-text">Seat Plan</span>
                        </a>
                    </li>
                </ul>
            }
        </LayoutSiderContent>
    </LayoutSider>
    <Layout>
        <LayoutContent>
            <Container Fluid>
                <div class="mt-5 d-block d-md-none">
                    <a href="/explore" class="text-white text-decoration-none">
                        <span class="app-name-mobile">Cinnamon</span>
                    </a>
                    <div class="mt-1">
                        <label for='toggle' class='hamburger me-3'>
                            <img src="images/Dashboard Icon/hamburger.png" class="toggle-icon">
                        </label>
                    </div>
                </div>
                <div class="render-body px-0 px-md-3 overflow-hidden">
                    @Body
                </div>
            </Container>
        </LayoutContent>
    </Layout>
</Layout>

@code {
    private bool IsShowSidebar { get; set; } = false;
    private HeaderModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (user.Identity != null && user.Identity.IsAuthenticated && token != null)
        {
            Model.IsAuthenticated = true;
        }
    }

    private void NavigateToUsers()
    {
        navigationManager.NavigateTo("/admin/users");
    }

    private void NavigateToExperiences()
    {
        navigationManager.NavigateTo("/admin/experiences");
    }

    private void NavigateToRefunds()
    {
        navigationManager.NavigateTo("/admin/refunds");
    }
    private void NavigateToBadges()
    {
        navigationManager.NavigateTo("/admin/badges");
    }

    private void NavigateToPricing()
    {
        navigationManager.NavigateTo("/admin/pricing");
    }

    private void NavigateToInclusiveTransaction()
    {
        navigationManager.NavigateTo("/admin/inclusive-transactions");
    }
    
    private void NavigateToCoupons()
    {
        navigationManager.NavigateTo("/admin/coupons");
    }

    private void NavigateToAnnouncements()
    {
        navigationManager.NavigateTo("/admin/announcements");
    }

    private void NavigateToDisbursements()
    {
        navigationManager.NavigateTo("/admin/disbursements");
    }

    private void NavigateToDynamicContents()
    {
        navigationManager.NavigateTo("/admin/dynamic-contents");
    }

    private void NavigateToSeatPlan()
    {
        navigationManager.NavigateTo("/admin/seat-plan");
    }
}

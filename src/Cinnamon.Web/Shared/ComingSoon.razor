@layout DashboardLayout
@page "/maker/dashboard/coming-soon"
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!--Bootstrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
</head>
<body>
    <div class="container container-fluid">
        <div class="row d-flex justify-content-center">
            <div class="row justify-content-center">
                <div class="col-sm-6 text-center">
                    <img src="images/Missing/building-on-it.svg" class="img-coming-soon img-fluid">
                </div>
            </div>
            <p class="coming-soon-caption">We’re building on it, come back soon.</p>
            <p class="mini-caption">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
            <button class="btn-primary btn-go-home" @onclick="NavigateToExplorePage">
                Go Home
            </button>
        </div>

    </div>


</body>
</html>

@code {
    private void NavigateToExplorePage()
    {
        NavigationManager.NavigateTo("explore");
    }
}

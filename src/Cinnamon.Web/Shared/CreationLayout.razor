@inherits LayoutComponentBase
@inject NavigationManager navigationManager
<PageTitle>Cinnamon</PageTitle>

<div class="page">
    <main>
        <div class="top-row px-3">
            <div class="app-name col-lg-3 col-md-2">
                <a class="app-name" @onclick="()=>OnClickLogo()">@Resources.App.appName</a>
            </div>
        </div>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code{
    private void OnClickLogo(){
        navigationManager.NavigateTo("/explore", true);
    } 
}
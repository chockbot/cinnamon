@using System.Security.Claims
@inherits LayoutComponentBase
@using Cinnamon.Web.Models.Layout;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Components;
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccountApiHandler accountApiHandler;

<div class="page">
    <main>
        <article class="content">
            <div class="container-fluid">
                 <div class="row flex-nowrap">
                    <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 side-bar">
                        <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                 <a href="Explore" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <span class="d-none d-sm-inline app-name">Cinnamon</span>
                 </a>
                 @if (Model.IsAuthenticated)
                 {
                    if (Model.Profile != null && Model.Profile.IsMaker)
                    {
                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                            <li class="nav-item">
                                <a href="Explore" class="nav-link align-middle px-0">
                                    <img class="icon-home" src="images/Dashboard Icon/Home.png"> <span class="ms-1 d-none d-sm-inline">Home</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a data-bs-toggle="collapse" class="nav-link px-0 align-middle" @onclick="NavigateToDashboard">
                                    <img class="icon-home" src="images/Dashboard Icon/dashboard icon.png"> <span class="ms-1 d-none d-sm-inline">Dashboard</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#" class="nav-link px-0 align-middle">
                                    <img class="icon-home" src="images/Dashboard Icon/manage icon.png"> <span class="ms-1 d-none d-sm-inline">Manage Students</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#" data-bs-toggle="collapse" class="nav-link px-0 align-middle ">
                                    <img class="icon-home" src="images/Dashboard Icon/report icon.png"> <span class="ms-1 d-none d-sm-inline">Reports</span>
                                </a>
                            </li>
                                        <li class="nav-item">
                                <a data-bs-toggle="collapse" class="nav-link px-0 align-middle" @onclick="NavigateToAccount">
                                    <img class="icon-home" src="images/Dashboard Icon/account icon.png"> <span class="ms-1 d-none d-sm-inline">Account</span> 
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#" data-bs-toggle="collapse" class="nav-link px-0 align-middle">
                                    <img class="icon-home" src="images/Dashboard Icon/badge icon.png"> <span class="ms-1 d-none d-sm-inline">Badges</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#" data-bs-toggle="collapse" class="nav-link px-0 align-middle">
                                    <img class="icon-home" src="images/Dashboard Icon/premium icon.png"> <span class="ms-1 d-none d-sm-inline">Premium</span>
                                </a>
                            </li>
                        </ul>
                    }
                 }
                 <hr />
                <div class="contact pb-3">
                    <a href="mailto:support@cinnamon.ph data-bs-toggle="collapse" class="nav-link px-0 align-middle">
                        <img src="images/Dashboard Icon/phone.png" alt="hugenerd" width="30" class="rounded-circle">
                        <span class="d-none d-sm-inline mx-1">Contact Us</span>
                    </a>
                </div>
            </div>
        </div>
         <div class="col py-3">
            @Body
        </div>
    </div>
</div>
        </article>
    </main>
</div>

@if (Model.IsAuthenticated && mouseEnter)
{
    <ModalLogin @ref="signinModal" />
}
@code
{
    private ModalLogin signinModal { get; set; }

    public bool clickButton { get; set; }

    private bool mouseEnter { get; set; }

    private HeaderModel Model { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (user.Identity != null && user.Identity.IsAuthenticated && token != null)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                // map only required field
                Model.Profile = new Models.Entities.CustomerProfile
                    {
                        IsMaker = result.Result.Result.IsMaker
                    };
                Model.IsAuthenticated = true;
            }
        }
    }

    private void NavigateToDashboard()
    {
        navigationManager.NavigateTo("/maker/dashboard");
    }

    private void NavigateToAccount()
    {
        navigationManager.NavigateTo("/customer/profile");
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void OnMouseEnter()
    {
        mouseEnter = !mouseEnter;
    }
    private void OnClickLogo()
    {
        navigationManager.NavigateTo("", true);
    }
    private void Logout()
    {
        navigationManager.NavigateTo("/api/account/logout", true);
    }
}
@using System.Security.Claims
@inherits LayoutComponentBase
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Layout;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Components;
@using Microsoft.AspNetCore.SignalR.Client;
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccountApiHandler accountApiHandler;
@inject IChatApiHandler chatApiHandler;

<Layout Sider class="dashboard-layout">
    <input type='checkbox' id='toggle' @bind="IsShowSidebar" />
    <LayoutSider @onclick="() => IsShowSidebar = !IsShowSidebar">
        <LayoutSiderContent>
            @if (Model.IsAuthenticated)
            {
                if (Model.Profile != null && Model.Profile.IsMaker)
                {
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0" id="menu">
                        
                        <li class="nav-item">
                            <div class="nav-link item-link sidebar-header">
                               @* <label for='toggle' class='close'><img src="images/Dashboard Icon/close.png" class="close-icon"></label>*@
                                <a href="Explore" class="d-flex align-items-center  text-white text-decoration-none">
                                    <span class="app-name" id="angelo">@Resources.App.appName</span>
                                </a>
                            </div>
                        </li>
                        <Divider/>
                        <li class="experiences-title">
                            <label>Main</label>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "dashboard" ? "active" : "inactive")" @onclick="NavigateToDashboard">
                                <img class="icon-home @(currentPage == "dashboard" ? "active" : "inactive")" src="images/Dashboard Icon/dashboard-icon.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "dashboard" ? "active" : "inactive")">Dashboard</span>
                            </a>
                        </li>
                        <li class="experiences-title">
                            <label>Experiences</label>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "events" ? "active" : "inactive")" @onclick="NavigateToEvents">
                                <img class="icon-home @(currentPage == "events" ? "active" : "inactive")" src="images/Dashboard Icon/experience-icon.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "events" ? "active" : "inactive")">My Events</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link activities-link" @onclick="ToggleCollapse">
                                <img class="icon-home" src="images/Dashboard Icon/experience-icon.svg">
                                <span class="ms-1 d-sm-inline nav-text">My Activities</span>
                                <i class="fas @GetArrowIcon() arrow-icon"></i>
                            </a>
                            <ul class="submenu" style="display:@GetSubMenuDisplay()">
                                <li class="sub-nav-link">
                                    <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "attendance" ? "active" : "inactive")" @onclick="NavigateToAttendance">
                                        <img class="icon-home @(currentPage == "attendance" ? "active" : "inactive")" src="images/Dashboard Icon/schedule.png"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "attendance" ? "active" : "inactive")">Attendance</span>
                                    </a>
                                </li>
                                <li class="sub-nav-link">
                                    <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "manage" ? "active" : "inactive")" @onclick="NavigateToManage">
                                        <img class="icon-home @(currentPage == "manage" ? "active" : "inactive")" src="images/Dashboard Icon/manage icon.png"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "manage" ? "active" : "inactive")">Manage Students</span>
                                    </a>
                                </li>
                            </ul>
                        </li>


                        <li class="experiences-title">
                            <label>Others</label>
                        </li>

                        @*<li class="nav-item messages-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link" @onclick="NavigateToMessages">
                                <img class="icon-home" src="images/Dashboard Icon/email.svg"> <span class="ms-1 d-sm-inline nav-text">Messages</span>
                                @if (hasNewMessages)
                                {
                                    <span class="has-new-message-badge">
                                    </span>
                                }
                            </a>
                        </li>*@
                        <li class="nav-item">
                            <a id="" data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "coupon" ? "active" : "inactive")" @onclick="NavigateToCoupons">
                                <img class="icon-home @(currentPage == "coupon" ? "active" : "inactive")" src="images/Dashboard Icon/promotion.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "coupon" ? "active" : "inactive")">Coupons</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link item-link @(currentPage == "reports" ? "active" : "inactive")" @onclick="NavigateToReports">
                                <img class="icon-home @(currentPage == "reports" ? "active" : "inactive")" src="images/Dashboard Icon/report-icon.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "reports" ? "active" : "inactive")">Reports</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "account" ? "active" : "inactive")" @onclick="NavigateToAccount">
                                <img class="icon-home @(currentPage == "account" ? "active" : "inactive")" src="images/Dashboard Icon/account-icon.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "account" ? "active" : "inactive")">Account</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link @(currentPage == "badge" ? "active" : "inactive")" @onclick="NavigateToBadges">
                                <img class="icon-home @(currentPage == "badge" ? "active" : "inactive")" src="images/Dashboard Icon/badge-icon.svg"> <span class="ms-1 d-sm-inline nav-text @(currentPage == "badge" ? "active" : "inactive")">Badges</span>
                            </a>
                        </li>
                        @*<li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link" @onclick="NavigateToPremium">
                                <img class="icon-home" src="images/Dashboard Icon/premium icon.png"> <span class="ms-1 d-sm-inline nav-text">Premium</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a data-bs-toggle="collapse" class="nav-link align-middle item-link" @onclick="NavigateToHelp">
                                <img class="icon-home" src="images/Dashboard Icon/help.png"> <span class="ms-1 d-sm-inline nav-text">Help</span>
                            </a>
                        </li>*@
                    </ul>
                }
            }
            <LayoutFooter>
                <div class="contact">
                    <a @onclick="NavigateToContact" data-bs-toggle="collapse" class="nav-link align-middle contact-box">
                        <img src="images/Dashboard Icon/phone.svg" alt="hugenerd" class="phone-icon">
                        <span class=" d-sm-inline mx-1">Contact Us</span>
                    </a>
                    <a @onclick="Logout" data-bs-toggle="collapse" class="nav-link align-middle contact-box">
                        <img src="images/Dashboard Icon/log-out.svg" alt="hugenerd" class="phone-icon">
                        <span class=" d-sm-inline mx-1">Logout</span>
                    </a>
                </div>
            </LayoutFooter>
        </LayoutSiderContent>
    </LayoutSider>
    <Layout>
        <LayoutContent>
            <Container Fluid>
                <div class="header-mobile">
                    <div>
                        <a href="Explore" class="text-white text-decoration-none">
                            <span class="d-sm-inline app-name-mobile">Cinnamon</span>
                        </a>
                    </div>
                    <div class="mt-3">
                        <label for='toggle' class='hamburger me-3'>
                            <img src="images/Dashboard Icon/hamburger.png" class="toggle-icon">
                        </label>
                    </div>
                </div> 
                <div class="render-body">
                    @Body
                </div>
            </Container>
        </LayoutContent>
    </Layout>
</Layout>

@if (Model.IsAuthenticated && mouseEnter)
{
    <ModalLogin @ref="signinModal"/>
}
@code
{
    private ModalLogin signinModal { get; set; }

    public bool clickButton { get; set; }

    private bool mouseEnter { get; set; }

    private HeaderModel Model { get; set; } = new();

    private bool IsShowSidebar {get; set;} = false;

    List<ChatRoom> chatRooms = new List<ChatRoom>();

    [Inject] HubConnection hubConnection { get; set; }

    private bool hasNewMessages = false;

    private bool isCollapsed = true;

    private string currentPage = "dashboard"; // Default page

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if (user.Identity != null && user.Identity.IsAuthenticated && token != null)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                // map only required field
                Model.Profile = new Models.Entities.CustomerProfile
                    {
                        IsMaker = result.Result.Result.IsMaker,
                        Id = result.Result.Result.Id
                    };
                Model.IsAuthenticated = true;

                await GetChatRoomsByUserId();
            }
        }
    }

    private void NavigateToDashboard()
    {
        currentPage = "dashboard";
        navigationManager.NavigateTo("/maker/dashboard");
    }

    private void NavigateToAccount()
    {
        currentPage = "account";
        navigationManager.NavigateTo("/customer/profile");
    }
    private void NavigateToManage()
    {
        currentPage = "manage";
        navigationManager.NavigateTo("/maker/dashboard/managestudents");
    }
    private void NavigateToMessages()
    {
        currentPage = "messages";
        navigationManager.NavigateTo("/maker/dashboard/messages");
    }
    private void NavigateToAttendance()
    {
        currentPage = "attendance";
        navigationManager.NavigateTo("/maker/dashboard/attendance");
    }

    private void NavigateToPremium()
    {
        currentPage = "premium";
        navigationManager.NavigateTo("/maker/dashboard/coming-soon");
    }

    private void NavigateToBadges()
    {
        currentPage = "badge";
        navigationManager.NavigateTo("/maker/dashboard/badges");
    }

    private void NavigateToReports()
    {
        currentPage = "reports";
        navigationManager.NavigateTo("/maker/dashboard/reports");
    }

    private void NavigateToHelp()
    {
        currentPage = "help";
        navigationManager.NavigateTo("/maker/dashboard/help");
    }

    private void NavigateToCoupons()
    {
        currentPage = "coupon";
        navigationManager.NavigateTo("/maker/dashboard/coupons");
    }
    private void NavigateToEvents()
    {
        currentPage = "events";
        navigationManager.NavigateTo("/maker/dashboard/events");
    }
    private void NavigateToContact()
    {
        navigationManager.NavigateTo("https://docs.google.com/forms/d/e/1FAIpQLSenakLuzzv2bTCy65a2WTy48E3wWAqs6B2reQVcSz3fkHOxkg/viewform");
    }

    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void OnMouseEnter()
    {
        mouseEnter = !mouseEnter;
    }
    private void OnClickLogo()
    {
        navigationManager.NavigateTo("", true);
    }
    private void Logout()
    {
        navigationManager.NavigateTo("/api/account/logout", true);
    }
    private string GetStyle()
    {
        var result = string.Empty;
        if(!IsShowSidebar){
            result = "display: none;";
        }
        return result;
    }

    private async Task GetChatRoomsByUserId()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");

        var result = await chatApiHandler.GetChatRoomsByUserId(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetChatRoomsByUserIdArgs
            {
                UserId = Model.Profile.Id
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            chatRooms = result.Result.Result.Select(c => new ChatRoom
                {
                    HasNewMessage = c.HasNewMessage,
                }).ToList();

            hasNewMessages = chatRooms.Any(c => c.HasNewMessage);
        }
    }

    private void ToggleCollapse()
    {
        IsShowSidebar = false;
        isCollapsed = !isCollapsed;
    }
    private string GetArrowIcon()
    {
        return isCollapsed ? "fa-chevron-right" : "fa-chevron-down"; // Font Awesome icons
    }

    private string GetSubMenuDisplay()
    {
        return isCollapsed ? "none" : "block";
    }
}
@using System.Security.Claims
@inherits LayoutComponentBase
@using Cinnamon.Web.Models.Entities;
@using Cinnamon.Web.Models.Layout;
@using Microsoft.AspNetCore.SignalR.Client;
@using Cinnamon.Web.Modules.ApiAccess.Handlers
@using Cinnamon.Web.Components;
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccountApiHandler accountApiHandler;
@inject IChatApiHandler chatApiHandler;
@implements IDisposable

<PageTitle>Cinnamon.Web</PageTitle>
<div class="page-wrapper">
    <div class="page app-name-section">
        <main>
            <div class="top-row px-4">
                <!--App Name-->
                <div class="app-name col-lg-3 col-md-3">
                    <a href="/explore" class="app-name">@Resources.App.appName</a>
                </div>
                <!--Menu-->
                <div class="d-flex flex-row justify-content-end" @onmouseenter="OnMouseEnter" @onmouseleave="OnMouseEnter">
                    @if (Model.Profile != null && Model.Profile.IsMaker)
                    {
                        <div class="become">
                            <a @onclick="NavigateToDashboard" class="btn border-0">Go to Dashboard</a>
                        </div>
                    } 
                    else
                    {
                        <div class="become">
                            <a href="/Onboarding" class="btn border-0">@Resources.App.Become</a>
                        </div>
                    }
                    @*DESKTOP*@
                    <div class="dropdown">
                        <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" 
                            aria-expanded="false" border="none" @onclick="onClickMenu">
                            <div class="menu">
                                <img src="images/menu.png">
                                @if (Model.Profile != null)
                                {
                                    @if (newMessagesCount != 0)
                                    {
                                        <span class="new-message-count-badge">
                                            @newMessagesCount
                                        </span>
                                    }
                                }
                            </div>
                        </button>
                        <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                            @if (Model.IsAuthenticated)
                            {
                                if (Model.Profile != null && Model.Profile.IsMaker)
                                {
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                    </li>
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToAttendance" Text="Check Attendance" />
                                    </li>
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToMaterials" Text="Materials" />
                                    </li>
                                    <li class="dropdown-item messages-item">
                                        <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                        @if (hasNewMessages)
                                        {
                                            <span class="has-new-message-badge">
                                            </span>
                                        }
                                    </li>
                                }
                                else
                                {
                                    <li class="dropdown-item messages-item">
                                        <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                        @if (hasNewMessages)
                                        {
                                            <span class="has-new-message-badge">
                                            </span>
                                        }
                                    </li>
                                }
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToAccount" Text="Account" />
                                </li>
                                <li class="dropdown-item">
                                    <Button Border="Border.Is0" Clicked="Logout">
                                        Logout
                                    </Button>
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToHelp" Text="Help" />
                                </li>
                            }
                            else
                            {
                                <li class="dropdown-item">
                                    <Button Border="Border.Is0" Clicked="() => signinModal.Show()">
                                        @Resources.App.Sign
                                    </Button>
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToMaterials" Text="Materials" />
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToHelp" Text="Help" />
                                </li>
                            }
                        </ul>
                    </div>
                    @*MOBILE*@
                     <div class="dropdown-mobile">
                        <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" 
                            aria-expanded="false" border="none" @onclick="onClickMenu">
                            <div class="menu">
                                <img src="images/menu.png">
                                @if (Model.Profile != null && !Model.Profile.IsMaker)
                                {
                                    @if (newMessagesCount != 0)
                                    {
                                        <span class="new-message-count-badge">
                                            @newMessagesCount
                                        </span>
                                    }
                                }
                            </div>
                        </button>
                        <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                            @if (Model.IsAuthenticated)
                            {
                                if (Model.Profile != null && Model.Profile.IsMaker)
                                {
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                    </li>
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToAttendance" Text="Check Attendance" />
                                    </li>
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToMaterials" Text="Materials" />
                                    </li>
                                    <li class="dropdown-item messages-item">
                                        <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                        @if (hasNewMessages)
                                        {
                                            <span class="has-new-message-badge">
                                            </span>
                                        }
                                    </li>
                                }
                                else if (Model.Profile != null && !Model.Profile.IsMaker)
                                {
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToOnboarding" Text="Become an Activity Provider" />
                                    </li>
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToMaterials" Text="Materials" />
                                    </li>
                                    <li class="dropdown-item messages-item">
                                        <NavButton OnClick="NavigateToMessages" Text="Messages" />
                                        @if (hasNewMessages)
                                        {
                                            <span class="has-new-message-badge">
                                            </span>
                                        }
                                    </li>
                                }
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToAccount" Text="Account" />
                                </li>
                                <li class="dropdown-item">
                                    <Button Border="Border.Is0" Clicked="Logout">
                                        Logout
                                    </Button>
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToHelp" Text="Help" />
                                </li>
                            }
                            else
                            {
                                <li class="dropdown-item">
                                    <Button Border="Border.Is0" Clicked="() => signinModal.Show()">
                                        @Resources.App.Sign
                                    </Button>
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToOnboarding" Text="Become an Activity Provider" />
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToMaterials" Text="Materials" />
                                </li>
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToHelp" Text="Help" />
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <article class="content">
                @Body
            </article>
        </main>
    </div>
</div>

<ModalLogin @ref="signinModal" ReturnUrl="@CurrentUrl" />


@code 
{
    private ModalLogin signinModal {get; set;}

    public bool clickButton { get; set; }

    private bool mouseEnter { get; set; }

    private HeaderModel Model {get; set;} = new();

    private bool hasNewMessages = false;

    private int newMessagesCount = 0;

    List<ChatRoom> chatRooms = new List<ChatRoom>();

    [Inject] HubConnection hubConnection { get; set; }

    private string CurrentUrl  { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var test = NavigationManager.Uri;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;

        var token = user.FindFirstValue("Token");
        if(user.Identity != null && user.Identity.IsAuthenticated && token != null)
        {
            var result = await accountApiHandler.GetProfile(new Framework.ApiCommand.ApiCore.Account.Request.GetProfileArgs { }, token);
            if(result.Succeeded && result.Result != null && result.Result.IsSuccess)
            {
                // map only required field
                Model.Profile = new Models.Entities.CustomerProfile {
                    IsMaker = result.Result.Result.IsMaker,
                    Id = result.Result.Result.Id
                };
                Model.IsAuthenticated = true;

                await GetChatRoomsByUserId();

                if (hubConnection.State == HubConnectionState.Disconnected)
                {
                    try
                    {
                        await hubConnection.StartAsync();
                    }
                    catch (Exception ex)
                    {
                        await Task.Delay(new Random().Next(0, 5) * 1000);

                        while (true)
                        {
                            try
                            {
                                await hubConnection.StartAsync();

                                break;
                            }
                            catch (ObjectDisposedException e)
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                            catch
                            {
                                await Task.Delay(new Random().Next(0, 5) * 1000);
                            }
                        }
                    }
                }
            }
        }

        NavigationManager.LocationChanged += LocationChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(firstRender)
        {
            CurrentUrl = $"/{NavigationManager.ToBaseRelativePath(NavigationManager.Uri)}";
        }
    }

    private async Task SendChatStatus()
    {
        if (hubConnection is not null && Model.Profile is not null)
        {
            await hubConnection.SendAsync("SendChatStatus", Model.Profile.Id);
        }
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/maker/dashboard");
    }
    private void NavigateToAttendance()
    {
        NavigationManager.NavigateTo("/maker/dashboard/attendance");
    }

    private void NavigateToAccount()
    {
        NavigationManager.NavigateTo("/customer/profile");
    }
    private void NavigateToHelp()
    {
        NavigationManager.NavigateTo("/Help");
    }

    private void NavigateToCreation()
    {
        NavigationManager.NavigateTo("/Creation");
    }

    private void NavigateToOnboarding()
    {
        NavigationManager.NavigateTo("/Onboarding");
    }
    private void NavigateToMaterials()
    {
        NavigationManager.NavigateTo("/materials");
    }
    
    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void OnMouseEnter()
    {
        mouseEnter = !mouseEnter;
    }

    private void Logout()
    {
        SendChatStatus();

        try
        {
            hubConnection.StopAsync();
        }
        finally
        {
            hubConnection.DisposeAsync();
        }

        NavigationManager.NavigateTo("/api/account/logout", true);
    }

    private async Task GetChatRoomsByUserId()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");

        var result = await chatApiHandler.GetChatRoomsByUserId(new Framework.ApiCommand.ApiCore.ChatRoom.Request.GetChatRoomsByUserIdArgs
            {
                UserId = Model.Profile.Id
            }, token);

        if (result.Succeeded && result.Result != null && result.Result.IsSuccess)
        {
            chatRooms = result.Result.Result.Select(c => new ChatRoom
                {
                    ChatRoomId = c.ChatRoomId,
                    FromUserId = c.FromUserId,
                    DateCreated = c.DateCreated,
                    FromFirstName = c.FromFirstName,
                    FromLastName = c.FromLastName,
                    Message = c.Message,
                    ToFirstName = c.ToFirstName,
                    ToLastName = c.ToLastName,
                    ToUserId = c.ToUserId,
                    FromProfilePath = c.FromProfilePath,
                    ToProfilePath = c.ToProfilePath,
                    FromConnectionId = c.FromConnectionId,
                    ToConnectionId = c.ToConnectionId,
                    HasNewMessage = c.HasNewMessage,
                    FromProfileLink = c.FromProfileLink
                }).ToList();

            hasNewMessages = chatRooms.Any(c => c.HasNewMessage);
            newMessagesCount = chatRooms.Count(c => c.HasNewMessage);
        }
    }

    private void NavigateToMessages()
    {
        NavigationManager.NavigateTo("/Messages");
    }

    void LocationChanged(object sender, LocationChangedEventArgs e)
    {
    }

    void IDisposable.Dispose()
    {
        // Unsubscribe from the event when our component is disposed
        NavigationManager.LocationChanged -= LocationChanged;
    }

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;
}




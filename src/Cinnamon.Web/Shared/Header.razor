@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components

<PageTitle>Cinnamon.Web</PageTitle>

<div class="page">
    <main>
    <div class="top-row px-4">
        <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4">
                <a href="" class="app-name">@Resources.App.appName</a>
        </div>
            <div class="col-lg-4 col-lg-4 col-md-4 col-sm-4 col-xs-4">
            <div class="input-group border rounded-pill p-1">
                <input type="search" placeholder="Location" aria-describedby="button-addon3" class="form-control bg-none border-0">
                <div class="input-group-append border-0">
                    <button id="button-addon3" type="button" class="btn btn-link text-success" style="background-color:#ffa942; border-radius:50%"><i class="fa fa-search" style="color:white"></i></button>
                </div>
            </div>
        </div>
            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-4 d-flex">
            <div class="nav">
                    <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#sigupModal">
                        Become a Cinnamon Maker
                        <span><img src="images/country.png" class="img-icon" style="width:10%"></span>
                    </button>
            </div>
            <div class="dropdown">
                <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none">
                    <div class="menu">
                        <img src="images/menu.png">
                        <span>@Resources.App.menu</span>
                    </div>
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenu2">
                    <li>
                        <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#sigupModal">
                            Sign-up
                        </button>
                    </li>
                    <li>
                        <div class="btn-faq">
                            <NavButton OnClick="NavigateToFAQPage" Text=FAQ />
                        </div>
                    </li>
                    <li>
                        <div class="btn-policy">
                            <NavButton OnClick="NavigateToPolicyPage" Text="Privacy Policy" />
                        </div>
                    </li>
                    <li>
                        <div class="btn-terms">
                            <NavButton OnClick="NavigateToTermsPage" Text="Terms of Use" />
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="modal fade" id="sigupModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="card-filter text-center">
                        <h1> Welcome to <span style="color:#ffa942">@Resources.App.appName</span></h1>
                         <SignUpCard></SignUpCard>
                    </div>
                </div>
            </div>
        </div>
    </div>
        <article class="content">
            @Body
        </article>
    </main>
</div>
@code {
    private void NavigateToFAQPage()
    {
        NavigationManager.NavigateTo("FAQ");
    }
    private void NavigateToPolicyPage()
    {
        NavigationManager.NavigateTo("policy");
    }
    private void NavigateToTermsPage()
    {
        NavigationManager.NavigateTo("terms");
    }
}


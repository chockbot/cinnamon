@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components

<!doctype html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
  <body>
  <div class="top-row px-4">
    <a href="#" class="app-name">@Resources.App.appName</a>
    <div class="flex-fill"></div>

        <!--Dropdown Navbar-->
        <div class="dropdown">
            <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none">
                <div class="menu">
                    <img src="images/menu.png">
                    <span>@Resources.App.menu</span>
                </div>
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenu2">
                <li>
                    <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#sigupModal">
                        Sign-up
                    </button>
                </li>
                <li>
                    <div class="btn-faq">
                        <NavButton OnClick="NavigateToFAQPage" Text=FAQ />
                    </div>
                </li>
                <li>
                    <div class="btn-policy">
                        <NavButton OnClick="NavigateToPolicyPage" Text="Privacy Policy" />
                    </div>
                </li>
                <li>
                    <div class="btn-terms">
                        <NavButton OnClick="NavigateToTermsPage" Text="Terms of Use" />
                    </div>
                </li>
            </ul>
        </div>
    </div>
    <div class="modal fade" id="sigupModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="card-filter">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                <h1> Welcome to @Resources.App.appName</h1>
                                <h7> Join our waiting list to get notified when we go live!</h7>
                                <br />

                            </li>
                            <li class="list-group-item text-center">
                                <div class="col-sm-12">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="inlineCheckbox1" value="option1">
                                        <label class="form-check-label" for="inlineCheckbox1">Customer</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" id="inlineCheckbox2" value="option2">
                                        <label class="form-check-label" for="inlineCheckbox2">Cinnamon Maker</label>
                                    </div>
                                    <br>
                                    <label class="radio"> <input type="radio" name="pricing" value="Hourly" checked> <span><i class="fa fa-clock-o"></i> Email</span></label>
                                    <label class="radio"> <input type="radio" name="pricing" value="Hourly" checked> <span><i class="fa fa-clock-o"></i> Sign-up</span></label>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </body>
</html>
@code{
    private void NavigateToFAQPage()
    {
        NavigationManager.NavigateTo("FAQ");
    }
	private void NavigateToPolicyPage()
	{
		NavigationManager.NavigateTo("policy");
	}
	private void NavigateToTermsPage()
	{
		NavigationManager.NavigateTo("terms");
	}
}


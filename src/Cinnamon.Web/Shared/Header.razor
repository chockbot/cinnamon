@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@using Cinnamon.Web.Components
@using Cinnamon.Core.Enums
@using Cinnamon.Core
@using Cinnamon.Core.Models;
@using Cinnamon.Data
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider


<PageTitle>Cinnamon.Web</PageTitle>

<div class="page">
    <main>
    <div class="top-row px-4">
        <!--App Name-->
        <div class="app-name col-lg-3 col-md-3">
            <a href="/explore" class="app-name">@Resources.App.appName</a>
        </div>
        <!--Menu-->
            <div class="d-flex flex-row justify-content-end" @onmouseenter="OnMouseEnter" @onmouseleave="OnMouseEnter">
                @if (UserModel != null && UserModel.IsMaker)
                {
                    <div class="become">
                        <a @onclick="NavigateToDashboard" class="btn border-0">Go to Dashboard</a>
                    </div>
                }
                else
                {
                    <div class="become">
                        <a href="/Onboarding" class="btn border-0">@Resources.App.Become</a>
                    </div>
                }
                <div class="dropdown">
                    <button class="btn border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false" border="none" @onclick="onClickMenu">
                        <div class="menu">
                            <img src="images/menu.png">
                           @* <span class="menu-label">@Resources.App.menu</span>*@
                        </div>
                    </button>
                    <ul class="dropdown-menu @ShowMenu()" aria-labelledby="dropdownMenu2">
                        @if (AuthState != null)
                        {
                            @if (AuthState.User.Identity.IsAuthenticated)
                            {
                                if (UserModel != null && UserModel.IsMaker)
                                {
                                    <li class="dropdown-item">
                                        <NavButton OnClick="NavigateToDashboard" Text="Manage Experiences" />
                                    </li>
                                }
                                <li class="dropdown-item">
                                    <NavButton OnClick="NavigateToAccount" Text="Account" />
                                </li>
                                <li class="dropdown-item">
                                    <form class="form-inline" asp-area="Identity" action="Identity/Account/Logout" method="post">
                                        <button type="submit" class="btn border-0">
                                            Logout
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="dropdown-item">
                                    <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#loginModal">
                                        @Resources.App.Sign
                                    </button>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="dropdown-item">
                                <button type="button" class="btn border-0" data-bs-toggle="modal" data-bs-target="#sigupModal">
                                    @Resources.App.Sign
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
    </div>
        <article class="content">
            @Body
        </article>
    </main>
    <ModalSignUp></ModalSignUp>
</div>
@if (!AuthState.User.Identity.IsAuthenticated && mouseEnter)
{
    <ModalLogin TypeValue="@UserType.Customer" ReturnUrl="@NavigationManager.Uri"></ModalLogin>
}
@code {
    public bool clickButton { get; set; }
    public List<CustomerModel> UserList = new List<CustomerModel>();
    public CustomerModel UserModel = new CustomerModel();
    public AuthenticationState AuthState { get; set; }
    private bool mouseEnter { get; set; }
     protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if(AuthState != null && AuthState.User.Identity.IsAuthenticated)
        {
            var email = AuthState.User.FindFirstValue(ClaimTypes.Email);
            UserModel = await CoreDI.DataStore.Customers.GetCustomerByEmailAsync(email);
        }
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/maker/dashboard");
    }
    private void NavigateToAccount()
    {
        NavigationManager.NavigateTo("/customer/profile");
    }
    
    private void onClickMenu()
    {
        if (clickButton)
        {
            clickButton = false;
        }
        else
        {
            clickButton = true;
        }
        StateHasChanged();
    }

    private string ShowMenu()
    {
        return clickButton ? "show" : "";
    }

    private void OnMouseEnter()
    {
        mouseEnter = !mouseEnter;
    }
}


@inherits LayoutComponentBase
@using Cinnamon.Web.Components
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@using System.Security.Claims

<PageTitle>Cinnamon</PageTitle>

<div class="page app-name-section">
    <main>
        <div class="top-row px-4 d-flex">
            <div class="app-name col-lg-8 col-md-6 col-sm-8 col-8">
                <a href="/explore" class="app-name">@Resources.App.appName</a>
            </div>
            <div class="login-button col-lg-4 col-md-6">
                <p class="cinnamon-link" @onclick="NavigateToAbout">About</p>
                <p class="cinnamon-link" @onclick="NavigateToBlogs">Blogs</p>
                <p class="cinnamon-link" @onclick="NavigateToHelp">Help</p>
                <button class="btn-login" @onclick="() => signinModal.Show()" style="display:@isDisplay">
                    Login | Signup
                </button>
            </div>
        </div>
        <article class="content">
            @Body
        </article>
    </main>
</div>
<ModalLogin @ref="signinModal" />
@code
{
    private ModalLogin signinModal;

    public ClaimsPrincipal AuthState { get; set; }

    private string isDisplay = "block";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        var token = user.FindFirstValue("Token");
        AuthState = user;
        if (user != null && user.Identity.IsAuthenticated)
        {
            isDisplay = "none";
        }
    }
    private void NavigateToHelp()
    {
        navigationManager.NavigateTo("/help");
    }
    private void NavigateToAbout()
    {
        navigationManager.NavigateTo("https://cinnamon.ph/blog/cinnamon/");
    }
    private void NavigateToBlogs()
    {
        navigationManager.NavigateTo("https://cinnamon.ph/blog/");
    }
}
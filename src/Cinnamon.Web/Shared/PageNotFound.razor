@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<!DOCTYPE html>

<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!--Bootstrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
</head>
<body>
    <div class="container container-fluid">
        <div class="row d-flex justify-content-center">
            <div class="row d-flex justify-content-center" style="border-radius:10px;">
                <div class="images-gallery order-lg-last order-md-last order-sm-first">
                    <div class="detail-md">
                        <div class="row">
                            <div class="col-lg-4 justify-content-center col-md-4 justify-content-center">
                                <img src="images/Missing/left-plug.svg" class="left-plug-not-found img-fluid">
                            </div>
                            <div class="col-lg-4 justify-content-center col-md-4 justify-content-center text-lg-center">
                                <img src="images/Missing/error-desktop.svg" class="img-not-found img-fluid">
                            </div>
                            <div class="col-lg-4 justify-content-center col-md-4 justify-content-center">
                                <img src="images/Missing/right-plug.svg" class="right-plug-not-found img-fluid">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <p class="not-found-caption">Sorry, This Page Could Not Be Found.</p>
            <p class="mini-caption">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
            <button class="btn-primary btn-go-home" @onclick="NavigateToExplorePage">
                Go Home
            </button>

        </div>

    </div>


</body>
</html>

@code {
    private void NavigateToExplorePage()
    {
        NavigationManager.NavigateTo("explore");
    }
}
